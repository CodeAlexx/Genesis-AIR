// Many-track navigation must paint and hit-test the same shifted lane model.
module genesis.tests.timeline_track_scroll
import std.draw as draw
import std.editor as editor
import std.editor_io as editor_io
import std.geometry as geometry
import std.math as math
import std.path as path
import std.files as files
import std.testing as test
import std.timeline as timeline
import std.widgets as widgets
import "../src/app.ai" as app
import "../src/chrome.ai" as chrome
import "../src/commands.ai" as commands
import "../src/input.ai" as input
import "../src/layout.ai" as layout
import "../src/provider.ai" as provider
import "../src/preview.ai" as preview
import "../src/timeline_follow.ai" as follow
import "../src/view.ai" as painter

fn encoded(state: ref<app.App>) -> string effects {alloc} {
  match editor_io.encode(struct.borrow(state,field=document)) {ok(value)=>value,err(_)=>string.copy("encode failed"),}
}
fn authored(state: ref<app.App>) -> string effects {alloc} {
  var out: string=encoded(state)
  string.append(out,string.from_int(state.document_revision))
  string.append(out,"/")
  string.append(out,string.from_int(state.media_revision))
  string.append(out,if app.dirty(state) {"/dirty/"}else{"/clean/"})
  string.append(out,string.from_int(app.current_clip(state)))
  let history: ref<editor.History> = struct.borrow(state,field=history)
  var index: u64=0
  loop {if index>=array.len(struct.borrow(history,field=undo)) {break}
    string.append(out,"/undo/")
    match editor_io.encode(array.borrow(struct.borrow(history,field=undo),index)) {
      ok(value)=>{string.append(out,value)},err(_)=>{string.append(out,"encode failed")},
    }
    index=index+1
  }
  index=0
  loop {if index>=array.len(struct.borrow(history,field=redo)) {break}
    string.append(out,"/redo/")
    match editor_io.encode(array.borrow(struct.borrow(history,field=redo),index)) {
      ok(value)=>{string.append(out,value)},err(_)=>{string.append(out,"encode failed")},
    }
    index=index+1
  }
  out
}
fn picture() -> draw.Surface effects {alloc} {
  var canvas: draw.Canvas=draw.canvas(option.unwrap(draw.surface(80,45)))
  draw.clear(canvas,draw.rgb(12,240,30))
  draw.finish(canvas)
}
fn fixture(root: str) -> app.App effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  var state: app.App=app.app(provider.fake(root))
  var doc: editor.Document=editor.document(30.0,160,90)
  let source: u64=editor.add_source(doc,"metadata-only.mov","Many-track source",240,30.0)
  let _=editor.describe_source(doc,source,160,90,true,true,48000,2)
  var count: u64=0
  loop {if count==24 {break}
    let track: u64=editor.add_track(doc,doc.active,if count==1 {editor.track_audio()}else{editor.track_video()},"Reachable lane")
    let _=editor.place(doc,track,source,0,60,0)
    count=count+1
  }
  // Root id2/source3/first track4/first clip5 are fixed independently.
  let _=editor.place(doc,4,source,60,60,60)
  let _=editor.add_transition(doc,4,60,12,"crossfade")
  let child: u64=editor.add_sequence(doc,"Short sequence",24.0,160,90)
  let _=editor.add_track(doc,child,editor.track_video(),"Only lane")
  let _=editor.seek(doc,7)
  commands.replace_project(state,doc)
  app.mark_dirty(state,false)
  var peaks: array<f64> = [0.8,0.8,0.8,0.8,0.8,0.8]
  app.set_waveform(state,5,peaks,0,59,state.media_revision)
  // The GUI A-lane paints a neutral-mixer visual reference; legacy V cache stays
  // above to prove it cannot overlay frame strips. No real decode is needed here.
  let audio_clip:editor.Clip=option.unwrap(editor.clip(struct.borrow(state,field=document),7))
  var neutral:editor.Document=preview.visual_reference_document(struct.borrow(state,field=document))
  let audio_key:string=match preview.visual_reference_key(neutral,audio_clip,8) {ok(value)=>value,err(_)=>string.new(),}
  let _=app.set_visual_waveform(state,7,str.view(audio_key),array.repeat(0.8,8))
  let media_revision: u64=state.media_revision
  let document_revision: u64=state.document_revision
  array.push(struct.borrow(state,field=thumbnails),app.Thumbnail {clip:5,frame:0,source:3,
    source_frame:0,revision:media_revision,document_revision:document_revision,pixels:picture()})
  state
}
fn painted(state: ref<app.App>, width: u32, height: u32) -> draw.Surface effects {alloc} {
  var canvas: draw.Canvas=draw.canvas(option.unwrap(draw.surface(width,height)))
  var source: draw.Surface=draw.empty_surface()
  var program: draw.Surface=draw.empty_surface()
  painter.paint(state,canvas,cast.float(width),cast.float(height),source,program)
  draw.finish(canvas)
}
fn long_fixture(root: str, length: i64, start: i64) -> app.App effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  var state: app.App=app.app(provider.fake(root))
  var doc: editor.Document=editor.document(60.0,1920,1080)
  let source: u64=editor.add_source(doc,"long-metadata-only.mov","Long clip",length,60.0)
  let _=editor.describe_source(doc,source,1920,1080,true,true,48000,2)
  let track: u64=editor.add_track(doc,doc.active,editor.track_video(),"Long video")
  let clip: u64=option.unwrap(editor.place(doc,track,source,0,length,start))
  commands.replace_project(state,doc)
  let _=editor.select_only(struct.borrow(state,field=document),clip)
  let _=commands.set_clip_field(state,clip,"gain",0.5)
  let _=commands.undo(state)
  app.mark_dirty(state,false)
  state
}
fn fit(state: ref<app.App>, width: f64, height: f64) -> string effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  let frame: layout.Frame=layout.frame(width,height)
  var controls: array<chrome.Control> = chrome.timeline_bar(frame,state)
  var at: u64=0
  loop {if at>=array.len(controls) {break}
    let entry: ref<chrome.Control> = array.borrow(controls,at)
    if entry.action==chrome.act_zoom_fit() {
      return input.pointer_down(state,width,height,(entry.area.left+entry.area.right)/2.0,(entry.area.top+entry.area.bottom)/2.0)
    }
    at=at+1
  }
  string.copy("Fit control missing")
}
fn pixel(surface: ref<draw.Surface>, x: f64, y: f64, wanted: draw.Color) -> bool effects {} {
  match draw.surface_pixel(surface,cast.sat(x),cast.sat(y)) {
    none=>false,some(found)=>found.r==wanted.r and found.g==wanted.g and found.b==wanted.b,
  }
}
type Button = struct {area: layout.Rect,enabled: bool}
fn button(state: ref<app.App>, frame: layout.Frame, action: u32) -> option<Button> effects {alloc} {
  var model: timeline.Timeline=painter.timeline_model(state,frame.timeline)
  var controls: array<chrome.Control> = chrome.track_controls(frame,state,model)
  var at: u64=0
  loop {if at>=array.len(controls) {break}
    let found: ref<chrome.Control> = array.borrow(controls,at)
    if found.action==action {return option.some(Button {area:found.area,enabled:found.enabled})}
    at=at+1
  }
  option.none()
}
pub fn main(args: view<str>) -> i32 effects {alloc,env,fs.meta,fs.read,fs.write,io.write,process,time} {
  if view.len(args)!=2 {return 2}
  let root: str=view.get(args,1)
  let _=files.mkdirs(root)
  var suite: test.Suite=test.suite("Timeline vertical track viewport",false)
  var state: app.App=fixture(root)
  let frame: layout.Frame=layout.frame(1600.0,980.0)
  let original: string=encoded(state)
  let revision: u64=state.document_revision
  let _=test.start(suite,"Header wheel and discoverable controls scroll only the track viewport")
  let down: Button=option.unwrap(button(state,frame,chrome.act_tracks_down()))
  let up: Button=option.unwrap(button(state,frame,chrome.act_tracks_up()))
  let _=test.check(suite,down.enabled and not up.enabled,"Down is enabled and Up disabled at the first lane")
  let initial_focus: u32=app.focus(state)
  var disabled_up: string=input.pointer_down(state,1600.0,980.0,(up.area.left+up.area.right)/2.0,(up.area.top+up.area.bottom)/2.0)
  let _=test.check(suite,str.len(str.view(disabled_up))==0 and app.track_scroll(state)==0 and app.focus(state)==initial_focus,"Clicking disabled Up produces no action or view change")
  let _=input.pointer_down(state,1600.0,980.0,(down.area.left+down.area.right)/2.0,(down.area.top+down.area.bottom)/2.0)
  let _=test.eq_u64(suite,app.track_scroll(state),1,"Footer Down advances one lane")
  let _=input.pointer_down(state,1600.0,980.0,(up.area.left+up.area.right)/2.0,(up.area.top+up.area.bottom)/2.0)
  let _=test.eq_u64(suite,app.track_scroll(state),0,"Footer Up returns one lane")
  let _=input.wheel(state,1600.0,980.0,frame.headers.left+10.0,frame.headers.top+10.0,true,1000,false)
  let visible: u64=cast.sat(math.floor(layout.height_of(frame.timeline)/50.0))
  let _=test.eq_u64(suite,app.track_scroll(state),24-visible,"Many wheel ticks clamp at the last full lane")
  let last_down: Button=option.unwrap(button(state,frame,chrome.act_tracks_down()))
  let _=test.check(suite,not last_down.enabled,"Down is disabled at the last lane")
  let last_first: u64=app.track_scroll(state)
  let last_focus: u32=app.focus(state)
  var disabled_down: string=input.pointer_down(state,1600.0,980.0,(last_down.area.left+last_down.area.right)/2.0,(last_down.area.top+last_down.area.bottom)/2.0)
  let _=test.check(suite,str.len(str.view(disabled_down))==0 and app.track_scroll(state)==last_first and app.focus(state)==last_focus,"Clicking disabled Down produces no action or view change")
  let _=test.check(suite,encoded(state)==original and state.document_revision==revision and not app.dirty(state),"View navigation preserves authored state, transport and dirty/revision")
  let horizontal: i64=app.scroll(state)
  let _=input.wheel(state,1600.0,980.0,frame.timeline.left+20.0,frame.timeline.top+10.0,true,2,false)
  let _=test.eq_i64(suite,app.scroll(state),horizontal+24,"Timeline body wheel preserves horizontal scrolling")
  let first: u64=app.track_scroll(state)
  let zoom: f64=app.zoom(state)
  let _=input.wheel(state,1600.0,980.0,frame.headers.left+10.0,frame.headers.top+10.0,false,1,true)
  let _=test.near_f64(suite,app.zoom(state),zoom*1.25,0.00001,"Ctrl wheel keeps timeline zoom")
  let _=test.eq_u64(suite,app.track_scroll(state),first,"Ctrl zoom preserves lane offset")
  let _=test.eq_u64(suite,app.track_scroll_max(state,100.0),22,"Two full lanes fit a100px body without requiring a trailing gap")
  let _=test.eq_u64(suite,app.track_scroll_max(state,99.0),23,"A body shorter than two complete lanes exposes one")
  let _=test.done(suite)

  let _=test.start(suite,"Wheel metadata owns modifier state after native file shortcuts")
  var wheel_state: app.App=fixture(root)
  let _=commands.select_only(wheel_state,5)
  let gain_edit:commands.Result=commands.set_clip_field(wheel_state,5,"gain",0.5)
  let _=test.check(suite,gain_edit.ok and option.unwrap(editor.clip(struct.borrow(wheel_state,field=document),5)).gain==0.5,"A supported edit changes authored gain before Undo")
  let gain_undo:commands.Result=commands.undo(wheel_state)
  let _=test.check(suite,gain_undo.ok and option.unwrap(editor.clip(struct.borrow(wheel_state,field=document),5)).gain==1.0,"Undo restores authored gain and creates genuine Redo")
  app.mark_dirty(wheel_state,false)
  let _=test.check(suite,array.len(struct.borrow(struct.borrow(wheel_state,field=history),field=redo))>0,"Navigation starts with a real Redo snapshot to preserve")
  let wheel_authored: string=authored(wheel_state)
  let scale: f64=2.0
  let header_x: u32=cast.sat((frame.headers.left+10.0)*scale)
  let header_y: u32=cast.sat((frame.headers.top+10.0)*scale)
  var shortcut: u64=0
  loop {if shortcut==2 {break}
    let _=input.key(wheel_state,if shortcut==0 {115}else{111},true,false)
    let _=test.check(suite,app.prompt_active(wheel_state),"Ctrl+S/Open reaches the native picker prompt")
    // The native picker consumes Return and closes without an AIR KeyUp event.
    app.end_prompt(wheel_state)
    let before_lane: u64=app.track_scroll(wheel_state)
    let before_zoom: f64=app.zoom(wheel_state)
    let plain: widgets.Wheel=widgets.Wheel {x:header_x,y:header_y,down:true,lines:1}
    let _=input.wheel_event(wheel_state,1600.0,980.0,plain,scale)
    let _=test.eq_u64(suite,app.track_scroll(wheel_state),before_lane+1,"Plain wheel scrolls headers despite the last Ctrl shortcut")
    let _=test.near_f64(suite,app.zoom(wheel_state),before_zoom,0.0,"No stale Ctrl state leaks into timeline zoom")
    shortcut=shortcut+1
  }
  let shift_first: u64=app.track_scroll(wheel_state)
  let zoom_before: f64=app.zoom(wheel_state)
  let shifted: widgets.Wheel=widgets.Wheel {x:header_x,y:or(header_y,widgets.shift_pointer_flag()),down:true,lines:1}
  let _=input.wheel_event(wheel_state,1600.0,980.0,shifted,scale)
  let _=test.eq_u64(suite,app.track_scroll(wheel_state),shift_first+1,"Packed Shift metadata is removed before header hit testing")
  let _=test.near_f64(suite,app.zoom(wheel_state),zoom_before,0.0,"Shift metadata never impersonates Ctrl zoom")
  let zoom_first: u64=app.track_scroll(wheel_state)
  let controlled: widgets.Wheel=widgets.Wheel {x:header_x,y:or(header_y,widgets.control_pointer_flag()),down:false,lines:1}
  let _=input.wheel_event(wheel_state,1600.0,980.0,controlled,scale)
  let _=test.near_f64(suite,app.zoom(wheel_state),zoom_before*1.25,0.00001,"Current Ctrl wheel deliberately zooms at the cleaned logical position")
  let _=test.eq_u64(suite,app.track_scroll(wheel_state),zoom_first,"Intentional Ctrl zoom leaves lane offset intact")
  let dock_before: f64=app.dock_scroll(wheel_state)
  let dock_zoom: f64=app.zoom(wheel_state)
  let dock: widgets.Wheel=widgets.Wheel {x:cast.sat((frame.dock_body.left+10.0)*scale),
    y:or(cast.sat((frame.dock_body.top+10.0)*scale),widgets.control_pointer_flag()),down:true,lines:3}
  let _=input.wheel_event(wheel_state,1600.0,980.0,dock,scale)
  let _=test.near_f64(suite,app.dock_scroll(wheel_state),dock_before+72.0,0.0,"Dock precedence keeps Ctrl wheel as inspector scrolling")
  let _=test.near_f64(suite,app.zoom(wheel_state),dock_zoom,0.0,"Dock Ctrl wheel never changes timeline zoom")
  let _=test.eq_str(suite,authored(wheel_state),wheel_authored,"Every wheel path preserves complete project, dirty/revisions, selection and all Undo/Redo snapshots")
  let _=test.done(suite)

  let _=test.start(suite,"Minimum window exposes and selects the formerly unreachable bottom track")
  let _=ref.swap(state,fixture(root))
  let small: layout.Frame=layout.frame(640.0,480.0)
  let _=app.set_track_scroll(state,1000,layout.height_of(small.timeline))
  var model: timeline.Timeline=painter.timeline_model(state,small.timeline)
  let bottom: f64=timeline.track_top(model,23)
  let _=test.check(suite,bottom>=small.timeline.top and bottom+46.0<=small.timeline.bottom,"Bottom lane fits the actual body at minimum size")
  let _=input.pointer_down(state,640.0,480.0,timeline.frame_to_x(model,20),bottom+10.0)
  let _=test.eq_u64(suite,app.current_clip(state),5,"Click selects the authored bottom-lane clip")
  let _=test.eq_i64(suite,editor.playhead(struct.borrow(state,field=document)),7,"Selecting a lane does not scrub time")
  app.end_gesture(state)
  let prior: u64=app.current_clip(state)
  let _=input.pointer_down(state,640.0,480.0,small.timeline.left+20.0,small.timeline.bottom+10.0)
  let _=test.eq_u64(suite,app.current_clip(state),prior,"Lane footer accepts no clipped clip gesture")
  var controls: array<chrome.Control> = chrome.track_controls(small,state,model)
  var at: u64=0
  var contained: bool=true
  loop {if at>=array.len(controls) {break}
    let entry: ref<chrome.Control> = array.borrow(controls,at)
    if entry.domain==chrome.domain_track() {
      contained=contained and entry.area.top>=small.headers.top and entry.area.bottom<=small.timeline.bottom
    }
    at=at+1
  }
  let _=test.check(suite,contained,"Every per-lane hit target is inside the visible header body")
  let _=test.done(suite)

  let _=test.start(suite,"Frame strips and audio peaks follow their distinct scrolled lanes")
  let _=ref.swap(state,fixture(root))
  let _=app.set_track_scroll(state,1000,layout.height_of(frame.timeline))
  let _=ref.swap(model,painter.timeline_model(state,frame.timeline))
  let y: f64=timeline.track_top(model,23)
  var image: draw.Surface=painted(state,1600,980)
  let _=test.check(suite,pixel(image,frame.timeline.left+30.0,y+40.0,draw.rgb(12,240,30)),"Cached thumbnail paints in the reached bottom lane")
  let _=test.check(suite,not pixel(image,frame.timeline.left+96.0,y+23.0,draw.rgb(150,224,196)),"Legacy V-lane waveform cache never overlays frame strips")
  let audio_y: f64=timeline.track_top(model,22)
  let _=test.check(suite,pixel(image,frame.timeline.left+96.0,audio_y+23.0,draw.rgb(215,255,236)),"Validated visual reference paints on the independently authored A lane")
  let _=test.check(suite,pixel(image,timeline.frame_to_x(model,60),y+23.0,draw.rgb(206,122,74)),"Transition seam paints over its authored lane")
  let header_body: f64=frame.timeline.bottom
  let colors: painter.Theme = painter.theme(state)
  let _=test.check(suite,pixel(image,frame.timeline.left+30.0,header_body+10.0,colors.background),"Clipped lane pixels do not paint into footer space")
  let seam: editor.Transition=array.get(struct.borrow(struct.borrow(state,field=document),field=transitions),0)
  let badge: layout.Rect=option.unwrap(painter.transition_bounds(state,frame.timeline,seam.id))
  let _=test.check(suite,seam.track==4 and badge.top==y+4.0 and badge.bottom==y+18.0 and badge.top>=frame.timeline.top and badge.bottom<=frame.timeline.bottom,"Scrolled transition badge stays in the reached video lane")
  let badge_x: f64=badge.right-3.0
  let badge_y: f64=badge.bottom-3.0
  let _=test.check(suite,pixel(image,badge_x,badge_y,colors.panel_head),"Scrolled unselected badge paints inside its non-label hit region")
  let _=test.eq_u64(suite,option.unwrap(painter.transition_hit(state,frame.timeline,badge_x,badge_y)),seam.id,"Scrolled badge hit resolves the same authored seam")
  let _=input.pointer_down(state,1600.0,980.0,badge_x,badge_y)
  let _=test.eq_u64(suite,app.current_transition(state),seam.id,"Actual scrolled badge click selects its stable transition ID")
  let _=test.done(suite)

  let _=test.start(suite,"Resize, sequence switch, hidden tracks and removal derive live clamped bounds")
  let _=ref.swap(state,fixture(root))
  let _=app.set_track_scroll(state,1000,layout.height_of(small.timeline))
  let small_first: u64=app.track_scroll(state)
  let _=ref.swap(model,painter.timeline_model(state,frame.timeline))
  let _=test.check(suite,app.track_scroll(state)<small_first and app.track_scroll(state)==app.track_scroll_max(state,layout.height_of(frame.timeline)),"Larger window clamps an existing bottom scroll")
  let _=editor.set_track_hidden(struct.borrow(state,field=document),4,true)
  let hidden_first: u64=app.track_scroll(state)
  let _=ref.swap(model,painter.timeline_model(state,frame.timeline))
  let _=test.eq_u64(suite,app.track_scroll(state),hidden_first,"Hidden lanes retain reachable unhide controls")
  let removed: commands.Result=commands.remove_track(state,4)
  let _=ref.swap(model,painter.timeline_model(state,frame.timeline))
  let _=test.check(suite,removed.ok and app.track_scroll(state)==app.track_scroll_max(state,layout.height_of(frame.timeline)),"Removing a bottom track clamps the live lane count")
  let undone: commands.Result=commands.undo(state)
  let _=ref.swap(model,painter.timeline_model(state,frame.timeline))
  let _=test.check(suite,undone.ok and match editor.track_slot(struct.borrow(state,field=document),4) {some(_)=>true,none=>false,},"Undo restores the removed authored lane")
  let before_add: u64=app.track_scroll_max(state,layout.height_of(frame.timeline))
  let added: commands.Result=commands.add_track(state,editor.track_audio(),"Reachable new audio lane")
  let _=ref.swap(model,painter.timeline_model(state,frame.timeline))
  let _=test.check(suite,added.ok and app.track_scroll_max(state,layout.height_of(frame.timeline))==before_add+1,"Adding an audio lane expands reachable live bounds")
  let _=app.set_track_scroll(state,1000,layout.height_of(frame.timeline))
  let _=ref.swap(model,painter.timeline_model(state,frame.timeline))
  let _=test.eq_u64(suite,app.track_scroll(state),before_add+1,"New bottom audio lane is reachable")
  let undone_add: commands.Result=commands.undo(state)
  let _=ref.swap(model,painter.timeline_model(state,frame.timeline))
  let _=test.check(suite,undone_add.ok and app.track_scroll(state)==before_add,"Undoing added lane clamps the formerly valid bottom offset")
  let child: u64=struct.get(array.borrow(struct.borrow(struct.borrow(state,field=document),field=sequences),1),field=id)
  let _=editor.set_active(struct.borrow(state,field=document),child)
  let _=ref.swap(model,painter.timeline_model(state,frame.timeline))
  let _=test.eq_u64(suite,app.track_scroll(state),0,"Switching to a short sequence resets lane navigation")
  let _=test.eq_u64(suite,app.track_scroll_max(state,layout.height_of(frame.timeline)),0,"Short sequence has no unreachable lanes")
  let _=editor.set_active(struct.borrow(state,field=document),2)
  let _=ref.swap(model,painter.timeline_model(state,frame.timeline))
  let _=test.eq_u64(suite,app.track_scroll(state),0,"Returning to another sequence begins at its first lane")
  let _=test.done(suite)
  let _=test.start(suite,"Fit shows every frame of the76701-frame clip across logical window sizes")
  var long_state: app.App=long_fixture(root,76701,0)
  let before_fit: string=authored(long_state)
  var widths: array<f64> = [640.0,1600.0,1920.0]
  var width_index: u64=0
  loop {if width_index>=array.len(widths) {break}
    let width: f64=array.get(widths,width_index)
    let fitted: layout.Frame=layout.frame(width,980.0)
    let _=app.set_scroll(long_state,1234)
    let _=test.eq_str(suite,fit(long_state,width,980.0),"Fitted to project","Actual Fit control reports success")
    var fitted_model: timeline.Timeline=painter.timeline_model(long_state,fitted.timeline)
    let _=test.check(suite,app.scroll(long_state)==0 and app.zoom(long_state)<0.05,"Fit resets origin and permits the needed long-project scale")
    let _=test.near_f64(suite,timeline.frame_to_x(fitted_model,76701),fitted.timeline.right,0.000001,"Full clip endpoint reaches the visible right edge")
    let range: i64=app.visible_span(long_state,layout.width_of(fitted.timeline))
    let _=test.check(suite,range>=76701 and range<=76702,"Rounded request includes the final frame without expanding more than one frame")
    width_index=width_index+1
  }
  let _=test.eq_str(suite,authored(long_state),before_fit,"Fit and resize preserve selection, authored bytes, revisions, dirty and nonempty Redo")
  let _=test.done(suite)

  let _=test.start(suite,"Sparse billion-frame Fit retains distant ruler ticks and seek mapping")
  let _=ref.swap(long_state,long_fixture(root,60,999999940))
  let sparse_authored: string=authored(long_state)
  let _=test.eq_str(suite,fit(long_state,1600.0,980.0),"Fitted to project","Sparse project uses the same actual Fit control")
  var sparse_model: timeline.Timeline=painter.timeline_model(long_state,frame.timeline)
  let _=test.near_f64(suite,timeline.frame_to_x(sparse_model,1000000000),frame.timeline.right,0.000001,"Sparse final clip remains inside full-duration Fit")
  let stride: i64=painter.ruler_stride(60.0,app.zoom(long_state))
  let stride_f: f64=cast.float(stride)
  let _=test.check(suite,stride>60 and stride_f*app.zoom(long_state)>=6.0,"Distant ticks skip empty seconds with at least six logical pixels spacing")
  let _=test.check(suite,app.visible_span(long_state,layout.width_of(frame.timeline))/stride<4096,"Full ruler requires a bounded visible tick count")
  let last_tick: i64=(1000000000/stride)*stride
  let last_x: f64=timeline.frame_to_x(sparse_model,last_tick)
  var sparse_image: draw.Surface=painted(long_state,1600,980)
  let sparse_colors: painter.Theme=painter.theme(long_state)
  let ink: bool=not pixel(sparse_image,last_x-1.0,frame.ruler.bottom-4.0,sparse_colors.timeline) or
    not pixel(sparse_image,last_x,frame.ruler.bottom-4.0,sparse_colors.timeline) or
    not pixel(sparse_image,last_x+1.0,frame.ruler.bottom-4.0,sparse_colors.timeline)
  let _=test.check(suite,last_tick>990000000 and ink,"Actual painted ruler contains a distant tick near the project end")
  let _=test.eq_str(suite,authored(long_state),sparse_authored,"Distant Fit and paint leave authored state and history intact")
  let _=app.set_scroll(long_state,700000000)
  let _=ref.swap(sparse_model,painter.timeline_model(long_state,frame.timeline))
  let target_x: f64=timeline.frame_to_x(sparse_model,800000000)
  let _=input.pointer_down(long_state,1600.0,980.0,target_x,frame.ruler.top+5.0)
  let _=input.pointer_up(long_state,1600.0,980.0,target_x,frame.ruler.top+5.0)
  let landed: i64=editor.playhead(struct.borrow(long_state,field=document))
  let _=test.check(suite,landed>=799999999 and landed<=800000001,"Panned ruler pointer resolves the distant authored frame within rounding")
  let _=test.done(suite)

  let _=test.start(suite,"Invalid zooms and signed-endpoint ranges remain finite and bounded")
  let valid_zoom: f64=app.zoom(long_state)
  let _=test.near_f64(suite,app.set_zoom(long_state,math.nan()),valid_zoom,0.0,"NaN cannot poison timeline geometry")
  let _=test.near_f64(suite,app.set_zoom(long_state,math.infinity()),valid_zoom,0.0,"Infinity preserves the last usable zoom")
  let _=app.set_zoom(long_state,0.0)
  let _=test.check(suite,app.zoom(long_state)>0.0 and math.is_finite(1.0/app.zoom(long_state)),"Minimum scale is positive with a finite reciprocal")
  let _=app.set_scroll(long_state,9223372036854775800)
  let _=test.eq_i64(suite,app.visible_span(long_state,1000.0),7,"Requested range reserves space for its signed frame origin")
  let _=test.eq_i64(suite,app.visible_span(long_state,math.infinity()),0,"Nonfinite width yields no request")
  let _=test.eq_i64(suite,app.visible_span(long_state,-1.0),0,"Negative width yields no request")
  let _=app.set_scroll(long_state,9223372036854775807)
  let _=test.eq_i64(suite,app.visible_span(long_state,1000.0),0,"Exhausted signed endpoint yields no wrapping request")
  let _=app.set_zoom(long_state,100.0)
  let _=test.near_f64(suite,app.zoom(long_state),40.0,0.0,"Close zoom retains the established upper limit")
  let _=test.check(suite,painter.ruler_stride(60.0,1.0)>0 and painter.ruler_stride(60.0,app.set_zoom(long_state,0.0))>0,"Ruler stride remains positive at both zoom extremes")
  let boundary_authored: string=authored(long_state)
  let boundary_zoom: f64=app.zoom(long_state)
  let boundary_lane: u64=app.track_scroll(long_state)
  let _=app.set_scroll(long_state,9223372036854775802)
  let _=input.wheel(long_state,1600.0,980.0,frame.timeline.left+20.0,frame.timeline.top+10.0,true,1,false)
  let _=test.eq_i64(suite,app.scroll(long_state),9223372036854775807,"Plain body wheel saturates near the signed endpoint")
  let _=input.wheel(long_state,1600.0,980.0,frame.timeline.left+20.0,frame.timeline.top+10.0,false,1,false)
  let _=test.eq_i64(suite,app.scroll(long_state),9223372036854775795,"Upward wheel retreats from the saturated endpoint")
  let _=input.wheel(long_state,1600.0,980.0,frame.timeline.left+20.0,frame.timeline.top+10.0,true,4294967295,false)
  let _=test.eq_i64(suite,app.scroll(long_state),9223372036854775807,"Largest event line count cannot wrap scroll")
  let _=test.check(suite,app.zoom(long_state)==boundary_zoom and app.track_scroll(long_state)==boundary_lane,"Endpoint panning preserves zoom and lane offset")
  let _=test.eq_str(suite,authored(long_state),boundary_authored,"Endpoint panning preserves complete document, revision, dirty, selection and history")
  let _=test.done(suite)
  let _=test.start(suite,"Program page following retains a page and respects manual and Source ownership")
  let _=test.eq_i64(suite,follow.page(359,0,360,true,false),0,"Every presented frame inside one page keeps strips unchanged")
  let _=test.eq_i64(suite,follow.page(360,0,360,true,false),360,"The first frame outside the right edge opens the next page")
  let _=test.eq_i64(suite,follow.page(1860,0,360,true,false),1800,"A distant Program time advances directly to its containing page")
  let _=test.eq_i64(suite,follow.page(1861,1800,360,true,false),1800,"Subsequent frames do not cause per-frame strip requests")
  let _=test.eq_i64(suite,follow.page(0,1800,360,true,false),0,"Start returns the timeline to its first page")
  let _=test.eq_i64(suite,follow.page(1081,1800,360,true,false),1080,"Backward navigation opens its containing page")
  let _=test.eq_i64(suite,follow.page(1860,12,360,false,false),12,"Manual panning is retained until following is rearmed")
  let _=test.eq_i64(suite,follow.page(1860,12,360,true,true),12,"Source playback cannot move the Program timeline")
  let _=test.eq_i64(suite,follow.page(1860,12,0,true,false),12,"No usable geometry means no viewport request")
  let _=test.eq_i64(suite,follow.page(-1,12,360,true,false),12,"Unavailable picture does not move the timeline")
  let _=test.eq_i64(suite,follow.page(9223372036854775807,9223372036854775800,7,true,false),9223372036854775807,"Page arithmetic at the signed endpoint cannot overflow")
  let _=test.done(suite)

  let _=test.start(suite,"Follow is discoverable and real input preserves manual pause and Source behavior")
  var followed_state:app.App=fixture(root)
  let follow_before:string=authored(followed_state)
  let _=test.check(suite,followed_state.timeline_follow_program,"Program follows by default")
  var follow_controls:array<chrome.Control> =chrome.timeline_bar(frame,followed_state)
  var follow_area:layout.Rect=layout.rect(0.0,0.0,0.0,0.0)
  var follow_on:bool=false
  var follow_index:u64=0
  loop {if follow_index>=array.len(follow_controls) {break}
    let entry:ref<chrome.Control> =array.borrow(follow_controls,follow_index)
    if entry.action==chrome.act_follow() {follow_area=entry.area
      follow_on=entry.on and entry.style==chrome.style_toggle() and entry.enabled}
    follow_index=follow_index+1}
  let _=test.check(suite,layout.width_of(follow_area)>0.0 and follow_on,"Timeline builds a highlighted enabled Follow toggle")
  let _=input.pointer_down(followed_state,1600.0,980.0,(follow_area.left+follow_area.right)*0.5,(follow_area.top+follow_area.bottom)*0.5)
  let _=test.check(suite,not followed_state.timeline_follow_program,"Shared Follow hit-testing disables following")
  let _=test.eq_str(suite,authored(followed_state),follow_before,"Follow toggle preserves authored graph, history and revisions")
  app.set_open_menu(followed_state,chrome.menu_view())
  var follow_menu:array<chrome.Control> =chrome.menu_popup(frame,followed_state)
  var found_follow:bool=false
  follow_index=0
  loop {if follow_index>=array.len(follow_menu) {break}
    let entry:ref<chrome.Control> =array.borrow(follow_menu,follow_index)
    if entry.action==chrome.act_follow() {found_follow=entry.enabled and not entry.on}
    follow_index=follow_index+1}
  let _=test.check(suite,found_follow,"View menu reflects suspended Follow state")
  app.set_open_menu(followed_state,chrome.menu_none())
  struct.set(followed_state,true,field=timeline_follow_program)
  let _=input.wheel(followed_state,1600.0,980.0,frame.timeline.left+20.0,frame.timeline.top+10.0,true,1,false)
  let _=test.check(suite,app.scroll(followed_state)==12 and not followed_state.timeline_follow_program,"Actual horizontal pan visibly suspends Follow")
  let _=editor.program_action(struct.borrow(followed_state,field=document),editor.play())
  app.set_focus(followed_state,app.panel_program())
  let _=input.key(followed_state,widgets.key_space(),false,false)
  let _=test.check(suite,not followed_state.timeline_follow_program and not editor.playing(struct.borrow(followed_state,field=document)),"Pause retains manual viewport ownership")
  let _=input.key(followed_state,widgets.key_space(),false,false)
  let _=test.check(suite,followed_state.timeline_follow_program,"Explicit Program Play rearms Follow")
  struct.set(followed_state,false,field=timeline_follow_program)
  let _=input.key(followed_state,widgets.key_home(),false,false)
  let _=test.check(suite,followed_state.timeline_follow_program and editor.playhead(struct.borrow(followed_state,field=document))==0,"Start rearms Follow at the actual beginning")
  struct.set(followed_state,false,field=timeline_follow_program)
  let _=input.key(followed_state,widgets.key_end(),false,false)
  let _=test.check(suite,followed_state.timeline_follow_program and followed_state.endpoint_end_requested,"End rearms but remains deferred until endpoint acceptance")
  struct.set(followed_state,false,field=timeline_follow_program)
  var stop_controls:array<chrome.Control> =chrome.monitor_controls(frame,followed_state,false)
  var stop_area:layout.Rect=layout.rect(0.0,0.0,0.0,0.0)
  follow_index=0
  loop {if follow_index>=array.len(stop_controls) {break}
    let entry:ref<chrome.Control> =array.borrow(stop_controls,follow_index)
    if entry.action==chrome.act_stop() {stop_area=entry.area}
    follow_index=follow_index+1}
  let _=input.pointer_down(followed_state,1600.0,980.0,(stop_area.left+stop_area.right)*0.5,(stop_area.top+stop_area.bottom)*0.5)
  let _=test.check(suite,layout.width_of(stop_area)>0.0 and not followed_state.timeline_follow_program and not editor.playing(struct.borrow(followed_state,field=document)),"Actual Stop retains manual viewport ownership")
  let _=input.pointer_down(followed_state,1600.0,980.0,frame.ruler.left+96.0,(frame.ruler.top+frame.ruler.bottom)*0.5)
  let _=input.pointer_up(followed_state,1600.0,980.0,frame.ruler.left+96.0,(frame.ruler.top+frame.ruler.bottom)*0.5)
  let _=test.check(suite,followed_state.timeline_follow_program and editor.playhead(struct.borrow(followed_state,field=document))>0 and not app.endpoint_requested(followed_state),"Actual Program ruler seek rearms Follow and lands before authored end")
  struct.set(followed_state,false,field=timeline_follow_program)
  let source_open:commands.Result=commands.open_source(followed_state,3)
  let _=test.check(suite,source_open.ok,"Source navigation fixture opens its actual authored source")
  app.set_focus(followed_state,app.panel_source())
  let _=input.key(followed_state,widgets.key_space(),false,false)
  let _=test.check(suite,not followed_state.timeline_follow_program and struct.get(struct.borrow(struct.borrow(followed_state,field=document),field=monitor),field=playing),"Actual Source Play never rearms Program following")
  let _=test.done(suite)

  let _=test.start(suite,"Timeline following uses the shared completed-picture coordinate")
  let _=test.check(suite,follow.allowed(true,false,false,false,true,17,true),"Current completed Program picture owns page following")
  let _=test.check(suite,not follow.allowed(true,false,false,false,true,-1,true),"Matching zero revisions cannot pan before an actual picture")
  let _=test.check(suite,not follow.allowed(true,false,false,false,true,17,false),"Retired picture revision cannot pan a new document")
  let _=test.check(suite,follow.allowed(true,false,false,false,false,-1,false),"Paused actual navigation does not require an asynchronous completed picture")
  let _=test.check(suite,not follow.allowed(true,false,true,false,false,17,true) and not follow.allowed(true,false,false,true,false,17,true),"Active pointer and pending endpoint retain viewport ownership")
  let _=test.check(suite,not follow.allowed(true,true,false,false,false,17,true) and not follow.allowed(false,false,false,false,false,17,true),"Source and explicit manual state never permit page following")
  var positioned:app.App=fixture(root)
  let _=editor.seek(struct.borrow(positioned,field=document),31)
  let _=editor.program_action(struct.borrow(positioned,field=document),editor.play())
  struct.set(positioned,17,field=presented_program_frame)
  let _=test.eq_i64(suite,app.timeline_frame(positioned),17,"Playing timeline shares completed Program picture rather than requested clock frame")
  let _=test.eq_i64(suite,follow.page(app.timeline_frame(positioned),0,20,true,false),0,"Decode ahead cannot prematurely pan the page")
  struct.set(positioned,21,field=presented_program_frame)
  let _=test.eq_i64(suite,follow.page(app.timeline_frame(positioned),0,20,true,false),20,"A completed Program crossing pans exactly once")
  let _=editor.program_action(struct.borrow(positioned,field=document),editor.pause())
  let _=test.eq_i64(suite,app.timeline_frame(positioned),31,"Paused navigation uses actual Program transport position")
  let nav_edit:commands.Result=commands.set_clip_field(positioned,5,"gain",0.5)
  let nav_undo:commands.Result=commands.undo(positioned)
  let _=test.check(suite,nav_edit.ok and nav_undo.ok and array.len(struct.borrow(struct.borrow(positioned,field=history),field=redo))>0,"Painted marker navigation starts with a real Redo ledger")
  let _=editor.seek(struct.borrow(positioned,field=document),31)
  let _=editor.program_action(struct.borrow(positioned,field=document),editor.play())
  struct.set(positioned,17,field=presented_program_frame)
  let navigation_before:string=authored(positioned)
  var marker_model:timeline.Timeline=painter.timeline_model(positioned,frame.timeline)
  let marker_x:f64=timeline.frame_to_x(marker_model,marker_model.playhead)
  let marker_y:f64=frame.timeline.top+20.0
  let _=input.pointer_down(positioned,1600.0,980.0,marker_x,marker_y)
  let _=test.check(suite,app.gesture_kind(positioned)==app.drag_scrub() and editor.playhead(struct.borrow(positioned,field=document))==17 and not editor.playing(struct.borrow(positioned,field=document)),"Clicking the painted17 marker scrubs17 rather than the requested31 clip")
  let _=input.pointer_up(positioned,1600.0,980.0,marker_x,marker_y)
  let _=test.check(suite,app.gesture_kind(positioned)==app.drag_none() and editor.playhead(struct.borrow(positioned,field=document))==17,"Painted marker release retires its gesture at the exact landed frame")
  // Normalize only the expected transport navigation before full authored comparison.
  let _=editor.seek(struct.borrow(positioned,field=document),31)
  let _=editor.program_action(struct.borrow(positioned,field=document),editor.play())
  let _=test.eq_str(suite,authored(positioned),navigation_before,"Painted marker seeking preserves exact graph, revisions, dirty, selection and Undo/Redo")
  let _=commands.open_source(positioned,3)
  app.set_focus(positioned,app.panel_source())
  let _=input.key(positioned,widgets.key_space(),false,false)
  let _=test.check(suite,not editor.playing(struct.borrow(positioned,field=document)) and app.timeline_frame(positioned)==31 and positioned.presented_program_frame==17,"Source Play pauses Program; paused timeline uses authored position while held Program picture remains explicit")
  let _=test.check(suite,not follow.allowed(true,true,false,false,false,17,true),"Source ownership suppresses viewport follow during that paused-coordinate distinction")
  let _=test.done(suite)
  test.conclude(suite,path.join(root,"timeline-track-scroll-tests.json"),11)
}
