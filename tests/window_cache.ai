module genesis.tests.window_cache
import std.editor as editor
import std.editor_io as editor_io
import std.files as files
import std.path as path
import std.testing as test
import std.text as text
import std.widgets as widgets
import "../src/app.ai" as app
import "../src/chrome.ai" as chrome
import "../src/commands.ai" as commands
import "../src/input.ai" as input
import "../src/layout.ai" as layout
import "../src/provider.ai" as provider
import "../src/timeline_media.ai" as media
import "../src/picture_queue.ai" as pictures
import "../src/window_cache.ai" as cache
import "../src/window_profile.ai" as profile
import "editor_split.ai" as split_tests

fn audio_matches(suite: ref<test.Suite>, state: ref<app.App>, saved: ref<cache.Cache>) -> unit effects {alloc} {
  let expected: string = media.audio_signature(struct.borrow(state,field=document))
  let _ = test.check(suite,str.eq(str.view(expected),struct.borrow(saved,field=audio)),"Cached mix equals independently rebuilt actual document mix")
  ()
}
fn changed(suite: ref<test.Suite>, state: ref<app.App>, saved: ref<cache.Cache>, revision: u64, key: str) -> unit effects {alloc} {
  let _ = test.check(suite,state.document_revision > revision,"Actual document mutation advances explicit revision")
  let _ = test.check(suite,pictures.identity_revision(state,false,true) != key,"Prepared snapshot identity retires previous content")
  let _ = test.check(suite,cache.refresh(state,saved),"Mix facts refresh after mutation")
  audio_matches(suite,state,saved)
  ()
}
fn parameter(state: ref<app.App>) -> layout.Rect effects {alloc} {
  var controls: array<chrome.Control> = chrome.properties_panel(layout.frame(1600.0,980.0),state)
  var i: u64 = 0
  loop {if i >= array.len(controls) {break}
    let control: ref<chrome.Control> = array.borrow(controls,i)
    if control.action == chrome.act_param_set() and chrome.kind_of(control) == "size_position" and chrome.name_of(control) == "x" {return control.area}
    i=i+1}
  layout.Rect {left:0.0,top:0.0,right:0.0,bottom:0.0}
}
fn encoded(doc: ref<editor.Document>) -> string effects {alloc} {
  match editor_io.encode(doc) {ok(value)=>value,err(_)=>string.copy("encode failed"),}
}
fn history_bytes(history: ref<editor.History>) -> string effects {alloc} {
  var out: string = string.copy("undo\n")
  var i: u64 = 0
  loop {if i >= editor.undo_depth(history) {break}
    string.append(out,encoded(array.borrow(struct.borrow(history,field=undo),i)))
    string.append(out,"\n")
    i=i+1}
  string.append(out,"redo\n")
  i=0
  loop {if i >= editor.redo_depth(history) {break}
    string.append(out,encoded(array.borrow(struct.borrow(history,field=redo),i)))
    string.append(out,"\n")
    i=i+1}
  out
}
fn edit_transactions(suite: ref<test.Suite>, root: str) -> unit effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  let _ = test.start(suite,"Refused insert and overwrite preserve occupied clips, history and cache")
  var state: app.App = app.app(provider.fake(root))
  let imported: commands.Result = commands.import_media(state,"transaction.mov","Transaction source")
  let track: u64 = app.default_video_track(state)
  let original: commands.Result = commands.append_clip(state,track,imported.value,0,60)
  let _ = commands.select_only(state,original.value)
  struct.set(struct.borrow(state,field=document),editor.bounds_reject(),field=source_bounds)
  let _ = commands.set_clip_field(state,original.value,"gain",0.5)
  let _ = commands.undo(state)
  app.mark_dirty(state,false)
  var saved: cache.Cache = cache.cache()
  let _ = cache.refresh(state,saved)
  let before: string = encoded(struct.borrow(state,field=document))
  let old_history: string = history_bytes(struct.borrow(state,field=history))
  let revision: u64 = state.document_revision
  let key: string = pictures.identity_revision(state,false,true)
  let _ = test.check(suite,editor.redo_depth(struct.borrow(state,field=history))>0,"Fixture contains actual redo snapshots before refused edits")
  var operation: u64 = 0
  loop {if operation >= 2 {break}
    let refused: commands.Result = if operation == 0 {commands.insert_clip(state,track,imported.value,1000000,10,20)}
      else {commands.overwrite_clip(state,track,imported.value,1000000,10,20)}
    let _ = test.check(suite,not refused.ok,"Out-of-range source inside occupied content is refused")
    let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),before,"Full document including clip selection, filters and IDs is byte-for-byte unchanged")
    let _ = test.eq_str(suite,history_bytes(struct.borrow(state,field=history)),old_history,"Every undo and redo snapshot remains unchanged")
    let _ = test.eq_u64(suite,state.document_revision,revision,"Refusal preserves semantic revision")
    let _ = test.eq_str(suite,pictures.identity_revision(state,false,true),key,"Refusal preserves prepared preview identity")
    let _ = test.check(suite,not app.dirty(state) and not cache.refresh(state,saved),"Refusal neither dirties saved state nor rebuilds cached mix")
    operation=operation+1}
  operation=0
  loop {if operation >= 2 {break}
    let depth: u64 = editor.undo_depth(struct.borrow(state,field=history))
    let revision_before: u64 = state.document_revision
    let committed: commands.Result = if operation == 0 {commands.insert_clip(state,track,imported.value,0,10,20)}
      else {commands.overwrite_clip(state,track,imported.value,0,10,20)}
    let _ = test.check(suite,committed.ok,"Legal edit inside occupied content succeeds")
    let _ = test.eq_u64(suite,editor.undo_depth(struct.borrow(state,field=history)),depth+1,"Successful edit captures exactly one original snapshot")
    let _ = test.eq_u64(suite,editor.redo_depth(struct.borrow(state,field=history)),0,"Committed edit clears redo")
    let _ = test.eq_u64(suite,state.document_revision,revision_before+1,"Committed edit invalidates exactly once")
    let after: string = encoded(struct.borrow(state,field=document))
    let _ = test.check(suite,after != before and editor.clip_count(struct.borrow(state,field=document)) == 3,"Successful edit commits the actual split and placed clip")
    let undone: commands.Result = commands.undo(state)
    let _ = test.check(suite,undone.ok,"Successful edit can be undone")
    let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),before,"Undo restores complete original document")
    let redone: commands.Result = commands.redo(state)
    let _ = test.check(suite,redone.ok,"Successful edit can be redone")
    let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),after,"Redo restores complete committed document")
    let _ = commands.undo(state)
    operation=operation+1}
  let _ = test.done(suite)
  ()
}
pub fn main(args: view<str>) -> i32 effects {alloc,env,fs.meta,fs.read,fs.write,io.write,process,time} {
  if view.len(args) < 2 {return 2}
  let root: str = view.get(args,1)
  let _ = files.mkdirs(root)
  var suite: test.Suite = test.suite("Native window semantic cache",true)
  edit_transactions(suite,root)
  split_tests.run(suite,root)
  var state: app.App = app.app(provider.fake(root))
  let imported: commands.Result = commands.import_media(state,"window.mov","Window source")
  let second: commands.Result = commands.import_media(state,"second.mov","Second source")
  let clip: commands.Result = commands.append_clip(state,app.default_video_track(state),imported.value,0,60)
  let audio_clip: commands.Result = commands.append_clip(state,app.default_audio_track(state),imported.value,0,60)
  let _ = commands.select_only(state,clip.value)
  let _ = commands.open_source(state,imported.value)
  var saved: cache.Cache = cache.cache()
  let _ = test.start(suite,"Heard-clock ticks reuse content and mix without a save-state dependency")
  let _ = test.check(suite,cache.refresh(state,saved),"First mix builds once")
  let revision: u64 = state.document_revision
  let key: string = pictures.identity_revision(state,false,true)
  let _ = commands.program(state,editor.play())
  var ticks: u64 = 0
  var reused: bool = true
  loop {if ticks >= 6000 {break}
    let _ = editor.seek(struct.borrow(state,field=document),cast.sat(ticks%60))
    app.mark_dirty(state,ticks%2 == 0)
    if cache.refresh(state,saved) or pictures.identity_revision(state,false,true) != key {reused=false}
    ticks=ticks+1}
  let _ = test.check(suite,reused,"6000 heard ticks and changing dirty flags reuse snapshot and mix")
  let _ = test.eq_u64(suite,saved.rebuilds,1,"No mix reconstruction during playback ticks")
  let _ = test.eq_u64(suite,state.document_revision,revision,"Transport does not become an edit")
  let _ = commands.program(state,editor.pause())
  let paused: string = pictures.identity_revision(state,false,false)
  let _ = commands.seek(state,12)
  let _ = test.check(suite,pictures.identity_revision(state,false,false) != paused,"Paused seek invalidates its exact picture")
  let _ = test.check(suite,not cache.refresh(state,saved),"Paused seek preserves sound facts")
  let _ = test.done(suite)

  let _ = test.start(suite,"Edits, undo, redo and live slider cancellation invalidate real state")
  var old_revision: u64 = state.document_revision
  var old_key: string = pictures.identity_revision(state,false,true)
  let original_mix: string = string.copy(struct.borrow(saved,field=audio))
  let gain: commands.Result = commands.set_clip_field(state,audio_clip.value,"gain",0.25)
  let _ = test.check(suite,gain.ok,"Audio edit succeeds")
  changed(suite,state,saved,old_revision,old_key)
  let _ = test.check(suite,not str.eq(str.view(original_mix),struct.borrow(saved,field=audio)),"Audible gain changes actual mix")
  old_revision=state.document_revision
  old_key=pictures.identity_revision(state,false,true)
  let _ = commands.undo(state)
  changed(suite,state,saved,old_revision,old_key)
  let _ = test.check(suite,str.eq(str.view(original_mix),struct.borrow(saved,field=audio)),"Undo restores original mix")
  old_revision=state.document_revision
  old_key=pictures.identity_revision(state,false,true)
  let _ = commands.redo(state)
  changed(suite,state,saved,old_revision,old_key)
  let preserved_mix: string = string.copy(struct.borrow(saved,field=audio))
  app.set_dock_tab(state,chrome.tab_properties())
  let bar: layout.Rect = parameter(state)
  let _ = test.check(suite,layout.width_of(bar)>0.0,"Actual inspector slider exists")
  let y: f64 = (bar.top+bar.bottom)*0.5
  old_revision=state.document_revision
  old_key=pictures.identity_revision(state,false,true)
  let _ = input.pointer_down(state,1600.0,980.0,bar.left+layout.width_of(bar)*0.25,y)
  changed(suite,state,saved,old_revision,old_key)
  let filter: u64 = chrome.filter_of_kind(struct.borrow(state,field=document),clip.value,"size_position")
  let _ = test.check(suite,filter != 0 and app.parameter_dragging(state),"Press materializes actual filter and begins live drag")
  old_revision=state.document_revision
  old_key=pictures.identity_revision(state,false,true)
  let _ = input.pointer_move(state,1600.0,980.0,bar.left+layout.width_of(bar)*0.75,y)
  changed(suite,state,saved,old_revision,old_key)
  let _ = test.near_f64(suite,editor.filter_param(struct.borrow(state,field=document),filter,"x",-1.0),0.5,0.00001,"Live drag actually changes project position")
  let _ = test.check(suite,str.eq(str.view(preserved_mix),struct.borrow(saved,field=audio)),"Picture-only drag leaves sound signature unchanged")
  old_revision=state.document_revision
  old_key=pictures.identity_revision(state,false,true)
  let _ = input.key(state,widgets.key_escape(),false,false)
  changed(suite,state,saved,old_revision,old_key)
  let _ = test.eq_u64(suite,editor.filter_count(struct.borrow(state,field=document),clip.value),0,"Escape restores pre-drag document")
  let _ = test.check(suite,not app.parameter_dragging(state),"Cancellation ends live drag")
  let _ = test.done(suite)

  let _ = test.start(suite,"Source, media, saved project and replacement preserve independent identities")
  old_revision=state.document_revision
  old_key=pictures.identity_revision(state,false,true)
  let _ = commands.open_source(state,second.value)
  let _ = test.check(suite,pictures.identity_revision(state,false,true) != old_key,"Different Source retires pixels without a content edit")
  let _ = test.eq_u64(suite,state.document_revision,old_revision,"Source choice remains independent of document revision")
  let selected: string = pictures.identity_revision(state,false,true)
  let _ = commands.monitor(state,editor.step_forward())
  let _ = test.check(suite,pictures.identity_revision(state,false,true) != selected,"Parked source time retires old monitor pixels")
  old_key=pictures.identity_revision(state,false,true)
  app.mark_media_changed(state)
  let _ = test.check(suite,pictures.identity_revision(state,false,true) != old_key,"External Reload retires old decoded media")
  let _ = test.check(suite,not cache.refresh(state,saved),"External media epoch does not rebuild unchanged wire facts")
  let project: string = path.join(root,"window-cache.air")
  let _ = commands.save_project(state,project)
  let _ = test.eq_u64(suite,state.document_revision,old_revision,"Save clears dirty without changing content")
  old_key=pictures.identity_revision(state,false,true)
  let _ = commands.new_project(state)
  changed(suite,state,saved,old_revision,old_key)
  let _ = test.eq_u64(suite,editor.clip_count(struct.borrow(state,field=document)),0,"New project replaces actual clips")
  let _ = test.check(suite,not app.dirty(state),"New clean project still invalidates cache")
  old_revision=state.document_revision
  old_key=pictures.identity_revision(state,false,true)
  let _ = commands.open_project(state,project)
  changed(suite,state,saved,old_revision,old_key)
  let _ = test.eq_u64(suite,editor.clip_count(struct.borrow(state,field=document)),2,"Open restores actual saved clips")
  let _ = test.check(suite,not app.dirty(state),"Opened clean project still invalidates cache")
  let _ = test.done(suite)
  let _ = test.start(suite,"Native profile writer keeps field order, bounded output and disabled silence")
  let diagnostic: string = path.join(root,"profile-writer.tsv")
  let _ = files.write_text(diagnostic,"")
  var measure: profile.Profile = profile.Profile {enabled:true,path:string.copy(diagnostic),pending:string.new(),rows:49999,buffered:0,previous_ns:321}
  var row: profile.Row = profile.row()
  struct.set(row,11,field=begin)
  struct.set(row,22,field=present_begin)
  struct.set(row,33,field=present_end)
  struct.set(row,44,field=end)
  struct.set(row,123,field=program)
  struct.set(row,456,field=source)
  struct.set(row,789,field=samples_before)
  struct.set(row,790,field=samples_after)
  struct.set(row,42,field=origin)
  struct.set(row,60.0,field=fps)
  struct.set(row,true,field=present_ok)
  struct.set(row,124,field=prepared_first)
  struct.set(row,125,field=prepared_last)
  struct.set(row,126,field=requested_frame)
  struct.set(row,7,field=in_flight)
  struct.set(row,6,field=received)
  struct.set(row,8,field=completed)
  struct.set(row,2,field=overwritten)
  struct.set(row,701,field=window_first_id)
  struct.set(row,702,field=window_last_id)
  struct.set(row,-17,field=window_first_frame)
  struct.set(row,-16,field=window_last_frame)
  struct.set(row,2,field=window_count)
  struct.set(row,6,field=owned_credit)
  struct.set(row,2,field=reserved_credit)
  profile.record(measure,row)
  let report: string = match files.read_text(diagnostic) {ok(value)=>value,err(_)=>string.new(),}
  var fields: array<string> = text.split(report,"\t")
  let _ = test.eq_u64(suite,array.len(fields),46,"Native report preserves 39 original columns and appends exactly seven decode-credit columns")
  let _ = test.check(suite,str.eq(array.borrow(fields,0),"11") and str.eq(array.borrow(fields,1),"22") and str.eq(array.borrow(fields,2),"33") and str.eq(array.borrow(fields,3),"44"),"Monotonic timestamp columns retain their order")
  let _ = test.check(suite,str.eq(array.borrow(fields,8),"123") and str.eq(array.borrow(fields,9),"456"),"Displayed source/program identities remain distinct")
  let _ = test.check(suite,str.eq(array.borrow(fields,12),"789") and str.eq(array.borrow(fields,13),"790") and str.eq(array.borrow(fields,16),"42"),"Before/after device samples and origin retain their order")
  let _ = test.check(suite,str.eq(array.borrow(fields,21),"1") and str.eq(array.borrow(fields,31),"321"),"Presentation success and previous diagnostic overhead retain their order")
  let _ = test.check(suite,str.eq(array.borrow(fields,32),"124") and str.eq(array.borrow(fields,33),"125") and str.eq(array.borrow(fields,34),"126"),"Prepared and requested frame positions remain distinct")
  let _ = test.check(suite,str.eq(array.borrow(fields,35),"7") and str.eq(array.borrow(fields,36),"6") and str.eq(array.borrow(fields,37),"8") and str.eq(array.borrow(fields,38),"2"),"In-flight, received and overwritten completion counts retain their original order")
  let _ = test.eq_str(suite,array.borrow(fields,39),"701","First decode ID is appended at column 39")
  let _ = test.eq_str(suite,array.borrow(fields,40),"702","Last decode ID is appended at column 40")
  let _ = test.eq_str(suite,array.borrow(fields,41),"-17","Signed first frame is appended at column 41")
  let _ = test.eq_str(suite,array.borrow(fields,42),"-16","Signed last frame is appended at column 42")
  let _ = test.eq_str(suite,array.borrow(fields,43),"2","Window count is appended at column 43")
  let _ = test.eq_str(suite,array.borrow(fields,44),"6","Owned picture credit is appended at column 44")
  let _ = test.eq_str(suite,array.borrow(fields,45),"2\n","Reserved picture credit terminates column 45 and the complete row")
  let _ = test.eq_u64(suite,measure.rows,50000,"Last permitted row reaches exact bound")
  let _ = test.eq_u64(suite,measure.buffered,0,"Reaching the cap flushes final partial block")
  profile.record(measure,row)
  let unchanged: string = match files.read_text(diagnostic) {ok(value)=>value,err(_)=>string.new(),}
  let _ = test.check(suite,report == unchanged,"Over-cap rows cannot append or grow output")
  let disabled: string = path.join(root,"disabled-profile.tsv")
  var inactive: profile.Profile = profile.Profile {enabled:false,path:string.copy(disabled),pending:string.new(),rows:0,buffered:0,previous_ns:0}
  profile.record(inactive,row)
  profile.flush(inactive)
  let exists: bool = match files.exists(disabled) {ok(value)=>value,err(_)=>false,}
  let _ = test.check(suite,not exists and inactive.rows == 0,"Disabled profile never creates a file or records rows")
  let poll_path: string = path.join(root,"profile-poll.tsv")
  let _ = files.write_text(poll_path,"")
  var poll_measure: profile.Profile = profile.Profile {enabled:true,path:string.copy(poll_path),pending:string.new(),rows:0,buffered:0,previous_ns:0}
  var poll_row: profile.Row = profile.row()
  profile.context(poll_row,false,true,1234,60.0,18007,22,33)
  profile.record(poll_measure,poll_row)
  profile.flush(poll_measure)
  let poll_report: string = match files.read_text(poll_path) {ok(value)=>value,err(_)=>string.new(),}
  var poll_fields: array<string> = text.split(poll_report,"\t")
  let _ = test.check(suite,str.eq(array.borrow(poll_fields,1),"0") and str.eq(array.borrow(poll_fields,2),"0") and str.eq(array.borrow(poll_fields,21),"0"),"Poll-only row never invents a native presentation")
  let _ = test.check(suite,str.eq(array.borrow(poll_fields,16),"1234") and str.eq(array.borrow(poll_fields,18),"0") and str.eq(array.borrow(poll_fields,19),"1"),"Poll-only iteration retains the actual playing epoch and source mode")
  let _ = test.near_f64(suite,option.unwrap(text.parse_f64(array.borrow(poll_fields,17))),60.0,0.000001,"Poll-only epoch carries the actual timeline fps")
  let _ = test.check(suite,str.eq(array.borrow(poll_fields,39),"0") and str.eq(array.borrow(poll_fields,40),"0"),"Poll-only row does not invent a decode ID window")
  let _ = test.check(suite,str.eq(array.borrow(poll_fields,41),"-1") and str.eq(array.borrow(poll_fields,42),"-1"),"Poll-only row retains unavailable decode-frame sentinels")
  let _ = test.check(suite,str.eq(array.borrow(poll_fields,43),"0") and str.eq(array.borrow(poll_fields,44),"0") and str.eq(array.borrow(poll_fields,45),"0\n"),"Poll-only row does not invent issued or owned decode credit")
  let _ = test.done(suite)
  test.conclude(suite,path.join(root,"window-cache-tests.json"),8)
}
