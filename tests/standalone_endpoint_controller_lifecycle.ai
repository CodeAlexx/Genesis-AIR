module test.standalone_endpoint_controller_lifecycle
import std.editor as editor
import std.editor_io as codec
import std.testing as test
import std.path as path
import std.text as text
import std.draw as draw
import std.files as files
import "../src/picture_queue.ai" as pictures
import "../src/preview_link.ai" as link
import "../src/app.ai" as app
import "../src/commands.ai" as commands
import "../src/provider.ai" as provider
import "../src/audio_endpoint.ai" as endpoint
import "../src/main.ai" as window
import "../src/native_audio.ai" as audio
import "../src/window_cache.ai" as window_cache
fn metadata(authored:i64,actual:i64,fps:f64) -> endpoint.End effects {alloc} {
  endpoint.End {generation:1,authored:authored,actual:actual,frames:match endpoint.frame_end(if authored>actual {authored}else{actual},fps) {ok(v)=>v,err(_)=>0,},fps:fps,roots:array.new()}
}
fn encoded(state:ref<app.App>) -> string effects {alloc} {match codec.encode(struct.borrow(state,field=document)) {ok(v)=>v,err(_)=>string.new(),}}
fn refused(raw:str)->bool effects {alloc} {match endpoint.decode(raw) {err(_)=>true,ok(_)=>false,}}
fn restart_fixture()->app.App effects {alloc} {
  var state:app.App=app.app(provider.fake(""))
  let audio_track:u64=app.default_audio_track(state)
  let video_track:u64=app.default_video_track(state)
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  let source:u64=editor.add_source(doc,"never-decode.wav","Restart source",60,30.0)
  let _=editor.describe_source(doc,source,64,36,true,true,48000,2)
  let audio:u64=option.unwrap(editor.append(doc,audio_track,source,0,60))
  let video:u64=option.unwrap(editor.append(doc,video_track,source,0,60))
  let _=editor.set_clip_streams(doc,audio,2)
  let _=editor.set_clip_streams(doc,video,1)
  let _=editor.select_only(doc,video)
  let _=editor.open_source(doc,source)
  let _=editor.seek(doc,12)
  let _=editor.program_action(doc,editor.play())
  state
}
fn accept_restart_endpoint(state:ref<app.App>,prepared:u64)->bool effects {alloc} {
  app.accept_endpoint(state,metadata(96000,112800,30.0),prepared,state.document_revision,state.media_revision,state.document.active)
}
fn restart_decision(state:ref<app.App>,preroll:ref<window.PcmPreroll>,mix:bool,pending:bool,preparing:bool)->bool effects {} {
  window.audio_restart_needed(state,false,true,true,false,editor.playhead(struct.borrow(state,field=document)),
    editor.playhead(struct.borrow(state,field=document)),mix,pending,preparing,preroll,9)
}

pub fn main(args:view<str>) -> i32 effects {alloc,fs.meta,fs.read,fs.write,time,env,io.write} {
  if view.len(args)!=2 {io.write("[GA_TEST_ARGUMENTS] Expected exclusive OUT_DIR\n")
    return 2}
  let root:str=view.get(args,1)
  // Windows supplies a fresh child; Unix supplies an owned TemporaryDirectory.
  match files.mkdirs(root) {ok(_)=>{},err(_)=>{io.write("[GA_TEST_ROOT_CREATE] Cannot create OUT_DIR\n")
    return 2},}
  var suite:test.Suite=test.suite("Standalone accepted audio endpoint controller",true)
  var state:app.App=app.app(provider.fake(""))
  var doc:editor.Document=editor.document(30.0,64,36)
  let source:u64=editor.add_source(doc,"never-decode.wav","Audio",60,30.0)
  let _=editor.describe_source(doc,source,0,0,false,true,48000,2)
  let owner:u64=doc.active
  let track:u64=editor.add_track(doc,owner,editor.track_audio(),"A1")
  let _=editor.append(doc,track,source,0,60)
  let _=ref.swap(struct.borrow(state,field=document),doc)
  let before:string=encoded(state)
  let _=test.start(suite,"Cold End intent and Stop or seek cancellation are runtime-only")
  var end_action:commands.Result=commands.program(state,editor.go_end())
  let _=test.check(suite,end_action.ok and state.endpoint_end_requested,"Cold End schedules background preparation")
  let _=test.eq_str(suite,encoded(state),before,"Cold End cannot invent endpoint or mutate graph")
  let _=commands.program(state,editor.stop())
  let _=test.check(suite,not state.endpoint_end_requested,"Stop cancels preparation intent")
  let _=commands.program(state,editor.go_end())
  let _=commands.seek(state,12)
  let _=test.check(suite,not state.endpoint_end_requested,"Explicit seek supersedes cold End intent")
  let _=test.done(suite)
  let _=test.start(suite,"Accepted EOF extends navigation without altering authored duration")
  let revision:u64=state.document_revision
  let media:u64=state.media_revision
  let _=test.check(suite,app.accept_endpoint(state,metadata(96000,112800,30.0),17,revision,media,owner),"Matching immutable origin accepted")
  let _=test.eq_i64(suite,app.presentation_duration(state),71,"First frame sample boundary at or after actual EOF")
  let _=test.eq_i64(suite,editor.duration(struct.borrow(state,field=document)),60,"Authored duration stays60")
  let _=commands.program(state,editor.go_end())
  let _=test.eq_i64(suite,editor.playhead(struct.borrow(state,field=document)),70,"Warm End reaches actual final picture coordinate")
  let _=commands.seek(state,64)
  let _=test.eq_i64(suite,editor.playhead(struct.borrow(state,field=document)),64,"Postbody Program seek remains reachable")
  let _=commands.program(state,editor.mark_in())
  let _=test.check(suite,not app.endpoint_current(state),"Authored mark edit retires stale identity")
  let _=test.check(suite,not app.accept_endpoint(state,metadata(96000,112800,30.0),18,revision,media,owner),"Old document revision rejected")
  let _=test.done(suite)
  let _=test.start(suite,"Sample-exact completion and final partial pull are separate from frame ceiling")
  var end:endpoint.End=metadata(96000,112800,30.0)
  let _=test.eq_u64(suite,endpoint.pull_count(end,112797,240000),3,"Final pull contains exactly3real stereo frames")
  let _=test.eq_u64(suite,endpoint.pull_count(end,112800,240000),0,"EOF allocates no padded PCM")
  let _=test.check(suite,not endpoint.completed(end,0,112799) and endpoint.completed(end,0,112800),"Natural completion waits actual sample EOF")
  var video:endpoint.End=metadata(288000,112800,30.0)
  let _=test.eq_i64(suite,video.frames,180,"Longer authored video preserves presentation extent")
  let _=test.check(suite,not endpoint.completed(video,0,112800) and endpoint.completed(video,0,288000),"Silent presentation continues to authored video end")
  var clock:audio.Clock=audio.Clock {ok:true,samples:112800,queued:0,error:string.new()}
  window.extend_silent_clock(clock,1000000000,112800,2000000000)
  let _=test.eq_u64(suite,clock.samples,160800,"Wallclock continuation begins at real drained device anchor")
  let _=test.eq_u64(suite,clock.queued,0,"Presentation clock creates no audio buffers")
  let _=test.done(suite)
  let _=test.start(suite,"Explicit marked crop and unmarked export use different exact ranges")
  var cut:editor.Document=editor.copy_document(struct.borrow(state,field=document))
  struct.set(struct.borrow(cut,field=program),0,field=mark_in)
  struct.set(struct.borrow(cut,field=program),60,field=mark_out)
  let marked:editor.Transport=editor.export_range_until(cut,71)
  let _=test.eq_i64(suite,marked.mark_out,60,"Explicit MarkOut stays hard exclusive crop")
  struct.set(struct.borrow(cut,field=program),-1,field=mark_out)
  let unmarked:editor.Transport=editor.export_range_until(cut,71)
  let _=test.eq_i64(suite,unmarked.mark_out,71,"Default export reaches accepted EOF picture ceiling")
  struct.set(struct.borrow(cut,field=program),64,field=mark_in)
  let tail:editor.Transport=editor.export_range_until(cut,71)
  let _=test.eq_i64(suite,tail.mark_in,64,"Nonzero MarkIn admits genuine postbody tail")
  let _=test.eq_i64(suite,editor.duration(cut),60,"Neither range changes authored clips")
  let _=test.done(suite)
  let _=test.start(suite,"Media or active-owner replacement rejects previous acceptance")
  let _=test.check(suite,app.accept_endpoint(state,metadata(96000,112800,30.0),19,state.document_revision,state.media_revision,owner),"Fresh revision accepts endpoint")
  app.mark_media_changed(state)
  let _=test.check(suite,not app.endpoint_current(state),"Reload retires accepted cache identity")
  let _=test.check(suite,not app.accept_endpoint(state,metadata(96000,112800,30.0),20,state.document_revision,media,owner),"Old media identity cannot return")
  let _=test.done(suite)
  let _=test.start(suite,"Actual native completion helper replays only at exact accepted EOF")
  var loop_doc:editor.Document=editor.copy_document(struct.borrow(state,field=document))
  struct.set(struct.borrow(loop_doc,field=program),true,field=looping)
  var loop_end:endpoint.End=metadata(96000,112800,30.0)
  var count:u64=0
  loop {if count>=2 {break}
    let _=editor.program_action_until(loop_doc,editor.play(),71)
    let _=editor.seek_until(loop_doc,70,71)
    let _=test.check(suite,not window.finish_program_until(loop_doc,loop_end,0,112799,0),"Last picture cannot finish one sample before actual EOF")
    let _=test.check(suite,not window.finish_program_until(loop_doc,loop_end,0,112800,1),"Queued real PCM must drain before loop restart")
    let _=test.check(suite,window.finish_program_until(loop_doc,loop_end,0,112800,0),"Exactly accepted EOF admits restart")
    let _=test.eq_i64(suite,editor.playhead(loop_doc),0,"New loop starts exactly at frame0")
    let _=test.check(suite,editor.playing(loop_doc),"New epoch remains playing")
    let _=test.check(suite,not window.finish_program_until(loop_doc,loop_end,0,112800,0),"Old device EOF cannot repeatedly restart new loop origin")
    count=count+1
  }
  struct.set(struct.borrow(loop_doc,field=program),false,field=looping)
  let _=editor.seek_until(loop_doc,70,71)
  let _=test.check(suite,window.finish_program_until(loop_doc,loop_end,0,112800,0) and not editor.playing(loop_doc),"Unlooped natural completion pauses once")
  let _=test.done(suite)
  let _=test.start(suite,"Source navigation stays native-bound and stale picture epochs cannot use accepted tail")
  let _=test.check(suite,app.accept_endpoint(state,metadata(96000,112800,30.0),27,state.document_revision,state.media_revision,owner),"Fresh current endpoint")
  struct.set(struct.borrow(state,field=document),source,field=monitor_source)
  let _=commands.monitor(state,editor.go_end())
  let _=test.eq_i64(suite,state.document.monitor.frame,59,"Source End retains physical native source extent")
  let _=commands.seek(state,64)
  let _=test.eq_i64(suite,editor.playhead(struct.borrow(state,field=document)),64,"Program reaches accepted tail independently")
  let _=commands.program(state,editor.play())
  var device:audio.Clock=audio.Clock {ok:true,samples:112800,queued:0,error:string.new()}
  var previous:i64=64
  let _=test.check(suite,not option.is_some(window.apply_picture_clock(state,device,0,30.0,70,false,9,8,state.document_revision,state.media_revision,previous)),"Stale picture epoch cannot apply tail clock")
  let _=test.eq_i64(suite,editor.playhead(struct.borrow(state,field=document)),64,"Stale clock preserves current Program coordinate")
  app.document_changed(state)
  let _=test.check(suite,not app.endpoint_current(state) and app.presentation_duration(state)==60,"Authored edit retires prepared endpoint and ceiling")
  let _=test.done(suite)
  let _=test.start(suite,"Signed native and destination phase apply only to marked accepted roots")
  var phase:endpoint.End=metadata(50450,50448,30000.0/1001.0)
  array.push(struct.borrow(phase,field=roots),endpoint.Root {id:"n20",start:0,body:50450,actual:50448,tail:true,native_eof:false})
  let _=test.check(suite,match endpoint.decode(str.view(endpoint.encode(phase))) {ok(_)=>true,err(_)=>false,},"Proven moved negative seam body-2 remains exact and reachable")
  struct.set(array.borrow(struct.borrow(phase,field=roots),0),false,field=tail)
  let _=test.check(suite,match endpoint.decode(str.view(endpoint.encode(phase))) {ok(_)=>false,err(_)=>true,},"Unmarked root does not inherit phase allowance")
  var maximum:endpoint.End=metadata(100,240103,30000.0/1001.0)
  array.push(struct.borrow(maximum,field=roots),endpoint.Root {id:"n20",start:0,body:100,actual:240103,tail:true,native_eof:false})
  let _=test.check(suite,match endpoint.decode(str.view(endpoint.encode(maximum))) {ok(_)=>true,err(_)=>false,},"True five-second tail plus two native and one destination seam accepted")
  struct.set(maximum,240104,field=actual)
  struct.set(maximum,match endpoint.frame_end(240104,30000.0/1001.0) {ok(v)=>v,err(_)=>0,},field=frames)
  struct.set(array.borrow(struct.borrow(maximum,field=roots),0),240104,field=actual)
  let _=test.check(suite,match endpoint.decode(str.view(endpoint.encode(maximum))) {ok(_)=>false,err(_)=>true,},"One sample beyond qualified bound refused")
  struct.set(phase,50447,field=actual)
  struct.set(array.borrow(struct.borrow(phase,field=roots),0),true,field=tail)
  struct.set(array.borrow(struct.borrow(phase,field=roots),0),50447,field=actual)
  let _=test.check(suite,match endpoint.decode(str.view(endpoint.encode(phase))) {ok(_)=>false,err(_)=>true,},"Unqualified third negative sample refused")
  struct.set(phase,0,field=generation)
  let _=test.check(suite,match endpoint.decode(str.view(endpoint.encode(phase))) {ok(_)=>false,err(_)=>true,},"Zero accepted generation cannot bypass malformed root geometry")
  let _=test.done(suite)
  let _=test.start(suite,"Native shared endpoint failure clears End intent once without authored mutation")
  let _=commands.program(state,editor.pause())
  let _=commands.program(state,editor.go_end())
  let _=test.check(suite,state.endpoint_end_requested,"Cold End begins pending intent")
  let failure_before:string=encoded(state)
  window.preparing_program_audio(state,true)
  let _=test.check(suite,text.contains(str.view(struct.borrow(state,field=status)),"Preparing audio"),"Cold End shows asynchronous preparation status")
  window.prepared_program_audio(state,"End")
  let _=test.eq_str(suite,struct.borrow(state,field=status),"End","Accepted End clears preparation status")
  window.preparing_program_audio(state,false)
  window.prepared_program_audio(state,"Playing")
  let _=test.eq_str(suite,struct.borrow(state,field=status),"Playing","Real first queue boundary clears preparation status")
  window.endpoint_failure(state,"[GA_AUDIO_ENDPOINT_PATH] Cannot read accepted descriptor")
  window.prepared_program_audio(state,"Playing")
  let _=test.check(suite,not state.endpoint_end_requested and not app.endpoint_current(state) and state.endpoint_prepare==0,"Failure retires metadata and pending End instead of repeating prepare")
  let _=test.check(suite,not editor.playing(struct.borrow(state,field=document)),"Failure pauses Program before future PCM queue")
  let _=test.check(suite,text.contains(str.view(struct.borrow(state,field=status)),"GA_AUDIO_ENDPOINT_PATH"),"Original coded cause survives retirement")
  let _=test.eq_str(suite,encoded(state),failure_before,"Paused cold End failure preserves complete authored graph")
  window.endpoint_failure(state,"[GA_AUDIO_ENDPOINT_STALE] Preparation identity was superseded")
  let _=test.check(suite,not state.endpoint_end_requested,"Stale acceptance takes same terminal path")
  let _=test.done(suite)
  let _=test.start(suite,"Saved tail seek waits actual acceptance and retires old picture ownership")
  var saved:editor.Document=editor.copy_document(struct.borrow(state,field=document))
  struct.set(struct.borrow(saved,field=program),70,field=frame)
  struct.set(struct.borrow(saved,field=program),false,field=playing)
  struct.set(struct.borrow(saved,field=monitor),0,field=frame)
  let _=editor.select_only(saved,option.unwrap(editor.clip_at(saved,0)).id)
  let saved_wire:string=match codec.encode(saved) {ok(v)=>v,err(_)=>{io.write("[GA_TEST_PROJECT_ENCODE] Cannot encode saved tail seek\n")
    return 2},}
  let saved_path:string=path.join(root,"tail-seek.air")
  match files.write_new_text(saved_path,str.view(saved_wire)) {ok(_)=>{},err(_)=>{io.write("[GA_TEST_PROJECT_WRITE] Cannot exclusively save tail seek\n")
    return 2},}
  let reopened:string=match files.read_text(saved_path) {ok(v)=>v,err(_)=>{io.write("[GA_TEST_PROJECT_READ] Cannot read saved tail seek\n")
    return 2},}
  let loaded:editor.Document=match codec.decode(str.view(reopened)) {ok(v)=>v,err(_)=>{io.write("[GA_TEST_PROJECT_DECODE] Cannot decode saved tail seek\n")
    return 2},}
  var seek_state:app.App=app.app(provider.fake(""))
  commands.replace_project(seek_state,loaded)
  let _=test.eq_i64(suite,editor.playhead(struct.borrow(seek_state,field=document)),70,"Open preserves exact saved tail coordinate while endpoint is unknown")
  let _=test.eq_i64(suite,seek_state.endpoint_seek_requested,70,"Open creates runtime-only paused navigation intent")
  let _=test.eq_str(suite,encoded(seek_state),saved_wire,"Reopen preserves complete saved document before query")
  let _=test.check(suite,not app.endpoint_picture_ready(seek_state),"No picture packet may decode or clamp unvalidated Program time")
  struct.set(struct.borrow(struct.borrow(seek_state,field=document),field=monitor),21,field=frame)
  struct.set(struct.borrow(struct.borrow(seek_state,field=document),field=monitor),true,field=playing)
  let _=test.check(suite,window.source_waits_for_endpoint(seek_state,true),"Cold saved Program validation defers Source PCM only until shared parked packet is safe")
  let _=test.eq_i64(suite,seek_state.document.monitor.frame,21,"Preparation does not seek Source or borrow its transport position")
  struct.set(struct.borrow(struct.borrow(seek_state,field=document),field=monitor),false,field=playing)
  struct.set(struct.borrow(struct.borrow(seek_state,field=document),field=monitor),0,field=frame)

  let _=commands.program(seek_state,editor.play())
  let _=test.check(suite,editor.playing(struct.borrow(seek_state,field=document)) and editor.playhead(struct.borrow(seek_state,field=document))==70 and seek_state.endpoint_seek_requested==70,"Play during cold reopen preserves target until accepted query")
  let _=commands.program(seek_state,editor.pause())
  let _=test.check(suite,not editor.playing(struct.borrow(seek_state,field=document)) and editor.playhead(struct.borrow(seek_state,field=document))==70,"Pause cannot clamp an unvalidated saved coordinate")
  window.preparing_program_audio(seek_state,true)
  let _=test.eq_str(suite,struct.borrow(seek_state,field=status),"Preparing audio endpoint for seek...","Paused reopened seek explains background preparation")
  var q:pictures.Queue=pictures.queue()
  let _=pictures.configure(q,"old",1,false,false,480,270)
  pictures.requested(q,99,59,100)
  let _=test.check(suite,pictures.receive(q,99,pictures.Frame {source:draw.empty_surface(),program:draw.empty_surface(),position:link.FramePosition {source_frame:0,program_frame:59,revision:seek_state.media_revision},held_source:true},200),"Old paused completion is genuinely owned before retirement")
  let _=pictures.configure(q,str.view(pictures.identity_revision(seek_state,false,false)),1,false,false,480,270)
  let _=test.check(suite,not option.is_some(pictures.take_due(q,70)) and not pictures.accepts(q,99),"Actual queue retirement removes completed and reserved old pictures")
  struct.set(seek_state,42,field=presented_program_frame)
  var source_pixels:draw.Surface=draw.empty_surface()
  var program_pixels:draw.Surface=draw.empty_surface()
  pictures.apply(seek_state,pictures.Frame {source:draw.empty_surface(),program:draw.empty_surface(),position:link.FramePosition {source_frame:0,program_frame:59,revision:seek_state.media_revision},held_source:false},source_pixels,program_pixels)
  let _=test.eq_i64(suite,seek_state.presented_program_frame,42,"Shared picture apply cannot relabel held pixels while intent is pending")
  let _=test.eq_i64(suite,editor.playhead(struct.borrow(seek_state,field=document)),70,"Old completion cannot change saved tail coordinate")
  let _=test.check(suite,not app.accept_endpoint(seek_state,metadata(96000,112800,30.0),100,seek_state.document_revision+1,seek_state.media_revision,seek_state.document.active),"Stale query cannot validate cold seek")
  let _=test.check(suite,not app.complete_endpoint_navigation(seek_state),"No acceptance means no clamp or navigation")
  let _=test.eq_i64(suite,editor.playhead(struct.borrow(seek_state,field=document)),70,"Stale query preserves coordinate until terminal retirement")
  struct.set(struct.borrow(struct.borrow(seek_state,field=document),field=monitor),true,field=playing)
  window.endpoint_failure(seek_state,"[GA_AUDIO_ENDPOINT_STALE] old preparation")
  let _=test.check(suite,not seek_state.document.monitor.playing,"Failed parked-endpoint validation retires waiting Source start rather than beginning an unprimeable device loop")
  let _=test.check(suite,not app.endpoint_requested(seek_state) and not app.endpoint_picture_ready(seek_state),"Terminal failure clears intent once and holds unvalidated pictures without auto-retry")
  let _=test.eq_str(suite,encoded(seek_state),saved_wire,"Terminal preparation failure does not clamp or edit saved transport")
  let _=commands.seek(seek_state,64)
  let _=test.eq_i64(suite,seek_state.endpoint_seek_requested,64,"Competing cold seek replaces former target")
  let bad:commands.Result=commands.seek(seek_state,9223372036854775807)
  let _=test.check(suite,not bad.ok and seek_state.endpoint_seek_requested==64,"Unrepresentable target refuses before disturbing valid intent")
  let wrong_before:string=encoded(seek_state)
  var wrong_fps:endpoint.End=metadata(96000,112800,60.0)
  array.push(struct.borrow(wrong_fps,field=roots),endpoint.Root {id:"n23",start:0,body:96000,actual:112800,tail:true,native_eof:false})
  let _=test.check(suite,match endpoint.decode(str.view(endpoint.encode(wrong_fps))) {ok(_)=>true,err(_)=>false,},"Wrong-FPS descriptor is structurally valid, so this tests document binding")
  let _=test.check(suite,not app.accept_endpoint(seek_state,wrong_fps,101,seek_state.document_revision,seek_state.media_revision,seek_state.document.active),"Current request identity cannot accept different owner FPS")
  var wrong_body:endpoint.End=metadata(96001,112800,30.0)
  array.push(struct.borrow(wrong_body,field=roots),endpoint.Root {id:"n23",start:0,body:96001,actual:112800,tail:true,native_eof:false})
  let _=test.check(suite,match endpoint.decode(str.view(endpoint.encode(wrong_body))) {ok(_)=>true,err(_)=>false,},"Wrong-authored descriptor is structurally valid")
  let _=test.check(suite,not app.accept_endpoint(seek_state,wrong_body,101,seek_state.document_revision,seek_state.media_revision,seek_state.document.active),"Current request identity cannot accept different authored sample geometry")
  let _=test.check(suite,not app.endpoint_current(seek_state) and seek_state.endpoint_prepare==0 and seek_state.endpoint_seek_requested==64,"Both geometry refusals preserve pending target and previous acceptance state atomically")
  let _=test.eq_str(suite,encoded(seek_state),wrong_before,"Geometry refusal leaves complete document unchanged")
  let _=test.check(suite,app.accept_endpoint(seek_state,metadata(96000,112800,30.0),101,seek_state.document_revision,seek_state.media_revision,seek_state.document.active),"Exact current prepare identity accepted")
  let _=test.check(suite,app.complete_endpoint_navigation(seek_state) and app.endpoint_picture_ready(seek_state),"Accepted endpoint enables picture dispatch and completes only latest seek")
  let _=test.eq_i64(suite,editor.playhead(struct.borrow(seek_state,field=document)),64,"Latest requested postbody position is reachable")
  let _=test.check(suite,not window.source_waits_for_endpoint(seek_state,true),"Accepted Program metadata permits independent Source clock start")
  let _=test.eq_i64(suite,editor.duration(struct.borrow(seek_state,field=document)),60,"Accepted seek leaves authored length unchanged")
  app.retire_endpoint(seek_state)
  let _=commands.seek(seek_state,90)
  let _=test.check(suite,app.accept_endpoint(seek_state,metadata(96000,112800,30.0),102,seek_state.document_revision,seek_state.media_revision,seek_state.document.active) and app.complete_endpoint_navigation(seek_state),"Out-of-EOF target waits real descriptor before clamp")
  let _=test.eq_i64(suite,editor.playhead(struct.borrow(seek_state,field=document)),70,"Only accepted presentation bound clamps oversized tail seek")
  app.retire_endpoint(seek_state)
  let _=commands.seek(seek_state,64)
  let _=commands.program(seek_state,editor.stop())
  let _=test.check(suite,not app.endpoint_requested(seek_state) and not editor.playing(struct.borrow(seek_state,field=document)),"Stop clears cold navigation before future PCM")
  let _=commands.seek(seek_state,64)
  let _=commands.seek(seek_state,12)
  let _=test.check(suite,not app.endpoint_requested(seek_state) and editor.playhead(struct.borrow(seek_state,field=document))==12,"Ordinary opposing seek cancels cold intent")
  let _=commands.seek(seek_state,64)
  app.mark_media_changed(seek_state)
  let _=test.check(suite,not app.endpoint_requested(seek_state),"Media invalidation retires seek intent")
  let _=commands.seek(seek_state,64)
  commands.replace_project(seek_state,editor.document(30.0,64,36))
  let _=test.check(suite,not app.endpoint_requested(seek_state) and app.endpoint_picture_ready(seek_state),"New empty project zero does not request preparation or inherit previous tail seek")
  let _=test.done(suite)
 let _=test.start(suite,"Native short EOF is explicit END2 only")
 let raw:str="END2 1 192000 191163 120 30\nn20 0 192000 191163 2"
 var value:endpoint.End=match endpoint.decode(raw) {err(_)=>{return 3},ok(v)=>v,}
 let _=test.eq_i64(suite,value.actual,191163,"Actual native count is not padded to nominal")
 let _=test.check(suite,array.borrow(struct.borrow(value,field=roots),0).native_eof,"Capability is explicit per root")
 let _=test.eq_str(suite,endpoint.encode(value),raw,"Native short version roundtrip is exact")
 let _=test.check(suite,refused("END1 1 192000 191163 120 30\nn20 0 192000 191163 1"),"END1 old minimum remains")
 let _=test.check(suite,refused("END1 1 192000 191163 120 30\nn20 0 192000 191163 2"),"END1 cannot acquire new flag silently")
 let _=test.done(suite)
 let _=test.start(suite,"Future zero-native-root owns identity without leading PCM")
 let empty:str="END2 2 101 0 1 30\nempty 100 101 100 2"
 value=match endpoint.decode(empty) {err(_)=>{return 4},ok(v)=>v,}
 let _=test.eq_i64(suite,value.actual,0,"No PCM allocated through future empty root")
 let _=test.eq_i64(suite,value.authored,101,"Authored presentation is unchanged")
 let _=test.eq_i64(suite,value.frames,1,"Presentation covers authored interval")
 let _=test.eq_i64(suite,array.borrow(struct.borrow(value,field=roots),0).actual,100,"Exact root query identity remains in ledger")
 let _=test.eq_str(suite,endpoint.encode(value),empty,"Empty absolute root identity roundtrips")
 let _=test.eq_u64(suite,endpoint.pull_count(value,0,100),0,"No pulls are requested for empty graph")
 let _=test.done(suite)
 let _=test.start(suite,"Mixed roots use only genuinely owned native samples")
 let mixed:str="END2 3 101 51 1 30\nempty 100 101 100 2\naudio 0 50 51 2"
 value=match endpoint.decode(mixed) {err(_)=>{return 5},ok(v)=>v,}
 let _=test.eq_i64(suite,value.actual,51,"Empty future root cannot extend earlier audible graph")
 let _=test.eq_u64(suite,array.len(struct.borrow(value,field=roots)),2,"Both accepted identities retained")
 let _=test.eq_str(suite,endpoint.encode(value),mixed,"Mixed ledger roundtrip exact")
 let _=test.check(suite,refused("END2 3 101 100 1 30\nempty 100 101 100 2\naudio 0 50 51 2"),"Maximum cannot falsely include empty graph")
 let _=test.done(suite)
 let _=test.start(suite,"Zero at origin and native EOF budget edges")
 value=match endpoint.decode("END2 4 1 0 1 30\nempty 0 1 0 2") {err(_)=>{return 6},ok(v)=>v,}
 let _=test.eq_i64(suite,value.actual,0,"Zero origin is a real zero graph")
 let _=test.check(suite,refused("END2 4 100 99 1 30\naudio 100 101 99 2"),"EOF cannot precede selected root placement")
 let _=test.check(suite,refused("END2 4 100 240101 151 30\naudio 0 100 240101 2"),"Five-second total tail ceiling remains strict")
 let _=test.check(suite,refused("END2 4 100 100 1 30\naudio 0 100 100 3"),"Unknown flags refuse")
 let _=test.check(suite,refused("END2 4 100 100 1 30\naudio 0 100 100 2\naudio 0 100 100 2"),"Duplicate identity refuses")
 let _=test.done(suite)

  var edit:u64=0
  loop {if edit>=4 {break}
    let _=test.start(suite,if edit==0 {"Active brightness edit re-prepares a retired endpoint"}else if edit==1 {"Active title edit re-prepares a retired endpoint"}else if edit==2 {"Active MarkIn re-prepares a retired endpoint"}else{"Active MarkOut re-prepares a retired endpoint"})
    var active:app.App=restart_fixture()
    var saved:window_cache.Cache=window_cache.cache()
    let _=window_cache.refresh(active,saved)
    let original_mix:string=string.copy(struct.borrow(saved,field=audio))
    let original_revision:u64=active.document_revision
    let _=test.check(suite,accept_restart_endpoint(active,51),"Live original revision owns accepted actual EOF")
    var preroll:window.PcmPreroll=window.first_pcm_begin(active,9,false,12)
    let _=test.check(suite,not restart_decision(active,preroll,false,false,false),"Unchanged active accepted session needs no restart")
    var changed:commands.Result=if edit<2 {
      commands.add_filter(active,app.current_clip(active),if edit==0 {"brightness"}else{"text"})
    }else{commands.program(active,if edit==2 {editor.mark_in()}else{editor.mark_out()})}
    let _=test.check(suite,changed.ok,"Actual authored controller operation succeeds")
    if edit==0 {let _=commands.set_filter_param(active,changed.value,"level",1.25)}
    if edit==1 {let _=commands.set_filter_text_param(active,changed.value,"text","Native active title")}
    let _=test.check(suite,active.document_revision>original_revision and editor.playing(struct.borrow(active,field=document)),"Edit advances revision while Program stays playing")
    let _=test.check(suite,window_cache.refresh(active,saved),"Actual semantic cache observes authored edit")
    let unchanged:bool=str.eq(str.view(original_mix),struct.borrow(saved,field=audio))
    let _=test.check(suite,unchanged,"Independent rebuilt audio plan is unchanged by picture or marks")
    let _=test.check(suite,not app.endpoint_current(active),"Authored edit correctly retires old endpoint")
    let _=test.check(suite,restart_decision(active,preroll,not unchanged,false,false),"Missing acceptance schedules existing stop/discard/reprepare rather than draining forever")
    let _=test.check(suite,not app.accept_endpoint(active,metadata(96000,112800,30.0),51,original_revision,active.media_revision,active.document.active),"Old completion cannot resurrect stale revision")
    preroll=window.first_pcm_begin(active,9,false,12)
    let _=test.check(suite,not restart_decision(active,preroll,false,true,true),"Current preparation is not restarted repeatedly")
    let _=test.check(suite,accept_restart_endpoint(active,52),"Fresh matching preparation restores endpoint")
    let _=test.check(suite,not restart_decision(active,preroll,false,false,false),"Fresh acceptance settles the restart decision")
    var accepted:endpoint.End=option.unwrap(struct.replace(active,option.none(),field=accepted_audio))
    let _=test.eq_u64(suite,endpoint.pull_count(accepted,12*1600,240000),93600,"Reprepared graph retains exact remaining body and genuine original tail")
    let _=test.done(suite)
    edit=edit+1
  }
  let _=test.start(suite,"Actual audio edits and seeks still restart independently of missing acceptance")
  var active:app.App=restart_fixture()
  var saved:window_cache.Cache=window_cache.cache()
  let _=window_cache.refresh(active,saved)
  let original_mix:string=string.copy(struct.borrow(saved,field=audio))
  var preroll:window.PcmPreroll=window.first_pcm_begin(active,9,false,12)
  let _=test.check(suite,accept_restart_endpoint(active,61),"Original accepted session")
  let audio_clip:u64=option.unwrap(editor.clip_at(struct.borrow(active,field=document),0)).id
  let _=test.check(suite,commands.set_clip_field(active,audio_clip,"gain",0.5).ok,"Actual audible clip gain edit succeeds")
  let _=window_cache.refresh(active,saved)
  let mix_changed:bool=not str.eq(str.view(original_mix),struct.borrow(saved,field=audio))
  let _=test.check(suite,mix_changed and restart_decision(active,preroll,mix_changed,false,false),"Audible wire change keeps existing restart")
  let _=test.check(suite,accept_restart_endpoint(active,62),"Fresh gain revision can be accepted")
  let _=commands.seek(active,18)
  let _=test.check(suite,window.audio_restart_needed(active,false,true,true,false,18,12,false,false,false,preroll,9),"Explicit actual seek restarts even with current accepted graph")
  app.mark_media_changed(active)
  let _=test.check(suite,restart_decision(active,preroll,true,false,false),"External media retirement still restarts")
  let _=test.done(suite)
  let _=test.start(suite,"Source preroll and pending cold navigation keep their independent decision")
  var source_state:app.App=restart_fixture()
  let _=commands.program(source_state,editor.pause())
  let _=commands.monitor(source_state,editor.play())
  var source_pcm:window.PcmPreroll=window.first_pcm_begin(source_state,9,true,0)
  let _=test.check(suite,not app.endpoint_current(source_state),"Source does not require Program endpoint")
  let _=test.check(suite,not window.audio_restart_needed(source_state,true,true,true,true,0,0,false,false,false,source_pcm,9),"Stable Source ignores missing Program endpoint")
  let _=test.check(suite,not window.audio_restart_needed(source_state,true,true,true,true,0,0,false,false,true,source_pcm,9),"Valid Source preroll is preserved")
  let _=test.check(suite,window.audio_restart_needed(source_state,true,true,true,true,0,0,false,false,true,source_pcm,10),"Stale Source preroll generation still restarts")
  var cold:app.App=restart_fixture()
  let _=commands.program(cold,editor.go_end())
  var cold_pcm:window.PcmPreroll=window.first_pcm_begin(cold,9,false,12)
  let _=test.check(suite,cold.endpoint_end_requested,"Cold End creates real navigation intent")
  let _=test.check(suite,not restart_decision(cold,cold_pcm,false,true,true),"Pending cold End remains bounded one preparation")
  let _=commands.seek(cold,10)
  let _=test.check(suite,not cold.endpoint_end_requested,"Actual seek cancels cold End intent")
  let _=test.check(suite,window.audio_restart_needed(cold,false,true,true,false,10,12,false,false,false,cold_pcm,9),"New seek remains an existing restart reason")
  let _=test.done(suite)

  test.conclude(suite,path.join(root,"controller-tests.json"),20)
}
