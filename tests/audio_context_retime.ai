// Real SDK edits, codec round trips and shared audio planning. Expected PCM is
// independently authored by the Python driver, never generated by this client.
module genesis.tests.audio_context_retime
import std.editor as editor
import std.editor_io as store
import std.files as files
import std.path as path
import std.text as text
import "../src/timeline_media.ai" as media

fn encoded(doc:ref<editor.Document>)->string effects {alloc} {
 match store.encode(doc) {ok(v)=>v,err(_)=>string.copy("invalid"),}
}
fn write(file:str,value:str)->result<unit,string> effects {alloc,fs.write} {
 match files.write_text(file,value) {ok(_)=>result.ok(()),err(_)=>result.err("fixture output failed"),}
}
fn output(doc:ref<editor.Document>,worker:str,root:str,label:str)->result<unit,string>
 effects {alloc,fs.meta,fs.read,fs.write,process,time} {
 let prefix:string=path.join(root,label)
 let before:string=encoded(doc)
 if str.eq(before,"invalid") {return result.err("encoding failed")}
 let _=try write(text.concat(prefix,".air"),before)
 let _=try media.prepare_audio(doc,worker,0,text.concat(prefix,".wav"))
 let _=try media.prepare_audio(doc,worker,7,text.concat(prefix,"-fresh.wav"))
 var held:option<media.AudioSession> =option.none()
 var cursor:i64=0
 var index:u64=0
 var manifest:string=string.new()
 loop {if cursor>=editor.duration(doc) {break}
  let width:i64=if index%3==0 {3}else if index%3==1 {5}else{7}
  let end:i64=if cursor+width<editor.duration(doc) {cursor+width}else{editor.duration(doc)}
  let out:string=text.concat(prefix,text.concat("-pull-",text.concat(string.from_int(index),".wav")))
  let plan:media.AudioPlan=try media.audio_plan_range(doc,worker,cursor,end,out)
  var job:media.AudioJob=media.audio_job(plan,ref.swap(held,option.none()))
  let session:media.AudioSession=try media.execute_playback_audio(job,"",0)
  let _=ref.swap(held,option.some(session))
  string.append(manifest,out)
  string.append(manifest,"\n")
  cursor=end
  index=index+1
 }
 match held {none=>{},some(session)=>{let _=try media.shutdown_audio_checked(session)},}
 let _=try write(text.concat(prefix,"-pulls.txt"),manifest)
 var n:u64=0
 loop {if n>=editor.clip_count(doc) {break}
  let clip:editor.Clip=option.unwrap(editor.clip_at(doc,n))
  n=n+1
  if clip.id==21 {continue}
  let peaks:array<f64> =try media.clip_envelope(doc,clip,600,worker,prefix,"",0)
  var values:array<string> =array.new()
  var k:u64=0
  loop {if k>=array.len(peaks) {break}
   array.push(values,string.from_float(array.get(peaks,k)))
   k=k+1}
  let _=try write(text.concat(prefix,text.concat("-peaks-",text.concat(string.from_int(clip.id),".txt"))),text.join(values,"\n"))
 }
 var plan:media.AudioPlan=try media.audio_plan_range(doc,worker,0,editor.duration(doc),"unused.wav")
 let _=try write(text.concat(prefix,".plan"),text.join(struct.borrow(plan,field=sounds),"\n"))
 if not str.eq(before,encoded(doc)) {return result.err("render mutated authored graph")}
 result.ok(())
}
pub fn main(args:view<str>)->i32 effects {alloc,fs.meta,fs.read,fs.write,io.write,process,time} {
 if view.len(args)!=3 and view.len(args)!=4 {return 2}
 let worker:str=view.get(args,1)
 let root:str=view.get(args,2)
 if view.len(args)==4 {
  if str.eq(view.get(args,3),"--reject") {
   let raw:string=match files.read_text(path.join(root,"reject.air")) {ok(v)=>v,err(_)=>{return 2},}
   match store.decode(raw) {ok(_)=>{return 3},err(_)=>{return 0},}
  }
  if str.eq(view.get(args,3),"--export") {
   let raw:string=match files.read_text(path.join(root,"cases.tsv")) {ok(v)=>v,err(_)=>{return 2},}
   var names:array<string> =text.split(raw,"\n")
   var n:u64=0
   var fonts:array<string> =array.new()
   loop {if n>=array.len(names) {break}
    let name:str=text.trim(array.borrow(names,n))
    n=n+1
    if str.len(name)==0 {continue}
    let raw:string=match files.read_text(path.join(root,text.concat(name,"-retimed.air"))) {ok(v)=>v,err(_)=>{return 2},}
    var doc:editor.Document=match store.decode(raw) {ok(v)=>v,err(_)=>{return 3},}
    let before:string=encoded(doc)
    match media.render_profile(doc,worker,path.join(root,text.concat(name,"-master.mkv")),fonts,"","",3) {
     ok(_)=>{},err(e)=>{io.write(e)
      return 4},}
    if not str.eq(before,encoded(doc)) {return 5}
   }
   return 0
  }
  if not str.eq(view.get(args,3),"--cancel") {return 2}
  let raw:string=match files.read_text(path.join(root,"cancel.air")) {ok(v)=>v,err(_)=>{return 2},}
  var doc:editor.Document=match store.decode(raw) {ok(v)=>v,err(_)=>{return 3},}
  if not editor.trim_end(doc,20,27000) or not editor.set_clip_speed(doc,20,2.0) {return 4}
  let plan:media.AudioPlan=match media.audio_plan_range(doc,worker,18000,18015,path.join(root,"cancelled.wav")) {
   ok(v)=>v,err(e)=>{io.write(e)
    return 5},}
  var job:media.AudioJob=media.audio_job(plan,option.none())
  match media.execute_playback_audio(job,root,1) {
   ok(session)=>{let _=media.shutdown_audio_checked(session)
    return 6},
   err(e)=>{let _=files.write_text(path.join(root,"cancel-result.txt"),e)
    if text.contains(e,"[GA_AUDIO_STREAM_CANCELLED]") {return 0}
    io.write(e)
    return 7},}
 }
 let raw:string=match files.read_text(path.join(root,"cases.tsv")) {ok(v)=>v,err(_)=>{return 2},}
 var names:array<string> =text.split(raw,"\n")
 var i:u64=0
 var ledger:string=string.new()
 loop {if i>=array.len(names) {break}
  let name:str=text.trim(array.borrow(names,i))
  i=i+1
  if str.len(name)==0 {continue}
  let input:string=match files.read_text(path.join(root,text.concat(name,".air"))) {ok(v)=>v,err(_)=>{return 2},}
  var doc:editor.Document=match store.decode(input) {ok(v)=>v,err(_)=>{return 3},}
  var dormant:array<u64> =array.new()
  var forbidden:array<string> =["delay","reverb","unrecognized_dsp"]
  var f:u64=0
  loop {if f>=array.len(forbidden) {break}
   let id:u64=match editor.add_filter(doc,20,array.borrow(forbidden,f)) {none=>{return 21},some(id)=>id,}
   if not editor.set_filter_enabled(doc,id,false) {return 21}
   array.push(dormant,id)
   f=f+1}
  if not editor.trim_end(doc,20,30) {return 4}
  let revision3:string=encoded(doc)
  if not text.contains(revision3,"\"revision\":3") {return 5}
  if not editor.set_clip_speed(doc,20,2.0) {io.write("Rate2 refused\n")
   return 6}
  let clip:editor.Clip=option.unwrap(editor.clip(doc,20))
  let ctx:editor.AudioContext=option.unwrap(clip.audio_context)
  let extent:editor.AudioExtent=option.unwrap(ctx.extent)
  if ctx.length!=60 or ctx.offset!=0 or extent.processing_length!=30 {return 7}
  let saved:string=encoded(doc)
  if not text.contains(saved,"\"revision\":4") {return 8}
  var loaded:editor.Document=match store.decode(saved) {ok(v)=>v,err(_)=>{return 9},}
  if not str.eq(saved,encoded(loaded)) {return 10}
  // Unsupported enabled graphs must refuse before consuming IDs or changing
  // authored values; existing disabled operators remain legitimate metadata.
  f=0
  loop {if f>=array.len(forbidden) {break}
   if option.is_some(editor.add_filter(doc,20,array.borrow(forbidden,f))) or
       editor.set_filter_enabled(doc,array.get(dormant,f),true) {return 22}
   if not str.eq(saved,encoded(doc)) {return 23}
   var held:editor.Document=editor.copy_document(doc)
   if not editor.set_clip_speed(held,20,0.0) {return 24}
   let held_before:string=encoded(held)
   if editor.set_filter_enabled(held,array.get(dormant,f),true) or
       not str.eq(held_before,encoded(held)) {return 25}
   f=f+1}
  var valid_filter:editor.Document=editor.copy_document(doc)
  let allowed:u64=match editor.add_filter(valid_filter,20,"eq_3band") {none=>{return 26},some(id)=>id,}
  if not editor.set_filter_enabled(valid_filter,allowed,false) or
      not editor.set_filter_enabled(valid_filter,allowed,true) or
      str.eq(encoded(valid_filter),"invalid") {return 27}
  var history:editor.History=editor.history(8)
  editor.capture(history,loaded)
  if not editor.set_clip_speed(loaded,20,1.0) or not editor.undo(history,loaded) or
      not str.eq(saved,encoded(loaded)) or not editor.redo(history,loaded) {return 11}
  // Failed retime/reverse/relink/slip preserve all authored bytes and redo.
  let refusing:string=encoded(doc)
  if editor.set_clip_speed(doc,20,4.0) or editor.set_clip_reverse(doc,20,true) or
      editor.relink_source_possible(doc,7,59) or editor.slip(doc,20,1) {return 12}
  if not str.eq(refusing,encoded(doc)) {return 13}
  var relinked:editor.Document=editor.copy_document(doc)
  let source:ref<editor.Source> =array.borrow(struct.borrow(doc,field=sources),0)
  let source_path:string=string.copy(str.view(struct.borrow(source,field=path)))
  let _=editor.relink_source(relinked,7,source_path,90)
  if not str.eq(saved,encoded(relinked)) {
   let kept:editor.AudioContext=option.unwrap(option.unwrap(editor.clip(relinked,20)).audio_context)
   let bound:editor.AudioExtent=option.unwrap(kept.extent)
   if bound.input_duration_us!=extent.input_duration_us or bound.processing_length!=30 {return 14}
  }
  if not editor.slip(relinked,20,1) {return 14}
  let slipped:editor.AudioContext=option.unwrap(option.unwrap(editor.clip(relinked,20)).audio_context)
  if slipped.source_in!=1 or option.unwrap(slipped.extent).input_duration_us!=extent.input_duration_us {return 14}
  var split:editor.Document=editor.copy_document(doc)
  let right:u64=match editor.split(split,20,15) {some(v)=>v,none=>{return 15},}
  var head:editor.Document=editor.copy_document(doc)
  if not editor.trim_start(head,20,5) {return 16}
  var tail:editor.Document=editor.copy_document(doc)
  if not editor.trim_end(tail,20,20) {return 17}
  var repeated:editor.Document=editor.copy_document(split)
  if not editor.trim_start(repeated,right,20) or not editor.trim_end(repeated,right,8) {return 18}
  var moved:editor.Document=editor.copy_document(doc)
  if not editor.move_clip(moved,20,clip.track,1) {return 19}
  match output(doc,worker,root,text.concat(name,"-retimed")) {ok(_)=>{},err(e)=>{io.write(e)
   return 20},}
  match output(split,worker,root,text.concat(name,"-split")) {ok(_)=>{},err(e)=>{io.write(e)
   return 20},}
  match output(head,worker,root,text.concat(name,"-head")) {ok(_)=>{},err(e)=>{io.write(e)
   return 20},}
  match output(tail,worker,root,text.concat(name,"-tail")) {ok(_)=>{},err(e)=>{io.write(e)
   return 20},}
  match output(repeated,worker,root,text.concat(name,"-repeated")) {ok(_)=>{},err(e)=>{io.write(e)
   return 20},}
  match output(moved,worker,root,text.concat(name,"-moved")) {ok(_)=>{},err(e)=>{io.write(e)
   return 20},}
  match output(loaded,worker,root,text.concat(name,"-rate1")) {ok(_)=>{},err(e)=>{io.write(e)
   return 20},}
  match output(relinked,worker,root,text.concat(name,"-slipped")) {ok(_)=>{},err(e)=>{io.write(e)
   return 20},}
  string.append(ledger,name)
  string.append(ledger,"\tPRESERVED\n")
 }
 let _=files.write_text(path.join(root,"ledger.tsv"),ledger)
 io.write("forward retime context proof passed\n")
 0
}
