// Refused edge edits must preserve the entire application transaction, including redo.
module genesis.tests.trim_history
import std.editor as editor
import std.editor_io as editor_io
import std.files as files
import std.path as path
import std.testing as test
import std.text as text
import "../src/app.ai" as app
import "../src/commands.ai" as commands
import "../src/filter_keys.ai" as filter_keys
import "../src/provider.ai" as provider

fn encoded(doc: ref<editor.Document>) -> string effects {alloc} {
  match editor_io.encode(doc) {ok(value)=>value,err(_)=>string.copy("encode failed"),}
}
fn history_bytes(history: ref<editor.History>) -> string effects {alloc} {
  var out: string = text.concat("depth ",string.from_int(history.depth))
  string.append(out,"\nundo\n")
  var index: u64 = 0
  loop {if index >= editor.undo_depth(history) {break}
    string.append(out,encoded(array.borrow(struct.borrow(history,field=undo),index)))
    string.append(out,"\n")
    index=index+1
  }
  string.append(out,"redo\n")
  index=0
  loop {if index >= editor.redo_depth(history) {break}
    string.append(out,encoded(array.borrow(struct.borrow(history,field=redo),index)))
    string.append(out,"\n")
    index=index+1
  }
  out
}
fn fixture(root: str) -> app.App effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  var state: app.App = app.app(provider.fake(root))
  let imported: commands.Result = commands.import_media(state,"trim.mov","Trim transaction source")
  let track: u64 = app.default_video_track(state)
  let audio_track: u64 = app.default_audio_track(state)
  let original: commands.Result = commands.append_clip(state,track,imported.value,10,60)
  let _ = commands.move_clip(state,original.value,track,20)
  let follower: u64 = option.unwrap(editor.place(struct.borrow(state,field=document),track,imported.value,10,10,80))
  let _ = editor.place(struct.borrow(state,field=document),audio_track,imported.value,10,10,80)
  let _ = commands.select_only(state,original.value)
  let _ = editor.select(struct.borrow(state,field=document),follower,true)
  let filter: commands.Result = commands.add_filter(state,original.value,"brightness")
  let _ = commands.set_filter_param(state,filter.value,"level",0.75)
  let key: string = filter_keys.name(filter.value,"brightness","level")
  let _ = editor.set_key(struct.borrow(state,field=document),original.value,key,0,0.5,1)
  let _ = editor.set_key(struct.borrow(state,field=document),original.value,key,50,1.2,1)
  struct.set(state,filter.value,field=selected_filter)
  let _ = commands.set_clip_field(state,original.value,"gain",0.6)
  let _ = commands.set_clip_field(state,original.value,"gain",0.8)
  let _ = commands.undo(state)
  let _ = commands.undo(state)
  app.mark_dirty(state,false)
  state
}
fn trim(state: ref<app.App>, operation: u64, clip: u64, value: i64) -> commands.Result effects {alloc} {
  if operation == 0 {return commands.trim_start(state,clip,value)}
  if operation == 1 {return commands.trim_end(state,clip,value)}
  commands.ripple_trim_end(state,clip,value)
}
fn toolkit_trim(doc: ref<editor.Document>, operation: u64, clip: u64, value: i64) -> bool effects {alloc} {
  if operation == 0 {return editor.trim_start(doc,clip,value)}
  if operation == 1 {return editor.trim_end(doc,clip,value)}
  editor.ripple_trim_end(doc,clip,value)
}
fn at(doc: ref<editor.Document>, track: u64, start: i64) -> u64 effects {} {
  var index: u64 = 0
  loop {if index >= array.len(struct.borrow(doc,field=clips)) {break}
    let clip: editor.Clip = array.get(struct.borrow(doc,field=clips),index)
    if clip.track == track and clip.start == start {return clip.id}
    index=index+1
  }
  0
}
pub fn main(args: view<str>) -> i32 effects {alloc,env,fs.meta,fs.read,fs.write,io.write,process,time} {
  if view.len(args) < 2 {return 2}
  let root: str = view.get(args,1)
  let _ = files.mkdirs(root)
  var suite: test.Suite = test.suite("Genesis trim transaction history",false)
  var refusal: u64 = 0
  loop {if refusal == 3 {break}
    let _ = test.start(suite,text.concat("Refused trim preserves every snapshot and selected item: ",string.from_int(refusal)))
    var state: app.App = fixture(root)
    let clip: u64 = app.current_clip(state)
    let track: u64 = app.default_video_track(state)
    let doc: ref<editor.Document> = struct.borrow(state,field=document)
    struct.set(doc,editor.bounds_reject(),field=source_bounds)
    if refusal == 1 {let _ = editor.set_track_lock(doc,track,true)}
    if refusal == 2 {
      // Re-probed media can be shorter than the already saved clip. Head trim
      // used to write its new start before source-range validation refused it.
      let source: u64 = option.unwrap(editor.clip(doc,clip)).source
      let slot: u64 = option.unwrap(editor.source_slot(doc,source))
      struct.set(array.borrow(struct.borrow(doc,field=sources),slot),30,field=frames)
    }
    let before: string = encoded(doc)
    let history: string = history_bytes(struct.borrow(state,field=history))
    let revision: u64 = state.document_revision
    let media_revision: u64 = state.media_revision
    let selected_filter: u64 = state.selected_filter
    let _ = test.check(suite,before != "encode failed","Fixture project encoding succeeds")
    let _ = test.eq_u64(suite,editor.redo_depth(struct.borrow(state,field=history)),2,"Fixture contains two real redo snapshots")
    var operation: u64 = 0
    loop {if operation == 3 {break}
      let target: u64 = if refusal == 0 {999999}else{clip}
      let value: i64 = if operation == 0 {30}else{if refusal == 2 {1000000}else{40}}
      var refused: commands.Result = trim(state,operation,target,value)
      let _ = test.check(suite,not refused.ok and text.contains(commands.message(refused),"GA_TRIM_CONTEXT"),"Refused edit reports a trim code")
      let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),before,"Complete project bytes including selection and automation stay intact")
      let _ = test.eq_str(suite,history_bytes(struct.borrow(state,field=history)),history,"Every undo and redo snapshot and history bound stay intact")
      let _ = test.eq_u64(suite,state.document_revision,revision,"Refusal preserves semantic document revision")
      let _ = test.eq_u64(suite,state.media_revision,media_revision,"Refusal preserves media revision")
      let _ = test.eq_u64(suite,app.current_clip(state),clip,"Refusal preserves selected clip")
      let _ = test.eq_u64(suite,state.selected_filter,selected_filter,"Refusal preserves picked filter identity")
      let _ = test.check(suite,not app.dirty(state),"Refusal leaves saved project clean")
      operation=operation+1
    }
    let _ = test.done(suite)
    refusal=refusal+1
  }
  let _ = test.start(suite,"Zero-delta trim succeeds without capturing history or changing state")
  var stationary: app.App = fixture(root)
  let stationary_clip: u64 = app.current_clip(stationary)
  let stationary_before: string = encoded(struct.borrow(stationary,field=document))
  let stationary_history: string = history_bytes(struct.borrow(stationary,field=history))
  let stationary_revision: u64 = stationary.document_revision
  let stationary_filter: u64 = stationary.selected_filter
  let stationary_track: u64 = app.default_video_track(stationary)
  let _ = editor.set_track_lock(struct.borrow(stationary,field=document),stationary_track,true)
  let stationary_locked: string = encoded(struct.borrow(stationary,field=document))
  let _ = test.check(suite,stationary_before != stationary_locked,"Fixture includes a locked but otherwise unchanged clip")
  var operation: u64 = 0
  loop {if operation == 3 {break}
    var result: commands.Result = trim(stationary,operation,stationary_clip,if operation == 0 {20}else{60})
    let _ = test.check(suite,result.ok and text.contains(commands.message(result),"GA_TRIM_NO_CHANGE"),"Stationary trim reports successful no-change")
    let _ = test.eq_str(suite,encoded(struct.borrow(stationary,field=document)),stationary_locked,"No-change preserves complete project bytes")
    let _ = test.eq_str(suite,history_bytes(struct.borrow(stationary,field=history)),stationary_history,"No-change preserves every undo/redo snapshot")
    let _ = test.eq_u64(suite,stationary.document_revision,stationary_revision,"No-change preserves revision")
    let _ = test.eq_u64(suite,app.current_clip(stationary),stationary_clip,"No-change preserves selection")
    let _ = test.eq_u64(suite,stationary.selected_filter,stationary_filter,"No-change preserves picked filter")
    let _ = test.check(suite,not app.dirty(stationary),"Stationary drag leaves saved project clean")
    operation=operation+1
  }
  let _ = test.done(suite)
  operation=0
  loop {if operation == 3 {break}
    let _ = test.start(suite,text.concat("Clamped trim returns unchanged and preserves the redo future: ",string.from_int(operation)))
    var state: app.App = fixture(root)
    let clip: u64 = app.current_clip(state)
    let doc: ref<editor.Document> = struct.borrow(state,field=document)
    let slot: u64 = option.unwrap(editor.clip_slot(doc,clip))
    if operation == 0 {
      struct.set(array.borrow(struct.borrow(doc,field=clips),slot),0,field=source_in)
    } else {
      let source: u64 = option.unwrap(editor.clip(doc,clip)).source
      let source_slot: u64 = option.unwrap(editor.source_slot(doc,source))
      struct.set(array.borrow(struct.borrow(doc,field=sources),source_slot),70,field=frames)
    }
    let before: string = encoded(doc)
    let history: string = history_bytes(struct.borrow(state,field=history))
    let revision: u64 = state.document_revision
    let media_revision: u64 = state.media_revision
    let selected_filter: u64 = state.selected_filter
    let request: i64 = if operation == 0 {-100}else{1000000}
    var candidate: editor.Document = editor.copy_document(struct.borrow(state,field=document))
    let _ = test.check(suite,toolkit_trim(candidate,operation,clip,request),"Actual toolkit accepts the out-of-range request under clamp policy")
    let _ = test.eq_str(suite,encoded(candidate),before,"Toolkit source clamp resolves to exact original document")
    let _ = test.eq_u64(suite,editor.redo_depth(struct.borrow(state,field=history)),2,"Fixture retains two actual redo snapshots")
    var result: commands.Result = trim(state,operation,clip,request)
    let _ = test.check(suite,result.ok and text.contains(commands.message(result),"GA_TRIM_NO_CHANGE"),"Clamped identity reports successful no-change")
    let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),before,"Clamped identity preserves complete project bytes")
    let _ = test.eq_str(suite,history_bytes(struct.borrow(state,field=history)),history,"Clamped identity preserves every undo/redo snapshot")
    let _ = test.eq_u64(suite,state.document_revision,revision,"Clamped identity preserves semantic revision")
    let _ = test.eq_u64(suite,state.media_revision,media_revision,"Clamped identity preserves media revision")
    let _ = test.eq_u64(suite,app.current_clip(state),clip,"Clamped identity preserves clip selection")
    let _ = test.eq_u64(suite,state.selected_filter,selected_filter,"Clamped identity preserves picked filter")
    let _ = test.check(suite,not app.dirty(state),"Clamped identity leaves saved project clean")
    let _ = test.done(suite)
    operation=operation+1
  }
  operation=0
  loop {if operation == 3 {break}
    let _ = test.start(suite,text.concat("Successful trim commits once and roundtrips through Undo/Redo: ",string.from_int(operation)))
    var state: app.App = fixture(root)
    let clip: u64 = app.current_clip(state)
    let track: u64 = app.default_video_track(state)
    let audio_track: u64 = app.default_audio_track(state)
    let doc: ref<editor.Document> = struct.borrow(state,field=document)
    let follower: u64 = at(doc,track,80)
    let other: u64 = at(doc,audio_track,80)
    let before: string = encoded(doc)
    let _ = test.check(suite,before != "encode failed","Fixture project encoding succeeds")
    let depth: u64 = editor.undo_depth(struct.borrow(state,field=history))
    let revision: u64 = state.document_revision
    let selected_filter: u64 = state.selected_filter
    let committed: commands.Result = trim(state,operation,clip,if operation == 0 {30}else{40})
    let _ = test.check(suite,committed.ok,"Legal edge edit succeeds")
    let _ = test.eq_u64(suite,editor.undo_depth(struct.borrow(state,field=history)),depth+1,"Successful trim captures exactly one original state")
    let _ = test.eq_u64(suite,editor.redo_depth(struct.borrow(state,field=history)),0,"Committed trim replaces the redo future")
    let _ = test.eq_u64(suite,state.document_revision,revision+1,"Successful trim invalidates semantic state exactly once")
    let _ = test.check(suite,app.dirty(state),"Committed edge edit dirties the project")
    let _ = test.eq_u64(suite,app.current_clip(state),clip,"Trim preserves clip selection")
    let _ = test.eq_u64(suite,state.selected_filter,selected_filter,"Trim preserves picked filter identity")
    let changed: editor.Clip = option.unwrap(editor.clip(struct.borrow(state,field=document),clip))
    let _ = test.eq_i64(suite,changed.start,if operation == 0 {30}else{20},"Committed trim has the requested head")
    let _ = test.eq_i64(suite,changed.length,if operation == 0 {50}else{40},"Committed trim has the requested body length")
    let _ = test.eq_i64(suite,changed.source_in,if operation == 0 {20}else{10},"Committed forward trim preserves source time")
    let _ = test.eq_i64(suite,option.unwrap(editor.clip(struct.borrow(state,field=document),follower)).start,if operation == 2 {60}else{80},"Only ripple tail shifts the following same-track clip")
    let _ = test.eq_i64(suite,option.unwrap(editor.clip(struct.borrow(state,field=document),other)).start,80,"Ripple leaves the other track fixed")
    let after: string = encoded(struct.borrow(state,field=document))
    let _ = test.check(suite,after != before,"Committed document contains a real edit")
    let undone: commands.Result = commands.undo(state)
    let _ = test.check(suite,undone.ok,"One Undo succeeds")
    let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),before,"One Undo restores exact clip curves and project bytes")
    let redone: commands.Result = commands.redo(state)
    let _ = test.check(suite,redone.ok,"One Redo succeeds")
    let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),after,"Redo restores the exact committed project")
    let _ = test.done(suite)
    operation=operation+1
  }
  test.conclude(suite,path.join(root,"trim-history-tests.json"),12)
}
