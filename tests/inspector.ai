module genesis.inspector_tests
import std.draw as draw
import std.editor as editor
import std.font as font
import std.geometry as geometry
import std.math as math
import std.curve as curve
import std.timeline as timeline
import "../src/view.ai" as painter
import std.path as path
import std.testing as test
import std.widgets as widgets
import "../src/app.ai" as app
import "../src/chrome.ai" as chrome
import "../src/commands.ai" as commands
import "../src/input.ai" as input
import "../src/layout.ai" as layout
import "../src/provider.ai" as provider
import "../src/typeface.ai" as typeface
import "../src/ui_text.ai" as ui_text
import "../src/timeline_media.ai" as media
import "../src/preview.ai" as preview

fn fixture(scratch: str) -> app.App effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  var state: app.App = app.app(provider.fake(scratch))
  var source: commands.Result = commands.import_media(state, "media/test.mov", "Inspector clip")
  let track: u64 = app.default_video_track(state)
  var clip: commands.Result = commands.append_clip(state, track, source.value, 0, 60)
  let _ = commands.select_only(state, clip.value)
  state
}
fn flat(color: draw.Color) -> draw.Surface effects {alloc} {
  var canvas: draw.Canvas = draw.canvas(option.unwrap(draw.surface(64,64)))
  draw.clear(canvas,color)
  draw.finish(canvas)
}
fn histogram_pixel(surface: ref<draw.Surface>, frame: layout.Frame, bucket: u64, channel: u64) -> draw.Color effects {} {
  let column: f64 = (layout.width_of(frame.dock_body)-12.0)/64.0
  let bar: f64 = (column-0.5)/3.0
  // The first red bar touches the plot outline; sample its interior rather
  // than the antialiased border. Other bins use their channel centers.
  option.unwrap(draw.surface_pixel(surface,cast.sat(frame.dock_body.left+6.0+cast.float(bucket)*column+(cast.float(channel)+(if bucket == 0 and channel == 0 {0.8}else{0.5}))*bar),
    cast.sat(frame.dock_body.top+6.0+12.0+48.0)))
}

fn parameter(controls: ref<array<chrome.Control>>, kind: str, name: str) -> layout.Rect effects {alloc} {
  var i: u64 = 0
  loop {
    if i >= array.len(controls) { break }
    let control: ref<chrome.Control> = array.borrow(controls, i)
    let named: string = chrome.name_of(control)
    let family: string = chrome.kind_of(control)
    if control.action == chrome.act_param_set() and str.eq(str.view(named), name) and
        str.eq(str.view(family), kind) { return control.area }
    i = i + 1
  }
  layout.rect(0.0, 0.0, 0.0, 0.0)
}

pub fn main(args: view<str>) -> i32 effects {alloc, env, fs.meta, fs.read, fs.write, io.write, process, time} {
  if view.len(args) < 2 { return 2 }
  let scratch: str = view.get(args, 1)
  var suite: test.Suite = test.suite("Genesis inspector and TrueType UI", false)
  let frame: layout.Frame = layout.frame(1600.0, 980.0)

  let _ = test.start(suite, "Empty inspector and single-clip project open")
  var state: app.App = fixture(scratch)
  let clip: u64 = app.current_clip(state)
  let _ = commands.clear_selection(state)
  var empty: array<chrome.Control> = chrome.properties_panel(frame, state)
  let _ = test.eq_u64(suite, array.len(empty), 2, "No misleading parameter controls without selection")
  app.set_dock_tab(state, chrome.tab_filters())
  var no_filters: array<chrome.Control> = chrome.filters_panel(frame, state)
  let _ = test.eq_u64(suite, array.len(no_filters), 2, "No active filter library without a clip")
  let project: string = path.join(scratch, "inspector-open.air")
  var saved: commands.Result = commands.save_project(state, str.view(project))
  var opened: commands.Result = commands.open_project(state, str.view(project))
  let _ = test.check(suite, saved.ok and opened.ok, "Project round trip")
  let _ = test.eq_u64(suite, app.current_clip(state), clip, "Single clip opens selected")
  let _ = test.check(suite, not app.dirty(state), "Selecting the opened clip does not report a user edit")
  let _ = test.done(suite)

  let _ = test.start(suite, "Both monitors expose real transport buttons")
  let source: u64 = struct.get(struct.borrow(state, field=document), field=monitor_source)
  let source_id: u64 = struct.get(array.borrow(struct.borrow(struct.borrow(state, field=document), field=sources), 0), field=id)
  let _ = commands.open_source(state, source_id)
  var source_controls: array<chrome.Control> = chrome.monitor_controls(frame, state, true)
  var program_controls: array<chrome.Control> = chrome.monitor_controls(frame, state, false)
  let _ = test.eq_u64(suite, array.len(source_controls), 7, "Source has transport and fullscreen controls")
  let _ = test.eq_u64(suite, array.len(program_controls), 7, "Program has transport and fullscreen controls")
  var button: layout.Rect = struct.get(array.borrow(program_controls, 2), field=area)
  let _ = input.pointer_down(state, 1600.0, 980.0, (button.left + button.right)*0.5, (button.top + button.bottom)*0.5)
  let _ = test.check(suite, editor.playing(struct.borrow(state, field=document)), "Program Play starts playback")
  button = struct.get(array.borrow(program_controls, 3), field=area)
  let _ = input.pointer_down(state, 1600.0, 980.0, (button.left + button.right)*0.5, (button.top + button.bottom)*0.5)
  let _ = test.check(suite, not editor.playing(struct.borrow(state, field=document)), "Program Stop stops playback")
  button = struct.get(array.borrow(source_controls, 2), field=area)
  let _ = input.pointer_down(state, 1600.0, 980.0, (button.left + button.right)*0.5, (button.top + button.bottom)*0.5)
  let _ = test.check(suite, struct.get(struct.borrow(struct.borrow(state, field=document), field=monitor), field=playing), "Source Play starts its independent transport")
  let _ = test.check(suite, not editor.playing(struct.borrow(state, field=document)), "Source playback pauses the program")
  button = struct.get(array.borrow(source_controls, 3), field=area)
  let _ = input.pointer_down(state, 1600.0, 980.0, (button.left + button.right)*0.5, (button.top + button.bottom)*0.5)
  let _ = test.check(suite, not struct.get(struct.borrow(struct.borrow(state, field=document), field=monitor), field=playing), "Source Stop stops playback")
  let _ = test.done(suite)

  let _ = test.start(suite, "Monitor scrub bars seek live and clamp outside release")
  let bar_source: layout.Rect = layout.monitor_scrub(frame.source)
  let source_frames: i64 = editor.source_frames(struct.borrow(state, field=document), source_id)
  let _ = input.pointer_down(state, 1600.0, 980.0, bar_source.left, (bar_source.top + bar_source.bottom)*0.5)
  let _ = input.pointer_move(state, 1600.0, 980.0, (bar_source.left + bar_source.right)*0.5, bar_source.top)
  let _ = test.eq_i64(suite, struct.get(struct.borrow(struct.borrow(state, field=document), field=monitor), field=frame), cast.sat(math.round(cast.float(source_frames - 1)*0.5)), "Source drag uses native source frames")
  let _ = input.pointer_up(state, 1600.0, 980.0, bar_source.right + 500.0, bar_source.top)
  let _ = test.eq_i64(suite, struct.get(struct.borrow(struct.borrow(state, field=document), field=monitor), field=frame), source_frames - 1, "Source release outside clamps to last frame")
  let bar_program: layout.Rect = layout.monitor_scrub(frame.program)
  let _ = commands.program(state, editor.play())
  let _ = input.pointer_down(state, 1600.0, 980.0, bar_program.left, bar_program.top + 5.0)
  let _ = test.check(suite, not editor.playing(struct.borrow(state, field=document)), "Scrub pauses the advancing playback clock")
  let _ = input.pointer_move(state, 1600.0, 980.0, (bar_program.left + bar_program.right)*0.5, bar_program.top)
  let _ = test.eq_i64(suite, editor.playhead(struct.borrow(state, field=document)), 30, "Program drag updates the project playhead immediately")
  let _ = input.pointer_up(state, 1600.0, 980.0, bar_program.right + 500.0, bar_program.top)
  let _ = test.eq_i64(suite, editor.playhead(struct.borrow(state, field=document)), 59, "Program release outside clamps to last frame")
  let _ = test.check(suite, app.gesture_kind(state) == app.drag_none(), "Release ends the seek gesture")
  let _ = test.done(suite)

  let _ = test.start(suite, "Timeline ruler drag pauses and follows its painted frame mapping")
  let _ = commands.program(state, editor.play())
  var model: timeline.Timeline = painter.timeline_model(state, frame.timeline)
  let x: f64 = timeline.frame_to_x(model, 20)
  let _ = input.pointer_down(state, 1600.0, 980.0, frame.ruler.left + 1.0, frame.ruler.top + 5.0)
  let _ = input.pointer_move(state, 1600.0, 980.0, x, frame.ruler.top + 5.0)
  let _ = input.pointer_up(state, 1600.0, 980.0, x, frame.ruler.top + 5.0)
  let _ = test.eq_i64(suite, editor.playhead(struct.borrow(state, field=document)), 20, "Ruler scrub lands on frame 20")
  let _ = test.check(suite, not editor.playing(struct.borrow(state, field=document)), "The clock does not override ruler scrub")
  let _ = test.done(suite)

  let _ = test.start(suite, "Dragging the painted playhead preserves video lanes")
  let original: editor.Clip = option.unwrap(editor.clip(struct.borrow(state, field=document), clip))
  let handle_x: f64 = timeline.frame_to_x(model, 20)
  let target_x: f64 = timeline.frame_to_x(model, 40)
  let _ = input.pointer_down(state, 1600.0, 980.0, handle_x, frame.timeline.top + 70.0)
  let _ = input.pointer_move(state, 1600.0, 980.0, target_x, frame.timeline.top + 125.0)
  let _ = test.eq_i64(suite, editor.playhead(struct.borrow(state, field=document)), 40, "Lane-area handle updates time during the drag")
  let _ = input.pointer_up(state, 1600.0, 980.0, target_x, frame.timeline.top + 125.0)
  let after_drag: editor.Clip = option.unwrap(editor.clip(struct.borrow(state, field=document), clip))
  let _ = test.eq_u64(suite, after_drag.track, original.track, "Dragging the playhead does not move video to A1")
  let _ = test.eq_i64(suite, after_drag.length, original.length, "Dragging the playhead does not trim the clip")
  var wrong_lane: commands.Result = commands.move_clip(state, clip, app.default_audio_track(state), 0)
  let _ = test.check(suite, not wrong_lane.ok, "Crossing into an audio lane is refused")
  let kept: editor.Clip = option.unwrap(editor.clip(struct.borrow(state, field=document), clip))
  let _ = test.eq_u64(suite, kept.track, original.track, "Refused move keeps the picture on V1")
  let _ = test.done(suite)

  let _ = test.start(suite, "Fullscreen retains program transport and scrub controls")
  app.set_focus(state, app.panel_program())
  let _ = input.key(state, 65480, false, false)
  let _ = test.eq_u64(suite, cast.wrap(state.fullscreen), 1, "F11 opens the program monitor")
  let full_area: layout.Rect = chrome.monitor_area(frame, state, false)
  var full_controls: array<chrome.Control> = chrome.monitor_controls(frame, state, false)
  let _ = test.check(suite, layout.width_of(full_area) > 1500.0, "Fullscreen monitor uses the whole client")
  var full_index: u64 = 0
  loop { if full_index >= array.len(full_controls) { break }
    let c: ref<chrome.Control> = array.borrow(full_controls, full_index)
    if c.action == chrome.act_play() {
      let _ = input.pointer_down(state, 1600.0, 980.0, (c.area.left + c.area.right)*0.5, (c.area.top + c.area.bottom)*0.5)
      break
    }
    full_index = full_index + 1
  }
  let _ = test.check(suite, editor.playing(struct.borrow(state, field=document)), "Fullscreen Play drives the program")
  let full_bar: layout.Rect = layout.monitor_scrub(full_area)
  let _ = input.pointer_down(state, 1600.0, 980.0, full_bar.left, full_bar.top + 5.0)
  let _ = input.pointer_move(state, 1600.0, 980.0, (full_bar.left+full_bar.right)*0.5, full_bar.top)
  let _ = test.eq_i64(suite, editor.playhead(struct.borrow(state, field=document)), 30, "Fullscreen scrub updates time")
  let _ = input.pointer_up(state, 1600.0, 980.0, full_bar.left, full_bar.top)
  let _ = input.key(state, widgets.key_escape(), false, false)
  let _ = test.eq_u64(suite, cast.wrap(state.fullscreen), 0, "Escape restores the editor")
  let _ = test.check(suite, not editor.playing(struct.borrow(state, field=document)), "Seek remains paused after fullscreen exit")
  let _ = test.done(suite)

  let _ = test.start(suite, "Slider drag updates live, clamps and has one undo")
  app.set_dock_tab(state, chrome.tab_properties())
  var controls: array<chrome.Control> = chrome.properties_panel(frame, state)
  let bar: layout.Rect = parameter(controls, "size_position", "x")
  let y: f64 = (bar.top + bar.bottom) * 0.5
  let _ = input.pointer_down(state, 1600.0, 980.0, bar.left + layout.width_of(bar) * 0.25, y)
  let _ = test.check(suite, app.parameter_dragging(state), "Press begins a parameter drag")
  let filter: u64 = chrome.filter_of_kind(struct.borrow(state, field=document), clip, "size_position")
  let _ = test.check(suite, filter != 0, "First edit creates its filter")
  let _ = input.pointer_move(state, 1600.0, 980.0, bar.left + layout.width_of(bar) * 0.75, y)
  let _ = test.near_f64(suite, editor.filter_param(struct.borrow(state, field=document), filter, "x", -1.0), 0.5, 0.00001, "Live drag sets the actual project parameter")
  let _ = input.pointer_up(state, 1600.0, 980.0, bar.right + 200.0, y)
  let _ = test.near_f64(suite, editor.filter_param(struct.borrow(state, field=document), filter, "x", -1.0), 1.0, 0.00001, "Release outside the bar clamps to maximum")
  let _ = test.check(suite, not app.parameter_dragging(state), "Release ends the drag")
  var undone: commands.Result = commands.undo(state)
  let _ = test.check(suite, undone.ok, "One undo succeeds")
  let _ = test.eq_u64(suite, editor.filter_count(struct.borrow(state, field=document), clip), 0, "One undo removes the whole drag and new filter")
  let _ = test.done(suite)

  let _ = test.start(suite, "Escape cancels parameter drag")
  let _ = input.pointer_down(state, 1600.0, 980.0, bar.right - 2.0, y)
  let _ = input.pointer_move(state, 1600.0, 980.0, bar.left, y)
  let _ = input.key(state, widgets.key_escape(), false, false)
  let _ = test.check(suite, not app.parameter_dragging(state), "Escape ends drag")
  let _ = test.eq_u64(suite, editor.filter_count(struct.borrow(state, field=document), clip), 0, "Escape restores original project")
  let _ = test.done(suite)

  let _ = test.start(suite, "Disabled filters remain selectable and editable")
  var first: commands.Result = commands.add_filter(state, clip, "brightness")
  let _ = commands.toggle_filter(state, first.value)
  let _ = commands.add_filter(state, clip, "contrast")
  app.set_dock_tab(state, chrome.tab_filters())
  var stack: array<chrome.Control> = chrome.filters_panel(frame, state)
  var i: u64 = 0
  loop {
    if i >= array.len(stack) { break }
    let control: ref<chrome.Control> = array.borrow(stack, i)
    if control.action == chrome.act_filter_pick() and control.target == first.value {
      let area: layout.Rect = control.area
      let _ = input.pointer_down(state, 1600.0, 980.0, (area.left + area.right) * 0.5, (area.top + area.bottom) * 0.5)
      break
    }
    i = i + 1
  }
  let _ = test.eq_u64(suite, app.selected_filter(state), first.value, "Click can select a disabled filter")
  let _ = test.check(suite, not editor.filter_enabled(struct.borrow(state, field=document), first.value), "Selection preserves disabled state")
  let _ = test.done(suite)

  let _ = test.start(suite, "Embedded video audio has active controls and invalidates the real mix")
  let _ = editor.describe_source(struct.borrow(state, field=document), source_id, 640, 360, true, true, 48000, 2)
  let track: u64 = app.default_video_track(state)
  var audio_tracks: array<u64> = chrome.audio_tracks(struct.borrow(state, field=document))
  let _ = test.eq_u64(suite, array.get(audio_tracks, 0), track, "Video with embedded audio is the first active strip")
  let before_sound: string = media.audio_signature(struct.borrow(state, field=document))
  app.set_dock_tab(state, chrome.tab_audio())
  var audio_controls: array<chrome.Control> = chrome.audio_panel(frame, state)
  var slot: u64 = 0
  loop { if slot >= array.len(audio_controls) { break }
    let control: ref<chrome.Control> = array.borrow(audio_controls, slot)
    let name: string = chrome.name_of(control)
    if control.action == chrome.act_param_set() and control.domain == chrome.domain_track() and control.target == track and str.eq(str.view(name), "gain") {
      let box: layout.Rect = control.area
      let _ = test.check(suite, control.enabled, "Embedded audio gain is enabled")
      let _ = input.pointer_down(state, 1600.0, 980.0, box.left + layout.width_of(box)*0.25, (box.top + box.bottom)*0.5)
      let _ = input.pointer_up(state, 1600.0, 980.0, box.left + layout.width_of(box)*0.25, (box.top + box.bottom)*0.5)
      break
    }
    slot = slot + 1
  }
  let _ = test.near_f64(suite, editor.track_gain(struct.borrow(state, field=document), track), 0.5, 0.001, "Audio gain click edits the audible video track")
  let _ = test.check(suite, not str.eq(str.view(before_sound), str.view(media.audio_signature(struct.borrow(state, field=document)))), "Fader changes invalidate queued PCM")
  let gain_sound: string = media.audio_signature(struct.borrow(state, field=document))
  let _ = commands.set_filter_param(state, first.value, "level", 1.1)
  let _ = commands.seek(state, 15)
  let _ = test.check(suite, str.eq(str.view(gain_sound), str.view(media.audio_signature(struct.borrow(state, field=document)))), "Picture-only edits and transport do not restart sound")
  let _ = commands.set_parameter(state, chrome.domain_clip(), clip, "", "pan", -1.0)
  let _ = test.check(suite, not str.eq(str.view(gain_sound), str.view(media.audio_signature(struct.borrow(state, field=document)))), "Clip pan is wired to the real mix")
  let _ = commands.set_parameter(state, chrome.domain_clip(), clip, "", "pan", 4.0)
  let value: editor.Clip = option.unwrap(editor.clip(struct.borrow(state, field=document), clip))
  let _ = test.near_f64(suite, value.pan, 1.0, 0.001, "Clip pan clamps at the right channel")
  let _ = test.check(suite, not editor.set_clip_pan(struct.borrow(state, field=document), 999999, 0.0), "Missing clip pan is refused")
  var mute_box: layout.Rect = layout.rect(0.0,0.0,0.0,0.0)
  var solo_box: layout.Rect = layout.rect(0.0,0.0,0.0,0.0)
  slot=0
  loop {if slot >= array.len(audio_controls) {break}
    let control: ref<chrome.Control> = array.borrow(audio_controls,slot)
    if control.target == track {
      if control.action == chrome.act_track_mute() {mute_box=control.area}
      if control.action == chrome.act_track_solo() {solo_box=control.area}
      let named: string = chrome.name_of(control)
      if control.action == chrome.act_param_set() and str.eq(str.view(named),"pan") {
        let box: layout.Rect = control.area
        let _ = test.check(suite,control.enabled,"Embedded track pan is enabled")
        let _ = input.pointer_down(state,1600.0,980.0,box.left+layout.width_of(box)*0.75,(box.top+box.bottom)*0.5)
        let _ = input.pointer_up(state,1600.0,980.0,box.left+layout.width_of(box)*0.75,(box.top+box.bottom)*0.5)
      }
    }
    slot=slot+1
  }
  let _ = test.near_f64(suite,editor.track_pan(struct.borrow(state,field=document),track),0.5,0.001,"Audio panel pan edits the actual track mix")
  let mixed: string = media.audio_signature(struct.borrow(state,field=document))
  let _ = input.pointer_down(state,1600.0,980.0,(mute_box.left+mute_box.right)*0.5,(mute_box.top+mute_box.bottom)*0.5)
  let _ = test.check(suite,not editor.track_audible(struct.borrow(state,field=document),track),"Audio panel Mute silences the embedded track")
  let _ = test.check(suite,not str.eq(str.view(mixed),str.view(media.audio_signature(struct.borrow(state,field=document)))),"Mute invalidates queued sound")
  let _ = input.pointer_down(state,1600.0,980.0,(mute_box.left+mute_box.right)*0.5,(mute_box.top+mute_box.bottom)*0.5)
  let _ = test.check(suite,editor.track_audible(struct.borrow(state,field=document),track),"Unmute restores the embedded track")
  let _ = input.pointer_down(state,1600.0,980.0,(solo_box.left+solo_box.right)*0.5,(solo_box.top+solo_box.bottom)*0.5)
  let owner: u64 = struct.get(struct.borrow(state,field=document),field=active)
  let _ = test.check(suite,editor.any_solo(struct.borrow(state,field=document),owner),"Audio panel Solo edits the mixer state")
  let _ = input.pointer_down(state,1600.0,980.0,(solo_box.left+solo_box.right)*0.5,(solo_box.top+solo_box.bottom)*0.5)
  let _ = test.check(suite,not editor.any_solo(struct.borrow(state,field=document),owner),"Solo toggles back off")
  let _ = test.done(suite)

  let _ = test.start(suite, "File shortcuts preserve clips and route to native prompts")
  app.set_project_path(state, "")
  let clips_before_save: u64 = editor.clip_count(struct.borrow(state, field=document))
  let _ = commands.seek(state, 25)
  let _ = input.key(state, 115, true, false)
  let _ = test.check(suite, app.prompt_active(state) and app.prompt_action(state) == chrome.act_save(), "Ctrl+S opens Save for an untitled project")
  let _ = test.eq_u64(suite, editor.clip_count(struct.borrow(state, field=document)), clips_before_save, "Ctrl+S never splits clips")
  let _ = input.key(state, widgets.key_escape(), false, false)
  let _ = input.key(state, 111, true, false)
  let _ = test.check(suite, app.prompt_active(state) and app.prompt_action(state) == chrome.act_open(), "Ctrl+O opens the project picker")
  let _ = input.key(state, widgets.key_escape(), false, false)
  let _ = test.done(suite)

  let _ = test.start(suite, "Audio gain K and sliders edit clip-local keys with one undo")
  var keyed: app.App = app.app(provider.fake(scratch))
  let keyed_source: u64 = editor.add_source(struct.borrow(keyed,field=document),"audio.wav","Audio",120,30.0)
  let _ = editor.describe_source(struct.borrow(keyed,field=document),keyed_source,0,0,false,true,48000,2)
  let audio_track: u64 = app.default_audio_track(keyed)
  let keyed_clip: u64 = option.unwrap(editor.place(struct.borrow(keyed,field=document),audio_track,keyed_source,0,60,10))
  let _ = commands.select_only(keyed,keyed_clip)
  let _ = commands.seek(keyed,12)
  let names_before: u64 = array.len(struct.borrow(struct.borrow(keyed,field=document),field=names))
  var unkeyed_controls: array<chrome.Control> = chrome.audio_panel(frame,keyed)
  let _ = test.eq_u64(suite,array.len(struct.borrow(struct.borrow(keyed,field=document),field=names)),names_before,"Reading unkeyed gain leaves project names intact")
  let unkeyed_audio: string = media.audio_signature(struct.borrow(keyed,field=document))
  let _ = test.eq_u64(suite,array.len(struct.borrow(struct.borrow(keyed,field=document),field=names)),names_before,"Planning unkeyed audio leaves project names intact")
  let _ = commands.set_parameter(keyed,chrome.domain_clip(),keyed_clip,"","gain",0.4)
  app.set_dock_tab(keyed,chrome.tab_audio())
  var key_controls: array<chrome.Control> = chrome.audio_panel(frame,keyed)
  var found_key: bool = false
  var k: u64 = 0
  loop {if k >= array.len(key_controls) {break}
    let control: ref<chrome.Control> = array.borrow(key_controls,k)
    let name: string = chrome.name_of(control)
    if control.action == chrome.act_param_key() and control.domain == chrome.domain_clip() and
        str.eq(str.view(name),"gain") {
      found_key=control.enabled
      let box: layout.Rect = control.area
      let _ = input.pointer_down(keyed,1600.0,980.0,(box.left+box.right)*0.5,(box.top+box.bottom)*0.5)
      break}
    k=k+1}
  let _ = test.check(suite,found_key,"Audio clip exposes an active gain K button")
  let _ = test.eq_u64(suite,editor.key_count(struct.borrow(keyed,field=document),keyed_clip,"gain"),1,"Click K creates an audible gain key")
  let first_gain: editor.Key = array.get(struct.borrow(struct.borrow(keyed,field=document),field=keys),0)
  let _ = test.eq_i64(suite,first_gain.frame,2,"Audio gain key uses clip-local frame 2")
  let _ = commands.seek(keyed,22)
  let _ = commands.set_parameter(keyed,chrome.domain_clip(),keyed_clip,"","gain",0.8)
  let _ = test.eq_u64(suite,editor.key_count(struct.borrow(keyed,field=document),keyed_clip,"gain"),2,"Editing a keyed gain adds a key at the current time")
  let _ = commands.seek(keyed,17)
  key_controls=chrome.audio_panel(frame,keyed)
  var gain_box: layout.Rect = layout.rect(0.0,0.0,0.0,0.0)
  k=0
  loop {if k >= array.len(key_controls) {break}
    let control: ref<chrome.Control> = array.borrow(key_controls,k)
    let name: string = chrome.name_of(control)
    if control.action == chrome.act_param_set() and control.domain == chrome.domain_clip() and str.eq(str.view(name),"gain") {
      let _ = test.near_f64(suite,control.value,0.6,0.0001,"Inspector reading follows the gain curve after seek")
      gain_box=control.area
      break}
    k=k+1}
  let before_keys: string = media.audio_signature(struct.borrow(keyed,field=document))
  let _ = input.pointer_down(keyed,1600.0,980.0,gain_box.left+layout.width_of(gain_box)*0.5,(gain_box.top+gain_box.bottom)*0.5)
  let _ = input.pointer_move(keyed,1600.0,980.0,gain_box.left+layout.width_of(gain_box)*0.75,(gain_box.top+gain_box.bottom)*0.5)
  let _ = input.pointer_up(keyed,1600.0,980.0,gain_box.left+layout.width_of(gain_box)*0.75,(gain_box.top+gain_box.bottom)*0.5)
  let _ = test.eq_u64(suite,editor.key_count(struct.borrow(keyed,field=document),keyed_clip,"gain"),3,"Gain drag creates one current-time key")
  let _ = test.check(suite,not str.eq(str.view(before_keys),str.view(media.audio_signature(struct.borrow(keyed,field=document)))),"Gain key edit invalidates queued audio")
  let _ = commands.undo(keyed)
  let _ = test.eq_u64(suite,editor.key_count(struct.borrow(keyed,field=document),keyed_clip,"gain"),2,"One undo removes the complete gain drag")
  let _ = test.near_f64(suite,editor.clip_value_at(struct.borrow(keyed,field=document),keyed_clip,"gain",17,1.0),0.6,0.0001,"Undo restores the audible curve")
  let _ = editor.set_key(struct.borrow(keyed,field=document),keyed_clip,"gain",2,0.4,curve.hold())
  let _ = commands.seek(keyed,12)
  let _ = commands.set_parameter(keyed,chrome.domain_clip(),keyed_clip,"","gain",0.5)
  let updated_gain: editor.Key = array.get(struct.borrow(struct.borrow(keyed,field=document),field=keys),0)
  let _ = test.eq_u64(suite,cast.wrap(updated_gain.interp),cast.wrap(curve.hold()),"Changing an existing key preserves its interpolation")
  let _ = commands.seek(keyed,0)
  let outside: commands.Result = commands.set_parameter(keyed,chrome.domain_clip(),keyed_clip,"","gain",0.7)
  let _ = test.check(suite,not outside.ok,"Keyed gain refuses edits outside its clip")
  let bad_gain: commands.Result = commands.keyframe_parameter(keyed,chrome.domain_clip(),keyed_clip,"","pan",0.7)
  let _ = test.check(suite,not bad_gain.ok,"Unsupported audio pan automation remains refused")
  let _ = test.done(suite)

  let _ = test.start(suite, "Histogram shows every equal-height RGB channel and follows the program frame")
  app.set_dock_tab(state,chrome.tab_scopes())
  var raster: painter.Renderer = painter.renderer()
  var source_picture: draw.Surface = flat(draw.rgb(255,0,0))
  var picture: draw.Surface = flat(draw.rgb(255,255,255))
  let _ = painter.render(state,raster,1600,980,true,source_picture,picture)
  var channel: u64 = 0
  loop {if channel == 3 {break}
    let white: draw.Color = histogram_pixel(struct.borrow(raster,field=surface),frame,63,channel)
    let _ = test.check(suite,if channel == 0 {white.r > 140 and white.g < 100}else if channel == 1 {white.g > 140 and white.r < 100}else{white.b > 140 and white.r < 100},"White frame keeps all three RGB bars visible")
    channel=channel+1
  }
  picture=flat(draw.rgb(0,0,0))
  let _ = painter.render(state,raster,1600,980,false,source_picture,picture)
  channel=0
  loop {if channel == 3 {break}
    let black: draw.Color = histogram_pixel(struct.borrow(raster,field=surface),frame,0,channel)
    let _ = test.check(suite,if channel == 0 {black.r > 140 and black.g < 100}else if channel == 1 {black.g > 140 and black.r < 100}else{black.b > 140 and black.r < 100},"Black frame keeps all three zero-level bars visible")
    channel=channel+1
  }
  picture=flat(draw.rgb(0,0,255))
  let _ = painter.render(state,raster,1600,980,false,source_picture,picture)
  let high_blue: draw.Color = histogram_pixel(struct.borrow(raster,field=surface),frame,63,2)
  let old_red: draw.Color = histogram_pixel(struct.borrow(raster,field=surface),frame,63,0)
  let _ = test.check(suite,high_blue.b > 140 and high_blue.r < 100,"Scopes use the blue program picture while the source is red")
  let _ = test.check(suite,old_red.r < 40 and old_red.g < 40 and old_red.b < 40,"Retained scope repaint removes the previous frame's bins")
  let _ = test.done(suite)

  let _ = test.start(suite,"Completed video stamps drive monitor time and the playing timeline")
  let _ = editor.seek(struct.borrow(state,field=document),50)
  let _ = editor.program_action(struct.borrow(state,field=document),editor.play())
  struct.set(state,30,field=presented_program_frame)
  struct.set(state,17,field=presented_source_frame)
  let _ = test.eq_i64(suite,app.monitor_frame(state,false),30,"Program time stays with decoded frame 30 while transport requests frame 50")
  let _ = test.eq_i64(suite,app.monitor_frame(state,true),17,"Source time uses its independent decoded frame")
  var shown: timeline.Timeline = painter.timeline_model(state,frame.timeline)
  let _ = test.eq_i64(suite,shown.playhead,30,"Playing timeline cursor uses the decoded program frame")
  let _ = test.check(suite,str.eq(str.view(timeline.timecode(app.monitor_frame(state,false),30.0)),"00:00:01:00"),"Program timecode labels the same one-second picture")
  let _ = editor.program_action(struct.borrow(state,field=document),editor.pause())
  let _ = test.eq_i64(suite,app.timeline_frame(state),50,"Paused seeking responds immediately")
  let strip_before: string = preview.strips_signature(struct.borrow(state,field=document))
  let _ = editor.seek(struct.borrow(state,field=document),55)
  let _ = editor.seek_monitor(struct.borrow(state,field=document),20)
  let _ = editor.program_action(struct.borrow(state,field=document),editor.play())
  let _ = test.check(suite,str.eq(str.view(strip_before),str.view(preview.strips_signature(struct.borrow(state,field=document)))),"Playback/seek changes reuse the strip request instead of cancelling it")
  let _ = editor.set_clip_speed(struct.borrow(state,field=document),clip,0.5)
  let _ = test.check(suite,not str.eq(str.view(strip_before),str.view(preview.strips_signature(struct.borrow(state,field=document)))),"Clip rate changes invalidate strip sampling")
  let _ = editor.program_action(struct.borrow(state,field=document),editor.pause())
  app.mark_media_changed(state)
  let _ = test.eq_i64(suite,state.presented_program_frame,-1,"Reload invalidates completed monitor stamps")
  let _ = test.done(suite)

  let _ = test.start(suite, "TrueType metrics, caching and display scale")
  app.set_fonts(state, typeface.search_paths())
  let book: ref<ui_text.Typography> = struct.borrow(state, field=typography)
  let _ = test.check(suite, ui_text.available(book), "Native UI has real TrueType faces")
  let wide: f64 = ui_text.width(book, "WWW", 12.0)
  let narrow: f64 = ui_text.width(book, "iii", 12.0)
  let _ = test.check(suite, wide > narrow * 2.0, "Proportional Segoe UI metrics replace the stroke font")
  let cached: u64 = font.cached_glyphs(array.borrow(struct.borrow(book, field=faces), 2))
  let repeated: f64 = ui_text.width(book, "WWWiii", 12.0)
  let _ = test.eq_u64(suite, font.cached_glyphs(array.borrow(struct.borrow(book, field=faces), 2)), cached, "Repeated chrome labels reuse glyphs")
  ui_text.set_scale(book, 2.0)
  let _ = test.near_f64(suite, ui_text.width(book, "WWW", 12.0), wide, 2.0, "Logical widths remain stable at 2x scale")
  let _ = test.check(suite, font.pixel_size(array.borrow(struct.borrow(book, field=faces), 2)) >= 32, "2x text rasterizes at physical resolution")
  let _ = test.done(suite)
  test.conclude(suite, path.join(scratch, "inspector-tests.json"), 32)
}
