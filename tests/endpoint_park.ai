// A prepared Program endpoint survives Pause/seek retirement and is reused for an
// identical mix. Usage: genesis-endpoint-park WORKER PROJECT.air ROOT
// Writes park-ns.txt (cold, warm-after-pause, edited) and refuses on any regression:
// metadata must match cold, a stale pull must be refused, and an edited mix must
// prepare fresh rather than reuse the parked session.
module test.endpoint_park
import std.curve as curve
import std.editor as editor
import std.editor_io as codec
import std.files as files
import std.path as path
import std.tasks as tasks
import std.text as text
import std.md5 as md5
import "../src/audio_playback.ai" as playback
import "../src/audio_endpoint.ai" as endpoint
import "../src/preview_link.ai" as link
import "../src/timeline_media.ai" as media
import "../src/track_keys.ai" as track_keys
fn ready(peer:ref<link.Link>,id:u64) -> result<unit,string> effects {alloc,net,time} {
  try link.wake(peer,false)
  link.await_ready(peer,id,time.monotonic_ns()+60000000000)
}
fn prepare(peer:ref<link.Link>,root:str,doc:ref<editor.Document>,id:u64,generation:u64) -> result<endpoint.End,string> effects {alloc,fs.read,fs.write,net,time} {
  if not playback.request_prepare_document(root,id,generation,doc,path.join(root,"unused.wav")) {return result.err("prepare publication")}
  try ready(peer,id)
  playback.read_endpoint(root)
}
fn pull(peer:ref<link.Link>,root:str,id:u64,generation:u64,prepared:u64,name:str,start:i64,count:u64) -> result<unit,string> effects {alloc,fs.write,net,time} {
  if not playback.request_pull(root,id,generation,prepared,path.join(root,name),start,count) {return result.err("pull publication")}
  ready(peer,id)
}
// MD5 is only an equality witness here; files.sha256 selects an undeclared SHA-NI
// provider on this pinned SDK's Windows runtime.
fn digest(root:str,name:str) -> result<string,string> effects {alloc,fs.read} {
  match files.read_limited(path.join(root,name),268435456) {ok(v)=>result.ok(md5.hex(bytes.view(v))),err(_)=>result.err(text.concat("read ",name)),}
}
fn retire(peer:ref<link.Link>,root:str,id:u64,generation:u64) -> result<unit,string> effects {alloc,fs.write,net,time} {
  if not playback.discard(root,id,generation) {return result.err("discard publication")}
  ready(peer,id)
}
// The audible clip whose track carries the automation edits below.
fn automation_target(doc:ref<editor.Document>) -> option<editor.Clip> effects {alloc} {
  var at:u64=0
  loop {if at>=editor.clip_count(doc) {break}
    let clip:editor.Clip=match editor.clip_at(doc,at) {none=>{break},some(v)=>v,}
    at=at+1
    if clip.owner==doc.active and clip.enabled and editor.clip_has_audio(clip) and editor.track_audible(doc,clip.track) and clip.nested==0 {return option.some(clip)}
  }
  option.none()
}
// Five track keys of one parameter: at the clip start, at its end, then three 1000-frame steps.
// The window of a clip is its span plus one key before and two after, so the key at +3000 is
// outside it. `step` scales the three middle values (gain 0.8/0.7/0.6, pan 0.4/0.3/0.2).
fn automate(doc:ref<editor.Document>,clip:editor.Clip,param:str,first:f64,last:f64) -> bool effects {alloc} {
  let _=track_keys.drop_track(doc,clip.track)
  let end:i64=clip.start+clip.length
  let top:f64=if str.eq(param,"pan") {0.4}else{0.8}
  var ok:bool=true
  ok=not option.is_some(track_keys.set(doc,clip.track,param,clip.start,first,curve.linear())) and ok
  ok=not option.is_some(track_keys.set(doc,clip.track,param,end,top,curve.linear())) and ok
  ok=not option.is_some(track_keys.set(doc,clip.track,param,end+1000,top-0.1,curve.linear())) and ok
  ok=not option.is_some(track_keys.set(doc,clip.track,param,end+2000,top-0.2,curve.linear())) and ok
  ok=not option.is_some(track_keys.set(doc,clip.track,param,end+3000,last,curve.linear())) and ok
  ok
}
fn definition_key(doc:ref<editor.Document>) -> result<string,string> effects {alloc} {
  match media.endpoint_plan(doc,"worker","unused.wav") {
    err(p)=>result.err(p),
    ok(value)=>{var plan:media.EndpointPlan=value
      var lines:array<string> =struct.replace(plan,array.new(),field=lines)
      result.ok(text.join(lines,"\n"))},
  }
}
// The park key is the definition lines: a track key edit reaching a clip window must prepare
// fresh (and sound different); one outside every window must leave them byte-identical so the
// parked mix is reused with identical PCM.
fn automation(peer:ref<link.Link>,root:str,raw:string,param:str,token:str,names:str,low:f64,mid:f64,high:f64,alt:f64,
    base:u64,generation:u64,timing:str) -> result<unit,string> effects {alloc,fs.read,fs.meta,fs.write,net,process,time} {
  var keyed:editor.Document=match codec.decode(str.view(raw)) {ok(v)=>v,err(_)=>{return result.err("input decode")},}
  let clip:editor.Clip=match automation_target(keyed) {some(v)=>v,none=>{return result.err("no audible clip for track automation")},}
  if not automate(keyed,clip,param,high,mid) {return result.err("track keys were not written")}
  var outside:editor.Document=match codec.decode(str.view(raw)) {ok(v)=>v,err(_)=>{return result.err("input decode")},}
  if not automate(outside,clip,param,high,low) {return result.err("track keys were not written")}
  var inside:editor.Document=match codec.decode(str.view(raw)) {ok(v)=>v,err(_)=>{return result.err("input decode")},}
  if not automate(inside,clip,param,alt,mid) {return result.err("track keys were not written")}
  let base_key:string=try definition_key(keyed)
  let outside_key:string=try definition_key(outside)
  let inside_key:string=try definition_key(inside)
  if not text.contains(str.view(base_key),token) {return result.err("automation was not planned")}
  if not str.eq(str.view(base_key),str.view(outside_key)) {return result.err("a key outside every clip window changed the definition lines")}
  if str.eq(str.view(base_key),str.view(inside_key)) {return result.err("a key inside the clip window did not change the definition lines")}
  let fps:f64=editor.sequence_fps(keyed,keyed.active)
  let origin:i64=media.audio_sample_frame(clip.start,fps)
  // Fresh request ids and generations after the earlier phases.
  let keyed_wav:string=text.concat(names,"-keyed.wav")
  let outside_wav:string=text.concat(names,"-outside.wav")
  let inside_wav:string=text.concat(names,"-inside.wav")
  let t0:u64=time.monotonic_ns()
  var first:endpoint.End=try prepare(peer,root,keyed,base,generation)
  let t1:u64=time.monotonic_ns()
  let count:u64=endpoint.pull_count(first,origin,24000)
  if count==0 {return result.err("automated clip has no PCM window")}
  let _=try pull(peer,root,base+1,generation,base,str.view(keyed_wav),origin,count)
  try retire(peer,root,base+2,generation+1)
  let t2:u64=time.monotonic_ns()
  var parked:endpoint.End=try prepare(peer,root,outside,base+3,generation+2)
  let t3:u64=time.monotonic_ns()
  if not str.eq(str.view(endpoint.encode(first)),str.view(endpoint.encode(parked))) {return result.err("outside-window edit changed endpoint metadata")}
  let _=try pull(peer,root,base+4,generation+2,base+3,str.view(outside_wav),origin,count)
  try retire(peer,root,base+5,generation+3)
  let t4:u64=time.monotonic_ns()
  var fresh:endpoint.End=try prepare(peer,root,inside,base+6,generation+4)
  let t5:u64=time.monotonic_ns()
  let _=fresh
  let _=try pull(peer,root,base+7,generation+4,base+6,str.view(inside_wav),origin,count)
  try retire(peer,root,base+8,generation+5)
  let a:string=try digest(root,str.view(keyed_wav))
  let b:string=try digest(root,str.view(outside_wav))
  let c:string=try digest(root,str.view(inside_wav))
  if not str.eq(str.view(a),str.view(b)) {return result.err("outside-window edit changed the PCM")}
  if str.eq(str.view(a),str.view(c)) {return result.err("inside-window edit reused the parked PCM")}
  let _=files.write_text(path.join(root,timing),endpoint.fields([string.from_int(t1-t0),string.from_int(t3-t2),string.from_int(t5-t4)]))
  result.ok(())
}
fn sequence(peer:ref<link.Link>,root:str,raw:string,doc:ref<editor.Document>,moved:ref<editor.Document>,edited:ref<editor.Document>) -> result<unit,string> effects {alloc,fs.read,fs.meta,fs.write,net,process,time} {
  try link.connect(peer)
  let t0:u64=time.monotonic_ns()
  var cold:endpoint.End=try prepare(peer,root,doc,1,1)
  let t1:u64=time.monotonic_ns()
  let count:u64=endpoint.pull_count(cold,0,48000)
  if count>0 {let _=try pull(peer,root,2,1,1,"before.wav",0,count)}
  // Pause: the main loop bumps the generation and retires queued sound.
  try retire(peer,root,3,2)
  // A pull naming the pre-Pause preparation must be refused.
  match pull(peer,root,4,2,1,"stale.wav",0,count) {
    ok(_)=>{return result.err("stale pull after Pause was accepted")},
    err(p)=>{if not text.contains(str.view(p),"GA_AUDIO_ENDPOINT_STALE") {return result.err(text.concat("unexpected stale refusal: ",str.view(p)))}},
  }
  // Play again: next generation, same mix, playhead moved while paused.
  let t2:u64=time.monotonic_ns()
  var warm:endpoint.End=try prepare(peer,root,moved,5,3)
  let t3:u64=time.monotonic_ns()
  if not str.eq(endpoint.encode(cold),endpoint.encode(warm)) {return result.err("parked endpoint metadata changed")}
  if count>0 {let _=try pull(peer,root,6,3,5,"after.wav",0,count)}
  // Scrub: twenty 75 ms exact pulls at spread positions from the warm endpoint.
  var scrub_ns:u64=0
  var scrubs:u64=0
  var step:u64=0
  loop {if step>=20 or warm.actual<=3600 {break}
    let at:i64=(warm.actual-3600)*cast.wrap(step)/19
    let s0:u64=time.monotonic_ns()
    let _=try pull(peer,root,100+step,3,5,"scrub.wav",at,3600)
    scrub_ns=scrub_ns+(time.monotonic_ns()-s0)
    scrubs=scrubs+1
    step=step+1
  }
  if scrubs==0 {return result.err("no scrub pulls")}
  let before:string=try digest(root,"before.wav")
  let after:string=try digest(root,"after.wav")
  if not str.eq(str.view(before),str.view(after)) {return result.err("PCM after Pause differs from PCM before Pause")}
  // An edit changes the definitions: Pause, then prepare must not reuse the parked mix.
  try retire(peer,root,130,4)
  let t4:u64=time.monotonic_ns()
  var changed:endpoint.End=try prepare(peer,root,edited,131,5)
  let t5:u64=time.monotonic_ns()
  if changed.actual!=cold.actual {return result.err("edited endpoint length changed")}
  if count>0 {let _=try pull(peer,root,132,5,131,"edited.wav",0,count)}
  let quieter:string=try digest(root,"edited.wav")
  if str.eq(str.view(before),str.view(quieter)) {return result.err("edited mix reused the parked PCM")}
  let _=files.write_text(path.join(root,"park-ns.txt"),endpoint.fields([string.from_int(t1-t0),string.from_int(t3-t2),string.from_int(t5-t4),string.from_int(scrub_ns/scrubs)]))
  try retire(peer,root,133,6)
  try automation(peer,root,raw,"gain","TRKGAIN:","auto",0.05,0.5,0.9,0.2,200,7,"track-park-ns.txt")
  try automation(peer,root,raw,"pan","TRKPAN:","autopan",-0.9,-0.3,0.9,-0.5,300,13,"track-pan-park-ns.txt")
  result.ok(())
}
fn run(worker:str,input:str,root:str) -> result<unit,string> effects {alloc,fs.read,fs.meta,fs.write,net,process,thread,time} {
  let raw:string=match files.read_text(input) {ok(v)=>v,err(_)=>{return result.err("input read")},}
  var doc:editor.Document=match codec.decode(str.view(raw)) {ok(v)=>v,err(_)=>{return result.err("input decode")},}
  // The moved copy differs only in its paused Program playhead.
  var moved:editor.Document=match codec.decode(str.view(raw)) {ok(v)=>v,err(_)=>{return result.err("input decode")},}
  let total:i64=editor.duration(moved)
  let _=editor.seek_until(moved,total/2,total)
  if editor.playhead(moved)==editor.playhead(doc) {return result.err("playhead did not move")}
  // The edited copy halves every audio track's gain, changing the mix definitions.
  var edited:editor.Document=match codec.decode(str.view(raw)) {ok(v)=>v,err(_)=>{return result.err("input decode")},}
  var halved:u64=0
  var at:u64=0
  loop {if at>=array.len(struct.borrow(edited,field=tracks)) {break}
    let id:u64=array.borrow(struct.borrow(edited,field=tracks),at).id
    let kind:u32=array.borrow(struct.borrow(edited,field=tracks),at).kind
    if kind==1 {if editor.set_track_gain(edited,id,editor.track_gain(edited,id)*0.5) {halved=halved+1}}
    at=at+1
  }
  if halved==0 {return result.err("no audio track to edit")}
  playback.reset(root)
  var peer:link.Link=try link.open()
  let config:playback.Config=playback.Config {root:string.copy(root),worker:string.copy(worker),events:link.ticket(peer)}
  var problem:string=string.new()
  task.scope {
    var jobs:array<task<bool>> =[task.spawn(config,fn=playback.run)]
    match sequence(peer,root,raw,doc,moved,edited) {ok(_)=>{},err(p)=>{problem=p},}
    playback.stop(root)
    let _=link.wake(peer,true)
    match tasks.join_next<bool>(jobs,5000) {none=>{if str.len(problem)==0 {problem="actor did not join"}},some(v)=>{if not v and str.len(problem)==0 {problem="actor returned false"}},}
    link.close_commands(peer)
  }
  if str.len(problem)>0 {result.err(problem)}else{result.ok(())}
}
pub fn main(args:view<str>) -> i32 effects {alloc,fs.read,fs.meta,fs.write,net,process,thread,time,io.write} {
  if view.len(args)!=4 {return 2}
  match run(view.get(args,1),view.get(args,2),view.get(args,3)) {ok(_)=>{io.write("endpoint park: cold, warm-after-pause and edited preparation passed\ntrack gain window: edit inside re-prepared with new PCM, edit outside kept the parked mix and PCM\ntrack pan window: edit inside re-prepared with new PCM, edit outside kept the parked mix and PCM\n")
    0},err(p)=>{io.write(str.view(p))
    io.write("\n")
    3},}
}
