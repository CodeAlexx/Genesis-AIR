module genesis.tests.picture_queue
import std.draw as draw
import std.testing as test
import "../src/app.ai" as app
import "../src/provider.ai" as provider
import "../src/picture_queue.ai" as pictures
import "../src/preview_link.ai" as link
fn frame(source: i64, program: i64) -> pictures.Frame effects {alloc} {
  pictures.Frame {source:draw.empty_surface(),program:draw.empty_surface(),
    position:link.FramePosition {source_frame:source,program_frame:program,revision:1},held_source:false}
}
fn position(frame: pictures.Frame own, source: bool) -> i64 effects {} {
  if source {frame.position.source_frame}else{frame.position.program_frame}
}
fn fill_window(queue:ref<pictures.Queue>,first_id:u64,origin:i64,count:u64,last:i64) -> bool effects {alloc} {
  var done:u64=0
  loop {if done>=count {break}
    let first:i64=origin+cast.wrap(done)+1
    let n:u64=if count-done>=2 {2}else{1}
    if not pictures.requested_window(queue,first_id+done,n,first,last,100+done) {return false}
    var offset:u64=0
    loop {if offset>=n {break}
      let at:i64=first+cast.wrap(offset)
      if not pictures.receive(queue,first_id+done+offset,
          frame(if queue.source {at}else{80},if queue.source {80}else{at}),200+done+offset) {return false}
      offset=offset+1}
    done=done+n}
  true
}
pub fn main(args: view<str>) -> i32 effects {alloc,env,fs.meta,fs.write,io.write,time} {
  var suite: test.Suite = test.suite("Audio-timed prepared pictures",true)
  var queue: pictures.Queue = pictures.queue()
  let _ = test.start(suite,"Prepared pixels wait for their audio time")
  let _ = pictures.configure(queue,"clip",1,true,false,480,270)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,0,200,60.0,0)),1,"Play prepares frame one after its already-owned paused zero")
  pictures.requested(queue,1,1,100000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,0,200,60.0,0)),"Future request remains reserved while its decode is outstanding")
  let _ = test.check(suite,pictures.receive(queue,1,frame(0,1),120000000),"Complete picture accepted")
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,0),1,"Diagnostics expose the first prepared program position")
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,1),-1,"Diagnostics report an empty prepared slot")
  let _ = test.check(suite,not option.is_some(pictures.take_due(queue,0)),"Future picture is held")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,1)),false),1,"Release at its stamped time")
  let _ = test.done(suite)
  let _ = test.start(suite,"Bounded queue skips superseded due pictures")
  pictures.requested(queue,2,3,130000000)
  let _ = pictures.receive(queue,2,frame(0,3),150000000)
  pictures.requested(queue,3,4,160000000)
  let _ = pictures.receive(queue,3,frame(0,4),180000000)
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,1),4,"Diagnostics expose the second prepared position")
  let _ = test.check(suite,not option.is_some(pictures.target(queue,2,200,60.0,2)),"Two prepared pictures impose backpressure")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,4)),false),4,"Catch up using newest due picture")
  let _ = test.eq_u64(suite,array.len(struct.borrow(queue,field=frames)),0,"Superseded pictures released")
  let _ = test.done(suite)
  let _ = test.start(suite,"Seek, content, geometry and transport invalidate old pixels")
  pictures.requested(queue,4,8,190000000)
  let _ = pictures.receive(queue,4,frame(0,8),210000000)
  pictures.requested(queue,5,9,220000000)
  let _ = test.check(suite,pictures.configure(queue,"clip",2,true,false,480,270),"Restart changes epoch")
  let _ = test.check(suite,not pictures.receive(queue,5,frame(0,9),240000000),"Old completion rejected after seek")
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,0),-1,"Epoch retirement clears diagnostic positions")
  let _ = test.check(suite,not option.is_some(pictures.take_due(queue,10)),"Retired epoch has no picture")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,0,200,60.0,10)),0,"Rewind requests exact start first")
  let _ = test.check(suite,pictures.configure(queue,"edit",2,true,false,480,270),"An edit invalidates pictures")
  let _ = test.check(suite,pictures.configure(queue,"edit",2,true,false,1280,720),"Geometry invalidates pictures")
  let _ = test.check(suite,pictures.configure(queue,"edit",2,false,false,480,270),"Pause invalidates future pictures")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,7,200,60.0,0)),7,"Paused scrub requests exact frame")
  pictures.requested(queue,6,7,250000000)
  let _ = pictures.receive(queue,6,frame(0,7),280000000)
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,0)),false),7,"Paused completion is immediately visible")
  let _ = test.check(suite,not option.is_some(pictures.target(queue,7,200,60.0,7)),"Idle paused frame is not decoded again")
  let _ = test.done(suite)
  let _ = test.start(suite,"Source clock and fractional frame rates")
  let _ = pictures.configure(queue,"source",3,true,true,480,270)
  struct.set(queue,50000000,field=latency_ns)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,10,200,24000.0/1001.0,10)),11,"Fractional Play begins with the next consecutive sample")
  pictures.requested(queue,7,11,300000000)
  let _ = pictures.receive(queue,7,frame(11,80),600000000)
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,0),11,"Source diagnostics use Source time rather than parked Program time")
  let _ = test.check(suite,not option.is_some(pictures.take_due(queue,10)),"Source time governs Source playback")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,11)),true),11,"Source picture releases at its own frame")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,199,200,60.0,199)),200,"Large fractional Source recovery clamps preparation to final frame")
  pictures.requested(queue,8,200,700000000)
  let _ = pictures.receive(queue,8,frame(200,80),730000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,200,200,60.0,199)),"End does not repeatedly decode last frame")
  let _ = test.done(suite)
  let _ = test.start(suite,"Changing render latency preserves on-time picture order")
  let _ = pictures.configure(queue,"variable latency",4,true,false,480,270)
  struct.set(queue,16000000,field=latency_ns)
  pictures.requested(queue,9,22,800000000)
  struct.set(queue,20000000,field=latency_ns)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,21,200,60.0,20)),"Growing lead cannot supersede an on-time decode")
  let _ = pictures.receive(queue,9,frame(0,22),810000000)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,21,200,60.0,20)),23,"A growing lead does not skip frame 23")
  pictures.requested(queue,10,23,820000000)
  struct.set(queue,4000000,field=latency_ns)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,22,200,60.0,21)),"Shrinking lead cannot supersede the next reserved picture")
  let _ = pictures.receive(queue,10,frame(0,23),830000000)
  let _ = pictures.take_due(queue,22)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,22,200,60.0,21)),24,"A shrinking lead keeps consecutive future frames")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,30,200,60.0,22)),32,"Larger lateness reseeds bounded future preparation")
  let _ = test.done(suite)
  let _ = test.start(suite,"Future reservation and bounded late supersession")
  let _ = pictures.configure(queue,"reserved",7,true,false,480,270)
  pictures.requested(queue,20,2,1000000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,0,200,60.0,0)),"Multiple polls cannot overwrite a future request")
  let _ = test.check(suite,not option.is_some(pictures.target(queue,2,200,60.0,1)),"A just-due request remains reserved")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,3,200,60.0,1)),3,"One-frame lateness recovers current heard sample")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,4,200,60.0,1)),6,"Two-frame lateness permits bounded future recovery")
  pictures.requested(queue,21,6,1010000000)
  let _ = test.check(suite,pictures.receive(queue,20,frame(0,2),1020000000),"Earlier late completion remains a correctly stamped picture")
  let _ = test.eq_u64(suite,queue.in_flight,21,"An older reply cannot release the newer reservation")
  let _ = test.check(suite,not option.is_some(pictures.target(queue,3,200,60.0,1)),"Catch-up request cannot be overwritten while still future")
  let _ = pictures.take_due(queue,3)
  let _ = test.check(suite,pictures.receive(queue,21,frame(0,6),1030000000),"Matching catch-up completion is accepted")
  let _ = test.eq_u64(suite,queue.in_flight,0,"Matching completion releases its reservation")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,5,200,60.0,2)),7,"Released reservation continues with the next consecutive picture")
  let _ = test.check(suite,not pictures.receive(queue,20,frame(0,2),1040000000),"Duplicate older reply cannot reopen retired work")
  let _ = test.eq_u64(suite,queue.in_flight,0,"Refused duplicate preserves reservation state")
  let _ = test.done(suite)
  let _ = test.start(suite,"Small lateness recovers current time without unbounded history")
  let _ = pictures.configure(queue,"recover current",10,true,false,480,270)
  pictures.requested(queue,30,10,1200000000)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,11,200,60.0,9)),11,"One-frame lag requests exact current sample instead of expired history")
  pictures.requested(queue,31,11,1210000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,11,200,60.0,9)),"Current recovery sample keeps its reservation until completion")
  let _ = test.check(suite,pictures.receive(queue,31,frame(0,11),1220000000),"Exact issued recovery frame is accepted")
  let _ = test.check(suite,not option.is_some(pictures.take_due(queue,10)),"Current recovery picture is never shown before its heard time")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,11)),false),11,"Current recovery picture releases at exact heard time")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,11,200,60.0,11)),12,"Successful recovery immediately resumes consecutive preparation")
  pictures.requested(queue,32,12,1230000000)
  struct.set(queue,50000000,field=latency_ns)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,40,200,60.0,11)),43,"Slow decode prepares within at most fifty milliseconds instead of chasing history")
  pictures.requested(queue,33,43,1240000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,41,200,60.0,11)),"Slow decode cannot overwrite an on-time bounded recovery reservation")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,44,200,60.0,11)),44,"One-frame delay recovers exact current time even after large-lag reseeding")
  pictures.requested(queue,34,44,1250000000)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,200,200,60.0,11)),200,"Large recovery reaches the exact final frame")
  pictures.requested(queue,35,200,1260000000)
  let _ = test.check(suite,pictures.receive(queue,35,frame(0,200),1270000000),"Final bounded recovery completes")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,200)),false),200,"Final recovery picture releases at sequence end")
  let _ = test.check(suite,not option.is_some(pictures.target(queue,200,200,60.0,200)),"End never stalls by repeatedly requesting the last frame")
  let _ = test.done(suite)
  let _ = test.start(suite,"Captured late stall reseeds bounded future preparation")
  let _ = pictures.configure(queue,"stall recovery",11,true,false,480,270)
  struct.set(queue,16000000,field=latency_ns)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,1000,1000,60.0,1000)),"Play on an already-owned final frame does not request beyond end")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,0,1000,60.0,0)),1,"Paused zero to Play reserves immediate frame one")
  // DF78's real trace held 129 until heard time 132, then remained late.
  // This model proves policy/lifecycle only; the retained native trace failed.
  pictures.requested(queue,40,129,1300000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,129,1000,60.0,128)),"Just-due 129 retains matching reservation")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,130,1000,60.0,128)),130,"Heard advance supersedes late129 with exact current130")
  pictures.requested(queue,41,130,1301000000)
  let _ = test.check(suite,pictures.receive(queue,40,frame(0,129),1320000000),"Earlier129 completion keeps its stamped position")
  let _ = test.eq_u64(suite,queue.in_flight,41,"Earlier completion cannot release current130 reservation")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,132)),false),129,"No timestamp substitution hides late received picture")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,132,1000,60.0,129)),134,"Captured129-to132 audio progression reseeds bounded future134")
  pictures.requested(queue,42,134,1321000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,133,1000,60.0,129)),"Future134 reservation cannot be superseded")
  let _ = pictures.receive(queue,41,frame(0,130),1322000000)
  let _ = test.eq_u64(suite,queue.in_flight,42,"Older130 completion preserves future134 reservation")
  let _ = pictures.take_due(queue,132)
  let _ = pictures.receive(queue,42,frame(0,134),1323000000)
  let _ = test.check(suite,not option.is_some(pictures.take_due(queue,133)),"Reseeded future picture remains unshown until actual time")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,133,1000,60.0,130)),135,"Matching future completion permits next consecutive135")
  pictures.requested(queue,43,135,1324000000)
  let _ = pictures.receive(queue,43,frame(0,135),1325000000)
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,0),134,"First actual owned future reserve remains134")
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,1),135,"Second actual owned reserve is consecutive135")
  let _ = test.check(suite,not option.is_some(pictures.target(queue,133,1000,60.0,130)),"Two actual owned reserves impose backpressure")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,134)),false),134,"Only currently due reserve is displayed")
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,0),135,"Later reserve survives due release")
  let _ = test.done(suite)
  let _ = test.start(suite,"Owned future pictures bound waits to actual device sample deadlines")
  let _ = pictures.configure(queue,"deadline",12,true,false,480,270)
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,0,0,0,60.0,8)),8,"Empty queue keeps event fallback")
  pictures.requested(queue,45,2,1400000000)
  let _ = pictures.receive(queue,45,frame(80,2),1401000000)
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,0,0,0,60.0,8)),8,"Distant due boundary never increases fallback")
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,1,1360,0,60.0,8)),5,"Five actual sample milliseconds replace blind eight-millisecond wait")
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,1,1599,0,60.0,8)),0,"Submillisecond boundary wakes without early pixel admission")
  let _ = test.check(suite,not option.is_some(pictures.take_due(queue,1)),"Zero wait cannot make a future picture due")
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,2,1600,0,60.0,8)),0,"Actual due frame needs no additional wait")
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,1,1200,0,60000.0/1001.0,8)),8,"Fractional boundary uses ceil1602 sample threshold")
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,1,1553,0,60000.0/1001.0,8)),1,"Fractional 49-sample remaining boundary floors to one millisecond")
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,1,1601,0,60000.0/1001.0,8)),0,"Fractional last not-yet-due sample only shortens wait")
  let _ = test.check(suite,not option.is_some(pictures.take_due(queue,1)),"Fractional wake preserves no-early release")
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,1,1200,0,0.0,8)),8,"Invalid FPS preserves fallback")
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,1,9007199254740992,0,60.0,8)),8,"Unrepresentable sample count cannot wrap deadline")
  let _ = pictures.configure(queue,"source deadline",13,true,true,480,270)
  pictures.requested(queue,46,12,1410000000)
  let _ = pictures.receive(queue,46,frame(12,80),1411000000)
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,11,1360,10,60.0,8)),5,"Source position and nonzero origin govern deadline")
  let _ = pictures.configure(queue,"paused deadline",13,false,true,480,270)
  pictures.requested(queue,47,12,1420000000)
  let _ = pictures.receive(queue,47,frame(12,80),1421000000)
  let _ = test.eq_u64(suite,cast.sat(pictures.next_due_wait(queue,11,1599,10,60.0,20)),20,"Paused exact seek retains normal event fallback")
  let _ = test.done(suite)
  let _ = test.start(suite,"Extreme valid end positions keep preparation arithmetic bounded")
  let _ = pictures.configure(queue,"extreme end",14,true,false,480,270)
  pictures.requested(queue,48,9223372036854775806,1430000000)
  let _ = pictures.receive(queue,48,frame(0,9223372036854775806),1431000000)
  let _ = pictures.take_due(queue,9223372036854775806)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,9223372036854775806,9223372036854775807,60.0,9223372036854775806)),9223372036854775807,"Future lead cannot overflow maximum final position")
  pictures.requested(queue,49,9223372036854775807,1432000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,9223372036854775807,9223372036854775807,60.0,9223372036854775806)),"Maximum final reservation cannot wrap to negative history")
  let _ = test.done(suite)
  let _ = test.start(suite,"Preroll requires owned consecutive pictures of the current epoch")
  var preroll: pictures.Queue = pictures.queue()
  let _ = test.check(suite,not pictures.primed(preroll,0,200,false,20,0),"Uninitialized queue cannot start authored PCM")
  let _ = pictures.configure(preroll,"preroll",20,true,false,480,270)
  let _ = test.check(suite,not pictures.primed(preroll,0,200,false,20,0),"Empty request queue is not owned picture readiness")
  pictures.requested(preroll,60,1,1500000000)
  let _ = test.check(suite,not pictures.primed(preroll,0,200,false,20,0),"In-flight frame one cannot prime playback")
  let _ = pictures.receive(preroll,60,frame(80,1),1501000000)
  let _ = test.check(suite,not pictures.primed(preroll,0,200,false,20,0),"One owned picture cannot prime a longer sequence")
  pictures.requested(preroll,61,2,1502000000)
  let _ = test.check(suite,not pictures.primed(preroll,0,200,false,20,0),"Requested second frame still needs owned pixels")
  let _ = pictures.receive(preroll,61,frame(80,2),1503000000)
  let _ = test.check(suite,pictures.primed(preroll,0,200,false,20,0),"Actual consecutive frames one and two prime playback")
  let _ = test.eq_u64(suite,array.len(struct.borrow(preroll,field=frames)),2,"Readiness does not consume owned reserves")
  let _ = test.check(suite,not option.is_some(pictures.take_due(preroll,0)),"Primed frame one remains unshown before actual audio time")
  let _ = test.check(suite,not pictures.primed(preroll,0,200,false,19,0),"Previous audio epoch cannot start playback")
  let _ = test.check(suite,not pictures.primed(preroll,0,200,true,20,0),"Program pictures cannot prime Source playback")
  let _ = test.check(suite,not pictures.primed(preroll,0,200,false,20,7),"A different displayed origin cannot prime playback")
  let _ = test.check(suite,not pictures.primed(preroll,-1,200,false,20,-1),"Negative origin is refused")
  let _ = test.check(suite,not pictures.primed(preroll,3,2,false,20,3),"Invalid reversed end bounds are refused")
  let _ = pictures.configure(preroll,"preroll",21,false,false,480,270)
  let _ = test.check(suite,not pictures.primed(preroll,0,0,false,21,0),"Paused queue cannot prime even an already shown final frame")
  let _ = test.eq_u64(suite,array.len(struct.borrow(preroll,field=frames)),0,"Stop retires actual preroll pictures")
  let _ = test.check(suite,not pictures.receive(preroll,61,frame(80,2),1504000000),"Old preroll completion cannot reopen stopped queue")
  let _ = test.done(suite)
  let _ = test.start(suite,"Preroll rejects skipped or wrong-mode positions and supports short tails")
  let _ = pictures.configure(preroll,"skip",22,true,false,480,270)
  pictures.requested(preroll,62,1,1510000000)
  let _ = pictures.receive(preroll,62,frame(10,1),1511000000)
  pictures.requested(preroll,63,3,1512000000)
  let _ = pictures.receive(preroll,63,frame(11,3),1513000000)
  let _ = test.check(suite,not pictures.primed(preroll,0,200,false,22,0),"Skipped second picture cannot qualify as consecutive reserve")
  let _ = pictures.configure(preroll,"reverse slots",23,true,false,480,270)
  pictures.requested(preroll,64,2,1520000000)
  let _ = pictures.receive(preroll,64,frame(11,2),1521000000)
  pictures.requested(preroll,65,1,1522000000)
  let _ = pictures.receive(preroll,65,frame(10,1),1523000000)
  let _ = test.check(suite,not pictures.primed(preroll,0,200,false,23,0),"Out-of-order positions cannot prime playback")
  let _ = pictures.configure(preroll,"source prime",24,true,true,480,270)
  pictures.requested(preroll,66,11,1530000000)
  let _ = pictures.receive(preroll,66,frame(11,90),1531000000)
  pictures.requested(preroll,67,12,1532000000)
  let _ = pictures.receive(preroll,67,frame(12,90),1533000000)
  let _ = test.check(suite,pictures.primed(preroll,10,200,true,24,10),"Source reserve uses Source positions with parked Program time")
  let _ = test.check(suite,not pictures.primed(preroll,10,200,false,24,10),"Source-owned slots cannot prime Program playback")
  let _ = pictures.configure(preroll,"short final",25,true,false,480,270)
  let _ = test.check(suite,pictures.primed(preroll,200,200,false,25,200),"Already displayed final frame requires zero additional pictures")
  let _ = test.check(suite,not pictures.primed(preroll,199,200,false,25,199),"One remaining frame must actually be owned")
  pictures.requested(preroll,68,200,1540000000)
  let _ = pictures.receive(preroll,68,frame(80,200),1541000000)
  let _ = test.check(suite,pictures.primed(preroll,199,200,false,25,199),"One remaining owned picture permits short-tail playback")
  let _ = test.check(suite,not option.is_some(pictures.take_due(preroll,199)),"Short-tail readiness still never releases early")
  let _ = pictures.configure(preroll,"extreme prime",26,true,false,480,270)
  let _ = test.check(suite,pictures.primed(preroll,9223372036854775807,9223372036854775807,false,26,9223372036854775807),"Maximum final frame readiness cannot overflow")
  pictures.requested(preroll,69,9223372036854775807,1550000000)
  let _ = pictures.receive(preroll,69,frame(0,9223372036854775807),1551000000)
  let _ = test.check(suite,pictures.primed(preroll,9223372036854775806,9223372036854775807,false,26,9223372036854775806),"Maximum one-frame tail readiness cannot overflow")
  let _ = test.done(suite)
  let _ = test.start(suite,"Stop and error pause retire outstanding reservations")
  pictures.requested(queue,22,6,1050000000)
  let _ = test.check(suite,pictures.configure(queue,"reserved",7,false,false,480,270),"Stop retires playing preparation")
  let _ = test.eq_u64(suite,queue.in_flight,0,"Stop releases outstanding reservation")
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,0),-1,"Stop releases prepared pixels")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,0,200,60.0,5)),0,"Stop/rewind requests exact start rather than future lead")
  pictures.requested(queue,23,0,1060000000)
  let _ = test.check(suite,not pictures.receive(queue,22,frame(0,6),1070000000),"Pre-Stop reply cannot consume paused reservation")
  let _ = test.eq_u64(suite,queue.in_flight,23,"Refused pre-Stop reply preserves exact paused request")
  let _ = test.check(suite,pictures.receive(queue,23,frame(0,0),1080000000),"Paused rewind completion remains accepted")
  let _ = test.eq_u64(suite,queue.in_flight,0,"Paused completion releases reservation")
  let _ = pictures.configure(queue,"reserved",8,true,false,480,270)
  pictures.requested(queue,24,2,1090000000)
  // Native preview errors pause both transports before configure is called.
  let _ = test.check(suite,pictures.configure(queue,"reserved",8,false,false,480,270),"Error-driven pause retires unfinished decode")
  let _ = test.eq_u64(suite,queue.in_flight,0,"Error pause cannot strand a future reservation")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,1,200,60.0,0)),1,"Error pause permits an exact-frame recovery request")
  pictures.requested(queue,25,1,1100000000)
  let _ = test.check(suite,not pictures.receive(queue,24,frame(0,2),1110000000),"Failed playing epoch cannot release recovery request")
  let _ = test.eq_u64(suite,queue.in_flight,25,"Recovery request retains its own reservation")
  let _ = pictures.configure(queue,"edited",9,true,false,1280,720)
  let _ = test.eq_u64(suite,queue.in_flight,0,"Edit/seek/media epoch/geometry retires outstanding recovery")
  let _ = test.check(suite,not pictures.receive(queue,25,frame(0,1),1120000000),"Recovery reply cannot reenter a replacement epoch")
  let _ = test.done(suite)
  let _ = test.start(suite,"Selecting a different Source retires prepared playback pictures")
  var state: app.App = app.app(provider.fake(""))
  let first: string = pictures.identity(state,false,true)
  struct.set(struct.borrow(state,field=document),7,field=monitor_source)
  let second: string = pictures.identity(state,false,true)
  let _ = test.check(suite,first != second,"Source selection is part of playback identity at the same time")
  let _ = pictures.configure(queue,first,5,true,false,480,270)
  pictures.requested(queue,11,1,900000000)
  let _ = pictures.receive(queue,11,frame(0,1),910000000)
  pictures.requested(queue,12,2,920000000)
  let _ = test.check(suite,pictures.configure(queue,second,5,true,false,480,270),"Source selection resets the queue")
  let _ = test.eq_u64(suite,array.len(struct.borrow(queue,field=frames)),0,"Previous Source pixels cannot survive in preparation")
  let _ = test.check(suite,not pictures.receive(queue,12,frame(0,2),930000000),"Previous Source completion cannot reenter the queue")
  let _ = test.done(suite)
  let _=test.start(suite,"Two-frame window transfers reserved credits into ordered actual pixels")
  var batch:pictures.Queue=pictures.queue()
  let _=pictures.configure(batch,"batch",40,true,false,480,270)
  let _=test.eq_u64(suite,pictures.credit(batch),8,"Empty current epoch owns exactly eight frame credits")
  let first:i64=option.unwrap(pictures.window_target(batch,0,120,60.0,0))
  let _=test.eq_i64(suite,first,1,"Already native-presented origin requests immediate future one")
  let _=test.eq_u64(suite,pictures.window_count(batch,first,120),2,"One window fills two available slots")
  let _=test.check(suite,pictures.requested_window(batch,100,2,first,120,100000000),"Atomically reserve IDs100 and101 with consecutive frame stamps")
  let _=test.check(suite,pictures.reserved(batch)==2 and pictures.credit(batch)==6,"Two in-flight transport slots consume actual credits before GUI receipt")
  let _=test.check(suite,not option.is_some(pictures.window_target(batch,10,120,60.0,0)),"Forty-plus-ms stall never supersedes active ordered work")
  let _=test.check(suite,not pictures.requested_window(batch,102,1,3,120,120000000),"No second window can steal an active transport credit")
  let _=test.check(suite,not pictures.receive(batch,101,frame(80,2),140000000),"Later FIFO ID cannot replace missing first ID")
  let _=test.check(suite,pictures.reserved(batch)==2 and array.len(struct.borrow(batch,field=frames))==0,"Out-of-order refusal preserves full reservation and owns no invented pixels")
  let _=test.check(suite,pictures.failure_accepts(batch,101),"An error on either current reserved member remains eligible")
  let _=test.check(suite,not pictures.receive(batch,100,frame(80,99),139000000),"Wrong picture stamp cannot consume current window credit")
  let _=test.check(suite,pictures.receive(batch,100,frame(80,1),140000000),"Actual first completion accepted after40ms")
  let _=test.check(suite,pictures.reserved(batch)==1 and array.len(struct.borrow(batch,field=frames))==1 and pictures.credit(batch)==6,"Partial receipt transfers one credit without enlarging ownership")
  let _=test.check(suite,not pictures.receive(batch,100,frame(80,1),141000000),"Duplicate first completion cannot release last reservation")
  let _=test.check(suite,not pictures.failure_accepts(batch,100),"Already received first-member error is retired")
  let _=test.check(suite,pictures.receive(batch,101,frame(80,2),150000000),"Second completion has its own actual position")
  let _=test.check(suite,pictures.reserved(batch)==0 and array.len(struct.borrow(batch,field=frames))==2 and batch.in_flight==0,"Full FIFO drain releases reservations into exactly two owned pictures")
  let _=test.check(suite,not option.is_some(pictures.take_due(batch,0)),"Batch completion cannot expose future pixels before real clock")
  let _=test.eq_i64(suite,position(option.unwrap(pictures.take_due(batch,1)),false),1,"Actual clock releases only frame one")
  let _=test.eq_i64(suite,pictures.pending_frame(batch,0),2,"Second picture remains owned after first presentation")
  let _=test.eq_u64(suite,pictures.window_count(batch,3,120),2,"One owned picture permits a two-member transport refill")
  let _=test.check(suite,pictures.requested_window(batch,102,2,3,120,160000000),"Two-slot refill reserves its actual consecutive IDs")
  let _=test.check(suite,pictures.reserved(batch)+array.len(struct.borrow(batch,field=frames))==3,"First refill accounts every owned and reserved picture")
  let _=test.check(suite,pictures.receive(batch,102,frame(80,3),170000000),"Refill arrives without replacing still-future frame two")
  let _=test.eq_i64(suite,pictures.pending_frame(batch,1),3,"Actual refill is consecutive frame three")
  let _=test.check(suite,pictures.receive(batch,103,frame(80,4),180000000),"Second refill can arrive while three owned future pictures coexist")
  let _=test.check(suite,array.len(struct.borrow(batch,field=frames))==3 and pictures.credit(batch)==5,"Three owned frames leave exactly five actual credits")
  let _=test.check(suite,pictures.requested_window(batch,104,2,5,120,181000000),"Refill fifth and sixth without a new clock tick")
  let _=pictures.receive(batch,104,frame(80,5),182000000)
  let _=pictures.receive(batch,105,frame(80,6),183000000)
  let _=test.check(suite,pictures.requested_window(batch,106,2,7,120,184000000),"Refill seventh and eighth without adaptive horizon")
  let _=pictures.receive(batch,106,frame(80,7),185000000)
  let _=pictures.receive(batch,107,frame(80,8),186000000)
  let _=test.eq_u64(suite,pictures.window_count(batch,9,120),1,"One free slot bounds the last refill to one member")
  let _=test.check(suite,pictures.requested_window(batch,108,1,9,120,187000000),"Reserve the final free slot")
  let _=pictures.receive(batch,108,frame(80,9),188000000)
  let _=test.check(suite,array.len(struct.borrow(batch,field=frames))==8 and pictures.credit(batch)==0,"Eight-slot bound refuses additional packet credit")
  let _=test.check(suite,not option.is_some(pictures.window_target(batch,1,120,60.0,1)),"Eight future owned frames enforce backpressure")
  let _=test.eq_i64(suite,position(option.unwrap(pictures.take_due(batch,2)),false),2,"Eight-slot FIFO releases original first frame only")
  let _=test.check(suite,pictures.pending_frame(batch,0)==3 and pictures.pending_frame(batch,1)==4,"First release preserves FIFO order of both later frames")
  let _=test.check(suite,not option.is_some(pictures.take_due(batch,2)),"Eight-slot extension cannot publish later frames early")
  let _=pictures.take_due(batch,4)
  let _=test.check(suite,not pictures.requested_window(batch,103,1,5,120,180000000),"Consumed request ID cannot reserve unreachable replay work")
  let _=test.done(suite)

  let _=test.start(suite,"Window end and identity bounds refuse without reserving nonexistent frames")
  let _=pictures.configure(batch,"tail",41,true,false,480,270)
  let _=test.check(suite,not option.is_some(pictures.window_target(batch,200,200,60.0,200)),"Zero-tail already displayed final has no decode window")
  let _=test.eq_u64(suite,pictures.window_count(batch,200,200),1,"Single final target cannot reserve beyond end")
  let _=test.check(suite,not pictures.requested_window(batch,200,2,200,200,180000000),"Two-frame window across authored end refuses")
  let _=test.check(suite,not pictures.requested_window(batch,200,0,199,200,180000000),"Empty window is refused")
  let _=test.check(suite,not pictures.requested_window(batch,200,3,199,200,180000000),"More than two frames is refused")
  let _=test.check(suite,not pictures.requested_window(batch,0,1,199,200,180000000),"Generation zero is not a request")
  let _=test.check(suite,not pictures.requested_window(batch,18446744073709551615,2,199,200,180000000),"ID range overflow refuses before arithmetic")
  let _=test.check(suite,not pictures.requested_window(batch,200,1,-1,200,180000000),"Negative target cannot reserve")
  let _=test.check(suite,batch.window_next==0 and batch.in_flight==0 and pictures.credit(batch)==8,"Malformed window refusals leave all reservation state empty")
  let _=test.check(suite,pictures.requested_window(batch,200,1,200,200,190000000),"One-tail final is a legal one-frame window")
  let _=test.check(suite,pictures.receive(batch,200,frame(80,200),200000000),"Actual tail completion received")
  let _=test.check(suite,pictures.primed(batch,199,200,false,41,199),"Only remaining actual future picture primes one-tail PCM")
  let _=test.check(suite,not option.is_some(pictures.take_due(batch,199)),"Tail receipt still cannot show early")
  let _=test.done(suite)

  let _=test.start(suite,"Stop seek content Source and geometry retire complete windows")
  let _=pictures.configure(batch,"old",42,true,true,480,270)
  let _=test.check(suite,pictures.requested_window(batch,210,2,11,100,210000000),"Source window reserves independent Source frames")
  let _=test.check(suite,pictures.receive(batch,210,frame(11,80),220000000),"Source first packet partially completes")
  let _=test.check(suite,pictures.configure(batch,"new content",43,false,false,1280,720),"Changed epoch/content/mode/geometry retires partial owned and reserved window")
  let _=test.check(suite,pictures.reserved(batch)==0 and pictures.credit(batch)==8 and array.len(struct.borrow(batch,field=frames))==0,"Retirement frees only old owned and pending credits")
  let _=test.check(suite,not pictures.receive(batch,211,frame(12,80),230000000),"Late old-epoch packet cannot resurrect retired window")
  let _=test.check(suite,not pictures.failure_accepts(batch,211),"Retired error cannot pause new transport")
  let _=test.eq_u64(suite,pictures.window_count(batch,0,100),1,"Paused seek uses preserved single-frame path")
  let _=test.check(suite,pictures.requested_window(batch,212,1,0,100,240000000),"Paused exact target reserves one actual pixel slot")
  let _=test.check(suite,pictures.receive(batch,212,frame(80,0),250000000),"New exact seek remains eligible after stale reply")
  let _=test.eq_i64(suite,position(option.unwrap(pictures.take_due(batch,0)),false),0,"Paused zero frame applied exactly")
  let _=test.done(suite)

  let _=test.start(suite,"Native first PCM needs eight actual consecutive future pictures")
  var reserve:pictures.Queue=pictures.queue()
  let _=test.check(suite,not pictures.window_primed(reserve,0,100,false,50,0),"Uninitialized native reserve refuses readiness")
  let _=pictures.configure(reserve,"reserve",50,true,false,480,270)
  let _=test.check(suite,fill_window(reserve,400,0,6,100),"Three two-member windows prepare six actual pictures")
  let _=test.eq_i64(suite,option.unwrap(pictures.window_target(reserve,0,100,60000.0/1001.0,0)),7,"Fixed reserve advances beyond the old50ms horizon")
  let _=test.check(suite,pictures.requested_window(reserve,406,2,7,100,300),"Six actual owned plus two reserved credits fill exactly eight")
  let _=test.check(suite,pictures.reserved(reserve)==2 and array.len(struct.borrow(reserve,field=frames))==6 and pictures.credit(reserve)==0,"Transport packets consume credit instead of adding memory above eight")
  let _=test.check(suite,not pictures.window_primed(reserve,0,100,false,50,0),"Six pictures plus requests are not actual readiness")
  let _=pictures.receive(reserve,406,frame(80,7),350)
  let _=test.check(suite,not pictures.window_primed(reserve,0,100,false,50,0),"Seven actual pictures plus eighth in flight are insufficient")
  let _=pictures.receive(reserve,407,frame(80,8),400)
  let _=test.check(suite,pictures.window_primed(reserve,0,100,false,50,0),"Eight consecutive owned pictures prime native playback")
  let _=test.check(suite,not pictures.window_primed(reserve,0,100,false,49,0) and not pictures.window_primed(reserve,0,100,true,50,0) and not pictures.window_primed(reserve,0,100,false,50,-1),"Old epoch wrong mode and stale origin cannot prime")
  let _=test.check(suite,not option.is_some(pictures.take_due(reserve,0)),"All eight remain future before the real clock")
  var due:i64=1
  loop {if due>8 {break}
    let _=test.eq_i64(suite,position(option.unwrap(pictures.take_due(reserve,due)),false),due,"Every actual clock boundary releases the oldest stamped picture")
    let _=test.check(suite,not option.is_some(pictures.take_due(reserve,due)),"Each later picture remains unpublished until due")
    due=due+1}
  let _=test.eq_i64(suite,option.unwrap(pictures.window_target(reserve,13,100,60000.0/1001.0,8)),13,"Depleted reserve recovers exact heard frame without speculative future leap")
  let _=test.check(suite,pictures.requested_window(reserve,408,2,13,100,500),"Recovery reserves exact heard frame and its immediate successor")
  let _=test.check(suite,not option.is_some(pictures.window_target(reserve,20,100,60000.0/1001.0,8)),"Even overdue current recovery work is not superseded")
  let _=pictures.receive(reserve,408,frame(80,13),600)
  let _=pictures.receive(reserve,409,frame(80,14),700)
  let _=test.eq_i64(suite,position(option.unwrap(pictures.take_due(reserve,13)),false),13,"Real heard frame is recovered rather than hidden")
  let _=test.eq_i64(suite,pictures.pending_frame(reserve,0),14,"Immediate successor remains future")
  let _=test.done(suite)
  let _=test.start(suite,"Native short tails zero through seven require only actual remaining pixels")
  var tail_count:u64=0
  loop {if tail_count>=8 {break}
    let _=pictures.configure(reserve,string.from_int(tail_count),60+tail_count,true,false,480,270)
    let last:i64=100+cast.wrap(tail_count)
    let _=test.check(suite,pictures.window_primed(reserve,100,last,false,60+tail_count,100)==(tail_count==0),"Empty queue primes only a zero-frame tail")
    if tail_count>0 {
      if tail_count>1 {let _=test.check(suite,fill_window(reserve,500,100,tail_count-1,last),"Prepare every tail picture except the final one")}
      let _=test.check(suite,not pictures.window_primed(reserve,100,last,false,60+tail_count,100),"Missing final tail pixels cannot be replaced by a prediction")
      let _=test.check(suite,pictures.requested_window(reserve,600,1,last,last,900),"Last tail target reserves only one member")
      let _=test.check(suite,not pictures.window_primed(reserve,100,last,false,60+tail_count,100),"A reserved final tail is not ready")
      let _=pictures.receive(reserve,600,frame(80,last),1000)
      let _=test.check(suite,pictures.window_primed(reserve,100,last,false,60+tail_count,100),"All actual remaining tail pictures prime without nonexistent frames")}
    tail_count=tail_count+1}
  let _=pictures.configure(reserve,"maximum-eight",70,true,false,480,270)
  let maximum_origin:i64=9223372036854775799
  let _=test.check(suite,fill_window(reserve,700,maximum_origin,8,9223372036854775807),"Eight-picture maximum signed endpoint is legal")
  let _=test.check(suite,pictures.window_primed(reserve,maximum_origin,9223372036854775807,false,70,maximum_origin),"Maximum endpoint readiness has no overflowing addition")
  let _=test.done(suite)
  let _=test.start(suite,"Every native identity retirement clears eight-pixel readiness and reservations")
  var changed:u64=0
  loop {if changed>=6 {break}
    let _=pictures.configure(reserve,"before",80,true,false,480,270)
    let _=test.check(suite,fill_window(reserve,800,0,8,100),"Own eight actual pictures before retirement")
    let _=test.check(suite,pictures.window_primed(reserve,0,100,false,80,0),"Current identity primes before the isolated change")
    let _=test.check(suite,pictures.configure(reserve,if changed==0 {"edited content"}else{"before"},
      if changed==1 {81}else{80},changed!=2,changed==3,
      if changed==4 {640}else{480},if changed==5 {360}else{270}),"One content epoch Stop mode or dimension change retires readiness")
    let _=test.check(suite,array.len(struct.borrow(reserve,field=frames))==0 and pictures.reserved(reserve)==0 and pictures.credit(reserve)==8,"Retirement releases all pixels without inventing new credit")
    let _=test.check(suite,not pictures.window_primed(reserve,0,100,false,80,0) and not pictures.receive(reserve,807,frame(80,8),1100),"Old complete identity and late packet cannot reopen readiness")
    changed=changed+1}
  let _=pictures.configure(reserve,"source-eight",90,true,true,480,270)
  let _=test.check(suite,fill_window(reserve,900,10,8,100),"Independent Source owns all eight exact Source positions")
  let _=test.check(suite,pictures.window_primed(reserve,10,100,true,90,10) and not pictures.window_primed(reserve,10,100,false,90,10),"Source readiness follows its actual Source positions and mode")
  let _=test.done(suite)
  let report: string = if view.len(args)>1 {string.copy(view.get(args,1))}else{string.copy("picture-queue-tests.json")}
  test.conclude(suite,report,24)
}
