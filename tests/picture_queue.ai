module genesis.tests.picture_queue
import std.draw as draw
import std.testing as test
import "../src/app.ai" as app
import "../src/provider.ai" as provider
import "../src/picture_queue.ai" as pictures
import "../src/preview_link.ai" as link
fn frame(source: i64, program: i64) -> pictures.Frame effects {alloc} {
  pictures.Frame {source:draw.empty_surface(),program:draw.empty_surface(),
    position:link.FramePosition {source_frame:source,program_frame:program,revision:1},held_source:false}
}
fn position(frame: pictures.Frame own, source: bool) -> i64 effects {} {
  if source {frame.position.source_frame}else{frame.position.program_frame}
}
pub fn main(args: view<str>) -> i32 effects {alloc,env,fs.meta,fs.write,io.write,time} {
  var suite: test.Suite = test.suite("Audio-timed prepared pictures",true)
  var queue: pictures.Queue = pictures.queue()
  let _ = test.start(suite,"Prepared pixels wait for their audio time")
  let _ = pictures.configure(queue,"clip",1,true,false,480,270)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,0,200,60.0,0)),2,"Prepare two frames ahead at 60 fps")
  pictures.requested(queue,1,2,100000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,1,200,60.0,0)),"Future request remains reserved while its decode is outstanding")
  let _ = test.check(suite,pictures.receive(queue,1,frame(0,2),120000000),"Complete picture accepted")
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,0),2,"Diagnostics expose the first prepared program position")
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,1),-1,"Diagnostics report an empty prepared slot")
  let _ = test.check(suite,not option.is_some(pictures.take_due(queue,1)),"Future picture is held")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,2)),false),2,"Release at its stamped time")
  let _ = test.done(suite)
  let _ = test.start(suite,"Bounded queue skips superseded due pictures")
  pictures.requested(queue,2,3,130000000)
  let _ = pictures.receive(queue,2,frame(0,3),150000000)
  pictures.requested(queue,3,4,160000000)
  let _ = pictures.receive(queue,3,frame(0,4),180000000)
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,1),4,"Diagnostics expose the second prepared position")
  let _ = test.check(suite,not option.is_some(pictures.target(queue,2,200,60.0,2)),"Two prepared pictures impose backpressure")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,4)),false),4,"Catch up using newest due picture")
  let _ = test.eq_u64(suite,array.len(struct.borrow(queue,field=frames)),0,"Superseded pictures released")
  let _ = test.done(suite)
  let _ = test.start(suite,"Seek, content, geometry and transport invalidate old pixels")
  pictures.requested(queue,4,8,190000000)
  let _ = pictures.receive(queue,4,frame(0,8),210000000)
  pictures.requested(queue,5,9,220000000)
  let _ = test.check(suite,pictures.configure(queue,"clip",2,true,false,480,270),"Restart changes epoch")
  let _ = test.check(suite,not pictures.receive(queue,5,frame(0,9),240000000),"Old completion rejected after seek")
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,0),-1,"Epoch retirement clears diagnostic positions")
  let _ = test.check(suite,not option.is_some(pictures.take_due(queue,10)),"Retired epoch has no picture")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,0,200,60.0,10)),0,"Rewind requests exact start first")
  let _ = test.check(suite,pictures.configure(queue,"edit",2,true,false,480,270),"An edit invalidates pictures")
  let _ = test.check(suite,pictures.configure(queue,"edit",2,true,false,1280,720),"Geometry invalidates pictures")
  let _ = test.check(suite,pictures.configure(queue,"edit",2,false,false,480,270),"Pause invalidates future pictures")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,7,200,60.0,0)),7,"Paused scrub requests exact frame")
  pictures.requested(queue,6,7,250000000)
  let _ = pictures.receive(queue,6,frame(0,7),280000000)
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,0)),false),7,"Paused completion is immediately visible")
  let _ = test.check(suite,not option.is_some(pictures.target(queue,7,200,60.0,7)),"Idle paused frame is not decoded again")
  let _ = test.done(suite)
  let _ = test.start(suite,"Source clock and fractional frame rates")
  let _ = pictures.configure(queue,"source",3,true,true,480,270)
  struct.set(queue,50000000,field=latency_ns)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,10,200,24000.0/1001.0,10)),12,"Fractional lead rounds up and is bounded")
  pictures.requested(queue,7,12,300000000)
  let _ = pictures.receive(queue,7,frame(12,80),600000000)
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,0),12,"Source diagnostics use Source time rather than parked Program time")
  let _ = test.check(suite,not option.is_some(pictures.take_due(queue,11)),"Source time governs Source playback")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,12)),true),12,"Source picture releases at its own frame")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,199,200,60.0,199)),200,"Preparation clamps to last frame")
  pictures.requested(queue,8,200,700000000)
  let _ = pictures.receive(queue,8,frame(200,80),730000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,200,200,60.0,199)),"End does not repeatedly decode last frame")
  let _ = test.done(suite)
  let _ = test.start(suite,"Changing render latency preserves on-time picture order")
  let _ = pictures.configure(queue,"variable latency",4,true,false,480,270)
  struct.set(queue,16000000,field=latency_ns)
  pictures.requested(queue,9,22,800000000)
  struct.set(queue,20000000,field=latency_ns)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,21,200,60.0,20)),"Growing lead cannot supersede an on-time decode")
  let _ = pictures.receive(queue,9,frame(0,22),810000000)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,21,200,60.0,20)),23,"A growing lead does not skip frame 23")
  pictures.requested(queue,10,23,820000000)
  struct.set(queue,4000000,field=latency_ns)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,22,200,60.0,21)),"Shrinking lead cannot supersede the next reserved picture")
  let _ = pictures.receive(queue,10,frame(0,23),830000000)
  let _ = pictures.take_due(queue,22)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,22,200,60.0,21)),24,"A shrinking lead keeps consecutive future frames")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,30,200,60.0,22)),32,"A late renderer still coalesces to the current audio time")
  let _ = test.done(suite)
  let _ = test.start(suite,"Future reservation and bounded late supersession")
  let _ = pictures.configure(queue,"reserved",7,true,false,480,270)
  pictures.requested(queue,20,2,1000000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,0,200,60.0,0)),"Multiple polls cannot overwrite a future request")
  let _ = test.check(suite,not option.is_some(pictures.target(queue,2,200,60.0,1)),"A just-due request remains reserved")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,3,200,60.0,1)),3,"One-frame lateness preserves the current heard sample")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,4,200,60.0,1)),6,"Larger late decode may catch up within the bounded lead")
  pictures.requested(queue,21,6,1010000000)
  let _ = test.check(suite,pictures.receive(queue,20,frame(0,2),1020000000),"Earlier late completion remains a correctly stamped picture")
  let _ = test.eq_u64(suite,queue.in_flight,21,"An older reply cannot release the newer reservation")
  let _ = test.check(suite,not option.is_some(pictures.target(queue,3,200,60.0,1)),"Catch-up request cannot be overwritten while still future")
  let _ = pictures.take_due(queue,3)
  let _ = test.check(suite,pictures.receive(queue,21,frame(0,6),1030000000),"Matching catch-up completion is accepted")
  let _ = test.eq_u64(suite,queue.in_flight,0,"Matching completion releases its reservation")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,5,200,60.0,2)),7,"Released reservation continues with the next consecutive picture")
  let _ = test.check(suite,not pictures.receive(queue,20,frame(0,2),1040000000),"Duplicate older reply cannot reopen retired work")
  let _ = test.eq_u64(suite,queue.in_flight,0,"Refused duplicate preserves reservation state")
  let _ = test.done(suite)
  let _ = test.start(suite,"Small lateness recovers current time without unbounded history")
  let _ = pictures.configure(queue,"recover current",10,true,false,480,270)
  pictures.requested(queue,30,10,1200000000)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,11,200,60.0,9)),11,"Recovery requests current time rather than expired frame 10 or future frame 13")
  pictures.requested(queue,31,11,1210000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,11,200,60.0,9)),"Current recovery sample keeps its reservation until completion")
  let _ = test.check(suite,pictures.receive(queue,31,frame(0,11),1220000000),"Exact issued recovery frame is accepted")
  let _ = test.check(suite,not option.is_some(pictures.take_due(queue,10)),"Current recovery picture is never shown before its heard time")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,11)),false),11,"Current recovery picture releases at exact heard time")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,11,200,60.0,11)),12,"Successful recovery immediately resumes consecutive preparation")
  pictures.requested(queue,32,12,1230000000)
  struct.set(queue,50000000,field=latency_ns)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,40,200,60.0,11)),43,"Slow decode catches up with at most 50 ms future lead instead of chasing expired history")
  pictures.requested(queue,33,43,1240000000)
  let _ = test.check(suite,not option.is_some(pictures.target(queue,41,200,60.0,11)),"Slow decode cannot overwrite an on-time bounded recovery reservation")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,44,200,60.0,11)),44,"One-frame delay remains exact even after large-lag recovery")
  pictures.requested(queue,34,44,1250000000)
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,199,200,60.0,11)),200,"Large recovery still clamps to the final frame")
  pictures.requested(queue,35,200,1260000000)
  let _ = test.check(suite,pictures.receive(queue,35,frame(0,200),1270000000),"Final bounded recovery completes")
  let _ = test.eq_i64(suite,position(option.unwrap(pictures.take_due(queue,200)),false),200,"Final recovery picture releases at sequence end")
  let _ = test.check(suite,not option.is_some(pictures.target(queue,200,200,60.0,200)),"End never stalls by repeatedly requesting the last frame")
  let _ = test.done(suite)
  let _ = test.start(suite,"Stop and error pause retire outstanding reservations")
  pictures.requested(queue,22,6,1050000000)
  let _ = test.check(suite,pictures.configure(queue,"reserved",7,false,false,480,270),"Stop retires playing preparation")
  let _ = test.eq_u64(suite,queue.in_flight,0,"Stop releases outstanding reservation")
  let _ = test.eq_i64(suite,pictures.pending_frame(queue,0),-1,"Stop releases prepared pixels")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,0,200,60.0,5)),0,"Stop/rewind requests exact start rather than future lead")
  pictures.requested(queue,23,0,1060000000)
  let _ = test.check(suite,not pictures.receive(queue,22,frame(0,6),1070000000),"Pre-Stop reply cannot consume paused reservation")
  let _ = test.eq_u64(suite,queue.in_flight,23,"Refused pre-Stop reply preserves exact paused request")
  let _ = test.check(suite,pictures.receive(queue,23,frame(0,0),1080000000),"Paused rewind completion remains accepted")
  let _ = test.eq_u64(suite,queue.in_flight,0,"Paused completion releases reservation")
  let _ = pictures.configure(queue,"reserved",8,true,false,480,270)
  pictures.requested(queue,24,2,1090000000)
  // Native preview errors pause both transports before configure is called.
  let _ = test.check(suite,pictures.configure(queue,"reserved",8,false,false,480,270),"Error-driven pause retires unfinished decode")
  let _ = test.eq_u64(suite,queue.in_flight,0,"Error pause cannot strand a future reservation")
  let _ = test.eq_i64(suite,option.unwrap(pictures.target(queue,1,200,60.0,0)),1,"Error pause permits an exact-frame recovery request")
  pictures.requested(queue,25,1,1100000000)
  let _ = test.check(suite,not pictures.receive(queue,24,frame(0,2),1110000000),"Failed playing epoch cannot release recovery request")
  let _ = test.eq_u64(suite,queue.in_flight,25,"Recovery request retains its own reservation")
  let _ = pictures.configure(queue,"edited",9,true,false,1280,720)
  let _ = test.eq_u64(suite,queue.in_flight,0,"Edit/seek/media epoch/geometry retires outstanding recovery")
  let _ = test.check(suite,not pictures.receive(queue,25,frame(0,1),1120000000),"Recovery reply cannot reenter a replacement epoch")
  let _ = test.done(suite)
  let _ = test.start(suite,"Selecting a different Source retires prepared playback pictures")
  var state: app.App = app.app(provider.fake(""))
  let first: string = pictures.identity(state,false,true)
  struct.set(struct.borrow(state,field=document),7,field=monitor_source)
  let second: string = pictures.identity(state,false,true)
  let _ = test.check(suite,first != second,"Source selection is part of playback identity at the same time")
  let _ = pictures.configure(queue,first,5,true,false,480,270)
  pictures.requested(queue,11,1,900000000)
  let _ = pictures.receive(queue,11,frame(0,1),910000000)
  pictures.requested(queue,12,2,920000000)
  let _ = test.check(suite,pictures.configure(queue,second,5,true,false,480,270),"Source selection resets the queue")
  let _ = test.eq_u64(suite,array.len(struct.borrow(queue,field=frames)),0,"Previous Source pixels cannot survive in preparation")
  let _ = test.check(suite,not pictures.receive(queue,12,frame(0,2),930000000),"Previous Source completion cannot reenter the queue")
  let _ = test.done(suite)
  let report: string = if view.len(args)>1 {string.copy(view.get(args,1))}else{string.copy("picture-queue-tests.json")}
  test.conclude(suite,report,24)
}
