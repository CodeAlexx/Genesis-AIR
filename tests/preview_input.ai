// Real child/socket checks for bounded frame identity, pixels and recovery.
module genesis.preview_input_test
import std.draw as draw
import std.files as files
import std.path as path
import std.testing as test
import std.text as text
import "../src/provider.ai" as provider

fn request(state: ref<provider.Provider>, pattern: str, w: u32, h: u32) -> provider.Frame
    effects {alloc,fs.meta,fs.read,fs.write,process,net,time} {
  let line: string = text.concat("PREVIEW ",text.concat(pattern,text.concat(" ",
    provider.wire_path(provider.preview_path(state)))))
  provider.program_command(state,line,w,h)
}
fn color(frame: ref<provider.Frame>, r: u8, g: u8, b: u8) -> bool effects {} {
  if not frame.ok {return false}
  match draw.surface_pixel(struct.borrow(frame,field=pixels),frame.width/2,frame.height/2) {
    some(value)=>value.r == r and value.g == g and value.b == b and value.a == 255,
    none=>false,
  }
}
fn lifetime(state: ref<provider.Provider>, root: str, count: u64) -> i32
    effects {alloc,env,fs.meta,fs.read,fs.write,io.write,process,net,time} {
  if count < 18000 or count > 100000 {return 2}
  var suite: test.Suite = test.suite("Genesis socket lifetime",false)
  let _ = test.start(suite,"Five-minute production provider transport at sixty requests per second")
  var patterns: array<string> = ["red","green","blue"]
  var frame: u64 = 0
  let begin: u64 = time.monotonic_ns()
  loop {if frame >= count {break}
    var picture: provider.Frame = request(state,str.view(array.borrow(patterns,frame%3)),1,1)
    let expected: bool = if frame%3 == 0 {color(picture,255,0,0)}
      else if frame%3 == 1 {color(picture,0,255,0)}else{color(picture,0,0,255)}
    let _ = test.check(suite,expected,"request identity and exact pixels survived socket retirement")
    if not expected {io.write(provider.last_error(state))
      break}
    if state.starts != 1 {io.write("Transport lifetime refused a hidden worker restart\n")
      break}
    frame=frame+1
    if frame%3600 == 0 {io.write(text.concat("Transport lifetime packets=",text.concat(string.from_int(frame),
      text.concat(" elapsed_ms=",text.concat(string.from_int((time.monotonic_ns()-begin)/1000000),"\n"))))) }
    let target: u64 = begin+frame*1000000000/60
    let now: u64 = time.monotonic_ns()
    if now < target {time.sleep_ms((target-now)/1000000)}
  }
  let _ = test.eq_u64(suite,frame,count,"all paced requests completed")
  let _ = test.eq_u64(suite,state.starts,1,"one worker session survived the complete run")
  let _ = test.eq_u64(suite,state.failures,0,"no transport refusal or recovery was hidden")
  provider.shutdown(state)
  let _ = test.done(suite)
  test.conclude(suite,path.join(root,"preview-lifetime-tests.json"),16)
}
pub fn main(args: view<str>) -> i32 effects {alloc,env,fs.meta,fs.read,fs.write,io.write,process,net,time} {
  if view.len(args) != 3 and view.len(args) != 4 {return 2}
  let root: str = view.get(args,1)
  let _ = files.mkdirs(root)
  var state: provider.Provider = provider.gcompose(view.get(args,2),root)
  if view.len(args) == 4 {return lifetime(state,root,match text.parse_u64(view.get(args,3)) {some(value)=>value,none=>0,})}
  var suite: test.Suite = test.suite("Genesis direct preview transport",false)
  let _ = test.start(suite,"Socket frames, request identity, bounded reads and worker lifecycle")
  provider.set_profile(state,true)
  var red: provider.Frame = request(state,"red",160,90)
  let _ = test.check(suite,color(red,255,0,0),"first frame pixels")
  var blue: provider.Frame = request(state,"blue",160,90)
  let _ = test.check(suite,color(blue,0,0,255),"next frame carries new pixels")
  var large: provider.Frame = request(state,"red",320,180)
  let _ = test.check(suite,color(large,255,0,0) and large.width == 320 and large.height == 180,"larger monitor reads its complete new picture")
  var small: provider.Frame = request(state,"red",80,45)
  let _ = test.check(suite,color(small,255,0,0) and small.width == 80 and small.height == 45,"smaller monitor cannot retain the old tail")
  let starts: u64 = state.starts
  var crashed: provider.Frame = request(state,"crash-once",80,45)
  let _ = test.check(suite,color(crashed,0,0,255),"broken pipe retries once with a new bounded transfer")
  let _ = test.eq_u64(suite,state.starts,starts+1,"broken pipe makes one recovery attempt")
  let recovery_log: string = match files.read_text(path.join(root,"errors.jsonl")) {ok(value)=>value,err(_)=>string.new(),}
  let _ = test.contains(suite,recovery_log,"GA_PROGRAM_RECOVERY","an automatic retry retains its coded diagnostic")
  let _ = test.contains(suite,recovery_log,"exit=3","recovery diagnostic retains the actual child exit status")
  var malformed: provider.Frame = request(state,"short",160,90)
  let _ = test.check(suite,not malformed.ok,"one missing byte refuses the frame")
  let _ = test.contains(suite,provider.last_error(state),"GA_PROGRAM_SIZE","short frame code")
  var recovery: provider.Frame = request(state,"blue",160,90)
  let _ = test.check(suite,color(recovery,0,0,255),"short frame recovery")
  var extra: provider.Frame = request(state,"extra",160,90)
  let _ = test.check(suite,not extra.ok,"one extra byte refuses the frame")
  let _ = test.contains(suite,provider.last_error(state),"GA_PROGRAM_SIZE","oversized frame code")
  var empty: provider.Frame = request(state,"empty",160,90)
  let _ = test.check(suite,not empty.ok,"empty output refuses the frame")
  let _ = test.contains(suite,provider.last_error(state),"GA_PROGRAM_SIZE","empty frame code")
  var green: provider.Frame = request(state,"green",160,90)
  let _ = test.check(suite,color(green,0,255,0),"empty and oversized recovery")
  var refused: provider.Frame = request(state,"error",160,90)
  let _ = test.check(suite,not refused.ok,"live worker refusal hides old pixels")
  let _ = test.contains(suite,provider.last_error(state),"GA_WORKER_REQUEST","worker refusal code")
  var retry: provider.Frame = request(state,"red",160,90)
  let _ = test.check(suite,color(retry,255,0,0),"worker refusal retires the session and recovers")
  let _ = test.check(suite,not match files.exists(provider.preview_path(state)) {ok(value)=>value,err(_)=>false,},"final monitor writes no image file")
  provider.invalidate(state)
  var reload: provider.Frame = request(state,"blue",160,90)
  let _ = test.check(suite,color(reload,0,0,255),"Reload retires cached picture bytes")

  provider.restart(state)
  var restarted: provider.Frame = request(state,"red",160,90)
  let _ = test.check(suite,color(restarted,255,0,0),"worker restart replaces the picture session")
  var invalid: provider.Frame = request(state,"red",0,90)
  let _ = test.check(suite,not invalid.ok,"invalid dimensions refused")
  let _ = test.contains(suite,provider.last_error(state),"GA_PREVIEW_SIZE","dimension refusal code")
  var complete: provider.Frame = request(state,"green",960,540)
  let _ = test.check(suite,color(complete,0,255,0) and complete.width == 960 and complete.height == 540,"large bounded read recovers after invalid dimensions")
  var fragmented: provider.Frame = request(state,"fragment",13,7)
  let _ = test.check(suite,color(fragmented,255,0,0),"fragmented header and binary payload reassemble exactly")
  var race: u64 = 0
  loop {if race >= 8 {break}
    var queued: provider.Frame = request(state,"done-first",13,7)
    let _ = test.check(suite,color(queued,255,0,0),"readable DONE before socket accept still receives its matching pixels")
    var next: provider.Frame = request(state,"blue",13,7)
    let _ = test.check(suite,color(next,0,0,255),"restored DONE retains unread diagnostic and next reply boundaries")
    race=race+1
  }
  let missing_begin: u64 = time.monotonic_ns()
  var missing: provider.Frame = request(state,"missing",13,7)
  let _ = test.check(suite,not missing.ok,"DONE without any picture is refused")
  let _ = test.contains(suite,provider.last_error(state),"GA_PROGRAM_SIZE","missing connection code")
  let _ = test.check(suite,time.monotonic_ns()-missing_begin < 2000000000,"missing packet refusal uses a bounded one-second deadline")
  var bad_patterns: array<string> = ["bad-magic","bad-token","bad-sequence","bad-width","bad-count"]
  var index: u64 = 0
  loop {if index >= array.len(bad_patterns) {break}
    var wrong: provider.Frame = request(state,str.view(array.borrow(bad_patterns,index)),80,45)
    let _ = test.check(suite,not wrong.ok,"mismatched header refuses stale or malformed pixels")
    let _ = test.contains(suite,provider.last_error(state),"GA_PROGRAM_HEADER","header identity code")
    var fresh: provider.Frame = request(state,"green",80,45)
    let _ = test.check(suite,color(fresh,0,255,0),"header rejection recovers with a new session")
    index=index+1
  }
  let profile_path: string = path.join(root,"provider-profile.tsv")
  let recorded: string = match files.read_text(profile_path) {ok(value)=>value,err(_)=>string.new(),}
  let _ = test.contains(suite,recorded,"call\texchange_ns\tinput_ns\tread_ns\tcopy_ns\n","diagnostic phase header")
  provider.set_profile(state,false)
  var ordinary: provider.Frame = request(state,"blue",160,90)
  let _ = test.check(suite,color(ordinary,0,0,255),"ordinary preview remains correct")
  let after: string = match files.read_text(profile_path) {ok(value)=>value,err(_)=>string.new(),}
  let _ = test.eq_str(suite,recorded,after,"ordinary preview writes no diagnostic row")
  provider.set_profile(state,true)
  let reset: string = match files.read_text(profile_path) {ok(value)=>value,err(_)=>string.new(),}
  let _ = test.eq_str(suite,reset,"call\texchange_ns\tinput_ns\tread_ns\tcopy_ns\n","new diagnostic session resets its rows")
  provider.shutdown(state)
  let _ = test.done(suite)
  test.conclude(suite,path.join(root,"preview-input-tests.json"),16)
}
