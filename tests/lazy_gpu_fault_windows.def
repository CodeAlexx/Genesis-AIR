; Test-only proxy for the pinned OpenCL loader. The two local C overrides
; clGetPlatformIDs and clEnqueueReadBuffer are exported with dllexport;
; all other pinned loader functions forward unchanged to OpenCL_real.dll.
LIBRARY OpenCL
EXPORTS
clBuildProgram=OpenCL_real.clBuildProgram
clCloneKernel=OpenCL_real.clCloneKernel
clCompileProgram=OpenCL_real.clCompileProgram
