// CPU-only cache/scheduling proof; fake media performs no decoding or GPU work.
module genesis.tests.waveform_detail
import std.editor as editor
import std.files as files
import std.path as path
import std.testing as test
import std.text as text
import "../src/app.ai" as app
import "../src/preview.ai" as preview
import "../src/provider.ai" as provider

fn count(state: ref<app.App>, clip: u64) -> u64 effects {} {
  match app.waveform_slot(state,clip) {none=>0,some(slot)=>{
    array.len(struct.borrow(array.borrow(struct.borrow(state,field=waveforms),slot),field=peaks))
  },}
}
fn seed(state: ref<app.App>, clip: u64, peaks: u64, value: f64) -> unit effects {alloc} {
  var values: array<f64> =array.repeat(value,peaks)
  app.set_waveform(state,clip,values,0,196607,state.media_revision)
}
fn requests(state: ref<app.App>) -> u64 effects {} {
  struct.get(struct.borrow(state,field=provider),field=calls)
}
fn bins(length: i64, wanted: u64) -> u64 effects {alloc} {
  match preview.waveform_buckets(length,wanted) {ok(value)=>value,err(_)=>0,}
}
pub fn main(args: view<str>) -> i32 effects {alloc,env,fs.meta,fs.read,fs.write,io.write,process,time} {
  if view.len(args) != 2 {return 2}
  let root: str=view.get(args,1)
  let _=files.mkdirs(root)
  var suite: test.Suite=test.suite("Processed fine waveform cache",true)
  let _=test.start(suite,"Fine bucket bounds are fixed independently of zoom")
  let _=test.eq_u64(suite,bins(1536,1),512,"Legacy boundary still512")
  let _=test.eq_u64(suite,bins(1539,1),513,"Next threeframes exceed coarsecap")
  let _=test.eq_u64(suite,bins(76701,1),25567,"21minute60fps clip has threeframe finecells")
  let _=test.eq_u64(suite,bins(9223372036854775807,1),65536,"Signed endpoint saturates at actual supported cap")
  let _=test.eq_u64(suite,bins(196608,5),52428,"Five longclips share fairquota")
  let _=test.eq_u64(suite,bins(1,32768),8,"Minimum cells fit exact clipcountlimit")
  let _=test.check(suite,match preview.waveform_buckets(196608,32769) {ok(_)=>false,err(problem)=>text.contains(problem,"GA_AUDIO_CLIP_ENV_CAPACITY"),},"Excess targets refuse ratherthan drop a visiblewave")
  let _=test.done(suite)

  var state: app.App=app.app(provider.fake(root))
  var doc: editor.Document=editor.document(60.0,160,90)
  let source: u64=editor.add_source(doc,"unused-fake-audio.wav","Samplecoded",200000,60.0)
  let _=editor.describe_source(doc,source,0,0,false,true,48000,2)
  let track: u64=editor.add_track(doc,doc.active,editor.track_audio(),"Audio")
  // Document visits E/F/G first, A last. A is the oldest cached entry.
  let e: u64=option.unwrap(editor.place(doc,track,source,0,196608,0))
  let f: u64=option.unwrap(editor.place(doc,track,source,0,196608,0))
  let g: u64=option.unwrap(editor.place(doc,track,source,0,196608,0))
  let b: u64=option.unwrap(editor.place(doc,track,source,0,196608,500000))
  let c: u64=option.unwrap(editor.place(doc,track,source,0,196608,500000))
  let d: u64=option.unwrap(editor.place(doc,track,source,0,196608,500000))
  let a: u64=option.unwrap(editor.place(doc,track,source,0,196608,0))
  let _=struct.replace(state,doc,field=document)
  struct.set(state,9,field=document_revision)
  struct.set(state,7,field=media_revision)
  seed(state,a,65536,0.123456)
  seed(state,b,65536,0.2)
  seed(state,c,65536,0.3)
  seed(state,d,65536,0.4)
  let _=test.start(suite,"All cached targets are promoted before earlier document-order misses")
  let _=test.eq_u64(suite,app.waveform_peak_count(state),262144,"Initial cache exactly2MiB ofscalar doubles")
  let _=test.check(suite,match preview.waveforms_for_viewport(state,"",0,0,100) {ok(value)=>value==4,err(_)=>false,},"E/F/G/A all complete despite A visitedlast")
  let _=test.eq_u64(suite,requests(state),3,"Only three uncached clips requestedmedia")
  var targets: array<u64> =[e,f,g,a]
  var at: u64=0
  loop {if at >= array.len(targets) {break}
    let _=test.eq_u64(suite,count(state,array.get(targets,at)),65536,"Every requested clip remainsfine")
    at=at+1
  }
  let slot: u64=option.unwrap(app.waveform_slot(state,a))
  let _=test.check(suite,array.get(struct.borrow(array.borrow(struct.borrow(state,field=waveforms),slot),field=peaks),123)==0.123456,"Cached lateA ownedpeak bytes unchanged")
  let _=test.check(suite,count(state,b)==0 and count(state,c)==0 and count(state,d)==0,"Only offscreen oldentries evicted")
  let _=test.eq_u64(suite,app.waveform_peak_count(state),262144,"Capacity invariant exact aftereviction")
  let _=test.done(suite)

  let _=test.start(suite,"Pan and zoom keep complete finepeaks without more media work")
  let _=test.check(suite,match preview.waveforms_for_viewport(state,"",0,20,40) {ok(value)=>value==4,err(_)=>false,},"Panned overlap reuses allcurrententries")
  let _=test.check(suite,match preview.waveforms_for_viewport(state,"",0,0,1) {ok(value)=>value==4,err(_)=>false,},"Oneframezoom reuses fullclip cells")
  let _=test.eq_u64(suite,requests(state),3,"No zoom-driven worker recurrence")
  let _=test.done(suite)

  let _=test.start(suite,"Fair visiblequota fits allfive longclips, not a missing-wave generation")
  let h: u64=option.unwrap(editor.place(struct.borrow(state,field=document),track,source,0,196608,0))
  let _=test.check(suite,match preview.waveforms_for_viewport(state,"",0,0,100) {ok(value)=>value==5,err(_)=>false,},"Five visibleclips eachcomplete")
  array.push(targets,h)
  at=0
  loop {if at >= array.len(targets) {break}
    let _=test.eq_u64(suite,count(state,array.get(targets,at)),52428,"Perclipquota exactandfair")
    at=at+1
  }
  let _=test.eq_u64(suite,app.waveform_peak_count(state),262140,"Complete request remainsunder2MiB scalarbudget")
  let _=test.done(suite)

  let _=test.start(suite,"Failed incoming cacheupdates preserve successful ownedentries")
  seed(state,999999,65536,0.1)
  seed(state,a,65537,0.1)
  seed(state,a,65536,-0.1)
  let _=test.eq_u64(suite,count(state,a),52428,"Unknown, oversized and negative incoming data cannotreplace A")
  let _=test.eq_u64(suite,app.waveform_peak_count(state),262140,"Refusal causesnoeviction")
  let _=test.done(suite)
  let _=test.start(suite,"Semantic revision invalidates every currently visibleprocessed clip")
  let before: u64=requests(state)
  app.document_changed(state)
  let _=test.check(suite,match preview.waveforms_for_viewport(state,"",0,0,100) {ok(value)=>value==5,err(_)=>false,},"Changeddocument refills exactrequestedset")
  let _=test.eq_u64(suite,requests(state)-before,5,"Every visibleclip regenerated")
  let _=test.eq_u64(suite,app.waveform_peak_count(state),262140,"Newrevision obeyssamebudget")
  let _=test.done(suite)
  test.conclude(suite,path.join(root,"waveform-detail-tests.json"),6)
}
