// Shared editor Split acceptance: compare every original timeline sample and full
// interpolation contexts, rather than deriving an expectation from new clip fields.
module genesis.tests.editor_split
import std.editor as editor
import std.editor_io as editor_io
import std.curve as curve
import std.math as math
import std.files as files
import std.path as path
import std.testing as test
import "../src/app.ai" as app
import "../src/commands.ai" as commands
import "../src/filter_keys.ai" as scoped
import "../src/picture_queue.ai" as pictures
import "../src/provider.ai" as provider
import "../src/timeline_media.ai" as media

fn encoded(doc: ref<editor.Document>) -> string effects {alloc} {
  match editor_io.encode(doc) {ok(value)=>value,err(_)=>string.copy("encode failed"),}
}
fn history_bytes(history: ref<editor.History>) -> string effects {alloc} {
  var out: string = string.copy("undo\n")
  var i: u64 = 0
  loop {if i >= editor.undo_depth(history) {break}
    string.append(out,encoded(array.borrow(struct.borrow(history,field=undo),i)))
    string.append(out,"\n")
    i=i+1}
  string.append(out,"redo\n")
  i=0
  loop {if i >= editor.redo_depth(history) {break}
    string.append(out,encoded(array.borrow(struct.borrow(history,field=redo),i)))
    string.append(out,"\n")
    i=i+1}
  out
}
fn fade_sample(value: editor.Clip, frame: i64) -> f64 effects {} {
  let local: i64 = frame-value.start
  var gain: f64 = 1.0
  if value.fade_in > 0 and local < value.fade_in {gain=cast.float(local)/cast.float(value.fade_in)}
  if value.fade_out > 0 and value.length-local <= value.fade_out {
    gain=math.min(gain,cast.float(value.length-local)/cast.float(value.fade_out))
  }
  gain
}
fn lift_survivors(suite: ref<test.Suite>, original: ref<editor.Document>, changed: ref<editor.Document>, id: u64) -> unit effects {alloc} {
  let old: editor.Clip = option.unwrap(editor.clip(original,id))
  let source_slot: u64 = option.unwrap(editor.source_slot(original,old.source))
  let source_fps: f64 = struct.get(array.borrow(struct.borrow(original,field=sources),source_slot),field=fps)
  let ratio: f64 = source_fps/editor.sequence_fps(original,old.owner)
  var frame: i64 = old.start
  loop {if frame >= editor.clip_end(old) {break}
    if frame >= 37 and frame < 52 {frame=52}
    var landed: u64 = 0
    var i: u64 = 0
    loop {if i >= editor.clip_count(changed) {break}
      let value: editor.Clip = option.unwrap(editor.clip_at(changed,i))
      if value.track == old.track and value.start <= frame and frame < editor.clip_end(value) {
        landed=value.id
        break
      }
      i=i+1}
    let _ = test.check(suite,landed != 0,"Lift retains every outside-gap sample")
    if landed != 0 {
      let next: editor.Clip = option.unwrap(editor.clip(changed,landed))
      let local: i64 = frame-old.start
      let expected: i64 = cast.sat(math.floor((cast.float(old.source_in)+cast.float(if old.reverse {old.length-1-local}else{local})*editor.playback_rate(original,old))*ratio))
      let _ = test.eq_i64(suite,media.source_frame(changed,next,frame),expected,"Newly legal Lift survivor matches independent original source coordinates")
      let _ = test.near_f64(suite,fade_sample(next,frame),fade_sample(old,frame),0.000000000001,"Newly legal Lift survivor retains every original fade sample")
      i=0
      loop {if i >= array.len(struct.borrow(original,field=keys)) {break}
        let key: editor.Key = array.get(struct.borrow(original,field=keys),i)
        if key.clip == id {
          let name: string = editor.name_text(original,key.param)
          let _ = test.near_f64(suite,editor.clip_value_at(changed,landed,name,frame,-1.0),editor.clip_value_at(original,id,name,frame,-1.0),0.000000000001,"Surviving original automation remains at the original frame time")
        }
        i=i+1}
    }
    frame=frame+1}
  ()
}
fn source_continuity(suite: ref<test.Suite>) -> unit effects {alloc,fs.meta,fs.write,time} {
  let _ = test.start(suite,"Split preserves forward reverse freeze and mixed-fps source samples")
  var variant: u64 = 0
  loop {if variant >= 10 {break}
    var doc: editor.Document = editor.document(30.0,1920,1080)
    let source: u64 = editor.add_source(doc,"sample.mov","Sample",2400,24.0)
    let track: u64 = editor.add_track(doc,doc.active,editor.track_video(),"V1")
    let id: u64 = option.unwrap(editor.place(doc,track,source,20,90,10))
    let rate: f64 = if variant < 2 {0.0} else if variant < 4 {0.5} else if variant < 6 {1.0} else if variant < 8 {2.0} else {0.5}
    let _ = editor.set_clip_speed(doc,id,rate)
    let _ = editor.set_clip_reverse(doc,id,variant%2 == 1)
    if variant >= 8 {
      let speed: u64 = option.unwrap(editor.add_filter(doc,id,"speed"))
      let _ = editor.set_filter_param(doc,speed,"rate",4.0)
    }
    var original: editor.Document = editor.copy_document(doc)
    let old: editor.Clip = option.unwrap(editor.clip(original,id))
    let right: u64 = match editor.split(doc,id,34) {none=>0,some(value)=>value,}
    let _ = test.check(suite,right != 0,"Representable static-rate cut succeeds")
    let left_clip: editor.Clip = option.unwrap(editor.clip(doc,id))
    let right_clip: editor.Clip = option.unwrap(editor.clip(doc,right))
    var frame: i64 = 10
    loop {if frame >= 100 {break}
      let landed: editor.Clip = if frame < 34 {left_clip} else {right_clip}
      let independent: i64 = cast.sat(math.floor((20.0+cast.float(if old.reverse {99-frame} else {frame-10})*media.effective_speed(original,old))*0.8))
      let _ = test.eq_i64(suite,media.source_frame(doc,landed,frame),independent,"Every split frame equals independent original source indexing")
      frame=frame+1}
    variant=variant+1}
  let _ = test.done(suite)
  ()
}
fn content_continuity(suite: ref<test.Suite>) -> unit effects {alloc,fs.meta,fs.write,time} {
  let _ = test.start(suite,"Split clones ordered instance filters and complete nonlinear automation contexts")
  var doc: editor.Document = editor.document(30.0,1920,1080)
  let source: u64 = editor.add_source(doc,"sample.mov","Sample",2400,24.0)
  let track: u64 = editor.add_track(doc,doc.active,editor.track_video(),"V1")
  let id: u64 = option.unwrap(editor.place(doc,track,source,20,90,10))
  let first: u64 = option.unwrap(editor.add_filter(doc,id,"brightness"))
  let second: u64 = option.unwrap(editor.add_filter(doc,id,"brightness"))
  let _ = editor.set_filter_param(doc,first,"amount",0.2)
  let _ = editor.set_filter_param(doc,second,"amount",0.8)
  let _ = editor.set_filter_text_param(doc,first,"label","Original text")
  let _ = editor.set_filter_enabled(doc,second,false)
  let _ = editor.reorder_filter(doc,second,0)
  let name: string = scoped.name(first,"brightness","amount")
  var names: array<string> = [string.copy("gain"),string.copy("opacity"),name,string.copy("brightness.amount")]
  var p: u64 = 0
  loop {if p >= array.len(names) {break}
    let param: str = str.view(array.borrow(names,p))
    let kind: u32 = if p == 0 {curve.smooth_natural()} else if p == 1 {curve.bounce_out()} else if p == 2 {curve.cubic_in_out()} else {curve.hold()}
    let _ = editor.set_key(doc,id,param,0,0.2,kind)
    let _ = editor.set_key(doc,id,param,20,0.9,kind)
    let _ = editor.set_key(doc,id,param,60,0.3,kind)
    let _ = editor.set_key(doc,id,param,89,0.7,kind)
    p=p+1}
  let _ = editor.set_fade_in(doc,id,37)
  let _ = editor.set_fade_out(doc,id,53)
  var original: editor.Document = editor.copy_document(doc)
  let right: u64 = option.unwrap(editor.split(doc,id,47))
  let cloned_second: u64 = option.unwrap(editor.filter_at(doc,right,0))
  let cloned_first: u64 = option.unwrap(editor.filter_at(doc,right,1))
  let _ = test.check(suite,cloned_first != first and cloned_second != second,"Every cloned instance receives a fresh filter identity")
  let _ = test.check(suite,not editor.filter_enabled(doc,cloned_second) and editor.filter_enabled(doc,cloned_first),"Stack order and disabled state survive")
  let _ = test.near_f64(suite,editor.filter_param(doc,cloned_first,"amount",0.0),0.2,0.0,"Numeric filter parameter survives")
  let _ = test.eq_str(suite,editor.filter_text_param(doc,cloned_first,"label",""),"Original text","Text parameter survives")
  let right_name: string = scoped.name(cloned_first,"brightness","amount")
  let _ = test.eq_u64(suite,editor.key_count(doc,right,right_name),4,"Scoped automation remaps the fresh filter identity")
  let _ = test.eq_u64(suite,editor.key_count(doc,right,array.borrow(names,2)),0,"Right clip has no dangling old scoped filter identity")
  var frame: i64 = 10
  loop {if frame >= 100 {break}
    let old_clip: editor.Clip = option.unwrap(editor.clip(original,id))
    let new_clip: editor.Clip = option.unwrap(editor.clip(doc,if frame < 47 {id} else {right}))
    let _ = test.near_f64(suite,fade_sample(new_clip,frame),fade_sample(old_clip,frame),0.000000000001,"Every original outer-fade sample remains identical at a representable boundary cut")
    p=0
    loop {if p >= array.len(names) {break}
      let left_name: str = str.view(array.borrow(names,p))
      let parameter: string = if frame < 47 or p != 2 {string.copy(left_name)} else {string.copy(str.view(right_name))}
      let expected: f64 = editor.clip_value_at(original,id,left_name,frame,-1.0)
      let actual: f64 = editor.clip_value_at(doc,if frame < 47 {id} else {right},parameter,frame,-1.0)
      let _ = test.near_f64(suite,actual,expected,0.000000000001,"Every nonlinear gain opacity scoped and legacy frame remains identical")
      p=p+1}
    frame=frame+1}
  var negatives: u64 = 0
  p=0
  loop {if p >= array.len(struct.borrow(doc,field=keys)) {break}
    let key: editor.Key = array.get(struct.borrow(doc,field=keys),p)
    if key.clip == right and key.frame < 0 {negatives=negatives+1}
    p=p+1}
  let _ = test.eq_u64(suite,negatives,8,"Two negative context keys per curve preserve original easing and Catmull tangents")
  let serialized: string = encoded(doc)
  var reloaded: editor.Document = match editor_io.decode(serialized) {ok(value)=>value,err(_)=>editor.document(30.0,1920,1080),}
  let _ = test.eq_str(suite,encoded(reloaded),serialized,"Complete negative and out-of-body curve context survives project roundtrip without a schema change")
  let _ = editor.set_filter_text_param(doc,cloned_first,"label","Changed right")
  let _ = test.eq_str(suite,editor.filter_text_param(doc,first,"label",""),"Original text","Cloned text storage is independent")
  let _ = test.eq_i64(suite,option.unwrap(editor.clip(doc,id)).fade_in,37,"Left retains exact outer fade-in")
  let _ = test.eq_i64(suite,option.unwrap(editor.clip(doc,right)).fade_out,53,"Right retains exact outer fade-out")
  let _ = test.done(suite)
  ()
}
// Supported tail cuts must exercise the public command transaction as well as the
// toolkit. Expectations below are authored source/frame/sample constants, not
// values derived from audio_context_for or the new split implementation.
fn supported_tail_transactions(suite: ref<test.Suite>, root: str) -> unit effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  var variant: u64 = 0
  loop {if variant >= 2 {break}
    var state: app.App = app.app(provider.fake(root))
    let source: commands.Result = commands.import_media(state,"tail.mov","Tail source")
    let placed: commands.Result = commands.append_clip(state,app.default_video_track(state),source.value,0,90)
    let audio: commands.Result = commands.append_clip(state,app.default_audio_track(state),source.value,0,90)
    let kind: str = if variant == 0 {"delay"} else {"reverb"}
    let parameter: str = if variant == 0 {"time"} else {"amount"}
    let amount: f64 = if variant == 0 {250.0} else {0.35}
    let filter: u64 = option.unwrap(editor.add_filter(struct.borrow(state,field=document),placed.value,kind))
    let _ = test.check(suite,editor.set_filter_param(struct.borrow(state,field=document),filter,parameter,amount),"Static tail parameter is authored")
    let _ = commands.select_only(state,placed.value)
    let _ = commands.seek(state,37)
    let _ = commands.set_clip_field(state,audio.value,"gain",0.5)
    let _ = commands.undo(state)
    app.mark_dirty(state,false)
    let before: string = encoded(struct.borrow(state,field=document))
    let neutral: editor.Clip = option.unwrap(editor.clip(struct.borrow(state,field=document),audio.value))
    let depth: u64 = editor.undo_depth(struct.borrow(state,field=history))
    let revision: u64 = state.document_revision
    let identity: string = pictures.identity_revision(state,false,true)
    let eligible_clip: editor.Clip = option.unwrap(editor.clip(struct.borrow(state,field=document),placed.value))
    let _ = test.check(suite,editor.redo_depth(struct.borrow(state,field=history)) == 1 and editor.audio_tail_context_supported(struct.borrow(state,field=document),eligible_clip),"Supported48k tail cut starts with a real Redo branch")
    let split: commands.Result = commands.split_at_playhead(state)
    let _ = test.check(suite,split.ok and split.value != placed.value,"Public command admits the supported static48k tail cut")
    if not split.ok {return ()}
    let left: editor.Clip = option.unwrap(editor.clip(struct.borrow(state,field=document),placed.value))
    let right: editor.Clip = option.unwrap(editor.clip(struct.borrow(state,field=document),split.value))
    let other: editor.Clip = option.unwrap(editor.clip(struct.borrow(state,field=document),audio.value))
    let _ = test.check(suite,left.start == 0 and left.length == 37 and left.source_in == 0 and right.start == 37 and right.length == 53 and right.source_in == 37,"Both visible pieces exactly cover authored0..90 with source cut37")
    let _ = test.check(suite,left.source == source.value and right.source == source.value and left.track == app.default_video_track(state) and right.track == left.track and left.streams == editor.streams_both() and right.streams == left.streams,"Split retains media lane and stream identity")
    let _ = test.check(suite,other.id == neutral.id and other.owner == neutral.owner and other.source == neutral.source and other.nested == neutral.nested and other.track == neutral.track and other.group == neutral.group and other.start == neutral.start and other.length == neutral.length and other.source_in == neutral.source_in,"Unlinked neutral audio clip retains every identity and geometry field")
    let _ = test.check(suite,other.enabled == neutral.enabled and other.selected == neutral.selected and other.streams == neutral.streams and other.fade_in == neutral.fade_in and other.fade_out == neutral.fade_out and other.gain == neutral.gain and other.pan == neutral.pan and other.speed == neutral.speed and other.reverse == neutral.reverse and not option.is_some(other.audio_context) and editor.filter_count(struct.borrow(state,field=document),other.id) == 0,"Neutral clip scalar state and context remain unchanged")
    let _ = test.check(suite,option.is_some(left.audio_context) and option.is_some(right.audio_context),"Both pieces own durable full processing contexts")
    if not option.is_some(left.audio_context) or not option.is_some(right.audio_context) {return ()}
    let lc: editor.AudioContext = option.unwrap(left.audio_context)
    let rc: editor.AudioContext = option.unwrap(right.audio_context)
    let _ = test.check(suite,lc.source_in == 0 and rc.source_in == 0 and lc.length == 90 and rc.length == 90 and lc.origin == 0 and rc.origin == 0 and lc.fps == 30.0 and rc.fps == 30.0 and lc.rate == 1.0 and rc.rate == 1.0 and not lc.reverse and not rc.reverse and not option.is_some(lc.extent) and not option.is_some(rc.extent),"Original full90-frame source and30fps unit phase persist on both pieces")
    let _ = test.check(suite,lc.offset == 0 and lc.crop_start == 0 and rc.offset == 37 and rc.crop_start == 59200 and lc.output_frames == 144000 and rc.output_frames == 144000,"Exact48k body crop is independently37 times1600 and full90 times1600")
    let _ = test.check(suite,lc.offset+left.length != lc.length and rc.offset+right.length == rc.length and editor.audio_tail_context_supported(struct.borrow(state,field=document),left) and editor.audio_tail_context_supported(struct.borrow(state,field=document),right),"Only right original-end survivor owns the EOF tail")
    let clone: u64 = option.unwrap(editor.filter_at(struct.borrow(state,field=document),right.id,0))
    let _ = test.check(suite,clone != filter and editor.filter_count(struct.borrow(state,field=document),left.id) == 1 and editor.filter_count(struct.borrow(state,field=document),right.id) == 1 and editor.filter_enabled(struct.borrow(state,field=document),filter) and editor.filter_enabled(struct.borrow(state,field=document),clone),"Ordered enabled tail filter is cloned with a fresh identity")
    let _ = test.eq_str(suite,editor.filter_kind(struct.borrow(state,field=document),clone),kind,"Cloned filter retains authored effect kind")
    let _ = test.near_f64(suite,editor.filter_param(struct.borrow(state,field=document),clone,parameter,-1.0),amount,0.0,"Cloned parameter retains the independently authored scalar")
    let _ = test.check(suite,editor.undo_depth(struct.borrow(state,field=history)) == depth+1 and editor.redo_depth(struct.borrow(state,field=history)) == 0,"Successful tail Split captures exactly one Undo and retires Redo")
    let _ = test.check(suite,state.document_revision == revision+1 and pictures.identity_revision(state,false,true) != identity and app.dirty(state),"Accepted tail Split invalidates prepared content identity exactly once")
    let committed: string = encoded(struct.borrow(state,field=document))
    let target: string = path.join(root,if variant == 0 {"split-delay.air"} else {"split-reverb.air"})
    let saved: bool = match files.write_text(target,committed) {ok(_)=>true,err(_)=>false,}
    let _ = test.check(suite,saved,"Supported tail project writes to a private Save path")
    let opened: string = match files.read_text(target) {ok(s)=>s,err(_)=>string.copy("missing"),}
    var loaded: editor.Document = match editor_io.decode(opened) {ok(d)=>d,err(_)=>{let _=test.check(suite,false,"Supported tail project opens with valid retained contexts")
      return ()},}
    let _ = test.eq_str(suite,encoded(loaded),committed,"Save Open retains complete cloned graph contexts and IDs")
    let _ = test.check(suite,commands.undo(state).ok,"Supported tail Split has Undo")
    let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),before,"Undo restores complete original graph with no retained context")
    let _ = test.check(suite,commands.redo(state).ok,"Supported tail Split has Redo")
    let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),committed,"Redo restores exact supported tail graph and stable IDs")
    variant=variant+1}
  ()
}
fn refused_and_undo(suite: ref<test.Suite>, root: str) -> unit effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  let _ = test.start(suite,"Split refusals preserve complete document redo selection and preview identity")
  var state: app.App = app.app(provider.fake(root))
  let source: commands.Result = commands.import_media(state,"split.mov","Split source")
  let placed: commands.Result = commands.append_clip(state,app.default_video_track(state),source.value,0,90)
  let audio: commands.Result = commands.append_clip(state,app.default_audio_track(state),source.value,0,90)
  let _ = commands.select_only(state,placed.value)
  let _ = commands.seek(state,37)
  let source_slot: u64 = option.unwrap(editor.source_slot(struct.borrow(state,field=document),source.value))
  let width: u32 = struct.get(array.borrow(struct.borrow(struct.borrow(state,field=document),field=sources),source_slot),field=width)
  let height: u32 = struct.get(array.borrow(struct.borrow(struct.borrow(state,field=document),field=sources),source_slot),field=height)
  let video_present: bool = struct.get(array.borrow(struct.borrow(struct.borrow(state,field=document),field=sources),source_slot),field=has_video)
  let audio_present: bool = struct.get(array.borrow(struct.borrow(struct.borrow(state,field=document),field=sources),source_slot),field=has_audio)
  let audio_rate: u32 = struct.get(array.borrow(struct.borrow(struct.borrow(state,field=document),field=sources),source_slot),field=audio_rate)
  let channels: u32 = struct.get(array.borrow(struct.borrow(struct.borrow(state,field=document),field=sources),source_slot),field=audio_channels)
  var variant: u64 = 0
  loop {if variant >= 9 {break}
    let _ = editor.set_clip_speed(struct.borrow(state,field=document),placed.value,if variant < 2 {0.5} else {1.0})
    let _ = editor.set_clip_reverse(struct.borrow(state,field=document),placed.value,variant == 1)
    let _ = editor.set_fade_in(struct.borrow(state,field=document),placed.value,if variant == 2 {48} else {0})
    let _ = editor.set_fade_out(struct.borrow(state,field=document),placed.value,if variant == 3 {54} else {0})
    if variant == 4 {let _ = editor.set_key(struct.borrow(state,field=document),placed.value,"fade_in",0,0.0,curve.linear())}
    if variant == 5 {let _ = editor.set_key(struct.borrow(state,field=document),placed.value,"speed.rate",0,1.0,curve.linear())}
    let original_streams:u32=editor.clip_streams(struct.borrow(state,field=document),placed.value)
    if variant >= 7 {let _=editor.set_clip_streams(struct.borrow(state,field=document),placed.value,editor.streams_both())}
    // Static48k Delay/Reverb cuts now preserve actual EOF tails. These two
    // negatives intentionally use the still-unproved32k native domain instead.
    if variant >= 7 {let _=editor.describe_source(struct.borrow(state,field=document),source.value,width,height,video_present,audio_present,32000,channels)}
    var temporal: u64 = 0
    if variant >= 6 {
      let kind: string = if variant == 6 {string.copy("timer")} else if variant == 7 {string.copy("delay")} else {string.copy("reverb")}
      temporal=option.unwrap(editor.add_filter(struct.borrow(state,field=document),placed.value,str.view(kind)))
    }
    if variant >= 7 {let unproved: editor.Clip=option.unwrap(editor.clip(struct.borrow(state,field=document),placed.value))
      let _=test.check(suite,not editor.audio_tail_context_supported(struct.borrow(state,field=document),unproved),"Unproved32k tail history remains outside the supported cut domain")}
    let _ = commands.set_clip_field(state,audio.value,"gain",0.5)
    let _ = commands.undo(state)
    app.mark_dirty(state,false)
    let before: string = encoded(struct.borrow(state,field=document))
    let history: string = history_bytes(struct.borrow(state,field=history))
    let revision: u64 = state.document_revision
    let key: string = pictures.identity_revision(state,false,true)
    var probe: editor.Document = editor.copy_document(struct.borrow(state,field=document))
    let raw: option<u64> = editor.split(probe,placed.value,37)
    let _ = test.check(suite,match raw {none=>true,some(_)=>false,},"Shared toolkit itself refuses unsupported cut")
    let _ = test.eq_str(suite,encoded(probe),before,"SDK refusal changes no clip filter key name or ID allocator")
    let inserted: option<u64> = editor.insert(probe,app.default_video_track(state),source.value,0,15,37)
    let _ = test.check(suite,match inserted {none=>true,some(_)=>false,},"Insert propagates occupied-clip split refusal")
    let _ = test.eq_str(suite,encoded(probe),before,"SDK refused insertion leaves occupied content untouched")
    let overwritten: option<u64> = editor.overwrite(probe,app.default_video_track(state),source.value,0,15,37)
    // A fractional Split at37 still refuses, but lifting37..52 needs an integral
    // head phase only at52. Likewise the gap can fully remove a right fade-in while
    // preserving a longer left ramp. These operations now have exact representations.
    if variant == 0 or variant == 2 {
      let _ = test.check(suite,match overwritten {none=>false,some(_)=>true,},"Overwrite admits independently representable surviving trims")
      lift_survivors(suite,struct.borrow(state,field=document),probe,placed.value)
      var lifted: editor.Document = editor.copy_document(struct.borrow(state,field=document))
      editor.lift_range(lifted,app.default_video_track(state),37,52)
      lift_survivors(suite,struct.borrow(state,field=document),lifted,placed.value)
    } else {
      let _ = test.check(suite,match overwritten {none=>true,some(_)=>false,},"Overwrite preflights unsafe surviving trims")
      let _ = test.eq_str(suite,encoded(probe),before,"SDK refused overwrite preserves both remnants")
      editor.lift_range(probe,app.default_video_track(state),37,52)
      let _ = test.eq_str(suite,encoded(probe),before,"Destructive lift-range caller fails safely before unsupported context")
    }
    let result: commands.Result = commands.split_at_playhead(state)
    let _ = test.check(suite,not result.ok,"Unsupported phase fades rates picture timer or unproved32k delay-tail cut is refused")
    let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),before,"Refusal does not cut the other eligible audio clip")
    let _ = test.eq_str(suite,history_bytes(struct.borrow(state,field=history)),history,"Refusal preserves every undo and redo snapshot")
    let _ = test.eq_u64(suite,state.document_revision,revision,"Refused Split preserves document revision")
    let _ = test.eq_str(suite,pictures.identity_revision(state,false,true),key,"Refused Split preserves cached preview identity")
    let _ = test.check(suite,not app.dirty(state),"Refused Split leaves saved state clean")
    let razor: commands.Result = commands.razor_all(state)
    let _ = test.check(suite,not razor.ok,"All-track razor refuses atomically when one lane cannot preserve context")
    let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),before,"Refused all-track razor preserves all clips")
    let _ = test.eq_str(suite,history_bytes(struct.borrow(state,field=history)),history,"Refused all-track razor preserves redo")
    if variant == 4 {let _ = editor.remove_key(struct.borrow(state,field=document),placed.value,"fade_in",0)}
    if variant == 5 {let _ = editor.remove_key(struct.borrow(state,field=document),placed.value,"speed.rate",0)}
    if temporal != 0 {let _ = editor.remove_filter(struct.borrow(state,field=document),temporal)}
    let _=editor.set_clip_streams(struct.borrow(state,field=document),placed.value,original_streams)
    if variant >= 7 {let _=test.check(suite,editor.describe_source(struct.borrow(state,field=document),source.value,width,height,video_present,audio_present,audio_rate,channels),"Restore original source metadata after unproved tail refusal")}
    variant=variant+1}
  let _ = editor.remove_key(struct.borrow(state,field=document),placed.value,"speed.rate",0)
  let _ = editor.set_clip_speed(struct.borrow(state,field=document),placed.value,1.0)
  let inactive: u64 = option.unwrap(editor.add_filter(struct.borrow(state,field=document),placed.value,"timer"))
  let _ = editor.set_filter_enabled(struct.borrow(state,field=document),inactive,false)
  let before: string = encoded(struct.borrow(state,field=document))
  let depth: u64 = editor.undo_depth(struct.borrow(state,field=history))
  let succeeded: commands.Result = commands.split_at_playhead(state)
  let _ = test.check(suite,succeeded.ok,"Representable selected Split succeeds")
  let _ = test.eq_u64(suite,editor.undo_depth(struct.borrow(state,field=history)),depth+1,"Split captures exactly once")
  let committed: string = encoded(struct.borrow(state,field=document))
  let _ = commands.undo(state)
  let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),before,"Undo restores full pre-Split document")
  let _ = commands.redo(state)
  let _ = test.eq_str(suite,encoded(struct.borrow(state,field=document)),committed,"Redo restores exact committed Split")
  supported_tail_transactions(suite,root)
  let _ = test.done(suite)
  ()
}
pub fn run(suite: ref<test.Suite>, root: str) -> unit effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  source_continuity(suite)
  content_continuity(suite)
  refused_and_undo(suite,root)
  ()
}
