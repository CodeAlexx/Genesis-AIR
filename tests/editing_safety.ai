module genesis.tests.editing_safety
import std.editor as editor
import std.editor_io as editor_io
import std.files as files
import std.path as path
import std.testing as test
import std.text as text
import std.widgets as widgets
import std.timeline as timeline
import "../src/app.ai" as app
import "../src/commands.ai" as commands
import "../src/input.ai" as input
import "../src/chrome.ai" as chrome
import "../src/layout.ai" as layout
import "../src/view.ai" as painter
import "../src/provider.ai" as provider
fn encoded(doc:ref<editor.Document>) -> string effects {alloc} {
  match editor_io.encode(doc) {ok(value)=>value,err(_)=>string.copy("encode failed"),}
}
fn stable(state:ref<app.App>) -> string effects {alloc} {
  var out:string=encoded(struct.borrow(state,field=document))
  string.append(out,string.from_int(state.document_revision))
  string.append(out,string.from_int(state.media_revision))
  string.append(out,if app.dirty(state) {"dirty"}else{"clean"})
  let history:ref<editor.History> = struct.borrow(state,field=history)
  var i:u64=0
  loop {if i>=array.len(struct.borrow(history,field=undo)) {break}
    string.append(out,"undo")
    string.append(out,encoded(array.borrow(struct.borrow(history,field=undo),i)))
    i=i+1}
  i=0
  loop {if i>=array.len(struct.borrow(history,field=redo)) {break}
    string.append(out,"redo")
    string.append(out,encoded(array.borrow(struct.borrow(history,field=redo),i)))
    i=i+1}
  out
}
// Authored IDs: sources3/4, tracks5/6, clips7/8/9. A0..24, B24..60;
// unrelated audio lane clip12..24. These expected ranges are not generated by edits.
fn fixture(root:str,locked:bool) -> app.App effects {alloc} {
  var state:app.App=app.app(provider.fake(root))
  var doc:editor.Document=editor.document(24.0,320,180)
  let a:u64=editor.add_source(doc,"first.mov","First",1000,24.0)
  let b:u64=editor.add_source(doc,"second.mov","Second",1000,24.0)
  let _=editor.describe_source(doc,a,320,180,true,true,48000,2)
  let _=editor.describe_source(doc,b,320,180,true,true,48000,2)
  let video:u64=editor.add_track(doc,doc.active,editor.track_video(),"Video")
  let audio:u64=editor.add_track(doc,doc.active,editor.track_audio(),"Other lane")
  let first:u64=option.unwrap(editor.place(doc,video,a,12,24,0))
  let second:u64=option.unwrap(editor.place(doc,video,b,100,36,24))
  let _=editor.place(doc,audio,a,200,12,12)
  let grade:u64=option.unwrap(editor.add_filter(doc,first,"brightness"))
  let _=editor.set_filter_param(doc,grade,"level",0.2)
  let _=editor.set_filter_text_param(doc,grade,"caption","Safety 日本")
  let _=editor.set_key(doc,first,"gain",-5,0.25,1)
  let _=editor.set_key(doc,first,"gain",40,0.75,2)
  let _=editor.set_key(doc,second,"brightness.level",0,0.3,0)
  let _=editor.select_only(doc,first)
  let _=editor.set_track_lock(doc,video,locked)
  commands.replace_project(state,doc)
  let _=commands.set_clip_field(state,first,"gain",0.4)
  let _=commands.undo(state)
  app.mark_dirty(state,false)
  state
}
fn click(state:ref<app.App>,action:u32,target:u64) -> string effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  let frame:layout.Frame=layout.frame(1600.0,980.0)
  var controls:array<chrome.Control> = array.new()
  if action==chrome.act_track_remove() {
    var model:timeline.Timeline=painter.timeline_model(state,frame.timeline)
    let _=ref.swap(controls,chrome.track_controls(frame,state,model))
  }else{let _=ref.swap(controls,chrome.timeline_bar(frame,state))}
  var i:u64=0
  loop {if i>=array.len(controls) {break}
    let control:ref<chrome.Control> = array.borrow(controls,i)
    if control.action==action and (target==0 or control.target==target) {
      let area:layout.Rect=control.area
      let x:f64=(area.left+area.right)/2.0
      let y:f64=(area.top+area.bottom)/2.0
      let result:string=input.pointer_down(state,1600.0,980.0,x,y)
      let _=input.pointer_up(state,1600.0,980.0,x,y)
      return result
    }
    i=i+1}
  string.copy("CONTROL_MISSING")
}
fn sample(state:ref<app.App>,at:i64) -> string effects {alloc} {
  let _=commands.seek(state,at)
  match app.program_sample(state) {none=>string.copy("gap"),some(value)=>text.concat(value.source,text.concat(":",string.from_int(value.frame))),}
}
pub fn main(args:view<str>) -> i32 effects {alloc,env,fs.meta,fs.read,fs.write,io.write,process,time} {
  if view.len(args)!=2 {return 2}
  let root:str=view.get(args,1)
  let _=files.mkdirs(root)
  var suite:test.Suite=test.suite("Locked destructive editing",false)
  var state:app.App=fixture(root,true)
  let _=test.start(suite,"Actual Delete Shift Delete retain locked clips and complete Redo")
  let initial:string=stable(state)
  let deleted:string=input.key(state,widgets.key_delete(),false,false)
  let ripple:string=input.key(state,widgets.key_delete(),false,true)
  let _=test.check(suite,text.contains(deleted,"GA_EDIT_LOCKED") and text.contains(ripple,"GA_EDIT_LOCKED"),"Both keyboard destructive paths give lock diagnostic")
  let _=test.eq_str(suite,stable(state),initial,"All document fields selection revisions dirty and every Undo Redo snapshot stay exact")
  let _=test.eq_u64(suite,array.len(struct.borrow(struct.borrow(state,field=history),field=redo)),1,"A real Redo branch remains")
  let _=test.eq_str(suite,sample(state,8),"first.mov:20","Original first source sample remains")
  let _=test.eq_str(suite,sample(state,30),"second.mov:106","Later source sample never shifts on locked Ripple")
  let _=test.done(suite)

  let _=test.start(suite,"Painted Lift Ripple locked lane removal retain all state")
  let _=ref.swap(state,fixture(root,true))
  let toolbar_before:string=stable(state)
  let lifted:string=click(state,chrome.act_lift(),0)
  let rippled:string=click(state,chrome.act_ripple(),0)
  let removed:string=click(state,chrome.act_track_remove(),5)
  let _=test.check(suite,text.contains(lifted,"GA_EDIT_LOCKED") and text.contains(rippled,"GA_EDIT_LOCKED") and text.contains(removed,"GA_EDIT_LOCKED"),"Real painted hit targets give coded lock refusal")
  let _=test.eq_str(suite,stable(state),toolbar_before,"All three mouse paths preserve every document history byte")
  let _=test.done(suite)

  let _=test.start(suite,"Shared editor independently enforces destructive locks")
  let _=ref.swap(state,fixture(root,true))
  let doc:ref<editor.Document> = struct.borrow(state,field=document)
  let shared_before:string=encoded(doc)
  let shared_lift:bool=editor.lift(doc,7)
  let shared_ripple:bool=editor.ripple_delete(doc,7)
  let shared_remove:bool=editor.remove_track(doc,5)
  let _=test.check(suite,not shared_lift and not shared_ripple and not shared_remove,"SDK directly refuses locked deletion")
  let _=test.eq_str(suite,encoded(doc),shared_before,"SDK does not mutate identities or authored tables on refusal")
  let _=test.done(suite)

  let _=test.start(suite,"Unknown targets retain complete Redo and document")
  let _=ref.swap(state,fixture(root,false))
  let missing_before:string=stable(state)
  var ml:commands.Result=commands.lift(state,999999)
  var mr:commands.Result=commands.ripple_delete(state,999999)
  var mt:commands.Result=commands.remove_track(state,999999)
  let _=test.check(suite,not ml.ok and not mr.ok and not mt.ok,"Missing target operations refuse")
  let _=test.check(suite,text.contains(ml.message,"GA_EDIT_TARGET") and text.contains(mr.message,"GA_EDIT_TARGET") and text.contains(mt.message,"GA_EDIT_TARGET"),"Unknown target has separate actionable code")
  let _=test.eq_str(suite,stable(state),missing_before,"Missing target preserves all Redo revisions and selection")
  let _=test.done(suite)

  let _=test.start(suite,"Unlocked Lift leaves authored gap and one complete Undo")
  let _=ref.swap(state,fixture(root,false))
  let lift_before:string=encoded(struct.borrow(state,field=document))
  let lifted_ok:string=click(state,chrome.act_lift(),0)
  let _=test.eq_str(suite,lifted_ok,"lifted","Unlocked painted Lift succeeds")
  let _=test.eq_u64(suite,editor.clip_count(struct.borrow(state,field=document)),2,"Only selected clip removed")
  let _=test.eq_u64(suite,array.len(struct.borrow(struct.borrow(state,field=history),field=undo)),1,"Lift creates one Undo")
  let _=test.eq_str(suite,sample(state,8),"gap","Lift leaves first interval empty")
  let _=test.eq_str(suite,sample(state,30),"second.mov:106","Later source mapping stays fixed")
  let _=commands.undo(state)
  let _=test.eq_str(suite,encoded(struct.borrow(state,field=document)),lift_before,"One Undo restores entire graph settings keys selection")
  let _=test.done(suite)

  let _=test.start(suite,"Unlocked Ripple closes only authored lane and retains source time")
  let _=ref.swap(state,fixture(root,false))
  let ripple_before:string=encoded(struct.borrow(state,field=document))
  let rippled_ok:string=input.key(state,widgets.key_delete(),false,true)
  let _=test.eq_str(suite,rippled_ok,"ripple deleted","Unlocked Shift Delete succeeds")
  let second:editor.Clip=option.unwrap(editor.clip(struct.borrow(state,field=document),8))
  let unrelated:editor.Clip=option.unwrap(editor.clip(struct.borrow(state,field=document),9))
  let _=test.check(suite,second.start==0 and second.length==36 and second.source_in==100 and unrelated.start==12,"Later clip shifts exactly24 and unrelated lane stays fixed")
  let _=test.eq_str(suite,sample(state,8),"second.mov:108","Moved window keeps authored native source sample")
  let _=test.eq_u64(suite,editor.key_count(struct.borrow(state,field=document),8,"brightness.level"),1,"Surviving key intact")
  let _=test.eq_u64(suite,array.len(struct.borrow(struct.borrow(state,field=history),field=undo)),1,"Ripple creates one Undo")
  let _=commands.undo(state)
  let _=test.eq_str(suite,encoded(struct.borrow(state,field=document)),ripple_before,"Undo restores affected and unrelated tables exactly")
  let _=test.done(suite)

  let _=test.start(suite,"Unlocked lane removal and Undo Redo retain complete graph identity")
  let _=ref.swap(state,fixture(root,false))
  let track_before:string=encoded(struct.borrow(state,field=document))
  let removed_ok:string=click(state,chrome.act_track_remove(),5)
  let _=test.eq_str(suite,removed_ok,"track removed","Unlocked painted lane removal succeeds")
  let _=test.check(suite,editor.track_count(struct.borrow(state,field=document))==1 and editor.clip_count(struct.borrow(state,field=document))==1,"Only requested lane and its clips removed")
  let track_after:string=encoded(struct.borrow(state,field=document))
  let _=test.eq_u64(suite,array.len(struct.borrow(struct.borrow(state,field=history),field=undo)),1,"Removal creates one Undo")
  let _=commands.undo(state)
  let _=test.eq_str(suite,encoded(struct.borrow(state,field=document)),track_before,"Undo restores removed clip filter text key and lane")
  let _=commands.redo(state)
  let _=test.eq_str(suite,encoded(struct.borrow(state,field=document)),track_after,"Redo restores exact accepted removal")
  let _=test.done(suite)
  test.conclude(suite,path.join(root,"editing-safety-tests.json"),7)
}
