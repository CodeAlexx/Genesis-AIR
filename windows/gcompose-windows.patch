+static void canvas_zero_globals(void){FpxCanvas empty={0};canvas_restore(&empty);}
+static int canvas_make_room(uint64_t extra){
+  if(g_canvas_active>=0&&g_ready)canvas_capture(&g_canvases[g_canvas_active]);
+  for(;;){
+    uint64_t bytes=g_external_bytes+g_snapshot_bytes+(g_snapshot_status?sizeof(cl_int):0);int victim=-1;
+    for(int i=0;i<FPX_CANVAS_COUNT;i++){
+      bytes+=g_canvases[i].bytes;
+      if(i!=g_canvas_active&&g_canvases[i].g_ready&&
+         (victim<0||g_canvases[i].age<g_canvases[victim].age))victim=i;
+    }
+    if(extra<=FPX_CANVAS_BYTES_LIMIT&&bytes<=FPX_CANVAS_BYTES_LIMIT-extra)return 0;
+    if(victim<0)return -2;
+    canvas_release(&g_canvases[victim]);
+  }
+}
+int fpx_gpu_external_reserve(uint64_t bytes){
+ if(!bytes||bytes>FPX_CANVAS_BYTES_LIMIT||!g_ready||canvas_make_room(bytes)!=0)return -2;
+ g_external_bytes+=bytes;return 0;
+}
+void fpx_gpu_external_release(uint64_t bytes){if(bytes<=g_external_bytes)g_external_bytes-=bytes;}
+uint64_t fpx_gpu_external_bytes(void){return g_external_bytes;}
+static void canvas_initial_ready(void){
