-"__kernel void k_vignette(__global float* d,float amt,float softness){\n"
-"  int x=get_global_id(0),y=get_global_id(1); if(x>=VW||y>=VH) return; int i=IDX(x,y);\n"
-"  float cx=(float)VW*0.5f, cy=(float)VH*0.5f;\n"
