+fn nest_phase_resampler_delta(node:&NestNode,nodes:&[NestNode])->i64 {
+    if let Some(phase)=&node.phase {return phase.resampler_delta;}
+    if node.tail && matches!(node.input,NestInput::Bus{..}) {
+        return nodes.iter().find(|child|child.parent==node.id).and_then(|child|child.phase.as_ref()).map_or(0,|phase|phase.resampler_delta);
+    }
+    0
+}
+fn nest_phase_extra(node:&NestNode,nodes:&[NestNode])->i64 {
+    nest_phase_body(node,nodes).map_or(0,|body|(body as i64-(node.end-node.start)).max(0))+nest_phase_resampler_delta(node,nodes).max(0)
