-impl Encoder {
-    /// Allocate the output container for `url` (e.g. "/tmp/out.mp4"). None on failure.
-    pub fn open(url: &str) -> Option<Encoder> {
-        let c = CString::new(url).ok()?;
-        let h = unsafe { fpx_enc_open(c.as_ptr()) };
-        if h.is_null() {
-            None
-        } else {
-            Some(Encoder { h, in_w: 0, in_h: 0 })
-        }
-    }
