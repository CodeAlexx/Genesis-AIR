+void* fpx_open(const char* path) {
+    FpxCtx* c = (FpxCtx*)calloc(1, sizeof(FpxCtx));
+    if (!c) return NULL;
+    if (avformat_open_input(&c->fmt, path, NULL, NULL) < 0) { free(c); return NULL; }
+    if (avformat_find_stream_info(c->fmt, NULL) < 0) { avformat_close_input(&c->fmt); free(c); return NULL; }
+    const AVCodec* codec = NULL;
+    int idx = av_find_best_stream(c->fmt, AVMEDIA_TYPE_VIDEO, -1, -1, &codec, 0);
+    if (idx < 0 || !codec) { avformat_close_input(&c->fmt); free(c); return NULL; }
+    c->vindex = idx;
+    AVStream* st = c->fmt->streams[idx];
+    c->dec = avcodec_alloc_context3(codec);
+    if (!c->dec) { avformat_close_input(&c->fmt); free(c); return NULL; }
+    avcodec_parameters_to_context(c->dec, st->codecpar);
+#ifdef _WIN32
+    // FFmpeg's native AV1 decoder exposes D3D11; libdav1d is the software fallback.
+    const AVCodec* hardware = codec->id == AV_CODEC_ID_AV1 ? avcodec_find_decoder_by_name("av1") : codec;
+    const char* requested_backend = getenv("GENESIS_VIDEO_BACKEND");
+    if (requested_backend && strcmp(requested_backend, "auto") && strcmp(requested_backend, "d3d11") &&
+        strcmp(requested_backend, "vulkan") && strcmp(requested_backend, "software")) {
+        fprintf(stderr, "[GA_VIDEO_BACKEND] Unknown backend; use auto, d3d11, vulkan or software\n");
+        avcodec_free_context(&c->dec); avformat_close_input(&c->fmt); free(c); return NULL;
+    }
+    if (!getenv("GENESIS_SOFTWARE_DECODE") && (!requested_backend || strcmp(requested_backend, "software")) && hardware) {
+        for (int i = 0; ; ++i) {
+            const AVCodecHWConfig* config = avcodec_get_hw_config(hardware, i);
+            if (!config) break;
+            enum AVHWDeviceType backend = requested_backend && !strcmp(requested_backend, "vulkan") ? AV_HWDEVICE_TYPE_VULKAN : AV_HWDEVICE_TYPE_D3D11VA;
+            if (config->device_type != backend ||
+                !(config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX)) continue;
+            AVBufferRef* device = NULL;
+            int device_result = av_hwdevice_ctx_create(&device, backend, NULL, NULL, 0);
+            if (device_result >= 0) {
+                avcodec_free_context(&c->dec);
+                c->dec = avcodec_alloc_context3(hardware);
+                if (!c->dec) { av_buffer_unref(&device); avformat_close_input(&c->fmt); free(c); return NULL; }
+                avcodec_parameters_to_context(c->dec, st->codecpar);
+                c->hw_format = backend == AV_HWDEVICE_TYPE_VULKAN ? AV_PIX_FMT_VULKAN : AV_PIX_FMT_D3D11;
+                c->dec->opaque = c;
+                c->dec->hw_device_ctx = device;
+                c->dec->get_format = fpx_hw_format;
+                if (avcodec_open2(c->dec, hardware, NULL) >= 0) {
+                    fprintf(stderr, "[gcompose] Native %s decode: %s\n", backend == AV_HWDEVICE_TYPE_VULKAN ? "Vulkan" : "D3D11", hardware->name);
+                    goto decoder_open;
+                }
+                avcodec_free_context(&c->dec);
+                c->dec = avcodec_alloc_context3(codec);
+                if (!c->dec) { avformat_close_input(&c->fmt); free(c); return NULL; }
+                avcodec_parameters_to_context(c->dec, st->codecpar);
+            }
+            break;
+        }
+    }
+#endif
+    if (avcodec_open2(c->dec, codec, NULL) < 0) { avcodec_free_context(&c->dec); avformat_close_input(&c->fmt); free(c); return NULL; }
+decoder_open:
+    c->cpu_format = AV_PIX_FMT_NONE;
+    c->width = c->dec->width;
+    c->height = c->dec->height;
+    c->time_base = st->time_base;
+    c->frame_rate = av_guess_frame_rate(c->fmt, st, NULL);
+    // SWS_BICUBIC like FramePFX; at native size this is pure pixel-format conversion (YUV->RGBA).
+    c->sws = NULL;
+    c->pkt = av_packet_alloc();
+    c->frame = av_frame_alloc();
+    return c;
+}
