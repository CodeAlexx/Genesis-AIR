+int fpx_gpu_canvas(int width,int height,int compound){
+  if(width<16||height<16||width>8192||height>8192||
+     (uint64_t)width*height>16777216||(compound!=0&&compound!=1)||!g_ready)return -1;
+  if(clFinish(g_q)!=CL_SUCCESS)return -3;
+  canvas_capture(&g_canvases[g_canvas_active]);
+  if(width==GVW&&height==GVH){g_compound=compound;g_canvases[g_canvas_active].age=++g_canvas_age;return 0;}
+  for(int i=0;i<FPX_CANVAS_COUNT;i++)if(g_canvases[i].g_ready&&g_canvases[i].width==width&&g_canvases[i].height==height){
+    canvas_restore(&g_canvases[i]);g_canvas_active=i;g_compound=compound;g_canvases[i].age=++g_canvas_age;return 0;
+  }
+  if(canvas_make_room(canvas_bytes(width,height,0))!=0)return -2;
+  int next=-1;for(int i=0;i<FPX_CANVAS_COUNT;i++)if(!g_canvases[i].g_ready){next=i;break;}
+  if(next<0){
+    for(int i=0;i<FPX_CANVAS_COUNT;i++)if(i!=g_canvas_active&&(next<0||g_canvases[i].age<g_canvases[next].age))next=i;
+    canvas_release(&g_canvases[next]);
+  }
+  int prior=g_canvas_active,old_mode=g_compound;
+  canvas_zero_globals();genesis_width=width;genesis_height=height;g_canvas_building=1;
+  int rc=fpx_gpu_init();g_canvas_building=0;
+  if(rc!=0){canvas_restore(&g_canvases[prior]);g_compound=old_mode;return rc;}
+  canvas_capture(&g_canvases[next]);g_canvases[next].age=++g_canvas_age;
+  g_canvas_active=next;g_compound=compound;return 0;
+}
