+                }else if !matches!(kind,"volume"|"pan"|"stereotools"|"equalizer"|"acompressor"|"agate"|"alimiter"|"anull"|"-") {return Err(bad());}
+            }
+            if (product-rate).abs()>1e-9 || (c.duration*PROG_SR as f64/rate-c.processing as f64).abs()>2.0 {return Err(bad());}
+        }
+        if context.as_ref().is_some_and(|c|c.processing!=c.frames) && native_eof.is_none() {return Err(nest_error("GA_AUDIO_CONTEXT_EOF", "Explicit nested extent needs native EOF capability"));}
