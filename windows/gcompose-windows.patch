+// position equals the static stage that follows reverse/tempo.
+fn apply_pan_balance(frame: &mut [f32], balance: f32) {
+    frame[0] *= 1.0 - balance.max(0.0);
+    frame[1] *= 1.0 + balance.min(0.0);
+}
+// Only keyed fades use absolute rounded timeline sample positions. Legacy
+// scalar fades keep their original range_local_s arithmetic byte-for-byte.
+struct ClipFadeKeys {
+    origin: i64, clip_origin: i64, fps: f64,
+    fade_in: Option<ClipGainKeys>, fade_out: Option<ClipGainKeys>,
+}
+impl ClipFadeKeys {
+    fn parse(token: &str) -> Option<Self> {
+        let fields: Vec<_> = token.strip_prefix("FADEKEYS:")?.split(':').collect();
+        if fields.len() != 5 { return None; }
+        let origin = fields[0].parse::<i64>().ok()?;
+        let clip_start = fields[1].parse::<i64>().ok()?;
+        let fps = fields[2].parse::<f64>().ok()?;
+        if !(0..=9007199254740991).contains(&origin)
+            || !(0..=9007199254740991).contains(&clip_start)
+            || !fps.is_finite() || fps <= 0.0
+            || !(f32::MAX as f64 / fps).is_finite() { return None; }
+        let clip_origin = (clip_start as f64 * PROG_SR as f64 / fps + 0.5).floor();
+        if !clip_origin.is_finite() || !(0.0..=9007199254740991.0).contains(&clip_origin) { return None; }
+        let fade_in = if fields[3] == "-" { None }
+            else { Some(ClipGainKeys::parse_points(origin, fields[3], true)?) };
+        let fade_out = if fields[4] == "-" { None }
+            else { Some(ClipGainKeys::parse_points(origin, fields[4], true)?) };
+        if fade_in.is_none() && fade_out.is_none() { return None; }
+        Some(Self { origin, clip_origin: clip_origin as i64, fps, fade_in, fade_out })
+    }
+    fn accepts_frames(&self, frames: usize) -> bool {
+        frames != 0 && i64::try_from(frames - 1).ok()
+            .and_then(|last| self.origin.checked_add(last))
+            .is_some_and(|last| last <= 9007199254740991)
+    }
+    fn local_time(&self, offset: usize) -> f64 {
+        // accepts_frames runs BEFORE opening or advancing any decoder. The
+        // subtraction stays exact in integer space even for distant timelines.
+        (self.origin + offset as i64 - self.clip_origin) as f64 / PROG_SR as f64
+    }
+    fn lengths(&self, offset: usize, scalar_in: f64, scalar_out: f64) -> (f64, f64) {
+        (self.fade_in.as_ref().map_or(scalar_in, |keys| keys.at_value(offset).max(0.0) / self.fps),
+         self.fade_out.as_ref().map_or(scalar_out, |keys| keys.at_value(offset).max(0.0) / self.fps))
+    }
+}
