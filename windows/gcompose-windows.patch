+static enum AVPixelFormat fpx_hw_format(AVCodecContext* dec, const enum AVPixelFormat* formats) {
+    FpxCtx* c = (FpxCtx*)dec->opaque;
+    for (const enum AVPixelFormat* p = formats; *p != AV_PIX_FMT_NONE; ++p)
+        if (c && *p == c->hw_format) return *p;
+    for (const enum AVPixelFormat* p = formats; *p != AV_PIX_FMT_NONE; ++p) {
+        const AVPixFmtDescriptor* desc = av_pix_fmt_desc_get(*p);
+        if (desc && !(desc->flags & AV_PIX_FMT_FLAG_HWACCEL)) return *p;
+    }
+    return AV_PIX_FMT_NONE;
+}
+
+// Inspect native timestamps before transferring pixels. The letterbox/float
+// path drops pictures before the requested time while they are still on the GPU.
+// Preserve stream color metadata for the selected picture's float color path.
+static int fpx_pull(FpxCtx* c, AVFrame* frame) {
+    int result = avcodec_receive_frame(c->dec, frame);
+    if (result < 0) return result;
+    const AVCodecParameters* metadata = c->fmt->streams[c->vindex]->codecpar;
+    if (frame->color_primaries == AVCOL_PRI_UNSPECIFIED) frame->color_primaries = metadata->color_primaries;
+    if (frame->color_trc == AVCOL_TRC_UNSPECIFIED) frame->color_trc = metadata->color_trc;
+    if (frame->colorspace == AVCOL_SPC_UNSPECIFIED) frame->colorspace = metadata->color_space;
+    if (frame->color_range == AVCOL_RANGE_UNSPECIFIED) frame->color_range = metadata->color_range;
+    return 0;
+}
+static int fpx_cpu_frame(FpxCtx* c) {
+    int64_t started = av_gettime_relative();
+    int result = 0;
+    const AVPixFmtDescriptor* format = av_pix_fmt_desc_get(c->frame->format);
+    if (format && (format->flags & AV_PIX_FMT_FLAG_HWACCEL)) {
+        if (!c->hw_transfer) c->hw_transfer = av_frame_alloc();
+        if (!c->hw_transfer) return AVERROR(ENOMEM);
+        int fast = 0;
+#ifdef _WIN32
+        if (c->frame->format == AV_PIX_FMT_D3D11 && !c->transfer_failed && !getenv("GENESIS_DEFAULT_TRANSFER")) {
+            result = fpx_d3d11_transfer(c);
+            if (result >= 0) fast = 1;
+            else { c->transfer_failed = 1; fpx_transfer_clear(c);
+                fprintf(stderr, "[GA_VIDEO_TRANSFER] Fast D3D11 read failed (%d), using the default transfer\n", result); }
+        }
+#endif
+        if (!fast) {
+            av_frame_unref(c->hw_transfer);
+            result = av_hwframe_transfer_data(c->hw_transfer, c->frame, 0);
+            if (result >= 0) result = av_frame_copy_props(c->hw_transfer, c->frame);
+        }
+        if (result < 0) return result;
+        av_frame_unref(c->frame);
+        av_frame_move_ref(c->frame, c->hw_transfer);
+    }
+    if (getenv("GENESIS_MEDIA_PROFILE")) fprintf(stderr, "[gcompose] decode transfer_us=%lld\n",
+        (long long)(av_gettime_relative()-started));
+    if (c->cpu_format != c->frame->format) {
+        c->cpu_format = c->frame->format;
+        if (c->sws) sws_freeContext(c->sws);
+        c->sws = sws_getContext(c->width, c->height, c->cpu_format,
+            c->width, c->height, AV_PIX_FMT_RGBA, SWS_BICUBIC, NULL, NULL, NULL);
+        if (c->sws2) sws_freeContext(c->sws2);
+        c->sws2 = c->sw > 0 && c->sh > 0 ? sws_getContext(c->width, c->height,
+            c->cpu_format, c->sw, c->sh, AV_PIX_FMT_RGBA, SWS_BICUBIC, NULL, NULL, NULL) : NULL;
+        if (c->sws_lb) sws_freeContext(c->sws_lb);
+        c->sws_lb = NULL;
+    }
+    return 0;
+}
+
+static int fpx_receive(FpxCtx* c) {
+    int result = fpx_pull(c, c->frame);
+    return result < 0 ? result : fpx_cpu_frame(c);
+}
