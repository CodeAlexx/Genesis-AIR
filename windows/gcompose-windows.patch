+
+// D3D11 staging memory can be uncached/write-combined. The public libavutil
+// copy primitive dispatches suitable CPU reads while preserving every byte.
+// Cache the staging resource and reuse aligned AVFrame backing buffers.
+static int fpx_d3d11_prepare(FpxCtx* c) {
+    AVFrame* input = c->frame;
+    if (input->format != AV_PIX_FMT_D3D11 || !input->hw_frames_ctx) return AVERROR(ENOSYS);
+    AVHWFramesContext* frames = (AVHWFramesContext*)input->hw_frames_ctx->data;
+    AVD3D11VADeviceContext* device = (AVD3D11VADeviceContext*)frames->device_ctx->hwctx;
+    ID3D11Texture2D* texture = (ID3D11Texture2D*)input->data[0];
+    D3D11_TEXTURE2D_DESC desc;
+    if (!texture || !device || !device->device_context) return AVERROR(EINVAL);
+    ID3D11Texture2D_GetDesc(texture, &desc);
+    // Only the tested semiplanar decode layouts use this path. FFmpeg owns
+    // other formats, including opaque decoder surfaces.
+    if ((frames->sw_format != AV_PIX_FMT_NV12 && frames->sw_format != AV_PIX_FMT_P010LE) ||
+        desc.Width > INT_MAX || desc.Height > INT_MAX || input->width > (int)desc.Width ||
+        input->height > (int)desc.Height) return AVERROR(ENOSYS);
+    if (c->staging_frames && (c->staging_frames->data != input->hw_frames_ctx->data ||
+        c->transfer_width != input->width || c->transfer_height != input->height)) fpx_transfer_clear(c);
+    if (!c->staging) {
+        int size = av_image_get_buffer_size(frames->sw_format, input->width, input->height, 64);
+        if (size < 1 || size > INT_MAX - 64) return AVERROR(EINVAL);
+        D3D11_TEXTURE2D_DESC staging = desc;
+        staging.ArraySize = 1; staging.MipLevels = 1;
+        staging.Usage = D3D11_USAGE_STAGING; staging.BindFlags = 0;
+        staging.CPUAccessFlags = D3D11_CPU_ACCESS_READ; staging.MiscFlags = 0;
+        if (FAILED(ID3D11Device_CreateTexture2D(device->device, &staging, NULL, &c->staging))) return AVERROR(EIO);
+        c->staging_frames = av_buffer_ref(input->hw_frames_ctx);
+        c->transfer_pool = av_buffer_pool_init(size + 64, NULL);
+        if (!c->staging_frames || !c->transfer_pool) { fpx_transfer_clear(c); return AVERROR(ENOMEM); }
+        c->transfer_width = input->width; c->transfer_height = input->height;
+    }
+    if (device->lock) device->lock(device->lock_ctx);
+    ID3D11DeviceContext_CopySubresourceRegion(device->device_context, (ID3D11Resource*)c->staging,
+        0, 0, 0, 0, (ID3D11Resource*)texture, (UINT)(uintptr_t)input->data[1], NULL);
+    if (device->unlock) device->unlock(device->lock_ctx);
+    return 0;
+}
+
+static int fpx_d3d11_transfer(FpxCtx* c) {
+    int prepared = fpx_d3d11_prepare(c);
+    if (prepared < 0) return prepared;
+    AVFrame* input = c->frame;
+    AVHWFramesContext* frames = (AVHWFramesContext*)input->hw_frames_ctx->data;
+    AVD3D11VADeviceContext* device = (AVD3D11VADeviceContext*)frames->device_ctx->hwctx;
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D_GetDesc(c->staging, &desc);
+    AVFrame* output = c->hw_transfer;
+    av_frame_unref(output);
+    output->format = frames->sw_format; output->width = input->width; output->height = input->height;
+    output->buf[0] = av_buffer_pool_get(c->transfer_pool);
+    if (!output->buf[0]) return AVERROR(ENOMEM);
+    uint8_t* aligned = (uint8_t*)(((uintptr_t)output->buf[0]->data + 63) & ~(uintptr_t)63);
+    if (av_image_fill_arrays(output->data, output->linesize, aligned, frames->sw_format,
+        input->width, input->height, 64) < 0) return AVERROR(EINVAL);
+    D3D11_MAPPED_SUBRESOURCE map;
+    int result = 0;
+    int64_t started = av_gettime_relative();
+    if (device->lock) device->lock(device->lock_ctx);
+    HRESULT mapped = ID3D11DeviceContext_Map(device->device_context, (ID3D11Resource*)c->staging,
+        0, D3D11_MAP_READ, 0, &map);
+    int64_t ready = av_gettime_relative();
+    if (FAILED(mapped)) result = AVERROR(EIO);
+    else {
+        uint8_t* source[4] = {0};
+        int pitch[4] = {(int)map.RowPitch, (int)map.RowPitch, (int)map.RowPitch, (int)map.RowPitch};
+        // The chroma plane starts after the texture's padded height, rather
+        // than the visible picture height (e.g. 1088 versus 1080).
+        int minimum_pitch[4];
+        result = av_image_fill_linesizes(minimum_pitch, frames->sw_format, input->width);
+        if (result >= 0 && (map.RowPitch > INT_MAX || (int)map.RowPitch < minimum_pitch[0] ||
+            (int)map.RowPitch < minimum_pitch[1])) result = AVERROR(EINVAL);
+        if (result >= 0) result = av_image_fill_pointers(source, frames->sw_format, desc.Height, map.pData, pitch);
+        if (result >= 0) {
+            ptrdiff_t dst_pitch[4], src_pitch[4];
+            for (int i=0; i<4; ++i) {dst_pitch[i]=output->linesize[i]; src_pitch[i]=pitch[i];}
+            av_image_copy_uc_from(output->data, dst_pitch, (const uint8_t* const*)source, src_pitch,
+                frames->sw_format, input->width, input->height);
+            result = 0;
+        }
+        ID3D11DeviceContext_Unmap(device->device_context, (ID3D11Resource*)c->staging, 0);
+    }
+    if (device->unlock) device->unlock(device->lock_ctx);
+    if (getenv("GENESIS_MEDIA_PROFILE")) fprintf(stderr, "[gcompose] staging wait_us=%lld copy_us=%lld\n",
+        (long long)(ready-started), (long long)(av_gettime_relative()-ready));
+    if (result < 0) return result;
+    return av_frame_copy_props(output, input);
+}
+#endif
