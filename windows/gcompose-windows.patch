+        }
+        if let Some((rate,_))=native_eof {
+            let bad=||nest_error("GA_AUDIO_CONTEXT_EOF", "Native EOF needs its complete forward original graph");
+            let c=context.as_ref().ok_or_else(bad)?;
+            if envelope.fade_keys.is_some() || c.crop.checked_add(frames as usize).is_none_or(|end| end<c.processing || end>c.processing+1) {return Err(bad());}
+            let mut product=1.0f64;
