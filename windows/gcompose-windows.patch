+  if((e=clSetKernelArg(k,2,sizeof(cl_mem),&g_buf[TRANS]))!=CL_SUCCESS)return e;
+  if((e=clSetKernelArg(k,3,sizeof(cl_mem),&g_buf[OUTB]))!=CL_SUCCESS)return e;
+  if((e=clSetKernelArg(k,4,sizeof(int),&kind))!=CL_SUCCESS)return e;
+  if((e=clSetKernelArg(k,5,sizeof(float),&t))!=CL_SUCCESS)return e;
