+fn nest_write_samples(file: &mut std::fs::File, samples: &[f32]) -> Result<(), String> {
+    // Raw float serialization intentionally has NO final_audio_sample mapping.
+    let mut bytes = Vec::new(); bytes.try_reserve_exact(samples.len() * 4).map_err(|_| nest_capacity("Cannot reserve float block bytes"))?;
+    for value in samples {
+        if !value.is_finite() { return Err(nest_render("Nonfinite nested audio sample")); }
+        bytes.extend_from_slice(&value.to_le_bytes());
+    }
+    file.write_all(&bytes).map_err(|_| nest_cache("Cannot write float cache block"))
+}
+fn nest_read_samples(file: &mut std::fs::File, offset: i64, frames: usize) -> Result<Vec<f32>, String> {
+    use std::io::{Read, Seek, SeekFrom};
+    file.seek(SeekFrom::Start(NEST_HEADER + offset as u64 * 8)).map_err(|_| nest_cache("Cannot seek float cache"))?;
+    let mut bytes = Vec::new(); bytes.try_reserve_exact(frames * 8).map_err(|_| nest_capacity("Cannot reserve float read block"))?;
+    bytes.resize(frames * 8, 0);
+    file.read_exact(&mut bytes).map_err(|_| nest_cache("Incomplete float cache block"))?;
+    let mut out = Vec::new(); out.try_reserve_exact(frames * 2).map_err(|_| nest_capacity("Cannot reserve float samples"))?;
+    for value in bytes.chunks_exact(4) {
+        let value = f32::from_le_bytes(value.try_into().unwrap());
+        if !value.is_finite() { return Err(nest_cache("Nonfinite float cache sample")); }
+        out.push(value);
+    }
+    Ok(out)
