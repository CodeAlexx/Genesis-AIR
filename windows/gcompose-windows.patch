+#ifdef _WIN32
+static void fpx_transfer_clear(FpxCtx* c) {
+    if (c->staging) ID3D11Texture2D_Release(c->staging);
+    c->staging = NULL;
+    av_buffer_unref(&c->staging_frames);
+    av_buffer_pool_uninit(&c->transfer_pool);
