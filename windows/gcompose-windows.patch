+                let native=fields[2].parse::<i32>().map_err(|_|bad())?;
+                if !leaf || !rate.is_finite() || !(0.05..=16.0).contains(&rate) || !matches!(native,44100|48000) {return Err(bad());}
+                native_eof=Some((rate,native));tail=true;
+            } else if token.starts_with("AUDIOPHASE:") {
+                if phase_token.is_some() {return Err(nest_error("GA_AUDIO_PHASE", "Duplicate original phase metadata"));}
+                phase_token=Some(*token);
+            } else if token.starts_with("AUDIOCTX:") {
+                if context.is_some() { return Err(nest_error("GA_AUDIO_CONTEXT", "Duplicate full-DSP sample context")); }
+                context = Some(NestAudioContext::parse(token, frames as usize)?);
+            } else if token.starts_with("AUDIOCTX2:") {
+                if context.is_some() {return Err(nest_error("GA_AUDIO_CONTEXT", "Duplicate explicit DSP extent"));}
+                context=Some(NestAudioContext::parse2(token,frames as usize)?);
+            } else { envelope_fields.push(token); }
+        }
+        if !leaf && context.as_ref().is_some_and(|value| value.source != 0.0 ||
+            !matches!(input, NestInput::Bus { begin, end } if value.duration == (end-begin) as f64 / PROG_SR as f64)) {
+            return Err(nest_error("GA_AUDIO_CONTEXT", "Bus DSP context must use its complete child-sum span"));
+        }
+        let phase=match phase_token {
+            Some(token)=>{
+                if !leaf || !tail || context.is_none() {return Err(nest_error("GA_AUDIO_PHASE", "Original phase requires a retained-tail direct leaf"));}
+                Some(NestAudioPhase::parse(token,context.as_ref().unwrap(),start,end)?)
+            },None=>None,
+        };
+        let envelope = NestEnvelope::parse(&envelope_fields, start, frames as usize)?;
+        if native_eof.is_some() && phase.is_some() {return Err(nest_error("GA_AUDIO_CONTEXT_EOF", "Conflicting EOF and phase contracts"));}
+        if tail && leaf && native_eof.is_none() && ((phase.is_none() && context.as_ref().is_none_or(|c| c.crop.checked_add(frames as usize) != Some(c.frames))) ||
+            envelope.fade_keys.is_some() || chain.split(',').any(|stage| !matches!(stage.split('=').next().unwrap_or(""),
