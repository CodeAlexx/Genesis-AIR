+impl NestedAudio {
+    fn begin(&mut self, line: &str) -> Result<(), String> {
+        let f: Vec<_> = line.split_whitespace().collect();
+        if f.len() != 2 || f[1] == "-" { return Err(nest_protocol("Nested cache directory is required")); }
+        let directory = std::path::PathBuf::from(dec_path(f[1]));
+        if let Some(owned) = &self.directory {
+            if owned != &directory { return Err(nest_cache("Nested cache directory changed within one worker session")); }
+        } else {
+            let metadata = std::fs::symlink_metadata(&directory).map_err(|_| nest_cache("Caller must reserve an exclusive empty directory"))?;
