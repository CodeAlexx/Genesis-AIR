+static int fpx_au_reverse_feed(FpxAudioStream* s) {
+    if (s->reverse_input_ended) return -1;
+    if (s->reverse_remaining == 0) {
+        s->reverse_input_ended = 1;
+        return av_buffersrc_add_frame(s->feed, NULL);
+    }
+    const int count = s->reverse_remaining > 96000 ? 96000 : (int)s->reverse_remaining;
+    const int64_t begin = s->reverse_remaining - count;
+    FpxAudioStream* part = fpx_au_stream_open_range(s->reverse_path,
+        s->reverse_start + (double)begin / 48000.0, (double)count / 48000.0, "-",
+        s->reverse_start, s->reverse_end);
+    if (!part) return -2;
+    AVFrame* input = av_frame_alloc();
+    if (!input) { fpx_au_stream_close(part); return -3; }
+    input->format = AV_SAMPLE_FMT_FLT;
+    input->sample_rate = 48000;
+    input->nb_samples = count;
+    input->pts = s->reverse_fed;
+    av_channel_layout_default(&input->ch_layout, 2);
+    int rc = av_frame_get_buffer(input, 0);
+    if (rc >= 0) {
+        float* pcm = (float*)input->data[0];
+        memset(pcm, 0, (size_t)count * 2 * sizeof(float));
+        int got = fpx_au_stream_read(part, pcm, count);
+        if (got < 0) rc = got;
+        else {
+            for (int at = 0; at < count / 2; ++at) {
+                for (int ch = 0; ch < 2; ++ch) {
+                    float value = pcm[at * 2 + ch];
+                    pcm[at * 2 + ch] = pcm[(count - at - 1) * 2 + ch];
+                    pcm[(count - at - 1) * 2 + ch] = value;
+                }
+            }
+            rc = av_buffersrc_add_frame(s->feed, input);
+        }
+    }
+    av_frame_free(&input);
+    fpx_au_stream_close(part);
+    if (rc >= 0) {
+        s->reverse_remaining = begin;
+        s->reverse_fed += count;
+    }
+    return rc;
+}
