-  if(!g_ready||!lut||nfloats<=0||nfloats>MAXLUTF) return -1; // CL_TRUE: transient host buffer.
-  return clEnqueueWriteBuffer(g_q,g_lut,CL_TRUE,0,nfloats*sizeof(float),lut,0,NULL,NULL)==CL_SUCCESS?0:-2;
-}
