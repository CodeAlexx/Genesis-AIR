+// Playback owns one decoder/resampler/filter graph per audible clip. Pulling the
+// next device block must not flush/recreate it: filters and resampling retain history.
+typedef struct {
+    AVFilterGraph* graph;
+    AVFilterContext* sink;
+    AVFilterContext* feed;
+    AVFrame* frame;
+    char* reverse_path;
+    double reverse_start;
+    double reverse_end;
+    int64_t reverse_remaining;
+    int64_t reverse_fed;
+    int reverse_input_ended;
+    int native_rate;
+    int offset;
+    int ended;
+} FpxAudioStream;
+
+void fpx_au_stream_close(void* handle) {
+    FpxAudioStream* s = (FpxAudioStream*)handle;
+    if (!s) return;
+    av_frame_free(&s->frame);
+    avfilter_graph_free(&s->graph);
+    av_free(s->reverse_path);
+    av_free(s);
+}
+
+static int fpx_au_stream_connect(FpxAudioStream* s, AVFilterContext* source, const char* full) {
+    AVFilterInOut* outputs = avfilter_inout_alloc();
+    AVFilterInOut* inputs = avfilter_inout_alloc();
+    if (!outputs || !inputs) {
+        avfilter_inout_free(&outputs); avfilter_inout_free(&inputs); return -1;
+    }
+    outputs->name = av_strdup("in"); outputs->filter_ctx = source; outputs->pad_idx = 0;
+    inputs->name = av_strdup("out"); inputs->filter_ctx = s->sink; inputs->pad_idx = 0;
+    int rc = avfilter_graph_parse_ptr(s->graph, full, &inputs, &outputs, NULL);
+    avfilter_inout_free(&inputs); avfilter_inout_free(&outputs);
+    return rc < 0 ? rc : avfilter_graph_config(s->graph, NULL);
+}
+
+// Establish the sample origin from the first decoded frame, including codec
+// skip-sample/edit-list handling. Later packet timestamps are deliberately not
+// used for sample selection. Shared by the streaming and alignment decoders.
+int fpx_au_source_origin(const char* path, int* rate, int64_t* origin) {
+    AVFormatContext* format = NULL;
+    AVCodecContext* decoder = NULL;
+    AVPacket* packet = NULL;
+    AVFrame* frame = NULL;
+    int result = -1;
+    if (!path || !rate || !origin || avformat_open_input(&format, path, NULL, NULL) < 0) goto done;
+    if (avformat_find_stream_info(format, NULL) < 0) goto done;
+    const AVCodec* codec = NULL;
+    int index = av_find_best_stream(format, AVMEDIA_TYPE_AUDIO, -1, -1, &codec, 0);
+    if (index < 0) { result = 0; goto done; }
+    decoder = avcodec_alloc_context3(codec);
+    packet = av_packet_alloc(); frame = av_frame_alloc();
+    if (!decoder || !packet || !frame ||
+        avcodec_parameters_to_context(decoder, format->streams[index]->codecpar) < 0) goto done;
+    decoder->pkt_timebase = format->streams[index]->time_base;
+    decoder->thread_count = 1;
+    if (avcodec_open2(decoder, codec, NULL) < 0) goto done;
+    int input_ended = 0;
+    for (;;) {
+        int rc = avcodec_receive_frame(decoder, frame);
+        if (rc >= 0) {
+            int native_rate = frame->sample_rate;
+            int64_t pts = frame->best_effort_timestamp;
+            if (pts == AV_NOPTS_VALUE) pts = frame->pts;
+            if (native_rate <= 0 || pts == AV_NOPTS_VALUE) { av_log(NULL, AV_LOG_ERROR, "[GA_AUDIO_SOURCE_ORIGIN] Cannot establish the first decoded sample timestamp\n"); goto done; }
+            int64_t first = av_rescale_q(pts, decoder->pkt_timebase, (AVRational){1, native_rate});
+            if (first == INT64_MIN || first == INT64_MAX) { av_log(NULL, AV_LOG_ERROR, "[GA_AUDIO_SOURCE_ORIGIN] Decoded sample origin exceeds supported range\n"); goto done; }
