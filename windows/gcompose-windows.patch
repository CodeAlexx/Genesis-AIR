-        &self,
-        op: f32,
-        px: f32,
-        py: f32,
-        pw: f32,
-        ph: f32,
-        bright: f32,
-        contrast: f32,
-        sat: f32,
-        look_kind: i32,
-        look_amt: f32,
-        lut_n: i32,
-    ) -> (Vec<f32>, bool) {
-        let mut out = vec![0f32; GVW * GVH * 4];
-        let fin = unsafe {
-            fpx_gpu_track1(-1, 0.0, 4.0); // no transition: copy base (slot 0)
