-// Build .so:  cc -O2 -fPIC -shared fpx_decode.c $(pkg-config --cflags --libs \
-//                 libavformat libavcodec libswscale libavutil) -o libfpxdecode.so
-// Build test: cc -DFPX_TEST -O2 fpx_decode.c $(pkg-config --cflags --libs \
