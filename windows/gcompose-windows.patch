-        return Some(samples.to_vec()); // nothing to filter; pass through.
-    }
-    let ch_us = ch as usize;
-    let nb = samples.len() / ch_us; // samples-per-channel
-    if nb == 0 {
-        return Some(samples.to_vec());
-    }
-    let c = CString::new(chain).ok()?;
