+struct NestPeaks { frames: u64, position: u64, bucket: usize, bucket_end: u64, values: Vec<f32> }
+impl NestPeaks {
+    fn new(frames: u64, buckets: usize) -> Result<Self, String> {
+        if frames == 0 || frames > NEST_MAX_FRAMES as u64 || buckets == 0 || buckets > 65536 {
+            return Err(nest_error("GA_AUDIO_NESTED_ENV", "Invalid envelope frame or bucket count"));
+        }
+        let mut values = Vec::new();
+        values.try_reserve_exact(buckets).map_err(|_| nest_capacity("Cannot reserve bounded envelope peaks"))?;
+        values.resize(buckets, 0.0f32);
+        Ok(Self { frames, position: 0, bucket: 0, bucket_end: frames / buckets as u64, values })
+    }
+    fn push(&mut self, samples: &[f32]) -> Result<(), String> {
+        if samples.len() % 2 != 0 || samples.len() as u64 / 2 > self.frames-self.position {
+            return Err(nest_cache("Envelope input exceeds its exact sample domain"));
+        }
+        for stereo in samples.chunks_exact(2) {
+            if !stereo[0].is_finite() || !stereo[1].is_finite() {
+                return Err(nest_cache("Nonfinite float envelope sample"));
+            }
+            while self.position >= self.bucket_end {
+                self.bucket += 1;
+                if self.bucket >= self.values.len() { return Err(nest_cache("Envelope bucket domain overflow")); }
+                self.bucket_end = (self.bucket as u64 + 1) * self.frames / self.values.len() as u64;
+            }
+            self.values[self.bucket] = self.values[self.bucket].max(stereo[0].abs()).max(stereo[1].abs());
+            self.position += 1;
+        }
+        Ok(())
+    }
+    fn write(self, output: std::path::PathBuf) -> Result<(), String> {
+        use std::io::Write;
+        if self.position != self.frames { return Err(nest_cache("Incomplete envelope sample domain")); }
+        let mut outputs = NestFiles { paths: Vec::new() };
+        let mut target = outputs.create(output)?;
+        if !target.metadata().map_err(|_| nest_cache("Cannot inspect new envelope output"))?.is_file() {
+            return Err(nest_error("GA_AUDIO_NESTED_ENV", "Envelope output is not a normal file"));
+        }
+        let mut bytes = Vec::new();
+        bytes.try_reserve_exact(self.values.len()*4).map_err(|_| nest_capacity("Cannot reserve bounded envelope bytes"))?;
