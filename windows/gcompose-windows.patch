+  clSetKernelArg(kPip,3,sizeof(float),&op); clSetKernelArg(kPip,4,sizeof(int),&blend); clSetKernelArg(kPip,5,sizeof(float),&px); clSetKernelArg(kPip,6,sizeof(float),&py);
