-    /// Upload an RGBA8 GVW×GVH frame to a slot (0=base/V1, 1=over/V2, 2=transition partner).
-    pub fn upload(&self, slot: i32, rgba: &[u8]) {
-        debug_assert_eq!(rgba.len(), GVW * GVH * 4);
-        unsafe { fpx_gpu_upload_u8(slot as c_int, rgba.as_ptr()) };
-    }
