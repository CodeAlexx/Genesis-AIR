+// Reserve it on every retained cache level; it is never invented audio padding.
+fn nest_phase_body(node:&NestNode,nodes:&[NestNode])->Option<usize> {
+    let phase=node.phase.as_ref().or_else(|| if node.tail {
+        nodes.iter().find(|child|child.parent==node.id).and_then(|child|child.phase.as_ref())
+    }else{None});
+    phase.map(|p|p.original_body)
