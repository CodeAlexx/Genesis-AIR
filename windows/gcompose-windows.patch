+pub struct AudioStream { handle: *mut std::ffi::c_void }
+impl AudioStream {
+    pub fn read_actual(&mut self,frames:usize)->Option<Vec<f32>> {
+        if frames>48000*30 {return None;}
+        let mut out=Vec::new();out.try_reserve_exact(frames.checked_mul(2)?).ok()?;out.resize(frames*2,0.0);
+        let count=unsafe {fpx_au_stream_read(self.handle,out.as_mut_ptr(),frames as c_int)};
+        if count<0 || count as usize>frames {return None;}out.truncate(count as usize*2);Some(out)
+    }
+    pub fn open(path: &str, start: f64, duration: f64, chain: &str) -> Option<Self> {
+        let path = CString::new(path).ok()?;
+        let chain = CString::new(chain).ok()?;
+        let handle = unsafe { fpx_au_stream_open(path.as_ptr(), start, duration, chain.as_ptr()) };
+        if handle.is_null() { None } else { Some(Self { handle }) }
+    }
+    pub fn read(&mut self, frames: usize) -> Option<Vec<f32>> {
+        if frames > 48000 * 30 { return None; }
+        let mut out = Vec::new();
+        out.try_reserve_exact(frames.checked_mul(2)?).ok()?;
+        out.resize(frames * 2, 0.0);
+        let rc = unsafe { fpx_au_stream_read(self.handle, out.as_mut_ptr(), frames as c_int) };
+        if rc < 0 || rc as usize > frames { return None; }
+        // Source EOF and filter latency/tails may leave less than the timeline
+        // length; the authoritative clip/device range remains exact, with silence.
+        Some(out)
+    }
+    /// Collect a complete render range using the same decoder, native-sample
+    /// trim, resampler and filter graph as playback. Unlike device reads, EOF
+    /// truncates the output rather than padding it; effect tails and retiming
+    /// retain their actual lengths. The caller's float-buffer cap stays binding.
+    pub fn read_to_end(&mut self, max_frames: usize) -> Option<Vec<f32>> {
+        let max_floats = max_frames.checked_mul(2)?;
+        let mut out = Vec::new();
+        let mut block = vec![0.0f32; 48000 * 2];
+        loop {
+            let rc = unsafe { fpx_au_stream_read(self.handle, block.as_mut_ptr(), 48000) };
+            if rc < 0 || rc > 48000 { return None; }
+            let floats = (rc as usize).checked_mul(2)?;
+            let count = out.len().checked_add(floats)?;
+            if count > max_floats { return None; }
+            if count > out.capacity() {
+                let capacity = out.capacity().saturating_mul(2).max(count).min(max_floats);
+                out.try_reserve_exact(capacity-out.len()).ok()?;
+            }
+            out.extend_from_slice(&block[..floats]);
+            if rc < 48000 { return Some(out); }
+        }
+    }
+}
+impl Drop for AudioStream {
+    fn drop(&mut self) { unsafe { fpx_au_stream_close(self.handle) } }
+}
