+int fpx_gpu_upload_fitted_f32(int slot,const float* input,int sw,int sh,int opaque){
+  if(!g_ready||slot<0||slot>2||!input||sw<16||sh<16||sw>8192||sh>8192||
+    (uint64_t)sw*sh>16777216)return -1;
+  uint64_t bytes=(uint64_t)sw*sh*4*sizeof(float);
+  if(canvas_make_room(bytes)!=0)return -2;
+  cl_int rc=CL_SUCCESS;cl_mem stage=clCreateBuffer(g_ctx,CL_MEM_READ_ONLY,(size_t)bytes,NULL,&rc);
+  if(rc!=CL_SUCCESS||!stage)return -2;
+  if((rc=clEnqueueWriteBuffer(g_q,stage,CL_TRUE,0,(size_t)bytes,input,0,NULL,NULL))!=CL_SUCCESS)goto done;
+  double fit=fmin((double)GVW/sw,(double)GVH/sh);
+  int fw=(int)floor(sw*fit+0.5),fh=(int)floor(sh*fit+0.5),left=(GVW-fw)/2,top=(GVH-fh)/2;
+  if(fw<1)fw=1;if(fh<1)fh=1;
+  if((rc=clSetKernelArg(kFit,0,sizeof(cl_mem),&stage))!=CL_SUCCESS)goto done;
+  if((rc=clSetKernelArg(kFit,1,sizeof(cl_mem),&g_buf[slot]))!=CL_SUCCESS)goto done;
+  int args[7]={sw,sh,fw,fh,left,top,opaque};
+  for(int i=0;i<7;i++)if((rc=clSetKernelArg(kFit,i+2,sizeof(int),&args[i]))!=CL_SUCCESS)goto done;
+  rc=launch(kFit);if(rc==0)rc=clFinish(g_q);
