-"  if(x1<0||y1<0||x0>w-1||y0>h-1){ d[di+0]=0.0f; d[di+1]=0.0f; d[di+2]=0.0f; d[di+3]=0.0f; return; }\n"
-"  int cx0=x0<0?0:(x0>w-1?w-1:x0), cx1=x1<0?0:(x1>w-1?w-1:x1);\n"
