+// Owned nested bus trees: all metadata preflights before processing, unclamped
+// RF64 caches keep large spans off the Rust heap. The caller owns the exclusive
+// flat directory and removes it after hard cancellation; Drop removes our files.
+const NEST_BLOCK: usize = 48000 * 5;
+const NEST_MAX_FRAMES: i64 = 48000 * 6 * 3600;
+const NEST_DISK_MAX: u64 = 32 * 1024 * 1024 * 1024;
+const NEST_DESCRIPTOR_MAX: usize = 32 * 1024 * 1024;
+const NEST_HEADER: u64 = 80;
+fn nest_error(code: &str, message: &str) -> String { format!("[{code}] {message}") }
+fn nest_protocol(message: &str) -> String { nest_error("GA_AUDIO_NESTED_PROTOCOL", message) }
+fn nest_capacity(message: &str) -> String { nest_error("GA_AUDIO_NESTED_CAPACITY", message) }
+fn nest_cache(message: &str) -> String { nest_error("GA_AUDIO_NESTED_CACHE", message) }
+fn nest_render(message: &str) -> String { nest_error("GA_AUDIO_NESTED_RENDER", message) }
+fn nest_id(value: &str) -> bool {
+    !value.is_empty() && value != "-" && value.len() <= 256 && value.bytes().all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b))
+}
+fn nest_sample(value: &str) -> Result<i64, String> {
+    let value = value.parse::<i64>().map_err(|_| nest_protocol("Invalid sample coordinate"))?;
+    if !(0..=9007199254740991).contains(&value) { return Err(nest_protocol("Sample coordinate outside exact range")); }
+    Ok(value)
+}
+fn nest_number(value: &str) -> Result<f64, String> {
+    let value = value.parse::<f64>().map_err(|_| nest_protocol("Invalid numeric field"))?;
+    if !value.is_finite() { return Err(nest_protocol("Nonfinite numeric field")); }
+    Ok(value)
+}
+struct NestEnvelope { gain: f32, fade_in: f64, fade_out: f64, length: f64,
+    gain_keys: Option<ClipGainKeys>, fade_keys: Option<ClipFadeKeys> }
+impl NestEnvelope {
+    fn parse(fields: &[&str], start: i64, frames: usize) -> Result<Self, String> {
+        if fields.len() < 4 || fields.len() > 6 { return Err(nest_protocol("Invalid envelope field count")); }
+        let gain = nest_number(fields[0])?;
+        let fade_in = nest_number(fields[1])?;
+        let fade_out = nest_number(fields[2])?;
+        let length = nest_number(fields[3])?;
+        if gain < 0.0 || gain > f32::MAX as f64 || fade_in < 0.0 || fade_out < 0.0 || length <= 0.0 {
+            return Err(nest_protocol("Invalid clip gain or fade length"));
+        }
+        let mut gain_keys = None;
+        let mut fade_keys = None;
+        for token in &fields[4..] {
+            if token.starts_with("GAINKEYS:") && gain_keys.is_none() {
+                gain_keys = Some(ClipGainKeys::parse(token).ok_or_else(|| nest_protocol("Invalid nested gain curve"))?);
+            } else if token.starts_with("FADEKEYS:") && fade_keys.is_none() {
+                fade_keys = Some(ClipFadeKeys::parse(token).ok_or_else(|| nest_protocol("Invalid nested fade curve"))?);
+            } else { return Err(nest_protocol("Unknown or duplicate nested envelope")); }
+        }
+        if gain_keys.as_ref().is_some_and(|keys| keys.origin != start) ||
+            fade_keys.as_ref().is_some_and(|keys| keys.origin != start || keys.clip_origin != start || !keys.accepts_frames(frames)) {
+            return Err(nest_protocol("Nested envelope origin or sample bound mismatch"));
+        }
+        Ok(Self { gain: gain as f32, fade_in, fade_out, length, gain_keys, fade_keys })
+    }
+    fn apply(&self, samples: &mut [f32], offset: usize) {
+        // Same gain*animated*product order as flat AUDIO; only the parent root
+        // output applies the final limiter. Curves have complete raw contexts.
+        for (fr, frame) in samples.chunks_exact_mut(2).enumerate() {
+            let at = offset + fr;
+            let local = self.fade_keys.as_ref().map_or(at as f64 / PROG_SR as f64, |keys| keys.local_time(at));
+            let (fi, fo) = self.fade_keys.as_ref().map_or((self.fade_in, self.fade_out),
+                |keys| keys.lengths(at, self.fade_in, self.fade_out));
+            let mut env = 1.0f64;
+            if fi > 0.0 && local < fi { env *= (local / fi).max(0.0); }
+            if fo > 0.0 && local >= self.length - fo { env *= ((self.length - local) / fo).clamp(0.0, 1.0); }
+            let animated = self.gain_keys.as_ref().map_or(1.0, |keys| keys.at(at));
+            let gain = (self.gain * animated) * env as f32;
+            for value in frame { *value *= gain; }
+        }
+    }
+}
+enum NestInput { Leaf { path: String, source: f64, duration: f64 }, Bus { begin: i64, end: i64 } }
+struct NestNode { id: String, parent: String, start: i64, end: i64, input: NestInput,
+    chain: String, envelope: NestEnvelope }
+impl NestNode {
+    fn parse(line: &str) -> Result<Self, String> {
+        let f: Vec<_> = line.split_whitespace().collect();
+        let leaf = f.first() == Some(&"NESTLEAF");
+        let base = if leaf { 13 } else { 12 };
+        if f.len() < base || f.len() > base + 2 { return Err(nest_protocol("Invalid nested node field count")); }
+        if !nest_id(f[1]) || (f[2] != "-" && !nest_id(f[2])) { return Err(nest_protocol("Invalid instance path")); }
+        let start = nest_sample(f[3])?; let end = nest_sample(f[4])?;
+        if end <= start { return Err(nest_protocol("Empty or reversed clip interval")); }
+        let frames = end - start;
+        if frames > NEST_MAX_FRAMES { return Err(nest_capacity("Nested clip exceeds six hours")); }
+        let input = if leaf {
+            if f[2] == "-" { return Err(nest_protocol("A nested leaf needs a bus parent")); }
+            let source = nest_number(f[6])?; let duration = nest_number(f[7])?;
+            if source < 0.0 || duration <= 0.0 || !(source + duration).is_finite() { return Err(nest_protocol("Invalid source interval")); }
+            if duration > 6.0 * 3600.0 { return Err(nest_capacity("Nested source span exceeds six hours")); }
+            NestInput::Leaf { path: dec_path(f[5]), source, duration }
+        } else {
+            let begin = nest_sample(f[5])?; let end = nest_sample(f[6])?;
+            if end <= begin { return Err(nest_protocol("Empty or reversed child source interval")); }
+            if end - begin > NEST_MAX_FRAMES { return Err(nest_capacity("Nested child source span exceeds six hours")); }
+            NestInput::Bus { begin, end }
+        };
+        let index = if leaf { 8 } else { 7 };
+        let chain = f[base - 1];
+        if chain.len() > 16384 { return Err(nest_capacity("Nested filter chain is too long")); }
+        // Only the leading reverse spelling reaches the shared native bridge's
+        // bounded two-second reverse feeder. Never admit libavfilter's
+        // unbounded whole-input areverse elsewhere in a nested graph.
+        if chain.contains("areverse") && chain != "areverse" &&
+            !chain.strip_prefix("areverse,").is_some_and(|tail| !tail.contains("areverse")) {
+            return Err(nest_protocol("Nested reverse must appear once at the beginning of the chain"));
+        }
+        let mut envelope_fields = vec![f[index], f[index+1], f[index+2], f[index+3]];
+        envelope_fields.extend_from_slice(&f[base..]);
+        let envelope = NestEnvelope::parse(&envelope_fields, start, frames as usize)?;
+        Ok(Self { id: f[1].to_owned(), parent: f[2].to_owned(), start, end, input, chain: chain.to_owned(), envelope })
+    }
+}
+#[derive(PartialEq)]
+struct NestIdentity { lines: Vec<String>, source_stamps: Vec<(String, u64, u128)> }
+struct NestPending { directory: std::path::PathBuf, lines: Vec<String>, bytes: usize }
+struct NestFiles { paths: Vec<std::path::PathBuf> }
+impl NestFiles {
+    fn create(&mut self, path: std::path::PathBuf) -> Result<std::fs::File, String> {
+        let file = std::fs::OpenOptions::new().create_new(true).write(true).read(true).open(&path)
+            .map_err(|_| nest_cache("Cannot create owned float cache file"))?;
+        self.paths.push(path); Ok(file)
+    }
+}
+impl Drop for NestFiles {
+    fn drop(&mut self) { for path in &self.paths { let _ = std::fs::remove_file(path); } }
+}
+struct NestAccepted { identity: NestIdentity, nodes: Vec<NestNode>, paths: Vec<std::path::PathBuf>,
+    _files: NestFiles, bytes: u64 }
+#[derive(Default)]
+struct NestedAudio { pending: Option<NestPending>, accepted: Option<NestAccepted>,
+    directory: Option<std::path::PathBuf>, serial: u64, warm_builds: u64, cache_hits: u64, mix_frames: u64 }
+fn nest_write_header(file: &mut std::fs::File, frames: i64) -> Result<(), String> {
+    let bytes = frames as u64 * 8;
+    let mut header = Vec::with_capacity(80);
+    header.extend_from_slice(b"RF64"); header.extend_from_slice(&u32::MAX.to_le_bytes()); header.extend_from_slice(b"WAVEds64");
+    header.extend_from_slice(&28u32.to_le_bytes()); header.extend_from_slice(&(bytes+72).to_le_bytes());
+    header.extend_from_slice(&bytes.to_le_bytes()); header.extend_from_slice(&(frames as u64).to_le_bytes());
+    header.extend_from_slice(&0u32.to_le_bytes()); header.extend_from_slice(b"fmt "); header.extend_from_slice(&16u32.to_le_bytes());
+    header.extend_from_slice(&3u16.to_le_bytes()); header.extend_from_slice(&2u16.to_le_bytes());
+    header.extend_from_slice(&48000u32.to_le_bytes()); header.extend_from_slice(&384000u32.to_le_bytes());
+    header.extend_from_slice(&8u16.to_le_bytes()); header.extend_from_slice(&32u16.to_le_bytes());
+    header.extend_from_slice(b"data"); header.extend_from_slice(&u32::MAX.to_le_bytes());
+    debug_assert_eq!(header.len(), 80);
+    file.write_all(&header).map_err(|_| nest_cache("Cannot write float RF64 header"))
+}
+fn nest_write_samples(file: &mut std::fs::File, samples: &[f32]) -> Result<(), String> {
+    // Raw float serialization intentionally has NO final_audio_sample mapping.
+    let mut bytes = Vec::new(); bytes.try_reserve_exact(samples.len() * 4).map_err(|_| nest_capacity("Cannot reserve float block bytes"))?;
+    for value in samples {
+        if !value.is_finite() { return Err(nest_render("Nonfinite nested audio sample")); }
+        bytes.extend_from_slice(&value.to_le_bytes());
+    }
+    file.write_all(&bytes).map_err(|_| nest_cache("Cannot write float cache block"))
+}
+fn nest_read_samples(file: &mut std::fs::File, offset: i64, frames: usize) -> Result<Vec<f32>, String> {
+    use std::io::{Read, Seek, SeekFrom};
+    file.seek(SeekFrom::Start(NEST_HEADER + offset as u64 * 8)).map_err(|_| nest_cache("Cannot seek float cache"))?;
+    let mut bytes = Vec::new(); bytes.try_reserve_exact(frames * 8).map_err(|_| nest_capacity("Cannot reserve float read block"))?;
+    bytes.resize(frames * 8, 0);
+    file.read_exact(&mut bytes).map_err(|_| nest_cache("Incomplete float cache block"))?;
+    let mut out = Vec::new(); out.try_reserve_exact(frames * 2).map_err(|_| nest_capacity("Cannot reserve float samples"))?;
+    for value in bytes.chunks_exact(4) {
+        let value = f32::from_le_bytes(value.try_into().unwrap());
+        if !value.is_finite() { return Err(nest_cache("Nonfinite float cache sample")); }
+        out.push(value);
+    }
+    Ok(out)
+}
+fn nest_peak_output(directory: &std::path::Path, output: std::path::PathBuf) -> Result<std::path::PathBuf, String> {
+    let invalid = |detail| nest_error("GA_AUDIO_NESTED_ENV", detail);
+        let owned = std::fs::canonicalize(directory).map_err(|_| nest_cache("Cannot inspect owned envelope cache directory"))?;
+        let name = output.file_name().and_then(|name| name.to_str())
+            .ok_or_else(|| invalid("Envelope output needs a normal filename"))?;
+        // Reject Windows alternate streams, device names and normalized aliases
+        // on both OS, keeping the caller-owned flat-directory contract portable.
+        let stem = name.split('.').next().unwrap_or("").to_ascii_uppercase();
+        let reserved = matches!(stem.as_str(), "CON" | "PRN" | "AUX" | "NUL") ||
+            (stem.len() == 4 && (stem.starts_with("COM") || stem.starts_with("LPT")) &&
+             matches!(stem.as_bytes()[3], b'1'..=b'9'));
+        if name.contains(':') || name.ends_with('.') || name.ends_with(' ') || reserved {
+            return Err(invalid("Envelope output needs a portable normal filename"));
+        }
+        let parent = output.parent().ok_or_else(|| invalid("Envelope output needs an owned cache parent"))?;
+        if std::fs::canonicalize(parent).map_err(|_| invalid("Envelope output parent is not the owned cache"))? != owned {
+            return Err(invalid("Envelope output must remain inside the owned flat cache"));
+        }
+        match std::fs::symlink_metadata(&output) {
+            Ok(_) => return Err(invalid("Envelope output must be a new file")),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {},
+            Err(_) => return Err(invalid("Cannot inspect envelope output path")),
+        }
+    Ok(output)
+}
