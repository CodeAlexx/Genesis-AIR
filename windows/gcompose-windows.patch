+fn nest_process_body(node: &NestNode, decoder: &mut ffi::AudioStream, body_override:Option<usize>, phase_short:usize,native_eof:bool,
+    mut consume: impl FnMut(&[f32]) -> Result<(), String>) -> Result<(usize,usize), String> {
+    let body = body_override.unwrap_or_else(||node.phase.as_ref().map_or((node.end-node.start) as usize,|p|p.original_body));
+    let (total, crop) = node.context.as_ref().map_or((body, 0), |c| (c.processing, c.crop));
+    let finish = crop.checked_add(body).ok_or_else(|| nest_error("GA_AUDIO_CONTEXT", "Body sample interval overflows"))?;
+    let mut at = 0usize; let mut emitted = 0usize; let mut blocks = 0usize;
+    while at < total {
+        let count = (total-at).min(NEST_BLOCK);
+        let actual_phase=native_eof || node.phase.is_some() || body_override.is_some();
+        let mut values = if actual_phase {decoder.read_actual(count)}else{decoder.read(count)}
+            .ok_or_else(|| nest_render("Cannot read full-DSP filter output"))?;
+        // Validate even discarded prefix/suffix: no failed/nonfinite graph may
+        // publish a seemingly valid body. Full right-edge processing completes
+        // before the caller publishes its file/cache transaction.
+        let received=values.len()/2;
+        if values.len()%2 != 0 || received>count ||
+            (received<count && !native_eof && (!actual_phase || total-at-received>phase_short)) ||
+            (node.context.is_some() && values.iter().any(|v| !v.is_finite())) {
+            return Err(nest_render("Invalid full-DSP filter sample block"));
+        }
+        let first = at.max(crop); let end = (at+received).min(finish);
+        if end > first {
+            let selected = &mut values[(first-at)*2..(end-at)*2];
+            node.envelope.apply(selected, emitted);
+            consume(selected)?; emitted += end-first;
+        }
+        at += received; blocks += 1;
+        // A finite no-tail graph can end before authored N by the independently
+        // verified negative native phase. Its cache owns actual EOF, never padding.
+        if received<count {break;}
+    }
+    if emitted < body && node.phase.is_none() && body_override.is_none() && (!native_eof || at==total) {
+        // Original sample phase is retained across fractional-FPS Move; only
+        // the authored endpoint may have one additional zero sample.
+        if body-emitted != 1 { return Err(nest_error("GA_AUDIO_CONTEXT", "Unproved endpoint padding")); }
+        consume(&[0.0,0.0])?; emitted += 1;
+    }
+    Ok((blocks,emitted))
+}
