+//   EncodeVideoFrame(ImMat)(cpp:288-294,1080-1200,1300-1390) ImMat RGBA->AVFrame->send/recv->mux
+//   EncodeAudioSamples     (cpp:296-430,1220-1390)           interleaved f32->frame chunk->swr->send/recv->mux
