+// Immutable snapshots share the context/queue, never canvas-cache ownership.
+static int snapshot_kernel(void){
+ if(g_snapshot_copy&&g_snapshot_status)return 0;
+ const char* source="__kernel void snapshot_copy(__global const float*s,__global float*d,volatile __global int*bad,int n){int i=get_global_id(0);if(i>=n)return;float v=s[i];d[i]=v;if(!isfinite(v))atomic_or(bad,1);if((i&3)==3&&(v<0.0f||v>1.0f))atomic_or(bad,2);}";
+ cl_int rc=CL_SUCCESS;
+ cl_program p=clCreateProgramWithSource(g_ctx,1,&source,NULL,&rc);if(!p||rc!=CL_SUCCESS)return -3;
+ if(clBuildProgram(p,1,&g_dev,NULL,NULL,NULL)!=CL_SUCCESS){clReleaseProgram(p);return -3;}
+ cl_kernel k=clCreateKernel(p,"snapshot_copy",&rc);if(!k||rc!=CL_SUCCESS){clReleaseProgram(p);return -3;}
+ if(canvas_make_room(sizeof(cl_int))!=0){clReleaseKernel(k);clReleaseProgram(p);return -2;}
+ cl_mem status=clCreateBuffer(g_ctx,CL_MEM_READ_WRITE,sizeof(cl_int),NULL,&rc);
+ if(!status||rc!=CL_SUCCESS){clReleaseKernel(k);clReleaseProgram(p);return -2;}
+ g_snapshot_program=p;g_snapshot_copy=k;g_snapshot_status=status;return 0;
+}
+int fpx_gpu_picture_store(uint64_t epoch,uint64_t id,int final_is_look){
+ if(!g_ready||!epoch||epoch!=g_snapshot_epoch||!id)return -1;
+ for(int i=0;i<g_snapshot_seen_count;i++)if(g_snapshot_seen[i]==id)return -1;
+ if(g_snapshot_seen_count>=FPX_SNAPSHOT_COUNT)return -2;
+ int at=-1;for(int i=0;i<FPX_SNAPSHOT_COUNT;i++)if(!g_snapshots[i].data){at=i;break;}
+ if(at<0)return -2;
+ int rc=snapshot_kernel();if(rc)return rc;
+ uint64_t bytes=(uint64_t)GVW*GVH*4*sizeof(float);
+ if(canvas_make_room(bytes)!=0)return -2;
+ cl_int error=CL_SUCCESS;cl_mem data=clCreateBuffer(g_ctx,CL_MEM_READ_WRITE,(size_t)bytes,NULL,&error);
+ if(!data||error!=CL_SUCCESS)return -2;
+ cl_int invalid=0;int n=GVW*GVH*4;cl_mem src=g_buf[final_is_look?LOOKB:OUTB];
+ if(clEnqueueWriteBuffer(g_q,g_snapshot_status,CL_TRUE,0,sizeof invalid,&invalid,0,NULL,NULL)!=CL_SUCCESS)goto failed;
+ if(clSetKernelArg(g_snapshot_copy,0,sizeof src,&src)!=CL_SUCCESS||
+    clSetKernelArg(g_snapshot_copy,1,sizeof data,&data)!=CL_SUCCESS||
+    clSetKernelArg(g_snapshot_copy,2,sizeof g_snapshot_status,&g_snapshot_status)!=CL_SUCCESS||
+    clSetKernelArg(g_snapshot_copy,3,sizeof n,&n)!=CL_SUCCESS)goto failed;
+ size_t global=(size_t)n;
+ if(clEnqueueNDRangeKernel(g_q,g_snapshot_copy,1,NULL,&global,NULL,0,NULL,NULL)!=CL_SUCCESS||
+    clEnqueueReadBuffer(g_q,g_snapshot_status,CL_TRUE,0,sizeof invalid,&invalid,0,NULL,NULL)!=CL_SUCCESS)goto failed;
+ if((invalid&1)||(g_compound&&(invalid&2))){clReleaseMemObject(data);return -4;}
+ g_snapshots[at]=(FpxSnapshot){id,bytes,GVW,GVH,(invalid&2)!=0,data};g_snapshot_bytes+=bytes;
+ g_snapshot_seen[g_snapshot_seen_count++]=id;
+ g_final_is_look=final_is_look;return 0;
+failed:
+ clFinish(g_q);clReleaseMemObject(data);return -3;
+}
+int fpx_gpu_picture_check(uint64_t epoch,uint64_t id,int fit){
+ if(!g_ready||!epoch||epoch!=g_snapshot_epoch||!id||fit<0||fit>2)return -1;
+ int at=snapshot_find(id);if(at<0)return -1;
+ FpxSnapshot*s=&g_snapshots[at];
+ if(!fit&&(s->width!=GVW||s->height!=GVH))return -1;
+ if(fit&&s->invalid_alpha)return -4;
+ return 0;
+}
+int fpx_gpu_picture_upload(int slot,uint64_t epoch,uint64_t id,int fit){
+ if(slot<0||slot>2)return -1;
+ int rc=fpx_gpu_picture_check(epoch,id,fit);if(rc)return rc;
+ FpxSnapshot*s=&g_snapshots[snapshot_find(id)];
+ if(!fit)return clEnqueueCopyBuffer(g_q,s->data,g_buf[slot],0,0,(size_t)s->bytes,0,NULL,NULL)==CL_SUCCESS?0:-3;
+ double factor=fmin((double)GVW/s->width,(double)GVH/s->height);
+ int fw=(int)floor(s->width*factor+.5),fh=(int)floor(s->height*factor+.5);
+ if(fw<1)fw=1;if(fh<1)fh=1;
+ int args[7]={s->width,s->height,fw,fh,(GVW-fw)/2,(GVH-fh)/2,fit==2};
+ if(clSetKernelArg(kFit,0,sizeof(cl_mem),&s->data)!=CL_SUCCESS||clSetKernelArg(kFit,1,sizeof(cl_mem),&g_buf[slot])!=CL_SUCCESS)return -3;
+ for(int i=0;i<7;i++)if(clSetKernelArg(kFit,i+2,sizeof(int),&args[i])!=CL_SUCCESS)return -3;
+ return launch(kFit)==0?0:-3;
+}
