+// Private explicit original owner/sample phase. Legacy AUDIOTAIL keeps its integral guard.
+struct NestAudioPhase { native_rate:i32, original_body:usize, resampler_delta:i64 }
+impl NestAudioPhase {
+    fn parse(token:&str, context:&NestAudioContext, start:i64, end:i64)->Result<Self,String> {
+        let bad=||nest_error("GA_AUDIO_PHASE", "Invalid native source/original owner sample phase");
+        let f:Vec<_>=token.split(':').collect();
+        if f.len()!=9 || f[0]!="AUDIOPHASE" {return Err(bad());}
+        let rate=f[1].parse::<i32>().map_err(|_|bad())?;
+        let fps=f[2].parse::<f64>().map_err(|_|bad())?;
+        if !matches!(rate,44100|48000) || ![24.0,30.0,60.0,24000.0/1001.0,30000.0/1001.0,60000.0/1001.0].contains(&fps) {return Err(bad());}
+        let mut ints=Vec::new();
+        for field in &f[3..] {let n=field.parse::<i64>().map_err(|_|bad())?;if !(0..=9007199254740991).contains(&n) {return Err(bad());}ints.push(n);}
+        let (origin,length,source,offset,body,placement)=(ints[0],ints[1],ints[2],ints[3],ints[4],ints[5]);
+        if length==0 || body==0 || offset.checked_add(body)!=Some(length) {return Err(bad());}
+        let sample=|frame:i64|->Option<i64> {
+            let value=(frame as f64*PROG_SR as f64/fps+0.5).floor();
+            if frame<0 || frame>9007199254740991 || !value.is_finite() || value>9007199254740991.0 {None}else{Some(value as i64)}
+        };
+        let first=sample(origin).ok_or_else(bad)?;
+        let last=sample(origin.checked_add(length).ok_or_else(bad)?).ok_or_else(bad)?;
+        let crop=sample(origin.checked_add(offset).ok_or_else(bad)?).ok_or_else(bad)?;
+        let placed=sample(placement).ok_or_else(bad)?;
+        let placed_end=sample(placement.checked_add(body).ok_or_else(bad)?).ok_or_else(bad)?;
+        if last<first || crop<first || crop>last || context.frames!=(last-first) as usize || context.crop!=(crop-first) as usize ||
+            start!=placed || end!=placed_end || ((end-start)-(last-crop)).abs()>1 ||
+            (context.source-source as f64/fps).abs()>1e-9 || (context.duration-length as f64/fps).abs()>1e-9 {return Err(bad());}
+        // fpx_audio.c selects nearest microsecond -> nearest native count.
+        // aresample's finite output count is rounded UP, independently of the
+        // owner frame phase. Keep that at most two-sample seam out of FX tail
+        // accounting; original N/crop and authored geometry remain untouched.
+        let micros=(context.duration*1_000_000.0+0.5).floor();
+        if !micros.is_finite() || micros<1.0 || micros>21_600_000_000.0 {return Err(bad());}
+        let native=(micros as u64).checked_mul(rate as u64).and_then(|n|n.checked_add(500_000)).ok_or_else(bad)?/1_000_000;
+        let resampled=native.checked_mul(PROG_SR as u64).and_then(|n|n.checked_add(rate as u64-1)).ok_or_else(bad)?/(rate as u64);
+        let delta=resampled as i64-(last-first);
+        if !(-2..=2).contains(&delta) {return Err(bad());}
+        Ok(Self {native_rate:rate,original_body:(last-crop) as usize,resampler_delta:delta})
+    }
+}
