+fn gain_catmull_coefficients(keys: &[ClipGainKey], i: usize) -> [f64; 4] {
+    let p = &keys[i.saturating_sub(1)];
+    let a = &keys[i];
+    let b = &keys[i + 1];
+    let q = &keys[(i + 2).min(keys.len() - 1)];
+    let x0 = p.frame as f64 - if p.frame == a.frame { 10000.0 } else { 0.0 };
+    let x3 = q.frame as f64 + if q.frame == b.frame { 10000.0 } else { 0.0 };
+    let alpha = if a.mode == 6 { 0.0 } else { 0.5 };
+    let tension: f64 = if a.mode == 5 { -1.0 } else if a.mode == 6 { 1.0 } else { 0.0 };
+    let distance = |x0: f64, y0: f64, x1: f64, y1: f64| {
+        if alpha == 0.0 { 1.0 } else { ((x1-x0)*(x1-x0)+(y1-y0)*(y1-y0)).sqrt().sqrt() }
+    };
+    let t12 = distance(a.frame as f64, a.value, b.frame as f64, b.value);
+    let mut m1 = 0.0;
+    let mut m2 = 0.0;
+    if tension > 0.0 || (a.value < p.value && a.value > b.value) || (a.value > p.value && a.value < b.value) {
+        let t01 = distance(x0, p.value, a.frame as f64, a.value);
+        m1 = tension.abs()*(b.value-a.value+t12*((a.value-p.value)/t01-(b.value-p.value)/(t01+t12)));
+    }
+    if tension > 0.0 || (b.value < a.value && b.value > q.value) || (b.value > a.value && b.value < q.value) {
+        let t23 = distance(b.frame as f64, b.value, x3, q.value);
+        m2 = tension.abs()*(b.value-a.value+t12*((q.value-b.value)/t23-(q.value-a.value)/(t12+t23)));
+    }
+    [2.0*(a.value-b.value)+m1+m2, -3.0*(a.value-b.value)-m1-m1-m2, m1, a.value]
+}
+fn gain_bounce(t: f64) -> f64 {
+    if t < 4.0/11.0 { 121.0*t*t/16.0 }
+    else if t < 8.0/11.0 { 363.0/40.0*t*t-99.0/10.0*t+17.0/5.0 }
+    else if t < 9.0/10.0 { 4356.0/361.0*t*t-35442.0/1805.0*t+16061.0/1805.0 }
+    else { 54.0/5.0*t*t-513.0/25.0*t+268.0/25.0 }
+}
+fn gain_ease(mode: u32, t: f64) -> f64 {
+    use std::f64::consts::PI;
+    if mode == 3 { return t*t*(3.0-2.0*t); }
+    if mode < 8 { return t; } // 0/1 are std.curve's legacy linear fallback.
+    let family = (mode-8)/3;
+    let direction = (mode-8)%3;
+    match family {
+        0 => match direction { 0 => ((t-1.0)*PI/2.0).sin()+1.0,
+            1 => (t*PI/2.0).sin(), _ => 0.5*(1.0-(t*PI).cos()) },
+        1..=4 => { let order = (family+1) as i32;
+            match direction { 0 => t.powi(order), 1 => 1.0-(1.0-t).powi(order),
+                _ => if t < 0.5 { 2.0f64.powi(order)*t.powi(order)/2.0 }
+                    else { 1.0-(-2.0*t+2.0).powi(order)/2.0 } } },
+        5 => if t == 0.0 || t == 1.0 { t } else { match direction {
+            0 => (10.0*t-10.0).exp2(), 1 => 1.0-(-10.0*t).exp2(),
+            _ => if t < 0.5 { (20.0*t-10.0).exp2()/2.0 } else { (2.0-(-20.0*t+10.0).exp2())/2.0 } } },
+        6 => match direction { 0 => 1.0-(1.0-t*t).sqrt(),
+            1 => (1.0-(t-1.0)*(t-1.0)).sqrt(),
+            _ => if t < 0.5 { 0.5*(1.0-(1.0-4.0*t*t).sqrt()) }
+                else { 0.5*((-((2.0*t)-3.0)*((2.0*t)-1.0)).sqrt()+1.0) } },
+        7 => { let back = |v: f64| v*v*v-v*(v*PI).sin();
+            match direction { 0 => back(t), 1 => 1.0-back(1.0-t),
+                _ => if t < 0.5 { 0.5*back(2.0*t) } else { 0.5*(1.0-back(1.0-(2.0*t-1.0)))+0.5 } } },
+        8 => { let c = 13.0*PI*0.5;
+            match direction { 0 => (c*t).sin()*(10.0*(t-1.0)).exp2(),
+                1 => (-c*(t+1.0)).sin()*(-10.0*t).exp2()+1.0,
+                _ => if t < 0.5 { 0.5*(c*2.0*t).sin()*(10.0*(2.0*t-1.0)).exp2() }
+                    else { 0.5*((-c*((2.0*t-1.0)+1.0)).sin()*(-10.0*(2.0*t-1.0)).exp2()+2.0) } } },
+        9 => match direction { 0 => 1.0-gain_bounce(1.0-t), 1 => gain_bounce(t),
+            _ => if t < 0.5 { 0.5*(1.0-gain_bounce(1.0-2.0*t)) } else { 0.5*gain_bounce(2.0*t-1.0)+0.5 } },
+        _ => t,
+    }
+}
