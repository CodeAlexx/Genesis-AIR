+// Owned nested bus trees: all metadata preflights before processing, unclamped
+// RF64 caches keep large spans off the Rust heap. The caller owns the exclusive
+// flat directory and removes it after hard cancellation; Drop removes our files.
+const NEST_BLOCK: usize = 48000 * 5;
+const NEST_MAX_FRAMES: i64 = 48000 * 6 * 3600;
+const NEST_DISK_MAX: u64 = 32 * 1024 * 1024 * 1024;
+const NEST_DESCRIPTOR_MAX: usize = 32 * 1024 * 1024;
+const NEST_HEADER: u64 = 80;
+fn nest_error(code: &str, message: &str) -> String { format!("[{code}] {message}") }
+fn nest_protocol(message: &str) -> String { nest_error("GA_AUDIO_NESTED_PROTOCOL", message) }
+fn nest_capacity(message: &str) -> String { nest_error("GA_AUDIO_NESTED_CAPACITY", message) }
+fn nest_cache(message: &str) -> String { nest_error("GA_AUDIO_NESTED_CACHE", message) }
+fn nest_render(message: &str) -> String { nest_error("GA_AUDIO_NESTED_RENDER", message) }
+fn nest_id(value: &str) -> bool {
+    !value.is_empty() && value != "-" && value.len() <= 256 && value.bytes().all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b))
+}
+fn nest_sample(value: &str) -> Result<i64, String> {
+    let value = value.parse::<i64>().map_err(|_| nest_protocol("Invalid sample coordinate"))?;
+    if !(0..=9007199254740991).contains(&value) { return Err(nest_protocol("Sample coordinate outside exact range")); }
+    Ok(value)
+}
+fn nest_number(value: &str) -> Result<f64, String> {
+    let value = value.parse::<f64>().map_err(|_| nest_protocol("Invalid numeric field"))?;
+    if !value.is_finite() { return Err(nest_protocol("Nonfinite numeric field")); }
+    Ok(value)
+}
+struct NestEnvelope { gain: f32, fade_in: f64, fade_out: f64, length: f64,
+    gain_keys: Option<ClipGainKeys>, fade_keys: Option<ClipFadeKeys>, pan_keys: Option<ClipGainKeys> }
+impl NestEnvelope {
+    fn parse(fields: &[&str], start: i64, frames: usize) -> Result<Self, String> {
+        if fields.len() < 4 || fields.len() > 7 { return Err(nest_protocol("Invalid envelope field count")); }
+        let gain = nest_number(fields[0])?;
+        let fade_in = nest_number(fields[1])?;
+        let fade_out = nest_number(fields[2])?;
+        let length = nest_number(fields[3])?;
+        if gain < 0.0 || gain > f32::MAX as f64 || fade_in < 0.0 || fade_out < 0.0 || length <= 0.0 {
+            return Err(nest_protocol("Invalid clip gain or fade length"));
+        }
+        let mut gain_keys = None;
+        let mut fade_keys = None;
+        let mut pan_keys = None;
+        for token in &fields[4..] {
+            if token.starts_with("GAINKEYS:") && gain_keys.is_none() {
+                gain_keys = Some(ClipGainKeys::parse(token).ok_or_else(|| nest_protocol("Invalid nested gain curve"))?);
+            } else if token.starts_with("FADEKEYS:") && fade_keys.is_none() {
+                fade_keys = Some(ClipFadeKeys::parse(token).ok_or_else(|| nest_protocol("Invalid nested fade curve"))?);
+            } else if token.starts_with("PANKEYS:") && pan_keys.is_none() {
+                pan_keys = Some(ClipGainKeys::parse_pan(token).ok_or_else(|| nest_protocol("Invalid nested pan curve"))?);
+            } else { return Err(nest_protocol("Unknown or duplicate nested envelope")); }
+        }
+        if gain_keys.as_ref().is_some_and(|keys| keys.origin != start) ||
+            pan_keys.as_ref().is_some_and(|keys| keys.origin != start) ||
+            fade_keys.as_ref().is_some_and(|keys| keys.origin != start || keys.clip_origin != start || !keys.accepts_frames(frames)) {
+            return Err(nest_protocol("Nested envelope origin or sample bound mismatch"));
+        }
+        Ok(Self { gain: gain as f32, fade_in, fade_out, length, gain_keys, fade_keys, pan_keys })
+    }
+    fn apply(&self, samples: &mut [f32], offset: usize) {
+        // Same gain*animated*product order as flat AUDIO; only the parent root
+        // output applies the final limiter. Curves have complete raw contexts.
+        for (fr, frame) in samples.chunks_exact_mut(2).enumerate() {
+            let at = offset + fr;
+            let local = self.fade_keys.as_ref().map_or(at as f64 / PROG_SR as f64, |keys| keys.local_time(at));
+            let (fi, fo) = self.fade_keys.as_ref().map_or((self.fade_in, self.fade_out),
+                |keys| keys.lengths(at, self.fade_in, self.fade_out));
+            let mut env = 1.0f64;
+            if fi > 0.0 && local < fi { env *= (local / fi).max(0.0); }
+            if fo > 0.0 && local >= self.length - fo { env *= ((self.length - local) / fo).clamp(0.0, 1.0); }
+            let animated = self.gain_keys.as_ref().map_or(1.0, |keys| keys.at(at));
+            let gain = (self.gain * animated) * env as f32;
+            if let Some(keys) = &self.pan_keys { apply_pan_balance(frame, keys.pan(at)); }
+            for value in frame { *value *= gain; }
+        }
+    }
+}
+// The full authored DSP graph is distinct from the visible sample body.  A
+// destructive timeline edit crops AFTER that graph, never restarts its history.
+struct NestAudioContext { source: f64, duration: f64, frames: usize, crop: usize, processing: usize }
+impl NestAudioContext {
+    // Direct explicit extents keep the durable virtual span; NEST retains v1.
+    fn parse2(token: &str, body: usize) -> Result<Self, String> {
+        let invalid=||nest_error("GA_AUDIO_CONTEXT", "Invalid explicit direct processing extent");
+        let f:Vec<_>=token.split(':').collect();
+        if f.len()!=6 || f[0]!="AUDIOCTX2" {return Err(invalid());}
+        let processing=f[4].parse::<usize>().map_err(|_|invalid())?;
+        let compact=format!("AUDIOCTX:{}:{}:{}:{}",f[1],f[2],f[3],f[5]);
+        let mut context=Self::parse_endpoint(&compact,body,true)?;
+        if processing==0 || processing>context.frames || context.crop>processing ||
+            context.crop.checked_add(body).is_none_or(|end|end>processing+1) {return Err(invalid());}
+        context.processing=processing;
+        Ok(context)
+    }
+    fn parse(token: &str, body: usize) -> Result<Self, String> {
+        Self::parse_endpoint(token,body,false)
+    }
+    fn parse_endpoint(token: &str, body: usize, endpoint: bool) -> Result<Self, String> {
+        let invalid = || nest_error("GA_AUDIO_CONTEXT", "Invalid full-DSP sample context");
+        let f: Vec<_> = token.split(':').collect();
+        if f.len() != 5 || f[0] != "AUDIOCTX" { return Err(invalid()); }
+        let source = f[1].parse::<f64>().map_err(|_| invalid())?;
+        let duration = f[2].parse::<f64>().map_err(|_| invalid())?;
+        let frames = f[3].parse::<usize>().map_err(|_| invalid())?;
+        let crop = f[4].parse::<usize>().map_err(|_| invalid())?;
+        if !source.is_finite() || source < 0.0 || !duration.is_finite() || duration <= 0.0 ||
+            duration > 21600.0 || !(source+duration).is_finite() || frames == 0 ||
+            frames > NEST_MAX_FRAMES as usize || crop > frames || (crop == frames && !endpoint) ||
+            crop.checked_add(body).is_none_or(|end| end > frames+1) {
+            return Err(invalid());
+        }
+        // At most one zero-padded endpoint sample is allowed when moving an
+        // unchanged body between fractional-FPS placement phases.
+        Ok(Self { source, duration, frames, crop, processing: frames })
+    }
+}
+// Full original graph input is retained, but causal flat output is read only as
+// requested. Prefix discard and transfer remain bounded; no float disk bus.
+fn context_discard(decoder:&mut ffi::AudioStream, frames:usize)->Option<()> {
+    let mut at=0usize;
+    let mut witness=NestFiles {paths:Vec::new()};
+    let trace=std::env::var_os("GENESIS_AUDIO_CONTEXT_TRACE").map(std::path::PathBuf::from);
+    while at<frames {
+        let count=(frames-at).min(NEST_BLOCK);
+        let values=decoder.read(count)?;
+        if values.len()!=count*2 || values.iter().any(|v|!v.is_finite()) {return None;}
+        at+=count;
+        if at==count {
+            if let Some(path)=&trace {
+                let mut file=witness.create(path.clone()).ok()?;
+                writeln!(file,"processed_prefix_frames={at}").and_then(|_|file.flush()).ok()?;
+            }
+        }
+    }
+    Some(())
+}
+fn context_body_read(decoder:&mut ffi::AudioStream,total:usize,crop:usize,frames:usize)->Option<Vec<f32>> {
+    if frames>NEST_BLOCK || crop.checked_add(frames)? > total.checked_add(1)? {return None;}
+    let count=frames.min(total.saturating_sub(crop));
+    let mut values=if count==0 {Vec::new()}else{decoder.read(count)?};
+    if values.len()!=count*2 || values.iter().any(|v|!v.is_finite()) {return None;}
+    values.resize(frames*2,0.0);Some(values)
+}
