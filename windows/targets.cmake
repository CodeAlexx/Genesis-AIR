# Exercise the exact compositor source used by the worker, including failure
# recovery of its retained OpenCL canvases. Private candidate builds can override
# the source without changing the canonical worker checkout.
set(GENESIS_COMPOSITOR_SOURCE "${GENESIS_ROOT}/build-windows/gcompose-source/gcompose/csrc/fpx_gpu.c" CACHE FILEPATH "Compositor source under test")
set(GENESIS_OPENCL_HEADERS "${GENESIS_ROOT}/build-windows/deps/OpenCL-Headers" CACHE PATH "OpenCL headers for the canvas harness")
set(GENESIS_OPENCL_LIBRARY "${GENESIS_ROOT}/build-windows/deps/opencl-build/Release/OpenCL.lib" CACHE FILEPATH "OpenCL import library for the canvas harness")
file(TO_CMAKE_PATH "${GENESIS_COMPOSITOR_SOURCE}" genesis_compositor_include)
add_executable(genesis-compound-canvas "${GENESIS_ROOT}/tests/compound_canvas_windows.c")
target_include_directories(genesis-compound-canvas PRIVATE "${GENESIS_OPENCL_HEADERS}")
target_compile_features(genesis-compound-canvas PRIVATE c_std_11)
target_compile_definitions(genesis-compound-canvas PRIVATE CL_TARGET_OPENCL_VERSION=120 _USE_MATH_DEFINES _CRT_SECURE_NO_WARNINGS "GENESIS_COMPOSITOR_SOURCE=\"${genesis_compositor_include}\"")
target_link_libraries(genesis-compound-canvas PRIVATE "${GENESIS_OPENCL_LIBRARY}")
set_target_properties(genesis-compound-canvas PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
