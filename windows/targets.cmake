if(NOT GENESIS_GENERATED_DIR)
  set(GENESIS_GENERATED_DIR "${GENESIS_ROOT}/build-windows/generated")
endif()
foreach(name IN ITEMS headless controls native audio-device audio-playback audio-cancel preview-async preview-stream preview-input inspector live-paint project-safety picture-queue keyed-video window-cache editor-trim trim-history recovery-ownership media-session spatial-canvas fade-controls audio-fade-keys audio-nested audio-nested-cancel nested-audio-controls)
  add_executable(genesis-${name} "${GENESIS_GENERATED_DIR}/${name}.c")
  target_include_directories(genesis-${name} PRIVATE "${CMAKE_SOURCE_DIR}/runtime")
  target_link_libraries(genesis-${name} PRIVATE air_rt)
  set_target_properties(genesis-${name} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
endforeach()
add_executable(genesis-process-wait "${GENESIS_ROOT}/tests/process_wait_windows.c")
target_include_directories(genesis-process-wait PRIVATE "${CMAKE_SOURCE_DIR}/runtime" "${CMAKE_SOURCE_DIR}/runtime/windows")
target_link_libraries(genesis-process-wait PRIVATE air_rt)
set_target_properties(genesis-process-wait PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
add_executable(genesis-worker-wrapper "${GENESIS_ROOT}/tests/worker_wrapper.c")
target_link_libraries(genesis-worker-wrapper PRIVATE ws2_32)
set_target_properties(genesis-worker-wrapper PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")

add_executable(genesis-ui-pixels "${CMAKE_SOURCE_DIR}/tests/stdlib/ui_pixels.c")
target_include_directories(genesis-ui-pixels PRIVATE "${CMAKE_SOURCE_DIR}/runtime")
set_target_properties(genesis-ui-pixels PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")

add_executable(genesis-audio-clock "${GENESIS_ROOT}/tests/audio_clock.cpp")
target_compile_features(genesis-audio-clock PRIVATE cxx_std_17)
target_link_libraries(genesis-audio-clock PRIVATE winmm)
set_target_properties(genesis-audio-clock PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
