+// Runtime presentation bounds supplied by a validated accepted audio endpoint.
+// These helpers do not change clip/sequence geometry or serialize a duration.
+pub fn program_action_until(doc:ref<Document>,action:u32,total:i64) -> Transport effects {} {
+  let last:i64=if total>0 {total-1}else{0}
+  let next:Transport=apply_transport(doc.program,action,last)
+  struct.set(doc,next,field=program)
+  next
+}
+pub fn seek_until(doc:ref<Document>,frame:i64,total:i64) -> i64 effects {} {
+  let last:i64=if total>0 {total-1}else{0}
+  let want:i64=if frame<0 {0}else{if frame>last {last}else{frame}}
+  let old:Transport=doc.program
+  struct.set(doc,Transport {playing:old.playing,frame:want,mark_in:old.mark_in,mark_out:old.mark_out,rate:old.rate,looping:old.looping},field=program)
+  want
+}
+pub fn export_range_until(doc:ref<Document>,total:i64) -> Transport effects {} {
+  let old:Transport=doc.program
+  let start:i64=if old.mark_in>=0 {old.mark_in}else{0}
+  var finish:i64=if old.mark_out>=0 {old.mark_out}else{total}
+  if finish>total {finish=total}
+  if finish<start {finish=start}
+  Transport {playing:false,frame:old.frame,mark_in:start,mark_out:finish,rate:old.rate,looping:old.looping}
+}
