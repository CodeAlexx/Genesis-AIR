+      let kind: ref<string> = struct.borrow(filter,field=kind)
+      // A cloned timer restarts local time; echo graphs lose the original delay
+      // history. Refuse until a preserved time/state context is represented.
+      if str.eq(kind,"timer") or str.eq(kind,"delay") or str.eq(kind,"reverb") {return false}
+    }
+    i=i+1}
+  i=0
