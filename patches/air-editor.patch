+// The static source-time protocol is shared by editing and rendering. Speed filters
+// multiply the clip rate in stack order; animated rates need integrated source-time
+// metadata and are deliberately outside this fixed-rate representation.
+pub fn playback_rate(doc: ref<Document>, value: Clip) -> f64 effects {alloc} {
+  var rate: f64 = value.speed
+  var i: u32 = 0
+  loop {
+    let id: u64 = match filter_at(doc,value.id,i) {none=>{break},some(found)=>found,}
+    let kind: string = filter_kind(doc,id)
+    if filter_enabled(doc,id) and str.eq(str.view(kind),"speed") {rate=rate*filter_param(doc,id,"rate",1.0)}
+    i=i+1}
+  rate
+}
