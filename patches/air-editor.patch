+        extent.processing_length > ctx.length or ctx.offset+value.length > extent.processing_length or
+        extent.input_duration_us == 0 or extent.input_duration_us > 21600000000 {return false}
+    let endpoint:u64=match audio_sample(ctx.origin+extent.processing_length,ctx.fps) {none=>{return false},some(n)=>n,}
+    let duration:f64=math.floor(cast.float(extent.processing_length)*ctx.rate/ctx.fps*1000000.0+0.5)
+    if not math.is_finite(duration) or duration != cast.float(extent.input_duration_us) or
+        extent.processing_frames != endpoint-first or extent.processing_frames == 0 {return false}
+    let slot:u64=match source_slot(doc,value.source) {none=>{return false},some(n)=>n,}
+    let source:ref<Source> =array.borrow(struct.borrow(doc,field=sources),slot)
+    if source.frames <= 0 or not math.is_finite(source.fps) or source.fps <= 0.0 {return false}
+    let input_end:f64=cast.float(ctx.source_in)+cast.float(extent.processing_length)*ctx.rate
+    let available_end:f64=cast.float(source.frames)*(ctx.fps/source.fps)
+    if not math.is_finite(input_end) or input_end > available_end {return false}
+    processing_length=extent.processing_length
+  },}
+  let last:f64=cast.float(ctx.source_in)+cast.float(processing_length-1)*ctx.rate
+  // Descendant edits can shorten a retained compound analysis window. The audio
+  // planner pads that missing child span before parent DSP; direct media handles
+  // remain strict. Never discard/reanchor the stored window to fit the new child.
+  if not math.is_finite(last) or last > 9007199254740991.0 or
+      (value.nested == 0 and not trim_sample_valid(doc,value,last)) {return false}
+  true
+}
+fn audio_context_valid_scalar(doc:ref<Document>,value:Clip) -> bool effects {} {
+  let ctx:AudioContext=match value.audio_context {none=>{return true},some(saved)=>saved,}
+  if not audio_context_geometry(doc,value,ctx) {return false}
+  let rate:f64=playback_rate_scalar(doc,value)
+  if audio_tail_present(doc,value) and not audio_tail_context_supported_scalar(doc,value) {return false}
+  // A held clip retains its context as dormant metadata; resuming transforms it.
+  if rate == 0.0 {return true}
+  if not math.is_finite(rate) or rate != ctx.rate or value.reverse != ctx.reverse {return false}
+  let steps:i64=if ctx.reverse {ctx.length-ctx.offset-value.length}else{ctx.offset}
+  let body_anchor:f64=cast.float(value.source_in)
+  body_anchor == cast.float(ctx.source_in)+cast.float(steps)*ctx.rate
+}
+// Potential audio is independent of current mute/solo/enable state: later edits
+// may restore those descendants. Stream masks and source capabilities are durable.
+// Unknown/cyclic/over-budget graphs conservatively keep the processing context.
+fn audio_context_picture_filter(kind:str) -> bool effects {} {
+  str.eq(kind,"speed") or
+  str.eq(kind,"brightness") or
+  str.eq(kind,"contrast") or
+  str.eq(kind,"saturation") or
+  str.eq(kind,"gamma") or
+  str.eq(kind,"hue") or
+  str.eq(kind,"white_balance") or
+  str.eq(kind,"sharpen") or
+  str.eq(kind,"blur") or
+  str.eq(kind,"glow") or
+  str.eq(kind,"vignette") or
+  str.eq(kind,"grain") or
+  str.eq(kind,"sepia") or
+  str.eq(kind,"mono") or
+  str.eq(kind,"invert") or
+  str.eq(kind,"levels") or
+  str.eq(kind,"lift_gamma_gain") or
+  str.eq(kind,"crop") or
+  str.eq(kind,"size_position") or
+  str.eq(kind,"rotate") or
+  str.eq(kind,"flip") or
+  str.eq(kind,"mirror") or
+  str.eq(kind,"chroma_key") or
+  str.eq(kind,"mask") or
+  str.eq(kind,"opacity") or
+  str.eq(kind,"blend") or
+  str.eq(kind,"text") or
+  str.eq(kind,"timer") or
+  str.eq(kind,"denoise") or
+  str.eq(kind,"stabilize") or
+  str.eq(kind,"lut3d")
+}
+fn audio_extent_filters_valid(doc:ref<Document>,value:Clip) -> bool effects {} {
+  var at:u64=0
+  loop {if at >= array.len(struct.borrow(doc,field=filters)) {break}
+    let filter:ref<Filter> =array.borrow(struct.borrow(doc,field=filters),at)
+    if filter.clip == value.id and filter.enabled {
+      let kind:ref<string> =struct.borrow(filter,field=kind)
+      if not audio_context_picture_filter(kind) and not str.eq(kind,"compressor") and
+          not str.eq(kind,"gate") and not str.eq(kind,"limiter") and not str.eq(kind,"eq_3band") and
+          not str.eq(kind,"eq_10band") and not str.eq(kind,"normalize") and not str.eq(kind,"volume") and
+          not str.eq(kind,"mute") and not str.eq(kind,"pan") {return false}
+    }
+    at=at+1}
+  true
+}
+// The direct tail renderer retains the complete original graph and its actual
+// EOF suffix. Only this proven source/time domain may bypass the echo edit guard.
+fn audio_tail_filter(kind:str) -> bool effects {} {
+  str.eq(kind,"volume") or str.eq(kind,"mute") or str.eq(kind,"pan") or
+  str.eq(kind,"eq_3band") or str.eq(kind,"eq_10band") or
+  str.eq(kind,"compressor") or str.eq(kind,"gate") or str.eq(kind,"limiter") or
+  str.eq(kind,"delay") or str.eq(kind,"reverb")
+}
+fn audio_tail_present(doc:ref<Document>,value:Clip) -> bool effects {} {
+  if not clip_has_audio(value) {return false}
+  var at:u64=0
+  loop {if at >= array.len(struct.borrow(doc,field=filters)) {break}
+    let f:ref<Filter> =array.borrow(struct.borrow(doc,field=filters),at)
+    if f.clip == value.id and f.enabled and
+        (str.eq(struct.borrow(f,field=kind),"delay") or str.eq(struct.borrow(f,field=kind),"reverb")) {return true}
+    at=at+1}
+  false
+}
+type AudioTailKey = struct {blocked:bool,kind:u32,scoped:bool,identity:u64}
+fn audio_tail_kind(kind:str) -> u32 effects {} {
+  if str.eq(kind,"speed") {return 1}
+  if str.eq(kind,"volume") {return 2}
+  if str.eq(kind,"mute") {return 3}
+  if str.eq(kind,"pan") {return 4}
+  if str.eq(kind,"eq_3band") {return 5}
+  if str.eq(kind,"eq_10band") {return 6}
+  if str.eq(kind,"compressor") {return 7}
+  if str.eq(kind,"gate") {return 8}
+  if str.eq(kind,"limiter") {return 9}
+  if str.eq(kind,"delay") {return 10}
+  if str.eq(kind,"reverb") {return 11}
+  0
+}
+fn audio_tail_key_family(named:str,scoped:bool,identity:u64) -> AudioTailKey effects {} {
+  let dot:u64=match str.find(named,".") {none=>{return AudioTailKey {blocked:false,kind:0,scoped:scoped,identity:identity}},some(n)=>n,}
+  AudioTailKey {blocked:false,kind:audio_tail_kind(str.slice(named,0,dot)),scoped:scoped,identity:identity}
+}
+fn audio_tail_key_policy(named:str) -> AudioTailKey effects {} {
+  if str.eq(named,"pan") or str.eq(named,"speed") or
+      str.eq(named,"fade_in") or str.eq(named,"fade_out") {return AudioTailKey {blocked:true,kind:0,scoped:false,identity:0}}
+  if str.starts_with(named,"filter.") {
+    let rest:str=str.slice(named,7,str.len(named))
+    let dot:u64=match str.find(rest,".") {none=>{return AudioTailKey {blocked:false,kind:0,scoped:true,identity:0}},some(n)=>n,}
+    let identity:u64=match text.parse_u64(str.slice(rest,0,dot)) {none=>0,some(n)=>n,}
+    return audio_tail_key_family(str.slice(rest,dot+1,str.len(rest)),true,identity)
+  }
+  audio_tail_key_family(named,false,0)
+}
+fn audio_tail_key_supported(doc:ref<Document>,value:Clip,key:AudioTailKey) -> bool effects {} {
+  if key.blocked {return false}
+  if key.kind == 0 {return true}
+  var index:u64=0
+  loop {if index >= array.len(struct.borrow(doc,field=filters)) {break}
+    let f:ref<Filter> =array.borrow(struct.borrow(doc,field=filters),index)
+    index=index+1
+    if f.clip == value.id and f.enabled and audio_tail_kind(struct.borrow(f,field=kind)) == key.kind and
+        (not key.scoped or f.id == key.identity) {return false}
+  }
+  true
+}
+fn audio_tail_context_supported_scalar(doc:ref<Document>,value:Clip) -> bool effects {} {
+  let rate:f64=playback_rate_scalar(doc,value)
+  if not clip_has_audio(value) or value.source == 0 or value.nested != 0 or value.reverse or
+      (rate != 1.0 and rate != 0.0) {return false}
+  let ctx:AudioContext=audio_context_for_scalar(doc,value)
+  let body_anchor:f64=cast.float(value.source_in)
+  let context_anchor:f64=cast.float(ctx.source_in)+cast.float(ctx.offset)
+  if option.is_some(ctx.extent) or ctx.rate != 1.0 or ctx.reverse or
+      not audio_context_geometry(doc,value,ctx) or
+      body_anchor != context_anchor or
+      ctx.output_frames == 0 or ctx.output_frames > 1036800000 {return false}
+  let samples:f64=48000.0/ctx.fps
+  // Private admission: exact owner endpoint arithmetic, never local rounded durations.
+  let admitted_phase:bool=ctx.fps == 24.0 or ctx.fps == 30.0 or ctx.fps == 60.0 or
+    ctx.fps == 24000.0/1001.0 or ctx.fps == 30000.0/1001.0 or ctx.fps == 60000.0/1001.0
+  if not math.is_finite(samples) or samples < 1.0 {return false}
+  let slot:u64=match source_slot(doc,value.source) {none=>{return false},some(n)=>n,}
+  let source:ref<Source> =array.borrow(struct.borrow(doc,field=sources),slot)
+  let legacy_integral:bool=source.audio_rate == 48000 and samples == math.floor(samples)
+  if not legacy_integral and not admitted_phase {return false}
+  let available:f64=cast.float(source.frames)*(ctx.fps/source.fps)
+  let requested:f64=cast.float(ctx.source_in)+cast.float(ctx.length)
+  if not source.has_audio or (source.audio_rate != 48000 and source.audio_rate != 44100) or
+      not math.is_finite(available) or requested > available {return false}
+  var echo:bool=false
+  var at:u64=0
+  loop {if at >= array.len(struct.borrow(doc,field=filters)) {break}
+    let filter:ref<Filter> =array.borrow(struct.borrow(doc,field=filters),at)
+    at=at+1
+    if filter.clip != value.id or not filter.enabled {continue}
+    let identity:u64=filter.id
+    let speed:bool=str.eq(struct.borrow(filter,field=kind),"speed")
+    let supported:bool=audio_context_picture_filter(struct.borrow(filter,field=kind)) or audio_tail_filter(struct.borrow(filter,field=kind))
+    let has_echo:bool=str.eq(struct.borrow(filter,field=kind),"delay") or str.eq(struct.borrow(filter,field=kind),"reverb")
+    if speed {
+      if filter_param(doc,identity,"rate",1.0) != 1.0 {return false}
+    }else if not supported {return false}
+    if has_echo {echo=true}
+  }
+  if not echo {return false}
+  at=0
+  loop {if at >= array.len(struct.borrow(doc,field=keys)) {break}
+    let key:Key=array.get(struct.borrow(doc,field=keys),at)
+    at=at+1
+    if key.clip != value.id {continue}
+    if key.param == 0 or key.param > array.len(struct.borrow(doc,field=names)) {return false}
+    let policy:AudioTailKey=audio_tail_key_policy(array.borrow(struct.borrow(doc,field=names),key.param-1))
+    if not audio_tail_key_supported(doc,value,policy) {return false}
+  }
+  true
+}
+// Potential interval planning must still expose an offline original-end suffix
+// to the source-availability preflight instead of silently treating it as silence.
+pub fn audio_tail_context_potential(doc:ref<Document>,value:Clip) -> bool effects {alloc} {
+  playback_rate_scalar(doc,value) == 1.0 and audio_tail_context_supported_scalar(doc,value)
+}
+pub fn audio_tail_context_supported(doc:ref<Document>,value:Clip) -> bool effects {alloc} {
+  source_online(doc,value.source) and audio_tail_context_potential(doc,value)
+}
+type AudioContextWalk = struct {scans:u64}
+fn audio_context_descendant(doc:ref<Document>,value:Clip,depth:u64,budget:ref<AudioContextWalk>) -> bool effects {} {
+  if not clip_has_audio(value) {return false}
+  if value.source != 0 {
+    if value.nested != 0 {return true}
+    return match source_slot(doc,value.source) {none=>true,some(slot)=>struct.get(array.borrow(struct.borrow(doc,field=sources),slot),field=has_audio),}
+  }
+  if value.nested == 0 or depth >= 16 {return true}
+  match sequence_slot(doc,value.nested) {none=>{return true},some(_)=>{},}
+  var f:u64=0
+  loop {if f >= array.len(struct.borrow(doc,field=filters)) {break}
+    if struct.get(budget,field=scans) >= 65536 {return true}
+    struct.set(budget,struct.get(budget,field=scans)+1,field=scans)
+    let filter:ref<Filter> =array.borrow(struct.borrow(doc,field=filters),f)
+    if filter.clip == value.id and not audio_context_picture_filter(str.view(struct.borrow(filter,field=kind))) {return true}
+    f=f+1}
+  var i:u64=0
+  loop {if i >= array.len(struct.borrow(doc,field=clips)) {break}
+    if struct.get(budget,field=scans) >= 65536 {return true}
+    struct.set(budget,struct.get(budget,field=scans)+1,field=scans)
+    let child:Clip=array.get(struct.borrow(doc,field=clips),i)
+    if child.owner == value.nested and audio_context_descendant(doc,child,depth+1,budget) {return true}
+    i=i+1}
+  false
+}
+fn audio_context_needed(doc:ref<Document>,value:Clip) -> bool effects {} {
+  if not clip_has_audio(value) or playback_rate_scalar(doc,value) <= 0.0 {return false}
+  var budget:AudioContextWalk=AudioContextWalk {scans:0}
+  audio_context_descendant(doc,value,0,budget)
+}
+// Preserve/extend a full processing window explicitly. Inward edits only change
+// body offset/crop; outward edits declare a larger history window and source anchor.
+fn audio_context_cut(doc:ref<Document>,old:Clip,next:Clip,delta:i64) -> option<Clip> effects {} {
+  var answer:Clip=next
+  if old.source_in == next.source_in and old.length == next.length and delta == 0 {return option.some(answer)}
+  if not audio_context_needed(doc,old) and not option.is_some(old.audio_context) {return option.some(answer)}
+  if not audio_context_valid_scalar(doc,old) {return option.none()}
+  audio_context_adjust(doc,next,audio_context_for_scalar(doc,old),delta)
+}
+fn audio_context_adjust(doc:ref<Document>,next:Clip,original:AudioContext,delta:i64) -> option<Clip> effects {} {
+  var answer:Clip=next
+  var ctx:AudioContext=original
+  let shifted:i64=add.sat(ctx.offset,delta)
+  if audio_tail_present(doc,next) and
+      (shifted < 0 or shifted > ctx.length or next.length > ctx.length-shifted) {return option.none()}
+  if shifted < 0 {
+    let extra:i64=-shifted
+    let anchor:f64=cast.float(ctx.source_in)-if ctx.reverse {0.0}else{cast.float(extra)*ctx.rate}
+    if ctx.length > 9007199254740991-extra or anchor < 0.0 or anchor != math.floor(anchor) {return option.none()}
+    struct.set(ctx,cast.sat(anchor),field=source_in)
+    // Extending past a moved original origin explicitly adopts the current phase.
+    struct.set(ctx,if ctx.origin >= extra {ctx.origin-extra}else{next.start},field=origin)
+    struct.set(ctx,ctx.length+extra,field=length)
+    struct.set(ctx,0,field=offset)
+    match ctx.extent {none=>{},some(extent)=>{
+      var extended:AudioExtent=extent
+      struct.set(extended,extent.processing_length+extra,field=processing_length)
+      struct.set(ctx,option.some(extended),field=extent)
+    },}
+  }else{struct.set(ctx,shifted,field=offset)}
+  if next.length > ctx.length-ctx.offset {
+    let extra:i64=next.length-(ctx.length-ctx.offset)
+    let anchor:f64=cast.float(ctx.source_in)-if ctx.reverse {cast.float(extra)*ctx.rate}else{0.0}
+    if ctx.length > 9007199254740991-extra or anchor < 0.0 or anchor != math.floor(anchor) {return option.none()}
+    struct.set(ctx,cast.sat(anchor),field=source_in)
+    struct.set(ctx,ctx.length+extra,field=length)
+  }
+  let first:u64=match audio_sample(ctx.origin,ctx.fps) {none=>{return option.none()},some(n)=>n,}
+  let crop:u64=match audio_sample(add.sat(ctx.origin,ctx.offset),ctx.fps) {none=>{return option.none()},some(n)=>n,}
+  let end:u64=match audio_sample(add.sat(ctx.origin,ctx.length),ctx.fps) {none=>{return option.none()},some(n)=>n,}
+  struct.set(ctx,crop-first,field=crop_start)
+  struct.set(ctx,end-first,field=output_frames)
+  match ctx.extent {none=>{},some(extent)=>{
+    let endpoint:u64=match audio_sample(ctx.origin+extent.processing_length,ctx.fps) {none=>{return option.none()},some(n)=>n,}
+    let duration:f64=math.floor(cast.float(extent.processing_length)*ctx.rate/ctx.fps*1000000.0+0.5)
+    if not math.is_finite(duration) or duration <= 0.0 or duration > 21600000000.0 {return option.none()}
+    struct.set(ctx,option.some(AudioExtent {input_duration_us:cast.sat(duration),processing_length:extent.processing_length,
+      processing_frames:endpoint-first}),field=extent)
+  },}
+  struct.set(answer,option.some(ctx),field=audio_context)
+  if not audio_context_geometry(doc,answer,ctx) {return option.none()}
+  if audio_tail_present(doc,answer) and not audio_tail_context_supported_scalar(doc,answer) {return option.none()}
+  option.some(answer)
+}
+// Explicit retime/slip preserves the complete span and its original sample phase.
+fn audio_context_retime(doc:ref<Document>,next:Clip,rate:f64) -> option<Clip> effects {} {
+  var answer:Clip=next
+  var ctx:AudioContext=match next.audio_context {none=>{return option.some(answer)},some(saved)=>saved,}
+  if not math.is_finite(rate) or rate < 0.0 {return option.none()}
+  if rate == 0.0 {
+    if audio_tail_present(doc,answer) and not audio_tail_context_supported_scalar(doc,answer) {return option.none()}
+    return option.some(answer)
+  }
+  let retimed:bool=ctx.rate != rate or ctx.reverse != next.reverse
+  let steps:i64=if next.reverse {ctx.length-ctx.offset-next.length}else{ctx.offset}
+  let anchor:f64=cast.float(next.source_in)-cast.float(steps)*rate
+  if not math.is_finite(anchor) or anchor < 0.0 or anchor > 9007199254740991.0 or anchor != math.floor(anchor) {return option.none()}
+  let saved_anchor:f64=cast.float(ctx.source_in)
+  if audio_tail_present(doc,next) and (rate != 1.0 or next.reverse or anchor != saved_anchor) {return option.none()}
+  struct.set(ctx,cast.sat(anchor),field=source_in)
+  struct.set(ctx,rate,field=rate)
+  struct.set(ctx,next.reverse,field=reverse)
+  // A forward body may fit the source even when its durable original window
+  // would need unavailable suffix handles at the new rate. Represent that input
+  // extent explicitly; never resize the original context or invent source PCM.
+  if (option.is_some(ctx.extent) and retimed) or (not option.is_some(ctx.extent) and next.nested == 0 and not trim_sample_valid(doc,next,
+      cast.float(ctx.source_in)+cast.float(ctx.length-1)*rate)) {
+    if next.nested != 0 or next.reverse {return option.none()}
+    let slot:u64=match source_slot(doc,next.source) {none=>{return option.none()},some(n)=>n,}
+    let source:ref<Source> =array.borrow(struct.borrow(doc,field=sources),slot)
+    if source.frames <= 0 or not math.is_finite(source.fps) or source.fps <= 0.0 {return option.none()}
+    let available:f64=(cast.float(source.frames)*(ctx.fps/source.fps)-cast.float(ctx.source_in))/rate
+    let endpoint:f64=if available < cast.float(ctx.length) {available}else{cast.float(ctx.length)}
+    let body_end:f64=cast.float(ctx.offset+next.length)
+    if not math.is_finite(endpoint) or endpoint <= 0.0 or endpoint != math.floor(endpoint) or
+        endpoint > 9007199254740991.0 or body_end > endpoint {return option.none()}
+    if not audio_extent_filters_valid(doc,next) {return option.none()}
+    let length:i64=cast.sat(endpoint)
+    let first:u64=match audio_sample(ctx.origin,ctx.fps) {none=>{return option.none()},some(n)=>n,}
+    let end:u64=match audio_sample(ctx.origin+length,ctx.fps) {none=>{return option.none()},some(n)=>n,}
+    let duration:f64=math.floor(cast.float(length)*rate/ctx.fps*1000000.0+0.5)
+    if not math.is_finite(duration) or duration <= 0.0 or duration > 21600000000.0 or end <= first {return option.none()}
+    struct.set(ctx,option.some(AudioExtent {input_duration_us:cast.sat(duration),processing_length:length,
+      processing_frames:end-first}),field=extent)
+  }
+  struct.set(answer,option.some(ctx),field=audio_context)
+  if not audio_context_geometry(doc,answer,ctx) {return option.none()}
+  if audio_tail_present(doc,answer) and not audio_tail_context_supported_scalar(doc,answer) {return option.none()}
+  option.some(answer)
+}
+
+fn audio_context_reconcile(doc:ref<Document>) -> bool effects {} {
+  var i:u64=0
+  loop {if i >= clip_count(doc) {break}
+    let old:Clip=option.unwrap(clip_at(doc,i))
+    let next:Clip=match audio_context_retime(doc,old,playback_rate_scalar(doc,old)) {none=>{return false},some(found)=>found,}
+    put_clip(doc,i,next)
+    i=i+1}
+  true
+}
+// A preflight must not intern names, allocate IDs, or change any document field.
+// source_in stores an integral LOWER source bound, including for reversed clips.
+// Reject cuts whose fractional phase or active fade cannot be represented by Clip.
+pub fn split_possible(doc: ref<Document>, id: u64, frame: i64) -> bool effects {alloc} {
+  let old: Clip = match clip(doc,id) {none=>{return false},some(value)=>value,}
+  if not audio_context_valid(doc,old) {return false}
+  let offset: i64 = frame-old.start
+  if offset <= 0 or offset >= old.length or track_locked(doc,old.track) {return false}
+  if old.source_in < 0 or old.fade_in < 0 or old.fade_out < 0 {return false}
+  if offset < old.fade_in or old.length-offset < old.fade_out {return false}
+  let rate: f64 = playback_rate(doc,old)
+  if not math.is_finite(rate) or rate < 0.0 {return false}
+  let advanced: f64 = cast.float(if old.reverse {old.length-offset} else {offset})*rate
+  if not math.is_finite(advanced) or advanced != math.floor(advanced) or
+      advanced >= cast.float(9223372036854775807-old.source_in) {return false}
+  var i: u64 = 0
+  loop {if i >= array.len(struct.borrow(doc,field=filters)) {break}
+    let filter: ref<Filter> = array.borrow(struct.borrow(doc,field=filters),i)
+    if filter.clip == id and filter.enabled {
+      let kind: ref<string> = struct.borrow(filter,field=kind)
+      // Timers still restart local picture time. Echo edits require the exact
+      // direct full-history/EOF-tail renderer, rather than a cloned local graph.
+      if (str.eq(kind,"timer") and clip_has_video(old)) or
+          ((str.eq(kind,"delay") or str.eq(kind,"reverb")) and clip_has_audio(old) and
+            not audio_tail_context_supported(doc,old)) {return false}
