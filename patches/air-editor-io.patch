-pub fn schema_revision() -> u64 effects {} { 2 }
+pub fn schema_revision() -> u64 effects {} { 5 }
+
+// Revision 5 = the document carries track automation: sequence-wide keys (clip 0) named
+// `track.<id>.gain` / `track.<id>.pan` whose frames are timeline frames of the track's
+// owning sequence. Every other sequence-wide name is ignored here. New automated mixer
+// parameters must keep the `track.<id>.<param>` prefix; a decoder that does not know the
+// parameter refuses (strict) instead of skipping it.
+fn track_key_parts(name: str) -> array<string> effects {alloc} {
+  var parts: array<string> = text.split(name,".")
+  if array.len(parts) == 3 and str.eq(str.view(array.borrow(parts,0)),"track") {
+    let id: u64 = match text.parse_u64(str.view(array.borrow(parts,1))) {none=>0,some(found)=>found,}
+    let digits: string = string.from_int(id)
+    if id > 0 and str.eq(str.view(digits),str.view(array.borrow(parts,1))) {return parts}
+  }
+  var none: array<string> = array.new()
+  none
+}
+// The track a `track.<id>.<param>` name addresses, or 0 when it is not a track key name.
+pub fn track_key_track(name: str) -> u64 effects {alloc} {
+  var parts: array<string> = track_key_parts(name)
+  if array.len(parts) == 0 {return 0}
+  match text.parse_u64(str.view(array.borrow(parts,1))) {none=>0,some(found)=>found,}
+}
+// 0 not a track key name, 1 gain, 2 pan, 3 a track-scoped name this build does not know.
+pub fn track_key_param(name: str) -> u64 effects {alloc} {
+  var parts: array<string> = track_key_parts(name)
+  if array.len(parts) == 0 {return 0}
+  let param: str = str.view(array.borrow(parts,2))
+  if str.eq(param,"gain") {return 1}
+  if str.eq(param,"pan") {return 2}
+  3
+}
+// Track automation validity. Keys that are not track keys are always acceptable here.
+pub fn track_key_valid(doc: ref<editor.Document>, key: editor.Key) -> bool effects {alloc} {
+  if key.clip != 0 {return true}
+  let name: string = editor.name_text(doc,key.param)
+  let kind: u64 = track_key_param(str.view(name))
+  if kind == 0 {return true}
+  if kind == 3 {return false}
+  let track: u64 = track_key_track(str.view(name))
+  let slot: u64 = match editor.track_slot(doc,track) {none=>{return false},some(found)=>found,}
+  if struct.get(array.borrow(struct.borrow(doc,field=tracks),slot),field=owner) != key.owner {return false}
+  if not math.is_finite(key.value) {return false}
+  if kind == 1 and (key.value < 0.0 or key.value > 3.4028234663852886e38) {return false}
+  if kind == 2 and (key.value < -1.0 or key.value > 1.0) {return false}
+  if key.interp >= curve.interp_count() {return false}
+  if key.frame < -9007199254740991 or key.frame > 9007199254740991 {return false}
+  true
+}
 
