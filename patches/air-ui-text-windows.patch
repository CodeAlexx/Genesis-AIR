+/* Canvas editing policy belongs to AIR. Paste transfers committed scalars through
+   the same ordered, growing queue as WM_CHAR; it never edits a widget or document. */
+static int queue_clipboard_text(air_win_window *window, const WCHAR *wide, SIZE_T capacity) {
+    if (wide == NULL) return 0;
+    SIZE_T length = 0;
+    while (length < capacity && length <= AIR_WIN_CLIPBOARD_UNITS_LIMIT && wide[length] != 0)
+        ++length;
+    if (length == capacity || length > AIR_WIN_CLIPBOARD_UNITS_LIMIT) return 0;
+    if (length == 0) return 1;
+    if (window->pending_surrogate != 0)
+        push_event(window, 10u, 0xfffdu, window->pending_text_modifiers);
+    window->pending_surrogate = 0;
+    for (SIZE_T index = 0; index < length; ++index) {
+        uint32_t scalar = wide[index];
+        if (scalar >= 0xd800u && scalar <= 0xdbffu) {
+            if (index + 1 < length && wide[index + 1] >= 0xdc00u && wide[index + 1] <= 0xdfffu) {
+                scalar = 0x10000u + ((scalar - 0xd800u) << 10u) + (wide[++index] - 0xdc00u);
+            } else scalar = 0xfffdu;
+        } else if (scalar >= 0xdc00u && scalar <= 0xdfffu) scalar = 0xfffdu;
+        push_event(window, 10u, scalar, 0u);
+    }
+    return 1;
+}
+
+static void paste_clipboard(air_win_window *window) {
+    if (!OpenClipboard(window->handle)) return;
+    HGLOBAL memory = (HGLOBAL)GetClipboardData(CF_UNICODETEXT);
+    if (memory != NULL) {
+        SIZE_T bytes = GlobalSize(memory);
+        if (bytes >= sizeof(WCHAR) && bytes % sizeof(WCHAR) == 0) {
+            const WCHAR *wide = (const WCHAR *)GlobalLock(memory);
+            if (wide != NULL) {
+                (void)queue_clipboard_text(window, wide, bytes / sizeof(WCHAR));
+                (void)GlobalUnlock(memory);
+            }
+        }
+    }
+    (void)CloseClipboard();
+}
