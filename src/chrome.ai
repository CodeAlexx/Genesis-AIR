// Chrome: the interactive controls, described once.
//
// A button that is painted in one place and hit-tested in another eventually disagrees with
// itself. So every clickable thing in Genesis AIR is built here, as a `Control` carrying its
// own rectangle, label and current state. `genesis.view` paints a list of controls;
// `genesis.input` hit-tests the SAME list and dispatches the action it finds. Neither one
// computes a rectangle of its own.
//
// A control never edits the document. It names an action; `genesis.commands` performs it.
module genesis.chrome

import std.editor as editor
import std.editor_view as editor_view
import std.timeline as timeline
import std.math as math
import std.vector_font as font
import "app.ai" as app
import "layout.ai" as layout

