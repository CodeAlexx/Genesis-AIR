// ---------------------------------------------------------------------------

pub type Control = struct {
  action: u32,
  style: u32,
  domain: u32,
  target: u64,
  kind: string,
  name: string,
  label: string,
  area: layout.Rect,
  on: bool,
  enabled: bool,
  value: f64,
  low: f64,
  high: f64,
  step: f64,
  // The type size this control's box was MEASURED at. The painter draws at the same size,
  // so a label can never be wider than the button built for it.
  size: f64
}

fn blank() -> Control effects {alloc} {
  Control {action: act_none(), style: style_text(), domain: domain_none(), target: 0,
    kind: string.new(), name: string.new(), label: string.new(), area: layout.rect(0.0, 0.0, 0.0, 0.0),
    on: false, enabled: true, value: 0.0, low: 0.0, high: 1.0, step: 0.1, size: 0.0}
}

pub fn button(action: u32, label: str, area: layout.Rect, on: bool) -> Control effects {alloc} {
  var made: Control = blank()
  struct.set(made, action, field=action)
  struct.set(made, style_button(), field=style)
  struct.set(made, on, field=on)
  let _ = ref.swap(struct.borrow(made, field=label), string.copy(label))
  struct.set(made, area, field=area)
  made
}

pub fn toggle(action: u32, label: str, area: layout.Rect, on: bool) -> Control effects {alloc} {
  var made: Control = button(action, label, area, on)
  struct.set(made, style_toggle(), field=style)
  made
}

pub fn label_of(control: ref<Control>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(control, field=label)))
}
pub fn name_of(control: ref<Control>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(control, field=name)))
}
pub fn kind_of(control: ref<Control>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(control, field=kind)))
}

// The topmost control under a point. Later controls win, which is what an overlapping
// stepper drawn on top of its row should do.
pub fn hit(controls: ref<array<Control>>, x: f64, y: f64) -> option<u64> effects {} {
  var found: option<u64> = option.none()
  var index: u64 = 0
  loop {
    if index >= array.len(controls) { break }
    let entry: ref<Control> = array.borrow(controls, index)
    if struct.get(entry, field=enabled)
      and struct.get(entry, field=action) != act_none()
      and layout.contains(struct.get(entry, field=area), x, y) {
      found = option.some(index)
    }
    index = index + 1
  }
  found
}

// ---------------------------------------------------------------------------
// The top toolbar.

// Toolbar type. The top toolbar has the whole window width and uses the title size. The
// timeline toolbar carries fourteen buttons in the narrower column left of the dock and has
// to come down a step to fit them; ten is the floor, below which the letterforms go.
pub fn top_bar_type() -> f64 effects {} { 12.0 }
pub fn timeline_bar_type() -> f64 effects {} { 10.0 }
fn bar_pad() -> f64 effects {} { 8.0 }

fn strip(out: ref<array<Control>>, left: f64, top: f64, height: f64, action: u32,
         label: str, on: bool, toggling: bool, size: f64) -> f64 effects {alloc} {
  let wide: f64 = font.text_vector_width(label, size) + bar_pad() * 2.0
  var made: Control = button(action, label, layout.rect(left, top, left + wide, top + height), on)
  struct.set(made, size, field=size)
  if toggling { struct.set(made, style_toggle(), field=style) }
  array.push(out, made)
  left + wide + 3.0
}

pub fn toolbar(frame: layout.Frame, state: ref<app.App>) -> array<Control> effects {alloc} {
  var out: array<Control> = array.new()
  let area: layout.Rect = frame.toolbar
  let size: f64 = top_bar_type()
  let top: f64 = area.top + 4.0
  let height: f64 = layout.toolbar_height() - 8.0
  var x: f64 = 8.0
  x = strip(out, x, top, height, act_import(), "Add", false, false, size)
  x = strip(out, x, top, height, act_open(), "Open", false, false, size)
  x = strip(out, x, top, height, act_save(), "Save", app.dirty(state), false, size)
  x = strip(out, x, top, height, act_new(), "New", false, false, size)
  x = strip(out, x, top, height, act_render(), "Render", false, false, size)
  x = x + 10.0
  x = strip(out, x, top, height, act_undo(), "Undo", false, false, size)
  x = strip(out, x, top, height, act_redo(), "Redo", false, false, size)
  x = x + 10.0
  x = strip(out, x, top, height, act_razor_all(), "Razor all tracks", false, false, size)
  x = x + 10.0
  x = strip(out, x, top, height, act_go_start(), "Start", false, false, size)
  x = strip(out, x, top, height, act_step_back(), "Prev", false, false, size)
  let playing: bool = editor.playing(struct.borrow(state, field=document))
  x = strip(out, x, top, height, act_play(), if playing { "Pause" } else { "Play" }, playing, true, size)
  x = strip(out, x, top, height, act_step_forward(), "Next", false, false, size)
  x = strip(out, x, top, height, act_go_end(), "End", false, false, size)
  x = x + 10.0
  x = strip(out, x, top, height, act_reload(), "Reload", false, false, size)
  out
}

// The timeline toolbar.
//
// It carries the most buttons of any strip and sits in the narrowest column, so it MEASURES
// before it lays out: the zoom cluster is reserved at the right, the main run is priced at
// each candidate size, and the largest size that fits is the one used. Laying out first and
// hoping is how the Group and Snap buttons ended up underneath Zoom out, where a click on
// either of them zoomed instead.
fn run_width(labels: ref<array<string>>, size: f64) -> f64 effects {alloc} {
  var total: f64 = 0.0
  var index: u64 = 0
  loop {
    if index >= array.len(labels) { break }
    let owned: string = string.copy(str.view(array.borrow(labels, index)))
    total = total + font.text_vector_width(str.view(owned), size) + bar_pad() * 2.0 + 3.0
    index = index + 1
  }
  total
}

pub fn timeline_bar(frame: layout.Frame, state: ref<app.App>) -> array<Control> effects {alloc} {
  var out: array<Control> = array.new()
  let area: layout.Rect = frame.tbar
  let top: f64 = area.top + 3.0
  let height: f64 = layout.tbar_height() - 6.0

  let playing_paste: bool = app.has_clipboard(state)
  let snapping: bool = app.snap(state)
  var labels: array<string> = ["Split", "Razor all", "Lift", "Ripple", "Cut", "Copy",
    "Paste", "Append", "Overwrite", "Insert", "Marker", "Transition", "Group", "Snap"]
  var actions: array<u32> = [act_split(), act_razor_all(), act_lift(), act_ripple(),
    act_cut(), act_copy(), act_paste(), act_append(), act_overwrite(), act_insert(),
    act_marker(), act_transition(), act_group(), act_snap()]
  var zoom_labels: array<string> = ["Zoom in", "Fit", "Zoom out"]
  var zoom_actions: array<u32> = [act_zoom_in(), act_zoom_fit(), act_zoom_out()]

  // Pick the size, then reserve the zoom cluster from the right at that size.
  var size: f64 = timeline_bar_type()
  loop {
    if size <= 8.0 { break }
    let needed: f64 = run_width(labels, size) + run_width(zoom_labels, size) + 16.0
    if needed <= layout.width_of(area) { break }
    size = size - 1.0
  }
  var right: f64 = area.right - 4.0
  var index: u64 = 0
  loop {
    if index >= array.len(zoom_labels) { break }
    let text: str = str.view(array.borrow(zoom_labels, index))
    let wide: f64 = font.text_vector_width(text, size) + bar_pad() * 2.0
    var zoomer: Control = button(array.get(zoom_actions, index), text,
      layout.rect(right - wide, top, right, top + height), false)
    struct.set(zoomer, size, field=size)
    array.push(out, zoomer)
    right = right - wide - 3.0
    index = index + 1
  }
  let limit: f64 = right - 6.0

  var x: f64 = area.left + 4.0
  index = 0
  loop {
    if index >= array.len(labels) { break }
    let text: str = str.view(array.borrow(labels, index))
    let wide: f64 = font.text_vector_width(text, size) + bar_pad() * 2.0
    // A button that will not fit is NOT built. An unbuilt button is not painted and cannot
    // be clicked, which is better than one drawn on top of another control's rectangle.
    if x + wide > limit { break }
    let action: u32 = array.get(actions, index)
    var made: Control = button(action, text, layout.rect(x, top, x + wide, top + height),
      if action == act_paste() { playing_paste } else if action == act_snap() { snapping }
      else { false })
    struct.set(made, size, field=size)
    if action == act_snap() { struct.set(made, style_toggle(), field=style) }
    array.push(out, made)
    x = x + wide + 3.0
    index = index + 1
  }
  out
}

// ---------------------------------------------------------------------------
// The dock tabs.

pub fn tab_properties() -> u32 effects {} { 0 }
pub fn tab_filters() -> u32 effects {} { 1 }
pub fn tab_scopes() -> u32 effects {} { 2 }
pub fn tab_audio() -> u32 effects {} { 3 }

pub fn tab_name(which: u32) -> string effects {alloc} {
  if which == tab_filters() { return string.copy("Filters") }
  if which == tab_scopes() { return string.copy("Scopes") }
  if which == tab_audio() { return string.copy("Audio") }
  string.copy("Properties")
}

// The largest type size at which every label fits across `width` with `padding` on each
// side of each one, down to a floor of eight.
fn fitted_size(labels: ref<array<string>>, width: f64, padding: f64,
               start: f64) -> f64 effects {alloc} {
  var characters: f64 = 0.0
  var index: u64 = 0
  loop {
    if index >= array.len(labels) { break }
    characters = characters + cast.float(str.len(str.view(array.borrow(labels, index))))
    index = index + 1
  }
  let slots: f64 = cast.float(array.len(labels))
  var size: f64 = start
  loop {
    if size <= 8.0 { break }
    if characters * size + padding * 2.0 * slots <= width { break }
    size = size - 1.0
  }
  size
}

pub fn dock_tabs(frame: layout.Frame, state: ref<app.App>) -> array<Control> effects {alloc} {
  var out: array<Control> = array.new()
  let area: layout.Rect = frame.dock_tabs
  let chosen: u32 = app.dock_tab(state)
  // Tabs are as wide as their own names, not an equal quarter each: "Properties" is twice
  // "Audio", and splitting the strip evenly clipped it to "Propert".
  var names: array<string> = array.new()
  var total: f64 = 0.0
  var index: u32 = 0
  loop {
    if index >= 4 { break }
    array.push(names, tab_name(index))
    total = total + cast.float(str.len(str.view(array.borrow(names, cast.wrap(index)))))
    index = index + 1
  }
  let padding: f64 = 6.0
  let size: f64 = fitted_size(names, layout.width_of(area), padding, top_bar_type())
  // Any width the names do not use is shared out, so the strip still spans the dock.
  let slack: f64 = (layout.width_of(area) - total * size - padding * 8.0) / 4.0
  var left: f64 = area.left
  index = 0
  loop {
    if index >= 4 { break }
    let seat: u64 = cast.wrap(index)
    let text: str = str.view(array.borrow(names, seat))
    let wide: f64 = font.text_vector_width(text, size) + padding * 2.0 + slack
    var made: Control = button(act_tab(), text,
      layout.rect(left, area.top, left + wide, area.bottom), index == chosen)
    struct.set(made, style_tab(), field=style)
    struct.set(made, seat, field=target)
    struct.set(made, size, field=size)
    array.push(out, made)
    left = left + wide
    index = index + 1
  }
  out
}

// ---------------------------------------------------------------------------
// The filter library.
//
// A kind is a plain string, exactly as `std.editor` stores it, and its parameters are
// described here rather than assumed by the painting code. That is what lets the inspector
// show a real control per parameter instead of a bare list of names.

pub type Spec = struct {
  name: string, label: string, low: f64, high: f64, step: f64, fallback: f64
}

fn sp(out: ref<array<Spec>>, name: str, label: str, low: f64, high: f64, step: f64,
      fallback: f64) -> unit effects {alloc} {
  array.push(out, Spec {name: string.copy(name), label: string.copy(label), low: low,
    high: high, step: step, fallback: fallback})
  ()
}

pub fn video_kinds() -> array<string> effects {alloc} {
  ["brightness", "contrast", "saturation", "gamma", "hue", "white_balance", "sharpen",
   "blur", "glow", "vignette", "grain", "sepia", "mono", "invert", "levels",
   "lift_gamma_gain", "crop", "size_position", "rotate", "flip", "mirror", "chroma_key",
   "mask", "opacity", "blend", "text", "timer", "denoise", "stabilize", "lut3d", "speed"]
}

pub fn audio_kinds() -> array<string> effects {alloc} {
  ["gain", "pan", "eq_3band", "eq_10band", "compressor", "gate", "normalize", "reverb",
   "delay", "pitch", "low_pass", "high_pass", "tremolo", "bass", "treble", "notch",
   "chorus", "flanger", "phaser", "limiter"]
}

pub fn library_kinds() -> array<string> effects {alloc} {
  var out: array<string> = array.new()
  var video: array<string> = video_kinds()
  var index: u64 = 0
  loop {
    if index >= array.len(video) { break }
    array.push(out, string.copy(str.view(array.borrow(video, index))))
    index = index + 1
  }
  var audio: array<string> = audio_kinds()
  index = 0
  loop {
    if index >= array.len(audio) { break }
    array.push(out, string.copy(str.view(array.borrow(audio, index))))
    index = index + 1
  }
  out
}

// True when the kind belongs to the audio half of the library, which is drawn apart.
pub fn is_audio_kind(kind: str) -> bool effects {alloc} {
  var audio: array<string> = audio_kinds()
  var index: u64 = 0
  loop {
    if index >= array.len(audio) { break }
    if str.eq(str.view(array.borrow(audio, index)), kind) { return true }
    index = index + 1
  }
  false
}

pub fn params_for(kind: str) -> array<Spec> effects {alloc} {
  var out: array<Spec> = array.new()
  if str.eq(kind, "brightness") { sp(out, "level", "Brightness", 0.0, 2.0, 0.05, 1.0) }
  else if str.eq(kind, "contrast") { sp(out, "level", "Contrast", 0.0, 2.0, 0.05, 1.0) }
  else if str.eq(kind, "saturation") { sp(out, "level", "Saturation", 0.0, 2.0, 0.05, 1.0) }
  else if str.eq(kind, "gamma") { sp(out, "level", "Gamma", 0.1, 3.0, 0.05, 1.0) }
  else if str.eq(kind, "hue") { sp(out, "shift", "Hue", -180.0, 180.0, 5.0, 0.0) }
  else if str.eq(kind, "white_balance") {
    sp(out, "temperature", "Temperature", -100.0, 100.0, 2.0, 0.0)
    sp(out, "tint", "Tint", -100.0, 100.0, 2.0, 0.0)
  }
  else if str.eq(kind, "sharpen") { sp(out, "amount", "Amount", 0.0, 2.0, 0.05, 0.0) }
  else if str.eq(kind, "blur") { sp(out, "radius", "Radius", 0.0, 40.0, 1.0, 0.0) }
  else if str.eq(kind, "glow") {
    sp(out, "amount", "Amount", 0.0, 1.0, 0.05, 0.0)
    sp(out, "threshold", "Threshold", 0.0, 1.0, 0.05, 0.7)
  }
  else if str.eq(kind, "vignette") {
    sp(out, "amount", "Amount", 0.0, 1.0, 0.05, 0.4)
    sp(out, "softness", "Softness", 0.0, 1.0, 0.05, 0.5)
  }
  else if str.eq(kind, "grain") { sp(out, "amount", "Amount", 0.0, 1.0, 0.02, 0.2) }
  else if str.eq(kind, "sepia") { sp(out, "amount", "Amount", 0.0, 1.0, 0.05, 1.0) }
  else if str.eq(kind, "mono") { sp(out, "amount", "Amount", 0.0, 1.0, 0.05, 1.0) }
  else if str.eq(kind, "invert") { sp(out, "amount", "Amount", 0.0, 1.0, 0.05, 1.0) }
  else if str.eq(kind, "levels") {
    sp(out, "black", "Black", 0.0, 1.0, 0.02, 0.0)
    sp(out, "white", "White", 0.0, 1.0, 0.02, 1.0)
    sp(out, "gamma", "Gamma", 0.1, 3.0, 0.05, 1.0)
  }
  else if str.eq(kind, "lift_gamma_gain") {
    sp(out, "lift", "Lift", -1.0, 1.0, 0.02, 0.0)
    sp(out, "gamma", "Gamma", 0.1, 3.0, 0.05, 1.0)
    sp(out, "gain", "Gain", 0.0, 3.0, 0.05, 1.0)
  }
  else if str.eq(kind, "crop") {
    sp(out, "left", "Left", 0.0, 1.0, 0.01, 0.0)
    sp(out, "top", "Top", 0.0, 1.0, 0.01, 0.0)
    sp(out, "right", "Right", 0.0, 1.0, 0.01, 0.0)
    sp(out, "bottom", "Bottom", 0.0, 1.0, 0.01, 0.0)
  }
  else if str.eq(kind, "size_position") {
    sp(out, "x", "PiP X", -1.0, 1.0, 0.01, 0.0)
    sp(out, "y", "PiP Y", -1.0, 1.0, 0.01, 0.0)
    sp(out, "w", "PiP W", 0.0, 2.0, 0.01, 1.0)
    sp(out, "h", "PiP H", 0.0, 2.0, 0.01, 1.0)
    sp(out, "rotation", "Rotation", -180.0, 180.0, 1.0, 0.0)
    sp(out, "opacity", "Opacity", 0.0, 1.0, 0.02, 1.0)
  }
  else if str.eq(kind, "rotate") { sp(out, "angle", "Angle", -180.0, 180.0, 1.0, 0.0) }
  else if str.eq(kind, "flip") { sp(out, "vertical", "Vertical", 0.0, 1.0, 1.0, 0.0) }
  else if str.eq(kind, "mirror") { sp(out, "horizontal", "Horizontal", 0.0, 1.0, 1.0, 1.0) }
  else if str.eq(kind, "chroma_key") {
    sp(out, "hue", "Key hue", 0.0, 360.0, 5.0, 120.0)
    sp(out, "tolerance", "Tolerance", 0.0, 1.0, 0.02, 0.25)
    sp(out, "softness", "Softness", 0.0, 1.0, 0.02, 0.10)
  }
  else if str.eq(kind, "mask") {
    sp(out, "feather", "Feather", 0.0, 1.0, 0.02, 0.1)
    sp(out, "invert", "Invert", 0.0, 1.0, 1.0, 0.0)
  }
  else if str.eq(kind, "opacity") { sp(out, "level", "Opacity", 0.0, 1.0, 0.02, 1.0) }
  else if str.eq(kind, "blend") { sp(out, "mode", "Blend mode", 0.0, 11.0, 1.0, 0.0) }
  else if str.eq(kind, "text") {
    sp(out, "size", "Size", 4.0, 200.0, 2.0, 36.0)
    sp(out, "x", "X", -1.0, 1.0, 0.01, 0.0)
    sp(out, "y", "Y", -1.0, 1.0, 0.01, 0.0)
  }
  else if str.eq(kind, "timer") { sp(out, "size", "Size", 4.0, 200.0, 2.0, 36.0) }
  else if str.eq(kind, "denoise") { sp(out, "amount", "Amount", 0.0, 1.0, 0.02, 0.3) }
  else if str.eq(kind, "stabilize") { sp(out, "strength", "Strength", 0.0, 1.0, 0.02, 0.5) }
  else if str.eq(kind, "lut3d") { sp(out, "amount", "Amount", 0.0, 1.0, 0.02, 1.0) }
  else if str.eq(kind, "speed") { sp(out, "rate", "Rate", 0.1, 4.0, 0.05, 1.0) }
  else if str.eq(kind, "gain") { sp(out, "level", "Gain dB", -60.0, 12.0, 0.5, 0.0) }
  else if str.eq(kind, "pan") { sp(out, "position", "Pan", -1.0, 1.0, 0.02, 0.0) }
  else if str.eq(kind, "eq_3band") {
    sp(out, "low", "EQ Low", -20.0, 20.0, 0.5, 0.0)
    sp(out, "mid", "EQ Mid", -20.0, 20.0, 0.5, 0.0)
    sp(out, "high", "EQ High", -20.0, 20.0, 0.5, 0.0)
    sp(out, "pan", "Pan", -1.0, 1.0, 0.02, 0.0)
  }
  else if str.eq(kind, "eq_10band") {
    sp(out, "band0", "31 Hz", -12.0, 12.0, 0.5, 0.0)
    sp(out, "band1", "62 Hz", -12.0, 12.0, 0.5, 0.0)
    sp(out, "band2", "125 Hz", -12.0, 12.0, 0.5, 0.0)
    sp(out, "band3", "250 Hz", -12.0, 12.0, 0.5, 0.0)
    sp(out, "band4", "500 Hz", -12.0, 12.0, 0.5, 0.0)
    sp(out, "band5", "1 kHz", -12.0, 12.0, 0.5, 0.0)
    sp(out, "band6", "2 kHz", -12.0, 12.0, 0.5, 0.0)
    sp(out, "band7", "4 kHz", -12.0, 12.0, 0.5, 0.0)
    sp(out, "band8", "8 kHz", -12.0, 12.0, 0.5, 0.0)
    sp(out, "band9", "16 kHz", -12.0, 12.0, 0.5, 0.0)
  }
  else if str.eq(kind, "compressor") {
    sp(out, "threshold", "Threshold", -60.0, 0.0, 1.0, -18.0)
    sp(out, "ratio", "Ratio", 1.0, 20.0, 0.5, 4.0)
    sp(out, "attack", "Attack ms", 0.0, 200.0, 1.0, 10.0)
    sp(out, "release", "Release ms", 0.0, 1000.0, 10.0, 120.0)
  }
  else if str.eq(kind, "gate") {
    sp(out, "threshold", "Threshold", -80.0, 0.0, 1.0, -45.0)
    sp(out, "hold", "Hold ms", 0.0, 500.0, 5.0, 50.0)
  }
  else if str.eq(kind, "normalize") { sp(out, "target", "Target LUFS", -30.0, 0.0, 0.5, -14.0) }
  else if str.eq(kind, "reverb") {
    sp(out, "amount", "Amount", 0.0, 1.0, 0.02, 0.3)
    sp(out, "room", "Room", 0.0, 1.0, 0.02, 0.5)
  }
  else if str.eq(kind, "delay") {
    sp(out, "time", "Delay ms", 0.0, 2000.0, 10.0, 250.0)
    sp(out, "decay", "Delay decay", 0.0, 1.0, 0.02, 0.4)
  }
  else if str.eq(kind, "pitch") { sp(out, "semitones", "Pitch", -12.0, 12.0, 0.5, 0.0) }
  else if str.eq(kind, "low_pass") { sp(out, "cutoff", "Low pass Hz", 20.0, 20000.0, 100.0, 8000.0) }
  else if str.eq(kind, "high_pass") { sp(out, "cutoff", "High pass Hz", 20.0, 20000.0, 20.0, 80.0) }
  else if str.eq(kind, "tremolo") {
    sp(out, "rate", "Rate Hz", 0.1, 20.0, 0.1, 5.0)
    sp(out, "depth", "Depth", 0.0, 1.0, 0.02, 0.5)
  }
  else if str.eq(kind, "bass") { sp(out, "level", "Bass", -20.0, 20.0, 0.5, 0.0) }
  else if str.eq(kind, "treble") { sp(out, "level", "Treble", -20.0, 20.0, 0.5, 0.0) }
  else if str.eq(kind, "notch") {
    sp(out, "frequency", "Notch Hz", 20.0, 20000.0, 50.0, 1000.0)
    sp(out, "width", "Width", 0.1, 10.0, 0.1, 1.0)
  }
  else if str.eq(kind, "chorus") {
    sp(out, "depth", "Depth", 0.0, 1.0, 0.02, 0.4)
    sp(out, "rate", "Rate Hz", 0.1, 10.0, 0.1, 1.5)
  }
  else if str.eq(kind, "flanger") {
    sp(out, "depth", "Depth", 0.0, 1.0, 0.02, 0.4)
    sp(out, "rate", "Rate Hz", 0.1, 10.0, 0.1, 0.5)
  }
  else if str.eq(kind, "phaser") {
    sp(out, "depth", "Depth", 0.0, 1.0, 0.02, 0.5)
    sp(out, "rate", "Rate Hz", 0.1, 10.0, 0.1, 0.8)
  }
  else if str.eq(kind, "limiter") { sp(out, "ceiling", "Ceiling dB", -12.0, 0.0, 0.1, -1.0) }
  else { sp(out, "amount", "Amount", 0.0, 1.0, 0.02, 1.0) }
  out
}

// The blend modes the "blend" filter's `mode` parameter selects between.
pub fn blend_modes() -> array<string> effects {alloc} {
  ["Over", "Add", "Screen", "Multiply", "Overlay", "Darken", "Lighten", "Difference",
   "Subtract", "Hard light", "Soft light", "Colour dodge"]
}

pub fn blend_name(mode: f64) -> string effects {alloc} {
  var names: array<string> = blend_modes()
  let index: u64 = cast.sat(math.max(0.0, mode))
  if index >= array.len(names) { return string.copy("Over") }
  string.copy(str.view(array.borrow(names, index)))
}

// ---------------------------------------------------------------------------
// Dock rows.
//
// Rows are laid out top-down from a cursor. Every row that leaves the panel is still
// produced but marked disabled and clipped away by the painter, so a scroll position never
// changes which row an action belongs to.

pub fn row_height() -> f64 effects {} { 22.0 }
pub fn head_height() -> f64 effects {} { 26.0 }

fn heading(out: ref<array<Control>>, area: layout.Rect, top: f64,
           text: str) -> f64 effects {alloc} {
  var made: Control = button(act_none(), text,
    layout.rect(area.left + 4.0, top, area.right - 4.0, top + head_height()), false)
  struct.set(made, style_heading(), field=style)
  array.push(out, made)
  top + head_height()
}

fn text_row(out: ref<array<Control>>, area: layout.Rect, top: f64, text: str,
            detail: str) -> f64 effects {alloc} {
  var made: Control = button(act_none(), text,
    layout.rect(area.left + 4.0, top, area.right - 4.0, top + row_height()), false)
  struct.set(made, style_text(), field=style)
  let _ = ref.swap(struct.borrow(made, field=name), string.copy(detail))
  array.push(out, made)
  top + row_height()
}

// One parameter: a name, a decrement, a bar that can be clicked to a position, an
// increment, a keyframe button and the current reading.
fn param_row(out: ref<array<Control>>, area: layout.Rect, top: f64, domain: u32,
             target: u64, kind: str, name: str, text: str, value: f64, low: f64,
             high: f64, step: f64, live: bool) -> f64 effects {alloc} {
  let bottom: f64 = top + row_height()
  let left: f64 = area.left + 4.0
  let right: f64 = area.right - 4.0
  // Label, decrement, bar, increment, keyframe, reading — in that order, with the reading
  // painted just past the keyframe button. Every offset is relative to the bar so the row
  // stays correct if the dock's width changes.
  let bar_left: f64 = left + 152.0
  let bar_right: f64 = right - 112.0

  var lab: Control = button(act_none(), text, layout.rect(left, top, bar_left - 30.0, bottom), false)
  struct.set(lab, style_row(), field=style)
  struct.set(lab, value, field=value)
  array.push(out, lab)

  var down: Control = button(act_param_dec(), "-",
    layout.rect(bar_left - 26.0, top + 1.0, bar_left - 4.0, bottom - 1.0), false)
  var bar: Control = button(act_param_set(), text, layout.rect(bar_left, top + 2.0, bar_right,
    bottom - 2.0), live)
  struct.set(bar, style_slider(), field=style)
  var up: Control = button(act_param_inc(), "+",
    layout.rect(bar_right + 2.0, top + 1.0, bar_right + 24.0, bottom - 1.0), false)
  let keyable: bool = domain != domain_track()
  var key: Control = button(if keyable { act_param_key() } else { act_none() }, "K",
    layout.rect(bar_right + 26.0, top + 1.0, bar_right + 48.0, bottom - 1.0), false)
  struct.set(key, keyable, field=enabled)

  struct.set(down, domain, field=domain)
  struct.set(bar, domain, field=domain)
  struct.set(up, domain, field=domain)
  struct.set(key, domain, field=domain)
  struct.set(down, target, field=target)
  struct.set(bar, target, field=target)
  struct.set(up, target, field=target)
  struct.set(key, target, field=target)
  struct.set(down, value, field=value)
  struct.set(bar, value, field=value)
  struct.set(up, value, field=value)
  struct.set(key, value, field=value)
  struct.set(down, low, field=low)
  struct.set(bar, low, field=low)
  struct.set(up, low, field=low)
  struct.set(key, low, field=low)
  struct.set(down, high, field=high)
  struct.set(bar, high, field=high)
  struct.set(up, high, field=high)
  struct.set(key, high, field=high)
  struct.set(down, step, field=step)
  struct.set(bar, step, field=step)
  struct.set(up, step, field=step)
  struct.set(key, step, field=step)
  let _ = ref.swap(struct.borrow(down, field=name), string.copy(name))
  let _ = ref.swap(struct.borrow(bar, field=name), string.copy(name))
  let _ = ref.swap(struct.borrow(up, field=name), string.copy(name))
  let _ = ref.swap(struct.borrow(key, field=name), string.copy(name))
  let _ = ref.swap(struct.borrow(down, field=kind), string.copy(kind))
  let _ = ref.swap(struct.borrow(bar, field=kind), string.copy(kind))
  let _ = ref.swap(struct.borrow(up, field=kind), string.copy(kind))
  let _ = ref.swap(struct.borrow(key, field=kind), string.copy(kind))
  array.push(out, down)
  array.push(out, bar)
  array.push(out, up)
  array.push(out, key)
  bottom
}

fn switch_row(out: ref<array<Control>>, area: layout.Rect, top: f64, action: u32,
              domain: u32, target: u64, kind: str, name: str, text: str,
              on: bool) -> f64 effects {alloc} {
  var made: Control = toggle(action, text,
    layout.rect(area.left + 4.0, top, area.right - 4.0, top + row_height()), on)
  struct.set(made, domain, field=domain)
  struct.set(made, target, field=target)
  let _ = ref.swap(struct.borrow(made, field=name), string.copy(name))
  let _ = ref.swap(struct.borrow(made, field=kind), string.copy(kind))
  array.push(out, made)
  top + row_height()
}

// The filter of a given kind on a clip, or 0 when the clip does not carry one yet. The
// inspector shows every parameter whether or not its filter exists; touching one creates it.
pub fn filter_of_kind(doc: ref<editor.Document>, clip: u64, kind: str) -> u64 effects {alloc} {
  if clip == 0 { return 0 }
  let count: u64 = editor.filter_count(doc, clip)
  var position: u32 = 0
  loop {
    let seen: u64 = cast.wrap(position)
    if seen >= count { break }
    match editor.filter_at(doc, clip, position) {
      some(id) => {
        // Bind the owned name before viewing it: a view of a temporary would dangle.
        let owned: string = editor.filter_kind(doc, id)
        if str.eq(str.view(owned), kind) { return id }
      },
      none => { },
    }
    position = position + 1
  }
  0
}

// Every parameter of one filter kind, drawn whether or not the filter exists.
fn kind_section(out: ref<array<Control>>, area: layout.Rect, top: f64,
                doc: ref<editor.Document>, clip: u64, kind: str) -> f64 effects {alloc} {
  let id: u64 = filter_of_kind(doc, clip, kind)
  var specs: array<Spec> = params_for(kind)
  var cursor: f64 = top
  var index: u64 = 0
  loop {
    if index >= array.len(specs) { break }
    let spec: ref<Spec> = array.borrow(specs, index)
    let owned_name: string = string.copy(str.view(struct.borrow(spec, field=name)))
    let owned_label: string = string.copy(str.view(struct.borrow(spec, field=label)))
    let fallback: f64 = struct.get(spec, field=fallback)
    let value: f64 = if id == 0 { fallback }
      else { editor.filter_param(doc, id, str.view(owned_name), fallback) }
    cursor = param_row(out, area, cursor, domain_filter(), id, kind, str.view(owned_name),
      str.view(owned_label), value, struct.get(spec, field=low),
      struct.get(spec, field=high), struct.get(spec, field=step), id != 0)
    index = index + 1
  }
  cursor
}

// An effect the inspector offers as a switch: off means "the clip has no such filter", on
// means it carries one. Turning it on creates the filter; the parameters appear beneath.
fn effect_switch(out: ref<array<Control>>, area: layout.Rect, top: f64,
                 doc: ref<editor.Document>, clip: u64, kind: str,
                 text: str) -> f64 effects {alloc} {
  let id: u64 = filter_of_kind(doc, clip, kind)
  let on: bool = id != 0 and editor.filter_enabled(doc, id)
  var made: Control = toggle(if id == 0 { act_filter_add() } else { act_filter_toggle() },
    text, layout.rect(area.left + 4.0, top, area.right - 26.0, top + row_height()), on)
  struct.set(made, domain_filter(), field=domain)
  struct.set(made, id, field=target)
  let _ = ref.swap(struct.borrow(made, field=kind), string.copy(kind))
  array.push(out, made)
  if id != 0 {
    array.push(out, drop_button(area, top, id, kind))
  }
  var cursor: f64 = top + row_height()
  if id != 0 { cursor = kind_section(out, area, cursor, doc, clip, kind) }
  cursor
}

fn drop_button(area: layout.Rect, top: f64, id: u64, kind: str) -> Control effects {alloc} {
  var made: Control = button(act_filter_remove(), "x",
    layout.rect(area.right - 34.0, top + 1.0, area.right - 8.0, top + row_height() - 1.0), false)
  struct.set(made, domain_filter(), field=domain)
  struct.set(made, id, field=target)
  let _ = ref.swap(struct.borrow(made, field=kind), string.copy(kind))
  made
}

// ---------------------------------------------------------------------------
// Properties: everything about the selected clip, in one scrolling column.

pub fn properties_panel(frame: layout.Frame, state: ref<app.App>) -> array<Control> effects {alloc} {
  var out: array<Control> = array.new()
  let area: layout.Rect = frame.dock_body
  let clip: u64 = app.current_clip(state)
  let scroll: f64 = app.dock_scroll(state)
  var cursor: f64 = area.top + 6.0 - scroll
  let doc: ref<editor.Document> = struct.borrow(state, field=document)

  cursor = heading(out, area, cursor, "CLIP")
  match editor.clip(doc, clip) {
    none => { text_row(out, area, cursor, "no clip selected", "select a clip in the timeline") },
    some(value) => {
      let source_name: string = editor.source_name(doc, value.source)
      cursor = text_row(out, area, cursor, "Name", str.view(source_name))
      var range: string = string.copy("in ")
      string.append(range, str.view(string.from_int(value.source_in)))
      string.append(range, "  len ")
      string.append(range, str.view(string.from_int(value.length)))
      cursor = text_row(out, area, cursor, "Source", str.view(range))
      var span: string = string.copy(str.view(string.from_int(value.start)))
      string.append(span, " .. ")
      string.append(span, str.view(string.from_int(editor.clip_end(value))))
      cursor = text_row(out, area, cursor, "Timeline", str.view(span))
      let track_name: string = editor.track_name(doc, value.track)
      cursor = text_row(out, area, cursor, "Track", str.view(track_name))
    },
  }

  cursor = heading(out, area, cursor, "SIZE, POSITION & ROTATE")
  cursor = kind_section(out, area, cursor, doc, clip, "size_position")

  cursor = heading(out, area, cursor, "BLEND")
  let blend_id: u64 = filter_of_kind(doc, clip, "blend")
  let blend_value: f64 = if blend_id == 0 { 0.0 }
    else { editor.filter_param(doc, blend_id, "mode", 0.0) }
  let blend_label: string = blend_name(blend_value)
  cursor = text_row(out, area, cursor, "Mode", str.view(blend_label))
  cursor = param_row(out, area, cursor, domain_filter(), blend_id, "blend", "mode", "Blend mode",
    blend_value, 0.0, 11.0, 1.0, blend_id != 0)

  cursor = heading(out, area, cursor, "FADES")
  match editor.clip(doc, clip) {
    none => { },
    some(value) => {
      cursor = param_row(out, area, cursor, domain_clip(), clip, "", "fade_in", "Fade in",
        cast.float(value.fade_in), 0.0, 240.0, 1.0, clip != 0)
      cursor = param_row(out, area, cursor, domain_clip(), clip, "", "fade_out", "Fade out",
        cast.float(value.fade_out), 0.0, 240.0, 1.0, clip != 0)
    },
  }

  cursor = heading(out, area, cursor, "SPEED")
  match editor.clip(doc, clip) {
    none => { },
    some(value) => {
      let shown: string = math.format_fixed(value.speed, 3)
      cursor = text_row(out, area, cursor, "Speed", str.view(shown))
      cursor = text_row(out, area, cursor, "Reverse", if value.reverse { "on" } else { "off" })
      cursor = text_row(out, area, cursor, "note", "read only in std.editor")
    },
  }

  cursor = heading(out, area, cursor, "AUDIO")
  match editor.clip(doc, clip) {
    none => { },
    some(value) => {
      cursor = param_row(out, area, cursor, domain_clip(), clip, "", "gain", "Audio gain",
        value.gain, 0.0, 4.0, 0.05, clip != 0)
    },
  }
  cursor = kind_section(out, area, cursor, doc, clip, "eq_3band")

  cursor = heading(out, area, cursor, "DYNAMICS")
  cursor = effect_switch(out, area, cursor, doc, clip, "compressor", "Compress")
  cursor = effect_switch(out, area, cursor, doc, clip, "gate", "Gate")
  cursor = effect_switch(out, area, cursor, doc, clip, "normalize", "Normalize")
  cursor = effect_switch(out, area, cursor, doc, clip, "limiter", "Limiter")

  cursor = heading(out, area, cursor, "EFFECTS")
  cursor = effect_switch(out, area, cursor, doc, clip, "reverb", "Reverb")
  cursor = effect_switch(out, area, cursor, doc, clip, "delay", "Delay")
  cursor = effect_switch(out, area, cursor, doc, clip, "pitch", "Pitch")
  cursor = effect_switch(out, area, cursor, doc, clip, "low_pass", "Low pass")
  cursor = effect_switch(out, area, cursor, doc, clip, "high_pass", "High pass")
  cursor = effect_switch(out, area, cursor, doc, clip, "tremolo", "Tremolo")
  cursor = effect_switch(out, area, cursor, doc, clip, "bass", "Bass")
  cursor = effect_switch(out, area, cursor, doc, clip, "treble", "Treble")
  cursor = effect_switch(out, area, cursor, doc, clip, "notch", "Notch")
  cursor = effect_switch(out, area, cursor, doc, clip, "chorus", "Chorus")
  cursor = effect_switch(out, area, cursor, doc, clip, "flanger", "Flanger")
  cursor = effect_switch(out, area, cursor, doc, clip, "phaser", "Phaser")

  cursor = heading(out, area, cursor, "GRAPHIC EQ")
  cursor = kind_section(out, area, cursor, doc, clip, "eq_10band")

  cursor = heading(out, area, cursor, "CLIP GRADE")
  cursor = kind_section(out, area, cursor, doc, clip, "brightness")
  cursor = kind_section(out, area, cursor, doc, clip, "contrast")
  cursor = kind_section(out, area, cursor, doc, clip, "saturation")
  out
}

// The natural height of the properties column, so scrolling can be bounded.
pub fn panel_extent(controls: ref<array<Control>>, area: layout.Rect) -> f64 effects {} {
  var lowest: f64 = area.top
  var index: u64 = 0
  loop {
    if index >= array.len(controls) { break }
    let edge: f64 = struct.get(struct.get(array.borrow(controls, index), field=area), field=bottom)
    if edge > lowest { lowest = edge }
    index = index + 1
  }
  lowest - area.top
}

// ---------------------------------------------------------------------------
// Filters: the stack applied to the selected clip, and the library it is drawn from.

fn library_grid(out: ref<array<Control>>, area: layout.Rect, origin: f64,
                kinds: ref<array<string>>) -> f64 effects {alloc} {
  let columns: f64 = 2.0
  let each: f64 = (layout.width_of(area) - 12.0) / columns
  var index: u64 = 0
  loop {
    if index >= array.len(kinds) { break }
    let column: f64 = cast.float(index - (index / 2) * 2)
    let row: f64 = cast.float(index / 2)
    let left: f64 = area.left + 6.0 + column * each
    let top: f64 = origin + row * (row_height() + 1.0)
    let owned: string = string.copy(str.view(array.borrow(kinds, index)))
    var made: Control = button(act_filter_add(), str.view(owned),
      layout.rect(left, top, left + each - 3.0, top + row_height() - 1.0), false)
    struct.set(made, domain_filter(), field=domain)
    struct.set(made, 0, field=target)
    let _ = ref.swap(struct.borrow(made, field=kind), string.copy(str.view(owned)))
    array.push(out, made)
    index = index + 1
  }
  let rows: f64 = cast.float((array.len(kinds) + 1) / 2)
  origin + rows * (row_height() + 1.0) + 4.0
}

pub fn filters_panel(frame: layout.Frame, state: ref<app.App>) -> array<Control> effects {alloc} {
  var out: array<Control> = array.new()
  let area: layout.Rect = frame.dock_body
  let clip: u64 = app.current_clip(state)
  let picked: u64 = app.selected_filter(state)
  let scroll: f64 = app.dock_scroll(state)
  var cursor: f64 = area.top + 6.0 - scroll
  let doc: ref<editor.Document> = struct.borrow(state, field=document)

  cursor = heading(out, area, cursor, "STACK")
  let count: u64 = editor.filter_count(doc, clip)
  if clip == 0 {
    cursor = text_row(out, area, cursor, "no clip selected", "")
  } else if count == 0 {
    cursor = text_row(out, area, cursor, "no filters", "pick one from the library below")
  } else {
    var position: u32 = 0
    loop {
      let seen: u64 = cast.wrap(position)
      if seen >= count { break }
      match editor.filter_at(doc, clip, position) {
        none => { },
        some(id) => {
          let owned: string = editor.filter_kind(doc, id)
          let on: bool = editor.filter_enabled(doc, id)
          let widened_position: u64 = cast.wrap(position)
          let top: f64 = cursor
          var name_button: Control = toggle(act_filter_pick(), str.view(owned),
            layout.rect(area.left + 4.0, top, area.right - 118.0, top + row_height()),
            id == picked)
          struct.set(name_button, domain_filter(), field=domain)
          struct.set(name_button, id, field=target)
          struct.set(name_button, on, field=enabled)
          array.push(out, name_button)
          var eye: Control = toggle(act_filter_toggle(), if on { "on" } else { "off" },
            layout.rect(area.right - 116.0, top + 1.0, area.right - 88.0,
                        top + row_height() - 1.0), on)
          struct.set(eye, domain_filter(), field=domain)
          struct.set(eye, id, field=target)
          array.push(out, eye)
          var up: Control = button(act_filter_up(), "Up",
            layout.rect(area.right - 86.0, top + 1.0, area.right - 62.0,
                        top + row_height() - 1.0), false)
          struct.set(up, domain_filter(), field=domain)
          struct.set(up, id, field=target)
          struct.set(up, cast.float(widened_position), field=value)
          array.push(out, up)
          var down: Control = button(act_filter_down(), "Dn",
            layout.rect(area.right - 60.0, top + 1.0, area.right - 36.0,
                        top + row_height() - 1.0), false)
          struct.set(down, domain_filter(), field=domain)
          struct.set(down, id, field=target)
          struct.set(down, cast.float(widened_position), field=value)
          array.push(out, down)
          array.push(out, drop_button(area, top, id, str.view(owned)))
          cursor = cursor + row_height()
        },
      }
      position = position + 1
    }
    // The parameters of whichever filter is selected, so the stack is editable in place.
    if picked != 0 {
      let owned: string = editor.filter_kind(doc, picked)
      cursor = heading(out, area, cursor, str.view(owned))
      cursor = kind_section(out, area, cursor, doc, clip, str.view(owned))
    }
  }

  cursor = heading(out, area, cursor, "LIBRARY — VIDEO")
  var video: array<string> = video_kinds()
  cursor = library_grid(out, area, cursor, video)
  cursor = heading(out, area, cursor, "LIBRARY — AUDIO")
  var audio: array<string> = audio_kinds()
  cursor = library_grid(out, area, cursor, audio)
  out
}

// ---------------------------------------------------------------------------
// Audio: a strip per audio track, plus the mix controls the mixer used to hold.

pub fn audio_panel(frame: layout.Frame, state: ref<app.App>) -> array<Control> effects {alloc} {
  var out: array<Control> = array.new()
  let area: layout.Rect = frame.dock_body
  let scroll: f64 = app.dock_scroll(state)
  // The meters occupy the top of the panel; the strips scroll beneath them.
  var cursor: f64 = area.top + meter_height() + 6.0 - scroll
  let doc: ref<editor.Document> = struct.borrow(state, field=document)
  let sequence: u64 = doc.active
  var lanes: array<u64> = editor_view.lanes(doc, sequence)
  var index: u64 = 0
  var seen: u64 = 0
  loop {
    if index >= array.len(lanes) { break }
    let id: u64 = array.get(lanes, index)
    if editor.track_kind(doc, id) == editor.track_audio() {
      let owned: string = editor.track_name(doc, id)
      cursor = heading(out, area, cursor, str.view(owned))
      cursor = param_row(out, area, cursor, domain_track(), id, "", "gain", "Gain",
        editor.track_gain(doc, id), 0.0, 2.0, 0.05, true)
      cursor = param_row(out, area, cursor, domain_track(), id, "", "pan", "Pan",
        editor.track_pan(doc, id), -1.0, 1.0, 0.05, true)
      let top: f64 = cursor
      let half: f64 = (area.left + area.right) * 0.5
      var mute: Control = toggle(act_track_mute(), "Mute",
        layout.rect(area.left + 4.0, top, half - 2.0, top + row_height()),
        not editor.track_audible(doc, id))
      struct.set(mute, domain_track(), field=domain)
      struct.set(mute, id, field=target)
      array.push(out, mute)
      var solo: Control = toggle(act_track_solo(), "Solo",
        layout.rect(half + 2.0, top, area.right - 4.0, top + row_height()), false)
      struct.set(solo, domain_track(), field=domain)
      struct.set(solo, id, field=target)
      match editor.track_slot(doc, id) {
        none => { },
        some(slot) => {
          let entry: ref<editor.Track> = array.borrow(struct.borrow(doc, field=tracks), slot)
          struct.set(solo, struct.get(entry, field=solo), field=on)
        },
      }
      array.push(out, solo)
      cursor = cursor + row_height() + 4.0
      seen = seen + 1
    }
    index = index + 1
  }
  if seen == 0 { text_row(out, area, cursor, "no audio tracks", "add one with +A") }
  out
}

pub fn meter_height() -> f64 effects {} { 128.0 }

// ---------------------------------------------------------------------------
// Scopes: the readouts are painted from the program frame; these are their switches.

pub fn scopes_panel(frame: layout.Frame, state: ref<app.App>) -> array<Control> effects {alloc} {
  var out: array<Control> = array.new()
  let area: layout.Rect = frame.dock_body
  // The scopes are read from the program frame the monitor already fetched on this repaint,
  // so there is nothing to refresh; the only action here is exporting what is on screen.
  let top: f64 = area.bottom - row_height() - 6.0
  var render: Control = button(act_render(), "Render still",
    layout.rect(area.left + 6.0, top, area.right - 6.0, top + row_height()), false)
  struct.set(render, top_bar_type(), field=size)
  array.push(out, render)
  out
}

// ---------------------------------------------------------------------------
// Track headers: the per-track switches, laid out on the same lane rows the timeline drew.

pub fn track_controls(frame: layout.Frame, state: ref<app.App>,
                      model: ref<timeline.Timeline>) -> array<Control> effects {alloc} {
  var out: array<Control> = array.new()
  let area: layout.Rect = frame.headers
  let doc: ref<editor.Document> = struct.borrow(state, field=document)
  let sequence: u64 = doc.active
  var lanes: array<u64> = editor_view.lanes(doc, sequence)
  let total: u64 = array.len(lanes)
  var lane: u64 = 0
  loop {
    if lane >= total { break }
    if lane >= array.len(struct.borrow(model, field=tracks)) { break }
    let id: u64 = array.get(lanes, total - 1 - lane)
    let top: f64 = timeline.track_top(model, lane)
    if top > area.bottom - 12.0 { break }
    var hidden: bool = false
    var locked: bool = false
    var muted: bool = false
    var soloed: bool = false
    match editor.track_slot(doc, id) {
      none => { },
      some(slot) => {
        let entry: ref<editor.Track> = array.borrow(struct.borrow(doc, field=tracks), slot)
        hidden = struct.get(entry, field=hidden)
        locked = struct.get(entry, field=locked)
        muted = struct.get(entry, field=muted)
        soloed = struct.get(entry, field=solo)
      },
    }
    let row: f64 = top + 18.0
    let size: f64 = 18.0
    var x: f64 = area.left + 8.0
    var index: u64 = 0
    var labels: array<string> = ["eye", "L", "M", "S", "x"]
    var actions: array<u32> = [act_track_hidden(), act_track_lock(), act_track_mute(),
                               act_track_solo(), act_track_remove()]
    var flags: array<bool> = [not hidden, locked, muted, soloed, false]
    loop {
      if index >= array.len(labels) { break }
      let text: str = str.view(array.borrow(labels, index))
      var made: Control = toggle(array.get(actions, index), text,
        layout.rect(x, row, x + size + 14.0, row + size), array.get(flags, index))
      struct.set(made, domain_track(), field=domain)
      struct.set(made, id, field=target)
      if index == 4 { struct.set(made, style_button(), field=style) }
      array.push(out, made)
      x = x + size + 17.0
      index = index + 1
    }
    lane = lane + 1
  }
  // The two track-adding buttons sit under the last lane, as in every editor.
  let foot: f64 = area.bottom - 26.0
  var add_video: Control = button(act_add_video_track(), "+V",
    layout.rect(area.left + 8.0, foot, area.left + 52.0, foot + 21.0), false)
  array.push(out, add_video)
  var add_audio: Control = button(act_add_audio_track(), "+A",
    layout.rect(area.left + 58.0, foot, area.left + 102.0, foot + 21.0), false)
  array.push(out, add_audio)
  out
}

// ---------------------------------------------------------------------------
// The media pool: one control per row, plus the actions that apply to the highlighted one.

pub fn pool_row_height() -> f64 effects {} { 32.0 }

pub fn pool_controls(frame: layout.Frame, state: ref<app.App>) -> array<Control> effects {alloc} {
  var out: array<Control> = array.new()
  let area: layout.Rect = frame.pool
  let highlighted: u64 = app.pool_row(state)
  let doc: ref<editor.Document> = struct.borrow(state, field=document)
  let count: u64 = editor.source_count(doc)
  let foot: f64 = area.bottom - 28.0
  var y: f64 = area.top + 22.0
  var index: u64 = 0
  loop {
    if index >= count { break }
    if y + pool_row_height() > foot { break }
    let entry: ref<editor.Source> = array.borrow(struct.borrow(doc, field=sources), index)
    let owned: string = string.copy(str.view(struct.borrow(entry, field=name)))
    var made: Control = toggle(act_pool_pick(), str.view(owned),
      layout.rect(area.left + 4.0, y, area.right - 4.0, y + pool_row_height() - 3.0),
      index == highlighted)
    struct.set(made, domain_source(), field=domain)
    struct.set(made, struct.get(entry, field=id), field=target)
    struct.set(made, struct.get(entry, field=online), field=enabled)
    struct.set(made, style_row(), field=style)
    array.push(out, made)
    y = y + pool_row_height()
    index = index + 1
  }
  // Actions on the highlighted source.
  var chosen: u64 = 0
  if highlighted < count {
    chosen = struct.get(array.borrow(struct.borrow(doc, field=sources), highlighted), field=id)
  }
  var labels: array<string> = ["Relink", "Add clip", "Source"]
  var actions: array<u32> = [act_pool_relink(), act_pool_add_clip(), act_pool_source()]
  let padding: f64 = 5.0
  let available: f64 = layout.width_of(area) - 12.0
  let size: f64 = fitted_size(labels, available, padding, top_bar_type())
  var characters: f64 = 0.0
  var count: u64 = 0
  loop {
    if count >= array.len(labels) { break }
    characters = characters + cast.float(str.len(str.view(array.borrow(labels, count))))
    count = count + 1
  }
  let slack: f64 = (available - characters * size - padding * 6.0) / 3.0
  var x: f64 = area.left + 6.0
  var index2: u64 = 0
  loop {
    if index2 >= 3 { break }
    let text: str = str.view(array.borrow(labels, index2))
    let wide: f64 = font.text_vector_width(text, size) + padding * 2.0 + slack
    var made: Control = button(array.get(actions, index2), text,
      layout.rect(x, foot + 2.0, x + wide - 3.0, foot + 23.0), false)
    struct.set(made, domain_source(), field=domain)
    struct.set(made, chosen, field=target)
    struct.set(made, chosen != 0, field=enabled)
    struct.set(made, size, field=size)
    array.push(out, made)
    x = x + wide
    index2 = index2 + 1
  }
  out
}

// The panel a dock tab shows. One place decides, so painting and hit testing agree.
pub fn dock_panel(frame: layout.Frame, state: ref<app.App>) -> array<Control> effects {alloc} {
  let which: u32 = app.dock_tab(state)
  if which == tab_filters() { return filters_panel(frame, state) }
  if which == tab_scopes() { return scopes_panel(frame, state) }
  if which == tab_audio() { return audio_panel(frame, state) }
  properties_panel(frame, state)
}
