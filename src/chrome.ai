pub fn style_toggle() -> u32 effects {} { 1 }
pub fn style_tab() -> u32 effects {} { 2 }
pub fn style_slider() -> u32 effects {} { 3 }
pub fn style_stepper() -> u32 effects {} { 4 }
pub fn style_row() -> u32 effects {} { 5 }
pub fn style_heading() -> u32 effects {} { 6 }
pub fn style_pip() -> u32 effects {} { 7 }
pub fn style_text() -> u32 effects {} { 8 }

// What a control acts on, so one generic parameter action can serve clips, filters and
// tracks without a separate action number for every field.
pub fn domain_none() -> u32 effects {} { 0 }
pub fn domain_clip() -> u32 effects {} { 1 }
pub fn domain_filter() -> u32 effects {} { 2 }
pub fn domain_track() -> u32 effects {} { 3 }
pub fn domain_source() -> u32 effects {} { 4 }

