// Genesis AIR application state.
//
// THE PROJECT IS AUTHORITATIVE. `document` is a `std.editor.Document` and it is the only
// place project facts live. Everything else in this record is view state: which panel is
// focused, what the timeline is scrolled to, which media pool row is highlighted. A widget
// never holds a second copy of a clip, a track or a transport position — if it is a project
// fact, it is read from the document at paint time.
//
// The flow is always:  input -> command -> document changes -> repaint.
module genesis.app

import std.application_theme as themes
import std.files as files
import std.path as path
import std.math as math
import std.draw as draw
import std.font as font
import std.text as text
import std.editor as editor
import std.editor_io as editor_io
import "provider.ai" as provider
import "typeface.ai" as typeface
import "ui_text.ai" as ui_text
import "linked_media.ai" as linked_media

// The panels a keystroke can be aimed at. The filter stack, the properties column and the
// mixer used to be panels of their own; they are tabs of the dock now, and `chrome` decides
// which tab is showing, so there is one place that knows and not four.
pub fn panel_pool() -> u32 effects {} { 0 }
pub fn panel_source() -> u32 effects {} { 1 }
pub fn panel_program() -> u32 effects {} { 2 }
pub fn panel_timeline() -> u32 effects {} { 6 }
pub fn panel_dock() -> u32 effects {} { 7 }
pub fn panel_toolbar() -> u32 effects {} { 8 }
pub fn panel_menu() -> u32 effects {} { 9 }

// The timeline viewport. `std.editor_view` derives its geometry from these, so zoom and pan
// are ordinary application state rather than a hidden second model. The NLE toolkit records
// viewport policy as deliberately unported; this is where it lives until it is proved
// generic enough to upstream.
pub type Viewport = struct { pixels_per_frame: f64, scroll_frames: i64, track_height: f64,
  first_track: u64, track_sequence: u64 }

// Peak data for one audio clip, keyed by the clip's STABLE id. The view reads this; only a
// refresh step fills it, so painting never calls the media provider.
pub type Waveform = struct {clip: u64, source: u64, length: i64, first: i64, last: i64, revision: u64, document_revision: u64, peaks: array<f64>}
pub type Thumbnail = struct {clip: u64, frame: i64, source: u64, source_frame: i64,
  revision: u64, document_revision: u64, pixels: draw.Surface}

// What a press on a clip started. A drag is view state, not a project fact: nothing is
// written to the document until the gesture resolves into a command.
pub fn drag_none() -> u32 effects {} { 0 }
pub fn drag_move() -> u32 effects {} { 1 }
pub fn drag_trim_start() -> u32 effects {} { 2 }
pub fn drag_trim_end() -> u32 effects {} { 3 }
pub fn drag_scrub() -> u32 effects {} { 4 }
pub fn drag_source_scrub() -> u32 effects {} { 5 }
pub fn drag_program_scrub() -> u32 effects {} { 6 }

pub type Drag = struct {
  kind: u32,
  clip: u64,
  grab_frame: i64,
  origin_start: i64,
  origin_in: i64,
  origin_length: i64,
  origin_track: u64,
  moved: bool
}

pub fn drag() -> Drag effects {} {
  Drag {kind: drag_none(), clip: 0, grab_frame: 0, origin_start: 0, origin_in: 0,
    origin_length: 0, origin_track: 0, moved: false}
}

// The shared editor owns a frozen authored clip payload. Project replacement
// retires it; ordinary edits and Undo leave the copied settings untouched.


// A modal draft owns its opening target; selection is independent view state.
pub type Prompt = struct { active: bool, action: u32, label: string, buffer: string, feedback: string,
  caret:u64,anchor:u64,first_row:u64,scroll_x:f64,goal_x:f64,dragging:bool,
  target_filter:u64,target_clip:u64,target_sequence:u64,target_project:u64,
  target_kind:string,original:string,multiline:bool,
  target_transition:u64,target_track:u64,target_center:i64,target_duration:i64 }

// A deferred project replacement belongs to the session, never to the document.
pub type ProjectAction = enum { None, New, Open, Recover, Close }
pub type ProjectStage = enum { None, Confirm, SavePath, OfferRecovery }
pub type PendingProject = struct {
  action: ProjectAction, stage: ProjectStage, target: string, label: string, error: string, choice: u32
}
pub fn no_project_request() -> PendingProject effects {alloc} {
  PendingProject {action: ProjectAction.None, stage: ProjectStage.None,
    target: string.new(), label: string.new(), error: string.new(), choice: 0}
}

pub type ParameterDrag = struct {
  active: bool, domain: u32, target: u64, name: string, label: string,
  left: f64, width: f64, low: f64, high: f64, step: f64, value: f64
}

pub fn parameter_drag() -> ParameterDrag effects {alloc} {
  ParameterDrag {active: false, domain: 0, target: 0, name: string.new(), label: string.new(),
    left: 0.0, width: 0.0, low: 0.0, high: 1.0, step: 0.1, value: 0.0}
}

pub type App = struct {
  document: editor.Document,
  history: editor.History,
  provider: provider.Provider,
  viewport: Viewport,
  focus: u32,
  menu: u32,
  hover_action: u32,
  hover_target: u64,
  pool_row: u64,
  selected_filter: u64,
  selected_transition: u64,
  selected_transition_epoch: u64,
  dock_tab: u32,
  dock_scroll: f64,
  dock_scroll_dragging: bool,
  dock_scroll_drag_offset: f64,
  snap: bool,
  light: bool,
  theme_id: u64,
  clipboard: option<editor.ClipSnapshot>,
  clipboard_peer: option<editor.ClipSnapshot>,
  clipboard_resource_valid: bool,
  gesture: Drag,
  prompt: Prompt,
  pending_project: PendingProject,
  recovery_file: string,
  recovered_file: string,
  recovery_lease: option<File>,
  recovered_lease: option<File>,
  project_path: string,
  status: string,
  dirty: bool,
  running: bool,
  export_profile: u32,
  frames_painted: u64,
  fullscreen: u32,
  media_revision: u64,
  project_epoch: u64,
  window_timing_requested: bool,
  document_revision: u64,
  waveforms: array<Waveform>,
  thumbnails: array<Thumbnail>,
  presented_source_frame: i64,
  presented_program_frame: i64,
  audio_left: f64,
  audio_right: f64,
  // TrueType faces for titles and captions, earliest first; later faces are fallbacks.
  fonts: array<string>,
  typography: ui_text.Typography,
  parameter_drag: ParameterDrag
}

pub fn viewport() -> Viewport effects {} {
  Viewport {pixels_per_frame: 2.4, scroll_frames: 0, track_height: 46.0,
    first_track: 0, track_sequence: 0}
}

// A new, empty project with the track set an editor actually starts from.
pub fn app(engine: provider.Provider own) -> App effects {alloc} {
  var document: editor.Document = editor.document(30.0, 1920, 1080)
  let sequence: u64 = document.active
  // Created bottom-up: `editor_view.lanes` orders by the track's own `order` and the
  // timeline draws the last lane at the TOP, so this is what puts video above audio.
  let _ = editor.add_track(document, sequence, editor.track_audio(), "A2")
  let _ = editor.add_track(document, sequence, editor.track_audio(), "A1")
  let _ = editor.add_track(document, sequence, editor.track_video(), "V1")
  let _ = editor.add_track(document, sequence, editor.track_video(), "V2")
  App {document: document, history: editor.history(64), provider: engine,
    viewport: viewport(), focus: panel_timeline(), menu: 0, hover_action: 0, hover_target: 0,
    pool_row: 0, selected_filter: 0, selected_transition:0, selected_transition_epoch:0,
    dock_tab: 0, dock_scroll: 0.0, dock_scroll_dragging: false,
    dock_scroll_drag_offset: 0.0, snap: true, light: false, theme_id: 0,
    clipboard: option.none(), clipboard_peer:option.none(), clipboard_resource_valid: false,
    gesture: drag(),
    prompt: Prompt {active: false, action: 0, label: string.new(), buffer: string.new(), feedback: string.new(),
      caret:0,anchor:0,first_row:0,scroll_x:0.0,goal_x:-1.0,dragging:false,
      target_filter:0,target_clip:0,target_sequence:0,target_project:0,
      target_kind:string.new(),original:string.new(),multiline:false,
      target_transition:0,target_track:0,target_center:0,target_duration:0},
    pending_project: no_project_request(), recovery_file: string.new(), recovered_file: string.new(),
    recovery_lease: option.none(), recovered_lease: option.none(),
    project_path: string.new(), status: string.copy("New project"), dirty: false,
    running: true, export_profile: 0, frames_painted: 0, fullscreen: 0, media_revision: 0, project_epoch: 0, window_timing_requested:false, document_revision: 0, waveforms: array.new(), thumbnails: array.new(),
    presented_source_frame: -1, presented_program_frame: -1, audio_left: 0.0, audio_right: 0.0,
    fonts: typeface.defaults(), typography: ui_text.empty(), parameter_drag: parameter_drag()}
}

pub fn status(state: ref<App>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(state, field=status)))
}
pub fn set_status(state: ref<App>, text: str) -> unit effects {alloc} {
  let _ = ref.swap(struct.borrow(state, field=status), string.copy(text))
  ()
}
pub fn project_path(state: ref<App>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(state, field=project_path)))
}
pub fn set_project_path(state: ref<App>, text: str) -> unit effects {alloc} {
  let _ = ref.swap(struct.borrow(state, field=project_path), string.copy(text))
  ()
}
// A reload changes external media without necessarily changing saved project facts.
pub fn mark_media_changed(state: ref<App>) -> unit effects {alloc} {
  struct.set(state, state.media_revision + 1, field=media_revision)
  let _ = struct.replace(state,array.new(),field=waveforms)
  let _ = struct.replace(state,array.new(),field=thumbnails)
  struct.set(state,-1,field=presented_source_frame)
  struct.set(state,-1,field=presented_program_frame)
  ()
}
// Transport requests can advance while decoding. Monitor time belongs to the
// completed picture; during playback the timeline follows that same picture.
pub fn monitor_frame(state: ref<App>, source: bool) -> i64 effects {} {
  let shown: i64 = if source {state.presented_source_frame}else{state.presented_program_frame}
  if shown >= 0 {shown}else{if source {struct.get(struct.borrow(state,field=document),field=monitor).frame}else{editor.playhead(struct.borrow(state,field=document))}}
}
pub fn timeline_frame(state: ref<App>) -> i64 effects {} {
  if editor.playing(struct.borrow(state,field=document)) {monitor_frame(state,false)}else{editor.playhead(struct.borrow(state,field=document))}
}
pub fn dirty(state: ref<App>) -> bool effects {} { state.dirty }
pub fn mark_dirty(state: ref<App>, value: bool) -> unit effects {} {
  struct.set(state, value, field=dirty)
  ()
}
// Successful document mutations explicitly invalidate semantic playback caches.
// Saving, repainting and following the heard clock do not change this revision.
pub fn document_changed(state: ref<App>) -> unit effects {} {
  refresh_clipboard_resource(state)
  if state.selected_transition!=0 and current_transition(state)==0 {set_selected_transition(state,0)}
  struct.set(state,state.document_revision+1,field=document_revision)
  struct.set(state,true,field=dirty)
  ()
}
pub fn running(state: ref<App>) -> bool effects {} { state.running }
pub fn light(state: ref<App>) -> bool effects {} { state.light }
pub fn set_light(state: ref<App>, value: bool) -> unit effects {} {
  struct.set(state, value, field=light)
  ()
}
pub fn theme_id(state: ref<App>) -> u64 effects {} { state.theme_id }

pub type ProgramSample = struct { source: string, frame: i64 }
// Resolve the visible video lane and its source position from the document.
// Audio, hidden tracks and other sequences must never obscure the program monitor.
pub fn program_sample(state: ref<App>) -> option<ProgramSample> effects {alloc} {
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  let position: i64 = editor.playhead(document)
  var selected: option<ProgramSample> = option.none()
  var order: u32 = 0
  var index: u64 = 0
  loop {
    if index >= editor.clip_count(document) { break }
    match editor.clip_at(document, index) {
      some(clip) => {
        if clip.owner == document.active and clip.enabled and clip.start <= position
          and editor.clip_end(clip) > position {
          match editor.track_slot(document, clip.track) {
            some(slot) => {
              let track: ref<editor.Track> = array.borrow(struct.borrow(document, field=tracks), slot)
              if track.kind == editor.track_video() and not track.hidden and track.order >= order {
                let track_order: u32 = track.order
                match editor.source_slot(document, clip.source) {
                  some(source_slot) => {
                    let source: ref<editor.Source> = array.borrow(struct.borrow(document, field=sources), source_slot)
                    let elapsed: i64 = if clip.reverse { clip.length - 1 - (position - clip.start) }
                      else { position - clip.start }
                    let offset: i64 = cast.sat(math.floor(cast.float(elapsed) * math.abs(clip.speed)))
                    selected = option.some(ProgramSample {source: string.copy(str.view(struct.borrow(source, field=path))),
                      frame: clip.source_in + offset})
                    order = track_order
                  }, none => {},
                }
              }
            }, none => {},
          }
        }
      }, none => {},
    }
    index = index + 1
  }
  selected
}
pub fn set_theme(state: ref<App>, value: u64) -> unit effects {} {
  struct.set(state, if value < themes.count() { value } else { 0 }, field=theme_id)
  struct.set(state, false, field=light)
  ()
}
pub fn theme_name(state: ref<App>) -> string effects {alloc} {
  if state.light { string.copy("Light") } else { themes.name(state.theme_id) }
}
pub fn persist_theme(state: ref<App>) -> bool effects {alloc, fs.write} {
  let root: str = str.view(struct.borrow(struct.borrow(state, field=provider), field=scratch))
  let _ = files.mkdirs(root)
  match files.write_text(path.join(root, "theme.txt"), theme_name(state)) { ok(_) => true, err(_) => false, }
}
pub fn stop(state: ref<App>) -> unit effects {} {
  struct.set(state, false, field=running)
  ()
}
pub fn focus(state: ref<App>) -> u32 effects {} { state.focus }
pub fn set_focus(state: ref<App>, value: u32) -> unit effects {} {
  struct.set(state, value, field=focus)
  ()
}
pub fn open_menu(state: ref<App>) -> u32 effects {} { state.menu }
pub fn set_open_menu(state: ref<App>, value: u32) -> unit effects {} {
  struct.set(state, if value > 5 { 0 } else { value }, field=menu)
  ()
}
pub fn hovered(state: ref<App>, action: u32, target: u64) -> bool effects {} {
  state.hover_action == action and state.hover_target == target
}
pub fn set_hover(state: ref<App>, action: u32, target: u64) -> bool effects {} {
  let changed: bool = state.hover_action != action or state.hover_target != target
  struct.set(state, action, field=hover_action)
  struct.set(state, target, field=hover_target)
  changed
}
pub fn clear_hover(state: ref<App>) -> bool effects {} { set_hover(state, 0, 0) }
pub fn close_menu(state: ref<App>) -> unit effects {} {
  set_open_menu(state, 0)
  let _ = clear_hover(state)
  ()
}
pub fn pool_row(state: ref<App>) -> u64 effects {} { state.pool_row }
pub fn set_pool_row(state: ref<App>, value: u64) -> unit effects {} {
  struct.set(state, value, field=pool_row)
  ()
}
pub fn selected_filter(state: ref<App>) -> u64 effects {} { state.selected_filter }
pub fn set_selected_filter(state: ref<App>, value: u64) -> unit effects {} {
  struct.set(state, value, field=selected_filter)
  ()
}
pub fn current_transition(state:ref<App>) -> u64 effects {} {
  if state.selected_transition_epoch!=state.project_epoch {return 0}
  match editor.transition(struct.borrow(state,field=document),state.selected_transition) {
    none=>0,some(value)=>if value.owner==state.document.active {value.id}else{0},
  }
}
pub fn set_selected_transition(state:ref<App>,id:u64) -> unit effects {} {
  struct.set(state,id,field=selected_transition)
  struct.set(state,state.project_epoch,field=selected_transition_epoch)
  ()
}
// ---- dock, snapping and the clipboard --------------------------------------

pub fn dock_tab(state: ref<App>) -> u32 effects {} { state.dock_tab }
pub fn set_fonts(state: ref<App>, paths: array<string> own) -> unit effects {alloc, fs.read, fs.meta} {
  var font_paths: array<string> = paths
  var ui_paths: array<string> = typeface.defaults()
  var index: u64 = 0
  loop {
    if index >= array.len(font_paths) { break }
    let face: str = str.view(array.borrow(font_paths, index))
    if text.ends_with(face, "NotoSansJP.ttf") { array.push(ui_paths, string.copy(face)) }
    index = index + 1
  }
  let _ = struct.replace(state, ui_text.load(ui_paths), field=typography)
  let _ = struct.replace(state, font_paths, field=fonts)
  ()
}

pub fn parameter_dragging(state: ref<App>) -> bool effects {} {
  struct.get(struct.borrow(state, field=parameter_drag), field=active)
}

pub fn begin_parameter_drag(state: ref<App>, domain: u32, target: u64, name: str,
                            label: str, left: f64, width: f64, low: f64, high: f64,
                            step: f64, value: f64) -> unit effects {alloc} {
  let _ = struct.replace(state, ParameterDrag {active: true, domain: domain, target: target,
    name: string.copy(name), label: string.copy(label), left: left, width: width,
    low: low, high: high, step: step, value: value}, field=parameter_drag)
  ()
}

pub fn end_parameter_drag(state: ref<App>) -> unit effects {} {
  struct.set(struct.borrow(state, field=parameter_drag), false, field=active)
  ()
}

pub fn set_dock_tab(state: ref<App>, value: u32) -> unit effects {} {
  struct.set(state, if value > 3 { 0 } else { value }, field=dock_tab)
  struct.set(state, 0.0, field=dock_scroll)
  ()
}
pub fn dock_scroll(state: ref<App>) -> f64 effects {} { state.dock_scroll }
pub fn set_dock_scroll(state: ref<App>, value: f64) -> f64 effects {} {
  let next: f64 = if value < 0.0 { 0.0 } else { value }
  struct.set(state, next, field=dock_scroll)
  next
}
pub fn dock_scroll_dragging(state: ref<App>) -> bool effects {} {
  state.dock_scroll_dragging
}
pub fn dock_scroll_drag_offset(state: ref<App>) -> f64 effects {} {
  state.dock_scroll_drag_offset
}
pub fn begin_dock_scroll_drag(state: ref<App>, offset: f64) -> unit effects {} {
  struct.set(state, true, field=dock_scroll_dragging)
  struct.set(state, offset, field=dock_scroll_drag_offset)
  ()
}
pub fn end_dock_scroll_drag(state: ref<App>) -> unit effects {} {
  struct.set(state, false, field=dock_scroll_dragging)
  struct.set(state, 0.0, field=dock_scroll_drag_offset)
  ()
}
pub fn snap(state: ref<App>) -> bool effects {} { state.snap }
pub fn toggle_snap(state: ref<App>) -> bool effects {} {
  let next: bool = not state.snap
  struct.set(state, next, field=snap)
  next
}

pub fn has_clipboard(state: ref<App>) -> bool effects {} {
  if not state.clipboard_resource_valid {return false}
  match struct.borrow(state,field=clipboard) {none=>false,some(_)=>true,}
}
pub fn set_clipboard(state: ref<App>, content:editor.ClipSnapshot own) -> unit effects {alloc} {
  let _=struct.replace(state,option.none(),field=clipboard_peer)
  let _=struct.replace(state,option.some(content),field=clipboard)
  struct.set(state,true,field=clipboard_resource_valid)
  ()
}
// Losing a resource lifetime retires the reference permanently until Copy.
// Restoring its numeric ID in a new Undo branch must never bind different media.
fn refresh_clipboard_resource(state:ref<App>) -> unit effects {} {
  if not state.clipboard_resource_valid {return ()}
  let saved:editor.Clip=match struct.borrow(state,field=clipboard) {none=>{return ()},some(value)=>value.clip,}
  let doc:ref<editor.Document> = struct.borrow(state,field=document)
  let media:bool=if saved.source==0 {true}else{match editor.source_slot(doc,saved.source) {none=>false,some(_)=>true,}}
  let child:bool=if saved.nested==0 {true}else{match editor.sequence_slot(doc,saved.nested) {none=>false,some(_)=>true,}}
  if not media or not child {struct.set(state,false,field=clipboard_resource_valid)}
  ()
}
pub fn clipboard_identity_valid(state:ref<App>) -> bool effects {} {state.clipboard_resource_valid}
pub fn paste_track(state: ref<App>) -> u64 effects {alloc} {
  if not has_clipboard(state) {return 0}
  let kind:u32=match struct.borrow(state,field=clipboard) {none=>{return 0},some(saved)=>saved.track_kind,}
  let selected:u64=current_clip(state)
  let doc:ref<editor.Document> = struct.borrow(state,field=document)
  let active:u64=doc.active
  match editor.clip(doc,selected) {none=>{},some(chosen)=>{
    if chosen.owner==doc.active and editor.track_kind(doc,chosen.track)==kind and not editor.track_locked(doc,chosen.track) {return chosen.track}
  },}
  var i:u64=0
  loop {if i >= editor.track_count(doc) {break}
    let track:ref<editor.Track> = array.borrow(struct.borrow(doc,field=tracks),i)
    if track.owner==active and track.kind==kind and not track.locked {return track.id}
    i=i+1}
  0
}

// ---- the pointer gesture ---------------------------------------------------

pub fn gesture_kind(state: ref<App>) -> u32 effects {} {
  struct.get(struct.borrow(state, field=gesture), field=kind)
}
pub fn gesture_clip(state: ref<App>) -> u64 effects {} {
  struct.get(struct.borrow(state, field=gesture), field=clip)
}
pub fn gesture(state: ref<App>) -> Drag effects {} { state.gesture }
pub fn begin_gesture(state: ref<App>, kind: u32, clip: u64, grab: i64, start: i64,
                     source_in: i64, length: i64, track: u64) -> unit effects {} {
  let held: ref<Drag> = struct.borrow(state, field=gesture)
  struct.set(held, kind, field=kind)
  struct.set(held, clip, field=clip)
  struct.set(held, grab, field=grab_frame)
  struct.set(held, start, field=origin_start)
  struct.set(held, source_in, field=origin_in)
  struct.set(held, length, field=origin_length)
  struct.set(held, track, field=origin_track)
  struct.set(held, false, field=moved)
  ()
}
pub fn gesture_moved(state: ref<App>) -> bool effects {} {
  struct.get(struct.borrow(state, field=gesture), field=moved)
}
pub fn mark_gesture_moved(state: ref<App>) -> unit effects {} {
  struct.set(struct.borrow(state, field=gesture), true, field=moved)
  ()
}
pub fn end_gesture(state: ref<App>) -> unit effects {} {
  struct.set(struct.borrow(state, field=gesture), drag_none(), field=kind)
  struct.set(struct.borrow(state, field=gesture), 0, field=clip)
  ()
}

// ---- the prompt ------------------------------------------------------------

pub fn prompt_active(state: ref<App>) -> bool effects {} {
  struct.get(struct.borrow(state, field=prompt), field=active)
}
pub fn prompt_action(state: ref<App>) -> u32 effects {} {
  struct.get(struct.borrow(state, field=prompt), field=action)
}
pub fn prompt_label(state: ref<App>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(struct.borrow(state, field=prompt), field=label)))
}
pub fn prompt_text(state: ref<App>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(struct.borrow(state, field=prompt), field=buffer)))
}
pub fn prompt_feedback(state: ref<App>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(struct.borrow(state, field=prompt), field=feedback)))
}
pub fn set_prompt_feedback(state: ref<App>, value: str) -> unit effects {alloc} {
  if not prompt_active(state) {return ()}
  let _=ref.swap(struct.borrow(struct.borrow(state,field=prompt),field=feedback),string.copy(value))
  ()
}
pub fn prompt_selected_all(state: ref<App>) -> bool effects {} {
  let asking:ref<Prompt> =struct.borrow(state,field=prompt)
  str.len(str.view(struct.borrow(asking,field=buffer)))>0 and
    math.min(cast.float(asking.caret),cast.float(asking.anchor))==0.0 and
    math.max(cast.float(asking.caret),cast.float(asking.anchor))==cast.float(str.len(str.view(struct.borrow(asking,field=buffer))))
}
pub fn prompt_select_all(state: ref<App>) -> unit effects {} {
  if prompt_active(state) {
    let asking:ref<Prompt> =struct.borrow(state,field=prompt)
    struct.set(asking,0,field=anchor)
    struct.set(asking,str.len(str.view(struct.borrow(asking,field=buffer))),field=caret)
    struct.set(asking,-1.0,field=goal_x)
  }
  ()
}
pub fn prompt_delete_selection(state: ref<App>) -> unit effects {alloc} {
  if not prompt_active(state) or prompt_caret(state)==prompt_anchor(state) { return () }
  prompt_replace(state,"")
  ()
}
pub fn begin_prompt(state: ref<App>, action: u32, label: str, seed: str) -> unit effects {alloc} {
  let asking: ref<Prompt> = struct.borrow(state, field=prompt)
  struct.set(asking, true, field=active)
  struct.set(asking, action, field=action)
  struct.set(asking,str.len(seed),field=caret)
  struct.set(asking,str.len(seed),field=anchor)
  struct.set(asking,0,field=first_row)
  struct.set(asking,0.0,field=scroll_x)
  struct.set(asking,-1.0,field=goal_x)
  struct.set(asking,false,field=dragging)
  struct.set(asking,0,field=target_filter)
  struct.set(asking,0,field=target_clip)
  struct.set(asking,0,field=target_sequence)
  struct.set(asking,0,field=target_transition)
  struct.set(asking,0,field=target_track)
  struct.set(asking,state.project_epoch,field=target_project)
  struct.set(asking,false,field=multiline)
  let _=ref.swap(struct.borrow(asking,field=target_kind),string.new())
  let _=ref.swap(struct.borrow(asking,field=original),string.copy(seed))
  let _ = ref.swap(struct.borrow(asking, field=label), string.copy(label))
  let _ = ref.swap(struct.borrow(asking, field=buffer), string.copy(seed))
  let _ = ref.swap(struct.borrow(asking, field=feedback), string.new())
  ()
}
pub fn begin_filter_prompt(state:ref<App>,action:u32,label:str,seed:str,filter:u64) -> unit effects {alloc} {
  begin_prompt(state,action,label,seed)
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  let asking:ref<Prompt> =struct.borrow(state,field=prompt)
  struct.set(asking,filter,field=target_filter)
  match editor.filter_slot(doc,filter) {
    none=>{},some(slot)=>{
      let item:ref<editor.Filter> =array.borrow(struct.borrow(doc,field=filters),slot)
      let clip_id:u64=item.clip
      struct.set(asking,clip_id,field=target_clip)
      let kind:string=editor.filter_kind(doc,filter)
      struct.set(asking,str.eq(str.view(kind),"text"),field=multiline)
      let original:string=editor.filter_text_param(doc,filter,if str.eq(str.view(kind),"text") {"content"}else{"path"},"")
      let _=ref.swap(struct.borrow(asking,field=original),original)
      let _=ref.swap(struct.borrow(asking,field=target_kind),kind)
      match editor.clip(doc,clip_id) {none=>{},some(clip)=>{struct.set(asking,clip.owner,field=target_sequence)},}
    },
  }
  ()
}
pub fn prompt_multiline(state:ref<App>) -> bool effects {} {
  prompt_active(state) and struct.get(struct.borrow(state,field=prompt),field=multiline)
}
pub fn prompt_filter(state:ref<App>) -> u64 effects {} {
  struct.get(struct.borrow(state,field=prompt),field=target_filter)
}
pub fn begin_transition_prompt(state:ref<App>,action:u32,id:u64) -> bool effects {alloc} {
  let value:editor.Transition=match editor.transition(struct.borrow(state,field=document),id) {
    none=>{return false},some(value)=>value,
  }
  begin_prompt(state,action,"Transition duration (frames)",str.view(string.from_int(value.duration)))
  let asking:ref<Prompt> =struct.borrow(state,field=prompt)
  struct.set(asking,id,field=target_transition)
  struct.set(asking,value.owner,field=target_sequence)
  struct.set(asking,value.track,field=target_track)
  struct.set(asking,value.center,field=target_center)
  struct.set(asking,value.duration,field=target_duration)
  let _=ref.swap(struct.borrow(asking,field=target_kind),editor.name_text(struct.borrow(state,field=document),value.kind))
  true
}
pub fn prompt_transition(state:ref<App>) -> u64 effects {} {state.prompt.target_transition}
pub fn prompt_transition_valid(state:ref<App>) -> bool effects {alloc} {
  let asking:ref<Prompt> =struct.borrow(state,field=prompt)
  if asking.target_project!=state.project_epoch or asking.target_transition==0 {return false}
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  match editor.transition(doc,asking.target_transition) {
    none=>false,some(value)=>value.owner==asking.target_sequence and value.owner==doc.active and
      value.track==asking.target_track and value.center==asking.target_center and
      value.duration==asking.target_duration and
      str.eq(str.view(editor.name_text(doc,value.kind)),str.view(struct.borrow(asking,field=target_kind))),
  }
}
pub fn prompt_target_valid(state:ref<App>) -> bool effects {alloc} {
  let asking:ref<Prompt> =struct.borrow(state,field=prompt)
  if asking.target_filter==0 or asking.target_clip==0 or asking.target_project!=state.project_epoch {return false}
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  let slot:u64=match editor.filter_slot(doc,asking.target_filter) {none=>{return false},some(value)=>value,}
  let item:ref<editor.Filter> =array.borrow(struct.borrow(doc,field=filters),slot)
  let owner:u64=item.clip
  let kind:string=string.copy(str.view(struct.borrow(item,field=kind)))
  let clip:editor.Clip=match editor.clip(doc,asking.target_clip) {none=>{return false},some(value)=>value,}
  if owner!=asking.target_clip or clip.owner!=asking.target_sequence or
      not str.eq(str.view(kind),str.view(struct.borrow(asking,field=target_kind))) {return false}
  let content:string=editor.filter_text_param(doc,asking.target_filter,
    if asking.multiline {"content"}else{"path"},"")
  str.eq(str.view(content),str.view(struct.borrow(asking,field=original)))
}
pub fn prompt_caret(state:ref<App>) -> u64 effects {} {state.prompt.caret}
pub fn prompt_anchor(state:ref<App>) -> u64 effects {} {state.prompt.anchor}
pub fn prompt_first_row(state:ref<App>) -> u64 effects {} {state.prompt.first_row}
pub fn prompt_scroll_x(state:ref<App>) -> f64 effects {} {state.prompt.scroll_x}
pub fn prompt_dragging(state:ref<App>) -> bool effects {} {state.prompt.dragging}
pub fn prompt_line_start(value:str,at:u64) -> u64 effects {} {
  var cursor:u64=if at>str.len(value) {str.len(value)}else{at}
  loop {if cursor==0 {break}
    if view.get(str.bytes(value),cursor-1)==10 {break}
    cursor=cursor-1}
  cursor
}
pub fn prompt_line_end(value:str,at:u64) -> u64 effects {} {
  var cursor:u64=if at>str.len(value) {str.len(value)}else{at}
  loop {if cursor>=str.len(value) {break}
    if view.get(str.bytes(value),cursor)==10 {break}
    cursor=cursor+1}
  cursor
}
pub fn prompt_row(value:str,at:u64) -> u64 effects {} {
  let limit:u64=if at>str.len(value) {str.len(value)}else{at}
  var cursor:u64=0
  var row:u64=0
  loop {if cursor>=limit {break}
    if view.get(str.bytes(value),cursor)==10 {row=row+1}
    cursor=cursor+1}
  row
}
pub fn prompt_row_start(value:str,row:u64) -> u64 effects {} {
  var cursor:u64=0
  var found:u64=0
  loop {if cursor>=str.len(value) or found>=row {break}
    if view.get(str.bytes(value),cursor)==10 {found=found+1}
    cursor=cursor+1}
  cursor
}
fn prompt_replace(state:ref<App>,insert:str) -> unit effects {alloc} {
  let current:string=prompt_text(state)
  let caret:u64=prompt_caret(state)
  let anchor:u64=prompt_anchor(state)
  let lo:u64=if caret<anchor {caret}else{anchor}
  let hi:u64=if caret>anchor {caret}else{anchor}
  var built:string=string.copy(str.slice(str.view(current),0,lo))
  string.append(built,insert)
  string.append(built,str.slice(str.view(current),hi,str.len(str.view(current))))
  // Combining text may join the preceding cluster: leave the insertion caret
  // on a complete supported std.font cluster, never within the joined mark.
  let boundary:u64=lo+str.len(insert)
  let start:u64=font.cluster_start(str.view(built),boundary)
  let at:u64=if start==boundary {boundary}else{font.cluster_end(str.view(built),start)}
  let asking:ref<Prompt> =struct.borrow(state,field=prompt)
  if not str.eq(str.view(current),str.view(built)) {let _=ref.swap(struct.borrow(asking,field=feedback),string.new())}
  let _=ref.swap(struct.borrow(asking,field=buffer),built)
  struct.set(asking,at,field=caret)
  struct.set(asking,at,field=anchor)
  struct.set(asking,-1.0,field=goal_x)
  ()
}
pub fn prompt_delete(state:ref<App>) -> unit effects {alloc} {
  if not prompt_active(state) {return ()}
  if prompt_caret(state)!=prompt_anchor(state) {prompt_delete_selection(state)
    return ()}
  let current:string=prompt_text(state)
  let at:u64=prompt_caret(state)
  if at>=str.len(str.view(current)) {return ()}
  struct.set(struct.borrow(state,field=prompt),font.cluster_end(str.view(current),at),field=anchor)
  prompt_replace(state,"")
}
// Directions: left/right, line Home/End, previous/next line. Control changes
// Home/End to the document endpoints. The caller retains modal key policy.
pub fn prompt_move(state:ref<App>,direction:u32,control:bool,extend:bool) -> unit effects {alloc} {
  if not prompt_active(state) {return ()}
  let current:string=prompt_text(state)
  let value:str=str.view(current)
  let caret:u64=prompt_caret(state)
  let anchor:u64=prompt_anchor(state)
  var next:u64=caret
  let start:u64=prompt_line_start(value,caret)
  let stop:u64=prompt_line_end(value,caret)
  if direction<=1 {
    if not extend and caret!=anchor {next=if direction==0 {if caret<anchor {caret}else{anchor}}else{if caret>anchor {caret}else{anchor}}}
    else {next=if direction==0 {font.cluster_before(value,caret)}else{font.cluster_end(value,caret)}}
  }else if direction==2 {next=if control {0}else{start}}
  else if direction==3 {next=if control {str.len(value)}else{stop}}
  else if direction==4 or direction==5 {
    if not prompt_multiline(state) {return ()}
    var goal:f64=state.prompt.goal_x
    if goal<0.0 {goal=ui_text.caret_x(struct.borrow(state,field=typography),str.slice(value,start,stop),10.0,caret-start)}
    var other:u64=start
    if direction==4 and start>0 {other=prompt_line_start(value,start-1)}
    if direction==5 and stop<str.len(value) {other=stop+1}
    let end:u64=prompt_line_end(value,other)
    next=other+ui_text.offset_at_x(struct.borrow(state,field=typography),str.slice(value,other,end),10.0,goal)
    struct.set(struct.borrow(state,field=prompt),goal,field=goal_x)
  }
  let asking:ref<Prompt> =struct.borrow(state,field=prompt)
  struct.set(asking,next,field=caret)
  if not extend {struct.set(asking,next,field=anchor)}
  if direction<4 {struct.set(asking,-1.0,field=goal_x)}
  ()
}
pub fn prompt_pointer(state:ref<App>,offset:u64,extend:bool) -> unit effects {alloc} {
  let current:string=prompt_text(state)
  let at:u64=font.cluster_start(str.view(current),offset)
  let asking:ref<Prompt> =struct.borrow(state,field=prompt)
  struct.set(asking,at,field=caret)
  if not extend {struct.set(asking,at,field=anchor)}
  struct.set(asking,-1.0,field=goal_x)
  struct.set(asking,true,field=dragging)
  ()
}
pub fn prompt_release(state:ref<App>) -> unit effects {} {struct.set(struct.borrow(state,field=prompt),false,field=dragging)
  ()}
pub fn prompt_keep_visible(state:ref<App>,width:f64,rows:u64) -> unit effects {alloc} {
  let current:string=prompt_text(state)
  let caret:u64=prompt_caret(state)
  let row:u64=prompt_row(str.view(current),caret)
  let slots:u64=if rows==0 {1}else{rows}
  var first:u64=prompt_first_row(state)
  if row<first {first=row}
  if row-first>=slots {first=row-slots+1}
  let start:u64=prompt_line_start(str.view(current),caret)
  let stop:u64=prompt_line_end(str.view(current),caret)
  let x:f64=ui_text.caret_x(struct.borrow(state,field=typography),str.slice(str.view(current),start,stop),10.0,caret-start)
  var scroll:f64=prompt_scroll_x(state)
  let span:f64=math.max(1.0,width)
  if x<scroll {scroll=x}
  if x>scroll+span {scroll=x-span}
  let asking:ref<Prompt> =struct.borrow(state,field=prompt)
  struct.set(asking,first,field=first_row)
  struct.set(asking,scroll,field=scroll_x)
  ()
}
pub fn prompt_push(state: ref<App>, text: str) -> unit effects {alloc} {
  if not prompt_active(state) { return () }
  if str.len(text) == 0 { return () }
  prompt_replace(state,text)
  ()
}
pub fn prompt_backspace(state: ref<App>) -> unit effects {alloc} {
  if not prompt_active(state) { return () }
  if prompt_caret(state)!=prompt_anchor(state) {
    prompt_delete_selection(state)
    return ()
  }
  let held:string=prompt_text(state)
  let at:u64=prompt_caret(state)
  if at==0 {return ()}
  struct.set(struct.borrow(state,field=prompt),font.cluster_before(str.view(held),at),field=anchor)
  prompt_replace(state,"")
  ()
}
pub fn end_prompt(state: ref<App>) -> unit effects {alloc} {
  let asking: ref<Prompt> = struct.borrow(state, field=prompt)
  struct.set(asking, false, field=active)
  struct.set(asking, 0, field=action)
  struct.set(asking,0,field=caret)
  struct.set(asking,0,field=anchor)
  struct.set(asking,false,field=dragging)
  struct.set(asking,false,field=multiline)
  struct.set(asking,0,field=target_filter)
  struct.set(asking,0,field=target_clip)
  let _=ref.swap(struct.borrow(asking,field=target_kind),string.new())
  let _=ref.swap(struct.borrow(asking,field=original),string.new())
  let _ = ref.swap(struct.borrow(asking, field=buffer), string.new())
  let _ = ref.swap(struct.borrow(asking, field=feedback), string.new())
  ()
}

pub fn painted(state: ref<App>) -> u64 effects {} { state.frames_painted }
pub fn count_paint(state: ref<App>) -> unit effects {} {
  struct.set(state, state.frames_painted + 1, field=frames_painted)
  ()
}

// ---- viewport -------------------------------------------------------------

pub fn zoom(state: ref<App>) -> f64 effects {} {
  struct.get(struct.borrow(state, field=viewport), field=pixels_per_frame)
}
pub fn scroll(state: ref<App>) -> i64 effects {} {
  struct.get(struct.borrow(state, field=viewport), field=scroll_frames)
}
pub fn track_height(state: ref<App>) -> f64 effects {} {
  struct.get(struct.borrow(state, field=viewport), field=track_height)
}
pub fn track_gap() -> f64 effects {} {4.0}
pub fn track_pitch(state: ref<App>) -> f64 effects {} {track_height(state)+track_gap()}
// Lane navigation is view state. Hidden/muted lanes remain reachable so their
// controls can restore them; resizing and edits derive bounds from live tracks.
pub fn track_scroll_max(state: ref<App>, height: f64) -> u64 effects {} {
  let doc: ref<editor.Document> = struct.borrow(state,field=document)
  var count: u64 = 0
  var at: u64 = 0
  loop {if at >= editor.track_count(doc) {break}
    if struct.get(array.borrow(struct.borrow(doc,field=tracks),at),field=owner) == doc.active {count=count+1}
    at=at+1
  }
  let lane: f64 = track_pitch(state)
  // The trailing inter-lane gap is not required to display the final lane.
  let room: f64 = math.max(0.0,height-4.0)+track_gap()
  let visible: u64 = if lane > 0.0 and room >= lane {cast.sat(math.floor(room/lane))}else{1}
  if count > visible {count-visible}else{0}
}
pub fn track_scroll(state: ref<App>) -> u64 effects {} {
  struct.get(struct.borrow(state,field=viewport),field=first_track)
}
pub fn set_track_scroll(state: ref<App>, value: u64, height: f64) -> u64 effects {} {
  let maximum: u64 = track_scroll_max(state,height)
  let next: u64 = if value > maximum {maximum}else{value}
  let sequence: u64 = struct.get(struct.borrow(state,field=document),field=active)
  struct.set(struct.borrow(state,field=viewport),sequence,field=track_sequence)
  struct.set(struct.borrow(state,field=viewport),next,field=first_track)
  next
}
pub fn clamp_track_scroll(state: ref<App>, height: f64) -> u64 effects {} {
  let sequence: u64 = struct.get(struct.borrow(state,field=document),field=active)
  let same: bool = sequence == struct.get(struct.borrow(state,field=viewport),field=track_sequence)
  set_track_scroll(state,if same {track_scroll(state)}else{0},height)
}
pub fn set_zoom(state: ref<App>, value: f64) -> f64 effects {} {
  if not math.is_finite(value) { return zoom(state) }
  var next: f64 = value
  // One logical pixel can represent the complete signed frame domain. Fit must
  // not acquire an unrelated short-project lower limit.
  let minimum: f64 = 1.0 / 9223372036854775807.0
  if next < minimum { next = minimum }
  if next > 40.0 { next = 40.0 }
  struct.set(struct.borrow(state, field=viewport), next, field=pixels_per_frame)
  next
}
// Requests use a half-open frame range. Round upward so the final fitted frame
// is not lost to division rounding, and leave room for a nonzero scroll origin.
pub fn visible_span(state: ref<App>, width: f64) -> i64 effects {} {
  if not math.is_finite(width) or width <= 0.0 { return 0 }
  let room: i64 = 9223372036854775807 - scroll(state)
  if room <= 0 { return 0 }
  let wanted: i64 = cast.sat(math.ceil(width / zoom(state)))
  if wanted > room { room } else { wanted }
}
pub fn set_scroll(state: ref<App>, value: i64) -> i64 effects {} {
  let next: i64 = if value < 0 { 0 } else { value }
  struct.set(struct.borrow(state, field=viewport), next, field=scroll_frames)
  next
}

// The first selected clip, which is what the properties and filter panels describe.
pub fn current_clip(state: ref<App>) -> u64 effects {alloc} {
  var chosen: array<u64> = editor.selection(struct.borrow(state, field=document))
  if array.len(chosen) == 0 { return 0 }
  array.get(chosen, 0)
}

// Selecting a linked video also exposes its audio in the Audio inspector.
pub fn current_audio_clip(state: ref<App>) -> u64 effects {alloc} {
  let selected:u64=current_clip(state)
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  if editor.clip_streams(doc,selected)==editor.streams_video() {
    let peer:u64=linked_media.mate(doc,selected)
    if peer!=0 {return peer}
  }
  selected
}

// The media source the pool has highlighted, by STABLE ID rather than row position.
pub fn current_source(state: ref<App>) -> u64 effects {} {
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  if state.pool_row >= editor.source_count(document) { return 0 }
  struct.get(array.borrow(struct.borrow(document, field=sources), state.pool_row), field=id)
}

// The track a new clip lands on: the first video track of the active sequence.
pub fn default_video_track(state: ref<App>) -> u64 effects {} {
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  let sequence: u64 = document.active
  var index: u64 = 0
  loop {
    if index >= editor.track_count(document) { break }
    let entry: ref<editor.Track> = array.borrow(struct.borrow(document, field=tracks), index)
    if struct.get(entry, field=owner) == sequence
      and struct.get(entry, field=kind) == editor.track_video() {
      return struct.get(entry, field=id)
    }
    index = index + 1
  }
  0
}
// A1 — the audio track nearest the video, which is the highest-ordered audio lane. Taking
// the first in document order would land new audio on the BOTTOM lane instead.
pub fn default_audio_track(state: ref<App>) -> u64 effects {} {
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  let sequence: u64 = document.active
  var chosen: u64 = 0
  var best: u32 = 0
  var index: u64 = 0
  loop {
    if index >= editor.track_count(document) { break }
    let entry: ref<editor.Track> = array.borrow(struct.borrow(document, field=tracks), index)
    if struct.get(entry, field=owner) == sequence
      and struct.get(entry, field=kind) == editor.track_audio() {
      let order: u32 = struct.get(entry, field=order)
      if chosen == 0 or order > best {
        chosen = struct.get(entry, field=id)
        best = order
      }
    }
    index = index + 1
  }
  chosen
}

// ---- waveform cache -------------------------------------------------------

pub fn waveform_bucket_limit() -> u64 effects {} {65536}
pub fn waveform_peak_budget() -> u64 effects {} {262144}
pub fn waveform_peak_count(state: ref<App>) -> u64 effects {} {
  var total: u64=0
  var at: u64=0
  loop {if at >= array.len(struct.borrow(state,field=waveforms)) {break}
    total=total+array.len(struct.borrow(array.borrow(struct.borrow(state,field=waveforms),at),field=peaks))
    at=at+1
  }
  total
}
pub fn touch_waveform(state: ref<App>, clip: u64) -> unit effects {alloc} {
  var previous: array<Waveform> =ref.swap(struct.borrow(state,field=waveforms),array.new())
  var reverse: array<Waveform> =array.new()
  var found: option<Waveform> =option.none()
  loop {match array.pop(previous) {none=>{break},some(entry)=>{
    if entry.clip == clip {let _=ref.swap(found,option.some(entry))}else{array.push(reverse,entry)}
  },}}
  loop {match array.pop(reverse) {none=>{break},some(entry)=>array.push(struct.borrow(state,field=waveforms),entry),}}
  match found {none=>{},some(entry)=>array.push(struct.borrow(state,field=waveforms),entry),}
  ()
}
pub fn set_waveform(state: ref<App>, clip: u64, peaks: array<f64> own, first: i64, last: i64, revision: u64) -> unit effects {alloc} {
  var incoming: array<f64> = peaks
  let value: editor.Clip = match editor.clip(struct.borrow(state,field=document),clip) {some(value)=>value,none=>{return ()},}
  let count: u64=array.len(incoming)
  if count == 0 or count > waveform_bucket_limit() {return ()}
  var check: u64=0
  loop {if check >= count {break}
    let peak: f64=array.get(incoming,check)
    if not math.is_finite(peak) or peak < 0.0 {return ()}
    check=check+1
  }
  var updated: Waveform = Waveform {clip:clip,source:value.source,length:value.length,first:first,last:last,revision:revision,document_revision:state.document_revision,peaks:incoming}
  // Entries are ordered by successful update. Invalid/failed incoming work
  // never evicts a prior entry; drop oldest other clips only after validation.
  var total: u64=count
  var index: u64 = 0
  loop {if index >= array.len(struct.borrow(state,field=waveforms)) {break}
    let entry: ref<Waveform> =array.borrow(struct.borrow(state,field=waveforms),index)
    if entry.clip != clip {total=total+array.len(struct.borrow(entry,field=peaks))}
    index=index+1
  }
  var evict: u64=0
  loop {if total <= waveform_peak_budget() or evict >= array.len(struct.borrow(state,field=waveforms)) {break}
    let entry: ref<Waveform> =array.borrow(struct.borrow(state,field=waveforms),evict)
    if entry.clip != clip {total=total-array.len(struct.borrow(entry,field=peaks))}
    evict=evict+1
  }
  var previous: array<Waveform> =ref.swap(struct.borrow(state,field=waveforms),array.new())
  var reverse: array<Waveform> =array.new()
  loop {if array.len(previous) == 0 {break}
    let position: u64=array.len(previous)-1
    var entry: Waveform=option.unwrap(array.pop(previous))
    if position >= evict and entry.clip != clip {array.push(reverse,entry)}
  }
  loop {match array.pop(reverse) {none=>{break},some(entry)=>array.push(struct.borrow(state,field=waveforms),entry),}}
  array.push(struct.borrow(state,field=waveforms),updated)
  ()
}

pub fn waveform_slot(state: ref<App>, clip: u64) -> option<u64> effects {} {
  var index: u64 = 0
  loop {
    if index >= array.len(struct.borrow(state, field=waveforms)) { break }
    if struct.get(array.borrow(struct.borrow(state, field=waveforms), index), field=clip) == clip {
      return option.some(index)
    }
    index = index + 1
  }
  option.none()
}
pub fn waveform_count(state: ref<App>) -> u64 effects {} {
  array.len(struct.borrow(state, field=waveforms))
}
