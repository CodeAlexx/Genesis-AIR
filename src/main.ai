fn say(text: str) -> unit effects {io.write} {
  io.write(text)
  io.write("\n")
  ()
}

fn worker_path() -> string effects {alloc, env, fs.meta, fs.read} {
  match env.get("GENESIS_GCOMPOSE") {
    some(value) => { return value },
    none => { },
  }
  match system.executable_path() {
    ok(executable) => {
      let build_dir: string = path.dirname(str.view(executable))
      let packaged: string = path.join(build_dir, "genesis-gcompose.exe")
      match files.exists(packaged) { ok(found) => { if found { return packaged } }, err(_) => {}, }

      let project_dir: string = path.dirname(str.view(build_dir))
      let sibling: string = path.join(str.view(path.dirname(str.view(project_dir))),
        "Genesis/target/release/gcompose")
      match files.exists(str.view(sibling)) {
        ok(found) => { if found { return sibling } },
        err(problem) => { },
      }
    },
    err(problem) => { },
  }
  match env.get("PATH") {
    none => { },
    some(search) => {
      var folders: array<string> = text.split(str.view(search), if text.contains(str.view(search), ";") { ";" } else { ":" })
      var at: u64 = 0
      loop {
        if at >= array.len(folders) { break }
        let candidate: string = path.join(str.view(array.borrow(folders, at)), "genesis-gcompose")
        match files.exists(str.view(candidate)) {
          ok(found) => { if found { return candidate } },
          err(problem) => { },
        }
        at = at + 1
      }
    },
  }
  string.copy("genesis-gcompose")
}

// Choose a provider: gcompose when its worker is present, otherwise the deterministic fake.
// The application above this line cannot tell which it got.
fn choose_provider(scratch: str, force_fake: bool) -> provider.Provider effects {alloc, env, fs.meta, fs.read} {
  if force_fake { return provider.fake(scratch) }
  var real: provider.Provider = provider.gcompose(str.view(worker_path()), scratch)
  if provider.available(real) { return real }
  let ffmpeg_path: string = match env.get("GENESIS_FFMPEG") { some(value) => value, none => string.copy("ffmpeg"), }
  let probe_path: string = match env.get("GENESIS_FFPROBE") { some(value) => value, none => string.copy("ffprobe"), }
  provider.native(ffmpeg_path, probe_path, scratch)
}

// Dark is the default. GENESIS_APPEARANCE and the final --appearance option accept
// dark, light, or system; system is resolved once by the native host at startup.
fn wants_light(args: view<str>) -> bool effects {alloc, env, ui} {
  var choice: string = string.copy("dark")
  match env.get("GENESIS_APPEARANCE") { some(value) => { choice = value }, none => { }, }
  var index: u64 = 1
  loop {
    if index + 1 >= view.len(args) { break }
    if str.eq(view.get(args, index), "--appearance") {
      choice = string.copy(view.get(args, index + 1))
    }
    index = index + 1
  }
  if str.eq(str.view(choice), "light") { return true }
  if str.eq(str.view(choice), "system") { return ui.system_theme() == 0 }
  false
}

fn settings_root() -> string effects {alloc, env} {
  match env.get("GENESIS_SCRATCH") { some(value) => { return value }, none => {}, }
  match env.get("LOCALAPPDATA") { some(value) => { return path.join(value, "GenesisAIR") }, none => {}, }
  match env.get("XDG_STATE_HOME") { some(value) => { return path.join(value, "genesis-air") }, none => {}, }
  match env.get("HOME") { some(value) => { return path.join(value, ".local/state/genesis-air") }, none => {}, }
  string.copy("genesis-state")
}
fn load_theme(state: ref<app.App>, args: view<str>, scratch: str) -> unit effects {alloc, env, fs.read, ui} {
  var choice: string = match files.read_text(path.join(scratch, "theme.txt")) {
    ok(value) => value, err(_) => string.copy("Serenity"),
  }
  match env.get("GENESIS_THEME") { some(value) => { choice = value }, none => {}, }
  var explicit_appearance: bool = match env.get("GENESIS_APPEARANCE") { some(_) => true, none => false, }
  var index: u64 = 1
  loop {
    if index + 1 >= view.len(args) { break }
    if view.get(args, index) == "--appearance" { explicit_appearance = true }
    if view.get(args, index) == "--theme" { choice = string.copy(view.get(args, index + 1))
      explicit_appearance = false }
    index = index + 1
  }
  let named: string = text.lower_ascii(text.trim(choice))
  var palette: u64 = 0
  loop { if palette >= themes.count() { break }
    if named == text.lower_ascii(themes.name(palette)) { app.set_theme(state, palette) }
    palette = palette + 1 }
  if named == "light" { app.set_light(state, true) }
  if explicit_appearance { app.set_light(state, wants_light(args)) }
  ()
}

// Ask the provider for the two monitor images the next repaint needs. The view never does
// this itself, so painting stays free of media work.
fn render_to(state: ref<app.App>, target: str, width: u32, height: u32) -> bool effects {alloc, fs.meta, fs.read, fs.write, process, net, time} {
  let _ = preview.waveforms(state)
  var images: array<draw.Surface> = preview.images(state, 320, 180)
  var program_image: draw.Surface = match array.pop(images) {
    some(value) => value, none => draw.empty_surface(),
  }
  var source_image: draw.Surface = match array.pop(images) {
    some(value) => value, none => draw.empty_surface(),
  }
  var surface: draw.Surface = match draw.surface(width, height) {
    some(value) => value,
    none => { return false },
  }
  var canvas: draw.Canvas = draw.canvas(surface)
  let wide: u64 = cast.wrap(width)
  let tall: u64 = cast.wrap(height)
  painter.paint(state, canvas, cast.float(wide), cast.float(tall), source_image, program_image)
  var finished: draw.Surface = draw.finish(canvas)
  var metadata: array<png_tools.TextEntry> = [
    png_tools.text("Title", "Genesis AIR"),
    png_tools.text("Renderer", "AIR portable toolkit + std.editor")
  ]
  var encoded: bytes = match png_tools.encode_rgba_with_text(finished, metadata) {
    ok(value) => value,
    err(problem) => { return false },
  }
  match image.write_file(target, bytes.view(encoded)) {
    ok(written) => true,
    err(problem) => false,
  }
}

// A small but genuine project: media, four tracks, real edits, a transition, keyframes,
// markers, a subtitle, a filter stack and a mixer change. Every step goes through the
// command layer, so this is the same path the UI takes.
fn build_demo(state: ref<app.App>) -> unit effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  var wide: commands.Result = commands.import_media(state, "media/wide.mov", "wide_shot.mov")
  var close: commands.Result = commands.import_media(state, "media/close.mov", "close_up.mov")
  var voice: commands.Result = commands.import_media(state, "audio:media/vo.wav", "narration.wav")
  let v1: u64 = app.default_video_track(state)
  let a1: u64 = app.default_audio_track(state)
  var first: commands.Result = commands.append_clip(state, v1, wide.value, 0, 150)
  var second: commands.Result = commands.append_clip(state, v1, close.value, 20, 130)
  var bed: commands.Result = commands.append_clip(state, a1, voice.value, 0, 260)
  let _ = commands.select_only(state, first.value)
  var seam: commands.Result = commands.add_transition(state, v1, 150, 24, "crossfade")
  var fades: commands.Result = commands.set_fades(state, second.value, 12, 18)
  var grade: commands.Result = commands.add_filter(state, first.value, "white_balance")
  let _ = commands.set_filter_param(state, grade.value, "temperature", 0.2)
  var sharp: commands.Result = commands.add_filter(state, first.value, "sharpen")
  let _ = commands.set_key(state, first.value, "opacity", 0, 0.0, 2)
  let _ = commands.set_key(state, first.value, "opacity", 30, 1.0, 2)
  let _ = commands.add_marker(state, 150, "cut")
  let _ = commands.add_subtitle(state, 20, 140, "The river remembers every stone.")
  let _ = commands.set_track_gain(state, a1, 0.8)
  let _ = commands.seek(state, 96)
  let _ = commands.open_source(state, close.value)
  app.set_status(state, "Demo project")
  ()
}

// The windowed application. One repaint per input burst; the document is the only state,
// so a repaint always shows exactly what the last command did.
// The native picker preserves Unicode paths and returns an empty path on Cancel.
fn choose_file(title: str, save: bool, suggested: str) -> option<string> effects {alloc, ffi} {
  let project: bool = str.eq(title, "Open project") or str.eq(title, "Save project") or str.eq(title, "Recover project")
  let filters: str = if project { "Genesis project (*.air)\t*.air" }
    else if save { "Video (*.mp4;*.mov;*.mkv)\t*.mp4;*.mov;*.mkv" }
    else { "Media\t*.mp4;*.mov;*.mkv;*.webm;*.avi;*.wav;*.mp3;*.m4a;*.flac;*.png;*.jpg\nAll files\t*.*" }
  let initial_directory: string = if str.eq(title, "Recover project") { path.dirname(suggested) } else { string.new() }
  let selected: result<option<string>,dialogs.Error> = if save {
    dialogs.save("", suggested, title,
      filters, if project { "air" } else if text.ends_with(suggested, ".mkv") { "mkv" } else if text.ends_with(suggested, ".mov") { "mov" } else { "mp4" })
  } else { dialogs.open(str.view(initial_directory), title, filters) }
  match selected {
    err(_) => option.none(),
    ok(value) => match value { none => option.some(string.new()), some(value) => option.some(value), },
  }
}

// Take the committed Export prompt and snapshot the project for a background export.
// `none` means nothing starts; the status line says why.
fn begin_export(state: ref<app.App>, busy: bool) -> option<timeline_media.ExportJob>
                effects {alloc, fs.write} {
  var where: string = app.prompt_text(state)
  app.end_prompt(state)
  if str.len(str.view(where)) == 0 {
    app.set_status(state, "cancelled")
    return option.none()
  }
  if busy {
    app.set_status(state, "an export is already running; press Esc to cancel it")
    return option.none()
  }
  let worker: string = provider.worker_path(struct.borrow(state, field=provider))
  if not provider.available(struct.borrow(state, field=provider)) or str.len(str.view(worker)) == 0 {
    app.set_status(state, "the gcompose worker is required for video export")
    return option.none()
  }
  let cancel: string = provider.export_cancel_path(struct.borrow(state, field=provider))
  let progress: string = provider.export_progress_path(struct.borrow(state, field=provider))
  timeline_media.clear_export_signals(str.view(cancel), str.view(progress))
  app.set_status(state, "exporting 0% (Esc cancels)")
  option.some(timeline_media.export_job(struct.borrow(state, field=document), str.view(worker),
    str.view(where), struct.borrow(state, field=fonts), str.view(cancel), str.view(progress), state.export_profile))
}

fn run_export(job: timeline_media.ExportJob own) -> result<timeline_media.ExportPublication, string>
              effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  timeline_media.run_export_detailed(job)
}

fn pause_transport(state: ref<app.App>, source: bool) -> unit effects {alloc} {
  let _ = if source { commands.monitor(state, editor.pause()) } else { commands.program(state, editor.pause()) }
  ()
}

// A device sample may advance only the document and picture epoch it belongs to.
// Keep the restart detector in step with clock-only seeks; user seeks remain edits.
pub fn apply_picture_clock(state: ref<app.App>, device: ref<native_audio.Clock>,
    origin: i64, fps: f64, last: i64, source: bool, epoch: u64, picture_epoch: u64,
    revision: u64, media_revision: u64, previous: ref<i64>) -> option<i64> effects {} {
  let presentation:i64=app.presentation_duration(state)
  let doc: ref<editor.Document> = struct.borrow(state,field=document)
  if not device.ok or not math.is_finite(fps) or fps <= 0.0 or last < 0 or origin < 0 or
      epoch != picture_epoch or state.document_revision != revision or
      state.media_revision != media_revision or doc.monitor.playing != source or
      (not source and not editor.playing(doc)) {return option.none()}
  let actual: i64 = transport_clock.frame_at_samples(origin,device.samples,fps,last)
  let _ = if source {editor.seek_monitor(doc,actual)}else{editor.seek_until(doc,actual,presentation)}
  let _ = ref.swap(previous,actual)
  option.some(actual)
}

// Pure native bridge predicates; actual presentation/device ownership stays in the loop.
pub fn picture_schedule_shown(preparing:bool,identity:bool,shown:i64) -> i64 effects {} {
  if not identity {-1}else{shown}
}
pub fn silent_origin_ready(state:ref<app.App>,pictures:ref<picture_queue.Queue>,origin:i64,
    finish:i64,epoch:u64,native_frame:i64,native_revision:u64,native_media:u64,
    advanced_pcm:bool) -> bool effects {} {
  let finish_ready:bool=advanced_pcm or picture_queue.window_primed(pictures,origin,
    if finish>0 {finish-1}else{0},false,epoch,native_frame)
  native_frame>=origin and native_revision==state.document_revision and
    native_media==state.media_revision and finish_ready
}

// First PCM remains caller-owned while actual future pictures are prepared.
// The two-second picture deadline starts at PCM completion, not decoder startup.
pub type PcmPreroll = struct {waiting:bool,ready:bool,ready_ns:u64,epoch:u64,
  revision:u64,media:u64,source:bool,source_id:u64,origin:i64}
pub fn pcm_preroll() -> PcmPreroll effects {} {
  PcmPreroll {waiting:false,ready:false,ready_ns:0,epoch:0,revision:0,media:0,
    source:false,source_id:0,origin:0}
}
pub fn first_pcm_begin(state:ref<app.App>,epoch:u64,source:bool,origin:i64) -> PcmPreroll effects {} {
  PcmPreroll {waiting:true,ready:false,ready_ns:0,epoch:epoch,
    revision:state.document_revision,media:state.media_revision,source:source,
    source_id:state.document.monitor_source,origin:origin}
}
pub fn first_pcm_valid(state:ref<app.App>,preroll:ref<PcmPreroll>,epoch:u64) -> bool effects {} {
  let doc:ref<editor.Document> = struct.borrow(state,field=document)
  preroll.waiting and preroll.epoch == epoch and state.document_revision == preroll.revision and
    state.media_revision == preroll.media and doc.monitor_source == preroll.source_id and
    doc.monitor.playing == preroll.source and (preroll.source or editor.playing(doc)) and
    (if preroll.source {doc.monitor.frame}else{editor.playhead(doc)}) == preroll.origin
}

// Actual native-loop restart decision. Runtime acceptance cannot survive an authored
// revision change; reprepare through the existing stop/discard/start transaction.
pub fn audio_restart_needed(state:ref<app.App>,source:bool,active:bool,was_playing:bool,
    was_source:bool,frame:i64,previous:i64,mix_changed:bool,pending:bool,preparing:bool,
    preroll:ref<PcmPreroll>,epoch:u64) -> bool effects {} {
  not active or not was_playing or source!=was_source or frame!=previous or mix_changed or
    (app.endpoint_requested(state) and not pending) or
    (preparing and not first_pcm_valid(state,preroll,epoch)) or
    (not source and not pending and not preparing and not app.endpoint_current(state))
}

pub fn first_pcm_received(preroll:ref<PcmPreroll>,epoch:u64,now:u64) -> bool effects {} {
  if not preroll.waiting or preroll.ready or preroll.epoch != epoch {return false}
  struct.set(preroll,true,field=ready)
  struct.set(preroll,now,field=ready_ns)
  true
}
// 0 waits without consuming PCM, 1 queues once, 2 retires stale ownership,
// 3 refuses an expired picture-prime deadline. None of these predicts a clock.
pub fn first_pcm_action(state:ref<app.App>,preroll:ref<PcmPreroll>,
    pictures:ref<picture_queue.Queue>,epoch:u64,now:u64,native_shown:i64) -> u32 effects {} {
  if not first_pcm_valid(state,preroll,epoch) {return 2}
  if not preroll.ready {return 0}
  if now < preroll.ready_ns or now-preroll.ready_ns >= 2000000000 {return 3}
  let doc:ref<editor.Document> = struct.borrow(state,field=document)
  let finish:i64 = if preroll.source {editor.source_frames(doc,doc.monitor_source)}else{app.presentation_duration(state)}
  if finish <= 0 {return 2}
  if picture_queue.window_primed(pictures,preroll.origin,finish-1,preroll.source,epoch,native_shown) {1}else{0}
}
pub fn first_pcm_presented(preroll:ref<PcmPreroll>,program:i64,program_revision:u64,
    program_media:u64,source:i64,source_revision:u64,source_media:u64,source_id:u64) -> i64 effects {} {
  if preroll.source {
    if source_revision == preroll.revision and source_media == preroll.media and
        source_id == preroll.source_id {source}else{-1}
  }else{if program_revision == preroll.revision and program_media == preroll.media {program}else{-1}}
}
pub fn first_pcm_release(preroll:ref<PcmPreroll>,output:str) -> unit effects {fs.write} {
  // A completed file can precede its channel receipt. Waiting owns that path
  // too; the serial producer rechecks supersession and removes late output.
  if preroll.waiting or preroll.ready {let _ = files.remove(output)}
  struct.set(preroll,false,field=ready)
  struct.set(preroll,false,field=waiting)
  ()
}

// Only the window's session-owned chunk path is passed here. Call after a
// superseding producer marker, or after its shutdown join, before path reuse.
pub fn release_playback_output(preroll:ref<PcmPreroll>,output:str) -> unit effects {fs.write} {
  if str.len(output) != 0 {let _ = files.remove(output)}
  struct.set(preroll,false,field=ready)
  struct.set(preroll,false,field=waiting)
  ()
}

fn run_window(state: ref<app.App>, title: str) -> i32 effects {alloc, env, ffi, fs.meta, fs.read, fs.write, io.write, process, thread, time, ui, net} {
  var window: Window = match gui.open_canvas(title, 1600, 980) {
    ok(value) => value,
    err(problem) => { say("Genesis AIR could not open a window; try the render command instead.")
      return 1 },
  }
  let _ = session.offer_recovery(state)
  var native_fullscreen: bool = false
  var dirty: bool = true
  var last_present_ns: u64 = 0
  var passive_pending: bool = false
  var source_pixels_pending: bool = true
  var displayed_source_id: u64 = 0
  var repaint_all: bool = true
  var timeline_damage: bool = false
  var waveform_damage:bool=false
  var thumbnail_damage:bool=false
  var renderer: painter.Renderer = painter.renderer()
  var handled_prompt: u32 = 0
  var last_recorded_error: string = string.new()
  var autosave_timer: recovery.Timer = recovery.timer()
  var pointer_x: f64 = 0.0
  var pointer_y: f64 = 0.0
  var clock_ns: u64 = clock.start()
  var frame_clock: transport_clock.Clock = transport_clock.Clock {remainder: 0.0}
  var audio_library: option<CAbiLibrary> = match native_audio.open() {
    ok(value) => option.some(value),
    err(problem) => { app.set_status(state, str.view(problem))
      option.none() },
  }
  var audio_active: bool = false
  var audio_origin: i64 = 0
  var audio_next: i64 = 0
  var audio_next_sample:i64=0
  var audio_task_end_sample:i64=0
  var endpoint_pending:bool=false
  var endpoint_requested_revision:u64=0
  var endpoint_requested_media:u64=0
  var endpoint_requested_owner:u64=0
  var endpoint_requested_seek:i64=-1
  var endpoint_requested_end:bool=false
  var silent_begin:u64=0
  var silent_anchor:u64=0
  var audio_generation: u64 = 0
  var audio_task_generation: u64 = 0
  var audio_task_end: i64 = 0
  var audio_task_output: string = string.new()
  var semantic_cache: window_cache.Cache = window_cache.cache()
  var window_measure: window_profile.Profile = match window_profile.startup() {
    ok(value)=>value,err(problem)=>{app.set_status(state,str.view(problem))
      window_profile.idle()},}
  struct.set(state,window_measure.enabled,field=window_timing_requested)
  var timing_transport_playing:bool=false
  var timing_flush_pending:bool=false
  var timing_limit_pending:bool=false
  var sound_signature: string = string.new()
  var sound_revision: u64 = 0
  var previous_source: bool = false
  var previous_playing: bool = false
  var previous_frame: i64 = editor.playhead(struct.borrow(state, field=document))
  var audio_preparing: bool = false
  var audio_pending: bool = false
  var first_pcm: PcmPreroll = pcm_preroll()
  var native_program_frame:i64 = -1
  var native_source_frame:i64 = -1
  var program_pixels_revision:u64 = 0
  var program_pixels_media:u64 = 0
  var source_pixels_revision:u64 = 0
  var source_pixels_media:u64 = 0
  var source_pixels_id:u64 = 0
  var native_program_revision:u64 = 0
  var native_program_media:u64 = 0
  var native_source_revision:u64 = 0
  var native_source_media:u64 = 0
  var native_source_id:u64 = 0
  var audio_request: u64 = 0
  task.scope {
  var audio_jobs: array<task<bool>> = array.new()
  var preview_jobs: array<task<bool>> = array.new()
  let audio_root: string = path.join(provider.media_root(struct.borrow(state,field=provider)),"audio-playback")
  audio_playback.reset(str.view(audio_root))
  var audio_transport: preview_link.Link = match preview_link.open() {ok(value)=>value,err(problem)=>{app.set_status(state,str.view(problem))
    return 1},}
  let audio_config: audio_playback.Config = audio_playback.Config {root:string.copy(str.view(audio_root)),
    worker:provider.worker_path(struct.borrow(state,field=provider)),events:preview_link.ticket(audio_transport)}
  array.push(audio_jobs,task.spawn(audio_config,fn=audio_playback.run))
  match preview_link.connect(audio_transport) {ok(_)=>{},err(problem)=>{app.set_status(state,str.view(problem))
    audio_playback.stop(str.view(audio_root))
    return 1},}

  let preview_root: string = path.join(provider.media_root(struct.borrow(state,field=provider)),"preview")
  let _ = files.mkdirs(str.view(preview_root))
  preview.reset(str.view(preview_root))
  var preview_transport: preview_link.Link = match preview_link.open_pixels() {ok(value)=>value,err(problem)=>{app.set_status(state,str.view(problem))
    audio_playback.stop(str.view(audio_root))
    let _ = preview_link.wake(audio_transport,true)
    return 1},}
  var config: preview.Config = preview.config(state, str.view(preview_root), preview_link.ticket(preview_transport))
  struct.set(config,true,field=pixel_stream)
  array.push(preview_jobs, task.spawn(config, fn=preview.run))
  match preview_link.connect(preview_transport) {ok(_)=>{},err(problem)=>{app.set_status(state,str.view(problem))
    preview.stop(str.view(preview_root))
    audio_playback.stop(str.view(audio_root))
    let _ = preview_link.wake(audio_transport,true)
    return 1},}
  var pictures: picture_queue.Queue = picture_queue.queue()
  let strip_root: string = path.join(provider.media_root(struct.borrow(state,field=provider)),"timeline-strips")
  let _ = files.mkdirs(str.view(strip_root))
  preview.reset(str.view(strip_root))
  var strip_transport: preview_link.Link = match preview_link.open() {ok(value)=>value,err(problem)=>{
    app.set_status(state,str.view(problem))
    preview.stop(str.view(preview_root))
    audio_playback.stop(str.view(audio_root))
    return 1},}
  var strip_config: preview.Config = preview.config(state,str.view(strip_root),preview_link.ticket(strip_transport))
  struct.set(strip_config,true,field=strips_only)
  array.push(preview_jobs,task.spawn(strip_config,fn=preview.run))
  match preview_link.connect(strip_transport) {ok(_)=>{},err(problem)=>{
    app.set_status(state,str.view(problem))
    preview.stop(str.view(strip_root))
    preview.stop(str.view(preview_root))
    audio_playback.stop(str.view(audio_root))
    return 1},}
  var strip_document_revision: u64 = 0
  var strip_project_epoch: u64 = 0
  var strip_initialized: bool = false
  var strip_requested: u64 = 0
  var strip_revision: u64 = 0
  var strip_scroll: i64 = -1
  var strip_zoom: f64 = 0.0
  var strip_span: i64 = 0
  var strip_first_lane: u64 = 0
  var strip_body_height: f64 = 0.0
  var strip_error: string = string.new()
  var preview_requested: u64 = 0
  var waveform_seen: u64 = 0
  var thumbnail_seen: u64 = 0
  var preview_media_revision: u64 = 0
  var preview_error: string = string.new()
  var preview_channel_generation: u64 = 0
  var preview_channel_error: string = string.new()
  var source_image: draw.Surface = draw.empty_surface()
  var program_image: draw.Surface = draw.empty_surface()
  var export_jobs: array<task<result<timeline_media.ExportPublication, string>>> = array.new()
  var export_target: string = string.new()
  var export_percent: u64 = 0
  let export_cancel: string = provider.export_cancel_path(struct.borrow(state, field=provider))
  let export_progress: string = provider.export_progress_path(struct.borrow(state, field=provider))
  loop {
    if not app.running(state) { break }
    var passive_changed: bool = false
    var window_row: window_profile.Row = window_profile.row()
    struct.set(window_row,if window_measure.enabled or state.window_timing_requested {clock.start()}else{0},field=begin)
    let selected_source_id: u64 = struct.get(struct.borrow(state,field=document),field=monitor_source)
    if displayed_source_id != selected_source_id {
      // A new source must never label the previous source's pixels/time with its
      // own frame rate and duration while the asynchronous decoder catches up.
      let _ = ref.swap(source_image,draw.empty_surface())
      struct.set(state,-1,field=presented_source_frame)
      displayed_source_id = selected_source_id
      source_pixels_pending = true
      repaint_all = true
      dirty = true
    }
    if preview_media_revision != state.media_revision {
      let _ = ref.swap(program_image, draw.empty_surface())
      let _ = ref.swap(source_image, draw.empty_surface())
      source_pixels_pending = true
      waveform_seen = strip_requested
      thumbnail_seen = strip_requested
    }
    preview_link.poll(preview_transport)
    preview.poll_failure(str.view(preview_root),preview_transport)
    preview_link.poll(strip_transport)
    preview.poll_failure(str.view(strip_root),strip_transport)
    // Input from the previous loop may have requested Play. A closed preview
    // lane cannot start or queue audio before the later picture-epoch check.
    // Request-specific failures remain eligible only after queue configuration.
    match preview.current_failure(preview_transport,false) {
      none=>{},some(_)=>{
        pause_transport(state,true)
        pause_transport(state,false)
      },
    }
    let strip_problem: string = match preview.current_failure(strip_transport,strip_transport.error_generation==strip_requested) {
      none=>string.new(),some(detail)=>detail,
    }
    if str.len(str.view(strip_problem))!=0 {
      let reference_pending:u64=state.waveform_pending
      let reference_failed:bool=state.waveform_failed
      app.waveform_failure(state,if strip_transport.closed {0}else{strip_transport.error_generation})
      if reference_pending!=state.waveform_pending or reference_failed!=state.waveform_failed {waveform_damage=true
        dirty=true}
    }
    if str.len(str.view(strip_problem)) != 0 and not str.eq(str.view(strip_problem),str.view(strip_error)) {
      app.set_status(state,str.view(strip_problem))
      dirty=true
    }
    strip_error=strip_problem
    let wave_ready: u64 = strip_transport.waveforms
    if wave_ready > waveform_seen {
      if preview.read_waveforms(state, str.view(strip_root),wave_ready) {
        waveform_seen = wave_ready
        waveform_damage = true
        passive_changed = true
      }else if wave_ready==state.waveform_pending and wave_ready==strip_requested and strip_initialized and
          strip_document_revision==state.document_revision and strip_revision==state.media_revision and
          strip_project_epoch==state.project_epoch {
        app.waveform_failure(state,wave_ready)
        waveform_damage=true
        waveform_seen=wave_ready
        app.set_status(state,"[GA_WAVEFORM_REFERENCE] Current waveform reference unavailable: published payload refused")
        dirty=true
      }
    }
    let thumb_ready: u64 = strip_transport.thumbnails
    if thumb_ready > thumbnail_seen {
      if preview.read_thumbnails(state, str.view(strip_root), thumb_ready) {
        thumbnail_seen = thumb_ready
        thumbnail_damage = true
        passive_changed = true
      }
    }
    let now_ns: u64 = clock.start()
    var elapsed_ns: u64 = clock.between_ns(clock_ns, now_ns)
    clock_ns = now_ns
    // Autosave is a session timer, independent of preview generation or input.
    // A final paused edit still reaches disk when no further event changes the frame.
    match recovery.tick(state, autosave_timer, now_ns) {
      ok(_) => {}, err(problem) => { app.set_status(state, str.view(problem))
        dirty = true },
    }
    let source_playing: bool = struct.get(struct.borrow(struct.borrow(state, field=document), field=monitor), field=playing)
    let playing_now: bool = source_playing or editor.playing(struct.borrow(state, field=document))
    let frame_now: i64 = if source_playing { struct.get(struct.borrow(struct.borrow(state, field=document), field=monitor), field=frame) }
      else { editor.playhead(struct.borrow(state, field=document)) }
    if array.len(export_jobs) > 0 {
      match tasks.join_next<result<timeline_media.ExportPublication, string>>(export_jobs, tasks.now()) {
        some(outcome) => {
          match outcome {
            ok(publication) => {
              var completed: timeline_media.ExportPublication = publication
              var said: string = string.copy("wrote video ")
              string.append(said, str.view(export_target))
              if completed.cleanup_pending {
                string.append(said, "; ")
                string.append(said, str.view(struct.borrow(completed,field=detail)))
              }
              app.set_status(state, str.view(said))
            },
            err(problem) => {
              if str.eq(str.view(problem),"[GA_EXPORT_CANCELLED] export cancelled") { app.set_status(state,"export cancelled") }
              else { app.set_status(state,str.view(problem)) }
            },
          }
          timeline_media.clear_export_signals(str.view(export_cancel), str.view(export_progress))
          dirty = true
        },
        none => {
          match timeline_media.export_progress(str.view(export_progress)) {
            none => { },
            some(percent) => {
              if percent != export_percent and not tasks.requested_at(str.view(export_cancel)) {
                export_percent = percent
                var said: string = string.copy("exporting ")
                let shown: i64 = cast.wrap(percent)
                string.append(said, str.view(string.from_int(shown)))
                string.append(said, "% (Esc cancels)")
                app.set_status(state, str.view(said))
                dirty = true
              }
            },
          }
        },
      }
    }
    match ref.swap(audio_library, option.none()) {
      none => {
        if app.endpoint_requested(state) or (playing_now and not source_playing) {
          endpoint_failure(state,"[GA_AUDIO_DEVICE_UNAVAILABLE] Accepted Program endpoint requires the native audio clock")
          audio_active=false
          audio_preparing=false
          endpoint_pending=false
          dirty=true
        }
      },
      some(opened) => {
        var library: CAbiLibrary = opened
        if endpoint_pending and (endpoint_requested_revision!=state.document_revision or endpoint_requested_media!=state.media_revision or
            endpoint_requested_owner!=state.document.active or (source_playing and not app.endpoint_requested(state)) or (not playing_now and not app.endpoint_requested(state)) or
            endpoint_requested_seek!=state.endpoint_seek_requested or endpoint_requested_end!=state.endpoint_end_requested) {
          let next_seek:i64=state.endpoint_seek_requested
          let next_end:bool=state.endpoint_end_requested
          let same_identity:bool=endpoint_requested_revision==state.document_revision and endpoint_requested_media==state.media_revision and endpoint_requested_owner==state.document.active
          audio_request=audio_request+1
          let _=audio_playback.discard(str.view(audio_root),audio_request,audio_generation)
          release_playback_output(first_pcm,str.view(audio_task_output))
          let _=preview_link.wake(audio_transport,false)
          endpoint_pending=false
          app.retire_endpoint(state)
          if same_identity and not source_playing {
            struct.set(state,next_seek,field=endpoint_seek_requested)
            struct.set(state,next_end,field=endpoint_end_requested)
          }
        }
        if not playing_now and audio_active {
          audio_preparing=false
          let _ = native_audio.request(library, "stop", "")
          audio_active = false
          audio_generation = audio_generation + 1
          audio_request=audio_request+1
          audio_pending=false
          if audio_playback.discard(str.view(audio_root),audio_request,audio_generation) {
            release_playback_output(first_pcm,str.view(audio_task_output))
          }else{app.set_status(state,"[GA_AUDIO_RETIRE] Cannot retire playback output")}
          let _ = preview_link.wake(audio_transport,false)
        }
        let signature_begin: u64 = window_profile.stamp(window_measure)
        let sound_refreshed: bool = window_cache.refresh(state,semantic_cache)
        var mix_changed: bool = sound_revision != state.media_revision
        if source_playing {
          let next_sound: string = string.from_int(struct.get(struct.borrow(state,field=document),field=monitor_source))
          if not str.eq(str.view(next_sound),str.view(sound_signature)) {mix_changed=true
            sound_signature=next_sound}
        } else if sound_refreshed or previous_source {
          // The cached wire mix is compared only after an edit or mode switch.
          let next_sound: ref<string> = struct.borrow(semantic_cache,field=audio)
          if not str.eq(str.view(next_sound),str.view(sound_signature)) {mix_changed=true
            sound_signature=string.copy(str.view(next_sound))}
        }
        sound_revision = state.media_revision
        struct.set(window_row,window_row.signature+window_profile.stamp(window_measure)-signature_begin,field=signature)
        if playing_now and not source_waits_for_endpoint(state,source_playing) and audio_restart_needed(state,source_playing,audio_active,previous_playing,previous_source,frame_now,previous_frame,mix_changed,endpoint_pending,audio_preparing,first_pcm,audio_generation) {
          // A mix edit may retire a later completed chunk after the first PCM
          // flags are clear. Supersede its producer before releasing the owned
          // output, and only then reuse that path for the new device epoch.
          let _ = native_audio.request(library,"stop","")
          audio_active=false
          audio_preparing=false
          if audio_generation == 18446744073709551615 or audio_request >= 18446744073709551614 {
            app.set_status(state,"[GA_AUDIO_RETIRE] Playback generation exhausted")
            pause_transport(state, source_playing)
          }else{
            audio_generation=audio_generation+1
            audio_request=audio_request+1
            if audio_playback.discard(str.view(audio_root),audio_request,audio_generation) {
              release_playback_output(first_pcm,str.view(audio_task_output))
              audio_pending=false
              let _ = preview_link.wake(audio_transport,false)
              audio_origin = frame_now
              audio_next = frame_now
              silent_begin=0
              silent_anchor=0
              endpoint_pending=false
              let started: string = native_audio.request(library, "start", "")
              audio_active = str.eq(str.view(started), "ok")
              audio_preparing = audio_active
              first_pcm=first_pcm_begin(state,audio_generation,source_playing,audio_origin)
              if audio_active and not source_playing {
                audio_request=audio_request+1
                endpoint_requested_revision=state.document_revision
                endpoint_requested_media=state.media_revision
                endpoint_requested_owner=state.document.active
          endpoint_requested_seek=state.endpoint_seek_requested
          endpoint_requested_end=state.endpoint_end_requested
                audio_task_generation=audio_generation
                if audio_playback.request_prepare_document(str.view(audio_root),audio_request,audio_generation,struct.borrow(state,field=document),str.view(path.join(str.view(audio_root),"prepare.wav"))) {
                  endpoint_pending=true
                  preparing_program_audio(state,false)
                  dirty=true
                  let _=preview_link.wake(audio_transport,false)
                }else{fail_program_endpoint(state,library,audio_transport,first_pcm,str.view(audio_root),str.view(audio_task_output),audio_request,audio_generation,"[GA_AUDIO_ENDPOINT_PATH] Cannot publish Program preparation")
                  audio_active=false
                  audio_preparing=false
                  audio_pending=false}
              }
              if not audio_active and not str.eq(str.view(started),"ok") {
                if source_playing {app.set_status(state,str.view(started))
                  pause_transport(state,true)}else{
                  fail_program_endpoint(state,library,audio_transport,first_pcm,str.view(audio_root),str.view(audio_task_output),audio_request,audio_generation,str.view(started))
                  audio_preparing=false
                  audio_pending=false}
              }
            }else{
              app.set_status(state,"[GA_AUDIO_RETIRE] Cannot retire playback output before restart")
              pause_transport(state,source_playing)
            }
          }
        }
        // Cold End is also an asynchronous graph preparation; it queues no PCM.
        if app.endpoint_requested(state) and not endpoint_pending and (source_playing or not editor.playing(struct.borrow(state,field=document))) {
          if audio_request>=18446744073709551614 {
            fail_program_endpoint(state,library,audio_transport,first_pcm,str.view(audio_root),str.view(audio_task_output),audio_request,audio_generation,"[GA_AUDIO_RETIRE] Playback request identity exhausted")
            audio_active=false
            audio_preparing=false
            audio_pending=false
          }else{
          audio_request=audio_request+1
          endpoint_requested_revision=state.document_revision
          endpoint_requested_media=state.media_revision
          endpoint_requested_owner=state.document.active
                endpoint_requested_seek=state.endpoint_seek_requested
                endpoint_requested_end=state.endpoint_end_requested
          audio_task_generation=audio_generation
          if audio_playback.request_prepare_document(str.view(audio_root),audio_request,audio_generation,struct.borrow(state,field=document),str.view(path.join(str.view(audio_root),"prepare.wav"))) {
            endpoint_pending=true
            preparing_program_audio(state,true)
            dirty=true
            let _=preview_link.wake(audio_transport,false)
          }else{fail_program_endpoint(state,library,audio_transport,first_pcm,str.view(audio_root),str.view(audio_task_output),audio_request,audio_generation,"[GA_AUDIO_ENDPOINT_PATH] Cannot publish End preparation")
            audio_active=false
            audio_preparing=false
            audio_pending=false}
          }
        }
        preview_link.poll(audio_transport)
        if endpoint_pending and (audio_transport.ready==audio_request or audio_transport.error_generation==audio_request or audio_transport.closed) {
          dirty=true
          endpoint_pending=false
          if audio_transport.ready!=audio_request {
            let problem:string=string.copy(struct.borrow(audio_transport,field=error))
            fail_program_endpoint(state,library,audio_transport,first_pcm,str.view(audio_root),str.view(audio_task_output),audio_request,audio_generation,str.view(problem))
            audio_active=false
            audio_preparing=false
            audio_pending=false
          }else{
            match audio_playback.read_endpoint(str.view(audio_root)) {
              err(problem)=>{fail_program_endpoint(state,library,audio_transport,first_pcm,str.view(audio_root),str.view(audio_task_output),audio_request,audio_generation,str.view(problem))
                audio_active=false
                audio_preparing=false
                audio_pending=false},
              ok(end)=>{
                if app.accept_endpoint(state,end,audio_request,endpoint_requested_revision,endpoint_requested_media,endpoint_requested_owner) {
                  dirty=true
                  let requested_end:bool=state.endpoint_end_requested
                  if app.complete_endpoint_navigation(state) {
                    audio_origin=editor.playhead(struct.borrow(state,field=document))
                    audio_next=audio_origin
                    if editor.playing(struct.borrow(state,field=document)) {first_pcm=first_pcm_begin(state,audio_generation,false,audio_origin)}
                    prepared_program_audio(state,if requested_end {"End"}else{"Sought"})
                  }
                  let active:u64=state.document.active
                  let fps:f64=editor.sequence_fps(struct.borrow(state,field=document),active)
                  audio_next_sample=endpoint.sample(audio_origin,fps)
                  let actual:i64=match struct.borrow(state,field=accepted_audio) {some(v)=>v.actual,none=>0,}
                  if audio_next_sample>=actual {audio_preparing=false
                    first_pcm=pcm_preroll()}
                }else{fail_program_endpoint(state,library,audio_transport,first_pcm,str.view(audio_root),str.view(audio_task_output),audio_request,audio_generation,"[GA_AUDIO_ENDPOINT_STALE] Preparation identity was superseded")
                  audio_active=false
                  audio_preparing=false
                  audio_pending=false}
              },
            }
          }
        }
        if audio_pending and not first_pcm.ready and (audio_transport.ready == audio_request or audio_transport.error_generation == audio_request or audio_transport.closed) {
          if audio_task_generation == audio_generation and playing_now and audio_active {
            if audio_transport.ready != audio_request {
              if audio_transport.closed {app.set_status(state,"[GA_AUDIO_TASK_CLOSED] Playback worker ended")}
              else {app.set_status(state,str.view(struct.borrow(audio_transport,field=error)))}
              pause_transport(state,source_playing)
              let _ = native_audio.request(library,"stop","")
              audio_active=false
            } else if audio_preparing {
              // Retain this completed file and request until actual picture priming.
              let _ = first_pcm_received(first_pcm,audio_generation,clock.start())
            } else {
              let queued: string = native_audio.request(library,"queue",str.view(audio_task_output))
              if not str.eq(str.view(queued),"ok") {
                app.set_status(state,str.view(queued))
                pause_transport(state,source_playing)
                let _ = native_audio.request(library,"stop","")
                audio_active=false
              } else {
                audio_next=audio_task_end
                audio_next_sample=audio_task_end_sample
                audio_preparing=false
              }
            }
          }
          if not first_pcm.ready {
            audio_pending=false
            let _ = files.remove(str.view(audio_task_output))
          }
        }
        if audio_active and playing_now {
          var device: native_audio.Clock = native_audio.clock(library)
          let active: u64 = struct.get(struct.borrow(state, field=document), field=active)
          let fps: f64 = if source_playing { timeline_media.monitor_fps(struct.borrow(state, field=document)) }
            else { editor.sequence_fps(struct.borrow(state, field=document), active) }
          let finish: i64 = if source_playing { let selected: u64 = struct.get(struct.borrow(state, field=document), field=monitor_source)
            editor.source_frames(struct.borrow(state, field=document), selected) } else { app.presentation_duration(state) }
          if finish <= 0 {
            pause_transport(state, source_playing)
            let _ = native_audio.request(library, "stop", "")
            audio_active = false
            audio_preparing = false
          }
          if not source_playing and app.endpoint_current(state) and not audio_preparing {
            let actual_end:i64=match struct.borrow(state,field=accepted_audio) {some(v)=>v.actual,none=>0,}
            if device.ok and device.queued==0 and not audio_pending and audio_next_sample>=actual_end {
              let origin_ready:bool=silent_origin_ready(state,pictures,audio_origin,finish,audio_generation,
                native_program_frame,native_program_revision,native_program_media,
                audio_next_sample>endpoint.sample(audio_origin,fps))
              if silent_begin==0 and origin_ready {silent_begin=clock.start()
                silent_anchor=device.samples
                prepared_program_audio(state,"Playing")
                dirty=true}
            }
            if silent_begin!=0 {extend_silent_clock(device,silent_begin,silent_anchor,clock.start())}
          }
          if not device.ok {
            app.set_status(state, str.view(struct.borrow(device, field=error)))
            pause_transport(state, source_playing)
          } else {
            if not audio_preparing {
              let endpoint_done:bool=app.endpoint_current(state) and match struct.borrow(state,field=accepted_audio) {some(v)=>audio_next_sample>=v.actual and endpoint.completed(v,audio_origin,device.samples),none=>false,}
              let presentation:i64=app.presentation_duration(state)
              let doc: ref<editor.Document> = struct.borrow(state, field=document)
              let last: i64 = if finish > 0 { finish - 1 } else { 0 }
              let actual: i64 = transport_clock.frame_at_samples(audio_origin,device.samples,fps,last)
              let current: i64 = if source_playing { struct.get(struct.borrow(doc, field=monitor), field=frame) } else { editor.playhead(doc) }
              if actual != current { let _ = if source_playing { editor.seek_monitor(doc, actual) } else { editor.seek_until(doc, actual,presentation) }
                passive_changed = true }
              let finished:bool=if source_playing {
                if device.queued==0 and actual>=last and audio_next>=finish {let _=editor.monitor_action(doc,editor.pause())
                  true}else{false}
              }else if endpoint_done {match struct.borrow(state,field=accepted_audio) {some(v)=>finish_program_until(doc,v,audio_origin,device.samples,device.queued),none=>false,}}
                else{false}
              if finished {
                let _=native_audio.request(library,"stop","")
                audio_active=false
                silent_begin=0
              }
            }
            if audio_active and device.queued<2 and not audio_pending and not endpoint_pending and not source_playing and app.endpoint_current(state) {
              let accepted_end:i64=match struct.borrow(state,field=accepted_audio) {some(v)=>v.actual,none=>0,}
              if audio_next_sample<accepted_end {
                let remaining:i64=if accepted_end-audio_next_sample>240000 {240000}else{accepted_end-audio_next_sample}
                let count:u64=cast.wrap(remaining)
                audio_task_end_sample=audio_next_sample+cast.wrap(count)
                audio_task_end=match endpoint.frame_end(audio_task_end_sample,fps) {ok(v)=>v,err(_)=>finish,}
                audio_task_generation=audio_generation
                audio_task_output=path.join(provider.media_root(struct.borrow(state,field=provider)),"playback-chunk.wav")
                audio_request=audio_request+1
                if audio_playback.request_pull(str.view(audio_root),audio_request,audio_generation,state.endpoint_prepare,str.view(audio_task_output),audio_next_sample,count) {
                  audio_pending=true
                  let _=preview_link.wake(audio_transport,false)
                }else{app.set_status(state,"[GA_AUDIO_ENDPOINT_PATH] Cannot publish exact PCM pull")
                  pause_transport(state,false)}
              }
            }
            if audio_active and source_playing and device.queued < 2 and not audio_pending and audio_next < finish {
              let chunk: i64 = cast.sat(fps * 5.0)
              audio_task_end = if audio_next + chunk > finish { finish } else { audio_next + chunk }
              let worker: string = provider.worker_path(struct.borrow(state, field=provider))
              let scratch: string = provider.media_root(struct.borrow(state,field=provider))
              audio_task_output = path.join(str.view(scratch), "playback-chunk.wav")
              let prepared: result<timeline_media.AudioPlan,string> = if source_playing {
                timeline_media.source_audio_range(struct.borrow(state, field=document), str.view(worker), audio_next, audio_task_end, str.view(audio_task_output))
              } else {
                timeline_media.audio_plan_range(struct.borrow(state, field=document), str.view(worker), audio_next, audio_task_end, str.view(audio_task_output))
              }
              match prepared {
                err(problem) => {
                  app.set_status(state, str.view(problem))
                  pause_transport(state, source_playing)
                  // A planning refusal must silence this device epoch before
                  // paint. The inactive path below supersedes its producer and
                  // releases held PCM during this same iteration.
                  let _ = native_audio.request(library,"stop","")
                  audio_active=false
                  audio_preparing=false
                },
                ok(plan) => {
                  audio_task_generation = audio_generation
                  var prepared_plan: timeline_media.AudioPlan = plan
                  audio_request=audio_request+1
                  if audio_playback.request(str.view(audio_root),audio_request,audio_generation,prepared_plan) {
                    audio_pending=true
                    match preview_link.wake(audio_transport,false) {ok(_)=>{},err(problem)=>{app.set_status(state,str.view(problem))
                      pause_transport(state,source_playing)},}
                  } else {
                    app.set_status(state,"[GA_AUDIO_TASK_WRITE] Cannot publish playback request")
                    pause_transport(state,source_playing)
                  }
                },
              }
            }
          }
        }
        if not audio_active and not endpoint_pending and (audio_pending or playing_now) {
          audio_preparing=false
          if audio_request == 18446744073709551615 {
            app.set_status(state,"[GA_AUDIO_RETIRE] Playback request generation exhausted")
          }else{
            audio_request=audio_request+1
            if audio_playback.discard(str.view(audio_root),audio_request,audio_generation) {
              release_playback_output(first_pcm,str.view(audio_task_output))
              audio_pending=false
            }else{app.set_status(state,"[GA_AUDIO_RETIRE] Cannot retire playback output")}
            let _ = preview_link.wake(audio_transport,false)
          }
        }
        if audio_active and playing_now {
          var levels: native_audio.Levels = native_audio.levels(library)
          if levels.ok {
            if state.audio_left != levels.left or state.audio_right != levels.right { passive_changed = true }
            struct.set(state, levels.left, field=audio_left)
            struct.set(state, levels.right, field=audio_right)
          }
        }
        audio_library = option.some(library)
      },
    }
    if not audio_active or not playing_now {
      if state.audio_left != 0.0 or state.audio_right != 0.0 { dirty = true }
      struct.set(state, 0.0, field=audio_left)
      struct.set(state, 0.0, field=audio_right)
    }
    // A dropped-file import below can replace/edit the document after the audio
    // clock was selected. Never apply that old device epoch to the new content.
    // Recorder I/O follows native audio service/retirement. A Stop plus Help-off
    // in the same input batch cannot flush before the device is stopped.
    let timing_program_playing:bool=editor.playing(struct.borrow(state,field=document))
    let timing_source_playing:bool=struct.get(struct.borrow(struct.borrow(state,field=document),field=monitor),field=playing)
    let timing_publish_ready:bool=window_profile.flush_ready(timing_program_playing,timing_source_playing,audio_active)
    // Automatic cap finalization waits for a paused, native-retired service phase.
    // Explicit Help-off remains the user's immediate requested finalization.
    if timing_limit_pending and window_measure.enabled and
        window_profile.finish_cap(window_measure.rows,timing_program_playing,timing_source_playing,audio_active) {
      struct.set(state,false,field=window_timing_requested)
    }
    if state.window_timing_requested != window_measure.enabled {
      if state.window_timing_requested {
        match window_profile.start_local(provider.media_root(struct.borrow(state,field=provider))) {
          ok(value)=>{let _=ref.swap(window_measure,value)
            app.set_status(state,text.concat("Recording playback timing: ",struct.borrow(window_measure,field=path)))},
          err(problem)=>{struct.set(state,false,field=window_timing_requested)
            app.set_status(state,str.view(problem))},}
      }else{
        match window_profile.stop(window_measure) {
          ok(_)=>{app.set_status(state,text.concat(if timing_limit_pending {"Playback timing saved (50,000-row limit): "}else{"Playback timing saved: "},struct.borrow(window_measure,field=path)))},
          err(problem)=>{app.set_status(state,str.view(problem))},}
      }
      timing_limit_pending=false
      timing_flush_pending=false
      dirty=true
    }
    if timing_flush_pending and timing_publish_ready {
      timing_flush_pending=false
      if window_measure.enabled {
        match window_profile.flush_checked(window_measure) {ok(_)=>{},err(problem)=>{
          struct.set(state,false,field=window_timing_requested)
          app.set_status(state,str.view(problem))
          diagnostics.record(struct.borrow(struct.borrow(state,field=provider),field=scratch),
            "GA_WINDOW_PROFILE_WRITE",str.view(problem),"window-timing-stop")
          dirty=true},}
      }
    }
    let audio_follow_revision: u64 = state.document_revision
    let audio_follow_media: u64 = state.media_revision
    previous_source = source_playing
    previous_playing = if source_playing { struct.get(struct.borrow(struct.borrow(state, field=document), field=monitor), field=playing) }
      else { editor.playing(struct.borrow(state, field=document)) }
    previous_frame = if source_playing { struct.get(struct.borrow(struct.borrow(state, field=document), field=monitor), field=frame) }
      else { editor.playhead(struct.borrow(state, field=document)) }
    let dropped: string = gui.dropped_files(window)
    if str.len(dropped) != 0 and not session.pending(state) {
      var imported: commands.Result = commands.import_drop(state, dropped)
      app.set_status(state, commands.message(imported))
      repaint_all = true
      dirty = true
    }
    if (state.fullscreen != 0) != native_fullscreen {
      native_fullscreen = state.fullscreen != 0
      ui.fullscreen(window, native_fullscreen)
      repaint_all = true
      dirty = true
    }
    let box: gui.Rect = gui.window_size(window)
    let width: u32 = if box.width < 640 { 640 } else { box.width }
    let height: u32 = if box.height < 480 { 480 } else { box.height }
    let physical_width: u64 = cast.wrap(width)
    let physical_height: u64 = cast.wrap(height)
    let ui_scale: f64 = layout.ui_scale(cast.float(physical_width),
      cast.float(physical_height))
    let logical_width: f64 = cast.float(physical_width) / ui_scale
    let logical_height: f64 = cast.float(physical_height) / ui_scale
    let presentation:i64=app.presentation_duration(state)
    let doc: ref<editor.Document> = struct.borrow(state,field=document)
    let picture_source: bool = struct.get(struct.borrow(doc,field=monitor),field=playing)
    let picture_playing: bool = picture_source or editor.playing(doc)
    var wanted: i64 = if picture_source {struct.get(struct.borrow(doc,field=monitor),field=frame)}else{editor.playhead(doc)}
    let parked_program: i64 = editor.playhead(doc)
    let parked_source: i64 = struct.get(struct.borrow(doc,field=monitor),field=frame)
    let fps: f64 = if picture_source {timeline_media.monitor_fps(doc)}else{editor.sequence_fps(doc,doc.active)}
    let finish: i64 = if picture_source {editor.source_frames(doc,doc.monitor_source)}else{presentation}
    let picture_source_id:u64 = doc.monitor_source
    if window_measure.enabled {
      window_profile.context(window_row,picture_source,picture_playing,audio_origin,fps,
        if finish > 0 {finish-1}else{0},state.presented_program_frame,state.presented_source_frame)
      // These identify the pixels about to be painted, before input can install
      // a new document or viewport at the end of this same loop iteration.
      struct.set(window_row,state.document_revision,field=revision)
      struct.set(window_row,state.media_revision,field=media_revision)
      struct.set(window_row,width,field=width)
      struct.set(window_row,height,field=height)
    }
    let monitor_width: u32 = if state.fullscreen != 0 {1280}else{480}
    let monitor_height: u32 = if state.fullscreen != 0 {720}else{270}
    if dirty or not pictures.initialized or pictures.epoch != audio_generation or
        pictures.playing != picture_playing or pictures.source != picture_source or
        pictures.width != monitor_width or pictures.height != monitor_height {
      let signature_begin: u64 = window_profile.stamp(window_measure)
      let key: string = picture_queue.identity_revision(state,picture_source,picture_playing)
      if picture_queue.configure(pictures,key,audio_generation,picture_playing,picture_source,monitor_width,monitor_height) {
        preview_link.retire_window(preview_transport)
        dirty=true}
      struct.set(window_row,window_row.signature+window_profile.stamp(window_measure)-signature_begin,field=signature)
    }
    // A failed old decode belongs to the retired request range after Stop,
    // seek, source replacement or an audio restart. Evaluate failure only after
    // configuring that range, and distinguish repeated codes by generation.
    var picture_failed: bool = false
    match preview.current_failure(preview_transport,
        picture_queue.failure_accepts(pictures,preview_transport.error_generation)) {
      none=>{
        // Recovery clears deduplication too: a later generation-zero channel
        // failure can have the same text as the earlier recovered failure.
        if str.len(preview_channel_error) != 0 {
          preview_channel_generation=0
          preview_channel_error=string.new()
        }
      },some(channel_error)=>{
        // Deduplicate status text, not the failure itself. A latched terminal
        // channel error must continue to prevent new requests and PCM starts.
        picture_failed=true
        if preview_channel_generation != preview_transport.error_generation or
            not str.eq(str.view(channel_error),str.view(preview_channel_error)) or
            not str.eq(str.view(channel_error),str.view(struct.borrow(state,field=status))) {
          app.set_status(state,str.view(channel_error))
          dirty=true
        }
        pause_transport(state,true)
        pause_transport(state,false)
        preview_channel_generation=preview_transport.error_generation
        preview_channel_error=channel_error
      },
    }
    preview_media_revision=state.media_revision
    loop {
      let ready:u64=preview_link.next_completed(preview_transport)
      if ready==0 {break}
      if not preview_link.select_completed(preview_transport,ready) {break}
      // Configure after following the audio clock, before consuming a completion:
      // a seek or restart must retire the previous epoch's prepared pictures.
      if app.endpoint_picture_ready(state) and picture_queue.accepts(pictures,ready) {
        var images: array<draw.Surface> = preview_link.take_images(preview_transport,ready)
        let position: preview_link.FramePosition = preview_transport.position
        if array.len(images) == 2 and position.revision == state.media_revision and
            picture_queue.matches(pictures,ready,position.source_frame,position.program_frame) {
          var next_program: draw.Surface = option.unwrap(array.pop(images))
          var next_source: draw.Surface = option.unwrap(array.pop(images))
          var held: bool = preview_link.holds_source(preview_transport)
          if held and (source_image.width == 0 or state.presented_source_frame != position.source_frame or
              source_pixels_revision != state.document_revision or source_pixels_media != state.media_revision or
              source_pixels_id != picture_source_id) {
            next_source=preview_link.restore_source(preview_transport)
            held=false
          }
          // The parked Source monitor has no future time. Preserve its pixels
          // immediately so retiring a prepared Program frame cannot erase it.
          if not picture_source and not held {
            let _ = ref.swap(source_image,next_source)
            source_pixels_pending = true
            next_source=draw.empty_surface()
            struct.set(state,position.source_frame,field=presented_source_frame)
            source_pixels_revision=state.document_revision
            source_pixels_media=state.media_revision
            source_pixels_id=picture_source_id
            held=true
            dirty=true
          }
          if not picture_queue.receive(pictures,ready,picture_queue.Frame {
              source:next_source,program:next_program,position:position,held_source:held},clock.start()) {
            app.set_status(state,"[GA_PREVIEW_CREDIT] Completed packet cannot acquire its reserved picture slot")
            pause_transport(state,true)
            pause_transport(state,false)
            picture_failed=true
            dirty=true
          }
        }else{
          app.set_status(state,"[GA_PREVIEW_PACKET] Completed picture does not match the current media generation")
          pause_transport(state,true)
          pause_transport(state,false)
          picture_failed=true
          dirty=true
        }
        let problem: string = string.copy(str.view(struct.borrow(preview_transport,field=pixel_error)))
        if str.len(problem) != 0 and problem != preview_error {app.set_status(state,problem)
          pause_transport(state,true)
          pause_transport(state,false)
          dirty=true}
        preview_error=problem
      }
    }
    // Completion processing may take time. Choose due pixels from a fresh real
    // device sample, never a projected future clock or a retired document epoch.
    if audio_active and not audio_preparing and picture_playing and
        picture_source == source_playing and audio_generation == pictures.epoch and
        state.document_revision == audio_follow_revision and state.media_revision == audio_follow_media and
        not picture_failed {
      match ref.swap(audio_library,option.none()) {none=>{},some(opened)=>{
        var library: CAbiLibrary = opened
        var device: native_audio.Clock = native_audio.clock(library)
        if not picture_source and silent_begin!=0 {extend_silent_clock(device,silent_begin,silent_anchor,clock.start())}
        if not device.ok {
          app.set_status(state,str.view(struct.borrow(device,field=error)))
          pause_transport(state,picture_source)
          picture_failed=true
          dirty=true
        } else {
          match apply_picture_clock(state,device,audio_origin,fps,if finish > 0 {finish-1}else{0},
              picture_source,audio_generation,pictures.epoch,audio_follow_revision,audio_follow_media,previous_frame) {
            none=>{},some(actual)=>{if actual != wanted {passive_changed=true}
              wanted=actual},
          }
        }
        audio_library=option.some(library)
      },}
    }
    if not picture_failed and app.endpoint_picture_ready(state) {
      match picture_queue.take_due(pictures,wanted) {none=>{},some(frame)=>{
        if not frame.held_source {
          source_pixels_pending = true
          source_pixels_revision=state.document_revision
          source_pixels_media=state.media_revision
          source_pixels_id=picture_source_id
        }
        picture_queue.apply(state,frame,source_image,program_image)
        program_pixels_revision=state.document_revision
        program_pixels_media=state.media_revision
        dirty=true},}
    }
    let shown_identity:bool = if picture_source {
      source_pixels_revision == state.document_revision and source_pixels_media == state.media_revision and
        source_pixels_id == picture_source_id
    }else{program_pixels_revision == state.document_revision and program_pixels_media == state.media_revision}
    let shown:i64=picture_schedule_shown(audio_preparing,shown_identity,
      if picture_source {state.presented_source_frame}else{state.presented_program_frame})

    let next_target: option<i64> = if picture_failed or not app.endpoint_picture_ready(state) {option.none()}else{
      picture_queue.window_target(pictures,wanted,if finish > 0 {finish-1}else{0},fps,shown)
    }
    match next_target {
      none=>{},some(target)=>{
        let last:i64=if finish>0 {finish-1}else{0}
        let count:u64=picture_queue.window_count(pictures,target,last)
        let program_frame: i64 = if picture_source {parked_program}else{target}
        let source_frame: i64 = if picture_source {target}else{parked_source}
        let signature_begin: u64 = window_profile.stamp(window_measure)
        if count>0 and preview_requested<=18446744073709551615-count {
          let first_id:u64=preview_requested+1
          let last_id:u64=preview_requested+count
          if preview.request_window(state,preview_root,preview_transport,first_id,count,
              struct.borrow(pictures,field=key),program_frame,source_frame,monitor_width,monitor_height,picture_source) {
            preview_requested=last_id
            if not picture_queue.requested_window(pictures,first_id,count,target,last,clock.start()) {
              app.set_status(state,"[GA_PREVIEW_CREDIT] Cannot reserve the published decode window")
              pause_transport(state,true)
              pause_transport(state,false)
              dirty=true
            }
            if window_measure.enabled {
              struct.set(window_row,first_id,field=window_first_id)
              struct.set(window_row,last_id,field=window_last_id)
              struct.set(window_row,target,field=window_first_frame)
              struct.set(window_row,target+cast.wrap(count-1),field=window_last_frame)
              struct.set(window_row,count,field=window_count)
            }
          }else{
            match preview.current_failure(preview_transport,
                picture_queue.failure_accepts(pictures,preview_transport.error_generation)) {
              some(problem)=>{app.set_status(state,str.view(problem))},
              none=>{app.set_status(state,"[GA_PREVIEW_REQUEST] Cannot publish the preview window")},
            }
            pause_transport(state,true)
            pause_transport(state,false)
            dirty=true}
        }else{app.set_status(state,"[GA_PREVIEW_CREDIT] Invalid or exhausted decode-window identity")
          pause_transport(state,true)
          pause_transport(state,false)
          dirty=true}
        struct.set(window_row,window_row.signature+window_profile.stamp(window_measure)-signature_begin,field=signature)
      },
    }
    if window_measure.enabled {
      struct.set(window_row,picture_queue.pending_frame(pictures,0),field=prepared_first)
      struct.set(window_row,picture_queue.pending_frame(pictures,1),field=prepared_last)
      struct.set(window_row,pictures.last_requested,field=requested_frame)
      struct.set(window_row,pictures.in_flight,field=in_flight)
      struct.set(window_row,pictures.received,field=received)
      struct.set(window_row,preview_transport.completed_total,field=completed)
      struct.set(window_row,preview_transport.overwritten_total,field=overwritten)
      struct.set(window_row,array.len(struct.borrow(pictures,field=frames)),field=owned_credit)
      struct.set(window_row,picture_queue.reserved(pictures),field=reserved_credit)
    }
    // Following is a viewport action, independent of authored/history state.
    // Use the same completed Program frame as the painted timeline and time.
    // An active pointer gesture owns its geometry until release; Source never pans Program.
    if timeline_follow.allowed(state.timeline_follow_program,source_playing,
        app.gesture_kind(state)!=app.drag_none(),app.endpoint_requested(state),
        editor.playing(struct.borrow(state,field=document)),state.presented_program_frame,
        program_pixels_revision==state.document_revision and program_pixels_media==state.media_revision) {
      let follow_frame:layout.Frame=layout.frame(logical_width,logical_height)
      let follow_scroll:i64=app.scroll(state)
      let follow_span:i64=app.visible_span(state,layout.width_of(follow_frame.timeline))
      let followed:i64=timeline_follow.page(app.timeline_frame(state),follow_scroll,follow_span,
        state.timeline_follow_program,source_playing)
      if followed!=follow_scroll {let _=app.set_scroll(state,followed)
        timeline_damage=true
        dirty=true}
    }
    // Fresh pictures and user actions repaint immediately. Clock/meter-only
    // updates get a bounded interval so repeated old frames cannot monopolize
    // the presenter while the next picture is being prepared.
    if passive_changed { passive_pending = true }
    if passive_pending and clock.start() - last_present_ns >= 33000000 { dirty = true }
    if dirty {
      let view_frame: layout.Frame = layout.frame(logical_width, logical_height)
      let span: i64 = app.visible_span(state,layout.width_of(view_frame.timeline))
      let body_height: f64 = layout.height_of(view_frame.timeline)
      let first_lane: u64 = app.clamp_track_scroll(state,body_height)
      if not strip_initialized or strip_document_revision != state.document_revision or strip_project_epoch != state.project_epoch or
          strip_revision != state.media_revision or strip_scroll != app.scroll(state) or strip_zoom != app.zoom(state) or strip_span != span or
          strip_first_lane != first_lane or strip_body_height != body_height {
        let signature_begin: u64 = window_profile.stamp(window_measure)
        // Encode only a real content/viewport change, never a moving heard clock.
        let signature: string = match editor_io.encode(struct.borrow(state,field=document)) {
          ok(value)=>value,err(_)=>string.new(),
        }
        strip_requested=strip_requested+1
        if preview.request_visual_strips(str.view(strip_root),str.view(signature),strip_requested,app.scroll(state),app.zoom(state),span,480,270,state.media_revision,state.document_revision,first_lane,body_height,state.project_epoch) {
          app.waveform_request(state,strip_requested)
          waveform_damage=true
          let _ = preview_link.wake(strip_transport,false)
          strip_document_revision=state.document_revision
          strip_project_epoch=state.project_epoch
          strip_initialized=true
          strip_revision=state.media_revision
          strip_scroll=app.scroll(state)
          strip_zoom=app.zoom(state)
          strip_span=span
          strip_first_lane=first_lane
          strip_body_height=body_height
        }else{app.waveform_failure(state,0)
          waveform_damage=true
          app.set_status(state,"[GA_TIMELINE_REQUEST] Cannot publish timeline bitmap request")}
        struct.set(window_row,window_row.signature+window_profile.stamp(window_measure)-signature_begin,field=signature)
      }
      let paint_begin: u64 = window_profile.stamp(window_measure)
      let painted: bool = painter.render_with_timeline_regions(state,renderer,width,height,repaint_all,source_image,program_image,not source_pixels_pending,timeline_damage,waveform_damage,thumbnail_damage)
      struct.set(window_row,window_profile.stamp(window_measure)-paint_begin,field=paint)
      if painted {
        if window_measure.enabled {
          // Queue application can change completed pixels after loop context.
          struct.set(window_row,state.presented_program_frame,field=program)
          struct.set(window_row,state.presented_source_frame,field=source)
          window_profile.sample(audio_library,window_row,false)
          struct.set(window_row,window_profile.stamp(window_measure),field=present_begin)
        }
        match gui.present_surface(window,struct.borrow(renderer,field=surface)) {
          ok(_) => {struct.set(window_row,true,field=present_ok)
            last_present_ns = clock.start()
            passive_pending = false
            source_pixels_pending = false
            native_program_frame=state.presented_program_frame
            native_source_frame=state.presented_source_frame
            native_program_revision=program_pixels_revision
            native_program_media=program_pixels_media
            native_source_revision=source_pixels_revision
            native_source_media=source_pixels_media
            native_source_id=source_pixels_id},
          err(_) => {app.set_status(state,"[GA_UI_PRESENT] Native presenter could not display the window frame")},
        }
        if window_measure.enabled {
          struct.set(window_row,window_profile.stamp(window_measure),field=present_end)
          struct.set(window_row,window_row.present_end-window_row.present_begin,field=present)
          window_profile.sample(audio_library,window_row,true)
        }
      } else {app.set_status(state,"[GA_UI_SURFACE] The window canvas could not be allocated")}
      if window_row.present_ok {
        timeline_damage = false
        waveform_damage=false
        thumbnail_damage=false
        repaint_all = false
        dirty = false
      } else {
        // Keep an unsuccessful paused edit eligible for a bounded retry too.
        repaint_all = true
        dirty = true
      }
    }
    // The first waveOut queue starts the real device clock. Hold that exact
    // completed PCM while callbacks/input continue and the bounded future queue
    // fills. A paused origin must have actually passed through native EndDraw.
    if audio_active and audio_preparing and audio_pending and first_pcm.ready {
      let native_shown:i64 = first_pcm_presented(first_pcm,native_program_frame,native_program_revision,
        native_program_media,native_source_frame,native_source_revision,native_source_media,native_source_id)
      let action:u32 = first_pcm_action(state,first_pcm,pictures,audio_generation,clock.start(),native_shown)
      let channel_failed:bool = audio_transport.closed or audio_transport.error_generation == audio_request
      if action == 1 and not picture_failed and not channel_failed {
        match ref.swap(audio_library,option.none()) {none=>{},some(opened)=>{
          var library:CAbiLibrary = opened
          let queued:string = native_audio.request(library,"queue",str.view(audio_task_output))
          if queued == "ok" {
            audio_next=audio_task_end
            audio_next_sample=audio_task_end_sample
            audio_preparing=false
            prepared_program_audio(state,"Playing")
            dirty=true
          }else{
            app.set_status(state,str.view(queued))
            pause_transport(state,first_pcm.source)
            let _ = native_audio.request(library,"stop","")
            audio_active=false
            audio_preparing=false
            dirty=true
          }
          audio_pending=false
          first_pcm_release(first_pcm,str.view(audio_task_output))
          audio_library=option.some(library)
        },}
        if not audio_active {
          audio_generation=audio_generation+1
          audio_request=audio_request+1
          let _ = audio_playback.discard(str.view(audio_root),audio_request,audio_generation)
          let _ = preview_link.wake(audio_transport,false)
        }
      }else if action >= 2 or picture_failed or channel_failed {
        if action == 3 {
          app.set_status(state,"[GA_PREVIEW_PREROLL] Future pictures were not ready within two seconds of first PCM completion")
          pause_transport(state,first_pcm.source)
          dirty=true
        }else if channel_failed {
          if audio_transport.closed {app.set_status(state,"[GA_AUDIO_TASK_CLOSED] Playback worker ended during picture priming")}
          else {app.set_status(state,str.view(struct.borrow(audio_transport,field=error)))}
          pause_transport(state,first_pcm.source)
          dirty=true
        }
        match ref.swap(audio_library,option.none()) {none=>{},some(opened)=>{
          var library:CAbiLibrary = opened
          let _ = native_audio.request(library,"stop","")
          audio_library=option.some(library)
        },}
        audio_active=false
        audio_preparing=false
        audio_pending=false
        audio_generation=audio_generation+1
        audio_request=audio_request+1
        if audio_playback.discard(str.view(audio_root),audio_request,audio_generation) {
          release_playback_output(first_pcm,str.view(audio_task_output))
        }else{app.set_status(state,"[GA_AUDIO_RETIRE] Cannot retire playback output")}
        let _ = preview_link.wake(audio_transport,false)
      }
    }
    // EndDraw can block through a refresh. Re-read the device after presenting
    // before waiting for an already prepared picture; its deadline owns this wait.
    var event_wait: u64 = if picture_playing {8}else{20}
    if audio_active and not audio_preparing and picture_playing and not picture_failed and
        audio_generation == pictures.epoch and state.document_revision == audio_follow_revision and
        state.media_revision == audio_follow_media and picture_queue.pending_frame(pictures,0) >= 0 {
      match ref.swap(audio_library,option.none()) {none=>{},some(opened)=>{
        var library: CAbiLibrary = opened
        var device: native_audio.Clock = native_audio.clock(library)
        if not picture_source and silent_begin!=0 {extend_silent_clock(device,silent_begin,silent_anchor,clock.start())}
        if device.ok {
          let heard: i64 = transport_clock.frame_at_samples(audio_origin,device.samples,fps,if finish > 0 {finish-1}else{0})
          event_wait=cast.wrap(picture_queue.next_due_wait(pictures,heard,device.samples,audio_origin,fps,8))
        } else {
          app.set_status(state,str.view(struct.borrow(device,field=error)))
          pause_transport(state,picture_source)
          dirty=true
          event_wait=0
        }
        audio_library=option.some(library)
      },}
    }
    var drained: u64 = 0
    loop {
      let wait_begin: u64 = window_profile.stamp(window_measure)
      let event: ui.event = preview_link.wait(window,preview_transport,if drained == 0 {event_wait}else{0})
      struct.set(window_row,window_row.wait+window_profile.stamp(window_measure)-wait_begin,field=wait)
      if event.kind == 0 or event.kind == 14 { break }
      if event.kind == 15 and app.prompt_dragging(state) {
        app.prompt_release(state)
        repaint_all = true
        dirty = true
      }
      if event.kind == 1 {
        let note: string = input.close_request(state)
        app.set_status(state, str.view(note))
        repaint_all = true
        dirty = true
        break
      }
      match widgets.translate(event) {
        none => { },
        some(signal) => {
          match signal {
            PointerDown(point) => {
              if not widgets.point_secondary(point) {
              let at: widgets.Point = widgets.point_coordinates(point)
              let at_x: u64 = cast.wrap(at.x)
              let at_y: u64 = cast.wrap(at.y)
              pointer_x = cast.float(at_x) / ui_scale
              pointer_y = cast.float(at_y) / ui_scale
              var note: string = input.pointer_down(state, logical_width, logical_height,
                pointer_x, pointer_y)
              if str.len(str.view(note)) != 0 { app.set_status(state, str.view(note)) }
              repaint_all = true
              dirty = true
              }
            },
            PointerMove(point) => {
              let at: widgets.Point = widgets.point_coordinates(point)
              let mx: u64 = cast.wrap(at.x)
              let my: u64 = cast.wrap(at.y)
              pointer_x = cast.float(mx) / ui_scale
              pointer_y = cast.float(my) / ui_scale
              if input.pointer_hover(state, logical_width, logical_height, pointer_x, pointer_y) {
                repaint_all = true
                dirty = true
              }
              if app.gesture_kind(state) != app.drag_none() or app.dock_scroll_dragging(state) or app.parameter_dragging(state) or app.prompt_dragging(state) {
                var moving: string = input.pointer_move(state, logical_width, logical_height,
                  pointer_x, pointer_y)
                if str.len(str.view(moving)) != 0 {
                  app.set_status(state, str.view(moving))
                  repaint_all = true
                  dirty = true
                }
                if app.prompt_dragging(state) {
                  repaint_all = true
                  dirty = true
                }
              }
            },
            Scroll(wheel) => {
              var note: string = input.wheel_event(state, logical_width, logical_height, wheel, ui_scale)
              if str.len(str.view(note)) != 0 { app.set_status(state, str.view(note)) }
              repaint_all = true
              dirty = true
            },
            Key(press) => {
              // The window owns the canvas, so a committed "render" prompt is performed
              // here rather than in the input layer.
              if input.prompt_is_render(state) and press.code == widgets.key_return() {
                export_target = app.prompt_text(state)
                match begin_export(state, array.len(export_jobs) > 0) {
                  none => { },
                  some(job) => {
                    export_percent = 0
                    array.push(export_jobs, task.spawn(job, fn=run_export))
                  },
                }
              } else if press.code == widgets.key_escape() and array.len(export_jobs) > 0 and
                  not app.prompt_active(state) and not session.pending(state) {
                timeline_media.request_export_cancel(str.view(export_cancel))
                app.set_status(state, "cancelling export")
              } else {
                var note: string = input.key(state, press.code, press.control, press.shift)
                if str.len(str.view(note)) != 0 { app.set_status(state, str.view(note)) }
              }
              repaint_all = true
              dirty = true
            },
            Resize(extent) => { repaint_all = true
              dirty = true },
            Tick => { },
            PointerUp(point) => {
              if not widgets.point_secondary(point) {
              let at: widgets.Point = widgets.point_coordinates(point)
              let ux: u64 = cast.wrap(at.x)
              let uy: u64 = cast.wrap(at.y)
              pointer_x = cast.float(ux) / ui_scale
              pointer_y = cast.float(uy) / ui_scale
              if app.gesture_kind(state) != app.drag_none() or app.dock_scroll_dragging(state) or app.parameter_dragging(state) or app.prompt_dragging(state) {
                var released: string = input.pointer_up(state, logical_width, logical_height,
                  pointer_x, pointer_y)
                if str.len(str.view(released)) != 0 {
                  app.set_status(state, str.view(released))
                }
                repaint_all = true
                dirty = true
              }
              }
            },
            Text(entry) => {
              var note: string = input.text(state, entry)
              if str.len(str.view(note)) != 0 { app.set_status(state, str.view(note)) }
              repaint_all = true
              dirty = true
            },
            Progress(step) => { },
            MenuAccess(code) => {
              var note: string = input.menu_access(state, code)
              if str.len(note) != 0 { app.set_status(state, note) }
              repaint_all = true
              dirty = true
            },
          }
        },
      }
      drained = drained + 1
      if drained > 64 { break }
    }
    if not app.prompt_active(state) { handled_prompt = 0 }
    if app.prompt_active(state) and app.prompt_action(state) != handled_prompt and
        (app.prompt_action(state) == chrome.act_import() or app.prompt_action(state) == chrome.act_open() or
         app.prompt_action(state) == chrome.act_save() or app.prompt_action(state) == chrome.act_render() or
         app.prompt_action(state) == chrome.act_pool_relink() or app.prompt_action(state) == chrome.act_recover()) {
      handled_prompt = app.prompt_action(state)
      let action: u32 = app.prompt_action(state)
      let title: str = if action == chrome.act_import() { "Add media" }
        else if action == chrome.act_open() { "Open project" }
        else if action == chrome.act_save() { "Save project" }
        else if action == chrome.act_recover() { "Recover project" }
        else if action == chrome.act_render() { "Export video" }
        else { "Relink media" }
      let saving: bool = action == chrome.act_save() or action == chrome.act_render()
      let suggested: string = app.prompt_text(state)
      // A native picker suspends this consumer. Retire the producer's marker
      // before blocking, so bounded pixel credit never expires behind a dialog.
      pause_transport(state,true)
      pause_transport(state,false)
      match ref.swap(audio_library,option.none()) {none=>{},some(opened)=>{
        var library:CAbiLibrary=opened
        let _=native_audio.request(library,"stop","")
        audio_library=option.some(library)
      },}
      audio_active=false
      audio_preparing=false
      dirty=true
      repaint_all=true
      if audio_generation == 18446744073709551615 or audio_request == 18446744073709551615 or
          preview_requested == 18446744073709551615 {
        app.set_status(state,"[GA_MODAL_RETIRE] Playback generation exhausted")
        continue
      }
      audio_generation=audio_generation+1
      audio_request=audio_request+1
      if not audio_playback.discard(str.view(audio_root),audio_request,audio_generation) {
        app.set_status(state,"[GA_MODAL_RETIRE] Cannot retire playback audio before file picker")
        continue
      }
      release_playback_output(first_pcm,str.view(audio_task_output))
      audio_pending=false
      let _=preview_link.wake(audio_transport,false)
      preview_requested=preview_requested+1
      if not preview.retire_request(str.view(preview_root),preview_transport,preview_requested) {
        app.set_status(state,"[GA_MODAL_RETIRE] Cannot retire preview before file picker")
        continue
      }
      match choose_file(title, saving, str.view(suggested)) {
        none => { },
        some(chosen) => {
          if str.len(str.view(chosen)) == 0 {
            let note: string = input.cancel_prompt(state)
            app.set_status(state, str.view(note))
          } else {
            var label: string = app.prompt_label(state)
            app.begin_prompt(state, action, str.view(label), "")
            app.prompt_push(state, str.view(chosen))
            if action == chrome.act_render() {
              export_target = string.copy(str.view(chosen))
              match begin_export(state, array.len(export_jobs) > 0) {
                none => { },
                some(job) => {
                  export_percent = 0
                  array.push(export_jobs, task.spawn(job, fn=run_export))
                },
              }
            } else {
              var result_note: string = input.commit_prompt(state)
              if str.len(str.view(result_note)) != 0 {
                app.set_status(state, str.view(result_note))
              }
            }
          }
        },
      }
      repaint_all = true
      dirty = true
    }
    let status: string = app.status(state)
    if str.starts_with(str.view(status), "[GA_") and not str.eq(str.view(status), str.view(last_recorded_error)) {
      let scratch: string = string.copy(str.view(struct.borrow(struct.borrow(state, field=provider), field=scratch)))
      diagnostics.record(str.view(scratch), "GA_EDITOR", str.view(status), "window")
      last_recorded_error = status
    }
    let timing_doc:ref<editor.Document> =struct.borrow(state,field=document)
    let timing_playing:bool=editor.playing(timing_doc) or
      struct.get(struct.borrow(timing_doc,field=monitor),field=playing)
    let defer_timing_write:bool=window_profile.buffered_playback(editor.playing(timing_doc),
      struct.get(struct.borrow(timing_doc,field=monitor),field=playing),audio_active,app.running(state))
    if window_measure.enabled {
      struct.set(window_row,window_profile.stamp(window_measure),field=end)
      struct.set(window_row,array.len(struct.borrow(pictures,field=frames)),field=prepared)
      struct.set(window_row,preview_transport.snapshot_generation,field=snapshot)
      struct.set(window_row,semantic_cache.rebuilds,field=rebuilds)
      struct.set(window_row,strip_requested,field=strips)
      struct.set(window_row,drained,field=inputs)
      let timing_record:result<unit,string> =if defer_timing_write {
        window_profile.record_buffered_checked(window_measure,window_row)
      }else{window_profile.record_checked(window_measure,window_row)}
      match timing_record {
        ok(_)=>{
          if window_measure.rows>=50000 {timing_limit_pending=true}
        },err(problem)=>{
          struct.set(state,false,field=window_timing_requested)
          app.set_status(state,str.view(problem))
          diagnostics.record(struct.borrow(struct.borrow(state,field=provider),field=scratch),
            "GA_WINDOW_PROFILE_WRITE",str.view(problem),"window-timing")
          dirty=true
        },}
    }
    // Retain the Stop-input row in memory; next loop services native audio
    // before it publishes this pending partial block or turns recording off.
    if window_measure.enabled and window_profile.flush_transition(timing_transport_playing,timing_playing,app.running(state)) {
      timing_flush_pending=true
    }
    timing_transport_playing=timing_playing
  }
  // Leaving the scope joins every task; stop an export at its next frame instead of
  // holding the closed window open until it finishes.
  if array.len(export_jobs) > 0 { timeline_media.request_export_cancel(str.view(export_cancel)) }
  match ref.swap(audio_library,option.none()) {none=>{},some(value)=>{var library: CAbiLibrary = value
    let _ = native_audio.request(library,"stop","")
    audio_library=option.some(library)},}
  if audio_request < 18446744073709551615 {
    audio_request=audio_request+1
    let _=audio_playback.discard(str.view(audio_root),audio_request,audio_generation)
  }
  audio_playback.stop(str.view(audio_root))
  let _ = preview_link.wake(audio_transport,true)
  let _ = tasks.join_next<bool>(audio_jobs,30000)
  release_playback_output(first_pcm,str.view(audio_task_output))
  preview_link.close_commands(audio_transport)
  match window_profile.stop(window_measure) {ok(_)=>{},err(problem)=>{
    let scratch:string=string.copy(str.view(struct.borrow(struct.borrow(state,field=provider),field=scratch)))
    diagnostics.record(str.view(scratch),"GA_WINDOW_PROFILE_WRITE",str.view(problem),"window-close")
    say(str.view(problem))},}
  preview.stop(str.view(preview_root))
  preview.stop(str.view(strip_root))
  let _ = preview_link.wake(strip_transport,true)
  let _ = preview_link.wake(preview_transport,true)
  let _ = tasks.join_next<bool>(preview_jobs, 30000)
  let _ = tasks.join_next<bool>(preview_jobs, 30000)
  preview_link.close_commands(preview_transport)
  preview_link.close_commands(strip_transport)
  }
  match ref.swap(audio_library, option.none()) {
    none => {}, some(opened) => { var library: CAbiLibrary = opened
      native_audio.close(library) },
  }
  provider.shutdown(struct.borrow(state, field=provider))
  gui.close(window)
  0
}

pub fn main(args: view<str>) -> i32 effects {alloc, env, ffi, fs.meta, fs.read, fs.write, io.write, process, thread, time, ui, net} {
  let verb: string = if view.len(args) < 2 { string.copy("new") } else { string.copy(view.get(args, 1)) }
  let force_fake: bool = verb == "demo" or match env.get("GENESIS_FAKE_PROVIDER") {
    some(value) => value == "1", none => false,
  }
  var scratch: string = match provider.resolve_scratch(settings_root()) {
    ok(value)=>value,err(problem)=>{say(problem)
      return 1},
  }
  // Reserve the caller's receipt before making a session or performing command
  // work. Existing files (including other controllers' receipts) are refused.
  var session_report: option<File> = match env.get("GENESIS_SESSION_REPORT") {
    none=>option.none(),some(report)=>{
      match fs.open(report,mode=create_new) {
        ok(value)=>option.some(value),err(_)=>{say("[GA_MEDIA_SESSION_REPORT] Cannot reserve requested session report")
          return 1},
      }
    },
  }
  var engine: provider.Provider = choose_provider(str.view(scratch), force_fake)
  match provider.isolate_media(engine) {ok(_)=>{},err(problem)=>{say(problem)
    return 1},}
  // A controller supplies its own receipt path; there is no shared latest-session
  // pointer whose replacement could cancel a different process's export.
  match ref.swap(session_report,option.none()) {
    none=>{},some(report)=>{
      let row: string = text.concat(provider.media_root(engine),"\n")
      match fs.write_all(report,str.bytes(row)) {
        ok(_)=>{},err(_)=>{say("[GA_MEDIA_SESSION_REPORT] Cannot write requested session report")
          return 1},
      }
    },
  }
  var state: app.App = app.app(engine)
  app.set_fonts(state, typeface.search_paths())
  load_theme(state, args, scratch)
  // Which inspector tab a headless render shows, so every panel is checkable without a
  // screen. The window path starts on Properties like any other launch.
  match env.get("GENESIS_TAB") {
    some(value) => {
      let named: string = value
      if str.eq(str.view(named), "filters") { app.set_dock_tab(state, chrome.tab_filters()) }
      else if str.eq(str.view(named), "scopes") { app.set_dock_tab(state, chrome.tab_scopes()) }
      else if str.eq(str.view(named), "audio") { app.set_dock_tab(state, chrome.tab_audio()) }
    },
    none => { },
  }

  if verb == "profile-playback" {
    if view.len(args) < 5 or view.len(args) > 7 {say("profile-playback needs REPORT.tsv PROJECT.air SECONDS [--legacy] [--poll]")
      return 2}
    var legacy: bool = false
    var sleep_poll: bool = false
    var flag: u64 = 5
    loop {if flag >= view.len(args) {break}
      let option: str = view.get(args,flag)
      if option == "--legacy" {legacy=true}else if option == "--poll" {sleep_poll=true}else{
        say("[GA_PLAYBACK_PROFILE_ARGS] Unknown option")
        return 2}
      flag=flag+1}
    var opened: commands.Result = commands.open_project(state,view.get(args,3))
    if not opened.ok {say(commands.message(opened))
      return 1}
    let seconds: u64 = match text.parse_u64(view.get(args,4)) {some(value)=>value,none=>0,}
    return playback_profile.run(state,view.get(args,2),seconds,legacy,sleep_poll)
  }
  if str.eq(verb, "profile-preview") {
    if view.len(args) < 4 { say("profile-preview needs a report path and a project")
      return 2 }
    var opened: commands.Result = commands.open_project(state, view.get(args, 3))
    if not opened.ok { say(str.view(commands.message(opened)))
      return 1 }
    let width: u32 = if view.len(args) > 4 { match text.parse_u64(view.get(args, 4)) {some(value) => cast.sat(value), none => 0,} } else { 2560 }
    let height: u32 = if view.len(args) > 5 { match text.parse_u64(view.get(args, 5)) {some(value) => cast.sat(value), none => 0,} } else { 1440 }
    let samples: u64 = if view.len(args) > 6 { match text.parse_u64(view.get(args, 6)) {some(value) => value, none => 0,} } else { 20 }
    var full_monitor: bool = false
    var full_paint: bool = false
    var file_pixels: bool = false
    var flag: u64 = 7
    loop { if flag >= view.len(args) { break }
      let argument: str = view.get(args, flag)
      if str.eq(argument, "--fullscreen") { full_monitor = true }
      else if str.eq(argument, "--full-paint") { full_paint = true }
      else if str.eq(argument, "--file-pixels") { file_pixels = true }
      else { say("[GA_PROFILE_ARGS] Unknown profile-preview option")
        return 2 }
      flag = flag + 1
    }
    return preview_profile.run(state, view.get(args, 2), width, height, full_monitor, samples, full_paint, file_pixels)
  }

  if str.eq(verb, "render") {
    if view.len(args) < 3 { say("render needs an output path")
      return 2 }
    if view.len(args) >= 4 and not str.starts_with(view.get(args, 3), "--") {
      var opened: commands.Result = commands.open_project(state, view.get(args, 3))
      if not opened.ok { say(str.view(commands.message(opened)))
        return 1 }
    }
    if not render_to(state, view.get(args, 2), 1600, 980) {
      say("the frame could not be written")
      return 1
    }
    say("Genesis AIR frame written")
    return 0
  }

  if str.eq(verb, "export") {
    if view.len(args) < 4 { say("export needs an output path and a project")
      return 2 }
    var opened: commands.Result = commands.open_project(state, view.get(args, 3))
    if not opened.ok { say(str.view(commands.message(opened)))
      return 1 }
    if not provider.available(struct.borrow(state, field=provider)) or
       provider.kind_fake() == struct.get(struct.borrow(state, field=provider), field=kind) {
      say("video export requires a gcompose worker")
      return 1
    }
    let worker: string = provider.worker_path(struct.borrow(state, field=provider))
    let cancel: string = provider.export_cancel_path(struct.borrow(state, field=provider))
    let progress: string = provider.export_progress_path(struct.borrow(state, field=provider))
    timeline_media.clear_export_signals(str.view(cancel), str.view(progress))
    var job: timeline_media.ExportJob = timeline_media.export_job(struct.borrow(state, field=document),
      str.view(worker), view.get(args, 2), struct.borrow(state, field=fonts), str.view(cancel),
      str.view(progress), if text.ends_with(view.get(args, 2), ".mkv") {
        if view.len(args) > 4 and str.eq(view.get(args, 4), "--hdr") { 5 } else { 3 }
      } else if text.ends_with(view.get(args, 2), ".mov") { 2 } else {
        let hevc: bool = view.len(args) > 4 and str.eq(view.get(args, 4), "--hevc")
        if view.len(args) > 4 and str.eq(view.get(args, 4), "--hdr") { 4 } else if hevc { 1 } else { 0 }
      })
    match timeline_media.run_export_detailed(job) {
      ok(publication) => { say("Genesis AIR video written")
        var completed: timeline_media.ExportPublication = publication
        if completed.cleanup_pending {say(str.view(struct.borrow(completed,field=detail)))}
        return 0 },
      err(problem) => { say(str.view(problem))
        return 1 },
    }
  }

  if str.eq(verb, "audio") {
    if view.len(args) < 4 { say("audio needs an output path and a project")
      return 2 }
    var opened: commands.Result = commands.open_project(state, view.get(args, 3))
    if not opened.ok { say(str.view(commands.message(opened)))
      return 1 }
    if not provider.available(struct.borrow(state, field=provider)) or
       provider.kind_fake() == struct.get(struct.borrow(state, field=provider), field=kind) {
      say("audio mix requires a gcompose worker")
      return 1
    }
    let worker: string = provider.worker_path(struct.borrow(state, field=provider))
    let playhead: i64 = editor.playhead(struct.borrow(state, field=document))
    match timeline_media.prepare_audio(struct.borrow(state, field=document), str.view(worker),
        playhead, view.get(args, 2)) {
      ok(has_audio) => {
        if has_audio { say("Genesis AIR audio written")
          return 0 }
        say("project has no audible audio after the playhead")
        return 1
      },
      err(problem) => { say(str.view(problem))
        return 1 },
    }
  }

  if str.eq(verb, "preview") {
    if view.len(args) < 4 { say("preview needs an output path and a project")
      return 2 }
    var opened: commands.Result = commands.open_project(state, view.get(args, 3))
    if not opened.ok { say(str.view(commands.message(opened)))
      return 1 }
    if not provider.available(struct.borrow(state, field=provider)) or
       provider.kind_fake() == struct.get(struct.borrow(state, field=provider), field=kind) {
      say("program preview requires a gcompose worker")
      return 1
    }
    let output: string = provider.preview_path(struct.borrow(state, field=provider))
    let frame: i64 = editor.playhead(struct.borrow(state, field=document))
    var frame_cache: timeline_media.RenderCache = timeline_media.render_cache(
      struct.borrow(state, field=fonts))
    timeline_media.configure_preview(struct.borrow(state, field=document), frame_cache)
    var plan: array<string> = match timeline_media.frame_plan(struct.borrow(state, field=document),
      frame, "PREVIEW", str.view(output), str.view(output), frame_cache) {
      ok(value) => value,
      err(problem) => { say(str.view(problem))
        return 1 },
    }
    var picture: provider.Frame = provider.program_plan(struct.borrow(state, field=provider),
      plan, 640, 360, frame_cache.width, frame_cache.height)
    timeline_media.cleanup_plan(str.view(output))
    if not provider.frame_ok(picture) { say(str.view(provider.frame_detail(picture)))
      return 1 }
    var pixels: draw.Surface = provider.take_pixels(picture)
    var metadata: array<png_tools.TextEntry> = array.new()
    var encoded: bytes = match png_tools.encode_rgba_with_text(pixels, metadata) {
      ok(value) => value,
      err(problem) => { say("preview encoding failed")
        return 1 },
    }
    match image.write_file(view.get(args, 2), bytes.view(encoded)) {
      ok(_) => { say("Genesis AIR program frame written")
        return 0 },
      err(problem) => { say("preview writing failed")
        return 1 },
    }
  }

  if str.eq(verb, "demo") {
    if view.len(args) < 3 { say("demo needs an output path")
      return 2 }
    build_demo(state)
    if view.len(args) >= 4 and not str.starts_with(view.get(args, 3), "--") {
      var saved: commands.Result = commands.save_project(state, view.get(args, 3))
      if not saved.ok { say(str.view(commands.message(saved)))
        return 1 }
      say("project saved")
    }
    if not render_to(state, view.get(args, 2), 1600, 980) {
      say("the frame could not be written")
      return 1
    }
    say("Genesis AIR demo frame written")
    return 0
  }

  // A bounded real-media check: open a source, read its length, pull one source frame and
  // one program frame through the provider, and write the composed editor frame. This is
  // the whole media path, on one file, with no render.
  if str.eq(verb, "probe") {
    if view.len(args) < 4 { say("probe needs a media path and an output path")
      return 2 }
    let media: str = view.get(args, 2)
    say(str.view(provider.describe(struct.borrow(state, field=provider))))
    var imported: commands.Result = commands.import_media(state, media, "fixture")
    if not imported.ok { say(str.view(commands.message(imported)))
      return 1 }
    let frames: i64 = editor.source_frames(struct.borrow(state, field=document), imported.value)
    io.write("frames ")
    io.write(str.view(string.from_int(frames)))
    io.write("\n")
    if frames <= 0 { say("the provider could not determine the source length")
      return 1 }
    let has_video: bool = match editor.source_slot(struct.borrow(state, field=document), imported.value) {
      none => false,
      some(slot) => struct.get(array.borrow(struct.borrow(
        struct.borrow(state, field=document), field=sources), slot), field=has_video),
    }
    let track: u64 = if has_video { app.default_video_track(state) }
      else { app.default_audio_track(state) }
    let owner: u64 = struct.get(struct.borrow(state, field=document), field=active)
    let available: i64 = editor.source_timeline_frames(
      struct.borrow(state, field=document), imported.value, owner)
    let length: i64 = if available < 24 { available } else { 24 }
    var placed: commands.Result = commands.append_clip(state, track, imported.value, 0, length)
    if not placed.ok { say(str.view(commands.message(placed)))
      return 1 }
    if view.len(args) >= 5 {
      var saved: commands.Result = commands.save_project(state, view.get(args, 4))
      if not saved.ok { say(str.view(commands.message(saved)))
        return 1 }
    }
    let _ = commands.open_source(state, imported.value)
    let _ = commands.seek(state, 0)
    // One source frame and one program frame, through the seam.
    var source_ok: bool = true
    io.write("source_frame ")
    if has_video {
      var shot: provider.Frame = provider.source_frame(struct.borrow(state, field=provider),
        media, 0, 320, 180)
      source_ok = provider.frame_ok(shot)
      io.write(if provider.frame_ok(shot) { "ok" } else { "failed" })
    } else { io.write("audio-only") }
    io.write("\n")
    if not render_to(state, view.get(args, 3), 1600, 980) {
      say("the frame could not be written")
      return 1
    }
    let calls: i64 = cast.sat(provider.calls(struct.borrow(state, field=provider)))
    let failed: i64 = cast.sat(provider.failures(struct.borrow(state, field=provider)))
    io.write("provider_calls ")
    io.write(str.view(string.from_int(calls)))
    io.write("\nprovider_failures ")
    io.write(str.view(string.from_int(failed)))
    io.write("\n")
    say("Genesis AIR probe complete")
    if not source_ok or failed != 0 { return 1 }
    return 0
  }

  if str.eq(verb, "open") {
    if view.len(args) < 3 { say("open needs a project path")
      return 2 }
    var opened: commands.Result = commands.open_linked_project(state, view.get(args, 2))
    if not opened.ok { say(str.view(commands.message(opened)))
      return 1 }
    return run_window(state, "Genesis AIR")
  }

  if str.eq(verb, "new") {
    return run_window(state, "Genesis AIR")
  }

  say("unknown command")
  2
}

// Presentation-only continuation after an exact empty/drained audio endpoint.
// The real device counter and PCM buffer remain untouched.
pub fn extend_silent_clock(device:ref<native_audio.Clock>,begin:u64,anchor:u64,now:u64) -> unit effects {} {
  if device.ok and now>=begin {
    let elapsed:f64=cast.float(now-begin)*48000.0/1000000000.0
    struct.set(device,add.sat(anchor,cast.sat(elapsed)),field=samples)
  }
}

// The native loop invokes this only with the current accepted epoch. Exact EOF,
// not the final ceil-frame boundary, admits one new loop epoch.
pub fn finish_program_until(document:ref<editor.Document>,end:ref<endpoint.End>,origin:i64,samples:u64,queued:u64) -> bool effects {} {
  if queued!=0 or not editor.playing(document) or end.frames<=0 or
      editor.playhead(document)<end.frames-1 or not endpoint.completed(end,origin,samples) {return false}
  let looping:bool=document.program.looping
  let _=editor.program_action_until(document,editor.pause(),end.frames)
  if looping {let _=editor.seek_until(document,0,end.frames)
    let _=editor.program_action_until(document,editor.play(),end.frames)}
  true
}

// Source uses its own graph/clock. Only an already requested unvalidated parked
// Program coordinate defers its start until the shared two-monitor packet is safe.
pub fn source_waits_for_endpoint(state:ref<app.App>,source:bool) -> bool effects {} {
  source and app.endpoint_requested(state)
}
pub fn endpoint_failure(state:ref<app.App>,detail:str) -> unit effects {alloc} {
  let waiting_source:bool=source_waits_for_endpoint(state,state.document.monitor.playing)
  app.retire_endpoint(state)
  if waiting_source {struct.set(struct.borrow(struct.borrow(state,field=document),field=monitor),false,field=playing)}
  struct.set(struct.borrow(struct.borrow(state,field=document),field=program),false,field=playing)
  app.set_status(state,detail)
}
fn fail_program_endpoint(state:ref<app.App>,library:ref<CAbiLibrary>,transport:ref<preview_link.Link>,preroll:ref<PcmPreroll>,root:str,output:str,request:ref<u64>,generation:u64,detail:str) -> unit effects {alloc,fs.write,net,time,ffi} {
  endpoint_failure(state,detail)
  let _=native_audio.request(library,"stop","")
  let previous:u64=ref.swap(request,0)
  if previous==18446744073709551615 {let _=ref.swap(request,previous)
    return ()}
  let next:u64=previous+1
  let _=ref.swap(request,next)
  if audio_playback.discard(root,next,generation) {
    release_playback_output(preroll,output)
    let _=preview_link.wake(transport,false)
  }
}

// Draft status for asynchronous preparation is cleared only at the real ready
// boundary (accepted paused End, queued first PCM, or a primed silent clock).
pub fn preparing_program_audio(state:ref<app.App>,end_only:bool) -> unit effects {alloc} {
  app.set_status(state,if end_only {if state.endpoint_seek_requested>=0 {"Preparing audio endpoint for seek..."}else{"Preparing audio endpoint for End..."}}else{"Preparing audio..."})
}
pub fn prepared_program_audio(state:ref<app.App>,detail:str) -> unit effects {alloc} {
  if str.eq(str.view(struct.borrow(state,field=status)),"Preparing audio...") or
      str.eq(str.view(struct.borrow(state,field=status)),"Preparing audio endpoint for End...") or
      str.eq(str.view(struct.borrow(state,field=status)),"Preparing audio endpoint for seek...") {app.set_status(state,detail)}
  ()
}
