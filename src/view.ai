// Painting Genesis AIR.
//
// Every pixel is derived from the document at paint time. Retained pixels and glyphs
// cache the presentation; hand this module an `App` and it draws what is currently true. That is
// what keeps the visual timeline from becoming a second, disagreeing model.
//
// The timeline lanes, clips, fades, markers and playhead come from `std.editor_view`, which
// builds a `std.timeline` view of the document; this module adds the application chrome
// (menu, pool rows, monitors, filter stack, properties, mixer, status) around it.
module genesis.view

import std.draw as draw
import std.editor as editor
import std.editor_view as editor_view
import std.geometry as geometry
import std.math as math
import std.timeline as timeline
import std.text as text
import "ui_text.ai" as ui_text
import std.application_theme as themes
import std.desktop_styles as styles
import std.widgets as widgets
import "app.ai" as app
import "project_session.ai" as session
import "chrome.ai" as chrome
import "layout.ai" as layout
import "provider.ai" as provider

pub type Theme = struct {
  background: draw.Color,
  panel: draw.Color,
  panel_head: draw.Color,
  edge: draw.Color,
  text: draw.Color,
  dim: draw.Color,
  accent: draw.Color,
  warn: draw.Color,
  focus: draw.Color,
  selected: draw.Color,
  row: draw.Color,
  timeline: draw.Color,
  lane: draw.Color,
  control: draw.Color,
  control_on: draw.Color,
  control_hover: draw.Color,
  button_on: draw.Color,
  button_hover: draw.Color,
  toolbar: draw.Color,
  prompt: draw.Color,
  scroll_track: draw.Color
}

// Every structural color comes from the same std.* palette used by AIR apps.
fn shared_theme(shared: widgets.Theme) -> Theme effects {} {
  Theme {background: shared.background, panel: shared.surface,
    panel_head: shared.shade, edge: shared.line, text: shared.ink, dim: shared.faint,
    accent: shared.accent, warn: shared.danger, focus: shared.accent,
    selected: shared.selection, row: shared.surface, timeline: shared.background,
    lane: shared.surface, control: shared.background, control_on: shared.selection,
    control_hover: shared.shade, button_on: shared.selection, button_hover: shared.shade,
    toolbar: shared.surface, prompt: shared.shade, scroll_track: shared.background}
}
pub fn theme(state: ref<app.App>) -> Theme effects {} {
  shared_theme(if app.light(state) { styles.light_modern() } else { themes.theme(app.theme_id(state)) })
}

fn fill(canvas: ref<draw.Canvas>, area: layout.Rect, value: draw.Color) -> unit effects {alloc} {
  match geometry.rect(area.left, area.top, area.right, area.bottom) {
    some(box) => draw.fill_rect(canvas, box, value),
    none => (),
  }
}
fn fill_at(canvas: ref<draw.Canvas>, left: f64, top: f64, right: f64, bottom: f64,
           value: draw.Color) -> unit effects {alloc} {
  match geometry.rect(left, top, right, bottom) {
    some(box) => draw.fill_rect(canvas, box, value),
    none => (),
  }
}
fn outline(canvas: ref<draw.Canvas>, area: layout.Rect, value: draw.Color) -> unit effects {alloc} {
  match geometry.rect(area.left, area.top, area.right, area.bottom) {
    some(box) => draw.stroke_rect(canvas, box, value, 1.0),
    none => (),
  }
}
// Cap heights for cached, antialiased Windows/system TrueType faces.
pub fn type_small() -> f64 effects {} { 12.0 }
pub fn type_body() -> f64 effects {} { 12.0 }
pub fn type_title() -> f64 effects {} { 14.0 }

// Characters that fit in a given width at a given size.
pub fn fits(width: f64, size: f64) -> u64 effects {} {
  if size <= 0.0 { return 0 }
  cast.sat(width / size)
}

fn label(canvas: ref<draw.Canvas>, typography: ref<ui_text.Typography>, x: f64, y: f64, text: str, size: f64,
         value: draw.Color) -> unit effects {alloc} {
  ui_text.paint(typography, canvas, x, y, text, size, value)
  ()
}

// A titled panel. `focused` draws the accent edge, so a person can see which panel a
// keystroke will reach.
fn panel(canvas: ref<draw.Canvas>, typography: ref<ui_text.Typography>, colors: Theme, area: layout.Rect, title: str,
         focused: bool) -> unit effects {alloc} {
  fill(canvas, area, colors.panel)
  fill_at(canvas, area.left, area.top, area.right, area.top + 26.0, colors.panel_head)
  outline(canvas, area, if focused { colors.focus } else { colors.edge })
  label(canvas, typography, area.left + 7.0, area.top + 5.0, title, type_title(), colors.text)
  ()
}

fn number(value: i64) -> string effects {alloc} { string.from_int(value) }

// ---------------------------------------------------------------------------
// Panels

fn paint_menu(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
              frame: layout.Frame) -> unit effects {alloc} {
  let area: layout.Rect = frame.menu
  fill(canvas, area, colors.panel_head)
  var controls: array<chrome.Control> = chrome.menu_bar(frame, state)
  paint_controls(canvas, struct.borrow(state, field=typography), colors, controls)
  var title: string = string.copy("Genesis AIR    ")
  let where: string = app.project_path(state)
  if str.len(str.view(where)) == 0 { string.append(title, "untitled") }
  else { string.append(title, str.view(where)) }
  if app.dirty(state) { string.append(title, "   EDITED") }
  label(canvas, struct.borrow(state, field=typography), area.right - 430.0, 8.0, str.view(title), type_title(), colors.dim)
  ()
}

fn paint_pool(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
              frame: layout.Frame) -> unit effects {alloc} {
  let area: layout.Rect = frame.pool
  let focused: bool = app.focus(state) == app.panel_pool()
  panel(canvas, struct.borrow(state, field=typography), colors, area, "MEDIA", focused)
  var controls: array<chrome.Control> = chrome.pool_controls(frame, state)
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  var index: u64 = 0
  loop {
    if index >= array.len(controls) { break }
    let entry: ref<chrome.Control> = array.borrow(controls, index)
    if struct.get(entry, field=action) != chrome.act_pool_pick() {
      paint_control(canvas, struct.borrow(state, field=typography), colors, entry)
      index = index + 1
      continue
    }
    let row: layout.Rect = struct.get(entry, field=area)
    let chosen: bool = struct.get(entry, field=on)
    let online: bool = struct.get(entry, field=enabled)
    let source: u64 = struct.get(entry, field=target)
    fill(canvas, row, if chosen { colors.selected } else { colors.row })
    outline(canvas, row, if chosen { colors.focus } else { colors.edge })
    // A stand-in for the thumbnail the provider will fill in.
    fill_at(canvas, row.left + 4.0, row.top + 3.0, row.left + 30.0, row.bottom - 3.0,
      if online { draw.rgb(66, 102, 160) } else { draw.rgb(94, 58, 62) })
    let named: string = chrome.label_of(entry)
    label(canvas, struct.borrow(state, field=typography), row.left + 34.0, row.top + 2.0, str.view(named), type_title(),
      if online { colors.text } else { colors.dim })
    var detail: string = string.new()
    let frames: i64 = editor.source_frames(document, source)
    if frames > 0 {
      string.append(detail, str.view(number(frames)))
      string.append(detail, " frames")
    } else { string.append(detail, "length unknown") }
    if not online { string.append(detail, "   OFFLINE") }
    label(canvas, struct.borrow(state, field=typography), row.left + 34.0, row.top + 17.0, str.view(detail), type_small(), colors.dim)
    index = index + 1
  }
  if editor.source_count(document) == 0 {
    label(canvas, struct.borrow(state, field=typography), area.left + 10.0, area.top + 30.0, "no media imported - press Add", type_small(),
      colors.dim)
  }
  ()
}

// A monitor: the frame area, a scrub bar carrying the in/out range, and SMPTE.
fn paint_monitor(canvas: ref<draw.Canvas>, typography: ref<ui_text.Typography>, colors: Theme, area: layout.Rect, title: str,
                 frame: i64, last: i64, mark_in: i64, mark_out: i64, fps: f64,
                 playing: bool, image: ref<draw.Surface>, focused: bool) -> unit effects {alloc} {
  panel(canvas, typography, colors, area, title, focused)
  let view_top: f64 = area.top + 30.0
  let view_bottom: f64 = area.bottom - 72.0
  fill_at(canvas, area.left + 6.0, view_top, area.right - 6.0, view_bottom, draw.rgb(8, 9, 11))
  paint_monitor_image(canvas, area, image)
  paint_monitor_time(canvas, typography, colors, area, frame, last, mark_in, mark_out, fps, playing)
  ()
}

// The provider supplies the monitor picture; body painting preserves the surrounding
// controls while applying the same letterbox geometry as a complete paint.
fn paint_monitor_image(canvas: ref<draw.Canvas>, area: layout.Rect, image: ref<draw.Surface>) -> unit effects {alloc} {
  let view_top: f64 = area.top + 30.0
  let view_bottom: f64 = area.bottom - 72.0
  // The provider's frame, letterboxed into the monitor.
  let source_w: u32 = draw.surface_width(image)
  let source_h: u32 = draw.surface_height(image)
  if source_w != 0 and source_h != 0 {
    let box_w: f64 = area.right - area.left - 12.0
    let box_h: f64 = view_bottom - view_top
    let wide: u64 = cast.wrap(source_w)
    let tall: u64 = cast.wrap(source_h)
    let scale: f64 = math.min(box_w / cast.float(wide), box_h / cast.float(tall))
    let draw_w: f64 = cast.float(wide) * scale
    let draw_h: f64 = cast.float(tall) * scale
    let left: f64 = area.left + 6.0 + (box_w - draw_w) * 0.5
    let top: f64 = view_top + (box_h - draw_h) * 0.5
    // draw_image follows the canvas transform. Writing device pixels directly
    // would leave the video unscaled while the surrounding controls enlarge.
    match geometry.rect(left, top, left + draw_w, top + draw_h) {
      some(target) => draw.draw_image(canvas, image, target),
      none => { },
    }
  }
  ()
}
fn paint_monitor_time(canvas: ref<draw.Canvas>, typography: ref<ui_text.Typography>, colors: Theme,
    area: layout.Rect, frame: i64, last: i64, mark_in: i64, mark_out: i64, fps: f64,
    playing: bool) -> unit effects {alloc} {
  let bar_top: f64 = area.bottom - 61.0
  fill_at(canvas, area.left + 8.0, bar_top, area.right - 8.0, bar_top + 7.0, draw.rgb(22, 24, 29))
  let span: f64 = if last > 0 { cast.float(last) } else { 1.0 }
  if mark_in >= 0 and mark_out > mark_in {
    let a: f64 = area.left + 8.0 + (area.right - area.left - 16.0) * cast.float(mark_in) / span
    let b: f64 = area.left + 8.0 + (area.right - area.left - 16.0) * cast.float(mark_out) / span
    fill_at(canvas, a, bar_top, b, bar_top + 7.0, draw.rgb(56, 90, 138))
  }
  let head: f64 = area.left + 8.0 + (area.right - area.left - 16.0) * cast.float(frame) / span
  fill_at(canvas, head - 1.0, bar_top - 3.0, head + 2.0, bar_top + 10.0, draw.rgb(244, 78, 78))
  var line: string = string.copy(str.view(timeline.timecode(frame, fps)))
  string.append(line, if playing { "   PLAY" } else { "   PAUSE" })
  label(canvas, typography, area.left + 8.0, bar_top + 16.0, str.view(line), type_body(), colors.text)
  ()
}

// ---------------------------------------------------------------------------
// The timeline
//
// Built by `std.editor_view.view`, which turns the document into a `std.timeline` model.
// The application supplies only the viewport — zoom, scroll and lane height — so the clip
// geometry a click resolves against is the geometry that was drawn.

pub fn timeline_model(state: ref<app.App>, area: layout.Rect) -> timeline.Timeline effects {alloc} {
  let zoom: f64 = app.zoom(state)
  let scroll: i64 = app.scroll(state)
  let height: f64 = app.track_height(state)
  let colours: editor_view.Palette = editor_view.dark()
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  let sequence: u64 = document.active
  // Scrolling is expressed as a shifted origin, so frame `scroll` sits at the panel's left.
  let origin: f64 = area.left - cast.float(scroll) * zoom
  var model: timeline.Timeline = editor_view.view(document, sequence, colours, zoom, origin,
    area.top + 4.0)
  var index: u64 = 0
  loop {
    if index >= array.len(struct.borrow(model, field=tracks)) { break }
    struct.set(array.borrow(struct.borrow(model, field=tracks), index), height, field=height)
    index = index + 1
  }
  model
}

fn paint_ruler(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
               area: layout.Rect, model: ref<timeline.Timeline>, fps: f64) -> unit effects {alloc} {
  fill(canvas, area, colors.timeline)
  outline(canvas, area, colors.edge)
  let step: i64 = if fps >= 1.0 { cast.sat(math.round(fps)) } else { 1 }
  // A timecode is eleven characters wide, so at close zoom only every Nth second can carry
  // one. Ticking every second while labelling every Nth is what keeps them from colliding.
  let stamp_width: f64 = ui_text.width(struct.borrow(state, field=typography), "00 00 00 00", type_small()) + 10.0
  let ticks_per_second: f64 = cast.float(step)
  let per_tick: f64 = ticks_per_second * app.zoom(state)
  var every: i64 = 1
  loop {
    if every > 3600 { break }
    let spacing: f64 = cast.float(every)
    if spacing * per_tick >= stamp_width { break }
    every = every + 1
  }
  var frame: i64 = app.scroll(state)
  // Start on a whole second so the labelled ticks do not shift while scrolling.
  frame = frame - (frame - (frame / step) * step)
  var ticks: i64 = frame / step
  var guard: u64 = 0
  loop {
    if guard > 4096 { break }
    let x: f64 = timeline.frame_to_x(model, frame)
    if x > area.right { break }
    if x >= area.left {
      let labelled: bool = ticks - (ticks / every) * every == 0
      draw.line(canvas, geometry.vec2(x, if labelled { area.top + 2.0 } else { area.bottom - 6.0 }),
        geometry.vec2(x, area.bottom), colors.edge, 1.0)
      // A label that would run past the ruler is dropped rather than drawn: the panel to the
      // right of the ruler is the inspector, and text does not belong in it.
      if labelled and x + 4.0 + stamp_width <= area.right {
        let stamp: string = timeline.timecode(frame, fps)
        label(canvas, struct.borrow(state, field=typography), x + 4.0, area.top + 4.0, str.view(stamp), type_small(), colors.dim)
      }
    }
    frame = frame + step
    ticks = ticks + 1
    guard = guard + 1
  }
  // Markers ride the ruler, where an editor expects them.
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  let sequence: u64 = document.active
  var index: u64 = 0
  loop {
    if index >= editor.marker_count(document) { break }
    let entry: ref<editor.Marker> = array.borrow(struct.borrow(document, field=markers), index)
    if struct.get(entry, field=owner) == sequence {
      let x: f64 = timeline.frame_to_x(model, struct.get(entry, field=frame))
      if x >= area.left and x <= area.right {
        fill_at(canvas, x - 3.0, area.top + 2.0, x + 4.0, area.top + 9.0, draw.rgb(236, 96, 116))
      }
    }
    index = index + 1
  }
  ()
}

fn paint_headers(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
                 area: layout.Rect, model: ref<timeline.Timeline>) -> unit effects {alloc} {
  fill(canvas, area, colors.timeline)
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  let sequence: u64 = document.active
  var lanes: array<u64> = editor_view.lanes(document, sequence)
  let total: u64 = array.len(lanes)
  var lane: u64 = 0
  loop {
    if lane >= total { break }
    if lane >= array.len(struct.borrow(model, field=tracks)) { break }
    let pick: u64 = total - 1 - lane
    let id: u64 = array.get(lanes, pick)
    let top: f64 = timeline.track_top(model, lane)
    let height: f64 = struct.get(array.borrow(struct.borrow(model, field=tracks), lane), field=height)
    if top > area.bottom { break }
    fill_at(canvas, area.left, top, area.right, top + height, colors.lane)
    match geometry.rect(area.left, top, area.right, top + height) {
      some(box) => { draw.stroke_rect(canvas, box, colors.edge, 1.0) },
      none => { },
    }
    label(canvas, struct.borrow(state, field=typography), area.left + 8.0, top + 4.0, str.view(editor.track_name(document, id)), type_title(),
      colors.text)
    lane = lane + 1
  }
  ()
}

// Waveforms for the audio clips, from the cache the application refreshed. The lane index
// matches the one `editor_view.view` assigned, so the bars land on their own clip.
fn paint_waveforms(canvas: ref<draw.Canvas>, colours: editor_view.Palette, state: ref<app.App>,
                   model: ref<timeline.Timeline>) -> unit effects {alloc} {
  let count: u64 = app.waveform_count(state)
  if count == 0 { return () }
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  let sequence: u64 = document.active
  var lanes: array<u64> = editor_view.lanes(document, sequence)
  let total: u64 = array.len(lanes)
  var index: u64 = 0
  loop {
    if index >= count { break }
    let entry: ref<app.Waveform> = array.borrow(struct.borrow(state, field=waveforms), index)
    let clip: u64 = struct.get(entry, field=clip)
    match editor.clip(document, clip) {
      none => { },
      some(value) => {
        var position: u64 = total
        var scan: u64 = 0
        loop {
          if scan >= total { break }
          if array.get(lanes, scan) == value.track { position = scan
            break }
          scan = scan + 1
        }
        if position < total {
          let lane: u64 = total - 1 - position
          editor_view.paint_waveform(canvas, colours, model, lane, value.start, value.length,
            array.view(struct.borrow(entry, field=peaks)))
        }
      },
    }
    index = index + 1
  }
  ()
}


fn paint_thumbnails(canvas: ref<draw.Canvas>, state: ref<app.App>, model: ref<timeline.Timeline>, area: layout.Rect) -> unit effects {alloc} {
  var doc: editor.Document = editor.copy_document(struct.borrow(state, field=document))
  let track_height: f64 = app.track_height(state)
  var i: u64 = 0
  loop { if i >= array.len(struct.borrow(state, field=thumbnails)) { break }
    let thumb: ref<app.Thumbnail> = array.borrow(struct.borrow(state, field=thumbnails), i)
    i = i + 1
    let clip: editor.Clip = match editor.clip(doc, thumb.clip) {none => { continue }, some(value) => value,}
    var lane: u64 = 0
    loop { if lane >= array.len(struct.borrow(model, field=tracks)) { break }
      if struct.get(array.borrow(struct.borrow(model, field=tracks), lane), field=id) == clip.track { break }
      lane = lane + 1
    }
    if lane >= array.len(struct.borrow(model, field=tracks)) { continue }
    let x: f64 = timeline.frame_to_x(model, thumb.frame)
    let right: f64 = math.min(x + 92.0, timeline.frame_to_x(model, clip.start + clip.length) - 2.0)
    if right <= area.left or x >= area.right or right <= x { continue }
    let y: f64 = timeline.track_top(model, lane) + 16.0
    let bottom: f64 = timeline.track_top(model, lane) + track_height - 4.0
    let saved: draw.State = draw.state(canvas)
    match geometry.rect(math.max(x, area.left), y, math.min(right, area.right), bottom) {
      none => {}, some(box) => {
        let _ = draw.clip_rect(canvas, box)
        let shown_width: f64 = (bottom - y) * 80.0 / 45.0
        match geometry.rect(x, y, x + shown_width, bottom) {none => {}, some(target) => draw.draw_image(canvas, struct.borrow(thumb, field=pixels), target),}
      },
    }
    draw.restore(canvas, saved)
  }
  ()
}

fn paint_timeline(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
                  area: layout.Rect, model: ref<timeline.Timeline>) -> unit effects {alloc} {
  fill(canvas, area, colors.timeline)
  let saved: draw.State = draw.state(canvas)
  match geometry.rect(area.left, area.top, area.right, area.bottom) {
    some(box) => { let _ = draw.clip_rect(canvas, box) },
    none => { },
  }
  timeline.paint(model, canvas, area.right)
  let colours: editor_view.Palette = editor_view.dark()
  paint_thumbnails(canvas, state, model, area)
  paint_waveforms(canvas, colours, state, model)
  // Redraw the seek handle above thumbnail/waveform pixels.
  let head: f64 = timeline.frame_to_x(model, editor.playhead(struct.borrow(state, field=document)))
  if head >= area.left and head < area.right { fill_at(canvas, head - 1.0, area.top, head + 2.0, area.bottom, colors.focus) }
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  let sequence: u64 = document.active
  editor_view.paint_transitions(document, canvas, colours, model, sequence)
  draw.restore(canvas, saved)
  outline(canvas, area, colors.edge)
  ()
}

fn paint_status(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
                area: layout.Rect) -> unit effects {alloc} {
  fill(canvas, area, colors.panel_head)
  // Mirror the centered prompt in the status line so its current value stays visible.
  if app.prompt_active(state) {
    fill(canvas, area, colors.prompt)
    var asking: string = app.prompt_label(state)
    string.append(asking, ":  ")
    string.append(asking, str.view(app.prompt_text(state)))
    label(canvas, struct.borrow(state, field=typography), 8.0, area.top + 6.0, str.view(asking), type_title(), colors.accent)
    let caret: f64 = 8.0 + ui_text.width(struct.borrow(state, field=typography), str.view(asking), type_title()) + 2.0
    fill_at(canvas, caret, area.top + 5.0, caret + 5.0, area.top + 14.0, colors.accent)
    label(canvas, struct.borrow(state, field=typography), area.right - 260.0, area.top + 6.0,
      "Enter to accept    Escape to cancel", type_small(), colors.dim)
    return ()
  }
  var line: string = app.status(state)
  string.append(line, "   |   ")
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  string.append(line, "clips ")
  let clips: i64 = cast.sat(editor.clip_count(document))
  string.append(line, str.view(number(clips)))
  string.append(line, "   duration ")
  string.append(line, str.view(number(editor.duration(document))))
  string.append(line, "   playhead ")
  string.append(line, str.view(timeline.timecode(editor.playhead(document),
    editor.sequence_fps(document, document.active))))
  var unbounded: array<u64> = editor.unbounded_clips(document)
  if array.len(unbounded) != 0 {
    string.append(line, "   ")
    let count: i64 = cast.sat(array.len(unbounded))
    string.append(line, str.view(number(count)))
    string.append(line, " clip(s) with an unverifiable source length")
  }
  label(canvas, struct.borrow(state, field=typography), 8.0, area.top + 6.0, str.view(line), type_title(), colors.text)
  ()
}

fn paint_prompt(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
                width: f64, height: f64) -> unit effects {alloc} {
  if not app.prompt_active(state) { return () }
  let box: layout.Rect = layout.prompt_panel(width, height)
  fill_at(canvas, box.left + 7.0, box.top + 7.0, box.right + 7.0,
    box.bottom + 7.0, draw.rgb(8, 9, 12))
  fill(canvas, box, colors.panel_head)
  outline(canvas, box, colors.focus)
  var title: string = app.prompt_label(state)
  label(canvas, struct.borrow(state, field=typography), box.left + 18.0, box.top + 18.0, str.view(title), type_title(), colors.text)
  let field: layout.Rect = layout.rect(box.left + 18.0, box.top + 48.0,
    box.right - 18.0, box.top + 84.0)
  fill(canvas, field, colors.background)
  outline(canvas, field, colors.edge)
  var whole: string = app.prompt_text(state)
  let count: u64 = str.len(str.view(whole))
  let capacity: u64 = fits(layout.width_of(field) - 24.0, type_body())
  let first: u64 = if count > capacity { count - capacity } else { 0 }
  var visible: string = string.copy(str.slice(str.view(whole), first, count))
  label(canvas, struct.borrow(state, field=typography), field.left + 8.0, field.top + 11.0, str.view(visible),
    type_body(), colors.text)
  let caret: f64 = field.left + 10.0 + ui_text.width(struct.borrow(state, field=typography), str.view(visible), type_body())
  fill_at(canvas, caret, field.top + 8.0, caret + 2.0, field.bottom - 7.0, colors.accent)
  label(canvas, struct.borrow(state, field=typography), box.left + 18.0, box.bottom - 28.0,
    "Enter to accept    Escape to cancel", type_small(), colors.dim)
  ()
}

fn paint_project_decision(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
    width: f64, height: f64) -> unit effects {alloc} {
  if not session.modal(state) { return () }
  let deferred: ref<app.PendingProject> = struct.borrow(state, field=pending_project)
  let offered: bool = deferred.stage == app.ProjectStage.OfferRecovery
  let reason: string = string.copy(str.view(struct.borrow(deferred, field=label)))
  let error: string = string.copy(str.view(struct.borrow(deferred, field=error)))
  let box: layout.Rect = layout.project_decision(width, height)
  fill_at(canvas, 0.0, 0.0, width, height, draw.color(0, 0, 0, 144))
  fill_at(canvas, box.left + 7.0, box.top + 7.0, box.right + 7.0, box.bottom + 7.0, draw.rgb(8, 9, 12))
  fill(canvas, box, colors.panel_head)
  outline(canvas, box, colors.focus)
  let saved: draw.State = draw.state(canvas)
  match geometry.rect(box.left + 18.0, box.top + 14.0, box.right - 18.0, box.bottom - 66.0) {
    none => {}, some(area) => { let _ = draw.clip_rect(canvas, area) },
  }
  label(canvas, struct.borrow(state, field=typography), box.left + 24.0, box.top + 22.0,
    if offered { "Recover an unsaved project?" } else { "Save changes before continuing?" }, type_title(), colors.text)
  var message: string = if offered { string.copy(str.view(reason)) } else { text.concat("Before ", str.view(reason)) }
  label(canvas, struct.borrow(state, field=typography), box.left + 24.0, box.top + 56.0,
    str.view(message), type_body(), colors.text)
  if str.len(str.view(error)) != 0 {
    label(canvas, struct.borrow(state, field=typography), box.left + 24.0, box.top + 88.0,
      str.view(error), type_small(), colors.warn)
  }
  if str.len(str.view(error)) == 0 {
    label(canvas, struct.borrow(state, field=typography), box.left + 24.0, box.top + 88.0,
      if offered { "Recovery opens a copy. Keep current leaves the snapshot available." }
        else { "Your current edits stay in place until you choose an action." }, type_small(), colors.dim)
  }
  draw.restore(canvas, saved)
  var controls: array<chrome.Control> = chrome.project_choices(width, height, state)
  paint_controls(canvas, struct.borrow(state, field=typography), colors, controls)
  ()
}

// ---------------------------------------------------------------------------
// Controls
//
// Everything clickable is painted from the list `genesis.chrome` built. The painter never
// invents a rectangle, so a control cannot be drawn anywhere other than where it responds.

fn text_centre(canvas: ref<draw.Canvas>, typography: ref<ui_text.Typography>, area: layout.Rect, text: str, size: f64,
               value: draw.Color) -> unit effects {alloc} {
  let wide: f64 = ui_text.width(typography, text, size)
  let x: f64 = area.left + (layout.width_of(area) - wide) * 0.5
  let y: f64 = area.top + (layout.height_of(area) - size) * 0.5
  label(canvas, typography, if x < area.left + 2.0 { area.left + 2.0 } else { x }, y, text, size, value)
  ()
}

fn paint_control(canvas: ref<draw.Canvas>, typography: ref<ui_text.Typography>, colors: Theme,
                 control: ref<chrome.Control>) -> unit effects {alloc} {
  let style: u32 = struct.get(control, field=style)
  let area: layout.Rect = struct.get(control, field=area)
  let on: bool = struct.get(control, field=on)
  let live: bool = struct.get(control, field=enabled)
  let text: string = chrome.label_of(control)

  if style == chrome.style_heading() {
    fill_at(canvas, area.left, area.bottom - 8.0, area.right, area.bottom - 7.0, colors.edge)
    label(canvas, typography, area.left + 2.0, area.top + 4.0, str.view(text), type_small(), colors.accent)
    return ()
  }
  if style == chrome.style_text() {
    let detail: string = chrome.name_of(control)
    label(canvas, typography, area.left + 2.0, area.top + 4.0, str.view(text), type_small(), colors.dim)
    let wide: f64 = ui_text.width(typography, str.view(detail), type_small())
    let x: f64 = area.right - 4.0 - wide
    label(canvas, typography, if x < area.left + 90.0 { area.left + 90.0 } else { x }, area.top + 4.0,
      str.view(detail), type_small(), colors.text)
    return ()
  }
  if style == chrome.style_row() {
    label(canvas, typography, area.left + 2.0, area.top + 5.0, str.view(text), type_small(), colors.text)
    return ()
  }
  if style == chrome.style_slider() {
    let low: f64 = struct.get(control, field=low)
    let high: f64 = struct.get(control, field=high)
    let value: f64 = struct.get(control, field=value)
    let span: f64 = if high - low == 0.0 { 1.0 } else { high - low }
    var portion: f64 = (value - low) / span
    if portion < 0.0 { portion = 0.0 }
    if portion > 1.0 { portion = 1.0 }
    fill(canvas, area, colors.control)
    let filled: f64 = area.left + layout.width_of(area) * portion
    fill_at(canvas, area.left, area.top, filled, area.bottom,
      if on { colors.control_on } else { colors.control_hover })
    outline(canvas, area, colors.edge)
    // Zero sits where it belongs on a signed range, so a cut is visibly below centre.
    if low < 0.0 and high > 0.0 {
      let zero: f64 = area.left + layout.width_of(area) * (0.0 - low) / span
      draw.line(canvas, geometry.vec2(zero, area.top), geometry.vec2(zero, area.bottom),
        colors.dim, 1.0)
    }
    let shown: string = math.format_fixed(value, 2)
    label(canvas, typography, area.right + 52.0, area.top + 1.0, str.view(shown), type_small(),
      if on { colors.text } else { colors.dim })
    return ()
  }
  if style == chrome.style_tab() {
    fill(canvas, area, if on { colors.panel } else { colors.timeline })
    if on { fill_at(canvas, area.left, area.top, area.right, area.top + 2.0, colors.accent) }
    outline(canvas, area, colors.edge)
    let tab_size: f64 = struct.get(control, field=size)
    text_centre(canvas, typography, area, str.view(text),
      if tab_size >= 8.0 { tab_size } else { type_title() },
      if on { colors.text } else { colors.dim })
    return ()
  }
  // Buttons and toggles.
  let face: draw.Color = if on { colors.button_on }
    else if live { colors.button_hover } else { colors.panel }
  fill(canvas, area, face)
  outline(canvas, area, if on { colors.focus } else { colors.edge })
  let measured: f64 = struct.get(control, field=size)
  let size: f64 = if measured >= 8.0 and measured <= 20.0 { measured } else { type_small() }
  text_centre(canvas, typography, area, str.view(text), size,
    if live or on { colors.text } else { colors.dim })
  ()
}

fn paint_controls(canvas: ref<draw.Canvas>, typography: ref<ui_text.Typography>, colors: Theme,
                  controls: ref<array<chrome.Control>>) -> unit effects {alloc} {
  var index: u64 = 0
  loop {
    if index >= array.len(controls) { break }
    paint_control(canvas, typography, colors, array.borrow(controls, index))
    index = index + 1
  }
  ()
}

fn paint_toolbar(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
                 frame: layout.Frame) -> unit effects {alloc} {
  fill(canvas, frame.toolbar, colors.toolbar)
  fill_at(canvas, 0.0, frame.toolbar.bottom - 1.0, frame.width, frame.toolbar.bottom,
    colors.edge)
  var controls: array<chrome.Control> = chrome.toolbar(frame, state)
  paint_controls(canvas, struct.borrow(state, field=typography), colors, controls)
  // The worker readout: which media provider is actually answering.
  let engine: string = provider.describe(struct.borrow(state, field=provider))
  let failures: i64 = cast.sat(provider.failures(struct.borrow(state, field=provider)))
  var line: string = string.copy("worker: ")
  string.append(line, str.view(engine))
  string.append(line, " / background preview")
  if failures != 0 {
    string.append(line, "   failures ")
    string.append(line, str.view(number(failures)))
  }
  let wide: f64 = ui_text.width(struct.borrow(state, field=typography), str.view(line), type_small())
  label(canvas, struct.borrow(state, field=typography), frame.width - wide - 10.0, frame.toolbar.top + 11.0, str.view(line), type_small(),
    if failures == 0 { colors.dim } else { colors.warn })
  ()
}

fn paint_timeline_bar(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
                      frame: layout.Frame) -> unit effects {alloc} {
  fill(canvas, frame.tbar, colors.panel)
  outline(canvas, frame.tbar, colors.edge)
  var controls: array<chrome.Control> = chrome.timeline_bar(frame, state)
  paint_controls(canvas, struct.borrow(state, field=typography), colors, controls)
  ()
}

// ---------------------------------------------------------------------------
// Scopes, read off the program frame that was already fetched for the monitor.

fn paint_scopes(canvas: ref<draw.Canvas>, typography: ref<ui_text.Typography>, colors: Theme, area: layout.Rect,
                image: ref<draw.Surface>) -> unit effects {alloc} {
  let wide: u32 = draw.surface_width(image)
  let tall: u32 = draw.surface_height(image)
  if wide == 0 or tall == 0 {
    label(canvas, typography, area.left + 8.0, area.top + 12.0, "no program frame", type_small(), colors.dim)
    return ()
  }
  // One pass over a sampled grid fills the histogram and the parade at once, so the scopes
  // cannot disagree about what frame they are showing.
  var red: array<f64> = array.new()
  var green: array<f64> = array.new()
  var blue: array<f64> = array.new()
  var luma: array<f64> = array.new()
  var slot: u64 = 0
  loop {
    if slot >= 64 { break }
    array.push(red, 0.0)
    array.push(green, 0.0)
    array.push(blue, 0.0)
    array.push(luma, 0.0)
    slot = slot + 1
  }
  let step_x: u32 = if wide > 128 { wide / 128 } else { 1 }
  let step_y: u32 = if tall > 96 { tall / 96 } else { 1 }
  var counted: f64 = 0.0
  var y: u32 = 0
  loop {
    if y >= tall { break }
    var x: u32 = 0
    loop {
      if x >= wide { break }
      match draw.surface_pixel(image, x, y) {
        none => { },
        some(colour) => {
          let r: u64 = cast.wrap(colour.r)
          let g: u64 = cast.wrap(colour.g)
          let b: u64 = cast.wrap(colour.b)
          let bucket_r: u64 = r / 4
          let bucket_g: u64 = g / 4
          let bucket_b: u64 = b / 4
          let grey: u64 = (r * 30 + g * 59 + b * 11) / 100
          let bucket_l: u64 = grey / 4
          let seen_r: f64 = array.get(red, bucket_r)
          let seen_g: f64 = array.get(green, bucket_g)
          let seen_b: f64 = array.get(blue, bucket_b)
          let seen_l: f64 = array.get(luma, bucket_l)
          array.set(red, bucket_r, seen_r + 1.0)
          array.set(green, bucket_g, seen_g + 1.0)
          array.set(blue, bucket_b, seen_b + 1.0)
          array.set(luma, bucket_l, seen_l + 1.0)
          counted = counted + 1.0
        },
      }
      x = x + step_x
    }
    y = y + step_y
  }
  if counted == 0.0 { return () }
  var peak: f64 = 1.0
  var scan: u64 = 0
  loop {
    if scan >= 64 { break }
    peak = math.max(peak, math.max(array.get(luma, scan),
      math.max(array.get(red, scan), math.max(array.get(green, scan), array.get(blue, scan)))))
    scan = scan + 1
  }

  var top: f64 = area.top + 6.0
  let panel_wide: f64 = layout.width_of(area) - 12.0
  let column: f64 = panel_wide / 64.0

  label(canvas, typography, area.left + 6.0, top, "HISTOGRAM", type_small(), colors.accent)
  top = top + 12.0
  let hist_height: f64 = 96.0
  fill_at(canvas, area.left + 6.0, top, area.right - 6.0, top + hist_height, draw.rgb(12, 13, 16))
  var index: u64 = 0
  loop {
    if index >= 64 { break }
    let x0: f64 = area.left + 6.0 + cast.float(index) * column
    let hr: f64 = hist_height * array.get(red, index) / peak
    let hg: f64 = hist_height * array.get(green, index) / peak
    let hb: f64 = hist_height * array.get(blue, index) / peak
    fill_at(canvas, x0, top + hist_height - hr, x0 + column - 0.5, top + hist_height,
      draw.rgb(180, 70, 70))
    fill_at(canvas, x0, top + hist_height - hg, x0 + column - 0.5, top + hist_height - hr,
      draw.rgb(70, 170, 90))
    fill_at(canvas, x0, top + hist_height - hb, x0 + column - 0.5, top + hist_height - hg,
      draw.rgb(70, 110, 200))
    index = index + 1
  }
  outline(canvas, layout.rect(area.left + 6.0, top, area.right - 6.0, top + hist_height),
    colors.edge)
  top = top + hist_height + 10.0

  label(canvas, typography, area.left + 6.0, top, "RGB PARADE", type_small(), colors.accent)
  top = top + 12.0
  let parade_height: f64 = 72.0
  let each: f64 = (panel_wide - 8.0) / 3.0
  var channel: u64 = 0
  loop {
    if channel >= 3 { break }
    let left: f64 = area.left + 6.0 + cast.float(channel) * (each + 4.0)
    fill_at(canvas, left, top, left + each, top + parade_height, draw.rgb(12, 13, 16))
    var bucket: u64 = 0
    loop {
      if bucket >= 64 { break }
      let amount: f64 = if channel == 0 { array.get(red, bucket) }
        else if channel == 1 { array.get(green, bucket) } else { array.get(blue, bucket) }
      if amount > 0.0 {
        let level: f64 = top + parade_height
          - parade_height * cast.float(bucket) / 63.0
        let bar: f64 = each * math.min(1.0, amount / peak)
        let tone: draw.Color = if channel == 0 { draw.rgb(200, 80, 80) }
          else if channel == 1 { draw.rgb(80, 190, 100) } else { draw.rgb(80, 120, 215) }
        fill_at(canvas, left, level - 1.5, left + bar, level + 1.5, tone)
      }
      bucket = bucket + 1
    }
    outline(canvas, layout.rect(left, top, left + each, top + parade_height), colors.edge)
    channel = channel + 1
  }
  top = top + parade_height + 10.0

  label(canvas, typography, area.left + 6.0, top, "LUMA WAVEFORM", type_small(), colors.accent)
  top = top + 12.0
  let wave_height: f64 = 72.0
  fill_at(canvas, area.left + 6.0, top, area.right - 6.0, top + wave_height, draw.rgb(12, 13, 16))
  index = 0
  loop {
    if index >= 64 { break }
    let amount: f64 = array.get(luma, index)
    if amount > 0.0 {
      let x0: f64 = area.left + 6.0 + cast.float(index) * column
      let height: f64 = wave_height * math.min(1.0, amount / peak)
      fill_at(canvas, x0, top + wave_height - height, x0 + column - 0.5, top + wave_height,
        draw.rgb(150, 200, 160))
    }
    index = index + 1
  }
  outline(canvas, layout.rect(area.left + 6.0, top, area.right - 6.0, top + wave_height),
    colors.edge)
  top = top + wave_height + 10.0

  let shown_wide: u64 = cast.wrap(wide)
  let shown_tall: u64 = cast.wrap(tall)
  var summary: string = string.copy("sampled ")
  let sampled: i64 = cast.sat(counted)
  string.append(summary, str.view(number(sampled)))
  string.append(summary, " px of ")
  string.append(summary, str.view(number(cast.sat(shown_wide))))
  string.append(summary, "x")
  string.append(summary, str.view(number(cast.sat(shown_tall))))
  label(canvas, typography, area.left + 6.0, top, str.view(summary), type_small(), colors.dim)
  ()
}

// ---------------------------------------------------------------------------
// Stereo output meters read the mixed PCM at the native device cursor.
fn paint_meters(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
                area: layout.Rect) -> unit effects {alloc} {
  let height: f64 = chrome.meter_height()
  fill_at(canvas, area.left + 4.0, area.top + 2.0, area.right - 4.0, area.top + height, draw.rgb(12, 13, 16))
  label(canvas, struct.borrow(state, field=typography), area.left + 10.0, area.top + 6.0, "OUTPUT / after gain, pan and effects", type_small(), colors.accent)
  let top: f64 = area.top + 26.0
  let bottom: f64 = area.top + height - 20.0
  var levels: array<f64> = [state.audio_left, state.audio_right]
  var names: array<string> = ["L", "R"]
  var i: u64 = 0
  loop { if i == 2 { break }
    let level: f64 = math.max(0.0, math.min(1.0, array.get(levels, i)))
    let x: f64 = area.left + 12.0 + cast.float(i) * 42.0
    fill_at(canvas, x, top, x + 28.0, bottom, draw.rgb(20, 22, 27))
    let db: f64 = if level > 0.000001 { 20.0 * math.log10(level) } else { -120.0 }
    let lit: f64 = bottom - (bottom - top) * math.max(0.0, (db + 60.0) / 60.0)
    var tone: draw.Color = draw.rgb(90, 190, 110)
    if db > -12.0 { tone = draw.rgb(228, 190, 90) }
    if db > -1.0 { tone = draw.rgb(232, 96, 96) }
    fill_at(canvas, x, lit, x + 28.0, bottom, tone)
    outline(canvas, layout.rect(x, top, x + 28.0, bottom), colors.edge)
    label(canvas, struct.borrow(state, field=typography), x + 10.0, bottom + 2.0, str.view(array.borrow(names, i)), type_small(), colors.dim)
    i = i + 1
  }
  label(canvas, struct.borrow(state, field=typography), area.left + 92.0, top, "0 dBFS", type_small(), colors.dim)
  label(canvas, struct.borrow(state, field=typography), area.left + 92.0, (top + bottom)*0.5, "-30", type_small(), colors.dim)
  label(canvas, struct.borrow(state, field=typography), area.left + 92.0, bottom - 10.0, "-60", type_small(), colors.dim)
  label(canvas, struct.borrow(state, field=typography), area.left + 166.0, top + 8.0,
    if state.audio_left > 0.0 or state.audio_right > 0.0 { "Audio playing" } else { "Stopped / silent" }, type_body(), colors.text)
  ()
}

// ---------------------------------------------------------------------------
// The dock.

fn paint_dock(canvas: ref<draw.Canvas>, colors: Theme, state: ref<app.App>,
              frame: layout.Frame, program_image: ref<draw.Surface>) -> unit effects {alloc} {
  fill(canvas, frame.dock, colors.panel)
  outline(canvas, frame.dock, if app.focus(state) == app.panel_dock() { colors.focus }
    else { colors.edge })
  var tabs: array<chrome.Control> = chrome.dock_tabs(frame, state)
  paint_controls(canvas, struct.borrow(state, field=typography), colors, tabs)

  let which: u32 = app.dock_tab(state)
  let body: layout.Rect = frame.dock_body
  let saved: draw.State = draw.state(canvas)
  match geometry.rect(body.left, body.top, body.right, body.bottom) {
    some(box) => { let _ = draw.clip_rect(canvas, box) },
    none => { },
  }
  if which == chrome.tab_scopes() {
    paint_scopes(canvas, struct.borrow(state, field=typography), colors, body, program_image)
  } else {
    if which == chrome.tab_audio() {
      paint_meters(canvas, colors, state, body)
      match geometry.rect(body.left, body.top + chrome.meter_height(), body.right, body.bottom) {
        some(box) => { let _ = draw.clip_rect(canvas, box) }, none => {},
      }
    }
    var controls: array<chrome.Control> = chrome.dock_panel(frame, state)
    paint_controls(canvas, struct.borrow(state, field=typography), colors, controls)
  }
  draw.restore(canvas, saved)

  // A full mouse scrollbar: the geometry comes from `chrome`, where input gets it too.
  if which != chrome.tab_scopes() and chrome.dock_scroll_max(frame, state) > 0.0 {
    let track: layout.Rect = chrome.dock_scroll_track(frame)
    let thumb: layout.Rect = chrome.dock_scroll_thumb(frame, state)
    fill(canvas, track, colors.scroll_track)
    outline(canvas, track, colors.edge)
    fill(canvas, thumb, if app.dock_scroll_dragging(state) { colors.focus } else { colors.dim })
    outline(canvas, thumb, colors.edge)
  }
  ()
}

// Paint the whole application. `source_image` and `program_image` are the frames the
// provider returned for this repaint; the view never calls the provider itself, so painting
// stays free of media work.
pub fn paint(state: ref<app.App>, canvas: ref<draw.Canvas>, width: f64, height: f64,
             source_image: ref<draw.Surface>, program_image: ref<draw.Surface>) -> unit effects {alloc} {
  ui_text.set_scale(struct.borrow(state, field=typography), draw.transform(canvas).a)
  let colors: Theme = theme(state)
  let frame: layout.Frame = layout.frame(width, height)
  draw.clear(canvas, colors.background)

  let document: ref<editor.Document> = struct.borrow(state, field=document)
  let sequence: u64 = document.active
  let fps: f64 = editor.sequence_fps(document, sequence)
  let monitor: editor.Transport = document.monitor
  let program: editor.Transport = document.program
  let source_last: i64 = editor.source_frames(document, document.monitor_source)
  let source_fps: f64 = match editor.source_slot(document, document.monitor_source) {
    none => fps,
    some(slot) => struct.get(array.borrow(struct.borrow(document, field=sources), slot), field=fps),
  }
  let total: i64 = editor.sequence_duration(document, sequence)
  let focus: u32 = app.focus(state)
  if state.fullscreen != 0 {
    let source: bool = state.fullscreen == 2
    let area: layout.Rect = chrome.monitor_area(frame, state, source)
    if source {
      paint_monitor(canvas, struct.borrow(state, field=typography), colors, area, "SOURCE", monitor.frame,
        if source_last > 0 { source_last - 1 } else { 0 }, monitor.mark_in, monitor.mark_out,
        source_fps, monitor.playing, source_image, false)
    } else {
      paint_monitor(canvas, struct.borrow(state, field=typography), colors, area, "PROGRAM", program.frame,
        if total > 0 { total - 1 } else { 0 }, program.mark_in, program.mark_out,
        fps, program.playing, program_image, false)
    }
    var controls: array<chrome.Control> = chrome.monitor_controls(frame, state, source)
    paint_controls(canvas, struct.borrow(state, field=typography), colors, controls)
    return ()
  }
  paint_menu(canvas, colors, state, frame)
  paint_toolbar(canvas, colors, state, frame)
  paint_pool(canvas, colors, state, frame)
  paint_monitor(canvas, struct.borrow(state, field=typography), colors, frame.source, "SOURCE", monitor.frame,
    if source_last > 0 { source_last - 1 } else { 0 }, monitor.mark_in, monitor.mark_out,
    source_fps, monitor.playing, source_image, focus == app.panel_source())
  paint_monitor(canvas, struct.borrow(state, field=typography), colors, frame.program, "PROGRAM", program.frame,
    if total > 0 { total - 1 } else { 0 }, program.mark_in, program.mark_out, fps,
    program.playing, program_image, focus == app.panel_program())

  var source_transport: array<chrome.Control> = chrome.monitor_controls(frame, state, true)
  var program_transport: array<chrome.Control> = chrome.monitor_controls(frame, state, false)
  paint_controls(canvas, struct.borrow(state, field=typography), colors, source_transport)
  paint_controls(canvas, struct.borrow(state, field=typography), colors, program_transport)

  paint_dock(canvas, colors, state, frame, program_image)
  paint_timeline_bar(canvas, colors, state, frame)

  var model: timeline.Timeline = timeline_model(state, frame.timeline)
  paint_ruler(canvas, colors, state, frame.ruler, model, fps)
  paint_timeline(canvas, colors, state, frame.timeline, model)
  paint_headers(canvas, colors, state, frame.headers, model)
  var track_buttons: array<chrome.Control> = chrome.track_controls(frame, state, model)
  let saved: draw.State = draw.state(canvas)
  match geometry.rect(frame.headers.left, frame.headers.top, frame.headers.right,
                      frame.headers.bottom) {
    some(box) => { let _ = draw.clip_rect(canvas, box) },
    none => { },
  }
  paint_controls(canvas, struct.borrow(state, field=typography), colors, track_buttons)
  draw.restore(canvas, saved)
  paint_status(canvas, colors, state, frame.status)
  // Menus are painted last because their popup deliberately overlays the toolbar and panels.
  var menu: array<chrome.Control> = chrome.menu_popup(frame, state)
  paint_controls(canvas, struct.borrow(state, field=typography), colors, menu)
  paint_prompt(canvas, colors, state, width, height)
  paint_project_decision(canvas, colors, state, width, height)
  app.count_paint(state)
  ()
}


// Derived paint state only. The document remains the authority for every UI fact.
pub type Renderer = struct {
  surface: draw.Surface, frame: i64, source_width: u32, source_height: u32,
  program_width: u32, program_height: u32, fullscreen: u32,
  source_playing: bool, program_playing: bool, overlay: bool
}
pub fn renderer() -> Renderer effects {alloc} {
  Renderer {surface: draw.empty_surface(), frame: 0, source_width: 0, source_height: 0,
    program_width: 0, program_height: 0, fullscreen: 0, source_playing: false, program_playing: false, overlay: false}
}

fn repaint_head(canvas: ref<draw.Canvas>, state: ref<app.App>, colors: Theme,
    frame: layout.Frame, model: ref<timeline.Timeline>, position: i64) -> unit effects {alloc} {
  let area: layout.Rect = frame.timeline
  let head: f64 = timeline.frame_to_x(model, position)
  if head < area.left - 3.0 or head > area.right + 3.0 { return () }
  let scale: f64 = draw.transform(canvas).a
  let saved: draw.State = draw.state(canvas)
  // Align the damage clip to physical pixels: fractional clips would alter coverage.
  let left: f64 = math.floor((head - 2.0) * scale) / scale
  let right: f64 = math.ceil((head + 3.0) * scale) / scale
  let top: f64 = (math.floor(area.top * scale) - 1.0) / scale
  let bottom: f64 = (math.ceil(area.bottom * scale) + 1.0) / scale
  match geometry.rect(left, top, right, bottom) {
    none => {}, some(box) => { let _ = draw.clip_rect(canvas, box)
      draw.fill_device_rect(canvas, cast.sat(left * scale), cast.sat(top * scale),
        cast.sat(right * scale), cast.sat(bottom * scale), colors.background)
      let sequence: u64 = struct.get(struct.borrow(state, field=document), field=active)
      let fps: f64 = editor.sequence_fps(struct.borrow(state, field=document), sequence)
      paint_ruler(canvas, colors, state, frame.ruler, model, fps)
      paint_timeline(canvas, colors, state, area, model)
      paint_headers(canvas, colors, state, frame.headers, model)
      var buttons: array<chrome.Control> = chrome.track_controls(frame, state, model)
      let timeline_clip: draw.State = draw.state(canvas)
      match geometry.rect(frame.headers.left, frame.headers.top, frame.headers.right, frame.headers.bottom) {
        none => {}, some(header_box) => { let _ = draw.clip_rect(canvas, header_box) },
      }
      paint_controls(canvas, struct.borrow(state, field=typography), colors, buttons)
      draw.restore(canvas, timeline_clip) },
  }
  draw.restore(canvas, saved)
  ()
}
fn erase_section(canvas: ref<draw.Canvas>, area: layout.Rect, background: draw.Color) -> unit effects {} {
  let scale: f64 = draw.transform(canvas).a
  draw.fill_device_rect(canvas, cast.sat(math.floor(area.left * scale) - 2.0),
    cast.sat(math.floor(area.top * scale) - 2.0), cast.sat(math.ceil(area.right * scale) + 2.0),
    cast.sat(math.ceil(area.bottom * scale) + 2.0), background)
}
fn paint_live_monitor(canvas: ref<draw.Canvas>, state: ref<app.App>, colors: Theme,
    frame: layout.Frame, source: bool, image: ref<draw.Surface>) -> unit effects {alloc} {
  let area: layout.Rect = chrome.monitor_area(frame, state, source)
  // Clear on physical pixel boundaries before reapplying fractional video edges.
  // Header, buttons and focus borders stay intact; transport changes repaint all.
  let scale: f64 = draw.transform(canvas).a
  let left: i64 = cast.sat(math.floor((area.left + 4.0) * scale))
  let top: i64 = cast.sat(math.floor((area.top + 30.0) * scale))
  let right: i64 = cast.sat(math.ceil((area.right - 4.0) * scale))
  let bottom: i64 = cast.sat(math.ceil((area.bottom - 31.0) * scale))
  let inside_left: i64 = cast.sat(math.ceil((area.left + 6.0) * scale))
  let inside_top: i64 = cast.sat(math.ceil((area.top + 30.0) * scale))
  let inside_right: i64 = cast.sat(math.floor((area.right - 6.0) * scale))
  let inside_bottom: i64 = cast.sat(math.floor((area.bottom - 72.0) * scale))
  if inside_right > inside_left and inside_bottom > inside_top {
    // The opaque picture background immediately overwrites this interior.
    // Restore only its surrounding bands, including fractional edge pixels.
    draw.fill_device_rect(canvas, left, top, right, inside_top, colors.panel)
    draw.fill_device_rect(canvas, left, inside_bottom, right, bottom, colors.panel)
    draw.fill_device_rect(canvas, left, inside_top, inside_left, inside_bottom, colors.panel)
    draw.fill_device_rect(canvas, inside_right, inside_top, right, inside_bottom, colors.panel)
  } else { draw.fill_device_rect(canvas, left, top, right, bottom, colors.panel) }
  fill_at(canvas, area.left + 6.0, area.top + 30.0, area.right - 6.0, area.bottom - 72.0,
    draw.rgb(8, 9, 11))
  paint_monitor_image(canvas, area, image)
  let doc: ref<editor.Document> = struct.borrow(state, field=document)
  let transport: editor.Transport = if source { doc.monitor } else { doc.program }
  let last: i64 = if source { editor.source_frames(doc, doc.monitor_source) } else { editor.duration(doc) }
  let fps: f64 = if source { match editor.source_slot(doc, doc.monitor_source) {
      none => editor.sequence_fps(doc, doc.active),
      some(slot) => struct.get(array.borrow(struct.borrow(doc, field=sources), slot), field=fps),
    } } else { editor.sequence_fps(doc, doc.active) }
  paint_monitor_time(canvas, struct.borrow(state, field=typography), colors, area, transport.frame,
    if last > 0 { last - 1 } else { 0 }, transport.mark_in, transport.mark_out, fps, transport.playing)
}
fn paint_live(state: ref<app.App>, canvas: ref<draw.Canvas>, width: f64, height: f64,
    previous_frame: i64, source: ref<draw.Surface>, program: ref<draw.Surface>) -> unit effects {alloc} {
  ui_text.set_scale(struct.borrow(state, field=typography), draw.transform(canvas).a)
  let colors: Theme = theme(state)
  let frame: layout.Frame = layout.frame(width, height)
  if state.fullscreen != 0 {
    let source_full: bool = state.fullscreen == 2
    if source_full { paint_live_monitor(canvas, state, colors, frame, true, source) }
    else { paint_live_monitor(canvas, state, colors, frame, false, program) }
    return ()
  }
  paint_live_monitor(canvas, state, colors, frame, true, source)
  paint_live_monitor(canvas, state, colors, frame, false, program)
  let doc: ref<editor.Document> = struct.borrow(state, field=document)
  let current: i64 = editor.playhead(doc)
  let animated: bool = array.len(struct.borrow(doc, field=keys)) != 0
  if current != previous_frame {
    var model: timeline.Timeline = timeline_model(state, frame.timeline)
    repaint_head(canvas, state, colors, frame, model, previous_frame)
    repaint_head(canvas, state, colors, frame, model, current)
  }
  if app.dock_tab(state) == chrome.tab_scopes() or app.dock_tab(state) == chrome.tab_audio() or
      animated {
    erase_section(canvas, frame.dock, colors.background)
    paint_dock(canvas, colors, state, frame, program)
  }
  erase_section(canvas, frame.status, colors.background)
  paint_status(canvas, colors, state, frame.status)
  app.count_paint(state)
  ()
}

// Input/layout/project edits request full=true. Playback and new preview pixels can
// reuse the canvas. Monitor regions clear their destination before compositing,
// so transparent frames do not require scanning either image or a complete paint.
// Dimension and transport changes conservatively repaint all.
pub fn render(state: ref<app.App>, cache: ref<Renderer>, width: u32, height: u32,
    full: bool, source: ref<draw.Surface>, program: ref<draw.Surface>) -> bool effects {alloc} {
  let doc: ref<editor.Document> = struct.borrow(state, field=document)
  let source_playing: bool = struct.get(struct.borrow(doc, field=monitor), field=playing)
  let program_playing: bool = editor.playing(doc)
  let program_frame: i64 = editor.playhead(doc)
  let previous: ref<draw.Surface> = struct.borrow(cache, field=surface)
  let resized: bool = previous.width != width or previous.height != height
  let overlay: bool = session.modal(state) or app.open_menu(state) != 0 or app.prompt_active(state)
  let repaint: bool = full or resized or overlay or cache.overlay != overlay or cache.source_width != source.width or cache.source_height != source.height or
    cache.program_width != program.width or cache.program_height != program.height or
    cache.fullscreen != state.fullscreen or cache.source_playing != source_playing or
    cache.program_playing != program_playing
  var surface: draw.Surface = struct.replace(cache, draw.empty_surface(), field=surface)
  if resized { surface = match draw.surface(width, height) {none => { return false }, some(value) => value,} }
  var canvas: draw.Canvas = draw.canvas(surface)
  let scale: f64 = layout.ui_scale(cast.float(width), cast.float(height))
  draw.set_transform(canvas, draw.scale(scale, scale))
  if repaint { paint(state, canvas, cast.float(width) / scale, cast.float(height) / scale, source, program) }
  else { paint_live(state, canvas, cast.float(width) / scale, cast.float(height) / scale, cache.frame, source, program) }
  let _ = struct.replace(cache, draw.finish(canvas), field=surface)
  struct.set(cache, program_frame, field=frame)
  struct.set(cache, source.width, field=source_width)
  struct.set(cache, source.height, field=source_height)
  struct.set(cache, program.width, field=program_width)
  struct.set(cache, program.height, field=program_height)
  struct.set(cache, state.fullscreen, field=fullscreen)
  struct.set(cache, source_playing, field=source_playing)
  struct.set(cache, program_playing, field=program_playing)
  struct.set(cache, overlay, field=overlay)
  true
}
