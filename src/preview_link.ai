// Bounded command/event lanes wake the preview task and native event loop.
// The window streams bounded pixel chunks; file frames remain available to diagnostics.
module genesis.preview_link
import std.channel as channel
import std.gui as gui
import std.text as text
import std.draw as draw
import std.files as files
import std.path as path
import std.tasks as tasks

pub type FrameTiming = struct {
  generation: u64, request_ns: u64, source_ns: u64, plan_ns: u64,
  program_ns: u64, publish_ns: u64, coalesce_ns: u64
}
pub type FramePosition = struct {source_frame: i64, program_frame: i64, revision: u64}
fn empty_timing() -> FrameTiming effects {} {
  FrameTiming {generation:0,request_ns:0,source_ns:0,plan_ns:0,program_ns:0,publish_ns:0,coalesce_ns:0}
}
pub type Link = struct {
  events: channel.Receiver, commands: array<channel.Sender>,
  ready: u64, waveforms: u64, thumbnails: u64, closed: bool, error: string, error_generation: u64, timing: FrameTiming,
  pixel_stream: bool, pending_pixels: channel.ChunkBuffer, pending_info: array<u64>,
  pixel_info: array<u64>, pixel_data: bytes, pixel_error: string,
  position: FramePosition,
  source_data: bytes, source_width: u32, source_height: u32, source_generation: u64, source_taken: u64, source_held: bool
}
pub type Peer = struct {events: channel.Sender, commands: channel.Receiver, last_drain_ns: u64}
fn problem(detail: str) -> string effects {alloc} { text.concat("[GA_PREVIEW_CHANNEL] ", detail) }
pub fn open() -> result<Link,string> effects {alloc,net,time} {
  open_mode(false)
}
pub fn open_pixels() -> result<Link,string> effects {alloc,net,time} {open_mode(true)}
fn open_mode(pixels: bool) -> result<Link,string> effects {alloc,net,time} {
  var events: channel.Receiver = match channel.open(if pixels {4}else{64},if pixels {262144}else{1024}) {
    ok(value) => value, err(error) => { return result.err(problem(str.view(channel.message(error)))) },
  }
  result.ok(Link {events:events,commands:array.new(),ready:0,waveforms:0,
    thumbnails:0,closed:false,error:string.new(),error_generation:0,timing:empty_timing(),
    pixel_stream:pixels,pending_pixels:channel.chunk_buffer(7376896),pending_info:array.new(),
    pixel_info:array.new(),pixel_data:bytes.copy(b""),pixel_error:string.new(),source_data:bytes.copy(b""),
    position:FramePosition {source_frame:0,program_frame:0,revision:0},
    source_width:0,source_height:0,source_generation:0,source_taken:0,source_held:false})
}
pub fn ticket(link: ref<Link>) -> channel.Ticket effects {alloc} {
  channel.ticket(struct.borrow(link,field=events))
}
pub fn peer(carried: ref<channel.Ticket>) -> result<Peer,string> effects {alloc,net,time} {
  let deadline: u64 = time.monotonic_ns()+3000000000
  var events: channel.Sender = match channel.connect(carried,deadline) {
    ok(value) => value, err(error) => { return result.err(problem(str.view(channel.message(error)))) },
  }
  // Empty wake commands consume at most 4096 bounded headers. The document is
  // authoritative in the mailbox, so a burst is coalesced before decoding.
  var commands: channel.Receiver = match channel.open_command_lane(events,0,4096,1,deadline) {
    ok(value) => value, err(error) => { return result.err(problem(str.view(channel.message(error)))) },
  }
  result.ok(Peer {events:events,commands:commands,last_drain_ns:0})
}
pub fn connect(link: ref<Link>) -> result<unit,string> effects {alloc,net,time} {
  let deadline: u64 = time.monotonic_ns()+3000000000
  var item: channel.Message = match channel.recv(struct.borrow(link,field=events),deadline) {
    ok(value) => match value {some(message)=>message,none=>{return result.err(problem("Preview task ended before connecting"))},},
    err(error) => { return result.err(problem(str.view(channel.message(error)))) },
  }
  if item.kind != 0 { return result.err(problem("Preview task did not provide its command lane")) }
  let encoded: string = match channel.text_of(item) {some(value)=>value,none=>{return result.err(problem("Invalid command lane"))},}
  var sender: channel.Sender = match channel.connect_command_lane(str.view(encoded),deadline) {
    ok(value)=>value,err(error)=>{return result.err(problem(str.view(channel.message(error))))},
  }
  array.push(struct.borrow(link,field=commands),sender)
  result.ok(())
}
pub fn wake(link: ref<Link>, stopping: bool) -> result<unit,string> effects {alloc,net,time} {
  if array.len(struct.borrow(link,field=commands)) == 0 or link.closed {
    return result.err(problem("Preview command lane is closed"))
  }
  match channel.send(array.borrow(struct.borrow(link,field=commands),0),
      if stopping {9}else{1},b"",time.monotonic_ns()+100000000) {
    ok(_)=>result.ok(()),err(error)=>result.err(problem(str.view(channel.message(error)))),
  }
}
// Wait for work, then consume the queued burst. One decode reads the newest
// committed document; a final Stop is never hidden by a later wake. The one-second
// idle deadline permits cancellation if startup or command delivery failed; it
// does not delay a request, which wakes the blocking receive immediately.
pub fn next(peer: ref<Peer>) -> bool effects {alloc,net,time} {
  var message: channel.Message = match channel.recv(struct.borrow(peer,field=commands),time.monotonic_ns()+1000000000) {
    ok(value)=>match value {some(value)=>value,none=>{return false},},
    err(error)=>{return error.code == channel.code_empty()},
  }
  if message.kind == 9 { return false }
  let drain_begin: u64 = time.monotonic_ns()
  loop {
    match channel.recv_now(struct.borrow(peer,field=commands),time.monotonic_ns()) {
      ok(value)=>match value {some(value)=>{message=value
        if message.kind == 9 { return false }},none=>{return false},},
      err(error)=>{if error.code == channel.code_empty(){break}else{return false}},
    }
  }
  struct.set(peer,time.monotonic_ns()-drain_begin,field=last_drain_ns)
  true
}
pub fn notify(peer: ref<Peer>, kind: u64, generation: u64) -> bool effects {alloc,net,time} {
  let value: string = string.from_int(generation)
  match channel.send(struct.borrow(peer,field=events),kind,str.bytes(str.view(value)),
    time.monotonic_ns()+100000000) {ok(_)=>true,err(_)=>false,}
}
// Detailed timings travel only for the explicit headless profile. Ordinary
// playback keeps its small generation-only completion message.
pub fn notify_frame(peer: ref<Peer>, generation: u64, request_ns: u64, source_ns: u64,
    plan_ns: u64, program_ns: u64, publish_ns: u64, coalesce_ns: u64) -> bool effects {alloc,net,time} {
  let values: array<u64> = [generation,request_ns,source_ns,plan_ns,program_ns,publish_ns,coalesce_ns]
  var payload: string = string.new()
  var index: u64 = 0
  loop {if index >= array.len(values) {break}
    if index != 0 {string.append(payload,"\t")}
    string.append(payload,str.view(string.from_int(array.get(values,index))))
    index=index+1
  }
  match channel.send(struct.borrow(peer,field=events),1,str.bytes(str.view(payload)),
    time.monotonic_ns()+100000000) {ok(_)=>true,err(_)=>false,}
}

// A full credit lane is resumable. Poll its credit wait in short steps so native
// modal dialogs can hold the consumer without poisoning the stream, while Stop
// or a new committed seek can still retire an incomplete frame.
fn send_pixels_part(peer: ref<Peer>, root: str, id: u64, kind: u64, data: view<byte>)
    -> result<bool,string> effects {alloc,fs.meta,fs.read,net,time} {
  loop {
    match channel.send(struct.borrow(peer,field=events),kind,data,time.monotonic_ns()+50000000) {
      ok(_)=>{return result.ok(true)},
      err(error)=>{
        if error.code != channel.code_full() {return result.err(problem(str.view(channel.message(error))))}
        if str.len(root) != 0 {
          if tasks.requested_at(path.join(root,"stop")) {return result.ok(false)}
          let current: string = match files.read_text(path.join(root,"request.id")) {
            ok(value)=>value,err(_)=>{return result.err("[GA_PREVIEW_REQUEST] Cannot read the pixel request marker")},
          }
          if not str.eq(str.view(text.trim(str.view(current))),str.view(string.from_int(id))) {return result.ok(false)}
        }
      },
    }
  }
  result.ok(false)
}
fn send_pixel_bytes(peer: ref<Peer>, root: str, id: u64, data: view<byte>)
    -> result<bool,string> effects {alloc,fs.meta,fs.read,net,time} {
  var offset: u64 = 0
  loop {if offset >= view.len(data) {break}
    let count: u64 = if view.len(data)-offset > 262144 {262144}else{view.len(data)-offset}
    if not try send_pixels_part(peer,root,id,6,view.slice(data,offset,offset+count)) {return result.ok(false)}
    offset=offset+count
  }
  result.ok(true)
}
pub fn notify_pixels(peer: ref<Peer>, root: str, source: ref<draw.Surface>, program: ref<draw.Surface>,
    detail: str, held_source: bool, timing: FrameTiming, position: FramePosition, publish_begin: u64) -> result<bool,string>
    effects {alloc,fs.meta,fs.read,net,time} {
  let source_pixels: view<byte> = array.view(struct.borrow(source,field=pixels))
  let program_pixels: view<byte> = array.view(struct.borrow(program,field=pixels))
  let values: array<u64> = [timing.generation,cast.wrap(source.width),cast.wrap(source.height),
    cast.wrap(program.width),cast.wrap(program.height),view.len(source_pixels),view.len(program_pixels),str.len(detail),if held_source {1}else{0},
    cast.sat(position.source_frame),cast.sat(position.program_frame),position.revision]
  var header: string = string.new()
  var index: u64 = 0
  loop {if index == 12 {break}
    if index != 0 {string.append(header,"\t")}
    string.append(header,str.view(string.from_int(array.get(values,index))))
    index=index+1
  }
  if not try send_pixels_part(peer,root,timing.generation,5,str.bytes(str.view(header))) {return result.ok(false)}
  if not try send_pixel_bytes(peer,root,timing.generation,source_pixels) {return result.ok(false)}
  if not try send_pixel_bytes(peer,root,timing.generation,program_pixels) {return result.ok(false)}
  if not try send_pixel_bytes(peer,root,timing.generation,str.bytes(detail)) {return result.ok(false)}
  let fields: array<u64> = [timing.generation,timing.request_ns,timing.source_ns,timing.plan_ns,
    timing.program_ns,time.monotonic_ns()-publish_begin,timing.coalesce_ns]
  var done: string = string.new()
  index=0
  loop {if index == 7 {break}
    if index != 0 {string.append(done,"\t")}
    string.append(done,str.view(string.from_int(array.get(fields,index))))
    index=index+1
  }
  send_pixels_part(peer,root,timing.generation,1,str.bytes(str.view(done)))
}
fn pixel_failure(link: ref<Link>, generation: u64, detail: str) -> unit effects {alloc} {
  let _ = struct.replace(link,channel.chunk_buffer(7376896),field=pending_pixels)
  let _ = struct.replace(link,array.new(),field=pending_info)
  struct.set(link,generation,field=error_generation)
  let _ = struct.replace(link,text.concat("[GA_PREVIEW_PIXELS] ",detail),field=error)
  ()
}
fn begin_pixels(link: ref<Link>, header: str) -> unit effects {alloc} {
  var fields: array<string> = text.split(header,"\t")
  var numbers: array<u64> = array.new()
  if array.len(fields) != 12 {pixel_failure(link,link.ready+1,"Invalid frame header")
    return ()}
  var at: u64 = 0
  loop {if at == 12 {break}
    let value: u64 = match text.parse_u64(str.view(array.borrow(fields,at))) {
      some(value)=>value,none=>{pixel_failure(link,link.ready+1,"Invalid frame dimensions")
        return ()},
    }
    array.push(numbers,value)
    at=at+1
  }
  let id: u64 = array.get(numbers,0)
  if id <= link.ready or array.get(numbers,1) > 1280 or array.get(numbers,2) > 720 or
      array.get(numbers,3) > 1280 or array.get(numbers,4) > 720 or array.get(numbers,7) > 4096 or array.get(numbers,8) > 1 or
      array.get(numbers,9) > 9223372036854775807 or array.get(numbers,10) > 9223372036854775807 or
      (array.get(numbers,8) == 1 and (array.len(struct.borrow(link,field=pixel_info)) != 12 or array.get(numbers,5) != 0)) or
      ((array.get(numbers,1) == 0) != (array.get(numbers,2) == 0)) or
      ((array.get(numbers,3) == 0) != (array.get(numbers,4) == 0)) or
      array.get(numbers,5) != array.get(numbers,1)*array.get(numbers,2)*4 or
      array.get(numbers,6) != array.get(numbers,3)*array.get(numbers,4)*4 {
    pixel_failure(link,id,"Invalid frame dimensions or byte lengths")
    return ()
  }
  let _ = struct.replace(link,channel.chunk_buffer(7376896),field=pending_pixels)
  let _ = channel.begin_chunks(struct.borrow(link,field=pending_pixels),array.get(numbers,5)+array.get(numbers,6)+array.get(numbers,7))
  let _ = struct.replace(link,numbers,field=pending_info)
  ()
}
fn finish_pixels(link: ref<Link>, generation: u64) -> bool effects {alloc} {
  var info: array<u64> = struct.replace(link,array.new(),field=pending_info)
  if array.len(info) != 12 or array.get(info,0) != generation {pixel_failure(link,generation,"Frame completion does not match its header")
    return false}
  var raw: bytes = match channel.finish_chunks(struct.borrow(link,field=pending_pixels)) {
    some(value)=>value,none=>{pixel_failure(link,generation,"Incomplete pixel frame")
      return false},
  }
  let offset: u64 = array.get(info,5)+array.get(info,6)
  let detail: string = match str.from_bytes(view.slice(bytes.view(raw),offset,view.len(bytes.view(raw)))) {
    some(value)=>string.copy(value),none=>{pixel_failure(link,generation,"Invalid frame error text")
      return false},
  }
  // Preserve source updates independently of the newest program packet. Poll
  // can coalesce several completed frames before the consumer paints any of them.
  if array.get(info,8) == 0 {
    let _ = struct.replace(link,bytes.copy(view.slice(bytes.view(raw),0,array.get(info,5))),field=source_data)
    struct.set(link,cast.sat(array.get(info,1)),field=source_width)
    struct.set(link,cast.sat(array.get(info,2)),field=source_height)
    struct.set(link,generation,field=source_generation)
  }
  let _ = struct.replace(link,detail,field=pixel_error)
  struct.set(link,FramePosition {source_frame:cast.sat(array.get(info,9)),program_frame:cast.sat(array.get(info,10)),revision:array.get(info,11)},field=position)
  let _ = struct.replace(link,raw,field=pixel_data)
  let _ = struct.replace(link,info,field=pixel_info)
  true
}
pub fn take_images(link: ref<Link>, id: u64) -> array<draw.Surface> effects {alloc} {
  let info: ref<array<u64>> = struct.borrow(link,field=pixel_info)
  var out: array<draw.Surface> = array.new()
  if array.len(info) != 12 or array.get(info,0) != id {return out}
  let program_width: u32 = cast.sat(array.get(info,3))
  let program_height: u32 = cast.sat(array.get(info,4))
  let source_len: u64 = array.get(info,5)
  let program_len: u64 = array.get(info,6)
  let held: bool = link.source_taken == link.source_generation
  struct.set(link,held,field=source_held)
  let source_width: u32 = link.source_width
  let source_height: u32 = link.source_height
  let source_generation: u64 = link.source_generation
  array.push(out,if held {draw.empty_surface()}else{
    match draw.surface_from_rgba(source_width,source_height,bytes.view(struct.borrow(link,field=source_data))) {
      some(value)=>value,none=>draw.empty_surface(),
    }
  })
  struct.set(link,source_generation,field=source_taken)
  let data: view<byte> = bytes.view(struct.borrow(link,field=pixel_data))
  array.push(out,match draw.surface_from_rgba(program_width,program_height,view.slice(data,source_len,source_len+program_len)) {
    some(value)=>value,none=>draw.empty_surface(),
  })
  out
}
pub fn holds_source(link: ref<Link>) -> bool effects {} {
  link.source_held
}
// A seek can retire a prepared picture after its Source bytes were consumed.
// Recover the parked monitor from the transport's authoritative source cache
// when the next accepted packet holds it, without forcing another media decode.
pub fn restore_source(link: ref<Link>) -> draw.Surface effects {alloc} {
  match draw.surface_from_rgba(link.source_width,link.source_height,
      bytes.view(struct.borrow(link,field=source_data))) {
    some(value)=>value,none=>draw.empty_surface(),
  }
}
pub fn finish(peer: ref<Peer>, generation: u64) -> unit effects {alloc,net,time} {
  let _ = notify(peer,9,generation)
  let sender: channel.Sender = struct.replace(peer,channel.orphan(),field=events)
  let _ = channel.hang_up(sender)
  ()
}
pub fn close_commands(link: ref<Link>) -> unit effects {alloc,net,time} {
  loop {match array.pop(struct.borrow(link,field=commands)) {
    some(sender)=>{let _ = channel.hang_up(sender)},none=>{break},
  }}
  ()
}
pub fn fail(peer: ref<Peer>, generation: u64, detail: str) -> unit effects {alloc,net,time} {
  let payload: string = text.concat(str.view(string.from_int(generation)),text.concat("\n",detail))
  let _ = channel.send(struct.borrow(peer,field=events),4,str.bytes(str.view(payload)),time.monotonic_ns()+100000000)
  ()
}
fn take(link: ref<Link>, message: channel.Message own) -> unit effects {alloc} {
  var item: channel.Message = message
  if item.kind == 5 {
    if not link.pixel_stream {pixel_failure(link,link.ready+1,"Unexpected pixel frame")
      return ()}
    match channel.text_of(item) {some(value)=>begin_pixels(link,str.view(value)),none=>pixel_failure(link,link.ready+1,"Invalid frame header text"),}
    return ()
  }
  if item.kind == 6 {
    if not channel.append_chunk(struct.borrow(link,field=pending_pixels),bytes.view(struct.borrow(item,field=data))) {
      let generation: u64 = if array.len(struct.borrow(link,field=pending_info)) == 12 {array.get(struct.borrow(link,field=pending_info),0)}else{link.ready+1}
      pixel_failure(link,generation,"Unexpected or oversized pixel chunk")
    }
    return ()
  }
  if item.kind == 9 {struct.set(link,true,field=closed)
    return ()}
  let value: string = match channel.text_of(item) {some(value)=>value,none=>string.new(),}
  if item.kind == 4 {
    let split: u64 = match str.find(str.view(value),"\n") {some(value)=>value,none=>{return ()},}
    let generation: u64 = match text.parse_u64(str.slice(str.view(value),0,split)) {some(value)=>value,none=>0,}
    if generation < link.ready or generation < link.error_generation {return ()}
    struct.set(link,generation,field=error_generation)
    let _ = struct.replace(link,string.copy(str.slice(str.view(value),split+1,str.len(str.view(value)))),field=error)
    return ()
  }
  var generation: u64 = match text.parse_u64(str.view(value)) {some(value)=>value,none=>0,}
  if item.kind == 1 and option.is_some(str.find(str.view(value),"\t")) {
    var fields: array<string> = text.split(str.view(value),"\t")
    if array.len(fields) != 7 {return ()}
    var numbers: array<u64> = array.new()
    var index: u64 = 0
    loop {if index == 7 {break}
      let value: u64 = match text.parse_u64(str.view(array.borrow(fields,index))) {
        some(value)=>value,none=>{return ()},
      }
      array.push(numbers,value)
      index=index+1
    }
    generation=array.get(numbers,0)
    if generation > link.ready {
      let _ = struct.replace(link,FrameTiming {generation:generation,
        request_ns:array.get(numbers,1),source_ns:array.get(numbers,2),
        plan_ns:array.get(numbers,3),program_ns:array.get(numbers,4),
        publish_ns:array.get(numbers,5),coalesce_ns:array.get(numbers,6)},field=timing)
    }
  }
  if item.kind == 1 and generation > link.ready {
    if link.pixel_stream and not finish_pixels(link,generation) {return ()}
    struct.set(link,generation,field=ready)
    if generation >= link.error_generation {
      let _ = struct.replace(link,string.new(),field=error)
      struct.set(link,0,field=error_generation)
    }
  }
  if item.kind == 2 and generation > link.waveforms {struct.set(link,generation,field=waveforms)}
  if item.kind == 3 and generation > link.thumbnails {struct.set(link,generation,field=thumbnails)}
  ()
}
pub fn poll(link: ref<Link>) -> unit effects {alloc,net,time} {
  if link.closed { return () }
  loop {
    match channel.recv_now(struct.borrow(link,field=events),time.monotonic_ns()) {
      ok(value)=>match value {some(value)=>take(link,value),none=>{struct.set(link,true,field=closed)
        let _ = struct.replace(link,problem("Preview task ended unexpectedly"),field=error)
        break},},
      err(error)=>{if error.code != channel.code_empty() {
        let _ = struct.replace(link,problem(str.view(channel.message(error))),field=error)
        struct.set(link,true,field=closed)
      }
      break},
    }
    if link.closed {break}
  }
  ()
}
pub fn await_event(link: ref<Link>, kind: u64, generation: u64, deadline: u64) -> result<unit,string>
    effects {alloc,net} {
  loop {
    let completed: u64 = if kind == 2 {link.waveforms}else if kind == 3 {link.thumbnails}else{link.ready}
    if completed >= generation {return result.ok(())}
    if link.closed {return result.err(problem("Preview task ended before completing the frame"))}
    if link.error_generation >= generation and str.len(str.view(struct.borrow(link,field=error))) != 0 {
      return result.err(string.copy(str.view(struct.borrow(link,field=error))))
    }
    match channel.recv(struct.borrow(link,field=events),deadline) {
      ok(value)=>match value {some(value)=>take(link,value),none=>{struct.set(link,true,field=closed)},},
      err(error)=>{return result.err(problem(str.view(channel.message(error))))},
    }
    if (link.closed or link.error_generation >= generation) and
        str.len(str.view(struct.borrow(link,field=error))) != 0 {
      return result.err(string.copy(str.view(struct.borrow(link,field=error))))
    }
  }
  result.ok(())
}
pub fn await_ready(link: ref<Link>, generation: u64, deadline: u64) -> result<unit,string> effects {alloc,net} {
  await_event(link,1,generation,deadline)
}
// The runtime wakes on the channel socket or native input. No window is opened
// by this helper; already decoded messages return without a timed wait.
pub fn wait(window: ref<Window>, link: ref<Link>, timeout: u64) -> ui.event effects {ui} {
  if link.closed {return gui.wait(window,timeout)}
  let events: ref<channel.Receiver> = struct.borrow(link,field=events)
  if channel.ready(events) {return gui.wait(window,0)}
  if array.len(struct.borrow(events,field=peer)) != 0 {
    return ui.next_event_on(window,array.borrow(struct.borrow(events,field=peer),0),timeout)
  }
  if array.len(struct.borrow(events,field=listener)) != 0 and not events.ended {
    return ui.next_event_on(window,array.borrow(struct.borrow(events,field=listener),0),timeout)
  }
  gui.wait(window,timeout)
}
