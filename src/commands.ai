// The application command layer.
//
// Every edit in Genesis AIR goes through a function here. An undoable action captures
// the document once, then calls the reusable operations in `std.editor`.
// There is NO edit arithmetic in this file — no clip maths, no ripple, no source clamping.
// If a command looks like it is computing an edit, that is a bug: the toolkit owns it.
//
// Each command returns a `Result` naming what happened, so the UI reports one message and
// the tests assert one outcome.
module genesis.commands

import std.editor as editor
import std.editor_io as editor_io
import std.curve as curve
import std.math as math
import std.files as files
import std.path as path
import std.codec as codec
import std.text as text
import "app.ai" as app
import "provider.ai" as provider
import "recovery.ai" as recovery
import "timeline_media.ai" as timeline_media
import "filter_keys.ai" as filter_keys
import "linked_media.ai" as linked_media

pub type Result = struct { ok: bool, message: string, value: u64 }

fn done(message: str, value: u64) -> Result effects {alloc} {
  Result {ok: true, message: string.copy(message), value: value}
}
fn refused(message: str) -> Result effects {alloc} {
  Result {ok: false, message: string.copy(message), value: 0}
}
pub fn message(value: ref<Result>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(value, field=message)))
}

// Record the document BEFORE a mutation. Every mutating command below calls
// `editor.capture` first, which is what makes undo cover the whole application rather than
// the handful of edits someone remembered to wire.

// ---------------------------------------------------------------------------
// Project

// Installing a different project begins a new undo/session context.
pub fn replace_project(state: ref<app.App>, document: editor.Document own) -> unit effects {alloc} {
  var loaded: editor.Document = document
  let _ = editor.program_action(loaded, editor.pause())
  let _ = editor.monitor_action(loaded, editor.pause())
  if editor.selection_count(loaded) == 0 and editor.clip_count(loaded) == 1 {
    match editor.clip_at(loaded, 0) {none => {}, some(value) => { let _ = editor.select_only(loaded, value.id) },}
  }
  let depth: u64 = struct.get(struct.borrow(state, field=history), field=depth)
  let _ = struct.replace(state, loaded, field=document)
  let _ = struct.replace(state, editor.history(depth), field=history)
  let _ = struct.replace(state, array.new(), field=waveforms)
  let _ = struct.replace(state, array.new(), field=thumbnails)
  let _=struct.replace(state,option.none(),field=clipboard)
  let _=struct.replace(state,option.none(),field=clipboard_peer)
  struct.set(state,false,field=clipboard_resource_valid)
  struct.set(state, app.viewport(), field=viewport)
  app.set_pool_row(state, 0)
  app.set_selected_filter(state, 0)
  let _ = app.set_dock_scroll(state, 0.0)
  app.end_parameter_drag(state)
  app.end_gesture(state)
  app.document_changed(state)
  struct.set(state, state.project_epoch + 1, field=project_epoch)
  app.mark_media_changed(state)
  ()
}

pub fn new_project(state: ref<app.App>) -> Result effects {alloc, fs.write} {
  var fresh: editor.Document = editor.document(30.0, 1920, 1080)
  let sequence: u64 = fresh.active
  let _ = editor.add_track(fresh, sequence, editor.track_audio(), "A2")
  let _ = editor.add_track(fresh, sequence, editor.track_audio(), "A1")
  let _ = editor.add_track(fresh, sequence, editor.track_video(), "V1")
  let _ = editor.add_track(fresh, sequence, editor.track_video(), "V2")
  let _ = recovery.clear_owned(state)
  replace_project(state, fresh)
  app.set_project_path(state, "")
  app.mark_dirty(state, false)
  app.set_status(state, "New project")
  done("new project", 0)
}

pub fn sequence_preset(state: ref<app.App>, preset: u64) -> Result effects {alloc} {
  let width: u32 = if preset == 2 or preset == 3 { 3840 } else if preset == 4 or preset == 5 { 1080 }
    else if preset == 6 { 2160 } else { 1920 }
  let height: u32 = if preset == 2 or preset == 3 { 2160 } else if preset == 4 or preset == 5 { 1920 }
    else if preset == 6 { 2160 } else { 1080 }
  let fps: f64 = if preset == 1 or preset == 2 { 24.0 } else if preset == 5 { 60.0 }
    else if preset == 7 { 25.0 } else if preset == 8 { 29.97002997003 } else { 30.0 }
  let doc: ref<editor.Document> = struct.borrow(state, field=document)
  if editor.duration(doc) > 0 and editor.sequence_fps(doc, doc.active) != fps {
    return refused("[GA_SEQUENCE_RATE] Choose the frame rate before placing clips; resolution can change at any time")
  }
  editor.capture(struct.borrow(state, field=history), doc)
  if not editor.set_sequence_format(doc, doc.active, width, height, fps) { return refused("[GA_SEQUENCE_FORMAT] Invalid format") }
  app.document_changed(state)
  done(text.concat(string.from_int(width), text.concat(" x ", string.from_int(height))), preset)
}

pub fn camera_cut(state: ref<app.App>, track: u64) -> Result effects {alloc} {
  let frame: i64 = editor.playhead(struct.borrow(state, field=document))
  match editor.camera_clip(struct.borrow(state, field=document), track, frame) {
    none => { return refused("[GA_CAMERA_EMPTY] The camera track has no visible video at the playhead") },
    some(_) => {},
  }
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let count: u64 = editor.cut_camera(struct.borrow(state, field=document), track, frame)
  app.document_changed(state)
  done("Camera cut recorded; audio mix unchanged", count)
}
pub fn camera_number(state: ref<app.App>, number: u64) -> Result effects {alloc} {
  let doc: ref<editor.Document> = struct.borrow(state, field=document)
  let active: u64 = doc.active
  var i: u64 = 0
  var camera: u64 = 0
  var target: u64 = 0
  loop { if i >= array.len(struct.borrow(doc, field=tracks)) { break }
    let value: ref<editor.Track> = array.borrow(struct.borrow(doc, field=tracks), i)
    if value.owner == active and value.kind == editor.track_video() {
      camera = camera + 1
      if camera == number { target = value.id
        break }
    }
    i = i + 1
  }
  if target == 0 { return refused("[GA_CAMERA_NUMBER] No video track for that camera number") }
  camera_cut(state, target)
}

pub fn save_project(state: ref<app.App>, target: str) -> Result effects {alloc, fs.write} {
  let text: string = match editor_io.encode(struct.borrow(state, field=document)) {
    ok(value) => value,
    err(problem) => { var failure: codec.Error = problem
      return refused(str.view(text.concat("[GA_PROJECT_FORMAT] ", str.view(codec.describe(failure))))) },
  }
  // Reserve an unused sibling; a stale or concurrent temporary is never overwritten.
  var slot: u64 = 0
  loop {
    let temporary: string = text.concat(target, text.concat(".genesis-save-", text.concat(str.view(string.from_int(slot)), ".tmp")))
    match files.write_atomic(target, str.view(temporary), str.view(text)) {
      ok(_) => { break },
      err(problem) => {
        if problem.code != 3 or slot >= 31 {
          return refused("[GA_SAVE_PUBLISH] The project could not be saved; current edits and the previous save are preserved")
        }
      },
    }
    slot = slot + 1
  }
  app.set_project_path(state, target)
  app.mark_dirty(state, false)
  let cleared: bool = recovery.clear_owned(state)
  app.set_status(state, "Saved")
  done(if cleared { "saved" } else { "[GA_RECOVERY_CLEAR] Project saved; a recovery file could not be cleared" }, cast.sat(str.len(str.view(text))))
}

pub fn save(state: ref<app.App>) -> Result effects {alloc, fs.write} {
  let where: string = app.project_path(state)
  if str.len(str.view(where)) == 0 { return refused("this project has no path yet; use save as") }
  save_project(state, str.view(where))
}

// Open a project. The stored schema and revision are the toolkit's; a revision this build
// does not implement is refused by `std.editor_io` and reported here rather than guessed at.
pub fn open_project(state: ref<app.App>, target: str) -> Result effects {alloc, fs.read, fs.write} {
  let text: string = match files.read_text(target) {
    ok(value) => value,
    err(problem) => { return refused("[GA_PROJECT_READ] The project could not be read; current edits are preserved") },
  }
  var loaded: editor.Document = match editor_io.decode(str.view(text)) {
    ok(value) => value,
    err(problem) => { var failure: codec.Error = problem
      return refused(str.view(text.concat("[GA_PROJECT_FORMAT] ", str.view(codec.describe(failure))))) },
  }
  let _ = recovery.clear_owned(state)
  replace_project(state, loaded)
  app.set_project_path(state, target)
  app.mark_dirty(state, false)
  app.set_status(state, "Opened")
  done("opened", 0)
}

// Native opens expose legacy embedded audio as linked clips; headless readers retain
// the original graph. Conversion is in memory and requires an explicit Save.
pub fn open_linked_project(state:ref<app.App>,target:str) -> Result effects {alloc,fs.read,fs.write} {
  let content:string=match files.read_text(target) {err(_)=>{return refused("[GA_PROJECT_READ] The project could not be read; current edits are preserved")},ok(value)=>value,}
  var loaded:editor.Document=match editor_io.decode(content) {err(_)=>{return refused("[GA_PROJECT_FORMAT] Invalid project; current edits are preserved")},ok(value)=>value,}
  var warning:string=string.new()
  let count:u64=match linked_media.migrate_legacy(loaded) {err(problem)=>{warning=text.concat("Opened original layout; automatic stream separation unavailable: ",problem)
    0},ok(value)=>value,}
  let _=recovery.clear_owned(state)
  replace_project(state,loaded)
  app.set_project_path(state,target)
  app.mark_dirty(state,count!=0)
  let message:string=if str.len(warning)!=0 {warning}else if count!=0 {string.copy("Opened; video and audio separated into linked lanes. Save to keep this layout")} else {string.copy("Opened")}
  app.set_status(state,message)
  done(message,count)
}

// ---------------------------------------------------------------------------
// Media

fn media_path(state: ref<app.App>, chosen: str) -> option<string> effects {alloc, fs.read} {
  // Fake-provider fixtures deliberately use synthetic names such as "audio:media/vo.wav".
  if struct.get(struct.borrow(state, field=provider), field=kind) == provider.kind_fake() {
    return option.some(string.copy(chosen))
  }
  if path.is_absolute(chosen) { return option.some(path.normalize(chosen)) }
  let cwd: string = match files.cwd() {
    ok(value) => value,
    err(problem) => { return option.none() },
  }
  option.some(path.join(str.view(cwd), chosen))
}

// Import a source. The provider is asked how long it really is, and that length becomes the
// pool's authoritative frame count — which is what lets the toolkit refuse a clip that would
// read past the end of the media.
pub fn import_media(state: ref<app.App>, path: str, name: str) -> Result effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  let absolute: string = match media_path(state, path) {
    some(value) => value,
    none => { return refused("the media path could not be resolved") },
  }
  var report: provider.Probe = provider.probe(struct.borrow(state, field=provider), str.view(absolute))
  if not report.ok { return refused(str.view(struct.borrow(report, field=detail))) }
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let id: u64 = editor.add_source(struct.borrow(state, field=document), str.view(absolute), name,
    report.frames, report.fps)
  let _ = editor.describe_source(struct.borrow(state, field=document), id, report.width,
    report.height, report.has_video, report.has_audio, 48000, 2)
  app.document_changed(state)
  if not report.ok {
    app.set_status(state, "Imported, but its length is unknown")
    return done("imported with unknown length", id)
  }
  app.set_status(state, "Imported")
  done("imported", id)
}

// Import an ordered native file-drop payload through the same provider/document path as
// Add. The host owns only newline-delimited path transfer; Genesis owns the policy.
pub fn import_drop(state: ref<app.App>, listing: str) -> Result effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  var paths: array<string> = text.lines(listing)
  var imported: u64 = 0
  var index: u64 = 0
  loop {
    if index >= array.len(paths) { break }
    let source: str = str.view(array.borrow(paths, index))
    if str.len(source) != 0 {
      var named: string = path.basename(source)
      var result: Result = import_media(state, source, str.view(named))
      if result.ok { imported = imported + 1 }
    }
    index = index + 1
  }
  if imported == 0 { return refused("the dropped selection contains no usable media") }
  var message: string = string.copy("imported ")
  string.append(message, str.view(string.from_int(imported)))
  string.append(message, if imported == 1 { " dropped file" } else { " dropped files" })
  done(str.view(message), imported)
}

pub fn add_bin(state: ref<app.App>, name: str) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let id: u64 = editor.add_bin(struct.borrow(state, field=document), name, 1)
  app.document_changed(state)
  done("bin added", id)
}

pub fn relink(state: ref<app.App>, source: u64, path: str) -> Result effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  let absolute: string = match media_path(state, path) {
    some(value) => value,
    none => { return refused("the media path could not be resolved") },
  }
  provider.restart(struct.borrow(state, field=provider))
  app.mark_media_changed(state)
  var report: provider.Probe = provider.probe(struct.borrow(state, field=provider), str.view(absolute))
  if not report.ok { return refused(str.view(struct.borrow(report, field=detail))) }
  if not editor.relink_source_possible(struct.borrow(state, field=document), source, report.frames) {
    return refused("[GA_AUDIO_CONTEXT] Replacement media cannot preserve the retained audio processing span")
  }
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let corrected: u64 = editor.relink_source(struct.borrow(state, field=document), source, str.view(absolute),
    report.frames)
  app.document_changed(state)
  if corrected != 0 {
    app.set_status(state, "Relinked; some clips were clamped to the new media")
    return done("relinked with clamping", corrected)
  }
  app.set_status(state, "Relinked")
  done("relinked", 0)
}

// ---------------------------------------------------------------------------
// Tracks

// A new track goes where its kind belongs: video on top, which is where `add_track` already
// appends it, and audio at the bottom, which needs `std.editor.reorder_track`.
pub fn add_track(state: ref<app.App>, kind: u32, name: str) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let sequence: u64 = struct.get(struct.borrow(state, field=document), field=active)
  let id: u64 = editor.add_track(struct.borrow(state, field=document), sequence, kind, name)
  if kind == editor.track_audio() {
    let _ = editor.reorder_track(struct.borrow(state, field=document), id, 0)
  }
  app.document_changed(state)
  done(if kind == editor.track_audio() { "audio track added below the video" }
       else { "video track added" }, id)
}

pub fn remove_track(state: ref<app.App>, track: u64) -> Result effects {alloc} {
  let doc:ref<editor.Document> = struct.borrow(state,field=document)
  match editor.track_slot(doc,track) {none=>{return refused("[GA_EDIT_TARGET] No such track")},some(_)=>{},}
  if editor.track_locked(doc,track) {return refused("[GA_EDIT_LOCKED] Track is locked")}
  var candidate:editor.Document=editor.copy_document(doc)
  if not editor.remove_track(candidate,track) {return refused("[GA_EDIT_CONTEXT] Track could not be removed")}
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done("track removed",track)
}

pub fn rename_track(state: ref<app.App>, track: u64, name: str) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.rename_track(struct.borrow(state, field=document), track, name) {
    return refused("no such track")
  }
  app.document_changed(state)
  done("track renamed", track)
}

// ---------------------------------------------------------------------------
// Timeline edits
//
// Each of these is a capture followed by exactly one toolkit call. That is the whole point:
// split, ripple, slip, roll and slide semantics live in `std.editor` and are not restated
// here, so the application cannot drift from the behavior the toolkit's gates prove.

pub fn insert_clip(state: ref<app.App>, track: u64, source: u64, source_in: i64, length: i64,
                   at: i64) -> Result effects {alloc} {
  // The toolkit may split before placement refuses a source range. Commit only success.
  var candidate: editor.Document = editor.copy_document(struct.borrow(state, field=document))
  match editor.insert(candidate, track, source, source_in, length, at) {
    some(id) => {
      if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
      editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
      let _ = struct.replace(state, candidate, field=document)
      app.document_changed(state)
      done("inserted", id) },
    none => refused("the clip could not be inserted there"),
  }
}

pub fn overwrite_clip(state: ref<app.App>, track: u64, source: u64, source_in: i64,
                      length: i64, at: i64) -> Result effects {alloc} {
  // Lifting the occupied range must not reach the live document if placement refuses it.
  var candidate: editor.Document = editor.copy_document(struct.borrow(state, field=document))
  match editor.overwrite(candidate, track, source, source_in, length, at) {
    some(id) => {
      if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
      editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
      let _ = struct.replace(state, candidate, field=document)
      app.document_changed(state)
      done("overwrote", id) },
    none => refused("the clip could not be placed there"),
  }
}

pub fn append_clip(state: ref<app.App>, track: u64, source: u64, source_in: i64,
                   length: i64) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  match editor.append(struct.borrow(state, field=document), track, source, source_in, length) {
    some(id) => { app.document_changed(state)
      done("appended", id) },
    none => refused("the clip could not be appended"),
  }
}

// Placement commits both streams together, with one undo snapshot.
fn source_flags(doc:ref<editor.Document>,source:u64) -> u32 effects {} {
  let slot:u64=match editor.source_slot(doc,source) {none=>{return 0},some(value)=>value,}
  let media:ref<editor.Source> =array.borrow(struct.borrow(doc,field=sources),slot)
  (if media.has_video {1}else{0})+(if media.has_audio {2}else{0})
}
fn place_source(state:ref<app.App>,source:u64,source_in:i64,length:i64,at:i64,mode:u32) -> Result effects {alloc} {
  let flags:u32=source_flags(struct.borrow(state,field=document),source)
  if flags==0 {return refused("[GA_EDIT_SOURCE] No audio or video media is available")}
  let has_video:bool=flags==1 or flags==3
  let has_audio:bool=flags==2 or flags==3
  let track:u64=if has_video {app.default_video_track(state)} else {app.default_audio_track(state)}
  let audio:u64=app.default_audio_track(state)
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  var candidate:editor.Document=editor.copy_document(doc)
  let id:u64=match if mode==1 {editor.insert(candidate,track,source,source_in,length,at)} else if mode==2 {editor.overwrite(candidate,track,source,source_in,length,at)} else {editor.append(candidate,track,source,source_in,length)} {
    none=>{return refused("[GA_EDIT_PLACE] Media cannot be placed on this lane")},some(value)=>value,
  }
  if has_video and has_audio {
    let placed:editor.Clip=match editor.clip(candidate,id) {none=>{return refused("[GA_EDIT_PLACE] Missing placed clip")},some(value)=>value,}
    if mode!=0 {
      // Apply the same SDK range operation to the audio lane before adding its stream.
      let temp:u64=match if mode==1 {editor.insert(candidate,audio,source,source_in,length,placed.start)} else {editor.overwrite(candidate,audio,source,source_in,length,placed.start)} {
        none=>{return refused("[GA_LINKED_PLACE] Audio lane is locked or cannot preserve this edit")},some(value)=>value,
      }
      if not editor.lift(candidate,temp) {return refused("[GA_LINKED_PLACE] Audio lane could not be prepared")}
    }
    match linked_media.separate_import(candidate,id,audio) {err(problem)=>{return refused(problem)},ok(_)=>{},}
  } else {
    let _=editor.set_clip_streams(candidate,id,if has_video {editor.streams_video()} else {editor.streams_audio()})
  }
  if not linked_document_geometry(doc,candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),doc)
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done(if has_video and has_audio {"Added linked video and audio"} else if has_video {"Added video"} else {"Added audio"},id)
}
pub fn append_source(state:ref<app.App>,source:u64,source_in:i64,length:i64) -> Result effects {alloc} {place_source(state,source,source_in,length,0,0)}
pub fn insert_source(state:ref<app.App>,source:u64,source_in:i64,length:i64,at:i64) -> Result effects {alloc} {place_source(state,source,source_in,length,at,1)}
pub fn overwrite_source(state:ref<app.App>,source:u64,source_in:i64,length:i64,at:i64) -> Result effects {alloc} {place_source(state,source,source_in,length,at,2)}

fn linked_geometry(doc:ref<editor.Document>,id:u64,peer:u64) -> bool effects {} {
  if peer==0 {return true}
  let a:editor.Clip=match editor.clip(doc,id) {none=>{return false},some(value)=>value,}
  let b:editor.Clip=match editor.clip(doc,peer) {none=>{return false},some(value)=>value,}
  a.owner==b.owner and a.source==b.source and a.nested==b.nested and
  a.start==b.start and a.source_in==b.source_in and a.length==b.length and a.speed==b.speed and a.reverse==b.reverse
}
// A multi-lane operation may affect unselected followers or neighbours. Every
// previously linked pair must survive with one source-time mapping or disappear
// together; validate before capturing history, including pairs on other A lanes.
fn linked_document_geometry(before:ref<editor.Document>,after:ref<editor.Document>) -> bool effects {} {
  var i:u64=0
  loop {if i>=editor.clip_count(before) {break}
    let old:editor.Clip=option.unwrap(editor.clip_at(before,i))
    let peer:u64=linked_media.mate(before,old.id)
    if peer!=0 and old.id<peer {
      let first:bool=option.is_some(editor.clip(after,old.id))
      let second:bool=option.is_some(editor.clip(after,peer))
      if first!=second {return false}
      if first and not linked_geometry(after,old.id,peer) {return false}
    }
    i=i+1}
  true
}
// Read-only exact-geometry trial for a candidate pointer snap. The actual edit
// still uses move_clip/trim_start/trim_end and owns the sole Undo transaction.
pub fn drag_possible(doc:ref<editor.Document>,id:u64,kind:u32,track:u64,start:i64,length:i64) -> bool effects {alloc} {
  if start<0 or length<1 or start>9223372036854775807-length {return false}
  let old:editor.Clip=match editor.clip(doc,id) {none=>{return false},some(value)=>value,}
  let peer:u64=linked_media.mate(doc,id)
  var candidate:editor.Document=editor.copy_document(doc)
  if kind==app.drag_move() {
    if editor.track_kind(doc,old.track)!=editor.track_kind(doc,track) or not editor.move_clip(candidate,id,track,start) {return false}
    if peer!=0 and not editor.nudge(candidate,peer,start-old.start) {return false}
  }else if kind==app.drag_trim_start() {
    if not editor.trim_start(candidate,id,start) {return false}
    if peer!=0 and not editor.trim_start(candidate,peer,start) {return false}
  }else if kind==app.drag_trim_end() {
    if not editor.trim_end(candidate,id,length) {return false}
    if peer!=0 and not editor.trim_end(candidate,peer,length) {return false}
  }else{return false}
  let actual:editor.Clip=match editor.clip(candidate,id) {none=>{return false},some(value)=>value,}
  actual.start==start and actual.length==length and linked_geometry(candidate,id,peer) and linked_document_geometry(doc,candidate)
}
fn regroup_pair(doc:ref<editor.Document>,a:u64,b:u64) -> unit effects {alloc} {
  if b==0 {return ()}
  var members:array<u64> =array.new()
  array.push(members,a)
  array.push(members,b)
  let _=editor.group(doc,array.view(members))
  ()
}

pub fn move_clip(state:ref<app.App>,clip:u64,track:u64,start:i64) -> Result effects {alloc} {
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  let current:editor.Clip=match editor.clip(doc,clip) {none=>{return refused("no such clip")},some(value)=>value,}
  if editor.track_kind(doc,current.track)!=editor.track_kind(doc,track) {return refused("[GA_TRACK_KIND] Keep video on a video lane and audio on an audio lane")}
  let peer:u64=linked_media.mate(doc,clip)
  var candidate:editor.Document=editor.copy_document(doc)
  if not editor.move_clip(candidate,clip,track,start) {return refused("[GA_EDIT_LOCKED] Clip cannot move there")}
  let moved:editor.Clip=match editor.clip(candidate,clip) {none=>{return refused("[GA_EDIT_TARGET] Missing clip")},some(value)=>value,}
  if peer!=0 and not editor.nudge(candidate,peer,moved.start-current.start) {return refused("[GA_LINKED_LOCKED] Linked audio/video lane is locked")}
  if not linked_geometry(candidate,clip,peer) {return refused("[GA_LINKED_RANGE] Linked streams cannot preserve the same source time")}
  if not linked_document_geometry(doc,candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),doc)
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done("moved",clip)
}
pub fn nudge(state:ref<app.App>,clip:u64,delta:i64) -> Result effects {alloc} {
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  let current:editor.Clip=match editor.clip(doc,clip) {none=>{return refused("no such clip")},some(value)=>value,}
  let outcome:Result=move_clip(state,clip,current.track,add.sat(current.start,delta))
  if not outcome.ok {return outcome}
  done("nudged",outcome.value)
}

// SPLIT at the playhead, which is what the keyboard shortcut means.
pub fn split_at_playhead(state: ref<app.App>) -> Result effects {alloc} {
  let frame: i64 = editor.playhead(struct.borrow(state, field=document))
  let sequence: u64 = struct.get(struct.borrow(state, field=document), field=active)
  let chosen: u64 = app.current_clip(state)
  var candidate: editor.Document = editor.copy_document(struct.borrow(state,field=document))
  if chosen != 0 {
    let selected: editor.Clip = match editor.clip(candidate,chosen) {none=>{return refused("no selected clip")},some(value)=>value,}
    if selected.start < frame and editor.clip_end(selected) > frame {
      match editor.split(candidate, chosen, frame) {
        some(id) => {
          let peer:u64=linked_media.mate(struct.borrow(state,field=document),chosen)
          if peer!=0 {
            let right:u64=match editor.split(candidate,peer,frame) {none=>{return refused("[GA_LINKED_SPLIT] Linked stream could not be split; both clips preserved")},some(value)=>value,}
            regroup_pair(candidate,chosen,peer)
            regroup_pair(candidate,id,right)
          }
          if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
          editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))
          let _ = struct.replace(state,candidate,field=document)
          app.document_changed(state)
          return done("split", id) },
        none => {return refused("[GA_SPLIT_CONTEXT] Cut is locked or cannot preserve source time, fades, or effect history")},
      }
    }
  }
  // Nothing selected, or the playhead is not inside it: split every track at the playhead,
  // which is the ordinary "razor all" gesture.
  var walk:u64=0
  loop {if walk>=editor.clip_count(candidate) {break}
    let value:editor.Clip=match editor.clip_at(candidate,walk) {none=>{break},some(found)=>found,}
    if value.owner==sequence and value.start<frame and editor.clip_end(value)>frame {
      let peer:u64=linked_media.mate(candidate,value.id)
      if peer!=0 and (editor.track_locked(candidate,value.track) or not editor.split_possible(candidate,peer,frame)) {
        return refused("[GA_LINKED_SPLIT] A linked lane is locked or cannot preserve this cut; all clips were preserved")
      }
    }
    walk=walk+1
  }
  let cuts: u64 = editor.split_all(candidate, sequence, frame)
  if cuts == 0 { return refused("[GA_SPLIT_CONTEXT] No unlocked cut can preserve source time, fades, and effect history at this playhead") }
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))
  let _ = struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done("split all tracks", cuts)
}

// Compare actual toolkit outcomes rather than repeating source-bound or ripple geometry.
// A clamped edit may succeed with the complete document unchanged.
fn trim_unchanged(before: ref<editor.Document>, after: ref<editor.Document>) -> bool effects {alloc} {
  let previous: string = match editor_io.encode(before) {err(_)=>{return false},ok(value)=>value,}
  let candidate: string = match editor_io.encode(after) {err(_)=>{return false},ok(value)=>value,}
  str.eq(previous,candidate)
}
pub fn trim_start(state: ref<app.App>, clip: u64, start: i64) -> Result effects {alloc} {
  let current: editor.Clip = match editor.clip(struct.borrow(state,field=document),clip) {
    none=>{return refused("[GA_TRIM_CONTEXT] No such clip for head trim")},some(value)=>value,
  }
  if start == current.start {return done("[GA_TRIM_NO_CHANGE] Head already at this frame",clip)}
  let peer:u64=linked_media.mate(struct.borrow(state,field=document),clip)
  var candidate: editor.Document = editor.copy_document(struct.borrow(state, field=document))
  if not editor.trim_start(candidate, clip, start) {
    return refused("[GA_TRIM_CONTEXT] Head trim cannot preserve unlocked source time and effect history")
  }
  if trim_unchanged(struct.borrow(state,field=document),candidate) {
    return done("[GA_TRIM_NO_CHANGE] Head remains at the available source bound",clip)
  }
  if peer!=0 and not editor.trim_start(candidate,peer,start) {return refused("[GA_LINKED_LOCKED] Linked stream edit was refused; both clips were preserved")}
  if not linked_geometry(candidate,clip,peer) {return refused("[GA_LINKED_RANGE] Linked streams cannot preserve the same source time")}
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let _ = struct.replace(state, candidate, field=document)
  app.document_changed(state)
  done("trimmed head", clip)
}
pub fn trim_end(state: ref<app.App>, clip: u64, length: i64) -> Result effects {alloc} {
  let current: editor.Clip = match editor.clip(struct.borrow(state,field=document),clip) {
    none=>{return refused("[GA_TRIM_CONTEXT] No such clip for tail trim")},some(value)=>value,
  }
  if length == current.length {return done("[GA_TRIM_NO_CHANGE] Tail already at this frame",clip)}
  let peer:u64=linked_media.mate(struct.borrow(state,field=document),clip)
  var candidate: editor.Document = editor.copy_document(struct.borrow(state, field=document))
  if not editor.trim_end(candidate, clip, length) {
    return refused("[GA_TRIM_CONTEXT] Tail trim cannot preserve unlocked source time and effect history")
  }
  if trim_unchanged(struct.borrow(state,field=document),candidate) {
    return done("[GA_TRIM_NO_CHANGE] Tail remains at the available source bound",clip)
  }
  if peer!=0 and not editor.trim_end(candidate,peer,length) {return refused("[GA_LINKED_LOCKED] Linked stream edit was refused; both clips were preserved")}
  if not linked_geometry(candidate,clip,peer) {return refused("[GA_LINKED_RANGE] Linked streams cannot preserve the same source time")}
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let _ = struct.replace(state, candidate, field=document)
  app.document_changed(state)
  done("trimmed tail", clip)
}
pub fn ripple_trim_end(state: ref<app.App>, clip: u64, length: i64) -> Result effects {alloc} {
  let current: editor.Clip = match editor.clip(struct.borrow(state,field=document),clip) {
    none=>{return refused("[GA_TRIM_CONTEXT] No such clip for ripple trim")},some(value)=>value,
  }
  if length == current.length {return done("[GA_TRIM_NO_CHANGE] Ripple tail already at this frame",clip)}
  let peer:u64=linked_media.mate(struct.borrow(state,field=document),clip)
  var candidate: editor.Document = editor.copy_document(struct.borrow(state, field=document))
  if not editor.ripple_trim_end(candidate, clip, length) {
    return refused("[GA_TRIM_CONTEXT] Ripple trim cannot preserve unlocked source time and effect history")
  }
  if trim_unchanged(struct.borrow(state,field=document),candidate) {
    return done("[GA_TRIM_NO_CHANGE] Ripple tail remains at the available source bound",clip)
  }
  if peer!=0 and not editor.ripple_trim_end(candidate,peer,length) {return refused("[GA_LINKED_LOCKED] Linked stream edit was refused; both clips were preserved")}
  if not linked_geometry(candidate,clip,peer) {return refused("[GA_LINKED_RANGE] Linked streams cannot preserve the same source time")}
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let _ = struct.replace(state, candidate, field=document)
  app.document_changed(state)
  done("ripple trimmed", clip)
}
pub fn ripple_delete(state: ref<app.App>, clip: u64) -> Result effects {alloc} {
  let doc:ref<editor.Document> = struct.borrow(state,field=document)
  let value:editor.Clip=match editor.clip(doc,clip) {none=>{return refused("[GA_EDIT_TARGET] No such clip")},some(found)=>found,}
  if editor.track_locked(doc,value.track) {return refused("[GA_EDIT_LOCKED] Track is locked")}
  let peer:u64=linked_media.mate(doc,clip)
  var candidate:editor.Document=editor.copy_document(doc)
  if not editor.ripple_delete(candidate,clip) {return refused("[GA_EDIT_CONTEXT] Clip could not be ripple deleted")}
  if peer!=0 and not editor.ripple_delete(candidate,peer) {return refused("[GA_LINKED_LOCKED] Linked stream edit was refused; both clips were preserved")}
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done("ripple deleted",clip)
}
pub fn lift(state: ref<app.App>, clip: u64) -> Result effects {alloc} {
  let doc:ref<editor.Document> = struct.borrow(state,field=document)
  let value:editor.Clip=match editor.clip(doc,clip) {none=>{return refused("[GA_EDIT_TARGET] No such clip")},some(found)=>found,}
  if editor.track_locked(doc,value.track) {return refused("[GA_EDIT_LOCKED] Track is locked")}
  let peer:u64=linked_media.mate(doc,clip)
  var candidate:editor.Document=editor.copy_document(doc)
  if not editor.lift(candidate,clip) {return refused("[GA_EDIT_CONTEXT] Clip could not be lifted")}
  if peer!=0 and not editor.lift(candidate,peer) {return refused("[GA_LINKED_LOCKED] Linked stream edit was refused; both clips were preserved")}
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done("lifted",clip)
}

pub fn slip(state:ref<app.App>,clip:u64,delta:i64) -> Result effects {alloc} {
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  let peer:u64=linked_media.mate(doc,clip)
  if clip_locked(doc,clip) or (peer!=0 and clip_locked(doc,peer)) {return refused("[GA_LINKED_LOCKED] Linked slip needs unlocked lanes")}
  var candidate:editor.Document=editor.copy_document(doc)
  if not editor.slip(candidate,clip,delta) {return refused("that slip was refused")}
  if peer!=0 and not editor.slip(candidate,peer,delta) {return refused("[GA_LINKED_LOCKED] Linked stream slip was refused")}
  if not linked_geometry(candidate,clip,peer) {return refused("[GA_LINKED_RANGE] Linked streams cannot preserve the same source time")}
  if not linked_document_geometry(doc,candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),doc)
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done("slipped",clip)
}
fn clip_locked(doc:ref<editor.Document>,id:u64) -> bool effects {} {
  match editor.clip(doc,id) {none=>true,some(value)=>editor.track_locked(doc,value.track),}
}
pub fn roll(state:ref<app.App>,left:u64,right:u64,delta:i64) -> Result effects {alloc} {
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  let lp:u64=linked_media.mate(doc,left)
  let rp:u64=linked_media.mate(doc,right)
  if (lp==0)!=(rp==0) {return refused("[GA_LINKED_ROLL] Both sides of a linked cut need matching audio/video mates")}
  if clip_locked(doc,left) or clip_locked(doc,right) or (lp!=0 and (clip_locked(doc,lp) or clip_locked(doc,rp))) {
    return refused("[GA_LINKED_LOCKED] Roll needs unlocked lanes")
  }
  var candidate:editor.Document=editor.copy_document(doc)
  let applied:i64=editor.roll(candidate,left,right,delta)
  if applied==0 {return refused("that cut cannot roll")}
  if lp!=0 and editor.roll(candidate,lp,rp,applied)!=applied {return refused("[GA_LINKED_ROLL] Linked cut cannot apply the same roll")}
  if not linked_geometry(candidate,left,lp) or not linked_geometry(candidate,right,rp) {return refused("[GA_LINKED_ROLL] Linked cut source ranges differ")}
  if not linked_document_geometry(doc,candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),doc)
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done("rolled",cast.wrap(if applied<0 {0-applied}else{applied}))
}
fn abutting(doc:ref<editor.Document>,clip:editor.Clip,before:bool) -> u64 effects {} {
  var found:u64=0
  var i:u64=0
  loop {if i>=editor.clip_count(doc) {break}
    let other:editor.Clip=option.unwrap(editor.clip_at(doc,i))
    if other.id!=clip.id and other.track==clip.track and
      (if before {editor.clip_end(other)==clip.start}else{other.start==editor.clip_end(clip)}) {
      if found!=0 {return 0}
      found=other.id
    }
    i=i+1}
  found
}
pub fn slide(state:ref<app.App>,clip:u64,delta:i64) -> Result effects {alloc} {
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  let old:editor.Clip=match editor.clip(doc,clip) {none=>{return refused("no such clip")},some(value)=>value,}
  let before:u64=abutting(doc,old,true)
  let after:u64=abutting(doc,old,false)
  if before==0 or after==0 {return refused("that clip has no unique abutting neighbours to absorb a slide")}
  let peer:u64=linked_media.mate(doc,clip)
  let bp:u64=linked_media.mate(doc,before)
  let ap:u64=linked_media.mate(doc,after)
  if (peer==0 and (bp!=0 or ap!=0)) or (peer!=0 and (bp==0 or ap==0)) {
    return refused("[GA_LINKED_SLIDE] Every affected neighbour needs matching audio/video mates")
  }
  if clip_locked(doc,clip) or clip_locked(doc,before) or clip_locked(doc,after) or
    (peer!=0 and (clip_locked(doc,peer) or clip_locked(doc,bp) or clip_locked(doc,ap))) {
    return refused("[GA_LINKED_LOCKED] Slide needs unlocked lanes")
  }
  var candidate:editor.Document=editor.copy_document(doc)
  if not editor.slide(candidate,clip,delta) {return refused("that slide cannot preserve its neighbours")}
  if peer!=0 {
    let other:editor.Clip=option.unwrap(editor.clip(doc,peer))
    if abutting(doc,other,true)!=bp or abutting(doc,other,false)!=ap or not editor.slide(candidate,peer,delta) {
      return refused("[GA_LINKED_SLIDE] Linked neighbours cannot apply the same slide")
    }
  }
  if not linked_geometry(candidate,clip,peer) or not linked_geometry(candidate,before,bp) or not linked_geometry(candidate,after,ap) {
    return refused("[GA_LINKED_SLIDE] Linked slide source ranges differ")
  }
  if not linked_document_geometry(doc,candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),doc)
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done("slid",clip)
}

// ---------------------------------------------------------------------------
// Selection and grouping

pub fn select_only(state: ref<app.App>, clip: u64) -> Result effects {alloc} {
  if not editor.select_only(struct.borrow(state, field=document), clip) {
    return refused("no such clip")
  }
  done("selected", clip)
}
pub fn add_to_selection(state: ref<app.App>, clip: u64) -> Result effects {alloc} {
  if not editor.select(struct.borrow(state, field=document), clip, true) {
    return refused("no such clip")
  }
  done("added to selection", clip)
}
pub fn clear_selection(state: ref<app.App>) -> Result effects {alloc} {
  editor.clear_selection(struct.borrow(state, field=document))
  done("selection cleared", 0)
}

pub fn group_selection(state: ref<app.App>) -> Result effects {alloc} {
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  var members:array<u64> =editor.selection(doc)
  let selected:u64=array.len(members)
  if selected<2 {return refused("select at least two clips to group")}
  if doc.next_id==0 or doc.next_id==18446744073709551615 {
    return refused("[GA_LINKED_CAPACITY] Group identity capacity is exhausted")
  }
  // Regrouping selected video halves must carry their existing audio mates too.
  var i:u64=0
  loop {if i>=selected {break}
    let peer:u64=linked_media.mate(doc,array.get(members,i))
    if peer!=0 {
      var found:bool=false
      var j:u64=0
      loop {if j>=array.len(members) {break}
        if array.get(members,j)==peer {found=true
          break}
        j=j+1}
      if not found {array.push(members,peer)}
    }
    i=i+1}
  i=0
  loop {if i>=array.len(members) {break}
    if clip_locked(doc,array.get(members,i)) {return refused("[GA_LINKED_LOCKED] A selected or linked lane is locked")}
    i=i+1}
  var candidate:editor.Document=editor.copy_document(doc)
  let id:u64=editor.group(candidate,array.view(members))
  if id==0 {return refused("those clips could not be grouped")}
  // A group containing duplicate source-time pairs would make mate discovery
  // ambiguous; refuse before committing instead of silently losing linkage.
  i=0
  loop {if i>=array.len(members) {break}
    let clip:u64=array.get(members,i)
    let peer:u64=linked_media.mate(doc,clip)
    if peer!=0 and linked_media.mate(candidate,clip)!=peer {
      return refused("[GA_LINKED_GROUP] Grouping would make an existing audio/video pair ambiguous")
    }
    i=i+1}
  editor.capture(struct.borrow(state,field=history),doc)
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done("grouped",id)
}
pub fn ungroup(state: ref<app.App>, group: u64) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.ungroup(struct.borrow(state, field=document), group) {
    return refused("no such group")
  }
  app.document_changed(state)
  done("ungrouped", group)
}
pub fn move_group(state: ref<app.App>, group: u64, delta: i64) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.move_group(struct.borrow(state, field=document), group, delta) {
    return refused("that group cannot move")
  }
  app.document_changed(state)
  done("group moved", group)
}

// ---------------------------------------------------------------------------
// Transitions, fades, keyframes, markers, subtitles

pub fn add_transition(state: ref<app.App>, track: u64, centre: i64, duration: i64,
                      kind: str) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let id: u64 = editor.add_transition(struct.borrow(state, field=document), track, centre,
    duration, kind)
  app.document_changed(state)
  done("transition added", id)
}
pub fn set_transition_duration(state: ref<app.App>, transition: u64, duration: i64) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.set_transition_duration(struct.borrow(state, field=document), transition, duration) {
    return refused("no such transition")
  }
  app.document_changed(state)
  done("transition resized", transition)
}
pub fn remove_transition(state: ref<app.App>, transition: u64) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.remove_transition(struct.borrow(state, field=document), transition) {
    return refused("no such transition")
  }
  app.document_changed(state)
  done("transition removed", transition)
}

pub fn set_fades(state: ref<app.App>, clip: u64, fade_in: i64, fade_out: i64) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.set_fade_in(struct.borrow(state, field=document), clip, fade_in) {
    return refused("no such clip")
  }
  let _ = editor.set_fade_out(struct.borrow(state, field=document), clip, fade_out)
  app.document_changed(state)
  done("fades set", clip)
}

pub fn set_key(state: ref<app.App>, clip: u64, param: str, frame: i64, value: f64,
               interp: u32) -> Result effects {alloc} {
  if paired_speed_key(struct.borrow(state,field=document),clip,param) {return refused("[GA_LINKED_SPEED] Linked rate automation must be edited on both streams together")}
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.set_key(struct.borrow(state, field=document), clip, param, frame, value, interp) {
    return refused("that parameter could not be keyed")
  }
  app.document_changed(state)
  done("keyframe set", clip)
}

pub fn add_marker(state: ref<app.App>, frame: i64, label: str) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let sequence: u64 = struct.get(struct.borrow(state, field=document), field=active)
  let id: u64 = editor.add_marker(struct.borrow(state, field=document), sequence, frame, label, 2)
  app.document_changed(state)
  done("marker added", id)
}

pub fn add_subtitle(state: ref<app.App>, start: i64, finish: i64, text: str) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let sequence: u64 = struct.get(struct.borrow(state, field=document), field=active)
  match editor.add_subtitle(struct.borrow(state, field=document), sequence, start, finish, text) {
    some(id) => { app.document_changed(state)
      done("subtitle added", id) },
    none => refused("a subtitle needs a positive span"),
  }
}

// ---------------------------------------------------------------------------
// Filters

// Linked rate filters/curves need a correspondence between their two instances.
// Refuse unsupported edits before either stream, history or revision can change.
fn paired_speed_filter(doc:ref<editor.Document>,id:u64) -> bool effects {alloc} {
  let slot:u64=match editor.filter_slot(doc,id) {none=>{return false},some(found)=>found,}
  let clip:u64=struct.get(array.borrow(struct.borrow(doc,field=filters),slot),field=clip)
  str.eq(editor.filter_kind(doc,id),"speed") and linked_media.mate(doc,clip)!=0
}
fn paired_speed_key(doc:ref<editor.Document>,clip:u64,param:str) -> bool effects {alloc} {
  if linked_media.mate(doc,clip)==0 {return false}
  let canonical:string=filter_keys.canonical(param)
  str.eq(canonical,"speed") or str.starts_with(canonical,"speed.")
}
pub fn add_filter(state: ref<app.App>, clip: u64, kind: str) -> Result effects {alloc} {
  if str.eq(kind,"speed") and linked_media.mate(struct.borrow(state,field=document),clip)!=0 {return refused("[GA_LINKED_SPEED] Linked rate filters cannot be edited independently")}
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  match editor.add_filter(struct.borrow(state, field=document), clip, kind) {
    some(id) => { app.set_selected_filter(state, id)
      app.document_changed(state)
      done("filter added", id) },
    none => refused("no such clip"),
  }
}
pub fn remove_filter(state: ref<app.App>, filter: u64) -> Result effects {alloc} {
  if paired_speed_filter(struct.borrow(state,field=document),filter) {return refused("[GA_LINKED_SPEED] Linked rate filters cannot be edited independently")}
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.remove_filter(struct.borrow(state, field=document), filter) {
    return refused("no such filter")
  }
  if app.selected_filter(state) == filter { app.set_selected_filter(state, 0) }
  app.document_changed(state)
  done("filter removed", filter)
}
pub fn toggle_filter(state: ref<app.App>, filter: u64) -> Result effects {alloc} {
  if paired_speed_filter(struct.borrow(state,field=document),filter) {return refused("[GA_LINKED_SPEED] Linked rate filters cannot be edited independently")}
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let now: bool = editor.filter_enabled(struct.borrow(state, field=document), filter)
  if not editor.set_filter_enabled(struct.borrow(state, field=document), filter, not now) {
    return refused("no such filter")
  }
  app.document_changed(state)
  done(if now { "filter disabled" } else { "filter enabled" }, filter)
}
pub fn reorder_filter(state: ref<app.App>, filter: u64, position: u32) -> Result effects {alloc} {
  if paired_speed_filter(struct.borrow(state,field=document),filter) {return refused("[GA_LINKED_SPEED] Linked rate filters cannot be edited independently")}
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.reorder_filter(struct.borrow(state, field=document), filter, position) {
    return refused("no such filter")
  }
  app.document_changed(state)
  done("filter reordered", filter)
}
pub fn set_filter_param(state: ref<app.App>, filter: u64, name: str, value: f64) -> Result effects {alloc} {
  if paired_speed_filter(struct.borrow(state,field=document),filter) {return refused("[GA_LINKED_SPEED] Linked rate filters cannot be edited independently")}
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.set_filter_param(struct.borrow(state, field=document), filter, name, value) {
    return refused("no such filter")
  }
  app.document_changed(state)
  done("parameter set", filter)
}

pub fn set_filter_text_param(state: ref<app.App>, filter: u64, name: str, value: str)
                             -> Result effects {alloc} {
  if paired_speed_filter(struct.borrow(state,field=document),filter) {return refused("[GA_LINKED_SPEED] Linked rate filters cannot be edited independently")}
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.set_filter_text_param(struct.borrow(state, field=document), filter,
    name, value) { return refused("no such filter") }
  app.document_changed(state)
  done("text parameter set", filter)
}

// ---------------------------------------------------------------------------
// Mixer. Solo-wins is the toolkit's policy and is not restated here.

pub fn set_track_gain(state: ref<app.App>, track: u64, value: f64) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.set_track_gain(struct.borrow(state, field=document), track, value) {
    return refused("no such track")
  }
  app.document_changed(state)
  done("gain set", track)
}
pub fn set_track_pan(state: ref<app.App>, track: u64, value: f64) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.set_track_pan(struct.borrow(state, field=document), track, value) {
    return refused("no such track")
  }
  app.document_changed(state)
  done("pan set", track)
}
pub fn toggle_mute(state: ref<app.App>, track: u64) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let now: bool = not editor.track_audible(struct.borrow(state, field=document), track)
  if not editor.set_track_muted(struct.borrow(state, field=document), track, not now) {
    return refused("no such track")
  }
  app.document_changed(state)
  done("mute toggled", track)
}
pub fn toggle_solo(state: ref<app.App>, track: u64) -> Result effects {alloc} {
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  var now: bool = false
  match editor.track_slot(document, track) {
    some(slot) => { now = struct.get(array.borrow(struct.borrow(document, field=tracks), slot), field=solo) },
    none => { return refused("no such track") },
  }
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let _ = editor.set_track_solo(struct.borrow(state, field=document), track, not now)
  app.document_changed(state)
  done("solo toggled", track)
}
pub fn toggle_track_lock(state: ref<app.App>, track: u64) -> Result effects {alloc} {
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  var now: bool = false
  match editor.track_slot(document, track) {
    some(slot) => { now = struct.get(array.borrow(struct.borrow(document, field=tracks), slot), field=locked) },
    none => { return refused("no such track") },
  }
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let _ = editor.set_track_lock(struct.borrow(state, field=document), track, not now)
  app.document_changed(state)
  done("lock toggled", track)
}

// ---------------------------------------------------------------------------
// Transport. The two transports are independent, which is the toolkit's model.

fn marks_change(current: editor.Transport, action: u32) -> bool effects {} {
  if action == editor.mark_in() {return current.mark_in != current.frame}
  if action == editor.mark_out() {return current.mark_out != current.frame}
  if action == editor.clear_marks() {return current.mark_in != -1 or current.mark_out != -1}
  false
}
pub fn program(state: ref<app.App>, action: u32) -> Result effects {alloc} {
  let marks: bool = marks_change(struct.get(struct.borrow(state,field=document),field=program),action)
  if marks {editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))}
  let landed: editor.Transport = editor.program_action(struct.borrow(state, field=document), action)
  if marks {app.document_changed(state)}
  done("program transport", cast.wrap(landed.frame))
}
pub fn seek(state: ref<app.App>, frame: i64) -> Result effects {alloc} {
  let landed: i64 = editor.seek(struct.borrow(state, field=document), frame)
  done("sought", cast.wrap(landed))
}
pub fn open_source(state: ref<app.App>, source: u64) -> Result effects {alloc} {
  if not editor.open_source(struct.borrow(state, field=document), source) {
    return refused("no such source")
  }
  done("source opened", source)
}
// Reload also restarts the media worker: a fresh one drops its cached decoders and LUTs,
// so a file changed on disk is read again.
pub fn reload_source(state: ref<app.App>, source: u64) -> Result effects {alloc, process, time} {
  provider.restart(struct.borrow(state, field=provider))
  app.mark_media_changed(state)
  open_source(state, source)
}
pub fn monitor(state: ref<app.App>, action: u32) -> Result effects {alloc} {
  let marks: bool = marks_change(struct.get(struct.borrow(state,field=document),field=monitor),action)
  if marks {editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))}
  let landed: editor.Transport = editor.monitor_action(struct.borrow(state, field=document), action)
  if marks {app.document_changed(state)}
  done("source transport", cast.wrap(landed.frame))
}
pub fn set_project_range(state: ref<app.App>, start: i64, finish: i64) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  if not editor.set_export_range(struct.borrow(state, field=document), start, finish) {
    return refused("that range is inverted")
  }
  app.document_changed(state)
  done("range set", 0)
}

// ---------------------------------------------------------------------------
// Undo and redo

pub fn undo(state: ref<app.App>) -> Result effects {alloc} {
  if not editor.undo(struct.borrow(state, field=history), struct.borrow(state, field=document)) {
    return refused("nothing to undo")
  }
  app.document_changed(state)
  app.set_status(state, "Undone")
  done("undone", 0)
}
pub fn redo(state: ref<app.App>) -> Result effects {alloc} {
  if not editor.redo(struct.borrow(state, field=history), struct.borrow(state, field=document)) {
    return refused("nothing to redo")
  }
  app.document_changed(state)
  app.set_status(state, "Redone")
  done("redone", 0)
}

// ---------------------------------------------------------------------------
// Generic parameter writes.
//
// The inspector shows a parameter whether or not the filter carrying it exists yet, so
// writing one may have to materialise the filter first. That is the only "arithmetic" here
// and it is bookkeeping, not editing: the value itself is stored by `std.editor`.

pub fn ensure_filter(state: ref<app.App>, clip: u64, kind: str) -> Result effects {alloc} {
  if clip == 0 { return refused("no clip selected") }
  let existing: u64 = chrome_filter_of_kind(state, clip, kind)
  if existing != 0 { return done("filter present", existing) }
  add_filter(state, clip, kind)
}

// Kept here rather than imported from the chrome module so the command layer does not
// depend on the view; it is the same three-line scan.
fn chrome_filter_of_kind(state: ref<app.App>, clip: u64, kind: str) -> u64 effects {alloc} {
  filter_of_kind(struct.borrow(state,field=document),clip,kind)
}
fn filter_of_kind(doc:ref<editor.Document>,clip:u64,kind:str) -> u64 effects {alloc} {
  let count: u64 = editor.filter_count(doc, clip)
  var position: u32 = 0
  loop {
    let seen: u64 = cast.wrap(position)
    if seen >= count { break }
    match editor.filter_at(doc, clip, position) {
      some(id) => {
        let owned: string = editor.filter_kind(doc, id)
        if str.eq(str.view(owned), kind) { return id }
      },
      none => { },
    }
    position = position + 1
  }
  0
}

fn fade_field(name: str) -> bool effects {} {name == "fade_in" or name == "fade_out"}

// Refusal must precede capture, name interning, and a pointer drag's first write.
// Validate existing curves too: an edit cannot silently repair or extend a
// malformed envelope which the audio worker will refuse.
fn fade_problem(state: ref<app.App>, clip: u64, name: str, value: f64, key: bool)
    -> option<string> effects {alloc} {
  if not fade_field(name) {return option.none()}
  let current: u64 = app.current_clip(state)
  let doc: ref<editor.Document> = struct.borrow(state,field=document)
  let selected: editor.Clip = match editor.clip(doc,clip) {
    none=>{return option.some(string.copy("[GA_KEY_TARGET] Fade target no longer exists"))},some(found)=>found,
  }
  if not math.is_finite(value) or value < 0.0 or value > 3.4028234663852886e38 {
    return option.some(string.copy("[GA_AUDIO_FADE_KEYS] Fade length must be finite and nonnegative"))
  }
  if not key and not filter_keys.has(doc,clip,name) {return option.none()}
  if clip != current {
    return option.some(string.copy("[GA_KEY_TARGET] Fade target is not the selected clip"))
  }
  let fps: f64 = editor.sequence_fps(doc,selected.owner)
  if selected.owner != doc.active or not math.is_finite(fps) or fps <= 0.0 or
      not math.is_finite(3.4028234663852886e38/fps) or not math.is_finite(value/fps) {
    return option.some(string.copy("[GA_AUDIO_FADE_KEYS] Fade keys require an active clip with a valid frame rate"))
  }
  let playhead: i64 = editor.playhead(doc)
  if playhead < selected.start or playhead >= editor.clip_end(selected) {
    return option.some(string.copy("[GA_KEY_RANGE] Playhead is outside the keyed fade clip"))
  }
  let origin: f64 = math.floor(cast.float(playhead)*48000.0/fps+0.5)
  let placement: f64 = math.floor(cast.float(selected.start)*48000.0/fps+0.5)
  let local: i64 = playhead-selected.start
  let local_frame: f64 = cast.float(local)
  if not math.is_finite(origin) or origin < 0.0 or origin > 9007199254740991.0 or
      local_frame > 9007199254740991.0 or selected.start < 0 or selected.start > 9007199254740991 or
      playhead > 9007199254740991 or not math.is_finite(placement) or placement > 9007199254740991.0 {
    return option.some(string.copy("[GA_AUDIO_FADE_KEYS] Fade sample position exceeds the supported range"))
  }
  var curve_index: u64 = 0
  loop {if curve_index == 2 {break}
    let curve_name: string = if curve_index == 0 {string.copy(name)}else{if name == "fade_in" {string.copy("fade_out")}else{string.copy("fade_in")}}
    var previous_frame: i64 = 0
    var previous_sample: f64 = 0.0
    var count: u64 = 0
    var replaces: bool = false
    var index: u64 = 0
    loop {if index >= array.len(struct.borrow(doc,field=keys)) {break}
      let point: editor.Key = array.get(struct.borrow(doc,field=keys),index)
      index=index+1
      if point.clip != clip or editor.name_text(doc,point.param) != curve_name {continue}
      let absolute_frame: f64 = cast.float(selected.start)+cast.float(point.frame)
      let sample: f64 = math.floor(absolute_frame*48000.0/fps+0.5)
      if point.owner != selected.owner or not math.is_finite(point.value) or
          math.abs(point.value) > 3.4028234663852886e38 or not math.is_finite(point.value/fps) or point.interp >= 38 or
          math.abs(cast.float(point.frame)) > 9007199254740991.0 or math.abs(absolute_frame) > 9007199254740991.0 or
          not math.is_finite(sample) or math.abs(sample) > 9007199254740991.0 or count >= 65536 or
          (count != 0 and (point.frame <= previous_frame or sample <= previous_sample)) or
          (curve_index == 0 and point.frame != local and sample == origin) {
        return option.some(string.copy("[GA_AUDIO_FADE_KEYS] Existing fade curve is invalid"))
      }
      previous_frame=point.frame
      previous_sample=sample
      if point.frame == local {replaces=true}
      count=count+1
    }
    if curve_index == 0 and count == 65536 and not replaces {
      return option.some(string.copy("[GA_AUDIO_FADE_KEYS] Fade curve has reached the supported key count"))
    }
    curve_index=curve_index+1
  }
  option.none()
}

pub fn set_clip_field(state: ref<app.App>, clip: u64, name: str, value: f64) -> Result effects {alloc} {
  match fade_problem(state,clip,name,value,false) {none=>{},some(problem)=>{return refused(problem)},}
  var candidate:editor.Document=editor.copy_document(struct.borrow(state,field=document))
  let outcome:Result=set_clip_field_document(candidate,clip,name,value)
  if not outcome.ok {return outcome}
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  outcome
}

fn write_fade_key(doc: ref<editor.Document>, clip: u64, name: str, value: f64) -> bool effects {alloc} {
  let selected: editor.Clip = option.unwrap(editor.clip(doc,clip))
  let frame: i64 = editor.playhead(doc)-selected.start
  let interp: u32 = parameter_key_interp(doc,clip,name,frame)
  editor.set_key(doc,clip,name,frame,value,interp)
}

fn set_clip_field_live(state:ref<app.App>,clip:u64,name:str,value:f64) -> Result effects {alloc} {
  match fade_problem(state,clip,name,value,false) {none=>{},some(problem)=>{return refused(problem)},}
  var candidate:editor.Document=editor.copy_document(struct.borrow(state,field=document))
  let outcome:Result=set_clip_field_document(candidate,clip,name,value)
  if not outcome.ok {return outcome}
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  outcome
}
fn set_speed_document(doc:ref<editor.Document>,clip:u64,value:f64) -> Result effects {alloc} {
  let old:editor.Clip=match editor.clip(doc,clip) {none=>{return refused("no such clip")},some(found)=>found,}
  let peer:u64=linked_media.mate(doc,clip)
  if not math.is_finite(value) or value<0.0 {return refused("[GA_LINKED_SPEED] Speed must be finite and nonnegative")}
  if editor.track_locked(doc,old.track) {return refused("[GA_EDIT_LOCKED] Track is locked")}
  if peer!=0 {
    let other:editor.Clip=option.unwrap(editor.clip(doc,peer))
    if editor.track_locked(doc,other.track) {return refused("[GA_LINKED_LOCKED] Linked stream is locked")}
  }
  if not editor.set_clip_speed(doc,clip,value) {return refused("Speed cannot be set")}
  if peer!=0 and not editor.set_clip_speed(doc,peer,value) {return refused("[GA_LINKED_SPEED] Linked speed cannot be set")}
  if not linked_geometry(doc,clip,peer) {return refused("[GA_LINKED_SPEED] Linked rates differ")}
  done("clip property set",clip)
}
fn set_clip_field_document(doc:ref<editor.Document>,clip:u64,name:str,value:f64) -> Result effects {alloc} {
  if fade_field(name) and filter_keys.has(doc,clip,name) {
    if not write_fade_key(doc,clip,name,value) {
      return refused("[GA_AUDIO_FADE_KEYS] Fade length could not be keyed")
    }
    return done("fade keyframe set",clip)
  }
  if str.eq(name, "gain") {
    if not math.is_finite(value) or value < 0.0 {
      return refused("[GA_AUDIO_GAIN_KEYS] Gain must be finite and nonnegative")
    }
    if editor.key_count(doc, clip, "gain") > 0 {
      let selected: editor.Clip = match editor.clip(doc, clip) {
        none => { return refused("no clip selected") }, some(found) => found,
      }
      let frame: i64 = editor.playhead(doc) - selected.start
      if frame < 0 or frame >= selected.length { return refused("playhead is outside the clip") }
      let interp: u32 = gain_key_interp(doc, clip, frame)
      let _ = editor.set_key(doc, clip, "gain", frame, value, interp)
        return done("gain keyframe set", clip)
    }
  }
  if str.eq(name,"speed") {return set_speed_document(doc,clip,value)}
  let frames: i64 = cast.sat(value)
  let ok: bool = if str.eq(name, "fade_in") {
      editor.set_fade_in(doc, clip, frames)
    } else if str.eq(name, "fade_out") {
      editor.set_fade_out(doc, clip, frames)
    } else if str.eq(name, "gain") {
      editor.set_clip_gain(doc, clip, value)
    } else if str.eq(name, "pan") {
      editor.set_clip_pan(doc, clip, value)
    } else if str.eq(name, "speed") {
      editor.set_clip_speed(doc, clip, value)
    } else { false }
  if not ok { return refused("that clip property is not settable") }
  done("clip property set", clip)
}

// Reverse is a flag, not a value, so it toggles rather than being set to a number.
pub fn toggle_clip_reverse(state:ref<app.App>,clip:u64) -> Result effects {alloc} {
  let doc:ref<editor.Document> =struct.borrow(state,field=document)
  let old:editor.Clip=match editor.clip(doc,clip) {none=>{return refused("no clip selected")},some(found)=>found,}
  let peer:u64=linked_media.mate(doc,clip)
  if editor.track_locked(doc,old.track) {return refused("[GA_EDIT_LOCKED] Track is locked")}
  if peer!=0 {
    let other:editor.Clip=option.unwrap(editor.clip(doc,peer))
    if editor.track_locked(doc,other.track) {return refused("[GA_LINKED_LOCKED] Linked stream is locked")}
  }
  var candidate:editor.Document=editor.copy_document(doc)
  if not editor.set_clip_reverse(candidate,clip,not old.reverse) {return refused("no such clip")}
  if peer!=0 and not editor.set_clip_reverse(candidate,peer,not old.reverse) {return refused("[GA_LINKED_REVERSE] Linked reverse cannot be set")}
  if not linked_geometry(candidate,clip,peer) {return refused("[GA_LINKED_REVERSE] Linked directions differ")}
  if not linked_document_geometry(doc,candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),doc)
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done(if old.reverse {"playing forward"}else{"playing in reverse"},clip)
}

pub fn set_track_field(state: ref<app.App>, track: u64, name: str, value: f64) -> Result effects {alloc} {
  if str.eq(name, "gain") { return set_track_gain(state, track, value) }
  if str.eq(name, "pan") { return set_track_pan(state, track, value) }
  refused("that track property is not settable")
}

// One entry point for every inspector control: the domain says what is being written.
pub fn set_parameter(state:ref<app.App>,domain:u32,target:u64,kind:str,name:str,value:f64) -> Result effects {alloc} {
  if domain==1 {return set_clip_field(state,target,name,value)}
  if domain!=2 and domain!=3 {return refused("nothing to set")}
  let clip:u64=if linked_media.is_audio_kind(kind) {app.current_audio_clip(state)}else{app.current_clip(state)}
  if domain==2 and target==0 and clip==0 {return refused("[GA_INSPECTOR_SELECTION] Select a timeline clip first")}
  var candidate:editor.Document=editor.copy_document(struct.borrow(state,field=document))
  var filter:u64=target
  if domain==2 and filter==0 {
    if str.eq(kind,"speed") and linked_media.mate(candidate,clip)!=0 {return refused("[GA_LINKED_SPEED] Linked rate filters cannot be edited independently")}
    filter=filter_of_kind(candidate,clip,kind)
    if filter==0 {filter=match editor.add_filter(candidate,clip,kind) {none=>{return refused("no such clip")},some(id)=>id,}}
  }
  let outcome:Result=update_parameter_document(candidate,domain,filter,name,value)
  if not outcome.ok {return outcome}
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  outcome
}

// Continuation of a pointer drag. The initial write owns the single undo snapshot.
pub fn update_parameter(state:ref<app.App>,domain:u32,target:u64,name:str,value:f64) -> Result effects {alloc} {
  if domain==1 {return set_clip_field_live(state,target,name,value)}
  var candidate:editor.Document=editor.copy_document(struct.borrow(state,field=document))
  let outcome:Result=update_parameter_document(candidate,domain,target,name,value)
  if outcome.ok {
    if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
    let _=struct.replace(state,candidate,field=document)
    app.document_changed(state)}
  outcome
}

fn update_parameter_document(doc: ref<editor.Document>, domain: u32, target: u64, name: str,
                             value: f64) -> Result effects {alloc} {
  if domain == 2 {
    if paired_speed_filter(doc,target) {return refused("[GA_LINKED_SPEED] Linked rate filters cannot be edited independently")}
    let slot: u64 = match editor.filter_slot(doc, target) {
      none => { return refused("that filter is missing") }, some(found) => found,
    }
    let clip: u64 = struct.get(array.borrow(struct.borrow(doc, field=filters), slot), field=clip)
    let kind: string = editor.filter_kind(doc, target)
    let qualified: string = filter_keys.name(target,str.view(kind),name)
    let old: string = filter_keys.legacy(str.view(kind),name)
    if filter_keys.has(doc,clip,str.view(qualified)) or filter_keys.has(doc,clip,str.view(old)) {
      let selected: editor.Clip = match editor.clip(doc, clip) {
        none => { return refused("selected clip is missing") }, some(found) => found,
      }
      let frame: i64 = editor.playhead(doc) - selected.start
      if frame < 0 or frame >= selected.length { return refused("[GA_VIDEO_KEY_RANGE] Playhead is outside the keyed clip") }
      if not math.is_finite(value) { return refused("[GA_VIDEO_KEY_VALUE] Key value must be finite") }
      if not timeline_media.key_supported(str.view(qualified)) { return refused("[GA_KEY_UNSUPPORTED] This parameter has no keyframed media behavior yet") }
      if not timeline_media.key_layer_supported(doc,selected,str.view(kind),editor.playhead(doc)) {
        return refused("[GA_KEY_LAYER] This effect needs an upper clip over a lower picture and cannot key a transition side")
      }
      filter_keys.migrate(doc,clip,target,str.view(kind),name)
      let interp: u32 = parameter_key_interp(doc, clip, str.view(qualified), frame)
      if not editor.set_key(doc, clip, str.view(qualified), frame, value, interp) {
        return refused("[GA_VIDEO_KEY_WRITE] That parameter could not be keyed")
      }
      return done("parameter keyframe set", target)
    }
  }
  let changed: bool = if domain == 2 { editor.set_filter_param(doc, target, name, value) }
    else if domain == 3 and str.eq(name, "gain") { editor.set_track_gain(doc, target, value) }
    else if domain == 3 and str.eq(name, "pan") { editor.set_track_pan(doc, target, value) }
    else { false }
  if not changed { return refused("that parameter is not settable") }
  done("parameter set", target)
}

// A keyframe on the parameter under the pointer, at the playhead. Clip-local frames are the
// toolkit's contract, so the value is handed over as-is.
fn gain_key_interp(doc: ref<editor.Document>, clip: u64, frame: i64) -> u32 effects {alloc} {
  parameter_key_interp(doc, clip, "gain", frame)
}

fn parameter_key_interp(doc: ref<editor.Document>, clip: u64, param: str, frame: i64) -> u32 effects {alloc} {
  let named: u64 = editor.name_id(doc, param)
  var i: u64 = 0
  loop { if i >= array.len(struct.borrow(doc, field=keys)) { break }
    let key: editor.Key = array.get(struct.borrow(doc, field=keys), i)
    if key.clip == clip and key.param == named and key.frame == frame { return key.interp }
    i = i + 1
  }
  let canonical: string = filter_keys.canonical(param)
  if str.eq(str.view(canonical),"blend.mode") { curve.hold() } else { curve.linear() }
}

pub fn keyframe_parameter(state:ref<app.App>,domain:u32,target:u64,kind:str,name:str,value:f64) -> Result effects {alloc} {
  if domain==1 and str.len(kind)==0 and fade_field(name) {
    match fade_problem(state,target,name,value,true) {none=>{},some(problem)=>{return refused(problem)},}
  }
  let audio:bool=linked_media.is_audio_kind(kind) or (domain==1 and (str.eq(name,"gain") or str.eq(name,"pan")))
  let clip:u64=if audio {app.current_audio_clip(state)}else{app.current_clip(state)}
  if clip==0 {return refused("no clip selected")}
  var candidate:editor.Document=editor.copy_document(struct.borrow(state,field=document))
  if str.eq(kind,"speed") and linked_media.mate(candidate,clip)!=0 {return refused("[GA_LINKED_SPEED] Linked rate automation cannot be edited independently")}
  if domain==1 and paired_speed_key(candidate,clip,name) {return refused("[GA_LINKED_SPEED] Linked rate automation cannot be edited independently")}
  let outcome:Result=keyframe_document(candidate,clip,domain,target,kind,name,value)
  if not outcome.ok {return outcome}
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  outcome
}
fn keyframe_document(doc:ref<editor.Document>,clip:u64,domain:u32,target:u64,kind:str,name:str,value:f64) -> Result effects {alloc} {
  let playhead: i64 = editor.playhead(doc)
  let selected: editor.Clip = match editor.clip(doc, clip) {
    none => { return refused("selected clip is missing") }, some(found) => found,
  }
  let frame: i64 = playhead - selected.start
  if frame < 0 or frame >= selected.length { return refused("playhead is outside the clip") }
  if domain == 1 and target != clip { return refused("[GA_KEY_TARGET] Key target no longer matches the selected clip") }
  if domain == 2 and target != 0 {
    let slot: u64 = match editor.filter_slot(doc,target) {
      none=>{return refused("[GA_KEY_TARGET] That filter no longer exists")},some(found)=>found,
    }
    let owner: u64 = struct.get(array.borrow(struct.borrow(doc,field=filters),slot),field=clip)
    let family: string = editor.filter_kind(doc,target)
    if owner != clip or not str.eq(str.view(family),kind) {
      return refused("[GA_KEY_TARGET] Key target no longer matches the selected filter")
    }
  }
  var qualified: string = string.copy(kind)
  if str.len(kind) != 0 { string.append(qualified, ".") }
  string.append(qualified, name)
  let audio_gain: bool = domain == 1 and str.eq(str.view(qualified), "gain")
  let clip_fade: bool = domain == 1 and str.len(kind) == 0 and fade_field(name)
  if audio_gain and (not math.is_finite(value) or value < 0.0) {
    return refused("[GA_AUDIO_GAIN_KEYS] Gain must be finite and nonnegative")
  }
  if not timeline_media.key_supported(str.view(qualified)) or
     (not audio_gain and not clip_fade and editor.track_kind(doc, selected.track) !=
       editor.track_video()) or (domain == 1 and str.len(kind) != 0) or
     (domain == 2 and str.len(kind) == 0) or (domain != 1 and domain != 2) {
    return refused("[GA_KEY_UNSUPPORTED] This parameter has no keyframed media behavior yet")
  }
  if not math.is_finite(value) { return refused("[GA_VIDEO_KEY_VALUE] Key value must be finite") }
  if domain == 2 and not timeline_media.key_layer_supported(doc,selected,kind,playhead) {
    return refused("[GA_KEY_LAYER] This effect needs an upper clip over a lower picture and cannot key a transition side")
  }
  // K on a parameter row can precede the first ordinary parameter edit. Create
  // its filter along with the key so one Undo removes both changes.
  if domain == 2 {
    var instance: u64 = if target == 0 {filter_of_kind(doc,clip,kind)}else{target}
    if instance == 0 {
      match editor.add_filter(doc, clip, kind) {
        none => { return refused("the filter could not be created") },
        some(id) => {instance=id},
      }
    }
    filter_keys.migrate(doc,clip,instance,kind,name)
    let _ = ref.swap(qualified,filter_keys.name(instance,kind,name))
  }
  let interp: u32 = parameter_key_interp(doc, clip,
    str.view(qualified), frame)
  if not editor.set_key(doc, clip,
                        str.view(qualified), frame, value, interp) {
    return refused("that parameter could not be keyed")
  }
  done("keyframe set", clip)
}

// Existing-key management shares target validation with the inspector writer.
// operation: 0 previous, 1 next, 2 delete, 3 interpolation.
pub fn manage_key(state: ref<app.App>, domain: u32, target: u64, kind: str,
                  name: str, operation: u32, mode: u32) -> Result effects {alloc} {
  if operation >= 2 and domain == 1 and fade_field(name) {
    match fade_problem(state,target,name,0.0,true) {none=>{},some(problem)=>{return refused(problem)},}
  }
  let audio: bool = linked_media.is_audio_kind(kind) or (domain == 1 and str.eq(name,"gain"))
  let clip: u64 = if audio {app.current_audio_clip(state)}else{app.current_clip(state)}
  let doc: ref<editor.Document> = struct.borrow(state,field=document)
  let selected: editor.Clip = match editor.clip(doc,clip) {
    none=>{return refused("[GA_KEY_TARGET] No valid clip selected")},some(found)=>found,
  }
  if selected.owner != doc.active or (domain != 1 and domain != 2) {
    return refused("[GA_KEY_TARGET] Key target is outside the active sequence")
  }
  if domain == 1 and (target != clip or str.len(kind) != 0) {
    return refused("[GA_KEY_TARGET] Key target no longer matches the selected clip")
  }
  if domain == 2 {
    let slot: u64 = match editor.filter_slot(doc,target) {
      none=>{return refused("[GA_KEY_TARGET] That filter no longer exists")},some(value)=>value,
    }
    let owner: u64 = struct.get(array.borrow(struct.borrow(doc,field=filters),slot),field=clip)
    if owner != clip or editor.filter_kind(doc,target) != kind {
      return refused("[GA_KEY_TARGET] Key target no longer matches the selected filter")
    }
  }
  let canonical: string = if domain == 1 {string.copy(name)}else{filter_keys.legacy(kind,name)}
  let fade: bool = domain == 1 and fade_field(name)
  let gain: bool = domain == 1 and str.eq(name,"gain")
  if not timeline_media.key_supported(str.view(canonical)) or
      (not fade and not gain and editor.track_kind(doc,selected.track) != editor.track_video()) {
    return refused("[GA_KEY_UNSUPPORTED] This parameter has no keyframed media behavior yet")
  }
  if operation > 3 {return refused("[GA_KEY_ACTION] Unknown keyframe action")}
  let named: string = filter_keys.curve_name(doc,clip,if domain == 2 {target}else{0},kind,name)
  let local: i64 = editor.playhead(doc)-selected.start
  if operation < 2 {
    let at: i64 = match filter_keys.neighbor(doc,clip,str.view(named),local,selected.length,operation == 1) {
      none=>{return refused("[GA_KEY_MISSING] No key in that direction")},some(value)=>value,
    }
    let _=editor.program_action(doc,editor.pause())
    let _=editor.monitor_action(doc,editor.pause())
    let _=editor.seek(doc,selected.start+at)
    return done("sought keyframe",clip)
  }
  if editor.track_locked(doc,selected.track) {return refused("[GA_EDIT_LOCKED] Track is locked")}
  if local < 0 or local >= selected.length {return refused("[GA_KEY_RANGE] Playhead is outside the clip")}
  let point: editor.Key = match filter_keys.exact(doc,clip,str.view(named),local) {
    none=>{return refused("[GA_KEY_MISSING] There is no key at the playhead")},some(value)=>value,
  }
  if point.owner != selected.owner or not math.is_finite(point.value) or point.interp >= curve.interp_count() {
    return refused("[GA_KEY_VALUE] Existing key is invalid")
  }
  if operation == 3 and gain and (point.value < 0.0 or point.value > 3.4028234663852886e38) {
    return refused("[GA_AUDIO_GAIN_KEYS] Gain must be finite and nonnegative within the supported sample range")
  }
  if operation == 3 and (mode >= curve.interp_count() or (canonical == "blend.mode" and mode != curve.hold())) {
    return refused("[GA_KEY_INTERPOLATION] This interpolation is not supported by the parameter")
  }
  if operation == 3 and mode == point.interp {return done("keyframe unchanged",clip)}
  if (str.eq(kind,"speed") or (domain == 1 and paired_speed_key(doc,clip,name))) and linked_media.mate(doc,clip) != 0 {
    return refused("[GA_LINKED_SPEED] Linked rate automation cannot be edited independently")
  }
  var candidate: editor.Document = editor.copy_document(doc)
  var edited: string = string.copy(str.view(named))
  if domain == 2 {
    if operation == 2 {filter_keys.materialize_family(candidate,clip,kind,name)}
    else {filter_keys.migrate(candidate,clip,target,kind,name)}
    let _=ref.swap(edited,filter_keys.name(target,kind,name))
  }
  let changed: bool = if operation == 2 {editor.remove_key(candidate,clip,str.view(edited),local)}
    else {editor.set_key(candidate,clip,str.view(edited),local,point.value,mode)}
  if not changed {return refused("[GA_KEY_WRITE] The key could not be changed")}
  if not linked_document_geometry(doc,candidate) {return refused("[GA_LINKED_RANGE] Key edit cannot preserve linked ranges")}
  editor.capture(struct.borrow(state,field=history),doc)
  let _=struct.replace(state,candidate,field=document)
  app.document_changed(state)
  done(if operation == 2 {"keyframe deleted"}else{"keyframe interpolation set"},clip)
}

// ---------------------------------------------------------------------------
// Clipboard snapshots retain the complete authored clip independently of its
// original. Project replacement retires document resource identities.

pub fn copy_clip(state: ref<app.App>, clip: u64) -> Result effects {alloc} {
  match editor.clip_snapshot(struct.borrow(state, field=document), clip) {
    none => refused("[GA_CLIPBOARD_COPY] No valid clip selected"),
    some(value) => {
      let doc:ref<editor.Document> = struct.borrow(state,field=document)
      let peer:u64=linked_media.mate(doc,clip)
      if peer!=0 {match editor.clip_snapshot(doc,peer) {none=>{return refused("[GA_CLIPBOARD_COPY] Linked stream content is invalid")},some(_)=>{},}}
      let paired:option<editor.ClipSnapshot> = if peer==0 {option.none()} else {editor.clip_snapshot(doc,peer)}
      app.set_clipboard(state,value)
      let _=struct.replace(state,paired,field=clipboard_peer)
      done("copied", clip) },
  }
}

pub fn cut_clip(state:ref<app.App>,clip:u64) -> Result effects {alloc} {
  let doc:ref<editor.Document> = struct.borrow(state,field=document)
  let saved:editor.ClipSnapshot=match editor.clip_snapshot(doc,clip) {none=>{return refused("[GA_CLIPBOARD_CUT] Clip content is invalid")},some(value)=>value,}
  let peer:u64=linked_media.mate(doc,clip)
  if peer!=0 {match editor.clip_snapshot(doc,peer) {none=>{return refused("[GA_CLIPBOARD_CUT] Linked stream content is invalid")},some(_)=>{},}}
  let paired:option<editor.ClipSnapshot> = if peer==0 {option.none()} else {editor.clip_snapshot(doc,peer)}
  var candidate:editor.Document=editor.copy_document(doc)
  if not editor.ripple_delete(candidate,clip) {return refused("[GA_CLIPBOARD_CUT] Clip could not be removed")}
  if peer!=0 and not editor.ripple_delete(candidate,peer) {return refused("[GA_LINKED_LOCKED] Linked stream could not be removed")}
  if not linked_document_geometry(doc,candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),doc)
  let _=struct.replace(state,candidate,field=document)
  app.set_clipboard(state,saved)
  let _=struct.replace(state,paired,field=clipboard_peer)
  app.document_changed(state)
  done("cut",clip)
}

pub fn paste_clip(state: ref<app.App>, track: u64, at: i64) -> Result effects {alloc} {
  if not app.clipboard_identity_valid(state) {
    match struct.borrow(state,field=clipboard) {
      none=>{return refused("[GA_CLIPBOARD_EMPTY] Clipboard is empty")},
      some(_)=>{return refused("[GA_CLIPBOARD_IDENTITY] Copied media or child sequence was removed; copy the clip again")},
    }
  }
  let audio_track:u64=app.default_audio_track(state)
  let video_track:u64=app.default_video_track(state)
  var candidate:editor.Document=editor.copy_document(struct.borrow(state,field=document))
  let pasted:result<u64,string> = match struct.borrow(state,field=clipboard) {
    none=>{return refused("[GA_CLIPBOARD_EMPTY] Clipboard is empty")},
    some(saved)=>editor.paste_clip_snapshot(candidate,saved,track,at),
  }
  match pasted {err(problem)=>refused(text.concat("[GA_CLIPBOARD_PASTE] ",problem)),ok(id)=>{
    match struct.borrow(state,field=clipboard_peer) {none=>{},some(saved)=>{
      let other:u64=if saved.track_kind==editor.track_audio() {audio_track} else {video_track}
      let peer:u64=match editor.paste_clip_snapshot(candidate,saved,other,at) {err(problem)=>{return refused(text.concat("[GA_LINKED_PASTE] ",problem))},ok(value)=>value,}
      regroup_pair(candidate,id,peer)
    },}
    if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
    editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))
    let _=struct.replace(state,candidate,field=document)
    app.document_changed(state)
    done("pasted",id)
  },}
}

// ---------------------------------------------------------------------------
// Tracks

pub fn toggle_track_hidden(state: ref<app.App>, track: u64) -> Result effects {alloc} {
  editor.capture(struct.borrow(state, field=history), struct.borrow(state, field=document))
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  var now: bool = false
  match editor.track_slot(document, track) {
    none => { return refused("no such track") },
    some(slot) => { now = struct.get(array.borrow(struct.borrow(document, field=tracks), slot),
      field=hidden) },
  }
  if not editor.set_track_hidden(struct.borrow(state, field=document), track, not now) {
    return refused("no such track")
  }
  app.document_changed(state)
  done(if now { "track shown" } else { "track hidden" }, track)
}

// ---------------------------------------------------------------------------
// Razor across every track: split whatever the playhead crosses, on every lane at once.
// The split itself is `std.editor.split`; this only enumerates the lanes.

pub fn razor_all(state: ref<app.App>) -> Result effects {alloc} {
  var candidate: editor.Document = editor.copy_document(struct.borrow(state,field=document))
  let cut: u64 = editor.split_all(candidate,candidate.active,editor.playhead(candidate))
  if cut == 0 { return refused("[GA_SPLIT_CONTEXT] No unlocked razor cut can preserve source time, fades, and effect history") }
  if not linked_document_geometry(struct.borrow(state,field=document),candidate) {return refused("[GA_LINKED_RANGE] This edit cannot preserve every linked audio/video range")}
  editor.capture(struct.borrow(state,field=history),struct.borrow(state,field=document))
  let _ = struct.replace(state,candidate,field=document)
  app.document_changed(state)
  var line: string = string.copy("razored ")
  let shown: i64 = cast.sat(cut)
  string.append(line, str.view(string.from_int(shown)))
  string.append(line, " clips")
  done(str.view(line), cut)
}

// A transition centred on the cut nearest the playhead on the selected clip's track.
pub fn transition_at_playhead(state: ref<app.App>, duration: i64) -> Result effects {alloc} {
  let clip: u64 = app.current_clip(state)
  if clip == 0 { return refused("select a clip beside the cut first") }
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  match editor.clip(document, clip) {
    none => refused("no such clip"),
    some(value) => { add_transition(state, value.track, editor.clip_end(value), duration,
      "dissolve") },
  }
}
