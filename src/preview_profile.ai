// Headless measurement of actual preview frame delivery and the AIR window renderer.
// It excludes audio and the native present call; it opens no window.
module genesis.preview_profile
import std.bench as bench
import std.draw as draw
import std.editor as editor
import std.editor_io as editor_io
import std.files as files
import std.path as path
import std.tasks as tasks
import std.text as text
import "app.ai" as app
import "layout.ai" as layout
import "preview.ai" as preview
import "preview_link.ai" as link
import "view.ai" as painter

fn same_color(a: draw.Color, b: draw.Color) -> bool effects {} {
  a.r == b.r and a.g == b.g and a.b == b.b
}

pub fn run(state: ref<app.App>, report: str, width: u32, height: u32,
    fullscreen: bool, samples: u64, full_paint: bool, file_pixels: bool) -> i32 effects {alloc, env, fs.meta, fs.read, fs.write, io.write, net, process, thread, time} {
  if width < 640 or height < 480 or width > 3840 or height > 2160 or samples == 0 or samples > 120 {
    io.write("[GA_PROFILE_ARGS] Use a 640x480..3840x2160 window and 1..120 samples\n")
    return 2
  }
  let root: string = path.join(str.view(struct.borrow(struct.borrow(state, field=provider), field=scratch)), "profile")
  let _ = files.mkdirs(str.view(root))
  preview.reset(str.view(root))
  var transport: link.Link = match if file_pixels {link.open()}else{link.open_pixels()} {ok(value)=>value,err(problem)=>{io.write(str.view(problem))
    return 1},}
  var configured: preview.Config = preview.config(state, str.view(root), link.ticket(transport))
  struct.set(configured,true,field=profile)
  struct.set(configured,not file_pixels,field=pixel_stream)
  struct.set(state, if fullscreen { 1 } else { 0 }, field=fullscreen)
  let _ = editor.program_action(struct.borrow(state, field=document), editor.play())
  let pixels: u64 = cast.wrap(width) * cast.wrap(height)
  let monitor_width: u32 = if fullscreen { 1280 } else { 480 }
  let monitor_height: u32 = if fullscreen { 720 } else { 270 }
  let monitor_pixels: u64 = cast.wrap(monitor_width) * cast.wrap(monitor_height)
  var ready: bench.Bench = bench.new("request_to_ready", "wake delivery, serialized document, worker decode/composite, monitor conversion and ready notification", monitor_pixels, "pixels", 3, samples)
  var read: bench.Bench = bench.new("read_images", "completed RGBA pixels into AIR surfaces by bulk copy", monitor_pixels, "pixels", 3, samples)
  var paint: bench.Bench = bench.new("paint", if full_paint { "complete editor paint at physical window dimensions" } else { "retained playback paint at physical window dimensions" }, pixels, "pixels", 3, samples)
  var pack: bench.Bench = bench.new("present_handoff", "borrow the RGBA canvas bytes consumed by the native presenter", pixels, "pixels", 3, samples)
  var total: bench.Bench = bench.new("serial_pipeline", "preview mailbox plus CPU paint and the borrowed presenter handoff, without audio or native present", pixels, "pixels", 3, samples)
  var snapshot: bench.Bench = bench.new("snapshot_read", "preview task reads and decodes its atomic request", 1, "frames", 3, samples)
  var source_stage: bench.Bench = bench.new("source_monitor", "source monitor decode or held frame read", monitor_pixels, "pixels", 3, samples)
  var planning: bench.Bench = bench.new("frame_planning", "program wire plan and document cache signature", 1, "frames", 3, samples)
  var program_stage: bench.Bench = bench.new("program_monitor", "worker request/reply, composition, pixel read and monitor resize", monitor_pixels, "pixels", 3, samples)
  var publication: bench.Bench = bench.new("frame_publication", "bounded pixel transfer and completion, or diagnostic frame files", monitor_pixels, "pixels", 3, samples)
  var coalescing: bench.Bench = bench.new("wake_coalescing", "drain queued wake commands before reading the newest snapshot", 1, "frames", 3, samples)
  var remaining: bench.Bench = bench.new("remaining_request_time", "document encoding, request publication, completion delivery and unclassified overhead", 1, "frames", 3, samples)
  bench.expect(snapshot,1)
  bench.expect(source_stage,1)
  bench.expect(planning,1)
  bench.expect(program_stage,1)
  bench.expect(publication,1)
  bench.expect(coalescing,1)
  bench.expect(remaining,1)
  bench.expect(ready, 1)
  bench.expect(read, monitor_pixels)
  bench.expect(paint, 1)
  bench.expect(pack, pixels * 4)
  bench.expect(total, 1)
  var renderer: painter.Renderer = painter.renderer()
  var iteration: u64 = 0
  var failure: bool = false
  var source: draw.Surface = draw.empty_surface()
  task.scope {
    var jobs: array<task<bool>> = array.new()
    array.push(jobs, task.spawn(configured, fn=preview.run))
    match link.connect(transport) {ok(_)=>{},err(problem)=>{io.write(str.view(problem))
      failure=true},}
    loop {
      if failure { break }
      if not bench.next(total) { break }
      let _ = bench.next(ready)
      let _ = bench.next(read)
      let _ = bench.next(paint)
      let _ = bench.next(pack)
      let begin: u64 = bench.mark()
      iteration = iteration + 1
      let _ = editor.seek(struct.borrow(state, field=document), cast.sat(iteration - 1))
      let document: string = match editor_io.encode(struct.borrow(state, field=document)) {
        ok(value) => value, err(_) => { failure = true
          break },
      }
      if not preview.request_quality(str.view(root), str.view(document), iteration, 0, 2.4, 450, monitor_width, monitor_height) {
        io.write("[GA_PREVIEW_REQUEST] Cannot publish the diagnostic preview request\n")
        failure=true
        break
      }
      match link.wake(transport,false) {ok(_)=>{},err(problem)=>{io.write(str.view(problem))
        failure=true},}
      match link.await_ready(transport,iteration,time.monotonic_ns()+30000000000) {
        ok(_)=>{},err(problem)=>{io.write(str.view(problem))
          failure=true},
      }
      if failure { break }
      let elapsed: u64 = bench.observe(ready, begin, 1)
      let timing: link.FrameTiming = struct.get(transport,field=timing)
      if timing.generation != iteration {failure=true
        break}
      bench.record_ns(snapshot,timing.request_ns,1)
      bench.record_ns(source_stage,timing.source_ns,1)
      bench.record_ns(planning,timing.plan_ns,1)
      bench.record_ns(program_stage,timing.program_ns,1)
      bench.record_ns(publication,timing.publish_ns,1)
      bench.record_ns(coalescing,timing.coalesce_ns,1)
      let stages: u64 = timing.request_ns+timing.source_ns+timing.plan_ns+timing.program_ns+timing.publish_ns+timing.coalesce_ns
      bench.record_ns(remaining,if elapsed >= stages {elapsed-stages}else{0},1)
      let read_begin: u64 = bench.mark()
      var images: array<draw.Surface> = if file_pixels {preview.read_images(str.view(root),iteration)}else{link.take_images(transport,iteration)}
      var program: draw.Surface = match array.pop(images) {some(value) => value, none => draw.empty_surface(),}
      var new_source: draw.Surface = match array.pop(images) {some(value) => value, none => draw.empty_surface(),}
      if file_pixels or not link.holds_source(transport) {let _ = ref.swap(source,new_source)}
      if not file_pixels {
        struct.set(state,transport.position.source_frame,field=presented_source_frame)
        struct.set(state,transport.position.program_frame,field=presented_program_frame)
      }
      let actual_pixels: u64 = cast.wrap(program.width) * cast.wrap(program.height)
      let _ = bench.observe(read, read_begin, actual_pixels)
      if actual_pixels != monitor_pixels { failure = true
        break }
      let paint_begin: u64 = bench.mark()
      if not painter.render(state, renderer, width, height, full_paint, source, program) { failure = true
        break }
      let finished: ref<draw.Surface> = struct.borrow(renderer, field=surface)
      // A blank allocation cannot pass as an executed paint. Check a panel pixel
      // away from text and outlines as well as the published program dimensions.
      let colors: painter.Theme = painter.theme(state)
      let expected: draw.Color = if fullscreen { colors.background } else { colors.panel_head }
      let painted: bool = match draw.surface_pixel(finished, width - 2, height - 2) {
        some(value) => same_color(value, expected), none => false,
      }
      let _ = bench.observe(paint, paint_begin, if painted { 1 } else { 0 })
      let pack_begin: u64 = bench.mark()
      let rgba: view<byte> = array.view(struct.borrow(finished, field=pixels))
      let _ = bench.observe(pack, pack_begin, view.len(rgba))
      let _ = bench.observe(total, begin, if painted { 1 } else { 0 })
    }
    preview.stop(str.view(root))
    let _ = link.wake(transport,true)
    let _ = tasks.join_next<bool>(jobs, 30000)
    link.close_commands(transport)
  }
  if failure { io.write("[GA_PROFILE_PREVIEW] The preview did not publish a complete frame\n")
    return 1 }
  var group: bench.Group = bench.group("Genesis preview frame delivery and CPU phases")
  bench.add(group, ready, 120)
  bench.add(group, read, 120)
  bench.add(group, paint, 120)
  bench.add(group, pack, 120)
  bench.add(group, total, 120)
  bench.add(group, snapshot, 120)
  bench.add(group, source_stage, 120)
  bench.add(group, planning, 120)
  bench.add(group, program_stage, 120)
  bench.add(group, publication, 120)
  bench.add(group, remaining, 120)
  bench.add(group, coalescing, 120)
  io.write(bench.text_report(ready))
  io.write(bench.text_report(read))
  io.write(bench.text_report(paint))
  io.write(bench.text_report(pack))
  io.write(bench.text_report(total))
  bench.group_conclude(group, report, 12)
}
