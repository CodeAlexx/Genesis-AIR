// Resolve an AIR editor document into gcompose's fixed frame and export protocol.
// The document owns project facts; this module owns only their media interpretation.
module genesis.timeline_media

import std.editor as editor
import std.editor_view as editor_view
import std.draw as draw
import std.files as files
import std.file_publish as file_publish
import std.math as math
import std.path as path
import std.process as proc
import std.tasks as tasks
import std.text as text
import std.system as system
import std.timeline as timeline
import std.font as font
import "chrome.ai" as chrome
import "provider.ai" as provider
import "typeface.ai" as typeface
import "bidi.ai" as bidi
import "filter_keys.ai" as filter_keys
import "picture_memory.ai" as picture_memory
import "audio_endpoint.ai" as endpoint

type SourceInfo = struct {path: string, frames: i64, fps: f64, audio: bool, online: bool}

fn source_info(doc: ref<editor.Document>, slot: u64) -> SourceInfo effects {alloc} {
  let value: ref<editor.Source> = array.borrow(struct.borrow(doc, field=sources), slot)
  SourceInfo {path: string.copy(str.view(struct.borrow(value, field=path))),
    frames: value.frames, fps: value.fps, audio: value.has_audio, online: value.online}
}

fn put(values: ref<array<string>>, at: u64, value: str) -> unit effects {alloc} {
  let _ = ref.swap(array.borrow(values, at), string.copy(value))
  ()
}
fn put_i(values: ref<array<string>>, at: u64, value: i64) -> unit effects {alloc} {
  put(values, at, str.view(string.from_int(value)))
}
fn put_f(values: ref<array<string>>, at: u64, value: f64) -> unit effects {alloc} {
  put(values, at, str.view(string.from_float(value)))
}

// One authoritative set of neutral fields, shared by PREVIEW and ENC. The worker's
// indexed grammar is intentionally contained here; index 101 is the clip fade and
// 102..104 extend the crop margins, 105 adds the simple-effect mix, and 106
// carries vignette softness; 107 opts upper-clip spatial effects into alpha cuts.
fn neutral() -> array<string> effects {alloc} {
  var values: array<string> = array.new()
  var at: u64 = 0
  loop {
    if at == 108 { break }
    array.push(values, string.copy("0"))
    at = at + 1
  }
  put(values, 0, "-")
  put(values, 1, "-")
  put(values, 4, "1")
  put(values, 8, "1")
  put(values, 9, "1")
  put(values, 11, "1")
  put(values, 12, "1")
  put(values, 15, "-")
  put(values, 16, "-1")
  put(values, 18, "4")
  put(values, 19, "-")
  put(values, 22, "1")
  put(values, 23, "1")
  at = 27
  loop {
    if at == 33 { break }
    put(values, at, "1")
    at = at + 1
  }
  put(values, 34, "1")
  put(values, 38, "1")
  put(values, 40, "0.4")
  put(values, 41, "0.1")
  put(values, 43, "0.25")
  put(values, 44, "0.5")
  put(values, 45, "0.75")
  put(values, 46, "1")
  put(values, 52, "1")
  put(values, 55, "1")
  put(values, 56, "1")
  put(values, 62, "1")
  put(values, 63, "1")
  put(values, 64, "1")
  put(values, 84, "90")
  put(values, 86, "0.5")
  put(values, 87, "0.5")
  put(values, 88, "1")
  put(values, 89, "1")
  put(values, 98, "1")
  put(values, 101, "1")
  put(values, 105, "1")
  put(values, 106, "0.5")
  values
}

fn source_path(doc: ref<editor.Document>, clip: editor.Clip) -> option<string> effects {alloc} {
  if not editor.clip_has_video(clip) {return option.none()}
  match editor.source_slot(doc, clip.source) {
    none => option.none(),
    some(slot) => {
      let source: ref<editor.Source> = array.borrow(struct.borrow(doc, field=sources), slot)
      if not source.online or not source.has_video { return option.none() }
      option.some(string.copy(str.view(struct.borrow(source, field=path))))
    },
  }
}

// Stabilization acts on decoded source frames before clip-local color/spatial
// effects and compositing. The worker keeps the real media path inside this
// source token, so audio always reads the original source.
fn picture_path(doc: ref<editor.Document>, clip: editor.Clip, frame: i64,
                source: string) -> result<string, string> effects {alloc} {
  var amount: f64 = 0.0
  var index: u32 = 0
  loop {
    match editor.filter_at(doc, clip.id, index) {
      none => { break },
      some(filter) => {
        if editor.filter_enabled(doc, filter) and
           str.eq(str.view(editor.filter_kind(doc, filter)), "stabilize") {
          amount = filter_value(doc, clip, filter, "stabilize", frame, "strength", 0.5)
          if not math.is_finite(amount) or amount < 0.0 or amount > 1.0 {
            return result.err("stabilize strength must be between 0 and 1")
          }
        }
      },
    }
    index = index + 1
  }
  if amount == 0.0 { return result.ok(string.copy(str.view(source))) }
  var wrapped: string = text.concat("STAB:", str.view(string.from_float(amount)))
  string.append(wrapped, ":")
  string.append(wrapped, str.view(source))
  result.ok(wrapped)
}

// The clip's Rate property and enabled Speed filters describe the same retime.
// Multiple filters compose multiplicatively; picture, sound, and bounds use one
// derived value, so no renderer maintains a second speed interpretation.
pub fn effective_speed(doc: ref<editor.Document>, clip: editor.Clip) -> f64 effects {alloc} {
  editor.playback_rate(doc,clip)
}

pub fn source_frame(doc: ref<editor.Document>, clip: editor.Clip, frame: i64) -> i64 effects {alloc} {
  if clip.nested != 0 {return match nested_picture_frame(doc,clip,frame) {ok(value)=>value,err(_)=>-1,}}
  let unclamped: i64 = frame - clip.start
  let local: i64 = if unclamped < 0 { 0 }
    else if unclamped >= clip.length { clip.length - 1 }
    else { unclamped }
  let source_fps: f64 = match editor.source_slot(doc, clip.source) {
    none => 30.0,
    some(slot) => struct.get(array.borrow(struct.borrow(doc, field=sources), slot), field=fps),
  }
  let timeline_fps: f64 = editor.sequence_fps(doc, clip.owner)
  let ratio: f64 = if timeline_fps > 0.0 and source_fps > 0.0 {
    source_fps / timeline_fps
  } else { 1.0 }
  let position: i64 = if clip.reverse { clip.length - 1 - local } else { local }
  let result_frame: i64 = cast.sat(math.floor(
    (cast.float(clip.source_in) + cast.float(position) * effective_speed(doc, clip)) * ratio))
  let bound: i64 = editor.source_frames(doc, clip.source)
  if bound > 0 and result_frame >= bound { bound - 1 }
  else if result_frame < 0 { 0 }
  else { result_frame }
}

fn source_range_ok(doc: ref<editor.Document>, clip: editor.Clip) -> bool effects {alloc} {
  let speed: f64 = effective_speed(doc, clip)
  if speed == 0.0 { return true }
  if not math.is_finite(speed) or speed < 0.0 { return false }
  let slot: u64 = match editor.source_slot(doc, clip.source) {
    none => { return false }, some(value) => value,
  }
  let sequence_fps: f64 = editor.sequence_fps(doc, clip.owner)
  let source: ref<editor.Source> = array.borrow(struct.borrow(doc, field=sources), slot)
  if source.frames <= 0 { return true }
  if sequence_fps <= 0.0 or source.fps <= 0.0 { return false }
  let last_native: f64 = math.floor((cast.float(clip.source_in) +
    cast.float(clip.length - 1) * speed) * source.fps / sequence_fps)
  last_native < cast.float(source.frames)
}

// Picture inspection must not intern absent default parameter names. A stored
// curve already owns its name; an unanimated row simply uses its neutral value.
fn picture_clip_value_at(doc: ref<editor.Document>, clip: u64, param: str,
    frame: i64, fallback: f64) -> f64 effects {alloc} {
  if not filter_keys.has(doc,clip,param) {return fallback}
  editor.clip_value_at(doc,clip,param,frame,fallback)
}

fn fade(doc: ref<editor.Document>, clip: editor.Clip, frame: i64) -> f64 effects {alloc} {
  let local: i64 = frame - clip.start
  let fade_in: f64 = math.max(0.0, picture_clip_value_at(doc, clip.id, "fade_in",
    frame, cast.float(clip.fade_in)))
  let fade_out: f64 = math.max(0.0, picture_clip_value_at(doc, clip.id, "fade_out",
    frame, cast.float(clip.fade_out)))
  let local_f: f64 = cast.float(local)
  var value: f64 = 1.0
  if fade_in > 0.0 and local_f < fade_in {
    value = local_f / fade_in
  }
  let remaining: i64 = clip.length - local
  let remaining_f: f64 = cast.float(remaining)
  if fade_out > 0.0 and remaining_f <= fade_out {
    let tail: f64 = remaining_f / fade_out
    if tail < value { value = tail }
  }
  value
}

fn filter_value(doc: ref<editor.Document>, clip: editor.Clip, filter: u64,
                kind: str, frame: i64, name: str, fallback: f64) -> f64 effects {alloc} {
  let base: f64 = editor.filter_param(doc, filter, name, fallback)
  filter_keys.value(doc,clip.id,filter,kind,name,frame,base)
}

fn multiply_gain(values: ref<array<string>>, channel: u64, factor: f64)
                 -> unit effects {alloc} {
  let index: u64 = 30 + channel
  let current: f64 = match text.parse_f64(str.view(array.borrow(values, index))) {
    none => 1.0, some(value) => value,
  }
  put_f(values, index, current * factor)
}

fn apply_filter(doc: ref<editor.Document>, clip: editor.Clip, values: ref<array<string>>,
                filter: u64, overlay: bool, frame: i64) -> bool effects {alloc} {
  if not editor.filter_enabled(doc, filter) { return true }
  let kind: string = editor.filter_kind(doc, filter)
  if chrome.is_audio_kind(str.view(kind)) { return true }
  if str.eq(str.view(kind), "text") or str.eq(str.view(kind), "timer") {
    return true
  }
  if str.eq(str.view(kind), "speed") or str.eq(str.view(kind), "opacity") {
    return true
  } else if str.eq(str.view(kind), "stabilize") {
    let amount: f64 = filter_value(doc, clip, filter, "stabilize", frame, "strength", 0.5)
    return math.is_finite(amount) and amount >= 0.0 and amount <= 1.0
  } else if str.eq(str.view(kind), "blend") and overlay {
    let selected: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "mode", 0.0)
    let mode: i64 = cast.sat(selected)
    if not math.is_finite(selected) or selected != cast.float(mode) or
       mode < 0 or mode > 11 { return false }
    // The inspector keeps Genesis AIR's order; the worker's historical ids 1/3/4
    // are Multiply/Overlay/Add. Convert once at the wire boundary.
    let wire_mode: i64 = if mode == 1 { 4 }
      else if mode == 3 { 1 }
      else if mode == 4 { 3 }
      else { mode }
    put_i(values, 5, wire_mode)
  } else if str.eq(str.view(kind), "size_position") and overlay {
    if filter_value(doc, clip, filter, str.view(kind), frame, "rotation", 0.0) != 0.0 { return false }
    put_f(values, 6, filter_value(doc, clip, filter, str.view(kind), frame, "x", 0.0))
    put_f(values, 7, filter_value(doc, clip, filter, str.view(kind), frame, "y", 0.0))
    put_f(values, 8, filter_value(doc, clip, filter, str.view(kind), frame, "w", 1.0))
    put_f(values, 9, filter_value(doc, clip, filter, str.view(kind), frame, "h", 1.0))
  } else if str.eq(str.view(kind), "brightness") and not overlay {
    put_f(values, 21, filter_value(doc, clip, filter, str.view(kind), frame, "level", 1.0) - 1.0)
  } else if str.eq(str.view(kind), "contrast") and not overlay {
    put_f(values, 22, filter_value(doc, clip, filter, str.view(kind), frame, "level", 1.0))
  } else if str.eq(str.view(kind), "saturation") and not overlay {
    put_f(values, 23, filter_value(doc, clip, filter, str.view(kind), frame, "level", 1.0))
  } else if str.eq(str.view(kind), "sharpen") and not overlay {
    put_f(values, 48, filter_value(doc, clip, filter, str.view(kind), frame, "amount", 0.0))
  } else if str.eq(str.view(kind), "blur") and not overlay {
    put_f(values, 35, filter_value(doc, clip, filter, str.view(kind), frame, "radius", 0.0))
  } else if str.eq(str.view(kind), "grain") and not overlay {
    put_f(values, 72, filter_value(doc, clip, filter, str.view(kind), frame, "amount", 0.0))
  } else if str.eq(str.view(kind), "hue") and not overlay {
    put_f(values, 51, filter_value(doc, clip, filter, str.view(kind), frame, "shift", 0.0))
  } else if str.eq(str.view(kind), "gamma") and not overlay {
    if not str.eq(str.view(array.borrow(values, 56)), "1") { return false }
    put_f(values, 56, filter_value(doc, clip, filter, str.view(kind), frame, "level", 1.0))
  } else if str.eq(str.view(kind), "levels") and not overlay {
    if not str.eq(str.view(array.borrow(values, 56)), "1") { return false }
    let black: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "black", 0.0)
    let white: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "white", 1.0)
    if black >= white { return false }
    put_f(values, 54, black)
    put_f(values, 55, white)
    put_f(values, 56, filter_value(doc, clip, filter, str.view(kind), frame, "gamma", 1.0))
  } else if str.eq(str.view(kind), "vignette") and not overlay {
    let softness: f64 = filter_value(doc, clip, filter, str.view(kind), frame,
      "softness", 0.5)
    if softness < 0.0 or softness > 1.0 { return false }
    put_f(values, 47, filter_value(doc, clip, filter, str.view(kind), frame, "amount", 0.4))
    put_f(values, 106, softness)
  } else if str.eq(str.view(kind), "lift_gamma_gain") and not overlay {
    let lift: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "lift", 0.0)
    let gamma: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "gamma", 1.0)
    let gain: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "gain", 1.0)
    var channel: u64 = 0
    loop {
      if channel >= 3 { break }
      put_f(values, 24 + channel, lift)
      put_f(values, 27 + channel, gamma)
      multiply_gain(values, channel, gain)
      channel = channel + 1
    }
  } else if str.eq(str.view(kind), "rotate") and not overlay {
    put_f(values, 33, filter_value(doc, clip, filter, str.view(kind), frame, "angle", 0.0))
  } else if str.eq(str.view(kind), "flip") and not overlay {
    put(values, 49, if filter_value(doc, clip, filter, str.view(kind), frame, "vertical", 0.0) >= 0.5 { "2" } else { "0" })
  } else if str.eq(str.view(kind), "mirror") and not overlay {
    put(values, 93, if filter_value(doc, clip, filter, str.view(kind), frame, "horizontal", 1.0) >= 0.5 { "1" } else { "0" })
  } else if (str.eq(str.view(kind), "invert") or str.eq(str.view(kind), "sepia") or
             str.eq(str.view(kind), "mono")) and not overlay {
    let amount: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "amount", 1.0)
    if amount < 0.0 or amount > 1.0 { return false }
    if not str.eq(str.view(array.borrow(values, 50)), "0") { return false }
    if amount != 0.0 {
      put(values, 50, if str.eq(str.view(kind), "invert") { "1" }
        else if str.eq(str.view(kind), "sepia") { "2" } else { "3" })
      put_f(values, 105, amount)
    }
  } else if str.eq(str.view(kind), "denoise") and not overlay {
    put_f(values, 65, filter_value(doc, clip, filter, str.view(kind), frame, "amount", 0.3))
  } else if str.eq(str.view(kind), "crop") and not overlay {
    let left: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "left", 0.0)
    let top: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "top", 0.0)
    let right: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "right", 0.0)
    let bottom: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "bottom", 0.0)
    put_f(values, 79, left)
    put_f(values, 102, top)
    put_f(values, 103, right)
    put_f(values, 104, bottom)
  } else if str.eq(str.view(kind), "mask") and not overlay {
    // The inspector's mask is a centered full-frame rectangle with an adjustable
    // soft edge. The worker applies this to the base image before its look pass.
    put(values, 85, "1")
    put_f(values, 88, 0.5)
    put_f(values, 89, 0.5)
    put_f(values, 90, filter_value(doc, clip, filter, str.view(kind), frame,
      "feather", 0.1))
    put(values, 91, if filter_value(doc, clip, filter, str.view(kind), frame,
      "invert", 0.0) >= 0.5 { "1" } else { "0" })
  } else if str.eq(str.view(kind), "chroma_key") and overlay {
    let degrees: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "hue", 120.0)
    if degrees < 0.0 or degrees > 360.0 { return false }
    let hue: f64 = if degrees == 360.0 { 0.0 } else { degrees }
    let sector: i64 = cast.sat(math.floor(hue / 60.0))
    let part: f64 = hue / 60.0 - cast.float(sector)
    let middle: f64 = 1.0 - part
    let red: f64 = if sector == 0 or sector == 5 { 1.0 }
      else if sector == 1 { middle } else if sector == 4 { part } else { 0.0 }
    let green: f64 = if sector == 1 or sector == 2 { 1.0 }
      else if sector == 0 { part } else if sector == 3 { middle } else { 0.0 }
    let blue: f64 = if sector == 3 or sector == 4 { 1.0 }
      else if sector == 2 { part } else if sector == 5 { middle } else { 0.0 }
    put(values, 36, "1")
    put_f(values, 37, red)
    put_f(values, 38, green)
    put_f(values, 39, blue)
    put_f(values, 40, filter_value(doc, clip, filter, str.view(kind), frame, "tolerance", 0.25))
    put_f(values, 41, filter_value(doc, clip, filter, str.view(kind), frame, "softness", 0.10))
  } else if str.eq(str.view(kind), "white_balance") and not overlay {
    let temperature: f64 = filter_value(doc, clip, filter, str.view(kind), frame,
      "temperature", 0.0)
    let tint: f64 = filter_value(doc, clip, filter, str.view(kind), frame, "tint", 0.0)
    if temperature < -100.0 or temperature > 100.0 or tint < -100.0 or tint > 100.0 {
      return false
    }
    put_f(values, 100, temperature / 100.0)
    let bias: f64 = tint / 100.0
    multiply_gain(values, 0, 1.0 - 0.2 * bias)
    multiply_gain(values, 1, 1.0 + 0.4 * bias)
    multiply_gain(values, 2, 1.0 - 0.2 * bias)
  } else if str.eq(str.view(kind), "lut3d") and not overlay {
    let lut: string = editor.filter_text_param(doc, filter, "path", "")
    if str.len(str.view(lut)) == 0 { return true }
    if not str.eq(str.view(array.borrow(values, 13)), "0") { return false }
    let amount: f64 = filter_value(doc, clip, filter, str.view(kind), frame,
      "amount", 1.0)
    if amount < 0.0 or amount > 1.0 { return false }
    put(values, 13, "2")
    put_f(values, 14, amount)
    let wire: string = provider.wire_path(str.view(lut))
    put(values, 15, str.view(wire))
  } else if str.eq(str.view(kind), "glow") and not overlay {
    put_f(values, 66, filter_value(doc, clip, filter, str.view(kind), frame, "amount", 0.0))
    put_f(values, 67, filter_value(doc, clip, filter, str.view(kind), frame, "threshold", 0.7))
  } else { return false }
  true
}

fn filters(doc: ref<editor.Document>, clip: editor.Clip, values: ref<array<string>>,
           overlay: bool, frame: i64, prepassed: bool) -> bool effects {alloc} {
  var index: u32 = 0
  loop {
    match editor.filter_at(doc, clip.id, index) {
      none => { break },
      some(filter) => {
        if prepassed and not overlay {
          let kind: string = editor.filter_kind(doc, filter)
          if not chrome.is_audio_kind(str.view(kind)) and
             not str.eq(str.view(kind), "speed") and
             not str.eq(str.view(kind), "opacity") {
            var probe: array<string> = neutral()
            if not apply_filter(doc, clip, probe, filter, false, frame) { return false }
            index = index + 1
            continue
          }
        }
        if not apply_filter(doc, clip, values, filter, overlay, frame) {
          if not overlay or not prepassed { return false }
          // A picture effect already ran on this clip before it was composited.
          // Verify it is genuinely mapped there; an unknown kind must still fail.
          var probe: array<string> = neutral()
          if not apply_filter(doc, clip, probe, filter, false, frame) { return false }
        }
      },
    }
    index = index + 1
  }
  true
}

fn overlay_opacity(doc: ref<editor.Document>, clip: editor.Clip, frame: i64) -> f64 effects {alloc} {
  var value: f64 = 1.0
  var index: u32 = 0
  loop {
    match editor.filter_at(doc, clip.id, index) {
      none => { break },
      some(filter) => {
        if editor.filter_enabled(doc, filter) {
          let kind: string = editor.filter_kind(doc, filter)
          if str.eq(str.view(kind), "opacity") {
            let base: f64 = editor.filter_param(doc, filter, "level", 1.0)
            value = value * filter_keys.value(doc,clip.id,filter,"opacity","level",frame,base)
          }
          if str.eq(str.view(kind), "size_position") {
            let base: f64 = editor.filter_param(doc, filter, "opacity", 1.0)
            value = value * filter_keys.value(doc,clip.id,filter,"size_position","opacity",frame,base)
          }
        }
      },
    }
    index = index + 1
  }
  value
}

fn clip_factor(doc: ref<editor.Document>, clip: editor.Clip, frame: i64) -> f64 effects {alloc} {
  fade(doc,clip,frame) * picture_clip_value_at(doc,clip.id,"opacity",frame,1.0) *
    overlay_opacity(doc,clip,frame)
}

pub fn key_supported(param: str) -> bool effects {alloc} {
  if str.eq(param, "opacity") or str.eq(param, "fade_in") or
     str.eq(param, "fade_out") or str.eq(param, "gain") { return true }
  let canonical: string = filter_keys.canonical(param)
  var pieces: array<string> = text.split(str.view(canonical), ".")
  if array.len(pieces) != 2 { return false }
  let kind: str = str.view(array.borrow(pieces, 0))
  let name: str = str.view(array.borrow(pieces, 1))
  if str.eq(kind, "text") {
    return str.eq(name, "size") or str.eq(name, "x") or str.eq(name, "y")
  }
  if str.eq(kind, "timer") { return str.eq(name, "size") }
  if str.eq(kind, "lut3d") {
    return str.eq(name, "amount")
  }
  if str.eq(kind, "stabilize") { return str.eq(name, "strength") }
  if str.eq(kind, "speed") { return false }
  if str.eq(kind, "size_position") and str.eq(name, "rotation") { return false }
  var video: array<string> = chrome.video_kinds()
  var known: bool = false
  var family: u64 = 0
  loop { if family >= array.len(video) { break }
    if str.eq(kind,str.view(array.borrow(video,family))) { known=true }
    family=family+1
  }
  if not known { return false }
  var specs: array<chrome.Spec> = chrome.params_for(kind)
  var index: u64 = 0
  loop {
    if index >= array.len(specs) { break }
    if str.eq(name, str.view(struct.borrow(array.borrow(specs, index), field=name))) { return true }
    index = index + 1
  }
  false
}

// Overlay-only controls need a lower picture at this timeline frame. An incoming
// transition side is prepared independently and cannot use these composition fields.
pub fn key_layer_supported(doc: ref<editor.Document>, clip: editor.Clip, kind: str,
                           frame: i64) -> bool effects {alloc} {
  if not str.eq(kind,"blend") and not str.eq(kind,"size_position") and
     not str.eq(kind,"chroma_key") { return true }
  var lanes: array<u64> = editor_view.lanes(doc,doc.active)
  var lower: bool = false
  var at: u64 = 0
  loop {if at >= array.len(lanes) {break}
    let track: u64 = array.get(lanes,at)
    if editor.track_kind(doc,track) == editor.track_video() and editor.track_visible(doc,track) {
      match picture_transition_at(doc,track,frame) {
        none=>{},
        some(id)=>{
          if track == clip.track {
            let transition:editor.Transition=option.unwrap(editor.transition(doc,id))
            if not lower and not transition_lower_span(doc,transition) { return false }
            match transition_pair(doc,track,transition.center) {
              none=>{return false},some(pair)=>{
                return pair.outgoing.id==clip.id or pair.incoming.id==clip.id
              },
            }
          }
        },
      }
      match composited_clip(doc,track,frame) {
        none=>{},
        some(visible)=>{
          if visible.id == clip.id { return lower or clip_needs_alpha_composition(doc,clip) }
          lower=true
        },
      }
    }
    at=at+1
  }
  false
}

fn visible_clip(doc: ref<editor.Document>, track: u64, frame: i64)
                -> option<editor.Clip> effects {} {
  var at: u64 = 0
  loop {
    if at >= editor.clip_count(doc) { break }
    match editor.clip_at(doc, at) {
      none => { },
      some(value) => {
        if value.track == track and value.owner == doc.active and value.enabled and
           editor.clip_has_video(value) and value.start <= frame and editor.clip_end(value) > frame {
          return option.some(value)
        }
      },
    }
    at = at + 1
  }
  option.none()
}

type TransitionPair = struct {outgoing: editor.Clip, incoming: editor.Clip}

// Match the worker's documented transition ids. Project files keep readable
// names; this is the sole conversion at the media boundary.
fn transition_kind(name: str) -> i64 effects {} {
  if str.eq(name, "crossfade") { return 0 }
  if str.eq(name, "wipe_lr") { return 1 }
  if str.eq(name, "wipe_rl") { return 2 }
  if str.eq(name, "wipe_up") { return 3 }
  if str.eq(name, "wipe_down") { return 4 }
  if str.eq(name, "slide_lr") { return 5 }
  if str.eq(name, "zoom") { return 6 }
  if str.eq(name, "dissolve") { return 7 }
  if str.eq(name, "iris") { return 8 }
  if str.eq(name, "clock") { return 9 }
  if str.eq(name, "barn_door") { return 10 }
  -1
}

// Use the editor's authoritative adjacent pair. It resolves touching cuts, short
// gaps, and overlap midpoints with the same ordering as the timeline model.
fn transition_pair(doc: ref<editor.Document>, track: u64, center: i64)
                   -> option<TransitionPair> effects {alloc} {
  let boundary: editor.Boundary = match editor.boundary_at(doc, track, center) {
    none => { return option.none() }, some(value) => value,
  }
  let outgoing: editor.Clip = match editor.clip(doc, boundary.outgoing) {
    none => { return option.none() },
    some(value) => value,
  }
  let incoming: editor.Clip = match editor.clip(doc, boundary.incoming) {
    none => { return option.none() },
    some(value) => value,
  }
  if outgoing.owner != doc.active or incoming.owner != doc.active or
     not outgoing.enabled or not incoming.enabled or
     not editor.clip_has_video(outgoing) or not editor.clip_has_video(incoming) { return option.none() }
  option.some(TransitionPair {outgoing: outgoing, incoming: incoming})
}

// Stream routing can leave an authored audio-only pair on a V lane. It must
// not activate picture transitions; unresolved legacy pairs keep their errors.
fn picture_transition_at(doc: ref<editor.Document>, track: u64, frame: i64)
    -> option<u64> effects {alloc} {
  let id: u64 = match editor.transition_at(doc,track,frame) {none=>{return option.none()},some(value)=>value,}
  match editor.transition(doc,id) {
    none=>{},some(transition)=>{match editor.boundary_at(doc,track,transition.center) {
      none=>{},some(boundary)=>{
        match editor.clip(doc,boundary.outgoing) {
          none=>{},some(clip)=>{if not editor.clip_has_video(clip) {return option.none()}},
        }
        match editor.clip(doc,boundary.incoming) {
          none=>{},some(clip)=>{if not editor.clip_has_video(clip) {return option.none()}},
        }
      },
    }},
  }
  option.some(id)
}

fn composited_clip(doc: ref<editor.Document>, track: u64, frame: i64)
                   -> option<editor.Clip> effects {alloc} {
  match picture_transition_at(doc, track, frame) {
    none => visible_clip(doc, track, frame),
    some(id) => {
      let transition: editor.Transition = match editor.transition(doc, id) {
        none => { return option.none() }, some(value) => value,
      }
      match transition_pair(doc, track, transition.center) {
        none => option.none(), some(pair) => option.some(pair.outgoing),
      }
    },
  }
}

fn incoming_transition_supported(doc: ref<editor.Document>, clip: editor.Clip,
                                 frame: i64, prepared: bool) -> bool effects {alloc} {
  if clip.nested != 0 or not source_range_ok(doc, clip) or
     (not prepared and clip_factor(doc,clip,frame) != 1.0) { return false }
  transition_incoming_edits_supported(doc,clip)
}

// Shared memory-only policy for creation/edit controls. Compound inputs are
// projected before the renderer's source check; their authored keys/operators
// still obey this same incoming-half policy.
pub fn transition_incoming_edits_supported(doc:ref<editor.Document>,clip:editor.Clip)
    -> bool effects {alloc} {
  var key_index: u64 = 0
  loop {
    if key_index >= array.len(struct.borrow(doc, field=keys)) { break }
    let key: editor.Key = array.get(struct.borrow(doc, field=keys), key_index)
    if key.clip == clip.id and not key_supported(str.view(editor.name_text(doc, key.param))) {
      return false
    }
    key_index = key_index + 1
  }
  var filter_index: u32 = 0
  loop {
    match editor.filter_at(doc, clip.id, filter_index) {
      none => { break },
      some(filter) => {
        if editor.filter_enabled(doc, filter) {
          let kind: string = editor.filter_kind(doc, filter)
          if str.eq(str.view(kind), "blend") or
             str.eq(str.view(kind), "size_position") or
             str.eq(str.view(kind), "chroma_key") { return false }
        }
      },
    }
    filter_index = filter_index + 1
  }
  true
}

// Refuse an edit that this adapter cannot yet render. Silent substitution would make the
// monitor and exported file disagree with the edit shown in the inspector.
fn wire_line(values: ref<array<string>>, kind: str, out: str) -> string effects {alloc} {
  var line: string = string.copy(kind)
  string.append(line, " ")
  string.append(line, str.view(text.join(values, " ")))
  if str.eq(kind, "PREVIEW") or str.eq(kind, "FLOAT") {
    string.append(line, " ")
    string.append(line, str.view(provider.wire_path(out)))
  }
  line
}

fn frame_line_core(doc: ref<editor.Document>, frame: i64, kind: str, out: str,
                   strict: bool, base_override: str, upper_override: str,
                   incoming_override: str, base_fade_prepassed: bool)
                   -> result<string, string> effects {alloc} {
  var values: array<string> = neutral()
  var visible: u64 = 0
  var lanes: array<u64> = editor_view.lanes(doc, doc.active)
  var lane: u64 = 0
  loop {
    if lane >= array.len(lanes) { break }
    let track: u64 = array.get(lanes, lane)
    if editor.track_kind(doc, track) == editor.track_video() and
       editor.track_visible(doc, track) {
      var chosen: option<editor.Clip> = visible_clip(doc, track, frame)
      match picture_transition_at(doc, track, frame) {
        none => { },
        some(id) => {
          if visible != 0 { return result.err("a transition above the base lane is not rendered yet") }
          let transition: editor.Transition = match editor.transition(doc, id) {
            none => { return result.err("the transition could not be resolved") },
            some(value) => value,
          }
          let name: string = editor.name_text(doc, transition.kind)
          let worker_kind: i64 = transition_kind(str.view(name))
          if worker_kind < 0 {
            return result.err("this transition kind is not rendered yet")
          }
          let pair: TransitionPair = match transition_pair(doc, track, transition.center) {
            none => { return result.err("transition needs an adjacent clip pair at its seam") },
            some(value) => value,
          }
          if not incoming_transition_supported(doc, pair.incoming, frame,str.len(incoming_override) != 0) {
            return result.err("the transition's incoming clip has an unsupported edit")
          }
          let incoming_path: string = if str.len(incoming_override) != 0 {
            string.copy(incoming_override)
          } else { match source_path(doc, pair.incoming) {
            none => { return result.err("the transition's incoming source is unavailable") },
            some(value) => try picture_path(doc, pair.incoming, frame, value),
          } }
          chosen = option.some(pair.outgoing)
          put_i(values, 16, worker_kind)
          put_f(values, 17, editor.transition_progress(transition, frame))
          put(values, 19, str.view(provider.wire_path(str.view(incoming_path))))
          put_i(values, 20, if str.len(incoming_override) != 0 { 0 }
            else { source_frame(doc, pair.incoming, frame) })
        },
      }
      match chosen {
        none => { },
        some(clip) => {
              if clip.enabled {
                if visible >= 2 {
                  if strict { return result.err("more than two visible video layers") }
                  lane = lane + 1
                  continue
                }
                var key_index: u64 = 0
                loop {
                  if key_index >= array.len(struct.borrow(doc, field=keys)) { break }
                  let key: editor.Key = array.get(struct.borrow(doc, field=keys), key_index)
                  if key.clip == clip.id {
                    let param: string = editor.name_text(doc, key.param)
                    if not key_supported(str.view(param)) {
                      return result.err("a visible clip has unsupported keyframed video effects")
                    }
                  }
                  key_index = key_index + 1
                }
                if clip.nested != 0 { return result.err("nested sequences are not rendered yet") }
                if not source_range_ok(doc, clip) {
                  return result.err("clip speed and length exceed its source frames")
                }
                let chosen_override: string = if visible == 0 { string.copy(base_override) }
                  else { string.copy(upper_override) }
                let prepassed: bool = str.len(str.view(chosen_override)) != 0
                let path: string = if prepassed { chosen_override }
                  else { match source_path(doc, clip) {
                    some(value) => try picture_path(doc, clip, frame, value),
                    none => { return result.err("a visible clip has no online video source") },
                  } }
                let source_at: i64 = if prepassed { 0 } else { source_frame(doc, clip, frame) }
                let slot: u64 = if visible == 0 { 0 } else { 1 }
                put(values, slot, str.view(provider.wire_path(str.view(path))))
                put_i(values, if visible == 0 { 2 } else { 3 }, source_at)
                if visible == 1 {
                  put_f(values, 4, fade(doc, clip, frame) *
                    picture_clip_value_at(doc, clip.id, "opacity", frame, 1.0) *
                    overlay_opacity(doc, clip, frame))
                } else {
                  put_f(values, 101, if base_fade_prepassed { 1.0 } else { fade(doc, clip, frame) *
                    picture_clip_value_at(doc, clip.id, "opacity", frame, 1.0) *
                    overlay_opacity(doc, clip, frame) })
                }
                if not filters(doc, clip, values, visible == 1, frame, prepassed) {
                  return result.err("a visible clip uses an unsupported video filter")
                }
                visible = visible + 1
              }
        },
      }
    }
    lane = lane + 1
  }
  result.ok(wire_line(values, kind, out))
}

pub fn frame_line(doc: ref<editor.Document>, frame: i64, kind: str, out: str)
                  -> result<string, string> effects {alloc} {
  match editor.subtitle_at(doc, doc.active, frame) {
    some(id) => { return result.err("subtitles need a frame plan") },
    none => { },
  }
  frame_line_core(doc, frame, kind, out, true, "", "", "", false)
}

fn layer_path(prefix: str, number: u64) -> string effects {alloc} {
  text.concat(prefix, if number == 0 { ".layer0.rgba" } else { ".layer1.rgba" })
}

fn scratch_variant(prefix: str, part: str, slot: u64) -> string effects {alloc} {
  let number: i64 = cast.sat(slot)
  let label: string = string.from_int(number)
  var output: string = string.copy(prefix)
  string.append(output, part)
  string.append(output, str.view(label))
  string.append(output, ".rgba")
  output
}

fn preclip_path(prefix: str, slot: u64) -> string effects {alloc} {
  scratch_variant(prefix, ".preclip", slot)
}

// Prepare an upper clip's picture effects before it meets lower lanes. Overlay-only
// controls run in the composition pass. Crop and Mask clear alpha in this per-clip
// pass, allowing lower lanes to show through their cleared areas.
fn preclip_line(doc: ref<editor.Document>, clip: editor.Clip, frame: i64,
                out: str, upper: bool)
                -> result<option<string>, string> effects {alloc} {
  var values: array<string> = neutral()
  var active: bool = false
  var index: u32 = 0
  loop {
    match editor.filter_at(doc, clip.id, index) {
      none => { break },
      some(filter) => {
        if editor.filter_enabled(doc, filter) {
          let kind: string = editor.filter_kind(doc, filter)
          if not chrome.is_audio_kind(str.view(kind)) and
             not str.eq(str.view(kind), "speed") and
             not str.eq(str.view(kind), "stabilize") and
             not str.eq(str.view(kind), "opacity") and
             not str.eq(str.view(kind), "blend") and
             not str.eq(str.view(kind), "size_position") and
             not str.eq(str.view(kind), "chroma_key") and
             not str.eq(str.view(kind), "text") and
             not str.eq(str.view(kind), "timer") {
            if not apply_filter(doc, clip, values, filter, false, frame) {
              return result.err("an upper clip uses an unsupported picture filter")
            }
            active = true
          }
        }
      },
    }
    index = index + 1
  }
  if not active { return result.ok(option.none()) }
  if upper { put(values, 107, "1") }
  let path: string = match source_path(doc, clip) {
    some(value) => try picture_path(doc, clip, frame, value),
    none => { return result.err("an upper clip has no online video source") },
  }
  put(values, 0, str.view(provider.wire_path(str.view(path))))
  put_i(values, 2, source_frame(doc, clip, frame))
  result.ok(option.some(wire_line(values, "FLOAT", out)))
}

type PreparedClip = struct {lines: array<string>, path: string}

fn text_raster_path(prefix: str, slot: u64) -> string effects {alloc} {
  scratch_variant(prefix, ".title", slot)
}

fn text_clip_path(prefix: str, slot: u64) -> string effects {alloc} {
  scratch_variant(prefix, ".textclip", slot)
}

fn ordered_title_path(prefix: str, slot: u64, index: u64) -> string effects {alloc} {
  let stem: string = scratch_variant(prefix, ".ordered-title", slot)
  text.concat(str.view(stem), text.concat(".", str.view(string.from_int(cast.sat(index)))))
}

fn ordered_count_path(prefix: str, slot: u64) -> string effects {alloc} {
  scratch_variant(prefix, ".ordered-count", slot)
}

// Composition/transport controls stay outside the per-picture stack. Everything
// else is a picture operator, including titles and unknown kinds (which the
// mapping must explicitly refuse rather than silently discard).
fn picture_operator(kind: str) -> bool effects {alloc} {
  not chrome.is_audio_kind(kind) and not str.eq(kind, "speed") and
    not str.eq(kind, "stabilize") and not str.eq(kind, "opacity") and
    not str.eq(kind, "blend") and not str.eq(kind, "size_position") and
    not str.eq(kind, "chroma_key")
}

fn raster_clip_text(doc: ref<editor.Document>, clip: editor.Clip, frame: i64,
                    prefix: str, slot: u64, only: u64, output_override: str,
                    cache: ref<RenderCache>)
                    -> result<option<string>, string> effects {alloc, fs.meta, fs.read, fs.write} {
  var present: bool = false
  var index: u32 = 0
  loop {
    match editor.filter_at(doc, clip.id, index) {
      none => { break },
      some(filter) => {
        if editor.filter_enabled(doc, filter) and (only == 0 or filter == only) {
          let kind: string = editor.filter_kind(doc, filter)
          if str.eq(str.view(kind), "timer") { present = true }
          if str.eq(str.view(kind), "text") {
            let content: string = editor.filter_text_param(doc, filter, "content", "")
            if str.len(str.view(content)) != 0 { present = true }
          }
        }
      },
    }
    index = index + 1
  }
  if not present { return result.ok(option.none()) }
  match files.mkdirs(str.view(path.dirname(prefix))) {
    err(problem) => { return result.err("text scratch directory could not be created") },
    ok(_) => { },
  }
  var surface: draw.Surface = match draw.surface(cache.width, cache.height) {
    none => { return result.err("text surface could not be allocated") },
    some(value) => value,
  }
  var canvas: draw.Canvas = draw.canvas(surface)
  draw.clear(canvas, draw.transparent())
  index = 0
  loop {
    match editor.filter_at(doc, clip.id, index) {
      none => { break },
      some(filter) => {
        if editor.filter_enabled(doc, filter) and (only == 0 or filter == only) {
          let kind: string = editor.filter_kind(doc, filter)
          if str.eq(str.view(kind), "text") or str.eq(str.view(kind), "timer") {
            let size: f64 = filter_value(doc, clip, filter, str.view(kind), frame,
              "size", 36.0)
            if size < 4.0 or size > 200.0 { return result.err("text size is out of range") }
            let content: string = if str.eq(str.view(kind), "timer") {
              timeline.timecode(frame - clip.start, editor.sequence_fps(doc, doc.active))
            } else { editor.filter_text_param(doc, filter, "content", "") }
            if str.len(str.view(content)) != 0 {
              let scaled_size: f64 = size * cast.float(cache.height) / 856.0
              let _ = try title_font(cache, scaled_size)
              let typeface_ref: ref<font.Font> = struct.borrow(cache, field=title)
              let x_value: f64 = if str.eq(str.view(kind), "timer") { 0.0 }
                else { filter_value(doc, clip, filter, str.view(kind), frame, "x", 0.0) }
              let y_value: f64 = if str.eq(str.view(kind), "timer") { 0.0 }
                else { filter_value(doc, clip, filter, str.view(kind), frame, "y", 0.0) }
              if x_value < -1.0 or x_value > 1.0 or y_value < -1.0 or y_value > 1.0 {
                return result.err("text position is out of range")
              }
              var rows: array<string> = text.split(str.view(content), "\n")
              var row: u64 = 0
              loop {
                if row >= array.len(rows) { break }
                // Rows are authored in logical order; draw their visual order.
                let shaped: string = bidi.visual(typeface_ref, str.view(array.borrow(rows, row)))
                let line: str = str.view(shaped)
                let _ = try typeface.covered(typeface_ref, line)
                let x: f64 = if str.eq(str.view(kind), "timer") { 40.0 * cast.float(cache.width) / 1280.0 }
                  else { cast.float(cache.width) * (0.5 + 0.5 * x_value) - font.measure(typeface_ref, line) * 0.5 }
                let y: f64 = if str.eq(str.view(kind), "timer") {
                  40.0 * cast.float(cache.height) / 856.0 + cast.float(row) * scaled_size * 1.3
                } else { cast.float(cache.height) * (0.5 + 0.5 * y_value) + cast.float(row) * scaled_size * 1.3 }
                typeface.draw_label(canvas, typeface_ref, x, y, line, scaled_size)
                row = row + 1
              }
            }
          }
        }
      },
    }
    index = index + 1
  }
  var finished: draw.Surface = draw.finish(canvas)
  var rgba: bytes = draw.surface_rgba(finished)
  let output: string = if str.len(output_override) == 0 {text_raster_path(prefix, slot)}
    else {string.copy(output_override)}
  match files.write_bytes(str.view(output), bytes.view(rgba)) {
    err(problem) => { return result.err("text raster could not be written") },
    ok(_) => { },
  }
  result.ok(option.some(output))
}

// A fixed wire packs parameters by kind and cannot represent arbitrary order or
// duplicate instances. Keep its single-operator fast path; larger stacks use
// one FP32 pass per operator with fresh neutral parameters. The first pass alone
// addresses the original source frame; later passes consume FLOAT intermediates.
fn ordered_clip_plan(doc: ref<editor.Document>, clip: editor.Clip, frame: i64,
                     prefix: str, slot: u64, upper: bool, cache: ref<RenderCache>)
                     -> result<option<PreparedClip>, string> effects {alloc, fs.meta, fs.read, fs.write} {
  var count: u64 = 0
  var index: u32 = 0
  loop {
    match editor.filter_at(doc, clip.id, index) {
      none => {break}, some(filter) => {
        let kind: string = editor.filter_kind(doc, filter)
        if editor.filter_enabled(doc, filter) and picture_operator(str.view(kind)) {count=count+1}
      },
    }
    index=index+1
  }
  if count < 2 {return result.ok(option.none())}
  // Unique title rasters survive until the worker executes the prepared plan.
  // The count sidecar lets the normal frame cleanup remove only these files.
  if count > 4096 {return result.err("[GA_FILTER_STACK_LIMIT] More than 4096 picture filters on one clip")}
  match files.mkdirs(str.view(path.dirname(prefix))) {
    err(_) => {return result.err("[GA_FILTER_STACK_SCRATCH] Cannot create ordered filter scratch directory")},
    ok(_) => {},
  }
  match files.write_text(str.view(ordered_count_path(prefix,slot)),
    str.view(string.from_int(cast.sat(count)))) {
    err(_) => {return result.err("[GA_FILTER_STACK_SCRATCH] Cannot record ordered filter scratch count")},
    ok(_) => {},
  }
  var source: string = match source_path(doc, clip) {
    none => {return result.err("an ordered clip has no online video source")},
    some(value) => try picture_path(doc, clip, frame, value),
  }
  var source_at: i64 = source_frame(doc, clip, frame)
  var lines: array<string> = array.new()
  var step: u64 = 0
  index=0
  loop {
    match editor.filter_at(doc, clip.id, index) {
      none => {break}, some(filter) => {
        let kind: string = editor.filter_kind(doc, filter)
        if editor.filter_enabled(doc, filter) and picture_operator(str.view(kind)) {
          var values: array<string> = neutral()
          if upper {put(values,107,"1")}
          put(values,0,str.view(provider.wire_path(str.view(source))))
          put_i(values,2,source_at)
          if str.eq(str.view(kind),"text") or str.eq(str.view(kind),"timer") {
            let raster: string = ordered_title_path(prefix,slot,step)
            match try raster_clip_text(doc,clip,frame,prefix,slot,filter,str.view(raster),cache) {
              none => {index=index+1
                step=step+1
                continue},
              some(title) => {
                let raw_title: string = text.concat("RAW:",str.view(title))
                put(values,1,str.view(provider.wire_path(str.view(raw_title))))
              },
            }
          } else if not apply_filter(doc,clip,values,filter,false,frame) {
            return result.err("[GA_FILTER_STACK_KIND] An ordered clip uses an unsupported picture filter")
          }
          let out: string = if array.len(lines) % 2 == 0 {preclip_path(prefix,slot)}
            else {text_clip_path(prefix,slot)}
          array.push(lines,wire_line(values,"FLOAT",str.view(out)))
          source=text.concat("FLOAT:",str.view(out))
          source_at=0
          step=step+1
        }
      },
    }
    index=index+1
  }
  if array.len(lines) == 0 {return result.ok(option.none())}
  result.ok(option.some(PreparedClip {lines:lines,path:source}))
}

fn text_clip_plan(doc: ref<editor.Document>, clip: editor.Clip, frame: i64,
                  prefix: str, slot: u64, upper: bool, cache: ref<RenderCache>)
                  -> result<option<PreparedClip>, string> effects {alloc, fs.meta, fs.read, fs.write} {
  match try ordered_clip_plan(doc,clip,frame,prefix,slot,upper,cache) {
    some(prepared) => {return result.ok(option.some(prepared))}, none => {},
  }
  let title: string = match try raster_clip_text(doc, clip, frame, prefix, slot, 0, "", cache) {
    none => { return result.ok(option.none()) }, some(value) => value,
  }
  var lines: array<string> = array.new()
  let source_stage: string = preclip_path(prefix, slot)
  match try preclip_line(doc, clip, frame, str.view(source_stage), upper) {
    some(line) => { array.push(lines, line) },
    none => {
      let source: string = match source_path(doc, clip) {
        none => { return result.err("a text clip has no online video source") },
        some(value) => try picture_path(doc, clip, frame, value),
      }
      var source_values: array<string> = neutral()
      put(source_values, 0, str.view(provider.wire_path(str.view(source))))
      put_i(source_values, 2, source_frame(doc, clip, frame))
      array.push(lines, wire_line(source_values, "FLOAT", str.view(source_stage)))
    },
  }
  var combined: array<string> = neutral()
  let raw_source: string = text.concat("FLOAT:", str.view(source_stage))
  let raw_title: string = text.concat("RAW:", str.view(title))
  put(combined, 0, str.view(provider.wire_path(str.view(raw_source))))
  put(combined, 1, str.view(provider.wire_path(str.view(raw_title))))
  let final_path: string = text_clip_path(prefix, slot)
  array.push(lines, wire_line(combined, "FLOAT", str.view(final_path)))
  result.ok(option.some(PreparedClip {lines: lines,
    path: text.concat("FLOAT:", str.view(final_path))}))
}

fn append_plan(lines: ref<array<string>>, prepared: ref<PreparedClip>) -> unit effects {alloc} {
  let steps: ref<array<string>> = struct.borrow(prepared, field=lines)
  var index: u64 = 0
  loop {
    if index >= array.len(steps) { break }
    array.push(lines, string.copy(str.view(array.borrow(steps, index))))
    index = index + 1
  }
  ()
}

// Per-side overlay controls are resolved before the upper transition. Blend
// remains metadata for the stationary-lower composition in UTRANS.
pub fn transition_upper_edits_supported(doc:ref<editor.Document>,clip:editor.Clip)
    -> bool effects {alloc} {
  var at:u64=0
  loop {if at>=array.len(struct.borrow(doc,field=keys)) {break}
    let key:editor.Key=array.get(struct.borrow(doc,field=keys),at)
    if key.clip==clip.id and not key_supported(str.view(editor.name_text(doc,key.param))) {return false}
    at=at+1
  }
  var index:u32=0
  loop {match editor.filter_at(doc,clip.id,index) {
    none=>{break},some(filter)=>{
      if editor.filter_enabled(doc,filter) {
        let kind:string=editor.filter_kind(doc,filter)
        if kind=="size_position" and editor.filter_param(doc,filter,"rotation",0.0)!=0.0 {return false}
      }
    },
  }
  index=index+1}
  true
}

type UpperSide = struct {lines:array<string>,path:string,blend:string}
fn upper_side_plan(doc:ref<editor.Document>,clip:editor.Clip,frame:i64,
    prefix:str,slot:u64,output:str,cache:ref<RenderCache>)
    -> result<UpperSide,string> effects {alloc,fs.meta,fs.read,fs.write} {
  if not transition_upper_edits_supported(doc,clip) or clip.nested!=0 or not source_range_ok(doc,clip) {
    return result.err("[GA_VIDEO_TRANSITION_SIDE] Invalid upper transition side")
  }
  var lines:array<string> = array.new()
  var source:string=match source_path(doc,clip) {
    none=>{return result.err("[GA_VIDEO_TRANSITION_SOURCE] Upper transition side is offline")},
    some(value)=>try picture_path(doc,clip,frame,value),
  }
  var prepassed:bool=false
  match try text_clip_plan(doc,clip,frame,prefix,slot,true,cache) {
    some(value)=>{var prepared:PreparedClip=value
      source=string.copy(str.view(prepared.path))
      append_plan(lines,prepared)
      prepassed=true},
    none=>{let raster:string=preclip_path(prefix,slot)
      match try preclip_line(doc,clip,frame,str.view(raster),true) {
        none=>{},some(line)=>{array.push(lines,line)
          source=text.concat("FLOAT:",str.view(raster))
          prepassed=true},
      }
    },
  }
  var values:array<string> = neutral()
  put(values,1,str.view(provider.wire_path(str.view(source))))
  put_i(values,3,if prepassed {0}else{source_frame(doc,clip,frame)})
  let factor:f64=clip_factor(doc,clip,frame)
  if not math.is_finite(factor) or factor<0.0 or factor>1.0 {
    return result.err("[GA_VIDEO_TRANSITION_SIDE] Invalid upper side opacity")
  }
  put_f(values,4,factor)
  if not filters(doc,clip,values,true,frame,prepassed) {
    return result.err("[GA_VIDEO_TRANSITION_FILTER] Unsupported upper side filter")
  }
  let blend:string=string.copy(str.view(array.borrow(values,5)))
  put(values,5,"0")
  // A missing base is transparent in compound mode. PiP and keying affect this
  // side alone; ordered grades/titles have already run before its placement.
  array.push(lines,wire_line(values,"FLOAT",output))
  result.ok(UpperSide {lines:lines,path:string.copy(output),blend:blend})
}

// Upper transitions operate on a straight-alpha lane before that lane is
// composited over the lower picture. Sliding or zooming this lane must leave the
// lower image stationary. The surrounding compound canvas owns alpha semantics.
// The controller admits an upper seam when a lower picture intersects ANY part
// of its authored window. Keep that role throughout the window: a temporary
// lower gap is transparent, never a different base-transition policy.
fn transition_lower_span(doc:ref<editor.Document>,transition:editor.Transition) -> bool effects {alloc} {
  let chosen_slot:u64=match editor.track_slot(doc,transition.track) {none=>{return false},some(value)=>value,}
  let chosen:ref<editor.Track> =array.borrow(struct.borrow(doc,field=tracks),chosen_slot)
  let chosen_order:u32=chosen.order
  let chosen_id:u64=chosen.id
  if transition.duration<2 or transition.center<transition.duration/2 or
     transition.center>9223372036854775807-(transition.duration-transition.duration/2) {return false}
  let start:i64=editor.transition_start(transition)
  let end:i64=editor.transition_end(transition)
  var at:u64=0
  loop {if at>=editor.clip_count(doc) {break}
    let clip:editor.Clip=array.get(struct.borrow(doc,field=clips),at)
    at=at+1
    if clip.owner!=doc.active or not clip.enabled or not editor.clip_has_video(clip) or
       clip.start>=end or editor.clip_end(clip)<=start {continue}
    let slot:u64=match editor.track_slot(doc,clip.track) {none=>{continue},some(value)=>value,}
    let lane:ref<editor.Track> =array.borrow(struct.borrow(doc,field=tracks),slot)
    let lower_kind:u32=lane.kind
    let lower_order:u32=lane.order
    let lower_id:u64=lane.id
    if lower_kind==editor.track_video() and editor.track_visible(doc,lower_id) and
       (lower_order<chosen_order or (lower_order==chosen_order and lower_id<chosen_id)) {return true}
  }
  at=0
  loop {if at>=editor.transition_count(doc) {break}
    let value:editor.Transition=array.get(struct.borrow(doc,field=transitions),at)
    at=at+1
    if value.duration<2 or value.center<value.duration/2 or
       value.center>9223372036854775807-(value.duration-value.duration/2) {continue}
    if value.owner!=doc.active or editor.transition_start(value)>=end or editor.transition_end(value)<=start {continue}
    let slot:u64=match editor.track_slot(doc,value.track) {none=>{continue},some(value)=>value,}
    let lane:ref<editor.Track> =array.borrow(struct.borrow(doc,field=tracks),slot)
    let lower_kind:u32=lane.kind
    let lower_order:u32=lane.order
    let lower_id:u64=lane.id
    if lower_kind!=editor.track_video() or not editor.track_visible(doc,lower_id) or
       not (lower_order<chosen_order or (lower_order==chosen_order and lower_id<chosen_id)) {continue}
    match transition_pair(doc,lower_id,value.center) {none=>{},some(pair)=>{
      if pair.outgoing.enabled and pair.incoming.enabled and editor.clip_has_video(pair.outgoing) and editor.clip_has_video(pair.incoming) {return true}
    },}
  }
  false
}
fn upper_lane_at(doc:ref<editor.Document>,track:u64,frame:i64) -> bool effects {alloc} {
  match picture_transition_at(doc,track,frame) {none=>false,some(id)=>{
    match editor.transition(doc,id) {none=>false,some(value)=>transition_lower_span(doc,value),}
  },}
}
fn clip_needs_alpha_composition(doc:ref<editor.Document>,clip:editor.Clip) -> bool effects {alloc} {
  var at:u32=0
  loop {match editor.filter_at(doc,clip.id,at) {none=>{break},some(id)=>{
    if editor.filter_enabled(doc,id) {
      let kind:string=editor.filter_kind(doc,id)
      if kind=="blend" or kind=="size_position" or kind=="chroma_key" {return true}
    }
  },}
  at=at+1}
  false
}
fn upper_transition_requested(doc:ref<editor.Document>,frame:i64) -> bool effects {alloc} {
  var lower:bool=false
  var lanes:array<u64> =editor_view.lanes(doc,doc.active)
  var at:u64=0
  loop {if at>=array.len(lanes) {break}
    let track:u64=array.get(lanes,at)
    if editor.track_kind(doc,track)==editor.track_video() and editor.track_visible(doc,track) {
      if upper_lane_at(doc,track,frame) {return true}
      match composited_clip(doc,track,frame) {none=>{},some(clip)=>{
        // A static overlay with no current lower picture composes against
        // transparent. No persistent transition role is invented for it.
        if not lower and clip_needs_alpha_composition(doc,clip) {
          match picture_transition_at(doc,track,frame) {none=>{return true},some(_)=>{},}
        }
        lower=true
      },}
    }
    at=at+1
  }
  false
}

fn isolated_picture_lane(doc:ref<editor.Document>,track:u64) -> editor.Document effects {alloc} {
  var isolated:editor.Document=editor.copy_document(doc)
  var at:u64=0
  loop {if at>=array.len(struct.borrow(isolated,field=tracks)) {break}
    let value:ref<editor.Track> =array.borrow(struct.borrow(isolated,field=tracks),at)
    if value.owner==doc.active and value.kind==editor.track_video() {
      struct.set(value,value.id!=track,field=hidden)
      struct.set(value,false,field=solo)
    }
    at=at+1
  }
  isolated
}

fn append_lines(lines:ref<array<string>>,prepared:ref<array<string>>) -> unit effects {alloc} {
  var at:u64=0
  loop {if at>=array.len(prepared) {break}
    array.push(lines,string.copy(str.view(array.borrow(prepared,at))))
    at=at+1
  }
  ()
}

fn upper_transition_plan(doc:ref<editor.Document>,frame:i64,kind:str,out:str,
    prefix:str,cache:ref<RenderCache>) -> result<array<string>,string>
    effects {alloc,fs.meta,fs.read,fs.write} {
  var visible:array<editor.Clip> =array.new()
  var lanes:array<u64> =editor_view.lanes(doc,doc.active)
  var at:u64=0
  loop {if at>=array.len(lanes) {break}
    let track:u64=array.get(lanes,at)
    if editor.track_kind(doc,track)==editor.track_video() and editor.track_visible(doc,track) {
      match composited_clip(doc,track,frame) {none=>{},some(clip)=>{array.push(visible,clip)},}
    }
    at=at+1
  }
  if array.len(visible)==0 or array.len(visible)>4096 {
    return result.err("[GA_VIDEO_TRANSITION_CAPACITY] Invalid upper transition lane count")
  }
  match files.mkdirs(path.dirname(prefix)) {err(_)=>{return result.err("[GA_VIDEO_TRANSITION_SCRATCH] Cannot create lane scratch")},ok(_)=>{},}
  match files.write_text(text.concat(prefix,".lane-count"),string.from_int(cast.sat(array.len(visible)))) {
    err(_)=>{return result.err("[GA_VIDEO_TRANSITION_SCRATCH] Cannot record lane rasters")},ok(_)=>{},
  }
  let first:editor.Clip=array.get(visible,0)
  let first_prefix:string=text.concat(prefix,".lane-0")
  var previous:string=text.concat(str.view(first_prefix),".output.rgba")
  var lines:array<string> =array.new()
  var layer:u64=0
  let transparent_first:bool=upper_lane_at(doc,first.track,frame) or
    (clip_needs_alpha_composition(doc,first) and match picture_transition_at(doc,first.track,frame) {none=>true,some(_)=>false,})
  if transparent_first {
    var clear:array<string> =neutral()
    put(clear,107,"1")
    array.push(lines,wire_line(clear,"FLOAT",str.view(previous)))
  }else{
    var base_doc:editor.Document=isolated_picture_lane(doc,first.track)
    lines=try media_plan(base_doc,frame,"FLOAT",str.view(previous),str.view(first_prefix),cache)
    layer=1
  }
  loop {if layer>=array.len(visible) {break}
    let clip:editor.Clip=array.get(visible,layer)
    let lane_prefix:string=text.concat(text.concat(prefix,".lane-"),string.from_int(cast.sat(layer)))
    var values:array<string> =neutral()
    put(values,0,str.view(provider.wire_path(text.concat("FLOAT:",str.view(previous)))))
    match picture_transition_at(doc,clip.track,frame) {
      some(id)=>{
        let transition:editor.Transition=match editor.transition(doc,id) {
          none=>{return result.err("[GA_VIDEO_TRANSITION_SIDE] Missing upper transition")},some(value)=>value,
        }
        let pair:TransitionPair=match transition_pair(doc,clip.track,transition.center) {
          none=>{return result.err("[GA_VIDEO_TRANSITION_SIDE] Missing upper transition pair")},some(value)=>value,
        }
        let worker_kind:i64=transition_kind(str.view(editor.name_text(doc,transition.kind)))
        if worker_kind<0 {return result.err("[GA_VIDEO_TRANSITION_SIDE] Unsupported upper transition kind")}
        let outgoing_path:string=text.concat(str.view(lane_prefix),".side-out.rgba")
        let incoming_path:string=text.concat(str.view(lane_prefix),".side-in.rgba")
        var outgoing:UpperSide=try upper_side_plan(doc,pair.outgoing,frame,str.view(lane_prefix),0,str.view(outgoing_path),cache)
        var incoming:UpperSide=try upper_side_plan(doc,pair.incoming,frame,str.view(lane_prefix),1,str.view(incoming_path),cache)
        append_lines(lines,struct.borrow(outgoing,field=lines))
        append_lines(lines,struct.borrow(incoming,field=lines))
        let next:string=layer_path(prefix,layer%2)
        var fields:array<string> = ["UTRANS",
          provider.wire_path(text.concat("FLOAT:",str.view(previous))),
          provider.wire_path(text.concat("FLOAT:",str.view(outgoing.path))),
          provider.wire_path(text.concat("FLOAT:",str.view(incoming.path))),
          string.from_int(worker_kind),string.from_float(editor.transition_progress(transition,frame)),"4",
          string.copy(str.view(outgoing.blend)),string.copy(str.view(incoming.blend)),provider.wire_path(str.view(next))]
        array.push(lines,text.join(fields," "))
        previous=next
        layer=layer+1
        continue
      },
      none=>{
        if clip.nested!=0 or not source_range_ok(doc,clip) {
          return result.err("[GA_VIDEO_TRANSITION_SOURCE] Invalid upper clip source")
        }
        var path:string=match source_path(doc,clip) {
          none=>{return result.err("[GA_VIDEO_TRANSITION_SOURCE] Upper clip is offline")},
          some(value)=>try picture_path(doc,clip,frame,value),
        }
        var prepassed:bool=false
        match try text_clip_plan(doc,clip,frame,str.view(lane_prefix),0,true,cache) {
          some(value)=>{var prepared:PreparedClip=value
            path=string.copy(str.view(prepared.path))
            append_plan(lines,prepared)
            prepassed=true},
          none=>{let raster:string=preclip_path(str.view(lane_prefix),0)
            match try preclip_line(doc,clip,frame,str.view(raster),true) {
              none=>{},some(line)=>{array.push(lines,line)
                path=text.concat("FLOAT:",str.view(raster))
                prepassed=true},
            }
          },
        }
        put(values,1,str.view(provider.wire_path(str.view(path))))
        put_i(values,3,if prepassed {0}else{source_frame(doc,clip,frame)})
        put_f(values,4,clip_factor(doc,clip,frame))
        if not filters(doc,clip,values,true,frame,prepassed) {
          return result.err("[GA_VIDEO_TRANSITION_FILTER] Upper clip uses an unsupported filter")
        }
      },
    }
    let next:string=layer_path(prefix,layer%2)
    array.push(lines,wire_line(values,"FLOAT",str.view(next)))
    previous=next
    layer=layer+1
  }
  var final:array<string> =neutral()
  put(final,0,str.view(provider.wire_path(text.concat("FLOAT:",str.view(previous)))))
  array.push(lines,wire_line(final,kind,out))
  result.ok(lines)
}

// Fold visible lanes bottom to top. The worker accepts RAW: RGBA as a base, so each
// PREVIEW output becomes the next input. ENC then consumes the completed raw frame.
fn media_plan(doc: ref<editor.Document>, frame: i64, kind: str, out: str,
              scratch_prefix: str, cache: ref<RenderCache>)
              -> result<array<string>, string> effects {alloc, fs.meta, fs.read, fs.write} {
  if upper_transition_requested(doc,frame) {return upper_transition_plan(doc,frame,kind,out,scratch_prefix,cache)}
  var visible: array<editor.Clip> = array.new()
  var lanes: array<u64> = editor_view.lanes(doc, doc.active)
  var at: u64 = 0
  loop {
    if at >= array.len(lanes) { break }
    let track: u64 = array.get(lanes, at)
    if editor.track_kind(doc, track) == editor.track_video() and editor.track_visible(doc, track) {
      match composited_clip(doc, track, frame) {
        none => { },
        some(clip) => { array.push(visible, clip) },
      }
    }
    at = at + 1
  }
  var lines: array<string> = array.new()
  var base_override: string = string.new()
  var upper_override: string = string.new()
  var incoming_override: string = string.new()
  let incoming_slot: u64 = array.len(visible)
  var base_fade_prepassed: bool = false
  var base_transition: bool = false
  if array.len(visible) >= 1 {
    let base: editor.Clip = array.get(visible, 0)
    base_transition=match picture_transition_at(doc,base.track,frame) {none=>false,some(_)=>true,}
    match try text_clip_plan(doc, base, frame, scratch_prefix, 0, false, cache) {
      none => {
        // Apply the bottom clip's picture effects before transitions or upper layers.
        // A final composite grade would also change the incoming clip or upper layers.
        if base_transition or array.len(visible) >= 2 {
          let raster: string = preclip_path(scratch_prefix,0)
          match try preclip_line(doc,base,frame,str.view(raster),false) {
            none=>{},some(line)=>{array.push(lines,line)
              base_override=text.concat("FLOAT:",str.view(raster))},
          }
        }
      },
      some(value) => { var prepared: PreparedClip = value
        base_override = string.copy(str.view(prepared.path))
        append_plan(lines, prepared) },
    }
  }
  // Rasters are produced while the whole frame plan is assembled. Every visible
  // camera and the incoming transition half therefore need distinct slot ids;
  // reusing slot 2 would overwrite a previous camera's titles before execution.
  let used_slots: u64 = array.len(visible) + if base_transition {1}else{0}
  if used_slots > 4097 {return result.err("[GA_FILTER_STACK_LIMIT] More than 4097 prepared picture slots")}
  if used_slots > 4 {
    match files.write_text(str.view(text.concat(scratch_prefix,".prepared-count")),
      str.view(string.from_int(cast.sat(used_slots)))) {
      err(_) => {return result.err("[GA_FILTER_STACK_SCRATCH] Cannot record prepared picture slots")},
      ok(_) => {},
    }
  }
  // The worker's fade field fades its complete output. Resolve a bottom clip's
  // fade/opacity before its transition and before upper cameras or overlays.
  if array.len(visible) >= 2 or base_transition {
    let base: editor.Clip = array.get(visible, 0)
    let factor: f64 = clip_factor(doc,base,frame)
    if factor != 1.0 {
      var values: array<string> = neutral()
      let prepassed: bool = str.len(str.view(base_override)) != 0
      let source: string = if prepassed { string.copy(str.view(base_override)) } else {
        match source_path(doc, base) { some(value) => try picture_path(doc, base, frame, value),
          none => { return result.err("a visible base clip has no online video source") }, }
      }
      put(values, 0, str.view(provider.wire_path(str.view(source))))
      put_i(values, 2, if prepassed { 0 } else { source_frame(doc, base, frame) })
      put_f(values, 101, factor)
      if not filters(doc, base, values, false, frame, prepassed) {
        return result.err("a visible base clip uses an unsupported video filter")
      }
      let raster: string = text.concat(scratch_prefix, ".base-opacity.rgba")
      array.push(lines, wire_line(values, "FLOAT", str.view(raster)))
      base_override = text.concat("FLOAT:", str.view(raster))
      base_fade_prepassed = true
    }
  }
  if array.len(visible) >= 2 {
    let upper: editor.Clip = array.get(visible, 1)
    match try text_clip_plan(doc, upper, frame, scratch_prefix, 1, true, cache) {
      some(value) => { var prepared: PreparedClip = value
        upper_override = string.copy(str.view(prepared.path))
        append_plan(lines, prepared) },
      none => {
        let raster: string = preclip_path(scratch_prefix, 1)
        match try preclip_line(doc, upper, frame, str.view(raster), true) {
          none => { },
          some(line) => {
            array.push(lines, line)
            upper_override = text.concat("FLOAT:", str.view(raster))
          },
        }
      },
    }
  }
  if array.len(visible) >= 1 {
    let base: editor.Clip = array.get(visible, 0)
    match picture_transition_at(doc, base.track, frame) {
      none => { },
      some(id) => {
        let transition: editor.Transition = match editor.transition(doc, id) {
          none => { return result.err("the transition could not be resolved") },
          some(value) => value,
        }
        let pair: TransitionPair = match transition_pair(doc, base.track, transition.center) {
          none => { return result.err("transition needs an adjacent clip pair at its seam") },
          some(value) => value,
        }
        let incoming: editor.Clip = pair.incoming
        match try text_clip_plan(doc, incoming, frame, scratch_prefix, incoming_slot, false, cache) {
          some(value) => { var prepared: PreparedClip = value
            incoming_override = string.copy(str.view(prepared.path))
            append_plan(lines, prepared) },
          none => {
            let raster: string = preclip_path(scratch_prefix, incoming_slot)
            match try preclip_line(doc, incoming, frame, str.view(raster), false) {
              none => { },
              some(line) => {
                array.push(lines, line)
                incoming_override = text.concat("FLOAT:", str.view(raster))
              },
            }
          },
        }
        let factor: f64 = clip_factor(doc,incoming,frame)
        if factor != 1.0 {
          var values: array<string> = neutral()
          let prepassed: bool = str.len(str.view(incoming_override)) != 0
          let source: string = if prepassed {string.copy(str.view(incoming_override))}else{
            match source_path(doc,incoming) {
              some(value)=>try picture_path(doc,incoming,frame,value),
              none=>{return result.err("the transition's incoming source is unavailable")},
            }
          }
          put(values,0,str.view(provider.wire_path(str.view(source))))
          put_i(values,2,if prepassed {0}else{source_frame(doc,incoming,frame)})
          put_f(values,101,factor)
          if not filters(doc,incoming,values,false,frame,prepassed) {
            return result.err("the transition's incoming clip uses an unsupported video filter")
          }
          let raster: string = text.concat(scratch_prefix,".incoming-opacity.rgba")
          array.push(lines,wire_line(values,"FLOAT",str.view(raster)))
          incoming_override=text.concat("FLOAT:",str.view(raster))
        }
      },
    }
  }
  if array.len(visible) <= 2 {
    array.push(lines, try frame_line_core(doc, frame, kind, out, true,
      str.view(base_override), str.view(upper_override), str.view(incoming_override), base_fade_prepassed))
    return result.ok(lines)
  }
  let first_out: string = layer_path(scratch_prefix, 0)
  array.push(lines, try frame_line_core(doc, frame, "FLOAT", str.view(first_out), false,
    str.view(base_override), str.view(upper_override), str.view(incoming_override), base_fade_prepassed))
  var layer: u64 = 2
  var previous: string = first_out
  loop {
    if layer >= array.len(visible) { break }
    let clip: editor.Clip = array.get(visible, layer)
    match picture_transition_at(doc, clip.track, frame) {
      some(id) => { return result.err("a transition above the base lane is not rendered yet") },
      none => { },
    }
    if clip.nested != 0 { return result.err("nested sequences are not rendered yet") }
    if not source_range_ok(doc, clip) {
      return result.err("clip speed and length exceed its source frames")
    }
    var key_index: u64 = 0
    loop {
      if key_index >= array.len(struct.borrow(doc, field=keys)) { break }
      let key: editor.Key = array.get(struct.borrow(doc, field=keys), key_index)
      if key.clip == clip.id and not key_supported(str.view(editor.name_text(doc, key.param))) {
        return result.err("a visible clip has unsupported keyframed video effects")
      }
      key_index = key_index + 1
    }
    var path: string = match source_path(doc, clip) {
      some(value) => try picture_path(doc, clip, frame, value),
      none => { return result.err("a visible clip has no online video source") },
    }
    var prepassed: bool = false
    match try text_clip_plan(doc, clip, frame, scratch_prefix, layer, true, cache) {
      some(value) => { var prepared: PreparedClip = value
        path = string.copy(str.view(prepared.path))
        append_plan(lines, prepared)
        prepassed = true },
      none => {
        let raster: string = preclip_path(scratch_prefix, layer)
        match try preclip_line(doc, clip, frame, str.view(raster), true) {
          none => { },
          some(line) => {
            array.push(lines, line)
            path = text.concat("FLOAT:", str.view(raster))
            prepassed = true
          },
        }
      },
    }
    var values: array<string> = neutral()
    var raw_base: string = text.concat("FLOAT:", str.view(previous))
    put(values, 0, str.view(provider.wire_path(str.view(raw_base))))
    put(values, 1, str.view(provider.wire_path(str.view(path))))
    put_i(values, 3, if prepassed { 0 } else { source_frame(doc, clip, frame) })
    put_f(values, 4, fade(doc, clip, frame) *
      picture_clip_value_at(doc, clip.id, "opacity", frame, 1.0) *
      overlay_opacity(doc, clip, frame))
    if not filters(doc, clip, values, true, frame, prepassed) {
      return result.err("a visible clip uses an unsupported video filter")
    }
    let last: bool = layer + 1 == array.len(visible)
    let stage_out: string = if last and not str.eq(kind, "ENC") { string.copy(out) }
      else { layer_path(scratch_prefix, (layer - 1) % 2) }
    array.push(lines, wire_line(values, if last and str.eq(kind, "PREVIEW") { "PREVIEW" } else { "FLOAT" }, str.view(stage_out)))
    previous = stage_out
    layer = layer + 1
  }
  if str.eq(kind, "ENC") {
    var values: array<string> = neutral()
    var raw_base: string = text.concat("FLOAT:", str.view(previous))
    put(values, 0, str.view(provider.wire_path(str.view(raw_base))))
    array.push(lines, wire_line(values, "ENC", ""))
  }
  result.ok(lines)
}

// What one preview or export reuses between frames. Fonts are rebuilt only when their pixel
// size changes (a two-face load is under 2 ms, so an animated size stays cheap).
pub type RenderCache = struct {
  width: u32, height: u32,
  subtitle: u64,
  validated_luts: array<string>,
  fonts: array<string>,
  title_px: u64,
  title: font.Font,
  caption_px: u64,
  caption: font.Font
}

pub fn render_cache(fonts: ref<array<string>>) -> RenderCache effects {alloc} {
  var paths: array<string> = array.new()
  var i: u64 = 0
  loop {
    if i >= array.len(fonts) { break }
    array.push(paths, string.copy(str.view(array.borrow(fonts, i))))
    i = i + 1
  }
  RenderCache {width: 1280, height: 856, subtitle: 0, validated_luts: array.new(), fonts: paths,
    title_px: 0, title: font.new(1), caption_px: 0, caption: font.new(1)}
}

pub fn configure_preview(doc: ref<editor.Document>, cache: ref<RenderCache>)
                          -> unit effects {alloc, process, time} {
  configure_monitor_preview(doc,cache,1280,720)
}

// Only operations whose coordinates and parameters are independent of pixel
// size may use a smaller composition canvas. Unknown/new effects retain native
// sequence pixels until their spatial contract has been established. Inspect all
// enabled filters conservatively, including transition halves and nested clips.
fn monitor_independent(kind: str) -> bool effects {alloc} {
  chrome.is_audio_kind(kind) or kind == "text" or kind == "timer" or
    kind == "speed" or kind == "opacity" or kind == "blend" or
    kind == "size_position" or kind == "brightness" or kind == "contrast" or
    kind == "saturation" or kind == "hue" or kind == "gamma" or kind == "levels" or
    kind == "vignette" or kind == "lift_gamma_gain" or kind == "rotate" or
    kind == "flip" or kind == "mirror" or kind == "invert" or kind == "sepia" or
    kind == "mono" or kind == "crop" or kind == "mask" or kind == "chroma_key" or
    kind == "white_balance" or kind == "lut3d"
}

// Transition kernels use working-pixel soft edges or round source/mask
// coordinates before the final monitor fit. Only pointwise mixing is proven
// independent of this canvas. Unknown kinds stay conservative and are still
// refused by the authoritative frame planner.
fn active_spatial_transition(doc: ref<editor.Document>) -> bool effects {alloc} {
  var lanes: array<u64> = editor_view.lanes(doc,doc.active)
  var at: u64 = 0
  loop {
    if at >= array.len(lanes) {break}
    let track: u64 = array.get(lanes,at)
    if editor.track_kind(doc,track) == editor.track_video() and editor.track_visible(doc,track) {
      match picture_transition_at(doc,track,editor.playhead(doc)) {
        none=>{},
        some(id)=>{
          match editor.transition(doc,id) {
            none=>{return true},
            some(value)=>{
              let kind: string = editor.name_text(doc,value.kind)
              if not str.eq(str.view(kind),"crossfade") and not str.eq(str.view(kind),"dissolve") {
                return true
              }
            },
          }
        },
      }
    }
    at=at+1
  }
  false
}

fn canvas_gcd(width: u32, height: u32) -> u32 effects {} {
  var first: u32 = width
  var second: u32 = height
  loop {
    if second == 0 {break}
    let remainder: u32 = first % second
    first=second
    second=remainder
  }
  first
}

pub fn configure_monitor_preview(doc: ref<editor.Document>, cache: ref<RenderCache>,
    monitor_width: u32, monitor_height: u32) -> unit effects {alloc, process, time} {
  var native: bool = nested_picture_requested(doc)
  var index: u64 = 0
  loop {
    if index >= array.len(struct.borrow(doc,field=filters)) {break}
    let filter: ref<editor.Filter> = array.borrow(struct.borrow(doc,field=filters),index)
    if filter.enabled and not monitor_independent(str.view(struct.borrow(filter,field=kind))) {
      match editor.clip(doc,filter.clip) {
        none=>{},some(clip)=>{if editor.clip_has_video(clip) {
          native = true
          break
        }},
      }
    }
    index = index+1
  }
  if not native {native=active_spatial_transition(doc)}
  match editor.sequence_slot(doc, doc.active) {
    none => {},
    some(slot) => {
      let seq: ref<editor.Sequence> = array.borrow(struct.borrow(doc, field=sequences), slot)
      // Keep small sequences at their own resolution. Only the fitted monitor
      // enlarges them; rendering effects on an enlarged canvas wastes each frame.
      // Native spatial filters preserve their physical radius, texture and
      // sampling semantics. Pointwise color/normalized geometry/title previews
      // compose only the pixels the ordinary monitor can display.
      let factor: f64 = if native {1.0} else {math.min(1.0,
        math.min(cast.float(monitor_width) / cast.float(seq.width),
          cast.float(monitor_height) / cast.float(seq.height)))}
      var width: u32 = cast.sat(math.max(16.0, math.round(cast.float(seq.width) * factor)))
      var height: u32 = cast.sat(math.max(16.0, math.round(cast.float(seq.height) * factor)))
      if not native and factor < 1.0 {
        // The decoder fits to even inner dimensions. An independently rounded
        // canvas can introduce extra bars (portrait 152x270 -> inner150x270).
        // Prefer exact aspect with both axes even, never enlarging the sequence.
        // Irreducible large odd ratios may have no fitting unit; retain the
        // existing bounded rounded canvas in that case.
        let divisor: u32 = canvas_gcd(seq.width,seq.height)
        if divisor != 0 {
          let unit_width: u32 = seq.width / divisor
          let unit_height: u32 = seq.height / divisor
          var multiple: u32 = if unit_width != 0 and unit_height != 0 {
            cast.sat(math.min(cast.float(monitor_width / unit_width),cast.float(monitor_height / unit_height)))
          }else{0}
          multiple=multiple-(multiple % 2)
          if multiple >= 2 and unit_width*multiple >= 16 and unit_height*multiple >= 16 {
            width=unit_width*multiple
            height=unit_height*multiple
          }
        }
      }
      struct.set(cache, width, field=width)
      struct.set(cache, height, field=height)
    },
  }
  ()
}

fn title_font(cache: ref<RenderCache>, cap_height: f64) -> result<unit, string>
              effects {alloc, fs.meta, fs.read} {
  let px: u64 = typeface.px_for(cap_height)
  if cache.title_px == px { return result.ok(()) }
  let loaded: font.Font = try typeface.load(struct.borrow(cache, field=fonts), px)
  let _ = struct.replace(cache, loaded, field=title)
  struct.set(cache, px, field=title_px)
  result.ok(())
}

fn caption_font(cache: ref<RenderCache>, cap_height: f64) -> result<unit, string>
                effects {alloc, fs.meta, fs.read} {
  let px: u64 = typeface.px_for(cap_height)
  if cache.caption_px == px { return result.ok(()) }
  let loaded: font.Font = try typeface.load(struct.borrow(cache, field=fonts), px)
  let _ = struct.replace(cache, loaded, field=caption)
  struct.set(cache, px, field=caption_px)
  result.ok(())
}

fn cube_fields(line: str) -> array<string> effects {alloc} {
  let spaced: string = text.replace(line, "\t", " ")
  var pieces: array<string> = text.split(str.view(spaced), " ")
  var out: array<string> = array.new()
  var index: u64 = 0
  loop {
    if index >= array.len(pieces) { break }
    let piece: str = str.view(array.borrow(pieces, index))
    if str.len(piece) != 0 { array.push(out, string.copy(piece)) }
    index = index + 1
  }
  out
}

// Match the subset of .cube that the worker actually applies: one 3D grid of at
// most 33 samples per axis, RGB triples, and the worker's fixed [0,1] domain.
fn valid_cube(content: str) -> bool effects {alloc} {
  var lines: array<string> = text.lines(content)
  var size: u64 = 0
  var samples: u64 = 0
  var line_index: u64 = 0
  loop {
    if line_index >= array.len(lines) { break }
    let trimmed: string = text.trim(str.view(array.borrow(lines, line_index)))
    line_index = line_index + 1
    if str.len(str.view(trimmed)) == 0 or str.starts_with(str.view(trimmed), "#") {
      continue
    }
    var parts: array<string> = cube_fields(str.view(trimmed))
    if array.len(parts) == 0 { continue }
    let first: str = str.view(array.borrow(parts, 0))
    if str.eq(first, "TITLE") { continue }
    if str.eq(first, "LUT_1D_SIZE") { return false }
    if str.eq(first, "LUT_3D_SIZE") {
      if size != 0 or array.len(parts) < 2 { return false }
      size = match text.parse_u64(str.view(array.borrow(parts, 1))) {
        none => { return false }, some(value) => value,
      }
      if size < 2 or size > 33 { return false }
      continue
    }
    if str.eq(first, "DOMAIN_MIN") or str.eq(first, "DOMAIN_MAX") {
      if array.len(parts) < 4 { return false }
      let expected: f64 = if str.eq(first, "DOMAIN_MIN") { 0.0 } else { 1.0 }
      var channel: u64 = 1
      loop {
        if channel > 3 { break }
        let value: f64 = match text.parse_f64(str.view(array.borrow(parts, channel))) {
          none => { return false }, some(number) => number,
        }
        if value != expected { return false }
        channel = channel + 1
      }
      continue
    }
    if size == 0 or array.len(parts) < 3 { return false }
    var channel: u64 = 0
    loop {
      if channel == 3 { break }
      let value: f64 = match text.parse_f64(str.view(array.borrow(parts, channel))) {
        none => { return false }, some(number) => number,
      }
      if not math.is_finite(value) { return false }
      channel = channel + 1
    }
    samples = samples + 1
    if samples > size * size * size { return false }
  }
  size != 0 and samples == size * size * size
}

fn validate_lut_paths(doc: ref<editor.Document>, frame: i64, cache: ref<RenderCache>)
                      -> result<unit, string> effects {alloc, fs.meta, fs.read} {
  var clip_index: u64 = 0
  loop {
    match editor.clip_at(doc, clip_index) {
      none => { break },
      some(clip) => {
        if clip.owner == doc.active and clip.enabled and editor.clip_has_video(clip) and clip.start <= frame and
           editor.clip_end(clip) > frame and editor.track_kind(doc,clip.track) == editor.track_video() and
           editor.track_visible(doc, clip.track) {
          var filter_index: u32 = 0
          loop {
            match editor.filter_at(doc, clip.id, filter_index) {
              none => { break },
              some(filter) => {
                let kind: string = editor.filter_kind(doc, filter)
                if editor.filter_enabled(doc, filter) and str.eq(str.view(kind), "lut3d") {
                  let lut: string = editor.filter_text_param(doc, filter, "path", "")
                  if str.len(str.view(lut)) != 0 {
                    var cached: bool = false
                    var cache_index: u64 = 0
                    loop {
                      if cache_index >= array.len(struct.borrow(cache, field=validated_luts)) { break }
                      if str.eq(str.view(array.borrow(struct.borrow(cache, field=validated_luts), cache_index)),
                        str.view(lut)) { cached = true
                        break }
                      cache_index = cache_index + 1
                    }
                    if cached { filter_index = filter_index + 1
                      continue }
                    let exists: bool = match files.is_file(str.view(lut)) {
                      err(problem) => { return result.err("LUT file is unavailable") },
                      ok(value) => value,
                    }
                    if not exists { return result.err("LUT path is not a file") }
                    let bytes: u64 = match files.file_size(str.view(lut)) {
                      err(problem) => { return result.err("LUT file is unavailable") },
                      ok(value) => value,
                    }
                    if bytes > 16777216 { return result.err("LUT file is too large") }
                    let source: string = match files.read_text(str.view(lut)) {
                      err(problem) => { return result.err("LUT file cannot be read") },
                      ok(value) => value,
                    }
                    if not valid_cube(str.view(source)) {
                      return result.err("LUT file is not a supported 3D .cube grid")
                    }
                    array.push(struct.borrow(cache, field=validated_luts), lut)
                  }
                }
              },
            }
            filter_index = filter_index + 1
          }
        }
      },
    }
    clip_index = clip_index + 1
  }
  result.ok(())
}

fn subtitle_path(prefix: str) -> string effects {alloc} {
  text.concat(prefix, ".subtitle.rgba")
}

fn raster_subtitle(doc: ref<editor.Document>, id: u64, prefix: str,
                   cache: ref<RenderCache>) -> result<string, string> effects {alloc, fs.meta, fs.read, fs.write} {
  let raster_file: string = subtitle_path(prefix)
  if cache.subtitle == id { return result.ok(raster_file) }
  match files.mkdirs(str.view(path.dirname(prefix))) {
    err(problem) => { return result.err("subtitle scratch directory could not be created") },
    ok(_) => { },
  }
  var surface: draw.Surface = match draw.surface(cache.width, cache.height) {
    none => { return result.err("subtitle surface could not be allocated") },
    some(value) => value,
  }
  var canvas: draw.Canvas = draw.canvas(surface)
  draw.clear(canvas, draw.transparent())
  let caption: string = editor.subtitle_text(doc, id)
  var rows: array<string> = text.split(str.view(caption), "\n")
  let caption_scale: f64 = cast.float(cache.height) / 856.0
  let _ = try caption_font(cache, 44.0 * caption_scale)
  let typeface_ref: ref<font.Font> = struct.borrow(cache, field=caption)
  var at: u64 = 0
  loop {
    if at >= array.len(rows) { break }
    let logical: str = str.view(array.borrow(rows, at))
    let shaped: string = bidi.visual(typeface_ref, logical)
    let line: str = str.view(shaped)
    let _ = try typeface.covered(typeface_ref, line)
    let y: f64 = (720.0 + cast.float(at) * 48.0) * caption_scale
    // A right-to-left caption keeps the same margin from the right edge.
    let margin: f64 = 154.0 * cast.float(cache.width) / 1280.0
    let x: f64 = if bidi.rtl_paragraph(logical) { cast.float(cache.width) - margin - font.measure(typeface_ref, line) }
      else { margin }
    typeface.draw_label(canvas, typeface_ref, x, y, line, 44.0 * caption_scale)
    at = at + 1
  }
  var finished: draw.Surface = draw.finish(canvas)
  var rgba: bytes = draw.surface_rgba(finished)
  match files.write_bytes(str.view(raster_file), bytes.view(rgba)) {
    err(problem) => { return result.err("subtitle raster could not be written") },
    ok(_) => { },
  }
  struct.set(cache, id, field=subtitle)
  result.ok(raster_file)
}

fn flat_frame_plan(doc: ref<editor.Document>, frame: i64, kind: str, out: str,
                  scratch_prefix: str, cache: ref<RenderCache>)
                  -> result<array<string>, string> effects {alloc, fs.meta, fs.read, fs.write} {
  let _ = try validate_lut_paths(doc, frame, cache)
  let subtitle: u64 = match editor.subtitle_at(doc, doc.active, frame) {
    none => 0, some(id) => id,
  }
  if subtitle == 0 { return media_plan(doc, frame, kind, out, scratch_prefix, cache) }
  let base: string = text.concat(scratch_prefix, ".base.rgba")
  var lines: array<string> = try media_plan(doc, frame, "FLOAT", str.view(base), scratch_prefix, cache)
  let caption: string = try raster_subtitle(doc, subtitle, scratch_prefix, cache)
  var values: array<string> = neutral()
  let raw_base: string = text.concat("FLOAT:", str.view(base))
  let raw_caption: string = text.concat("RAW:", str.view(caption))
  put(values, 0, str.view(provider.wire_path(str.view(raw_base))))
  put(values, 1, str.view(provider.wire_path(str.view(raw_caption))))
  let folded: string = if str.eq(kind, "PREVIEW") or str.eq(kind, "FLOAT") { string.copy(out) }
    else { text.concat(scratch_prefix, ".caption.rgba") }
  array.push(lines, wire_line(values, if str.eq(kind, "PREVIEW") { "PREVIEW" } else { "FLOAT" }, str.view(folded)))
  if str.eq(kind, "ENC") {
    var final_values: array<string> = neutral()
    let raw_folded: string = text.concat("FLOAT:", str.view(folded))
    put(final_values, 0, str.view(provider.wire_path(str.view(raw_folded))))
    array.push(lines, wire_line(final_values, "ENC", ""))
  }
  result.ok(lines)
}

fn cleanup_flat_plan(prefix: str) -> unit effects {alloc, fs.read, fs.write} {
  let lane_count:string=text.concat(prefix,".lane-count")
  match files.read_text(str.view(lane_count)) {
    err(_)=>{},ok(value)=>{
      let count:u64=match text.parse_u64(str.view(value)) {none=>0,some(number)=>number,}
      var lane:u64=0
      loop {if lane>=count or lane>=4096 {break}
        let child:string=text.concat(text.concat(prefix,".lane-"),string.from_int(cast.sat(lane)))
        cleanup_flat_plan(str.view(child))
        let _=files.remove(text.concat(str.view(child),".output.rgba"))
        let _=files.remove(text.concat(str.view(child),".side-out.rgba"))
        let _=files.remove(text.concat(str.view(child),".side-in.rgba"))
        lane=lane+1
      }
    },
  }
  let _=files.remove(str.view(lane_count))
  let _ = files.remove(str.view(text.concat(prefix, ".base-opacity.rgba")))
  let _ = files.remove(str.view(text.concat(prefix, ".incoming-opacity.rgba")))
  let _ = files.remove(str.view(layer_path(prefix, 0)))
  let _ = files.remove(str.view(layer_path(prefix, 1)))
  var slot: u64 = 0
  var slots: u64 = 4
  let prepared_count: string = text.concat(prefix,".prepared-count")
  match files.read_text(str.view(prepared_count)) {
    err(_) => {}, ok(value) => {
      match text.parse_u64(str.view(value)) {
        none => {}, some(count) => {if count > slots and count <= 4097 {slots=count}},
      }
    },
  }
  loop {
    if slot == slots { break }
    let _ = files.remove(str.view(preclip_path(prefix, slot)))
    let _ = files.remove(str.view(text_raster_path(prefix, slot)))
    let _ = files.remove(str.view(text_clip_path(prefix, slot)))
    let count_file: string = ordered_count_path(prefix,slot)
    match files.read_text(str.view(count_file)) {
      err(_) => {}, ok(value) => {
        let count: u64 = match text.parse_u64(str.view(value)) {none=>0,some(value)=>value,}
        var index: u64 = 0
        loop {if index >= count or index >= 4096 {break}
          let _ = files.remove(str.view(ordered_title_path(prefix,slot,index)))
          index=index+1}
      },
    }
    let _ = files.remove(str.view(count_file))
    slot = slot + 1
  }
  let _ = files.remove(str.view(prepared_count))
  let _ = files.remove(str.view(subtitle_path(prefix)))
  let _ = files.remove(str.view(text.concat(prefix, ".base.rgba")))
  let _ = files.remove(str.view(text.concat(prefix, ".caption.rgba")))
  ()
}

// Compound pictures use a private document projection. The original sequence,
// clip-local automation, authored filter order and source phase never change.
type PictureBudget = struct {nodes:u64, passes:u64, pixels:u64, bytes:u64}
type PictureBuild = struct {groups:u64}
type PictureRaster = struct {lines:array<string>, path:string, width:u32, height:u32}

fn nested_picture_requested(doc: ref<editor.Document>) -> bool effects {} {
  var at:u64=0
  loop {if at >= editor.clip_count(doc) {break}
    let clip:editor.Clip=array.get(struct.borrow(doc,field=clips),at)
    if clip.owner == doc.active and clip.nested != 0 and clip.enabled and editor.clip_has_video(clip) and
       editor.track_kind(doc,clip.track) == editor.track_video() and
       editor.track_visible(doc,clip.track) {return true}
    at=at+1
  }
  false
}

fn picture_exact_frame(frame:i64) -> bool effects {} {
  let value:f64=cast.float(frame)
  math.abs(value) <= 9007199254740991.0
}
fn picture_same_clip(a:editor.Clip,b:editor.Clip) -> bool effects {} {
  a.id == b.id and a.owner == b.owner and a.source == b.source and a.nested == b.nested and
    a.source_in == b.source_in and a.length == b.length and a.start == b.start and
    a.track == b.track and a.group == b.group and a.enabled == b.enabled and
    a.selected == b.selected and a.fade_in == b.fade_in and a.fade_out == b.fade_out and
    a.gain == b.gain and a.pan == b.pan and a.speed == b.speed and a.reverse == b.reverse and a.streams == b.streams
}

// source_in belongs to the enclosing sequence, not to the child's native FPS.
// Clamp transition handles just as a media clip clamps its sampled endpoints.
pub fn nested_picture_frame(doc: ref<editor.Document>, clip:editor.Clip, frame:i64)
    -> result<i64,string> effects {alloc} {
  if not editor.clip_has_video(clip) or clip.nested == 0 or clip.source != 0 or clip.length <= 0 or clip.source_in < 0 {
    return result.err("[GA_VIDEO_NESTED_PROTOCOL] Invalid compound source geometry")
  }
  match editor.sequence_slot(doc,clip.owner) {none=>{return result.err("[GA_VIDEO_NESTED_SOURCE] Compound owner sequence is missing")},some(_)=>{},}
  match editor.sequence_slot(doc,clip.nested) {none=>{return result.err("[GA_VIDEO_NESTED_SOURCE] Compound child sequence is missing")},some(_)=>{},}
  let owner_fps:f64=editor.sequence_fps(doc,clip.owner)
  let child_fps:f64=editor.sequence_fps(doc,clip.nested)
  let speed:f64=effective_speed(doc,clip)
  if not math.is_finite(owner_fps) or owner_fps <= 0.0 or
     not math.is_finite(child_fps) or child_fps <= 0.0 or
     not math.is_finite(speed) or speed < 0.0 {
    return result.err("[GA_VIDEO_NESTED_PROTOCOL] Invalid compound rate")
  }
  let delta:i64=sub.sat(frame,clip.start)
  let local:i64=if delta < 0 {0}else if delta >= clip.length {clip.length-1}else{delta}
  let position:i64=if clip.reverse {clip.length-1-local}else{local}
  let sampled:f64=math.floor((cast.float(clip.source_in)+cast.float(position)*speed)*child_fps/owner_fps)
  if not math.is_finite(sampled) or sampled < 0.0 or sampled > 9007199254740991.0 {
    return result.err("[GA_VIDEO_NESTED_CAPACITY] Compound frame exceeds the exact frame domain")
  }
  let duration:i64=editor.sequence_duration(doc,clip.nested)
  if duration > 0 and sampled >= cast.float(duration) {
    return result.err("[GA_VIDEO_NESTED_SOURCE] Compound rate and length exceed child frames")
  }
  result.ok(cast.sat(sampled))
}

fn picture_charge(budget:ref<PictureBudget>, width:u32, height:u32, passes:u64,
                  path_bytes:u64) -> result<unit,string> effects {alloc} {
  let pixels:u64=cast.wrap(width)*cast.wrap(height)
  let cost:u64=pixels*passes
  let bytes:u64=(3072+path_bytes)*passes
  if budget.passes > 16384 or passes > 16384-budget.passes or
     cost > 2147483648 or budget.pixels > 2147483648-cost or
     bytes > 960000 or budget.bytes > 960000-bytes {
    return result.err("[GA_VIDEO_NESTED_CAPACITY] Compound picture pass, pixel or descriptor budget exceeded")
  }
  struct.set(budget,budget.passes+passes,field=passes)
  struct.set(budget,budget.pixels+cost,field=pixels)
  struct.set(budget,budget.bytes+bytes,field=bytes)
  result.ok(())
}

// Validate the reachable visible-track structure before any title/raster writes.
// Inspect every enabled clip, including future transition halves, so malformed
// children cannot appear only after an export has started publishing frames.
fn picture_preflight(doc:ref<editor.Document>, sequence:u64, ancestors:ref<array<u64>>,
                     budget:ref<PictureBudget>, prefix_bytes:u64, frame:i64, visible_context:bool)
    -> result<unit,string> effects {alloc} {
  var at:u64=0
  loop {if at >= array.len(ancestors) {break}
    if array.get(ancestors,at) == sequence {return result.err("[GA_VIDEO_NESTED_CYCLE] Compound picture composition cycle")}
    at=at+1
  }
  if array.len(ancestors) >= 16 or budget.nodes >= 4096 {
    return result.err("[GA_VIDEO_NESTED_CAPACITY] Compound picture depth or node budget exceeded")
  }
  let seq_slot:u64=match editor.sequence_slot(doc,sequence) {
    none=>{return result.err("[GA_VIDEO_NESTED_SOURCE] Compound picture sequence is missing")},some(value)=>value,
  }
  let width:u32=struct.get(array.borrow(struct.borrow(doc,field=sequences),seq_slot),field=width)
  let height:u32=struct.get(array.borrow(struct.borrow(doc,field=sequences),seq_slot),field=height)
  let fps:f64=editor.sequence_fps(doc,sequence)
  if not math.is_finite(fps) or fps <= 0.0 or width < 16 or height < 16 or
     width > 8192 or height > 8192 {
    return result.err("[GA_VIDEO_NESTED_PROTOCOL] Invalid compound sequence format")
  }
  let native_pixels:u64=cast.wrap(width)*cast.wrap(height)
  if native_pixels > 16777216 {
    return result.err("[GA_VIDEO_NESTED_CAPACITY] Compound canvas exceeds sixteen million pixels")
  }
  struct.set(budget,budget.nodes+1,field=nodes)
  if visible_context {let _=try picture_charge(budget,width,height,3,prefix_bytes*6+384)}
  var next:array<u64> = array.new()
  at=0
  loop {if at >= array.len(ancestors) {break}
    array.push(next,array.get(ancestors,at))
    at=at+1
  }
  array.push(next,sequence)
  var view_doc:editor.Document=editor.copy_document(doc)
  struct.set(view_doc,sequence,field=active)
  if visible_context and upper_transition_requested(view_doc,frame) {
    // One explicit transparent seed also covers a temporary lower-lane gap.
    let _=try picture_charge(budget,width,height,1,prefix_bytes*6+384)
  }
  at=0
  loop {if at >= editor.clip_count(doc) {break}
    let clip:editor.Clip=array.get(struct.borrow(doc,field=clips),at)
    at=at+1
    if clip.owner != sequence or not clip.enabled or not editor.clip_has_video(clip) or
       editor.track_kind(doc,clip.track) != editor.track_video() or
       not editor.track_visible(doc,clip.track) {continue}
    if budget.nodes >= 4096 {return result.err("[GA_VIDEO_NESTED_CAPACITY] Compound picture node budget exceeded")}
    struct.set(budget,budget.nodes+1,field=nodes)
    let track_slot:u64=match editor.track_slot(doc,clip.track) {
      none=>{return result.err("[GA_VIDEO_NESTED_PROTOCOL] Compound picture clip track is missing")},some(value)=>value,
    }
    if struct.get(array.borrow(struct.borrow(doc,field=tracks),track_slot),field=owner) != sequence or
       clip.length <= 0 or clip.start < 0 or clip.source_in < 0 or
       not picture_exact_frame(clip.start) or
       not picture_exact_frame(clip.length) or
       not picture_exact_frame(clip.source_in) or
       not picture_exact_frame(editor.clip_end(clip)) {
      return result.err("[GA_VIDEO_NESTED_PROTOCOL] Compound picture clip geometry is invalid")
    }
    var operators:u64=0
    var filter_at:u32=0
    loop {match editor.filter_at(doc,clip.id,filter_at) {
      none=>{break},some(filter)=>{
        if editor.filter_enabled(doc,filter) {
          let kind:string=editor.filter_kind(doc,filter)
          if clip.nested != 0 and kind == "stabilize" {
            return result.err("[GA_VIDEO_NESTED_HISTORY] Compound stabilization needs group frame history")
          }
          if picture_operator(str.view(kind)) {operators=operators+1}
        }
      },
    }
    filter_at=filter_at+1
    if operators > 4096 {return result.err("[GA_VIDEO_NESTED_CAPACITY] Compound picture filter stack exceeds 4096 operators")}
    }
    let used:bool=visible_context and picture_used(view_doc,clip,frame)
    var path_bytes:u64=prefix_bytes*6+384
    if clip.nested != 0 {
      var ancestor_at:u64=0
      loop {if ancestor_at >= array.len(next) {break}
        if array.get(next,ancestor_at) == clip.nested {return result.err("[GA_VIDEO_NESTED_CYCLE] Compound picture composition cycle")}
        ancestor_at=ancestor_at+1
      }
      let _=try nested_picture_frame(doc,clip,clip.start)
      let _=try nested_picture_frame(doc,clip,editor.clip_end(clip)-1)
      let child_frame:i64=if used {try nested_picture_frame(doc,clip,frame)}else{0}
      let _=try picture_preflight(doc,clip.nested,next,budget,prefix_bytes+32,child_frame,used)
    }else{
      let source:string=match source_path(doc,clip) {
        none=>{return result.err("[GA_VIDEO_NESTED_SOURCE] Compound leaf has no online video source")},some(value)=>value,
      }
      if str.len(source) > 32768 {return result.err("[GA_VIDEO_NESTED_CAPACITY] Compound media source path is too long")}
      path_bytes=path_bytes+str.len(source)*3
      let source_slot:u64=option.unwrap(editor.source_slot(doc,clip.source))
      let source_fps:f64=struct.get(array.borrow(struct.borrow(doc,field=sources),source_slot),field=fps)
      let speed:f64=effective_speed(doc,clip)
      if not math.is_finite(source_fps) or source_fps <= 0.0 or
         not math.is_finite(speed) or speed < 0.0 {
        return result.err("[GA_VIDEO_NESTED_PROTOCOL] Invalid compound leaf rate")
      }
      let last:f64=math.floor((cast.float(clip.source_in)+cast.float(clip.length-1)*speed)*source_fps/fps)
      let frames:i64=editor.source_frames(doc,clip.source)
      if not math.is_finite(last) or last > 9007199254740991.0 or
         (frames > 0 and last >= cast.float(frames)) {
        return result.err("[GA_VIDEO_NESTED_SOURCE] Compound leaf rate and length exceed source frames")
      }
    }
    if used {
      let _=try picture_charge(budget,width,height,operators+3,path_bytes)
      // Two side preparation passes replace the old isolated-lane transition.
      // Charge explicitly before any title or scratch ownership writes.
      if upper_transition_requested(view_doc,frame) {
        match picture_transition_at(view_doc,clip.track,frame) {none=>{},some(_)=>{
          match composited_clip(view_doc,clip.track,frame) {none=>{},some(selected)=>{
            if selected.id==clip.id {let _=try picture_charge(budget,width,height,2,path_bytes)}
          },}
        },}
      }
    }
    var key_at:u64=0
    loop {if key_at >= array.len(struct.borrow(doc,field=keys)) {break}
      let key:editor.Key=array.get(struct.borrow(doc,field=keys),key_at)
      if key.clip == clip.id and (key.owner != clip.owner or
          not math.is_finite(key.value) or math.abs(cast.float(key.frame)) > 9007199254740991.0 or
          not key_supported(str.view(editor.name_text(doc,key.param)))) {
        return result.err("[GA_VIDEO_NESTED_PROTOCOL] Compound picture has unsupported or invalid animation")
      }
      key_at=key_at+1
    }
  }
  result.ok(())
}

fn picture_canvas(width:u32,height:u32,mode:u32) -> string effects {alloc} {
  var fields:array<string> = ["CANVAS",string.from_int(width),string.from_int(height),string.from_int(mode)]
  text.join(fields," ")
}
fn picture_token(kind:str,width:u32,height:u32,file:str) -> string effects {alloc} {
  var value:string=text.concat(kind,":")
  string.append(value,string.from_int(width))
  string.append(value,":")
  string.append(value,string.from_int(height))
  string.append(value,":")
  string.append(value,file)
  value
}
fn picture_prefix(prefix:str,index:u64) -> string effects {alloc} {
  text.concat(text.concat(prefix,".nested-"),string.from_int(index))
}
fn picture_used(doc:ref<editor.Document>,clip:editor.Clip,frame:i64) -> bool effects {alloc} {
  match composited_clip(doc,clip.track,frame) {none=>{},some(value)=>{if value.id == clip.id {return true}},}
  match picture_transition_at(doc,clip.track,frame) {
    none=>{},some(id)=>{
      let transition:editor.Transition=match editor.transition(doc,id) {none=>{return false},some(value)=>value,}
      match transition_pair(doc,clip.track,transition.center) {
        none=>{},some(pair)=>{if pair.incoming.id == clip.id {return true}},
      }
    },
  }
  false
}

fn picture_sequence_plan(doc:ref<editor.Document>,sequence:u64,frame:i64,
    width:u32,height:u32,prefix:str,build:ref<PictureBuild>,fonts:ref<array<string>>)
    -> result<PictureRaster,string> effects {alloc,fs.meta,fs.read,fs.write} {
  if build.groups >= 4096 {return result.err("[GA_VIDEO_NESTED_CAPACITY] Compound raster node budget exceeded")}
  let own_prefix:string=picture_prefix(prefix,build.groups)
  struct.set(build,build.groups+1,field=groups)
  match files.mkdirs(path.dirname(prefix)) {err(_)=>{return result.err("[GA_VIDEO_NESTED_SCRATCH] Cannot create compound scratch")},ok(_)=>{},}
  match files.write_text(text.concat(prefix,".nested-count"),string.from_int(build.groups)) {
    err(_)=>{return result.err("[GA_VIDEO_NESTED_SCRATCH] Cannot record compound raster ownership")},ok(_)=>{},
  }
  var projected:editor.Document=editor.copy_document(doc)
  struct.set(projected,sequence,field=active)
  var lines:array<string> = array.new()
  var at:u64=0
  loop {if at >= editor.clip_count(doc) {break}
    let clip:editor.Clip=array.get(struct.borrow(doc,field=clips),at)
    at=at+1
    if clip.owner != sequence or not clip.enabled or not editor.clip_has_video(clip) or
       editor.track_kind(doc,clip.track) != editor.track_video() or
       not editor.track_visible(doc,clip.track) or not picture_used(projected,clip,frame) {continue}
    let factor:f64=clip_factor(projected,clip,frame)
    if not math.is_finite(factor) or factor < 0.0 or factor > 1.0 {
      return result.err("[GA_VIDEO_NESTED_PROTOCOL] Compound picture opacity is outside zero to one")
    }
    if clip.nested == 0 {continue}
    let child_frame:i64=try nested_picture_frame(doc,clip,frame)
    let child_slot:u64=option.unwrap(editor.sequence_slot(doc,clip.nested))
    let child_width:u32=struct.get(array.borrow(struct.borrow(doc,field=sequences),child_slot),field=width)
    let child_height:u32=struct.get(array.borrow(struct.borrow(doc,field=sequences),child_slot),field=height)
    var child:PictureRaster=try picture_sequence_plan(doc,clip.nested,child_frame,
      child_width,child_height,prefix,build,fonts)
    var line_at:u64=0
    loop {if line_at >= array.len(struct.borrow(child,field=lines)) {break}
      array.push(lines,string.copy(str.view(array.borrow(struct.borrow(child,field=lines),line_at))))
      line_at=line_at+1
    }
    let source:string=picture_token("FLOATDIM",child.width,child.height,str.view(child.path))
    let source_id:u64=editor.add_source(projected,str.view(source),"compound raster",1,editor.sequence_fps(doc,clip.owner))
    let _=editor.describe_source(projected,source_id,child.width,child.height,true,false,0,0)
    var replacement:editor.Clip=clip
    struct.set(replacement,source_id,field=source)
    struct.set(replacement,0,field=nested)
    struct.set(replacement,0,field=source_in)
    // Zero freezes only this private already-sampled raster, even when original
    // Speed filters are present. Keep local keys/start/length/filter identities.
    struct.set(replacement,0.0,field=speed)
    struct.set(replacement,false,field=reverse)
    let replacement_slot:u64=option.unwrap(editor.clip_slot(projected,clip.id))
    array.set(struct.borrow(projected,field=clips),replacement_slot,replacement)
  }
  array.push(lines,picture_canvas(width,height,1))
  var cache:RenderCache=render_cache(fonts)
  struct.set(cache,width,field=width)
  struct.set(cache,height,field=height)
  let output:string=text.concat(str.view(own_prefix),".group.rgba")
  var own_lines:array<string> = try flat_frame_plan(projected,frame,"FLOAT",str.view(output),str.view(own_prefix),cache)
  at=0
  loop {if at >= array.len(own_lines) {break}
    array.push(lines,string.copy(str.view(array.borrow(own_lines,at))))
    at=at+1
  }
  result.ok(PictureRaster {lines:lines,path:output,width:width,height:height})
}

fn picture_lines_valid(lines:ref<array<string>>) -> bool effects {} {
  if array.len(lines) > 16384 {return false}
  var bytes:u64=0
  var at:u64=0
  loop {if at >= array.len(lines) {break}
    let size:u64=str.len(str.view(array.borrow(lines,at)))+1
    if size > 1048576 or size > 960000-bytes {return false}
    bytes=bytes+size
    at=at+1
  }
  true
}

pub fn frame_plan(doc:ref<editor.Document>,frame:i64,kind:str,out:str,
    scratch_prefix:str,cache:ref<RenderCache>)
    -> result<array<string>,string> effects {alloc,fs.meta,fs.read,fs.write} {
  if not nested_picture_requested(doc) and not upper_transition_requested(doc,frame) {
    return flat_frame_plan(doc,frame,kind,out,scratch_prefix,cache)
  }
  if str.len(scratch_prefix) == 0 or str.len(scratch_prefix) > 4096 or
     frame < 0 or not picture_exact_frame(frame) or
     (kind != "PREVIEW" and kind != "FLOAT" and kind != "ENC") {
    return result.err("[GA_VIDEO_NESTED_PROTOCOL] Invalid compound picture request")
  }
  var budget:PictureBudget=PictureBudget {nodes:0,passes:0,pixels:0,bytes:0}
  var ancestors:array<u64> = array.new()
  try picture_preflight(doc,doc.active,ancestors,budget,str.len(scratch_prefix),frame,true)
  cleanup_plan(scratch_prefix)
  var build:PictureBuild=PictureBuild {groups:0}
  var raster:PictureRaster=match picture_sequence_plan(doc,doc.active,frame,
      cache.width,cache.height,scratch_prefix,build,struct.borrow(cache,field=fonts)) {
    err(problem)=>{cleanup_plan(scratch_prefix)
      return result.err(problem)},ok(value)=>value,
  }
  var lines:array<string> = struct.replace(raster,array.new(),field=lines)
  array.push(lines,picture_canvas(cache.width,cache.height,0))
  var values:array<string> = neutral()
  let source:string=picture_token("OPAQUE",raster.width,raster.height,str.view(raster.path))
  put(values,0,str.view(provider.wire_path(str.view(source))))
  array.push(lines,wire_line(values,kind,out))
  if not picture_lines_valid(lines) {
    cleanup_plan(scratch_prefix)
    return result.err("[GA_VIDEO_NESTED_CAPACITY] Compound picture wire budget exceeded")
  }
  result.ok(lines)
}

// Timeline filmstrips address the authored clip, even when it is disabled/hidden.
// Isolate only its enclosing lane; child visibility and clip enablement survive.
pub fn clip_picture_plan(doc:ref<editor.Document>,clip:editor.Clip,owner_frame:i64,
    kind:str,out:str,prefix:str,cache:ref<RenderCache>)
    -> result<array<string>,string> effects {alloc,fs.meta,fs.read,fs.write} {
  let slot:u64=match editor.clip_slot(doc,clip.id) {
    none=>{return result.err("[GA_VIDEO_NESTED_SOURCE] Filmstrip clip is missing")},some(value)=>value,
  }
  if not picture_same_clip(array.get(struct.borrow(doc,field=clips),slot),clip) or
     owner_frame < clip.start or owner_frame >= editor.clip_end(clip) or
     not editor.clip_has_video(clip) or editor.track_kind(doc,clip.track) != editor.track_video() {
    return result.err("[GA_VIDEO_NESTED_PROTOCOL] Filmstrip clip or frame is stale")
  }
  var isolated:editor.Document=editor.copy_document(doc)
  struct.set(isolated,clip.owner,field=active)
  var at:u64=0
  loop {if at >= editor.clip_count(isolated) {break}
    var current:editor.Clip = array.get(struct.borrow(isolated,field=clips),at)
    if current.owner == clip.owner {struct.set(current,current.id == clip.id,field=enabled)
      array.set(struct.borrow(isolated,field=clips),at,current)}
    at=at+1
  }
  let track_slot:u64=match editor.track_slot(isolated,clip.track) {
    none=>{return result.err("[GA_VIDEO_NESTED_SOURCE] Filmstrip clip track is missing")},some(value)=>value,
  }
  struct.set(array.borrow(struct.borrow(isolated,field=tracks),track_slot),false,field=hidden)
  var transitions:array<editor.Transition> = array.new()
  at=0
  loop {if at >= array.len(struct.borrow(isolated,field=transitions)) {break}
    let transition:editor.Transition=array.get(struct.borrow(isolated,field=transitions),at)
    if transition.owner != clip.owner {array.push(transitions,transition)}
    at=at+1
  }
  let _=struct.replace(isolated,transitions,field=transitions)
  // Sequence captions are siblings of the isolated clip and do not belong in
  // its filmstrip; captions inside the nested source remain part of its picture.
  var subtitles:array<editor.Subtitle> = array.new()
  at=0
  loop {if at >= array.len(struct.borrow(isolated,field=subtitles)) {break}
    let subtitle:ref<editor.Subtitle> = array.borrow(struct.borrow(isolated,field=subtitles),at)
    if subtitle.owner != clip.owner {array.push(subtitles,editor.Subtitle {
      id:subtitle.id,owner:subtitle.owner,start:subtitle.start,finish:subtitle.finish,
      text:string.copy(str.view(struct.borrow(subtitle,field=text)))})}
    at=at+1
  }
  let _=struct.replace(isolated,subtitles,field=subtitles)
  if clip.nested != 0 {
    let seq_slot:u64=match editor.sequence_slot(isolated,clip.owner) {
      none=>{return result.err("[GA_VIDEO_NESTED_SOURCE] Filmstrip owner sequence is missing")},some(value)=>value,
    }
    struct.set(cache,struct.get(array.borrow(struct.borrow(isolated,field=sequences),seq_slot),field=width),field=width)
    struct.set(cache,struct.get(array.borrow(struct.borrow(isolated,field=sequences),seq_slot),field=height),field=height)
  }
  frame_plan(isolated,owner_frame,kind,out,prefix,cache)
}

pub fn cleanup_plan(prefix:str) -> unit effects {alloc,fs.read,fs.write} {
  let count_file:string=text.concat(prefix,".nested-count")
  let count:u64=match files.read_text(str.view(count_file)) {
    err(_)=>0,ok(value)=>match text.parse_u64(str.view(value)) {none=>0,some(number)=>if number <= 4096 {number}else{0},},
  }
  var at:u64=0
  loop {if at >= count {break}
    let owned:string=picture_prefix(prefix,at)
    cleanup_flat_plan(str.view(owned))
    let _=files.remove(text.concat(str.view(owned),".group.rgba"))
    at=at+1
  }
  let _=files.remove(str.view(count_file))
  cleanup_flat_plan(prefix)
}

// Playback and export check their control files while process I/O waits.
fn export_current(cancel: str) -> result<unit,string> effects {alloc, fs.meta} {
  if str.len(cancel) == 0 { return result.ok(()) }
  match files.exists(cancel) {
    ok(found)=>{if found {return result.err("[GA_EXPORT_CANCELLED] export cancelled")}},
    err(problem)=>{return result.err(text.concat("[GA_EXPORT_CONTROL] Cannot check cancellation: ",fs.error.message(problem)))},
  }
  result.ok(())
}
fn worker_request_current(root: str, id: u64, cancel: str) -> result<bool,string>
    effects {alloc, fs.meta, fs.read} {
  try export_current(cancel)
  audio_request_current(root,id)
}
fn audio_request_current(root: str, id: u64) -> result<bool,string> effects {alloc, fs.meta, fs.read} {
  if str.len(root) == 0 { return result.ok(true) }
  if tasks.requested_at(path.join(root,"stop")) { return result.ok(false) }
  let marker: string = match files.read_text(path.join(root,"request.id")) {
    ok(value)=>value,err(_)=>{return result.err("[GA_AUDIO_STREAM_CONTROL] Cannot read playback request marker")},
  }
  match text.parse_u64(str.view(text.trim(str.view(marker)))) {
    some(value)=>result.ok(value == id),none=>result.err("[GA_AUDIO_STREAM_CONTROL] Invalid playback request marker"),
  }
}
fn reply_for_request(child: ref<Child>, reader: ref<proc.LineReader>, line: str, root: str, id: u64, cancel: str)
           -> result<string, string> effects {alloc, fs.meta, fs.read, process, time} {
  var request: string = string.copy(line)
  string.append(request, "\n")
  let cancellable: bool = str.len(root) != 0 or str.len(cancel) != 0
  if not cancellable {
    match proc.write_all_stdin(child, str.bytes(str.view(request)), proc.deadline_in(30000)) {
      err(problem) => { return result.err(text.concat("worker write: ", fs.error.message(problem))) },
      ok(_) => { },
    }
  } else {
    let deadline: u64 = proc.deadline_in(30000)
    var sent: u64 = 0
    loop {
      let current: bool = try worker_request_current(root,id,cancel)
      if not current { return result.err("[GA_AUDIO_STREAM_CANCELLED] Playback request was superseded") }
      if sent >= str.len(str.view(request)) { break }
      if time.monotonic_ns() >= deadline { return result.err(if str.len(cancel) != 0 {
        "[GA_EXPORT_TIMEOUT] Worker write timed out" }else{"[GA_AUDIO_STREAM_TIMEOUT] Worker write timed out"}) }
      let step: u64 = proc.deadline_in(50)
      match proc.write_stdin(child,view.slice(str.bytes(str.view(request)),sent,str.len(str.view(request))),
          if step < deadline {step}else{deadline}) {
        ok(wrote)=>{sent=sent+wrote},
        err(problem)=>{if problem.code != 10 {return result.err(text.concat("worker write: ",fs.error.message(problem))) }},
      }
    }
  }
  let deadline: u64 = proc.deadline_in(120000)
  var detail: string = string.new()
  var count: u64 = 0
  loop {
    let current: bool = try worker_request_current(root,id,cancel)
    if not current { return result.err("[GA_AUDIO_STREAM_CANCELLED] Playback request was superseded") }
    if count >= 256 { return result.err("worker emitted too many diagnostic lines") }
    let step: u64 = if cancellable {proc.deadline_in(50)}else{deadline}
    match proc.read_line(child, reader, if step < deadline {step}else{deadline}) {
      err(problem) => {
        if problem.code == 10 and cancellable and time.monotonic_ns() < deadline {continue}
        if problem.code == 10 and str.len(cancel) != 0 {return result.err("[GA_EXPORT_TIMEOUT] Worker reply timed out")}
        return result.err(text.concat("worker reply: ", fs.error.message(problem)))
      },
      ok(value) => {
        match value {
          none => { return result.err("worker closed its reply pipe") },
          some(reply) => {
            if text.contains(str.view(reply), "AUDIO fx chain failed") {
              return result.err("worker could not apply an audio filter chain")
            }
            if str.starts_with(str.view(reply), "DONE") { return result.ok(reply) }
            if str.starts_with(str.view(reply), "ERR") {
              if str.len(str.view(detail)) > 0 {
                return result.err(text.concat("worker rejected request: ", str.view(detail)))
              }
              return result.err(text.concat("worker rejected: ", line))
            }
            detail = reply
          },
        }
      },
    }
    count = count + 1
  }
  result.err("worker gave no reply")
}
fn command_for_request(child: ref<Child>, reader: ref<proc.LineReader>, line: str, root: str, id: u64, cancel: str)
           -> result<unit,string> effects {alloc,fs.meta,fs.read,process,time} {
  let _ = try reply_for_request(child,reader,line,root,id,cancel)
  result.ok(())
}
fn export_command(child: ref<Child>, reader: ref<proc.LineReader>, line: str, cancel: str)
           -> result<unit, string> effects {alloc, fs.meta, fs.read, process, time} {
  match command_for_request(child,reader,line,"",0,cancel) {
    ok(_)=>result.ok(()),
    err(problem)=>result.err(if str.starts_with(str.view(problem),"[GA_") {problem}
      else{text.concat("[GA_EXPORT_WORKER] ",str.view(problem))}),
  }
}

fn audio_session(child: ref<Child>, reader: ref<proc.LineReader>, opener: str,
                 sounds: ref<array<string>>, closer: str, cache: str)
                 -> result<unit, string> effects {alloc, fs.meta, fs.read, process, time} {
  audio_session_for_request(child,reader,opener,sounds,closer,"",0,cache)
}
fn audio_session_for_request(child: ref<Child>, reader: ref<proc.LineReader>, opener: str,
                 sounds: ref<array<string>>, closer: str, root: str, id: u64, cache: str)
                 -> result<unit, string> effects {alloc, fs.meta, fs.read, process, time} {
  try command_for_request(child, reader, opener, root, id, "")
  var at: u64 = 0
  loop {
    if at >= array.len(sounds) { break }
    let line: string = nested_audio_runtime_line(array.borrow(sounds,at),cache)
    try command_for_request(child, reader, line, root, id, "")
    at = at + 1
  }
  try command_for_request(child, reader, closer, root, id, "")
  result.ok(())
}

// A clip may carry both picture and sound. Video filters belong to frame_line; these
// stages affect only its audio stream and keep the inspector's parameter values.
fn audio_filter_stage(doc: ref<editor.Document>, filter: u64)
                      -> option<string> effects {alloc} {
  let kind: string = editor.filter_kind(doc, filter)
  if str.eq(str.view(kind), "gain") {
    var stage: string = text.concat("volume=", str.view(string.from_float(
      editor.filter_param(doc, filter, "level", 0.0))))
    string.append(stage, "dB")
    return option.some(stage)
  }
  if str.eq(str.view(kind), "pan") {
    return option.some(text.concat("stereotools=balance_out=", str.view(string.from_float(
      editor.filter_param(doc, filter, "position", 0.0)))))
  }
  if str.eq(str.view(kind), "eq_3band") {
    var stages: array<string> = array.new()
    var names: array<string> = ["low", "mid", "high"]
    var freqs: array<string> = ["100", "1000", "8000"]
    var band: u64 = 0
    loop {
      if band >= 3 { break }
      let gain: f64 = editor.filter_param(doc, filter, str.view(array.borrow(names, band)), 0.0)
      if gain != 0.0 {
        var stage: string = text.concat("equalizer=f=", str.view(array.borrow(freqs, band)))
        string.append(stage, ":t=q:w=1:g=")
        string.append(stage, str.view(string.from_float(gain)))
        array.push(stages, stage)
      }
      band = band + 1
    }
    let pan: f64 = editor.filter_param(doc, filter, "pan", 0.0)
    if pan != 0.0 {
      array.push(stages, text.concat("stereotools=balance_out=", str.view(string.from_float(pan))))
    }
    return option.some(if array.len(stages) == 0 { string.copy("anull") }
      else { text.join(stages, ",") })
  }
  if str.eq(str.view(kind), "eq_10band") {
    var stages: array<string> = array.new()
    var freqs: array<string> = ["31", "62", "125", "250", "500", "1000", "2000",
      "4000", "8000", "16000"]
    var band: u64 = 0
    loop {
      if band >= 10 { break }
      let name: string = text.concat("band", str.view(string.from_int(band)))
      let gain: f64 = editor.filter_param(doc, filter, str.view(name), 0.0)
      if gain != 0.0 {
        var stage: string = text.concat("equalizer=f=", str.view(array.borrow(freqs, band)))
        string.append(stage, ":width_type=o:width=1:g=")
        string.append(stage, str.view(string.from_float(gain)))
        array.push(stages, stage)
      }
      band = band + 1
    }
    return option.some(if array.len(stages) == 0 { string.copy("anull") }
      else { text.join(stages, ",") })
  }
  if str.eq(str.view(kind), "compressor") {
    let threshold: f64 = math.pow(10.0,
      editor.filter_param(doc, filter, "threshold", -18.0) / 20.0)
    let ratio: f64 = editor.filter_param(doc, filter, "ratio", 4.0)
    let attack: f64 = math.max(0.01, editor.filter_param(doc, filter, "attack", 10.0))
    let release: f64 = math.max(0.01, editor.filter_param(doc, filter, "release", 120.0))
    var stage: string = text.concat("acompressor=threshold=", str.view(string.from_float(threshold)))
    string.append(stage, ":ratio=")
    string.append(stage, str.view(string.from_float(ratio)))
    string.append(stage, ":attack=")
    string.append(stage, str.view(string.from_float(attack)))
    string.append(stage, ":release=")
    string.append(stage, str.view(string.from_float(release)))
    return option.some(stage)
  }
  if str.eq(str.view(kind), "gate") {
    let threshold: f64 = math.pow(10.0,
      editor.filter_param(doc, filter, "threshold", -45.0) / 20.0)
    // The saved `hold` parameter predates audio export. The inspector labels it as
    // release time, which is the response the worker's agate filter can implement.
    let release: f64 = math.max(0.01, editor.filter_param(doc, filter, "hold", 50.0))
    var stage: string = text.concat("agate=threshold=", str.view(string.from_float(threshold)))
    string.append(stage, ":release=")
    string.append(stage, str.view(string.from_float(release)))
    return option.some(stage)
  }
  if str.eq(str.view(kind), "normalize") {
    let target: f64 = editor.filter_param(doc, filter, "target", -14.0)
    if target > -5.0 or target < -70.0 { return option.none() }
    return option.some(text.concat("loudnorm=I=", str.view(string.from_float(target))))
  }
  if str.eq(str.view(kind), "delay") {
    let delay_ms: f64 = editor.filter_param(doc, filter, "time", 250.0)
    let decay: f64 = editor.filter_param(doc, filter, "decay", 0.4)
    if delay_ms <= 0.0 { return option.some(string.copy("anull")) }
    if decay > 0.95 { return option.none() }
    let millis: i64 = cast.sat(delay_ms)
    let bounded_ms: i64 = if millis < 1 { 1 } else { millis }
    var stage: string = text.concat("aecho=0.8:0.9:", str.view(string.from_int(bounded_ms)))
    string.append(stage, ":")
    string.append(stage, str.view(string.from_float(decay)))
    return option.some(stage)
  }
  if str.eq(str.view(kind), "reverb") {
    let amount: f64 = editor.filter_param(doc, filter, "amount", 0.3)
    let room: f64 = editor.filter_param(doc, filter, "room", 0.5)
    if amount <= 0.0 { return option.some(string.copy("anull")) }
    var delays: array<string> = array.new()
    var decays: array<string> = array.new()
    var taps: array<i64> = [47, 97, 151, 211]
    var at: u64 = 0
    loop {
      if at >= array.len(taps) { break }
      let tap: f64 = cast.float(array.get(taps, at))
      let delay_ms: i64 = cast.sat(tap * (0.5 + room))
      let bounded_ms: i64 = if delay_ms < 1 { 1 } else { delay_ms }
      array.push(delays, string.from_int(bounded_ms))
      array.push(decays, string.from_float(amount * (0.5 - cast.float(at) * 0.1)))
      at = at + 1
    }
    var stage: string = text.concat("aecho=0.8:0.9:", str.view(text.join(delays, "|")))
    string.append(stage, ":")
    string.append(stage, str.view(text.join(decays, "|")))
    return option.some(stage)
  }
  if str.eq(str.view(kind), "pitch") {
    let semitones: f64 = editor.filter_param(doc, filter, "semitones", 0.0)
    let ratio: f64 = math.pow(2.0, semitones / 12.0)
    return option.some(text.concat("rubberband=pitch=", str.view(string.from_float(ratio))))
  }
  if str.eq(str.view(kind), "low_pass") {
    return option.some(text.concat("lowpass=f=", str.view(string.from_float(
      editor.filter_param(doc, filter, "cutoff", 8000.0)))))
  }
  if str.eq(str.view(kind), "high_pass") {
    return option.some(text.concat("highpass=f=", str.view(string.from_float(
      editor.filter_param(doc, filter, "cutoff", 80.0)))))
  }
  if str.eq(str.view(kind), "tremolo") {
    var stage: string = text.concat("tremolo=f=", str.view(string.from_float(
      editor.filter_param(doc, filter, "rate", 5.0))))
    string.append(stage, ":d=")
    let depth: f64 = editor.filter_param(doc, filter, "depth", 0.5)
    string.append(stage, str.view(string.from_float(depth)))
    return option.some(stage)
  }
  if str.eq(str.view(kind), "bass") or str.eq(str.view(kind), "treble") {
    return option.some(text.concat(if str.eq(str.view(kind), "bass") { "bass=g=" }
      else { "treble=g=" }, str.view(string.from_float(
      editor.filter_param(doc, filter, "level", 0.0)))))
  }
  if str.eq(str.view(kind), "notch") {
    var stage: string = text.concat("bandreject=f=", str.view(string.from_float(
      editor.filter_param(doc, filter, "frequency", 1000.0))))
    string.append(stage, ":t=q:w=")
    string.append(stage, str.view(string.from_float(
      editor.filter_param(doc, filter, "width", 1.0))))
    return option.some(stage)
  }
  if str.eq(str.view(kind), "chorus") {
    let depth: f64 = editor.filter_param(doc, filter, "depth", 0.4)
    let rate: f64 = editor.filter_param(doc, filter, "rate", 1.5)
    var stage: string = text.concat("chorus=0.5:0.9:50:0.4:", str.view(string.from_float(rate)))
    string.append(stage, ":")
    string.append(stage, str.view(string.from_float(depth * 2.0)))
    return option.some(stage)
  }
  if str.eq(str.view(kind), "flanger") {
    let depth: f64 = editor.filter_param(doc, filter, "depth", 0.4)
    let rate: f64 = editor.filter_param(doc, filter, "rate", 0.5)
    var stage: string = text.concat("flanger=depth=", str.view(string.from_float(depth * 8.0)))
    string.append(stage, ":speed=")
    string.append(stage, str.view(string.from_float(rate)))
    return option.some(stage)
  }
  if str.eq(str.view(kind), "phaser") {
    let depth: f64 = editor.filter_param(doc, filter, "depth", 0.5)
    let rate: f64 = editor.filter_param(doc, filter, "rate", 0.8)
    if rate > 2.0 { return option.none() }
    var stage: string = text.concat("aphaser=decay=", str.view(string.from_float(
      0.1 + depth * 0.8)))
    string.append(stage, ":speed=")
    string.append(stage, str.view(string.from_float(rate)))
    return option.some(stage)
  }
  if str.eq(str.view(kind), "limiter") {
    let ceiling: f64 = editor.filter_param(doc, filter, "ceiling", -1.0)
    let linear: f64 = math.pow(10.0, ceiling / 20.0)
    let limited: f64 = if linear < 0.0625 { 0.0625 }
      else if linear > 1.0 { 1.0 } else { linear }
    var stage: string = text.concat("alimiter=limit=", str.view(string.from_float(limited)))
    string.append(stage, ":level=disabled")
    return option.some(stage)
  }
  option.none()
}

fn tempo_stages(stages: ref<array<string>>, speed: f64) -> unit effects {alloc} {
  var remaining: f64 = speed
  loop {
    if remaining <= 2.0 { break }
    array.push(stages, string.copy("atempo=2"))
    remaining = remaining / 2.0
  }
  loop {
    if remaining >= 0.5 { break }
    array.push(stages, string.copy("atempo=0.5"))
    remaining = remaining * 2.0
  }
  if remaining < 0.999999 or remaining > 1.000001 {
    array.push(stages, text.concat("atempo=", str.view(string.from_float(remaining))))
  }
  ()
}

// Absolute rounded sample boundaries are shared by playback chunks and export.
// Preserve original frame coordinates too: std.curve Catmull tangents use them.
fn audio_gain_keys(doc: ref<editor.Document>, clip: editor.Clip, begin: i64, fps: f64)
    -> result<string, string> effects {alloc} {
  var points: array<string> = array.new()
  var at: u64 = 0
  loop { if at >= array.len(struct.borrow(doc, field=keys)) { break }
    let key: editor.Key = array.get(struct.borrow(doc, field=keys), at)
    at = at + 1
    if key.clip != clip.id { continue }
    let name: string = editor.name_text(doc, key.param)
    if not str.eq(str.view(name), "gain") { continue }
    if not math.is_finite(key.value) or key.value < 0.0 or key.value > 3.4028234e38 or
        key.interp >= 38 {
      return result.err("[GA_AUDIO_GAIN_KEYS] Invalid clip gain keyframe")
    }
    var fields: array<string> = [string.from_int(audio_sample_frame(clip.start + key.frame, fps)),
      string.from_int(key.frame), string.from_float(key.value), string.from_int(key.interp)]
    array.push(points, text.join(fields, ","))
  }
  if array.len(points) == 0 { return result.ok(string.copy("")) }
  var token: string = string.copy("GAINKEYS:")
  string.append(token, str.view(string.from_int(audio_sample_frame(begin, fps))))
  string.append(token, ":")
  string.append(token, str.view(text.join(points, "/")))
  result.ok(token)
}

// Animated clip pan uses the gain curve adapter with signed [-1,1] values. The
// worker applies stereotools output balance per destination sample after the
// clip chain; audio_pan_post_chain proves that position equals the static stage.
fn audio_pan_keys(doc: ref<editor.Document>, clip: editor.Clip, begin: i64, fps: f64)
    -> result<string, string> effects {alloc} {
  var points: array<string> = array.new()
  var at: u64 = 0
  loop { if at >= array.len(struct.borrow(doc, field=keys)) { break }
    let key: editor.Key = array.get(struct.borrow(doc, field=keys), at)
    at = at + 1
    if key.clip != clip.id { continue }
    let name: string = editor.name_text(doc, key.param)
    if not str.eq(str.view(name), "pan") { continue }
    if not math.is_finite(key.value) or key.value < -1.0 or key.value > 1.0 or key.interp >= 38 {
      return result.err("[GA_AUDIO_PAN_KEYS] Invalid clip pan keyframe")
    }
    var fields: array<string> = [string.from_int(audio_sample_frame(clip.start + key.frame, fps)),
      string.from_int(key.frame), string.from_float(key.value), string.from_int(key.interp)]
    array.push(points, text.join(fields, ","))
  }
  if array.len(points) == 0 { return result.ok(string.copy("")) }
  var token: string = string.copy("PANKEYS:")
  string.append(token, str.view(string.from_int(audio_sample_frame(begin, fps))))
  string.append(token, ":")
  string.append(token, str.view(text.join(points, "/")))
  result.ok(token)
}

// Gain, pan and mute stages are memoryless per-channel scales, so they commute
// with a per-sample balance. Any other enabled audio stage keeps the refusal.
fn audio_pan_post_chain(doc: ref<editor.Document>, clip: editor.Clip) -> bool effects {alloc} {
  var at: u32 = 0
  loop {match editor.filter_at(doc,clip.id,at) {none=>{break},some(filter)=>{
    if editor.filter_enabled(doc,filter) {
      let kind: string = editor.filter_kind(doc,filter)
      if chrome.is_audio_kind(kind) and not str.eq(kind,"gain") and not str.eq(kind,"pan") and
          not str.eq(kind,"volume") and not str.eq(kind,"mute") {return false}
    }
  },}
    at=at+1
  }
  true
}

// Fade lengths remain in raw sequence frames through interpolation, including
// surrounding off-body keys. The worker converts each evaluated length to
// seconds and applies independent in/out ramps in destination-sample time.
fn audio_fade_keys(doc: ref<editor.Document>, clip: editor.Clip, begin: i64, end: i64, fps: f64, streaming: bool)
    -> result<string, string> effects {alloc} {
  var incoming: array<string> = array.new()
  var outgoing: array<string> = array.new()
  var previous_in: i64 = -9007199254740991
  var previous_out: i64 = -9007199254740991
  var sample_in: i64 = -9007199254740991
  var sample_out: i64 = -9007199254740991
  var at: u64 = 0
  loop {if at >= array.len(struct.borrow(doc,field=keys)) {break}
    let key: editor.Key = array.get(struct.borrow(doc,field=keys),at)
    at=at+1
    if key.clip != clip.id {continue}
    let name: string = editor.name_text(doc,key.param)
    if not str.eq(str.view(name),"fade_in") and not str.eq(str.view(name),"fade_out") {continue}
    if key.owner != clip.owner or not math.is_finite(key.value) or
        math.abs(key.value) > 3.4028234663852886e38 or key.interp >= 38 or
        key.frame < -9007199254740991 or key.frame > 9007199254740991 or
        clip.start < 0 or clip.start > 9007199254740991 or begin < 0 or begin > 9007199254740991 or
        not math.is_finite(fps) or fps <= 0.0 or not math.is_finite(3.4028234663852886e38/fps) {
      return result.err("[GA_AUDIO_FADE_KEYS] Invalid clip fade keyframe")
    }
    let frame: f64 = cast.float(clip.start)+cast.float(key.frame)
    let sample: f64 = math.floor(frame*48000.0/fps+0.5)
    let origin: f64 = math.floor(cast.float(begin)*48000.0/fps+0.5)
    let placement: f64 = math.floor(cast.float(clip.start)*48000.0/fps+0.5)
    let last: f64 = if streaming {math.floor(cast.float(end)*48000.0/fps+0.5)-1.0}else{origin+1073741822.0}
    if math.abs(frame) > 9007199254740991.0 or not math.is_finite(sample) or
        math.abs(sample) > 9007199254740991.0 or not math.is_finite(origin) or
        origin > 9007199254740991.0 or not math.is_finite(placement) or placement > 9007199254740991.0 or
        not math.is_finite(last) or last > 9007199254740991.0 or (streaming and last < origin) {
      return result.err("[GA_AUDIO_FADE_KEYS] Fade keyframe exceeds exact sample range")
    }
    let at_sample: i64 = cast.sat(sample)
    let is_in: bool = str.eq(str.view(name),"fade_in")
    if (is_in and array.len(incoming) >= 65536) or (not is_in and array.len(outgoing) >= 65536) or
        (is_in and array.len(incoming) > 0 and (key.frame <= previous_in or at_sample <= sample_in)) or
        (not is_in and array.len(outgoing) > 0 and (key.frame <= previous_out or at_sample <= sample_out)) {
      return result.err("[GA_AUDIO_FADE_KEYS] Fade keyframe order or count is invalid")
    }
    var fields: array<string> = [string.from_int(at_sample),
      string.from_int(key.frame),string.from_float(key.value),string.from_int(key.interp)]
    let point: string = text.join(fields,",")
    if is_in {array.push(incoming,point)
      previous_in=key.frame
      sample_in=at_sample
    }else{array.push(outgoing,point)
      previous_out=key.frame
      sample_out=at_sample}
  }
  if array.len(incoming) == 0 and array.len(outgoing) == 0 {return result.ok(string.copy(""))}
  var fields: array<string> = [string.copy("FADEKEYS"),string.from_int(audio_sample_frame(begin,fps)),
    string.from_int(clip.start),string.from_float(fps),
    if array.len(incoming) == 0 {string.copy("-")}else{text.join(incoming,"/")},
    if array.len(outgoing) == 0 {string.copy("-")}else{text.join(outgoing,"/")}]
  result.ok(text.join(fields,":"))
}

// Only contributing clip contexts reach this preflight. Gain/fade curves, and
// pan curves over memoryless chains, have exact sample envelopes; the remaining
// active audio curves cannot yet retain their DSP/time history. Dormant
// instance curves do not affect audible output.
fn audio_automation_preflight(doc: ref<editor.Document>, clip: editor.Clip, held: bool)
    -> result<unit,string> effects {alloc} {
  var at: u64 = 0
  loop {if at >= array.len(struct.borrow(doc,field=keys)) {break}
    let key: editor.Key = array.get(struct.borrow(doc,field=keys),at)
    at=at+1
    if key.clip != clip.id {continue}
    let name: string = editor.name_text(doc,key.param)
    if str.eq(name,"speed") {
      return result.err("[GA_AUDIO_AUTOMATION_UNSUPPORTED] Animated clip speed needs preserved audio history")
    }
    if not held and str.eq(name,"pan") and not audio_pan_post_chain(doc,clip) {
      return result.err("[GA_AUDIO_AUTOMATION_UNSUPPORTED] Animated clip pan before a stateful audio filter needs preserved audio history")
    }
    let canonical: string = filter_keys.canonical(name)
    var family: array<string> = text.split(canonical,".")
    if array.len(family) != 2 {continue}
    let kind: str = array.borrow(family,0)
    if (held and not str.eq(kind,"speed")) or
        (not str.eq(kind,"speed") and not chrome.is_audio_kind(kind)) {continue}
    var parts: array<string> = text.split(name,".")
    let scoped: u64 = if array.len(parts) == 4 and not str.eq(name,canonical) {
      match text.parse_u64(array.borrow(parts,1)) {some(value)=>value,none=>0,}
    }else{0}
    var filter_at: u32 = 0
    loop {match editor.filter_at(doc,clip.id,filter_at) {
      none=>{break},some(filter)=>{
        if (scoped == 0 or filter == scoped) and editor.filter_enabled(doc,filter) and
            str.eq(editor.filter_kind(doc,filter),kind) {
          return result.err("[GA_AUDIO_AUTOMATION_UNSUPPORTED] Animated enabled audio filter needs preserved graph history")
        }
      },}
      filter_at=filter_at+1
    }
  }
  result.ok(())
}

fn audio_tail_graph(doc:ref<editor.Document>,clip:editor.Clip)->bool effects {alloc} {
  if clip.nested != 0 {return false}
  var at:u32=0
  loop {match editor.filter_at(doc,clip.id,at) {none=>{break},some(filter)=>{
    if editor.filter_enabled(doc,filter) {
      let kind:string=editor.filter_kind(doc,filter)
      if str.eq(kind,"delay") or str.eq(kind,"reverb") {return true}
    }
  },}
    at=at+1
  }
  false
}

// Only this proved direct static phase may retain the original actual EOF tail.
// The SDK uses the same capability when opening destructive editing guards.
fn audio_tail_owner(doc:ref<editor.Document>,clip:editor.Clip)->bool effects {alloc} {
  if not audio_tail_graph(doc,clip) or not editor.audio_tail_context_potential(doc,clip) {return false}
  let context:editor.AudioContext=editor.audio_context_for(doc,clip)
  context.offset+clip.length == context.length
}

// Native EOF is distinct from the legacy authored-body cache. The original
// forward graph is processed at normalized 48k before its actual count is read.
// No new schema is authored; END2 identifies this runtime-only accepted bound.
fn audio_native_eof_owner(doc:ref<editor.Document>,clip:editor.Clip)->bool effects {alloc} {
  if clip.nested!=0 or clip.reverse or not editor.clip_has_audio(clip) or
      not editor.audio_context_valid(doc,clip) {return false}
  let speed:f64=effective_speed(doc,clip)
  if not math.is_finite(speed) or speed<0.05 or speed>16.0 {return false}
  let source_slot:u64=match editor.source_slot(doc,clip.source) {none=>{return false},some(v)=>v,}
  let rate:u32=struct.get(array.borrow(struct.borrow(doc,field=sources),source_slot),field=audio_rate)
  if rate!=44100 and rate!=48000 {return false}
  var needed:bool=speed!=1.0
  var at:u32=0
  loop {match editor.filter_at(doc,clip.id,at) {none=>{break},some(filter)=>{
    if editor.filter_enabled(doc,filter) {
      let kind:string=editor.filter_kind(doc,filter)
      if chrome.is_audio_kind(kind) {
        if str.eq(kind,"compressor") or str.eq(kind,"gate") or str.eq(kind,"limiter") or
            str.eq(kind,"eq_3band") or str.eq(kind,"eq_10band") {needed=true}
        else if not str.eq(kind,"volume") and not str.eq(kind,"mute") and not str.eq(kind,"pan") {return false}
      }
    }
  },}
    at=at+1
  }
  if not needed {return false}
  let context:editor.AudioContext=editor.audio_context_for(doc,clip)
  let end:i64=match context.extent {none=>context.length,some(v)=>v.processing_length,}
  if context.reverse or context.offset+clip.length!=end {return false}
  var key_at:u64=0
  loop {if key_at>=array.len(struct.borrow(doc,field=keys)) {break}
    let key:editor.Key=array.get(struct.borrow(doc,field=keys),key_at)
    if key.clip==clip.id {
      let name:string=editor.name_text(doc,key.param)
      if str.eq(name,"fade_in") or str.eq(name,"fade_out") {return false}
    }
    key_at=key_at+1
  }
  true
}

// Context-bearing clips need a full original DSP graph followed by an exact
// sample crop. Legacy AUDIO/AUDIOSTREAM remains unchanged for context-free clips.
fn audio_context_graph(doc: ref<editor.Document>, clip: editor.Clip) -> bool effects {alloc} {
  if audio_tail_graph(doc,clip) and editor.audio_tail_context_potential(doc,clip) {return true}
  let context: editor.AudioContext = match editor.audio_context(clip) {none=>{
    // These verified same-length graphs need their full authored history even
    // before the first cut. Unknown/tail-producing legacy chains keep their
    // existing whole-AUDIO behavior; no blanket tail-policy conversion.
    var temporal: bool = false
    var filter_at: u32 = 0
    loop {match editor.filter_at(doc,clip.id,filter_at) {none=>{break},some(filter)=>{
      if editor.filter_enabled(doc,filter) {
        let kind: string = editor.filter_kind(doc,filter)
        if chrome.is_audio_kind(kind) {
          if str.eq(kind,"compressor") or str.eq(kind,"gate") or str.eq(kind,"limiter") or
              str.eq(kind,"eq_3band") or str.eq(kind,"eq_10band") or str.eq(kind,"normalize") {
            temporal=true
          }else if not str.eq(kind,"volume") and not str.eq(kind,"mute") and not str.eq(kind,"pan") {
            return false
          }
        }
      }
    },}
      filter_at=filter_at+1
    }
    return temporal
  },some(value)=>value,}
  if option.is_some(context.extent) {return true}
  if not editor.audio_context_valid(doc,clip) {return true}
  if clip.nested != 0 or context.reverse or context.rate != 1.0 {return true}
  let samples: f64 = 48000.0/context.fps
  if not math.is_finite(samples) or samples != math.floor(samples) {return true}
  let slot: u64 = match editor.source_slot(doc,clip.source) {none=>{return true},some(value)=>value,}
  if struct.get(array.borrow(struct.borrow(doc,field=sources),slot),field=audio_rate) != 48000 {return true}
  var at: u32 = 0
  loop {match editor.filter_at(doc,clip.id,at) {none=>{break},some(filter)=>{
    if editor.filter_enabled(doc,filter) and chrome.is_audio_kind(editor.filter_kind(doc,filter)) {return true}
  },}
    at=at+1
  }
  // Origin decoding already preserves compressed codec state. At native 48k,
  // unit forward rate and integral frame/sample phase, a trim is an exact native
  // sample selection; pan/gain/fades are memoryless. No float body cache needed.
  false
}

// Whole-input/unknown tail policies retain the owned full bus. Proven causal
// flat graphs use a retained original decoder and exact bounded output pulls.
fn audio_context_disk(doc:ref<editor.Document>,clip:editor.Clip)->bool effects {alloc} {
  if clip.nested!=0 {return true}
  if not audio_context_graph(doc,clip) {return false}
  var at:u32=0
  loop {match editor.filter_at(doc,clip.id,at) {none=>{break},some(filter)=>{
    if editor.filter_enabled(doc,filter) {
      let kind:string=editor.filter_kind(doc,filter)
      if chrome.is_audio_kind(kind) and not str.eq(kind,"compressor") and not str.eq(kind,"gate") and
          not str.eq(kind,"limiter") and not str.eq(kind,"eq_3band") and not str.eq(kind,"eq_10band") and
          not str.eq(kind,"volume") and not str.eq(kind,"mute") and not str.eq(kind,"pan") {return true}
    }
  },}
    at=at+1
  }
  false
}

fn flat_audio_lines(doc: ref<editor.Document>, start: i64, finish: i64, fps: f64, streaming: bool)
               -> result<array<string>, string> effects {alloc} {
  var lines: array<string> = array.new()
  var at: u64 = 0
  loop {
    if at >= editor.clip_count(doc) { break }
    let clip: editor.Clip = match editor.clip_at(doc, at) {
      none => { break },
      some(value) => value,
    }
    at = at + 1
    if clip.owner != doc.active or not clip.enabled or not editor.clip_has_audio(clip) or
       not editor.track_audible(doc, clip.track) { continue }
    // Preserve context-free complete whole-output EOF/tail behavior. Device
    // pulls and fresh subranges retain the original graph for causal history.
    let legacy_original:bool=not streaming and not option.is_some(editor.audio_context(clip)) and start<=clip.start
    if audio_context_disk(doc,clip) and not legacy_original {continue}
    let context_requested:bool=not legacy_original and audio_context_graph(doc,clip)
    let source_slot: u64 = match editor.source_slot(doc, clip.source) {
      none => { continue },
      some(slot) => slot,
    }
    var source: SourceInfo = source_info(doc, source_slot)
    if not source.audio { continue }
    let begin: i64 = if clip.start > start { clip.start } else { start }
    let end: i64 = if editor.clip_end(clip) < finish { editor.clip_end(clip) } else { finish }
    if end <= begin { continue }
    let speed: f64 = effective_speed(doc, clip)
    // A static held picture is silent, except that an active Rate curve could
    // make it progress. Refuse that unsupported time context before skipping it.
    try audio_automation_preflight(doc,clip,speed == 0.0)
    if speed == 0.0 { continue }
    if not source.online {return result.err("[GA_AUDIO_SOURCE_OFFLINE] Audible clip source is offline")}
    if not source_range_ok(doc, clip) {
      return result.err("audio clip speed and length exceed its source frames")
    }
    if not math.is_finite(speed) or speed < 0.05 or speed > 16.0 {
      return result.err("audible clip speed must be between 0.05 and 16")
    }
    let local_start: i64 = if clip.reverse { if streaming { 0 } else { clip.length - (end - clip.start) } }
      else { begin - clip.start }
    let source_s: f64 = cast.float(clip.source_in) / fps +
      cast.float(local_start) * speed / fps
    var duration_s: f64 = cast.float(end - begin) * speed / fps
    if source.frames > 0 and source.fps > 0.0 {
      let remaining_s: f64 = cast.float(source.frames) / source.fps - source_s
      if duration_s > remaining_s { duration_s = remaining_s }
    }
    if duration_s <= 0.0 { continue }
    let legacy_destination_s: f64 = if streaming {
      cast.float(audio_sample_frame(begin, fps) - audio_sample_frame(start, fps)) / 48000.0
    } else { cast.float(begin - start) / fps }
    var stages: array<string> = array.new()
    if clip.reverse { array.push(stages, string.copy("areverse")) }
    tempo_stages(stages, speed)
    let pan_keys: string = match audio_pan_keys(doc, clip, begin, fps) {
      err(problem) => { return result.err(problem) }, ok(value) => value,
    }
    // A keyed curve replaces the static clip pan stage; track pan stays static.
    if clip.pan != 0.0 and str.len(str.view(pan_keys)) == 0 {
      var stage: string = string.copy("stereotools=balance_out=")
      string.append(stage, str.view(string.from_float(clip.pan)))
      array.push(stages, stage)
    }
    let track_pan: f64 = editor.track_pan(doc, clip.track)
    if track_pan != 0.0 {
      var stage: string = string.copy("stereotools=balance_out=")
      string.append(stage, str.view(string.from_float(track_pan)))
      array.push(stages, stage)
    }
    var filter_index: u32 = 0
    loop {
      match editor.filter_at(doc, clip.id, filter_index) {
        none => { break },
        some(filter) => {
          if editor.filter_enabled(doc, filter) {
            let kind: string = editor.filter_kind(doc, filter)
            if chrome.is_audio_kind(str.view(kind)) {
              match audio_filter_stage(doc, filter) {
                none => { return result.err("an audio clip uses an unsupported audio filter") },
                some(stage) => { array.push(stages, stage) },
              }
            } else if not str.eq(str.view(kind), "speed") and
                      editor.track_kind(doc, clip.track) != editor.track_video() {
              return result.err("a picture filter cannot render on an audio lane")
            }
          }
        },
      }
      filter_index = filter_index + 1
    }
    let chain: string = if array.len(stages) == 0 { string.copy("-") }
      else { text.join(stages, ",") }
    let gain_keys: string = match audio_gain_keys(doc, clip, begin, fps) {
      err(problem) => { return result.err(problem) }, ok(value) => value,
    }
    let fade_keys: string = match audio_fade_keys(doc, clip, begin, end, fps, streaming) {
      err(problem) => {return result.err(problem)},ok(value)=>value,
    }
    let destination_s: f64 = if context_requested or str.len(str.view(fade_keys)) != 0 {
      cast.float(audio_sample_frame(begin,fps)-audio_sample_frame(start,fps))/48000.0
    }else{legacy_destination_s}
    var fields: array<string> = [
      string.copy(if streaming { "AUDIOSTREAM" } else { "AUDIO" }),
      provider.wire_path(str.view(struct.borrow(source, field=path))),
      string.from_float(source_s), string.from_float(duration_s),
      string.from_float(destination_s),
      string.from_float(if str.len(str.view(gain_keys)) == 0 {
        editor.effective_gain(doc, clip.id)
      } else { editor.track_gain(doc, clip.track) }),
      string.from_float(cast.float(clip.fade_in) / fps),
      string.from_float(cast.float(clip.fade_out) / fps),
      string.from_float(cast.float(clip.length) / fps),
      string.from_float(if context_requested {cast.float(audio_sample_frame(begin,fps)-audio_sample_frame(clip.start,fps))/48000.0}else{cast.float(begin - clip.start) / fps}),
      chain
    ]
    if streaming {
      var remaining_source: f64 = cast.float(editor.clip_end(clip) - begin) * speed / fps
      if source.frames > 0 and source.fps > 0.0 {
        let available: f64 = cast.float(source.frames) / source.fps - source_s
        if remaining_source > available { remaining_source = available }
      }
      array.push(fields, string.from_int(clip.id))
      array.push(fields, string.from_float(remaining_source))
      array.push(fields, string.from_int(audio_sample_frame(end, fps) - audio_sample_frame(begin, fps)))
    }
    if context_requested {
      if not editor.audio_context_valid(doc,clip) {return result.err("[GA_AUDIO_CONTEXT] Invalid original audio processing window")}
      let context:editor.AudioContext=editor.audio_context_for(doc,clip)
      let original_source:f64=cast.float(context.source_in)/context.fps
      var original_duration:f64=cast.float(context.length)*context.rate/context.fps
      let processing_length:i64=match context.extent {none=>context.length,some(extent)=>{
        original_duration=cast.float(extent.input_duration_us)/1000000.0
        extent.processing_length},}
      if not option.is_some(context.extent) and source.frames>0 and source.fps>0.0 {
        let available:f64=cast.float(source.frames)/source.fps-original_source
        if original_duration>available {original_duration=available}
      }
      let request_crop:u64=context.crop_start+cast.sat(audio_sample_frame(begin,fps)-audio_sample_frame(clip.start,fps))
      var context_fields:array<string> = [string.copy(if option.is_some(context.extent) {"AUDIOCTX2"}else{"AUDIOCTX"}),
        string.from_float(original_source),string.from_float(original_duration),string.from_int(context.output_frames)]
      match context.extent {none=>{},some(extent)=>{array.push(context_fields,string.from_int(extent.processing_frames))},}
      array.push(context_fields,string.from_int(request_crop))
      array.push(context_fields,string.from_int(audio_sample_frame(end,fps)-audio_sample_frame(begin,fps)))
      if not streaming and end==editor.clip_end(clip) and context.offset+clip.length==processing_length {
        array.push(context_fields,"TAIL")
      }
      array.push(fields,text.join(context_fields,":"))
    }
    if str.len(str.view(gain_keys)) != 0 { array.push(fields, gain_keys) }
    if str.len(str.view(fade_keys)) != 0 { array.push(fields, fade_keys) }
    if str.len(str.view(pan_keys)) != 0 { array.push(fields, pan_keys) }
    array.push(lines, text.join(fields, " "))
  }
  result.ok(lines)
}

// Nested sound is a tree of sequence INSTANCES, not a flattened list of sources.
// A compound's filters and envelopes act on the child sum. The worker renders
// each complete instance to an unclipped float cache, then slices destination
// samples for playback, audition and export using the same cached history.
type NestedAudioTree = struct {lines: array<string>, nodes: u64, disk_bytes: f64, descriptor_bytes: u64}
type NestedAudioBounds = struct {first: i64, last: i64, fps: f64, speed: f64}

fn nested_audio_bounds(doc: ref<editor.Document>, clip: editor.Clip)
    -> result<NestedAudioBounds,string> effects {alloc} {
  match editor.sequence_slot(doc,clip.owner) {
    none=>{return result.err("[GA_AUDIO_NESTED_PROTOCOL] Nested clip owner is missing")},some(_)=>{},
  }
  let track: u64 = match editor.track_slot(doc,clip.track) {
    none=>{return result.err("[GA_AUDIO_NESTED_PROTOCOL] Nested clip track is missing")},some(slot)=>slot,
  }
  if struct.get(array.borrow(struct.borrow(doc,field=tracks),track),field=owner) != clip.owner {
    return result.err("[GA_AUDIO_NESTED_PROTOCOL] Nested track belongs to a different sequence")
  }
  let fps: f64 = editor.sequence_fps(doc,clip.owner)
  let speed: f64 = effective_speed(doc,clip)
  if not math.is_finite(fps) or fps <= 0.0 or
      not math.is_finite(3.4028234663852886e38/fps) or
      clip.start < 0 or clip.start > 9007199254740991 or
      clip.length <= 0 or clip.length > 9007199254740991 or
      clip.source_in < 0 or clip.source_in > 9007199254740991 or
      not math.is_finite(speed) or (speed != 0.0 and (speed < 0.05 or speed > 16.0)) {
    return result.err("[GA_AUDIO_NESTED_PROTOCOL] Invalid nested clip time or rate")
  }
  let first: f64 = math.floor(cast.float(clip.start)*48000.0/fps+0.5)
  let last: f64 = math.floor((cast.float(clip.start)+cast.float(clip.length))*48000.0/fps+0.5)
  if not math.is_finite(first) or not math.is_finite(last) or
      first > 9007199254740991.0 or last > 9007199254740991.0 or
      last <= first or last-first > 1036800000.0 {
    return result.err("[GA_AUDIO_NESTED_CAPACITY] Nested output exceeds exact samples or six hours")
  }
  result.ok(NestedAudioBounds {first:cast.sat(first),last:cast.sat(last),fps:fps,speed:speed})
}

fn clip_pan_keyed(doc: ref<editor.Document>, clip: editor.Clip) -> bool effects {alloc} {
  var at: u64 = 0
  loop {if at >= array.len(struct.borrow(doc,field=keys)) {break}
    let key: editor.Key = array.get(struct.borrow(doc,field=keys),at)
    at=at+1
    if key.clip == clip.id and str.eq(editor.name_text(doc,key.param),"pan") {return true}
  }
  false
}

fn nested_audio_chain(doc: ref<editor.Document>, clip: editor.Clip, speed: f64)
    -> result<string,string> effects {alloc} {
  var stages: array<string> = array.new()
  if clip.reverse {array.push(stages,string.copy("areverse"))}
  tempo_stages(stages,speed)
  if not math.is_finite(clip.pan) or clip.pan < -1.0 or clip.pan > 1.0 {
    return result.err("[GA_AUDIO_NESTED_PROTOCOL] Invalid nested clip pan")
  }
  if clip.pan != 0.0 and not clip_pan_keyed(doc,clip) {
    array.push(stages,text.concat("stereotools=balance_out=",string.from_float(clip.pan)))
  }
  let track_pan: f64 = editor.track_pan(doc,clip.track)
  if not math.is_finite(track_pan) or track_pan < -1.0 or track_pan > 1.0 {
    return result.err("[GA_AUDIO_NESTED_PROTOCOL] Invalid nested track pan")
  }
  if track_pan != 0.0 {
    array.push(stages,text.concat("stereotools=balance_out=",string.from_float(track_pan)))
  }
  var index: u32 = 0
  loop {match editor.filter_at(doc,clip.id,index) {
    none=>{break},some(filter)=>{
      if editor.filter_enabled(doc,filter) {
        let kind: string = editor.filter_kind(doc,filter)
        if chrome.is_audio_kind(kind) {
          match audio_filter_stage(doc,filter) {
            some(stage)=>array.push(stages,stage),
            none=>{return result.err("[GA_AUDIO_NESTED_RENDER] Nested clip uses an unsupported audio filter")},
          }
        }else if not str.eq(kind,"speed") and editor.track_kind(doc,clip.track) != editor.track_video() {
          return result.err("[GA_AUDIO_NESTED_RENDER] A picture filter cannot render on an audio lane")
        }
      }
    },}
    index=index+1
  }
  result.ok(if array.len(stages) == 0 {string.copy("-")}else{text.join(stages,",")})
}

// Before the existing raw-frame gain serializer adds signed frame coordinates,
// prove its arithmetic and exact sample domain for this recursively owned node.
fn nested_gain_preflight(doc: ref<editor.Document>, clip: editor.Clip, fps: f64)
    -> result<unit,string> effects {alloc} {
  var index: u64 = 0
  var count: u64 = 0
  var previous: i64 = -9007199254740991
  var previous_sample: f64 = -9007199254740991.0
  loop {if index >= array.len(struct.borrow(doc,field=keys)) {break}
    let key: editor.Key = array.get(struct.borrow(doc,field=keys),index)
    index=index+1
    if key.clip != clip.id or not str.eq(editor.name_text(doc,key.param),"gain") {continue}
    let absolute: f64 = cast.float(clip.start)+cast.float(key.frame)
    let sample: f64 = math.floor(absolute*48000.0/fps+0.5)
    if key.owner != clip.owner or key.frame < -9007199254740991 or key.frame > 9007199254740991 or
        not math.is_finite(key.value) or key.value < 0.0 or key.value > 3.4028234e38 or key.interp >= 38 or
        math.abs(absolute) > 9007199254740991.0 or not math.is_finite(sample) or
        math.abs(sample) > 9007199254740991.0 or count >= 65536 or
        (count != 0 and (key.frame <= previous or sample <= previous_sample)) {
      return result.err("[GA_AUDIO_GAIN_KEYS] Invalid nested clip gain keyframe")
    }
    previous=key.frame
    previous_sample=sample
    count=count+1
  }
  result.ok(())
}

fn nested_audio_append(tree: ref<NestedAudioTree>, fields: ref<array<string>>, bytes: f64)
    -> result<unit,string> effects {alloc} {
  if tree.nodes >= 4096 or not math.is_finite(bytes) or bytes < 0.0 or
      tree.disk_bytes+bytes > 34359738368.0 {
    return result.err("[GA_AUDIO_NESTED_CAPACITY] Nested audio exceeds node or float cache limits")
  }
  let row: string = text.join(fields," ")
  let size: u64 = str.len(row)+1
  if tree.descriptor_bytes+size > 960000 {
    return result.err("[GA_AUDIO_NESTED_CAPACITY] Nested audio descriptor exceeds the playback mailbox")
  }
  array.push(struct.borrow(tree,field=lines),row)
  struct.set(tree,tree.nodes+1,field=nodes)
  struct.set(tree,tree.disk_bytes+bytes,field=disk_bytes)
  struct.set(tree,tree.descriptor_bytes+size,field=descriptor_bytes)
  result.ok(())
}

fn nested_audio_define(doc: ref<editor.Document>, clip: editor.Clip, instance: str, parent: str,
    ancestors: ref<array<u64>>, tree: ref<NestedAudioTree>, direct_tail:bool,native_eof:bool)
    -> result<unit,string> effects {alloc} {
  if not editor.clip_has_audio(clip) {return result.ok(())}
  if array.len(ancestors) > 16 or str.len(instance) > 256 {
    return result.err("[GA_AUDIO_NESTED_CAPACITY] Nested audio exceeds depth or instance path limits")
  }
  let bounds: NestedAudioBounds = try nested_audio_bounds(doc,clip)
  if not editor.audio_context_valid(doc,clip) {
    return result.err("[GA_AUDIO_CONTEXT] Invalid preserved audio processing window")
  }
  var processing: editor.Clip = clip
  let context: editor.AudioContext = editor.audio_context_for(doc,clip)
  let has_context: bool = option.is_some(editor.audio_context(clip)) or direct_tail
  if has_context {
    struct.set(processing,context.source_in,field=source_in)
    struct.set(processing,match context.extent {none=>context.length,some(extent)=>extent.processing_length,},field=length)
  }
  if clip.nested == 0 {
    let slot: u64 = match editor.source_slot(doc,clip.source) {
      some(value)=>value,none=>{return result.err("[GA_AUDIO_NESTED_PROTOCOL] Nested leaf source is missing")},
    }
    let source: SourceInfo = source_info(doc,slot)
    if not source.audio {return result.ok(())}
    if bounds.speed != 0.0 and not source.online {
      return result.err("[GA_AUDIO_SOURCE_OFFLINE] Audible nested leaf source is offline")
    }
  }
  try audio_automation_preflight(doc,clip,bounds.speed == 0.0)
  if bounds.speed == 0.0 {return result.ok(())}
  let chain: string = try nested_audio_chain(doc,clip,bounds.speed)
  try nested_gain_preflight(doc,clip,bounds.fps)
  let gain_keys: string = try audio_gain_keys(doc,clip,clip.start,bounds.fps)
  let fade_keys: string = try audio_fade_keys(doc,clip,clip.start,editor.clip_end(clip),bounds.fps,false)
  let pan_keys: string = try audio_pan_keys(doc,clip,clip.start,bounds.fps)
  let gain: f64 = if str.len(gain_keys) == 0 {editor.effective_gain(doc,clip.id)}else{editor.track_gain(doc,clip.track)}
  if not math.is_finite(gain) or gain < 0.0 or gain > 3.4028234663852886e38 or
      clip.fade_in < 0 or clip.fade_out < 0 {
    return result.err("[GA_AUDIO_NESTED_PROTOCOL] Invalid nested gain or scalar fade")
  }
  var fields: array<string> = array.new()
  var context_source: f64 = 0.0
  var context_duration: f64 = 0.0
  var disk_bytes: f64 = cast.float(bounds.last-bounds.first)*8.0+128.0
  if clip.nested == 0 {
    let source_slot: u64 = match editor.source_slot(doc,clip.source) {
      some(slot)=>slot,none=>{return result.err("[GA_AUDIO_NESTED_PROTOCOL] Nested leaf source is missing")},
    }
    var source: SourceInfo = source_info(doc,source_slot)
    if not source_range_ok(doc,processing) {return result.err("[GA_AUDIO_NESTED_PROTOCOL] Nested leaf exceeds its source frames")}
    let source_s: f64 = cast.float(processing.source_in)/bounds.fps
    var duration_s: f64 = cast.float(processing.length)*bounds.speed/bounds.fps
    match context.extent {none=>{},some(extent)=>{duration_s=cast.float(extent.input_duration_us)/1000000.0},}
    if not option.is_some(context.extent) and source.frames > 0 and source.fps > 0.0 {
      let remaining: f64 = cast.float(source.frames)/source.fps-source_s
      if duration_s > remaining {duration_s=remaining}
    }
    if not math.is_finite(source_s) or not math.is_finite(duration_s) or
        duration_s <= 0.0 or duration_s > 21600.0 {
      return result.err("[GA_AUDIO_NESTED_CAPACITY] Nested leaf source span is invalid or exceeds six hours")
    }
    fields=[string.copy("NESTLEAF"),string.copy(instance),string.copy(parent),
      string.from_int(bounds.first),string.from_int(bounds.last),provider.wire_path(source.path),
      string.from_float(source_s),string.from_float(duration_s)]
    context_source=source_s
    context_duration=duration_s
  }else{
    if clip.source != 0 {return result.err("[GA_AUDIO_NESTED_PROTOCOL] Nested clip also references a media source")}
    match editor.sequence_slot(doc,clip.nested) {
      none=>{return result.err("[GA_AUDIO_NESTED_PROTOCOL] Nested sequence is missing")},some(_)=>{},
    }
    var next_ancestors: array<u64> = array.new()
    var at: u64 = 0
    loop {if at >= array.len(ancestors) {break}
      let sequence: u64 = array.get(ancestors,at)
      if sequence == clip.nested {return result.err("[GA_AUDIO_NESTED_CYCLE] Nested sequence has a composition cycle")}
      array.push(next_ancestors,sequence)
      at=at+1
    }
    array.push(next_ancestors,clip.nested)
    let child_fps: f64 = editor.sequence_fps(doc,clip.nested)
    if not math.is_finite(child_fps) or child_fps <= 0.0 {
      return result.err("[GA_AUDIO_NESTED_PROTOCOL] Nested sequence frame rate is invalid")
    }
    let child_length: i64 = editor.sequence_duration(doc,clip.nested)
    let child_limit: f64 = math.floor(cast.float(child_length)*48000.0/child_fps+0.5)
    let selected_first: f64 = math.floor(cast.float(processing.source_in)*48000.0/bounds.fps+0.5)
    let logical_last: f64 = math.floor((cast.float(processing.source_in)+cast.float(processing.length-1)*bounds.speed)*child_fps/bounds.fps)
    let selected_end: f64 = math.floor((cast.float(processing.source_in)+cast.float(processing.length)*bounds.speed)*48000.0/bounds.fps+0.5)
    // An empty sequence is a valid source in the SDK. Materialize its requested
    // span as silence so an enclosing filter can still operate on that sum.
    // A retained parent window also stays full when descendants are shortened;
    // zero-fill the removed child suffix BEFORE the original parent DSP/crop.
    let selected_last: f64 = if child_length == 0 or has_context {selected_end}
      else if selected_end > child_limit {child_limit}else{selected_end}
    if not math.is_finite(child_limit) or child_limit > 9007199254740991.0 or
        not math.is_finite(selected_first) or not math.is_finite(selected_last) or
        selected_first > 9007199254740991.0 or selected_last > 9007199254740991.0 or
        selected_first < 0.0 or selected_last <= selected_first or selected_last-selected_first > 1036800000.0 or
        not math.is_finite(logical_last) or (not has_context and child_length != 0 and logical_last >= cast.float(child_length)) {
      return result.err("[GA_AUDIO_NESTED_PROTOCOL] Nested source span exceeds its sequence")
    }
    let child_first: i64 = cast.sat(selected_first)
    let child_last: i64 = cast.sat(selected_last)
    at=0
    loop {if at >= editor.clip_count(doc) {break}
      let child: editor.Clip = match editor.clip_at(doc,at) {none=>{break},some(value)=>value,}
      at=at+1
      if child.owner != clip.nested or not child.enabled or not editor.clip_has_audio(child) or not editor.track_audible(doc,child.track) {continue}
      if child.nested == 0 {
        let slot: u64 = match editor.source_slot(doc,child.source) {none=>{continue},some(value)=>value,}
        let source: SourceInfo = source_info(doc,slot)
        if not source.audio {continue}
      }
      let child_begin_sample: f64 = math.floor(cast.float(child.start)*48000.0/child_fps+0.5)
      let child_end_sample: f64 = math.floor((cast.float(child.start)+cast.float(child.length))*48000.0/child_fps+0.5)
      if child_end_sample <= cast.float(child_first) or child_begin_sample >= cast.float(child_last) {continue}
      let child_bounds: NestedAudioBounds = try nested_audio_bounds(doc,child)
      if child_bounds.last <= child_first or child_bounds.first >= child_last {continue}
      let child_path: string = text.concat(instance,text.concat(if child.nested == 0 {".l"}else{".n"},string.from_int(child.id)))
      let _ = try nested_audio_define(doc,child,child_path,instance,next_ancestors,tree,false,false)
    }
    disk_bytes=disk_bytes+cast.float(child_last-child_first)*8.0+128.0
    fields=[string.copy("NESTBUS"),string.copy(instance),string.copy(parent),
      string.from_int(bounds.first),string.from_int(bounds.last),string.from_int(child_first),string.from_int(child_last)]
    context_duration=cast.float(child_last-child_first)/48000.0
  }
  array.push(fields,string.from_float(gain))
  array.push(fields,string.from_float(cast.float(clip.fade_in)/bounds.fps))
  array.push(fields,string.from_float(cast.float(clip.fade_out)/bounds.fps))
  array.push(fields,string.from_float(cast.float(clip.length)/bounds.fps))
  array.push(fields,chain)
  if str.len(gain_keys) != 0 {array.push(fields,gain_keys)}
  if str.len(fade_keys) != 0 {array.push(fields,fade_keys)}
  if str.len(pan_keys) != 0 {array.push(fields,pan_keys)}
  if has_context {
    var ctx_fields: array<string> = ["AUDIOCTX",string.from_float(context_source),string.from_float(context_duration),
      string.from_int(context.output_frames)]
    if native_eof {match context.extent {none=>{},some(extent)=>{
      array.set(ctx_fields,0,"AUDIOCTX2")
      array.push(ctx_fields,string.from_int(extent.processing_frames))
    },}}
    array.push(ctx_fields,string.from_int(context.crop_start))
    array.push(fields,text.join(ctx_fields,":"))
  }
  if direct_tail {
    if not native_eof {array.push(fields,"AUDIOTAIL")}
    let phase_source:u64=option.unwrap(editor.source_slot(doc,clip.source))
    let phase_rate:u32=struct.get(array.borrow(struct.borrow(doc,field=sources),phase_source),field=audio_rate)
    let admitted_phase:bool=audio_phase_fps(context.fps)
    if native_eof {
      var eof_fields:array<string> =["AUDIOEOF",string.from_float(bounds.speed),string.from_int(phase_rate)]
      array.push(fields,text.join(eof_fields,":"))
    }else if admitted_phase {
      var phase:array<string> =["AUDIOPHASE",string.from_int(phase_rate),
        string.from_float(context.fps),string.from_int(context.origin),string.from_int(context.length),
        string.from_int(context.source_in),string.from_int(context.offset),string.from_int(clip.length),
        string.from_int(clip.start)]
      array.push(fields,text.join(phase,":"))
    }
    disk_bytes=disk_bytes+1920024.0
  }
  nested_audio_append(tree,fields,disk_bytes)
}

fn audio_phase_fps(fps:f64)->bool effects {} {
  fps == 24.0 or fps == 30.0 or fps == 60.0 or fps == 24000.0/1001.0 or
    fps == 30000.0/1001.0 or fps == 60000.0/1001.0
}

fn direct_audio_define(doc: ref<editor.Document>,clip: editor.Clip,instance: str,
    ancestors: ref<array<u64>>,tree: ref<NestedAudioTree>,native_eof:bool) -> result<unit,string> effects {alloc} {
  let bounds: NestedAudioBounds = try nested_audio_bounds(doc,clip)
  let tail:bool=native_eof or audio_tail_owner(doc,clip)
  let leaf: string = text.concat(instance,text.concat(".l",string.from_int(clip.id)))
  try nested_audio_define(doc,clip,leaf,instance,ancestors,tree,tail,native_eof)
  var neutral: array<string> = ["NESTBUS",string.copy(instance),"-",string.from_int(bounds.first),string.from_int(bounds.last),
    string.from_int(bounds.first),string.from_int(bounds.last),"1","0","0",
    string.from_float(cast.float(bounds.last-bounds.first)/48000.0),"-"]
  if tail {array.push(neutral,"AUDIOTAIL")}
  nested_audio_append(tree,neutral,cast.float(bounds.last-bounds.first)*16.0+256.0+if tail {3840048.0}else{0.0})
}

fn audio_lines(doc: ref<editor.Document>, start: i64, finish: i64, fps: f64, streaming: bool)
    -> result<array<string>,string> effects {alloc} {
  var tree: NestedAudioTree = NestedAudioTree {lines:array.new(),nodes:0,disk_bytes:0.0,descriptor_bytes:0}
  var slices: array<string> = array.new()
  let origin: i64 = audio_sample_frame(start,fps)
  let finish_sample: i64 = audio_sample_frame(finish,fps)
  var ancestors: array<u64> = [doc.active]
  var at: u64 = 0
  loop {if at >= editor.clip_count(doc) {break}
    let clip: editor.Clip = match editor.clip_at(doc,at) {none=>{break},some(value)=>value,}
    at=at+1
    if clip.owner != doc.active or not clip.enabled or not editor.clip_has_audio(clip) or
        not editor.track_audible(doc,clip.track) {continue}
    if clip.nested == 0 and (not audio_context_disk(doc,clip) or
        (not streaming and not option.is_some(editor.audio_context(clip)) and start<=clip.start)) {continue}
    let tail:bool=audio_tail_owner(doc,clip)
    if (editor.clip_end(clip) <= start and not tail) or clip.start >= finish {continue}
    let bounds: NestedAudioBounds = try nested_audio_bounds(doc,clip)
    let tail_allowance:i64=if tail {if audio_phase_fps(bounds.fps) {240003}else{240000}}else{0}
    if bounds.last > 9007199254740991-tail_allowance {return result.err("[GA_AUDIO_CONTEXT_TAIL] Audible tail exceeds exact sample coordinates")}
    let audible_bound:i64=bounds.last+tail_allowance
    if audible_bound <= origin or bounds.first >= finish_sample {continue}
    try audio_automation_preflight(doc,clip,bounds.speed == 0.0)
    if bounds.speed == 0.0 {continue}
    if clip.nested==0 {
      let source_slot:u64=match editor.source_slot(doc,clip.source) {none=>{continue},some(slot)=>slot,}
      let source:SourceInfo=source_info(doc,source_slot)
      if not source.audio {continue}
      if not source.online {return result.err("[GA_AUDIO_SOURCE_OFFLINE] Audible clip source is offline")}
    }
    if clip.nested==0 and audio_tail_graph(doc,clip) and option.is_some(editor.audio_context(clip)) and
        not editor.audio_tail_context_supported(doc,clip) {
      return result.err("[GA_AUDIO_CONTEXT_TAIL] Retained Delay/Reverb needs admitted native source/owner phase history")
    }
    let instance: string = text.concat("n",string.from_int(clip.id))
    if clip.nested == 0 {
      let slot: u64 = match editor.source_slot(doc,clip.source) {none=>{continue},some(value)=>value,}
      let source: SourceInfo = source_info(doc,slot)
      if not source.audio {continue}
      let _ = try direct_audio_define(doc,clip,instance,ancestors,tree,false)
    }else{let _ = try nested_audio_define(doc,clip,instance,"-",ancestors,tree,false,false)}
    let begin: i64 = if bounds.first > origin {bounds.first}else{origin}
    let end: i64 = if audible_bound < finish_sample {audible_bound}else{finish_sample}
    var fields: array<string> = [string.copy(if tail {"NESTMIXTAIL"}else{"NESTMIX"}),instance,string.from_int(begin),string.from_int(end),string.from_int(begin-origin)]
    array.push(slices,text.join(fields," "))
  }
  var flat: array<string> = try flat_audio_lines(doc,start,finish,fps,streaming)
  if tree.nodes == 0 {return result.ok(flat)}
  var lines: array<string> = [string.copy("NESTBEGIN -")]
  at=0
  loop {if at >= array.len(struct.borrow(tree,field=lines)) {break}
    array.push(lines,string.copy(array.borrow(struct.borrow(tree,field=lines),at)))
    at=at+1
  }
  array.push(lines,string.copy("NESTCOMMIT"))
  at=0
  loop {if at >= array.len(flat) {break}
    array.push(lines,string.copy(array.borrow(flat,at)))
    at=at+1
  }
  at=0
  loop {if at >= array.len(slices) {break}
    array.push(lines,string.copy(array.borrow(slices,at)))
    at=at+1
  }
  // The retained app request mailbox is bounded to one MiB, including its
  // header and output path. Reject explicitly before publishing a larger tree.
  if str.len(text.join(lines,"\n")) > 960000 {
    return result.err("[GA_AUDIO_NESTED_CAPACITY] Nested audio descriptor exceeds the playback mailbox")
  }
  result.ok(lines)
}

// Direct-source clips use the same processed stereo leaf as continuous playback.
// A neutral enclosing bus exposes its exact authored sample body to NESTENV;
// no mono/downsampled source envelope or final program limiter is involved.
pub fn clip_envelope_plan(doc: ref<editor.Document>, clip: editor.Clip, buckets: u64, output: str)
    -> result<array<string>,string> effects {alloc} {
  if not editor.clip_has_audio(clip) {return result.err("[GA_AUDIO_CLIP_ENV] Clip audio stream is disabled")}
  if clip.nested != 0 {return compound_envelope_plan(doc,clip,buckets,output)}
  if clip.source == 0 or buckets == 0 or buckets > 65536 {
    return result.err("[GA_AUDIO_CLIP_ENV] Invalid processed clip envelope request")
  }
  let slot: u64 = match editor.source_slot(doc,clip.source) {some(value)=>value,
    none=>{return result.err("[GA_AUDIO_CLIP_ENV] Processed clip source is missing")},}
  let source: SourceInfo = source_info(doc,slot)
  if not source.audio {return result.err("[GA_AUDIO_CLIP_ENV] Processed clip source has no audio")}
  if not source.online {return result.err("[GA_AUDIO_CLIP_ENV] [GA_AUDIO_SOURCE_OFFLINE] Processed clip source is offline")}
  // Retain the public direct-envelope context while exposing the shared cause.
  match audio_automation_preflight(doc,clip,false) {
    ok(_)=>{},err(problem)=>{return result.err(text.concat("[GA_AUDIO_CLIP_ENV] ",problem))},
  }
  let bounds: NestedAudioBounds = try nested_audio_bounds(doc,clip)
  if bounds.speed == 0.0 {return result.err("[GA_AUDIO_CLIP_ENV] Held clip has no progressing audio")}
  var tree: NestedAudioTree = NestedAudioTree {lines:array.new(),nodes:0,disk_bytes:0.0,descriptor_bytes:0}
  var ancestors: array<u64> = [clip.owner]
  let instance: string = text.concat("n",string.from_int(clip.id))
  try direct_audio_define(doc,clip,instance,ancestors,tree,false)
  envelope_tree_lines(tree,instance,buckets,output)
}

fn envelope_tree_lines(tree: ref<NestedAudioTree>, instance: str, buckets: u64, output: str)
    -> result<array<string>,string> effects {alloc} {
  var lines: array<string> = [string.copy("NESTBEGIN -")]
  var at: u64 = 0
  loop {if at >= array.len(struct.borrow(tree,field=lines)) {break}
    array.push(lines,string.copy(array.borrow(struct.borrow(tree,field=lines),at)))
    at=at+1
  }
  array.push(lines,string.copy("NESTCOMMIT"))
  var fields: array<string> = ["NESTENV",string.copy(instance),string.from_int(buckets),provider.wire_path(output)]
  array.push(lines,text.join(fields," "))
  if str.len(text.join(lines,"\n")) > 960000 {
    return result.err("[GA_AUDIO_NESTED_CAPACITY] Processed waveform descriptor exceeds the mailbox")
  }
  result.ok(lines)
}

// Describe one complete authored compound bus, independent of program playback.
pub fn compound_envelope_plan(doc: ref<editor.Document>, clip: editor.Clip, buckets: u64, output: str)
    -> result<array<string>,string> effects {alloc} {
  if not editor.clip_has_audio(clip) or clip.nested == 0 or clip.source != 0 or buckets == 0 or buckets > 65536 {
    return result.err("[GA_AUDIO_NESTED_ENV] Invalid compound envelope request")
  }
  var tree: NestedAudioTree = NestedAudioTree {lines:array.new(),nodes:0,disk_bytes:0.0,descriptor_bytes:0}
  var ancestors: array<u64> = [clip.owner]
  let instance: string = text.concat("n",string.from_int(clip.id))
  try nested_audio_define(doc,clip,instance,"-",ancestors,tree,false,false)
  if tree.nodes == 0 {return result.err("[GA_AUDIO_NESTED_ENV] Compound rate has no output")}
  envelope_tree_lines(tree,instance,buckets,output)
}

// Absolute boundaries prevent fractional-rate chunks accumulating roundoff.
pub fn audio_sample_frame(frame: i64, fps: f64) -> i64 effects {} {
  cast.sat(math.floor(cast.float(frame) * 48000.0 / fps + 0.5))
}

// Complete accepted graph for endpoint discovery and subsequent PCM pulls.
// There is deliberately no legacy AUDIO path after this descriptor is committed.
pub type AudioSession = struct {child: option<Child>, reader: proc.LineReader, cache: string}
pub type EndpointPlan = struct {worker:string,output:string,end:endpoint.End,lines:array<string>}
pub type PreparedAudio = struct {session:AudioSession,end:endpoint.End}
pub fn endpoint_plan(doc:ref<editor.Document>,worker:str,output:str) -> result<EndpointPlan,string> effects {alloc} {
  let fps:f64=editor.sequence_fps(doc,doc.active)
  let authored:i64=audio_sample_frame(editor.duration(doc),fps)
  let frames:i64=try endpoint.frame_end(authored,fps)
  var end:endpoint.End=endpoint.End {generation:0,authored:authored,actual:0,frames:frames,fps:fps,roots:array.new()}
  var tree:NestedAudioTree=NestedAudioTree {lines:array.new(),nodes:0,disk_bytes:0.0,descriptor_bytes:0}
  var ancestors:array<u64> =[doc.active]
  var at:u64=0
  loop {if at>=editor.clip_count(doc) {break}
    let clip:editor.Clip=match editor.clip_at(doc,at) {none=>{break},some(v)=>v,}
    at=at+1
    if clip.owner!=doc.active or not clip.enabled or not editor.clip_has_audio(clip) or not editor.track_audible(doc,clip.track) {continue}
    let bounds:NestedAudioBounds=try nested_audio_bounds(doc,clip)
    try audio_automation_preflight(doc,clip,bounds.speed==0.0)
    if bounds.speed==0.0 {continue}
    if clip.nested==0 {
      let slot:u64=match editor.source_slot(doc,clip.source) {none=>{return result.err("[GA_AUDIO_SOURCE_OFFLINE] Audible source is missing")},some(v)=>v,}
      let source:SourceInfo=source_info(doc,slot)
      if not source.audio {continue}
      if not source.online {return result.err("[GA_AUDIO_SOURCE_OFFLINE] Audible source is offline")}
    }
    if clip.nested==0 and audio_tail_graph(doc,clip) and not editor.audio_tail_context_supported(doc,clip) {return result.err("[GA_AUDIO_CONTEXT_TAIL] Endpoint preparation requires supported complete static tail history")}
    let instance:string=text.concat("n",string.from_int(clip.id))
    if clip.nested==0 {let _=try direct_audio_define(doc,clip,str.view(instance),ancestors,tree,audio_native_eof_owner(doc,clip))}
    else {let _=try nested_audio_define(doc,clip,str.view(instance),"-",ancestors,tree,false,false)}
    array.push(struct.borrow(end,field=roots),endpoint.Root {id:instance,start:bounds.first,body:bounds.last,actual:bounds.last,tail:audio_native_eof_owner(doc,clip) or audio_tail_owner(doc,clip),native_eof:audio_native_eof_owner(doc,clip)})
  }
  var root_at:u64=0
  loop {if root_at>=array.len(struct.borrow(end,field=roots)) {break}
    let value:ref<endpoint.Root> =array.borrow(struct.borrow(end,field=roots),root_at)
    let body:i64=value.body
    if body>end.actual {struct.set(end,body,field=actual)}
    root_at=root_at+1
  }
  if tree.nodes>0 {struct.set(end,1,field=generation)}
  var lines:array<string> =array.new()
  if tree.nodes>0 {
    array.push(lines,"NESTBEGIN -")
    at=0
    loop {if at>=array.len(struct.borrow(tree,field=lines)) {break}
      array.push(lines,string.copy(array.borrow(struct.borrow(tree,field=lines),at)))
      at=at+1
    }
    array.push(lines,"NESTCOMMIT")
  }
  if str.len(text.join(lines,"\n"))+str.len(endpoint.encode(end))>960000 {return result.err("[GA_AUDIO_NESTED_CAPACITY] Endpoint descriptor exceeds mailbox")}
  result.ok(EndpointPlan {worker:string.copy(worker),output:string.copy(output),end:end,lines:lines})
}
fn query_endpoint(child:ref<Child>,reader:ref<proc.LineReader>,end:ref<endpoint.End>,root:str,id:u64,cancel:str) -> result<unit,string>
    effects {alloc,fs.meta,fs.read,process,time} {
  var generation:u64=end.generation
  var maximum:i64=0
  var at:u64=0
  loop {if at>=array.len(struct.borrow(end,field=roots)) {break}
    let value:ref<endpoint.Root> =array.borrow(struct.borrow(end,field=roots),at)
    let command:string=endpoint.fields(["NESTEND",string.from_int(id),string.copy(str.view(struct.borrow(value,field=id))),string.from_int(generation)])
    let reply:string=try reply_for_request(child,reader,str.view(command),root,id,cancel)
    var f:array<string> =text.split(str.view(reply)," ")
    if array.len(f)!=8 or not str.eq(str.view(array.borrow(f,0)),"DONE") or not str.eq(str.view(array.borrow(f,1)),"NESTEND") or
        not str.eq(str.view(array.borrow(f,2)),str.view(string.from_int(id))) or not str.eq(str.view(array.borrow(f,3)),str.view(value.id)) {
      return result.err("[GA_AUDIO_ENDPOINT] Worker endpoint identity differs from query")
    }
    let gen:u64=match text.parse_u64(str.view(array.borrow(f,4))) {none=>{return result.err("[GA_AUDIO_ENDPOINT] Invalid accepted generation")},some(v)=>v,}
    let start:i64=match text.parse_i64(str.view(array.borrow(f,5))) {none=>{return result.err("[GA_AUDIO_ENDPOINT] Invalid start")},some(v)=>v,}
    let body:i64=match text.parse_i64(str.view(array.borrow(f,6))) {none=>{return result.err("[GA_AUDIO_ENDPOINT] Invalid body")},some(v)=>v,}
    let actual:i64=match text.parse_i64(str.view(array.borrow(f,7))) {none=>{return result.err("[GA_AUDIO_ENDPOINT] Invalid EOF")},some(v)=>v,}
    if gen==0 or (generation!=0 and gen!=generation) or start!=value.start or body!=value.body or actual<start or
        (not value.native_eof and actual<body-if value.tail {if endpoint.phase_fps(end.fps) {2}else{0}}else{1}) or actual>body+if value.native_eof {240000}else if value.tail {if endpoint.phase_fps(end.fps) {240003}else{240000}}else{1} {return result.err("[GA_AUDIO_ENDPOINT] Worker endpoint geometry differs from accepted plan")}
    generation=gen
    struct.set(value,actual,field=actual)
    if actual>maximum and not (value.native_eof and actual==start) {maximum=actual}
    at=at+1
  }
  struct.set(end,generation,field=generation)
  struct.set(end,maximum,field=actual)
  struct.set(end,try endpoint.frame_end(if maximum>end.authored {maximum}else{end.authored},end.fps),field=frames)
  result.ok(())
}
pub fn prepare_audio_endpoint(plan:EndpointPlan own,previous:option<AudioSession> own,root:str,id:u64) -> result<PreparedAudio,string>
    effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  var owned:EndpointPlan=plan
  var session:AudioSession=match previous {some(v)=>v,none=>{
    var argv:array<string> =[string.copy(str.view(owned.worker)),"--serve"]
    let child:Child=match proc.spawn_piped_merged(argv) {err(p)=>{return result.err(text.concat("[GA_AUDIO_ENDPOINT_START] ",fs.error.message(p)))},ok(v)=>v,}
    AudioSession {child:option.some(child),reader:proc.line_reader(65536),cache:string.new()}
  },}
  if array.len(struct.borrow(owned,field=lines))>0 and str.len(struct.borrow(session,field=cache))==0 {
    let cache:string=match nested_audio_reserve(str.view(owned.output)) {err(p)=>{return result.err(nested_audio_failure(p,shutdown_audio_checked(session)))},ok(v)=>v,}
    let _=struct.replace(session,cache,field=cache)
  }
  var child:Child=option.unwrap(struct.replace(session,option.none(),field=child))
  var reader:proc.LineReader=struct.replace(session,proc.line_reader(65536),field=reader)
  var failure:string=string.new()
  var at:u64=0
  loop {if at>=array.len(struct.borrow(owned,field=lines)) {break}
    let line:string=nested_audio_runtime_line(array.borrow(struct.borrow(owned,field=lines),at),struct.borrow(session,field=cache))
    match command_for_request(child,reader,str.view(line),root,id,"") {ok(_)=>{},err(p)=>{failure=p
        break},}
    at=at+1
  }
  struct.set(struct.borrow(owned,field=end),0,field=generation)
  if str.len(failure)==0 {match query_endpoint(child,reader,struct.borrow(owned,field=end),root,id,"") {ok(_)=>{},err(p)=>{failure=p},}}
  let _=struct.replace(session,option.some(child),field=child)
  let _=struct.replace(session,reader,field=reader)
  if str.len(failure)>0 {return result.err(nested_audio_failure(failure,shutdown_audio_checked(session)))}
  result.ok(PreparedAudio {session:session,end:struct.replace(owned,endpoint.empty(),field=end)})
}
fn endpoint_mix_plan(worker:str,output:str,end:ref<endpoint.End>,start:i64,frames:u64) -> result<AudioPlan,string> effects {alloc} {
  if start<0 or start>end.actual or frames==0 or frames>1036800000 or frames>cast.wrap(end.actual-start) {
    return result.err("[GA_AUDIO_ENDPOINT_RANGE] PCM pull exceeds accepted exact EOF")
  }
  let finish:i64=start+cast.wrap(frames)
  var lines:array<string> =array.new()
  var at:u64=0
  loop {if at>=array.len(struct.borrow(end,field=roots)) {break}
    let value:ref<endpoint.Root> =array.borrow(struct.borrow(end,field=roots),at)
    let begin:i64=if value.start>start {value.start}else{start}
    let last:i64=if value.actual<finish {value.actual}else{finish}
    if begin<last {array.push(lines,endpoint.fields([if value.tail {"NESTMIXTAIL"}else{"NESTMIX"},string.copy(str.view(struct.borrow(value,field=id))),string.from_int(begin),string.from_int(last),string.from_int(begin-start)]))}
    at=at+1
  }
  result.ok(AudioPlan {worker:string.copy(worker),output:string.copy(output),duration:cast.float(frames)/48000.0,frames:frames,sounds:lines})
}

pub type AudioPlan = struct {
  worker: string, output: string, duration: f64, frames: u64, sounds: array<string>
}

// Transport and picture-only edits do not invalidate queued sound. Actual mix edits do.
pub fn audio_signature(doc: ref<editor.Document>) -> string effects {alloc} {
  let fps: f64 = editor.sequence_fps(doc, doc.active)
  let finish: i64 = editor.duration(doc)
  var lines: array<string> = match audio_lines(doc, 0, finish, fps, false) {
    ok(value) => value, err(problem) => { return problem },
  }
  array.push(lines, string.from_float(fps))
  array.push(lines, string.from_int(finish))
  text.join(lines, "\n")
}

// Resolve all document facts on the window thread. The returned plan owns its worker
// commands and can be handed to a background task without borrowing the document.
pub fn audio_plan(doc: ref<editor.Document>, worker: str, start: i64, output: str)
                  -> result<option<AudioPlan>, string> effects {alloc} {
  let finish: i64 = editor.duration(doc)
  if start >= finish { return result.ok(option.none()) }
  let fps: f64 = editor.sequence_fps(doc, doc.active)
  if fps <= 0.0 { return result.err("sequence frame rate is invalid") }
  var sounds: array<string> = try audio_lines(doc, start, finish, fps, false)
  if array.len(sounds) == 0 { return result.ok(option.none()) }
  result.ok(option.some(AudioPlan {worker: string.copy(worker), output: string.copy(output),
    duration: cast.float(finish - start) / fps, frames: cast.sat(audio_sample_frame(finish,fps)-audio_sample_frame(start,fps)), sounds: sounds}))
}

// Playback prepares bounded chunks using one continuous decoder/filter graph per clip.
pub fn audio_plan_range(doc: ref<editor.Document>, worker: str, start: i64, finish: i64, output: str)
                        -> result<AudioPlan,string> effects {alloc} {
  let fps: f64 = editor.sequence_fps(doc, doc.active)
  if not math.is_finite(fps) or fps <= 0.0 or start < 0 or finish <= start { return result.err("[GA_AUDIO_RANGE] Invalid playback range") }
  var sounds: array<string> = try audio_lines(doc, start, finish, fps, true)
  if nested_audio_requested(sounds) and str.len(text.join(sounds,"\n"))+str.len(provider.wire_path(output))+128 > 1048576 {
    return result.err("[GA_AUDIO_NESTED_CAPACITY] Nested audio request exceeds the playback mailbox")
  }
  result.ok(AudioPlan {worker: string.copy(worker), output: string.copy(output),
    duration: cast.float(finish - start) / fps, frames: cast.sat(audio_sample_frame(finish,fps)-audio_sample_frame(start,fps)), sounds: sounds})
}

pub fn monitor_fps(doc: ref<editor.Document>) -> f64 effects {} {
  match editor.source_slot(doc, doc.monitor_source) {
    none => 30.0,
    some(slot) => struct.get(array.borrow(struct.borrow(doc, field=sources), slot), field=fps),
  }
}
pub fn source_audio_range(doc: ref<editor.Document>, worker: str, start: i64, finish: i64, output: str)
                          -> result<AudioPlan,string> effects {alloc} {
  let slot: u64 = match editor.source_slot(doc, doc.monitor_source) { some(value) => value, none => { return result.err("[GA_AUDIO_SOURCE] No source selected") }, }
  let source: ref<editor.Source> = array.borrow(struct.borrow(doc, field=sources), slot)
  let source_path: string = string.copy(str.view(struct.borrow(source, field=path)))
  let frames: i64 = source.frames
  let fps: f64 = source.fps
  let has_audio: bool = source.has_audio
  // Source audition deliberately ignores Program mixer state, but its original
  // selected asset's availability must survive the fresh audition graph.
  if has_audio and not source.online {
    return result.err("[GA_AUDIO_SOURCE_OFFLINE] Selected sound source is offline")
  }
  var audition: editor.Document = editor.document(fps, 1920, 1080)
  let owner: u64 = audition.active
  let source_id: u64 = editor.add_source(audition, str.view(source_path), "source", frames, fps)
  let _ = editor.describe_source(audition, source_id, 0, 0, false, has_audio, 48000, 2)
  let track: u64 = editor.add_track(audition, owner, editor.track_audio(), "Source")
  let _ = editor.append(audition, track, source_id, 0, frames)
  audio_plan_range(audition, worker, start, finish, output)
}

// One background owner retains the pipe/reader between requests. These resource
// handles stay on that thread; seeks and actual mix edits discard the old session.
fn nested_audio_runtime_line(line: str, cache: str) -> string effects {alloc} {
  if str.eq(line,"NESTBEGIN -") {return text.concat("NESTBEGIN ",provider.wire_path(cache))}
  string.copy(line)
}
fn nested_audio_requested(lines: ref<array<string>>) -> bool effects {} {
  array.len(lines) != 0 and str.eq(array.borrow(lines,0),"NESTBEGIN -")
}
fn nested_audio_reserve(output: str) -> result<string,string> effects {alloc,fs.read,fs.write,time} {
  let parent: string = try provider.resolve_scratch(path.dirname(output))
  match files.mkdirs(parent) {ok(_)=>{},err(_)=>{return result.err("[GA_AUDIO_NESTED_CACHE] Cannot create audio cache parent")},}
  let stamp: u64 = time.monotonic_ns()
  var attempt: u64 = 0
  loop {if attempt >= 128 {break}
    let name: string = text.concat(".genesis-nested-",text.concat(string.from_int(stamp),text.concat("-",string.from_int(attempt))))
    let cache: string = path.join(parent,name)
    match files.create_dir(cache) {
      ok(_)=>{return result.ok(cache)},
      err(problem)=>{if problem.code != 3 {return result.err("[GA_AUDIO_NESTED_CACHE] Cannot reserve a private audio cache")}},
    }
    attempt=attempt+1
  }
  result.err("[GA_AUDIO_NESTED_CACHE] Cannot reserve a unique audio cache")
}
// Only the exclusively created, caller-owned flat directory reaches this
// helper. Join/terminate its worker first; never follow links or recurse.
fn nested_audio_cleanup(cache: str) -> result<unit,string> effects {alloc,fs.meta,fs.write} {
  if str.len(cache) == 0 {return result.ok(())}
  let root: fs.meta = match files.symlink_metadata(cache) {
    ok(value)=>value,err(problem)=>{if problem.code == 1 {return result.ok(())}
      return result.err("[GA_AUDIO_NESTED_CACHE] Cannot inspect owned audio cache")},
  }
  if not root.is_dir or root.is_symlink {return result.err("[GA_AUDIO_NESTED_CACHE] Owned audio cache is no longer a directory")}
  var names: array<string> = match files.list_dir(cache) {
    ok(value)=>value,err(_)=>{return result.err("[GA_AUDIO_NESTED_CACHE] Cannot list owned audio cache")},
  }
  var index: u64 = 0
  var failed: bool = false
  loop {if index >= array.len(names) {break}
    let file: string = path.join(cache,array.borrow(names,index))
    index=index+1
    match files.symlink_metadata(file) {
      err(problem)=>{if problem.code != 1 {failed=true}},
      ok(info)=>{if info.is_dir and not info.is_symlink {failed=true}else{
        match files.remove(file) {ok(_)=>{},err(_)=>{failed=true},}
      }},
    }
  }
  if failed {return result.err("[GA_AUDIO_NESTED_CACHE] Cannot remove owned audio cache files")}
  match files.remove(cache) {
    ok(_)=>result.ok(()),err(_)=>result.err("[GA_AUDIO_NESTED_CACHE] Cannot remove owned audio cache directory"),
  }
}
fn nested_audio_failure(primary: str, cleanup: result<unit,string> own) -> string effects {alloc} {
  match cleanup {
    ok(_)=>string.copy(primary),
    err(problem)=>text.concat(primary,text.concat("\n",problem)),
  }
}
fn nested_audio_stop(child: Child own, cache: str) -> result<unit,string>
    effects {alloc,fs.meta,fs.write,process,time} {
  var worker: Child = child
  var stopped: bool = match proc.terminate(worker,100) {ok(_)=>true,err(_)=>false,}
  var close_failed: bool = false
  match proc.close(worker) {ok(_)=>{stopped=true},err(_)=>{close_failed=true},}
  if not stopped {
    return result.err("[GA_AUDIO_NESTED_CACHE] Worker exit is unconfirmed; owned audio cache was retained")
  }
  let cleaned: result<unit,string> = nested_audio_cleanup(cache)
  if close_failed {return result.err(nested_audio_failure("[GA_AUDIO_NESTED_CACHE] Cannot release audio worker",cleaned))}
  cleaned
}
pub type AudioJob = struct {plan: AudioPlan, session: option<AudioSession>}
pub fn audio_job(plan: AudioPlan own, session: option<AudioSession> own) -> AudioJob effects {} {
  AudioJob {plan: plan, session: session}
}
pub fn shutdown_audio_checked(session: AudioSession own) -> result<unit,string>
    effects {alloc,fs.meta,fs.write,process,time} {
  var owned: AudioSession = session
  match struct.replace(owned,option.none(),field=child) {
    none=>nested_audio_cleanup(struct.borrow(owned,field=cache)),
    some(value)=>nested_audio_stop(value,struct.borrow(owned,field=cache)),
  }
}
pub fn shutdown_audio(session: AudioSession own) -> unit effects {alloc,fs.meta,fs.write,process,time} {
  let _ = shutdown_audio_checked(session)
  ()
}
// Run on the strip worker, never during painting. The same complete float bus
// used by audition/playback supplies stereo peaks before final device clipping.
pub fn compound_envelope(doc: ref<editor.Document>, clip: editor.Clip, buckets: u64,
    worker: str, scratch: str, root: str, id: u64) -> result<array<f64>,string>
    effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  if clip.nested == 0 {return result.err("[GA_AUDIO_NESTED_ENV] Compound envelope requires a nested clip")}
  clip_envelope(doc,clip,buckets,worker,scratch,root,id)
}
pub fn clip_envelope(doc: ref<editor.Document>, clip: editor.Clip, buckets: u64,
    worker: str, scratch: str, root: str, id: u64) -> result<array<f64>,string>
    effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  let _ = try clip_envelope_plan(doc,clip,buckets,"envelope.f32")
  let cache: string = try nested_audio_reserve(scratch)
  let output: string = path.join(cache,"envelope.f32")
  var lines: array<string> = match clip_envelope_plan(doc,clip,buckets,output) {
    ok(value)=>value,err(problem)=>{return result.err(nested_audio_failure(problem,nested_audio_cleanup(cache)))},
  }
  // Original native/destination phase and native EOF markers require the
  // accepted exact cache path; the streamed reducer deliberately rejects them.
  let descriptor: string = text.join(lines,"\n")
  let cached_phase: bool = text.contains(str.view(descriptor)," AUDIOPHASE:") or
    text.contains(str.view(descriptor)," AUDIOEOF:")
  if clip.nested == 0 and not cached_phase {
    // The public cached-bus plan remains the PCM/reference path. Waveforms alone
    // can reduce its exact direct leaf while streaming, without RF64 bodies.
    // The worker proves the identity wrapper before accepting this terminator.
    let _ = array.pop(lines)
    let _ = array.pop(lines)
    var fields: array<string> = ["NESTPEAK",text.concat("n",string.from_int(clip.id)),
      string.from_int(buckets),provider.wire_path(output)]
    array.push(lines,text.join(fields," "))
  }
  var argv: array<string> = [string.copy(worker),"--serve"]
  var child: Child = match proc.spawn_piped_merged(argv) {
    ok(value)=>value,err(problem)=>{return result.err(nested_audio_failure(
      text.concat("[GA_AUDIO_NESTED_ENV] Cannot start envelope worker: ",fs.error.message(problem)),nested_audio_cleanup(cache)))},
  }
  var reader: proc.LineReader = proc.line_reader(65536)
  var session: AudioSession = AudioSession {child:option.none(),reader:proc.line_reader(65536),cache:string.copy(cache)}
  var at: u64 = 0
  var failure: string = string.new()
  loop {if at >= array.len(lines) {break}
    let line: string = nested_audio_runtime_line(array.borrow(lines,at),cache)
    match command_for_request(child,reader,line,root,id,"") {
      ok(_)=>{},err(problem)=>{failure=problem
        break},
    }
    at=at+1
  }
  let _ = struct.replace(session,option.some(child),field=child)
  if str.len(failure) != 0 {return result.err(nested_audio_failure(failure,shutdown_audio_checked(session)))}
  var decoded: result<array<f64>,string> = read_compound_envelope(output,buckets)
  match decoded {
    err(problem)=>result.err(nested_audio_failure(problem,shutdown_audio_checked(session))),
    ok(peaks)=>{try shutdown_audio_checked(session)
      result.ok(peaks)},
  }
}
fn read_compound_envelope(output: str, buckets: u64) -> result<array<f64>,string> effects {alloc,fs.read} {
  let raw: bytes = match files.read_bytes(output) {ok(value)=>value,err(_)=>{
    return result.err("[GA_AUDIO_NESTED_ENV] Cannot read processed compound peaks")},}
  let data: view<byte> = bytes.view(raw)
  if view.len(data) != buckets*4 {return result.err("[GA_AUDIO_NESTED_ENV] Processed peak count differs from request")}
  var peaks: array<f64> = array.new()
  var at: u64 = 0
  loop {if at >= buckets {break}
    let offset: u64 = at*4
    let b0: u8 = cast.bits(view.get(data,offset))
    let b1: u8 = cast.bits(view.get(data,offset+1))
    let b2: u8 = cast.bits(view.get(data,offset+2))
    let b3: u8 = cast.bits(view.get(data,offset+3))
    let bits: u32 = cast.wrap(b0)+cast.wrap(b1)*256+cast.wrap(b2)*65536+cast.wrap(b3)*16777216
    let value: f32 = cast.bits(bits)
    let peak: f64 = cast.float(value)
    if not math.is_finite(peak) or peak < 0.0 {return result.err("[GA_AUDIO_NESTED_ENV] Invalid processed compound peak")}
    array.push(peaks,peak)
    at=at+1
  }
  result.ok(peaks)
}
pub fn execute_playback_audio(job: ref<AudioJob>, root: str, id: u64) -> result<AudioSession,string>
    effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  let plan: ref<AudioPlan> = struct.borrow(job,field=plan)
  var session: AudioSession = match ref.swap(struct.borrow(job,field=session),option.none()) {
    some(value) => value,
    none => {
      var argv: array<string> = [string.copy(str.view(plan.worker)),string.copy("--serve")]
      let child: Child = match proc.spawn_piped_merged(argv) {
        ok(value) => value,
        err(problem) => { return result.err(text.concat("[GA_AUDIO_STREAM_START] ",fs.error.message(problem))) },
      }
      AudioSession {child: option.some(child), reader: proc.line_reader(65536), cache:string.new()}
    },
  }
  match files.mkdirs(str.view(path.dirname(str.view(plan.output)))) {
    err(problem) => {return result.err(nested_audio_failure("[GA_AUDIO_STREAM_PATH] Audio scratch directory could not be created",shutdown_audio_checked(session)))},
    ok(_) => {},
  }
  if nested_audio_requested(struct.borrow(plan,field=sounds)) and str.len(struct.borrow(session,field=cache)) == 0 {
    let cache: string = match nested_audio_reserve(struct.borrow(plan,field=output)) {
      ok(value)=>value,err(problem)=>{return result.err(nested_audio_failure(problem,shutdown_audio_checked(session)))},
    }
    let _ = struct.replace(session,cache,field=cache)
  }
  let target: string = provider.wire_path(str.view(plan.output))
  var opener: string = text.concat("PLAYWAVE ",str.view(target))
  string.append(opener," ")
  string.append(opener,str.view(string.from_int(plan.frames)))
  let closer: string = text.concat("WAVECLOSE ",str.view(target))
  var child: Child = option.unwrap(struct.replace(session,option.none(),field=child))
  var reader: proc.LineReader = struct.replace(session,proc.line_reader(65536),field=reader)
  var answer: result<unit,string> = audio_session_for_request(child,reader,str.view(opener),struct.borrow(plan,field=sounds),str.view(closer),root,id,struct.borrow(session,field=cache))
  match audio_request_current(root,id) {
    ok(current)=>{if not current {answer=result.err("[GA_AUDIO_STREAM_CANCELLED] Playback request was superseded")}},
    err(problem)=>{answer=result.err(problem)},
  }
  let _ = struct.replace(session,option.some(child),field=child)
  let _ = struct.replace(session,reader,field=reader)
  match answer {
    err(problem) => {
      let combined: string = nested_audio_failure(problem,shutdown_audio_checked(session))
      let _ = files.remove(str.view(plan.output))
      return result.err(if str.starts_with(combined,"[GA_") {combined}
        else {text.concat("[GA_AUDIO_STREAM_REPLY] ",combined)}) },
    ok(_) => result.ok(session),
  }
}

pub fn endpoint_pull_plan(worker:str,output:str,end:ref<endpoint.End>,start:i64,frames:u64) -> result<AudioPlan,string> effects {alloc} {
  if frames>1440000 {return result.err("[GA_AUDIO_ENDPOINT_RANGE] Playback pull exceeds 30 seconds")}
  endpoint_mix_plan(worker,output,end,start,frames)
}

// Assemble the plan as a WAV through the worker. The document is no longer involved.
pub fn execute_audio_plan(plan: ref<AudioPlan>) -> result<bool, string>
                          effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  match files.mkdirs(str.view(path.dirname(str.view(plan.output)))) {
    err(problem) => { return result.err("audio scratch directory could not be created") },
    ok(_) => { },
  }
  let cache: string = if nested_audio_requested(struct.borrow(plan,field=sounds)) {
    try nested_audio_reserve(struct.borrow(plan,field=output))
  }else{string.new()}
  var argv: array<string> = [string.copy(str.view(plan.worker)), string.copy("--serve")]
  var child: Child = match proc.spawn_piped_merged(argv) {
    err(problem) => {return result.err(nested_audio_failure(text.concat("start audio worker: ",fs.error.message(problem)),nested_audio_cleanup(cache)))},
    ok(value) => value,
  }
  let target: string = provider.wire_path(str.view(plan.output))
  var reader: proc.LineReader = proc.line_reader(65536)
  var opener: string = text.concat("WAVE ", str.view(target))
  string.append(opener, " ")
  string.append(opener, str.view(string.from_float(plan.duration)))
  var closer: string = text.concat("WAVECLOSE ", str.view(target))
  match audio_session(child, reader, str.view(opener), plan.sounds, str.view(closer),cache) {
    err(problem) => {
      return result.err(nested_audio_failure(problem,nested_audio_stop(child,cache)))
    },
    ok(_) => { },
  }
  let _ = proc.close_stdin(child)
  let finished: process.status = match proc.wait(child, proc.deadline_in(30000)) {
    err(problem) => {
      return result.err(nested_audio_failure("audio worker did not finish",nested_audio_stop(child,cache)))
    },
    ok(value) => value,
  }
  match proc.close(child) {
    ok(_)=>{},err(problem)=>{return result.err(nested_audio_failure(text.concat("close audio worker: ",fs.error.message(problem)),nested_audio_cleanup(cache)))},
  }
  if not proc.success(finished) {
    return result.err(nested_audio_failure("audio worker exited unsuccessfully",nested_audio_cleanup(cache)))
  }
  try nested_audio_cleanup(cache)
  result.ok(true)
}

pub fn prepare_audio(doc: ref<editor.Document>, worker: str, start: i64, output: str)
                     -> result<bool, string> effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  let prepared: option<AudioPlan> = try audio_plan(doc, worker, start, output)
  match prepared {
    none => result.ok(false),
    some(value) => {
      var plan: AudioPlan = value
      execute_audio_plan(plan)
    },
  }
}

fn render_into(doc: ref<editor.Document>, worker: str, output: str, fonts: ref<array<string>>,
               cancel: str, progress: str, profile: u32, sounds: ref<array<string>>)
               -> result<unit, string> effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  try export_current(cancel)
  let sequence_slot: u64 = match editor.sequence_slot(doc, doc.active) {
    none => { return result.err("[GA_EXPORT_SEQUENCE] the project has no active sequence") },
    some(slot) => slot,
  }
  let sequence: ref<editor.Sequence> = array.borrow(struct.borrow(doc, field=sequences), sequence_slot)
  let fps: f64 = sequence.fps
  let width: u32 = sequence.width
  let height: u32 = sequence.height
  if not (fps > 0.0) { return result.err("[GA_EXPORT_FPS] the sequence frame rate is invalid") }
  let cache: string = if nested_audio_requested(sounds) {try nested_audio_reserve(output)}else{string.new()}
  var argv: array<string> = [string.copy(worker), string.copy("--serve"), string.copy("--size"),
    string.from_int(width), string.from_int(height)]
  // Preview resampling may differ at edges. Every export retains the master
  // reference transform, including SDR sequences smaller than their source.
  array.push(argv, string.copy("--reference-color"))
  if profile == 4 or profile == 5 { array.push(argv, string.copy("--hdr")) }
  // Merge diagnostics into the bounded line reader so a chatty encoder cannot fill an
  // unread stderr pipe and stall a long export.
  var child: Child = match proc.spawn_piped_merged(argv) {
    err(problem) => {return result.err(nested_audio_failure(text.concat("[GA_EXPORT_START] start worker: ",fs.error.message(problem)),nested_audio_cleanup(cache)))},
    ok(value) => value,
  }
  var reader: proc.LineReader = proc.line_reader(65536)
  // This thread owns the child until the session finishes. Stop it before the
  // caller removes partial output, including failures inside a borrowed helper.
  match render_session(doc,child,reader,output,fonts,cancel,progress,profile,width,height,fps,sounds,cache) {
    err(problem)=>{
      result.err(nested_audio_failure(problem,nested_audio_stop(child,cache)))
    },
    ok(_)=>{
      match proc.close(child) {
        err(problem)=>result.err(nested_audio_failure(text.concat("[GA_EXPORT_EXIT] close worker: ",fs.error.message(problem)),nested_audio_cleanup(cache))),
        ok(status)=>{if proc.success(status) {nested_audio_cleanup(cache)}else{
          result.err(nested_audio_failure("[GA_EXPORT_EXIT] worker exited unsuccessfully",nested_audio_cleanup(cache)))}},
      }
    },
  }
}

fn render_session(doc: ref<editor.Document>, child: ref<Child>, reader: ref<proc.LineReader>,
                  output: str, fonts: ref<array<string>>, cancel: str, progress: str,
                  profile: u32, width: u32, height: u32, fps: f64,
                  sounds: ref<array<string>>, cache_directory: str)
                  -> result<unit,string> effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  var accepted:EndpointPlan=try endpoint_plan(doc,"",output)
  var warm:u64=0
  loop {if warm>=array.len(struct.borrow(accepted,field=lines)) {break}
    let line:string=nested_audio_runtime_line(array.borrow(struct.borrow(accepted,field=lines),warm),cache_directory)
    let _=try export_command(child,reader,str.view(line),cancel)
    warm=warm+1
  }
  struct.set(struct.borrow(accepted,field=end),0,field=generation)
  let _=try query_endpoint(child,reader,struct.borrow(accepted,field=end),"",1,cancel)
  let range:editor.Transport=editor.export_range_until(doc,accepted.end.frames)
  if range.mark_out<=range.mark_in {return result.err("[GA_EXPORT_RANGE] the export range is empty")}
  let audio_start:i64=audio_sample_frame(range.mark_in,fps)
  let marked_end:i64=audio_sample_frame(range.mark_out,fps)
  let audio_end:i64=if accepted.end.actual<marked_end {accepted.end.actual}else{marked_end}
  let exact_frames:u64=if audio_end>audio_start {cast.wrap(audio_end-audio_start)}else{0}
  if exact_frames>1036800000 {return result.err("[GA_AUDIO_CAPACITY] Exact export audio exceeds six hours")}
  var mix:array<string> =array.new()
  if exact_frames>0 {
    var plan:AudioPlan=try endpoint_mix_plan("",output,struct.borrow(accepted,field=end),audio_start,exact_frames)
    mix=struct.replace(plan,array.new(),field=sounds)
  }
  let fractional: bool = math.abs(fps - 30000.0 / 1001.0) < 0.001 or
    math.abs(fps - 24000.0 / 1001.0) < 0.001 or math.abs(fps - 60000.0 / 1001.0) < 0.001
  let fps_denominator: i64 = if fractional { 1001 } else { 1000000 }
  let fps_number: i64 = cast.sat(math.round(fps * cast.float(fps_denominator)))
  var open_fields: array<string> = [
    string.copy("OPEN"), provider.wire_path(output),
    string.from_int(width), string.from_int(height),
    string.from_int(fps_number), string.from_int(fps_denominator),
    string.copy(if profile == 2 or profile == 3 or profile == 5 { "0" } else { "1" }), string.copy(if profile == 2 or profile == 3 or profile == 5 { "0" } else { "18" }),
    string.copy(if profile == 3 or profile == 5 { "ffv1" } else if profile == 2 { "prores_ks" } else if profile == 1 or profile == 4 { "libx265" } else { "libx264" }),
    string.from_float(cast.float(range.mark_out - range.mark_in) / fps),
    string.copy("0"), string.copy(if profile == 2 or profile == 3 or profile == 5 { "-" } else { "medium" }), string.copy("320000"),
    string.copy(if profile == 2 or profile == 3 or profile == 5 { "pcm_s24le" } else { "aac" }),
    string.from_float(fps)
  ]
  array.push(open_fields,text.concat("AUDIOFRAMES:",string.from_int(exact_frames)))
  try export_command(child, reader, str.view(text.join(open_fields, " ")), cancel)
  var cache: RenderCache = render_cache(fonts)
  struct.set(cache, width, field=width)
  struct.set(cache, height, field=height)
  var frame: i64 = range.mark_in
  var reported: i64 = -1
  loop {
    if frame >= range.mark_out { break }
    try export_current(cancel)
    let percent: i64 = (frame - range.mark_in) * 100 / (range.mark_out - range.mark_in)
    if percent != reported and str.len(progress) != 0 {
      let _ = files.write_text(progress, str.view(string.from_int(percent)))
      reported = percent
    }
    var planned: array<string> = try frame_plan(doc, frame, "ENC", "", output, cache)
    // Export owns one physical worker. Frame-relative positive epochs are
    // unique within that session and do not add clock effects to frame_plan.
    var lines: array<string> = try picture_memory.lower(planned,cast.sat(frame-range.mark_in+1))
    var step: u64 = 0
    loop {
      if step >= array.len(lines) { break }
      try export_command(child, reader, str.view(array.borrow(lines, step)), cancel)
      step = step + 1
    }
    frame = frame + 1
  }
  var at: u64 = 0
  loop {
    if at >= array.len(mix) { break }
    let line: string = nested_audio_runtime_line(array.borrow(mix,at),cache_directory)
    try export_command(child, reader, line, cancel)
    at = at + 1
  }
  try export_command(child, reader, "CLOSE", cancel)
  match proc.close_stdin(child) {
    ok(_) => { },
    err(problem) => { return result.err(text.concat("[GA_EXPORT_EXIT] close worker input: ", fs.error.message(problem))) },
  }
  let deadline: u64 = proc.deadline_in(30000)
  loop {
    try export_current(cancel)
    let step: u64 = proc.deadline_in(50)
    match proc.wait(child,if step < deadline {step}else{deadline}) {
      ok(status)=>{
        if not proc.success(status) {return result.err("[GA_EXPORT_EXIT] worker exited unsuccessfully")}
        break
      },
      err(problem)=>{
        if problem.code == 10 and time.monotonic_ns() < deadline {continue}
        return result.err(text.concat("[GA_EXPORT_EXIT] wait for worker: ",fs.error.message(problem)))
      },
    }
  }
  result.ok(())
}

pub type ExportPublication = struct {cleanup_pending: bool, detail: string}

// This directory was created exclusively by this export. Only known plan
// sidecars and its exclusively created partial may be removed, after joining
// the worker. An unexpected entry leaves the reservation intact for diagnosis.
fn export_release(reservation: str, partial: str, owns_partial: bool)
    -> result<unit,string> effects {alloc,fs.meta,fs.read,fs.write} {
  let info: fs.meta = match files.symlink_metadata(reservation) {
    ok(value)=>value,err(_)=>{return result.err("[GA_EXPORT_CLEANUP] Cannot inspect owned export reservation")},
  }
  if not info.is_dir or info.is_symlink {
    return result.err("[GA_EXPORT_CLEANUP] Owned export reservation is no longer a directory")
  }
  if owns_partial {
    cleanup_plan(partial)
    match files.remove(partial) {
      ok(_)=>{},err(problem)=>{if problem.code != 1 {
        return result.err("[GA_EXPORT_CLEANUP] Cannot remove owned export partial")
      }},
    }
  }
  match files.remove(reservation) {
    ok(_)=>result.ok(()),err(_)=>result.err("[GA_EXPORT_CLEANUP] Cannot remove owned export reservation"),
  }
}
fn export_failure(primary: str, cleanup: result<unit,string> own) -> string effects {alloc} {
  match cleanup {ok(_)=>string.copy(primary),err(problem)=>text.concat(primary,text.concat("\n",problem)),}
}
fn export_publish_helper() -> result<string,string> effects {alloc,fs.meta,fs.read} {
  let executable: string = match system.executable_path() {
    ok(value)=>value,err(_)=>{return result.err("[GA_EXPORT_HELPER] Cannot locate file publication helper")},
  }
  let helper: string = path.join(path.dirname(executable),
    if text.ends_with(executable,".exe") {"air-file-publish.exe"}else{"air-file-publish"})
  match files.exists(helper) {
    ok(found)=>{if not found {return result.err("[GA_EXPORT_HELPER] File publication helper is missing")}},
    err(_)=>{return result.err("[GA_EXPORT_HELPER] Cannot inspect file publication helper")},
  }
  result.ok(helper)
}

pub fn render_profile_detailed(doc: ref<editor.Document>, worker: str, output: str, fonts: ref<array<string>>,
              cancel: str, progress: str, profile: u32)
              -> result<ExportPublication, string> effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  if not text.ends_with(output, if profile == 3 or profile == 5 { ".mkv" } else if profile == 2 { ".mov" } else { ".mp4" }) {
    return result.err("[GA_EXPORT_EXTENSION] Use .mkv for the 16-bit lossless master, .mov for ProRes or .mp4 for H.264/HEVC")
  }
  match files.exists(output) {
    ok(found) => { if found { return result.err("[GA_EXPORT_EXISTS] the output file already exists") } },
    err(problem) => { return result.err(text.concat("[GA_EXPORT_PATH] ",fs.error.message(problem))) },
  }
  let legacy_partial: string = text.concat(output, if profile == 3 or profile == 5 { ".genesis-air-part.mkv" } else if profile == 2 { ".genesis-air-part.mov" } else { ".genesis-air-part.mp4" })
  match files.exists(str.view(legacy_partial)) {
    ok(found) => { if found { return result.err("[GA_EXPORT_PARTIAL_EXISTS] an unfinished output already exists") } },
    err(problem) => { return result.err(text.concat("[GA_EXPORT_PATH] ",fs.error.message(problem))) },
  }
  // Pure audio rejection owns neither output nor sidecars. Resolve before
  // entering the executor's cleanup boundary; preserve foreign sidecars.
  // Actual end is resolved on the retained worker before OPEN. A mark beginning
  // after authored video may still select a real audio tail.
  try export_current(cancel)
  match editor.sequence_slot(doc,doc.active) {
    none=>{return result.err("[GA_EXPORT_SEQUENCE] the project has no active sequence")},some(_)=>{},
  }
  let fps: f64 = editor.sequence_fps(doc,doc.active)
  if not (fps > 0.0) {return result.err("[GA_EXPORT_FPS] the sequence frame rate is invalid")}
  var accepted_plan:EndpointPlan=try endpoint_plan(doc,worker,output)
  var sounds:array<string> =struct.replace(accepted_plan,array.new(),field=lines)
  let helper: string = try export_publish_helper()
  let reservation: string = text.concat(output,".genesis-air-owner")
  // mkdir without recursive semantics is atomic on POSIX and Windows. A
  // competitor owns nothing and must not inspect/remove its owner's partial.
  match files.create_dir(reservation) {
    ok(_)=>{},err(problem)=>{return result.err(if problem.code == 3 {
      "[GA_EXPORT_BUSY] Another export owns this target (or its reservation requires cleanup)"
    }else{text.concat("[GA_EXPORT_PATH] Cannot reserve export target: ",fs.error.message(problem))})},
  }
  let partial: string = path.join(reservation,
    if profile == 3 or profile == 5 {"export.mkv"}else if profile == 2 {"export.mov"}else{"export.mp4"})
  // Claim the partial before the worker can truncate it. Never remove a path
  // whose exclusive creation failed, even within the reserved directory.
  match files.write_new_text(partial,"") {
    ok(_)=>{},err(problem)=>{return result.err(export_failure(
      text.concat("[GA_EXPORT_PARTIAL] Cannot claim private partial: ",fs.error.message(problem)),
      export_release(reservation,partial,false)))},
  }
  match render_into(doc, worker, str.view(partial), fonts, cancel, progress, profile,sounds) {
    err(problem) => {
      result.err(export_failure(problem,export_release(reservation,partial,true)))
    },
    ok(_) => {
      match export_current(cancel) {
        err(problem)=>{
          return result.err(export_failure(problem,export_release(reservation,partial,true)))
        },
        ok(_)=>{},
      }
      match file_publish.publish_new(partial,output,helper) {
        ok(_) => {
          match export_release(reservation,partial,true) {
            ok(_)=>result.ok(ExportPublication {cleanup_pending:false,detail:string.new()}),
            err(problem)=>{
              let detail: string = text.concat("[GA_EXPORT_PUBLISHED_CLEANUP] Output was published successfully; ",problem)
              let _ = files.write_new_text(path.join(reservation,"cleanup.error"),detail)
              result.ok(ExportPublication {cleanup_pending:true,detail:detail})
            },
          }
        },
        err(problem) => {
          let detail: string = match problem {
            Conflict=>string.copy("[GA_EXPORT_EXISTS] The output appeared during rendering; it was preserved"),
            MissingHelper=>string.copy("[GA_EXPORT_HELPER] File publication helper could not be started"),
            Source=>string.copy("[GA_EXPORT_PUBLISH] Private output is not a complete regular file"),
            Failed=>string.copy("[GA_EXPORT_PUBLISH] Atomic no-replace publication failed"),
          }
          result.err(export_failure(detail,export_release(reservation,partial,true)))
        },
      }
    },
  }
}

// Compatibility for existing synchronous component callers. Detailed native
// UI/CLI callers retain the committed-success warning instead of retrying it.
pub fn render_profile(doc: ref<editor.Document>, worker: str, output: str, fonts: ref<array<string>>,
    cancel: str, progress: str, profile: u32) -> result<unit,string>
    effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  let _ = try render_profile_detailed(doc,worker,output,fonts,cancel,progress,profile)
  result.ok(())
}

pub fn render(doc: ref<editor.Document>, worker: str, output: str, fonts: ref<array<string>>,
              cancel: str, progress: str) -> result<unit, string>
              effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  render_profile(doc, worker, output, fonts, cancel, progress, 0)
}

// Clear an earlier run's signals so a stale cancel cannot stop a new export.
pub fn clear_export_signals(cancel: str, progress: str) -> unit effects {fs.write} {
  let _ = files.remove(cancel)
  let _ = files.remove(progress)
  ()
}

pub fn request_export_cancel(cancel: str) -> unit effects {fs.write} {
  let _ = files.write_text(cancel, "cancelled\n")
  ()
}

// Whole percent written by a running export, when it has reported one.
pub fn export_progress(progress: str) -> option<u64> effects {alloc, fs.read} {
  match files.read_text(progress) {
    err(_) => option.none(),
    ok(content) => {
      let trimmed: string = text.trim(str.view(content))
      match text.parse_u64(str.view(trimmed)) {
        none => option.none(),
        some(value) => if value > 100 { option.none() } else { option.some(value) },
      }
    },
  }
}

// Everything an export task needs, owned, so the editor keeps running and can change the
// project while its snapshot renders.
pub type ExportJob = struct {
  profile: u32,
  document: editor.Document,
  worker: string,
  output: string,
  fonts: array<string>,
  cancel: string,
  progress: string
}

pub fn export_job(doc: ref<editor.Document>, worker: str, output: str,
                  fonts: ref<array<string>>, cancel: str, progress: str, profile: u32)
                  -> ExportJob effects {alloc} {
  var faces: array<string> = array.new()
  var i: u64 = 0
  loop {
    if i >= array.len(fonts) { break }
    array.push(faces, string.copy(str.view(array.borrow(fonts, i))))
    i = i + 1
  }
  ExportJob {profile: profile, document: editor.copy_document(doc), worker: string.copy(worker),
    output: string.copy(output), fonts: faces, cancel: string.copy(cancel),
    progress: string.copy(progress)}
}

pub fn export_output(job: ref<ExportJob>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(job, field=output)))
}

pub fn run_export_detailed(job: ExportJob own) -> result<ExportPublication, string>
                  effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  var owned: ExportJob = job
  let worker: string = string.copy(str.view(struct.borrow(owned, field=worker)))
  let output: string = string.copy(str.view(struct.borrow(owned, field=output)))
  let cancel: string = string.copy(str.view(struct.borrow(owned, field=cancel)))
  let progress: string = string.copy(str.view(struct.borrow(owned, field=progress)))
  var fonts: array<string> = struct.replace(owned, array.new(), field=fonts)
  let profile: u32 = owned.profile
  let outcome: result<ExportPublication, string> = render_profile_detailed(struct.borrow(owned, field=document),
    str.view(worker), str.view(output), fonts, str.view(cancel), str.view(progress), profile)
  clear_export_signals(str.view(cancel), str.view(progress))
  outcome
}

pub fn run_export(job: ExportJob own) -> result<unit,string>
    effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  let _ = try run_export_detailed(job)
  result.ok(())
}

pub fn execute_endpoint_pull(session:AudioSession own,end:ref<endpoint.End>,worker:str,output:str,start:i64,frames:u64,root:str,id:u64)
    -> result<AudioSession,string> effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  var retained:AudioSession=session
  var copy:endpoint.End=match endpoint.decode(str.view(endpoint.encode(end))) {ok(v)=>v,err(p)=>{return result.err(nested_audio_failure(p,shutdown_audio_checked(retained)))},}
  var child:Child=option.unwrap(struct.replace(retained,option.none(),field=child))
  var reader:proc.LineReader=struct.replace(retained,proc.line_reader(65536),field=reader)
  let checked:result<unit,string> =query_endpoint(child,reader,copy,root,id,"")
  let _=struct.replace(retained,option.some(child),field=child)
  let _=struct.replace(retained,reader,field=reader)
  match checked {err(p)=>{return result.err(nested_audio_failure(p,shutdown_audio_checked(retained)))},ok(_)=>{},}
  if not str.eq(endpoint.encode(copy),endpoint.encode(end)) {return result.err(nested_audio_failure("[GA_AUDIO_ENDPOINT_STALE] Accepted EOF changed before pull",shutdown_audio_checked(retained)))}
  let plan:AudioPlan=match endpoint_pull_plan(worker,output,end,start,frames) {ok(v)=>v,err(p)=>{return result.err(nested_audio_failure(p,shutdown_audio_checked(retained)))},}
  var job:AudioJob=audio_job(plan,option.some(retained))
  execute_playback_audio(job,root,id)
}
