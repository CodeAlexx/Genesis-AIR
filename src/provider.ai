// The media-provider seam.
//
// Genesis AIR never learns where a frame came from. Everything the application asks of a
// media engine goes through this one module: probe a source, make a thumbnail, fetch a
// source frame, fetch a composited program frame, read an audio envelope.
//
// Two providers are implemented. `fake` is deterministic and needs no external program, so
// the whole application is testable without FFmpeg, OpenCL or a GPU. `gcompose` drives the
// existing Genesis worker (CodeAlexx/Genesis-, `gcompose/`) as a SEPARATE PROCESS, which is
// the isolation the original measured it needs: NVIDIA OpenCL initialization and a UI GL/GLX
// stack crashed intermittently when combined, so the compositor stays out of this process.
//
// The donor's 103-field frame wire is assembled in timeline_media.ai; this module owns
// transport, source probes, frame reads and waveform reads.
module genesis.provider

import std.draw as draw
import std.files as files
import std.image as image
import std.math as math
import std.path as path
import std.process as proc
import std.text as text
import "ffmpeg.ai" as ffmpeg
import "diagnostics.ai" as diagnostics

pub fn kind_fake() -> u32 effects {} { 0 }
pub fn kind_gcompose() -> u32 effects {} { 1 }
pub fn kind_ffmpeg() -> u32 effects {} { 2 }
pub type CachedFrame = struct { source: string, frame: i64, width: u32, height: u32, filename: string }
pub type CachedProbe = struct { source: string, info: ffmpeg.Info }
pub type CachedEnvelope = struct { source: string, buckets: u64, peaks: array<f64> }

pub type Provider = struct {
  kind: u32,
  worker: string,
  ffprobe: string,
  probes: array<CachedProbe>,
  frames: array<CachedFrame>,
  envelopes: array<CachedEnvelope>,
  scratch: string,
  calls: u64,
  failures: u64,
  last_error: string,
  available: bool,
  // One `gcompose --serve` kept open across requests, started on first use.
  session: option<Child>,
  reader: proc.LineReader,
  canvas_width: u32, canvas_height: u32,
  starts: u64
}

// What a probe learned about one source. `frames` 0 means the length is genuinely unknown,
// which is the state `std.editor`'s source-bounds contract keys on.
pub type Probe = struct {
  ok: bool,
  frames: i64,
  width: u32,
  height: u32,
  fps: f64,
  has_video: bool,
  has_audio: bool,
  detail: string
}

pub type Frame = struct { ok: bool, width: u32, height: u32, pixels: draw.Surface, detail: string }

pub fn fake(scratch: str) -> Provider effects {alloc} {
  Provider {kind: kind_fake(), worker: string.new(), scratch: string.copy(scratch),
    ffprobe: string.new(), probes: array.new(), frames: array.new(), envelopes: array.new(),
    calls: 0, failures: 0, last_error: string.new(), available: true,
    session: option.none(), reader: proc.line_reader(65536), starts: 0, canvas_width: 1280, canvas_height: 720}
}

// A gcompose provider. `worker` is the binary; the provider is `available` only when it is
// actually there, so an application can fall back rather than fail at the first request.
pub fn gcompose(worker: str, scratch: str) -> Provider effects {alloc, fs.meta} {
  let there: bool = match files.exists(worker) { ok(found) => found, err(problem) => false, }
  let sibling: string = path.join(str.view(path.dirname(worker)), "ffprobe.exe")
  let probe: string = if match files.exists(str.view(sibling)) { ok(value) => value, err(_) => false, } { sibling } else { string.copy("ffprobe") }
  Provider {kind: kind_gcompose(), worker: string.copy(worker), scratch: string.copy(scratch),
    ffprobe: probe, probes: array.new(), frames: array.new(), envelopes: array.new(),
    calls: 0, failures: 0, last_error: string.new(), available: there,
    session: option.none(), reader: proc.line_reader(65536), starts: 0, canvas_width: 1280, canvas_height: 720}
}

// FFmpeg is a real-media backend, selected only when gcompose is absent.
pub fn native(ffmpeg_path: str, probe_path: str, scratch: str) -> Provider effects {alloc} {
  Provider {kind: kind_ffmpeg(), worker: string.copy(ffmpeg_path), ffprobe: string.copy(probe_path),
    scratch: string.copy(scratch), probes: array.new(), frames: array.new(), envelopes: array.new(),
    calls: 0, failures: 0, last_error: string.new(), available: true,
    session: option.none(), reader: proc.line_reader(65536), starts: 0, canvas_width: 1280, canvas_height: 720}
}
pub fn invalidate(state: ref<Provider>) -> unit effects {alloc} {
  let _ = ref.swap(struct.borrow(state, field=probes), array.new())
  let _ = ref.swap(struct.borrow(state, field=frames), array.new())
  let _ = ref.swap(struct.borrow(state, field=envelopes), array.new())
  ()
}
pub fn available(state: ref<Provider>) -> bool effects {} { state.available }
pub fn worker_path(state: ref<Provider>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(state, field=worker)))
}
pub fn preview_path(state: ref<Provider>) -> string effects {alloc} {
  path.join(str.view(struct.borrow(state, field=scratch)), "program.rgba")
}
pub fn audition_path(state: ref<Provider>) -> string effects {alloc} {
  path.join(str.view(struct.borrow(state, field=scratch)), "audition.wav")
}
// An export in progress watches the first file and reports whole percent to the second, so
// the window, a script, or a test can follow or cancel it.
pub fn export_cancel_path(state: ref<Provider>) -> string effects {alloc} {
  path.join(str.view(struct.borrow(state, field=scratch)), "export.cancel")
}
pub fn export_progress_path(state: ref<Provider>) -> string effects {alloc} {
  path.join(str.view(struct.borrow(state, field=scratch)), "export.progress")
}
pub fn calls(state: ref<Provider>) -> u64 effects {} { state.calls }
pub fn worker_starts(state: ref<Provider>) -> u64 effects {} { state.starts }
pub fn failures(state: ref<Provider>) -> u64 effects {} { state.failures }
pub fn last_error(state: ref<Provider>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(state, field=last_error)))
}
pub fn describe(state: ref<Provider>) -> string effects {alloc} {
  if state.kind == kind_fake() { return string.copy("fake") }
  if state.kind == kind_ffmpeg() { return string.copy("FFmpeg") }
  var out: string = string.copy("gcompose")
  if not state.available { string.append(out, " (worker missing)") }
  else if state.starts > 1 {
    string.append(out, " (restarted ")
    let restarts: i64 = cast.sat(state.starts - 1)
    string.append(out, str.view(string.from_int(restarts)))
    string.append(out, ")")
  }
  out
}

pub fn note_failure(state: ref<Provider>, detail: str) -> unit effects {alloc, fs.write, time} {
  struct.set(state, state.failures + 1, field=failures)
  var message: string = if str.starts_with(detail, "[GA_") { string.copy(detail) }
    else { text.concat("[GA_PROVIDER] ", detail) }
  let _ = ref.swap(struct.borrow(state, field=last_error), string.copy(message))
  var parts: array<string> = text.split(message, "]")
  let code: str = array.borrow(parts, 0)
  diagnostics.record(str.view(struct.borrow(state, field=scratch)),
    str.slice(code, 1, str.len(code)), message, "media")
  ()
}

fn scratch_file(state: ref<Provider>, name: str) -> string effects {alloc} {
  path.join(str.view(struct.borrow(state, field=scratch)), name)
}

// gcompose's positional wire decodes these escapes in the reverse order. Encode '%' first
// so a literal sequence such as "%20" still names the same file after the round trip.
pub fn wire_path(value: str) -> string effects {alloc} {
  var encoded: string = text.replace(value, "%", "%25")
  encoded = text.replace(str.view(encoded), " ", "%20")
  encoded = text.replace(str.view(encoded), "\t", "%09")
  encoded = text.replace(str.view(encoded), "\n", "%0A")
  text.replace(str.view(encoded), "\r", "%0D")
}

// Stop the shared worker. The next request starts a new one, which also drops the worker's
// decoder and LUT caches, so Reload and Relink see files that changed on disk.
pub fn restart(state: ref<Provider>) -> unit effects {alloc, process, time} {
  invalidate(state)
  match ref.swap(struct.borrow(state, field=session), option.none()) {
    none => { },
    some(child) => { var owned: Child = child
      let _ = proc.terminate(owned, 200)
      let _ = proc.close(owned) },
  }
  ()
}

pub fn set_canvas(state: ref<Provider>, width: u32, height: u32) -> unit effects {alloc, process, time} {
  if state.canvas_width != width or state.canvas_height != height {
    restart(state)
    struct.set(state, width, field=canvas_width)
    struct.set(state, height, field=canvas_height)
  }
  ()
}

pub fn shutdown(state: ref<Provider>) -> unit effects {alloc, process, time} { restart(state) }

fn start_worker(state: ref<Provider>) -> option<Child> effects {alloc, process, time} {
  var argv: array<string> = [string.copy(str.view(struct.borrow(state, field=worker))),
    string.copy("--serve"), string.copy("--size"), string.from_int(state.canvas_width),
    string.from_int(state.canvas_height)]
  // Diagnostics share the reply pipe so an unread stderr can never fill and stall the worker.
  match proc.spawn_piped_merged(argv) {
    err(problem) => option.none(),
    ok(child) => {
      proc.reset_lines(struct.borrow(state, field=reader))
      struct.set(state, state.starts + 1, field=starts)
      option.some(child)
    },
  }
}

// What one request/reply exchange produced: 0 DONE (text is the reply), 1 ERR from a live
// worker, 2 the pipe broke (text says how).
type Exchange = struct {kind: u32, text: string}

fn exchange(child: ref<Child>, reader: ref<proc.LineReader>, command: str) -> Exchange
            effects {alloc, process, time} {
  let deadline: u64 = proc.deadline_in(30000)
  var request: string = string.copy(command)
  string.append(request, "\n")
  match proc.write_all_stdin(child, str.bytes(str.view(request)), deadline) {
    err(problem) => { return Exchange {kind: 2, text: string.copy("the worker stopped accepting requests")} },
    ok(_) => { },
  }
  var count: u64 = 0
  loop {
    if count >= 256 { return Exchange {kind: 2, text: string.copy("the worker emitted too many diagnostic lines")} }
    match proc.read_line(child, reader, deadline) {
      err(problem) => { return Exchange {kind: 2, text: string.copy("the worker's reply could not be read")} },
      ok(value) => {
        match value {
          none => { return Exchange {kind: 2, text: string.copy("the worker exited")} },
          some(line) => {
            if str.starts_with(str.view(line), "DONE") {
              let reply: string = if str.len(str.view(line)) <= 5 { string.new() }
                else { string.copy(str.slice(str.view(line), 5, str.len(str.view(line)))) }
              return Exchange {kind: 0, text: reply}
            }
            if str.starts_with(str.view(line), "ERR") { return Exchange {kind: 1, text: text.concat("[GA_WORKER_REQUEST] ", line)} }
          },
        }
      },
    }
    count = count + 1
  }
  Exchange {kind: 2, text: string.copy("the worker gave no reply")}
}

// Run one command line through the shared worker and return its reply text, or none.
fn ask(state: ref<Provider>, command: str, tag: str) -> option<string> effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  struct.set(state, state.calls + 1, field=calls)
  if state.kind == kind_ffmpeg() {
    note_failure(state, "[GA_COMPOSITOR_MISSING] Full timeline rendering requires the bundled gcompose worker")
    return option.none()
  }
  if not state.available {
    note_failure(state, "[GA_WORKER_MISSING] The gcompose worker is not present")
    return option.none()
  }
  match files.mkdirs(str.view(struct.borrow(state, field=scratch))) {
    ok(made) => { }, err(problem) => { },
  }
  var attempt: u64 = 0
  loop {
    var child: Child = match ref.swap(struct.borrow(state, field=session), option.none()) {
      some(live) => live,
      none => match start_worker(state) {
        some(fresh) => fresh,
        none => { note_failure(state, "the worker could not be started")
          return option.none() },
      },
    }
    var outcome: Exchange = exchange(child, struct.borrow(state, field=reader), command)
    if outcome.kind == 2 {
      let _ = proc.terminate(child, 200)
      let _ = proc.close(child)
      if attempt == 0 {
        attempt = 1
        continue
      }
      note_failure(state, str.view(outcome.text))
      return option.none()
    }
    let _ = ref.swap(struct.borrow(state, field=session), option.some(child))
    if outcome.kind == 1 {
      note_failure(state, str.view(struct.borrow(outcome, field=text)))
      return option.none()
    }
    return option.some(ref.swap(struct.borrow(outcome, field=text), string.new()))
  }
  option.none()
}
fn native_info(state: ref<Provider>, source: str) -> option<ffmpeg.Info> effects {alloc, fs.write, process, time} {
  var index: u64 = 0
  loop {
    if index >= array.len(struct.borrow(state, field=probes)) { break }
    let cached: ref<CachedProbe> = array.borrow(struct.borrow(state, field=probes), index)
    if str.view(struct.borrow(cached, field=source)) == source { return option.some(cached.info) }
    index = index + 1
  }
  match ffmpeg.probe(str.view(struct.borrow(state, field=ffprobe)), source) {
    err(problem) => { note_failure(state, problem)
      option.none() },
    ok(info) => { array.push(struct.borrow(state, field=probes), CachedProbe {source: string.copy(source), info: info})
      option.some(info) },
  }
}

fn parse_int(text_value: str) -> option<i64> effects {} {
  if str.len(text_value) == 0 { return option.none() }
  var value: i64 = 0
  let raw: view<byte> = str.bytes(text_value)
  var index: u64 = 0
  loop {
    if index >= view.len(raw) { break }
    let octet: u8 = cast.bits(view.get(raw, index))
    let code: u64 = cast.wrap(octet)
    if code < 48 or code > 57 { return option.none() }
    value = value * 10 + cast.sat(code - 48)
    index = index + 1
  }
  option.some(value)
}

type VideoInfo = struct {width: u32, height: u32, fps: f64, known: bool}

fn ffprobe_text(state: ref<Provider>, source: str, stream: str, fields: str,
                tag: str) -> option<string> effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  match files.mkdirs(str.view(struct.borrow(state, field=scratch))) {
    ok(_) => { },
    err(problem) => { return option.none() },
  }
  let log: string = scratch_file(state, tag)
  var argv: array<string> = ["ffprobe", "-v", "error", "-select_streams",
    string.copy(stream), "-show_entries", string.copy(fields),
    "-of", "default=noprint_wrappers=1", string.copy(source)]
  match proc.run(argv, ".", str.view(log), false) {
    err(problem) => option.none(),
    ok(status) => {
      if not proc.success(status) { return option.none() }
      match files.read_text(str.view(log)) {
        err(problem) => option.none(),
        ok(value) => option.some(value),
      }
    },
  }
}

fn video_info(state: ref<Provider>, source: str) -> VideoInfo
              effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  var info: VideoInfo = VideoInfo {width: 0, height: 0, fps: 30.0, known: false}
  let answer: string = match ffprobe_text(state, source, "v:0",
      "stream=width,height,avg_frame_rate", "video-info.txt") {
    none => { return info },
    some(value) => value,
  }
  var lines: array<string> = text.split(str.view(answer), "\n")
  var at: u64 = 0
  loop {
    if at >= array.len(lines) { break }
    let line: str = str.view(array.borrow(lines, at))
    if str.starts_with(line, "width=") {
      match parse_int(str.slice(line, 6, str.len(line))) {
        some(value) => { let width: u32 = cast.sat(value)
          struct.set(info, width, field=width) }, none => { },
      }
    }
    if str.starts_with(line, "height=") {
      match parse_int(str.slice(line, 7, str.len(line))) {
        some(value) => { let height: u32 = cast.sat(value)
          struct.set(info, height, field=height) }, none => { },
      }
    }
    if str.starts_with(line, "avg_frame_rate=") {
      var ratio: array<string> = text.split(str.slice(line, 15, str.len(line)), "/")
      if array.len(ratio) == 2 {
        let top: f64 = match text.parse_f64(str.view(array.borrow(ratio, 0))) {
          some(value) => value, none => 0.0,
        }
        let bottom: f64 = match text.parse_f64(str.view(array.borrow(ratio, 1))) {
          some(value) => value, none => 0.0,
        }
        if top > 0.0 and bottom > 0.0 { struct.set(info, top / bottom, field=fps) }
      }
    }
    at = at + 1
  }
  let measured: bool = info.width > 0 and info.height > 0
  struct.set(info, measured, field=known)
  info
}

fn has_audio(state: ref<Provider>, source: str) -> bool
             effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  match ffprobe_text(state, source, "a:0", "stream=codec_type", "audio-info.txt") {
    none => true,
    some(value) => text.contains(str.view(value), "codec_type=audio"),
  }
}

fn audio_frames(state: ref<Provider>, source: str) -> i64
                effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  let answer: string = match ffprobe_text(state, source, "a:0",
      "format=duration", "duration-info.txt") {
    none => { return 0 },
    some(value) => value,
  }
  var lines: array<string> = text.split(str.view(answer), "\n")
  var at: u64 = 0
  loop {
    if at >= array.len(lines) { break }
    let line: str = str.view(array.borrow(lines, at))
    if str.starts_with(line, "duration=") {
      match text.parse_f64(str.slice(line, 9, str.len(line))) {
        some(seconds) => {
          if seconds > 0.0 and seconds < 86400.0 {
            let frames: i64 = cast.sat(math.ceil(seconds * 30.0))
            return frames
          }
        },
        none => { },
      }
    }
    at = at + 1
  }
  0
}

// ---------------------------------------------------------------------------
// The provider surface
//
// Source and program media operations. Everything above the seam uses these.

// Deterministic fake dimensions and length, derived from the path so a fixture is stable.
fn fake_seed(source: str) -> u64 effects {} {
  var seed: u64 = 2166136261
  let raw: view<byte> = str.bytes(source)
  var index: u64 = 0
  loop {
    if index >= view.len(raw) { break }
    let octet: u8 = cast.bits(view.get(raw, index))
    seed = mul.wrap(xor(seed, cast.wrap(octet)), 16777619)
    index = index + 1
  }
  seed
}

// PROBE: gcompose supplies the frame count; ffprobe supplies dimensions, native frame rate
// and audio presence. A provider that does not know the frame count says 0.
pub fn probe(state: ref<Provider>, source: str) -> Probe effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  if state.kind == kind_fake() {
    struct.set(state, state.calls + 1, field=calls)
    let seed: u64 = fake_seed(source)
    let frames: i64 = cast.sat(120 + seed % 480)
    let audio_only: bool = str.starts_with(source, "audio:")
    return Probe {ok: true, frames: frames, width: if audio_only { 0 } else { 1920 },
      height: if audio_only { 0 } else { 1080 }, fps: 30.0, has_video: not audio_only,
      has_audio: true, detail: string.copy("fake source")}
  }
  let metadata: ffmpeg.Info = match native_info(state, source) {
    none => { return Probe {ok: false, frames: 0, width: 0, height: 0, fps: 30.0,
      has_video: false, has_audio: false, detail: last_error(state)} },
    some(value) => value,
  }
  let info: VideoInfo = VideoInfo {width: metadata.width, height: metadata.height,
    fps: metadata.fps, known: metadata.video}
  let audio: bool = metadata.audio
  if state.kind == kind_ffmpeg() or not metadata.video {
    return Probe {ok: true, frames: metadata.frames, width: metadata.width, height: metadata.height,
      fps: metadata.fps, has_video: metadata.video, has_audio: metadata.audio,
      detail: string.copy("native FFprobe metadata")}
  }
  var command: string = string.copy("NFRAMES ")
  string.append(command, str.view(wire_path(source)))
  match ask(state, str.view(command), "probe.txt") {
    none => Probe {ok: false, frames: 0, width: 0, height: 0, fps: 30.0, has_video: false,
      has_audio: false, detail: last_error(state)},
    some(reply) => {
      match parse_int(str.view(text.trim(str.view(reply)))) {
        none => Probe {ok: false, frames: 0, width: 0, height: 0, fps: 30.0,
          has_video: false, has_audio: false, detail: string.copy("unreadable frame count")},
        some(frames) => {
          Probe {ok: true, frames: frames, width: info.width, height: info.height,
            fps: info.fps, has_video: true, has_audio: audio,
            detail: string.copy("gcompose NFRAMES + ffprobe metadata")}
        },
      }
    },
  }
}

// A deterministic image the fake provider returns, so a test can assert real pixels.
fn fake_image(source: str, frame: i64, width: u32, height: u32) -> draw.Surface effects {alloc} {
  match draw.surface(width, height) {
    none => draw.empty_surface(),
    some(target) => {
      var canvas: draw.Canvas = draw.canvas(target)
      let seed: u64 = fake_seed(source)
      let base: u64 = seed % 128
      let positive: i64 = if frame < 0 { 0 } else { frame }
      let shift: u64 = cast.wrap(positive) % 128
      let red: u8 = cast.sat((base + shift) % 256)
      let green: u8 = cast.sat((base * 3 + shift) % 200)
      let blue: u8 = cast.sat((base * 7 + shift * 2) % 200)
      draw.clear(canvas, draw.rgb(red, green, blue))
      // A corner marker, so a test can tell one frame from another by pixel.
      var y: u32 = 0
      loop {
        if y >= 8 or y >= height { break }
        var x: u32 = 0
        loop {
          if x >= 8 or x >= width { break }
          let mark_r: u8 = cast.sat(shift * 2 % 256)
          let mark_b: u8 = cast.sat(base * 2 % 256)
          let px: i64 = cast.wrap(x)
          let py: i64 = cast.wrap(y)
          draw.device_pixel(canvas, px, py, draw.rgb(mark_r, 255, mark_b))
          x = x + 1
        }
        y = y + 1
      }
      draw.finish(canvas)
    },
  }
}

// Read a raw RGBA file the worker wrote and turn it into a surface.
fn read_rgba(file: str, width: u32, height: u32) -> option<draw.Surface> effects {alloc, fs.read} {
  let raw: bytes = match files.read_bytes(file) { ok(value) => value, err(problem) => { return option.none() }, }
  let data: view<byte> = bytes.view(raw)
  let wanted: u64 = cast.wrap(width) * cast.wrap(height) * 4
  if view.len(data) < wanted { return option.none() }
  match draw.surface(width, height) {
    none => option.none(),
    some(target) => {
      var canvas: draw.Canvas = draw.canvas(target)
      var y: u32 = 0
      loop {
        if y >= height { break }
        var x: u32 = 0
        loop {
          if x >= width { break }
          let at: u64 = (cast.wrap(y) * cast.wrap(width) + cast.wrap(x)) * 4
          let r: u8 = cast.bits(view.get(data, at))
          let g: u8 = cast.bits(view.get(data, at + 1))
          let b: u8 = cast.bits(view.get(data, at + 2))
          let px: i64 = cast.wrap(x)
          let py: i64 = cast.wrap(y)
          draw.device_pixel(canvas, px, py, draw.rgb(r, g, b))
          x = x + 1
        }
        y = y + 1
      }
      option.some(draw.finish(canvas))
    },
  }
}

// PREVIEW always writes the worker's fixed 1280x856 canvas. Sample that canvas into the
// monitor's requested size; interpreting the first width*height bytes as a small image
// would instead show only a cropped corner of the composition.
fn read_program(file: str, width: u32, height: u32, canvas_width: u32, canvas_height: u32) -> option<draw.Surface> effects {alloc, fs.read} {
  let raw: bytes = match files.read_bytes(file) { ok(value) => value, err(problem) => { return option.none() }, }
  let data: view<byte> = bytes.view(raw)
  if view.len(data) != cast.wrap(canvas_width) * cast.wrap(canvas_height) * 4 or width == 0 or height == 0 { return option.none() }
  match draw.surface(width, height) {
    none => option.none(),
    some(target) => {
      var canvas: draw.Canvas = draw.canvas(target)
      draw.clear(canvas, draw.rgb(0, 0, 0))
      let fit: f64 = math.min(cast.float(width) / cast.float(canvas_width), cast.float(height) / cast.float(canvas_height))
      let fit_width: u32 = cast.sat(math.max(1.0, math.round(cast.float(canvas_width) * fit)))
      let fit_height: u32 = cast.sat(math.max(1.0, math.round(cast.float(canvas_height) * fit)))
      let left: i64 = cast.wrap((width - fit_width) / 2)
      let top: i64 = cast.wrap((height - fit_height) / 2)
      var y: u32 = 0
      loop {
        if y >= fit_height { break }
        let sy: u64 = cast.wrap(y) * cast.wrap(canvas_height) / cast.wrap(fit_height)
        var x: u32 = 0
        loop {
          if x >= fit_width { break }
          let sx: u64 = cast.wrap(x) * cast.wrap(canvas_width) / cast.wrap(fit_width)
          let at: u64 = (sy * cast.wrap(canvas_width) + sx) * 4
          let red: u8 = cast.bits(view.get(data, at))
          let green: u8 = cast.bits(view.get(data, at + 1))
          let blue: u8 = cast.bits(view.get(data, at + 2))
          draw.device_pixel(canvas, cast.wrap(x) + left, cast.wrap(y) + top, draw.rgb(red, green, blue))
          x = x + 1
        }
        y = y + 1
      }
      option.some(draw.finish(canvas))
    },
  }
}

pub fn program_command(state: ref<Provider>, line: str, width: u32, height: u32) -> Frame
                       effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  let output: string = preview_path(state)
  match ask(state, line, "program.txt") {
    none => Frame {ok: false, width: 0, height: 0, pixels: draw.empty_surface(),
      detail: last_error(state)},
    some(reply) => {
      match read_program(str.view(output), width, height, state.canvas_width, state.canvas_height) {
        none => Frame {ok: false, width: 0, height: 0, pixels: draw.empty_surface(),
          detail: string.copy("the worker's program frame could not be read")},
        some(pixels) => Frame {ok: true, width: width, height: height, pixels: pixels,
          detail: string.copy("gcompose PREVIEW")},
      }
    },
  }
}

pub fn program_plan(state: ref<Provider>, lines: ref<array<string>>, width: u32,
                    height: u32, canvas_width: u32, canvas_height: u32) -> Frame effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  set_canvas(state, canvas_width, canvas_height)
  if array.len(lines) == 0 {
    return Frame {ok: false, width: 0, height: 0, pixels: draw.empty_surface(),
      detail: string.copy("empty preview plan")}
  }
  var at: u64 = 0
  loop {
    if at + 1 >= array.len(lines) { break }
    match ask(state, str.view(array.borrow(lines, at)), "program-step.txt") {
      none => {
        return Frame {ok: false, width: 0, height: 0, pixels: draw.empty_surface(),
          detail: last_error(state)}
      },
      some(reply) => { },
    }
    at = at + 1
  }
  program_command(state, str.view(array.borrow(lines, at)), width, height)
}

fn thumb_command(source: str, frame: i64, width: u32, height: u32, out: str) -> string effects {alloc} {
  var command: string = string.copy("THUMB ")
  string.append(command, str.view(wire_path(source)))
  string.append(command, " ")
  string.append(command, str.view(string.from_int(frame)))
  string.append(command, " ")
  let w: i64 = cast.wrap(width)
  let h: i64 = cast.wrap(height)
  string.append(command, str.view(string.from_int(w)))
  string.append(command, " ")
  string.append(command, str.view(string.from_int(h)))
  string.append(command, " ")
  string.append(command, str.view(wire_path(out)))
  command
}

// THUMBNAIL / SOURCE FRAME. One decode of one source at one frame; the media pool and the
// source monitor both use it, which is why there is one operation rather than two.
pub fn source_frame(state: ref<Provider>, source: str, frame: i64, width: u32,
                    height: u32) -> Frame effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  if state.kind == kind_fake() {
    struct.set(state, state.calls + 1, field=calls)
    return Frame {ok: true, width: width, height: height,
      pixels: fake_image(source, frame, width, height), detail: string.copy("fake frame")}
  }
  if state.kind == kind_ffmpeg() { return native_frame(state, source, frame, width, height) }
  if array.len(struct.borrow(state, field=frames)) > 0 {
    let held: ref<CachedFrame> = array.borrow(struct.borrow(state, field=frames), 0)
    if str.view(struct.borrow(held, field=source)) == source and held.frame == frame and held.width == width and held.height == height {
      match read_rgba(str.view(struct.borrow(held, field=filename)), width, height) {
        none => {}, some(surface) => { return Frame {ok: true, width: width, height: height, pixels: surface, detail: string.copy("cached source monitor")} },
      }
    }
  }
  var out: string = scratch_file(state, "frame.rgba")
  let command: string = thumb_command(source, frame, width, height, str.view(out))
  match ask(state, str.view(command), "frame.txt") {
    none => Frame {ok: false, width: 0, height: 0, pixels: draw.empty_surface(),
      detail: last_error(state)},
    some(reply) => {
      match read_rgba(str.view(out), width, height) {
        none => { note_failure(state, "[GA_FRAME_READ] The worker frame could not be read")
          failed_frame(state) },
        some(surface) => {
          var cache: array<CachedFrame> = array.new()
          array.push(cache, CachedFrame {source: string.copy(source), frame: frame, width: width, height: height, filename: string.copy(str.view(out))})
          let _ = struct.replace(state, cache, field=frames)
          Frame {ok: true, width: width, height: height, pixels: surface, detail: string.copy("gcompose THUMB")}
        },
      }
    },
  }
}

fn failed_frame(state: ref<Provider>) -> Frame effects {alloc} {
  Frame {ok: false, width: 0, height: 0, pixels: draw.empty_surface(), detail: last_error(state)}
}
fn native_frame(state: ref<Provider>, source: str, at: i64, width: u32, height: u32)
    -> Frame effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  struct.set(state, state.calls + 1, field=calls)
  let info: ffmpeg.Info = match native_info(state, source) {
    none => { return failed_frame(state) }, some(value) => value,
  }
  // Audio sources have no video monitor; the waveform is their visual representation.
  if not info.video { return Frame {ok: true, width: 0, height: 0,
    pixels: draw.empty_surface(), detail: string.copy("audio source")} }
  var index: u64 = 0
  loop {
    if index >= array.len(struct.borrow(state, field=frames)) { break }
    let cached: ref<CachedFrame> = array.borrow(struct.borrow(state, field=frames), index)
    if str.view(struct.borrow(cached, field=source)) == source and cached.frame == at
      and cached.width == width and cached.height == height {
      match read_rgba(str.view(struct.borrow(cached, field=filename)), width, height) {
        some(surface) => { return Frame {ok: true, width: width, height: height,
          pixels: surface, detail: string.copy("cached frame")} }, none => {},
      }
    }
    index = index + 1
  }
  let _ = files.mkdirs(str.view(struct.borrow(state, field=scratch)))
  let held: u64 = array.len(struct.borrow(state, field=frames))
  let slot: u64 = if held < 2 { held } else { state.calls % 2 }
  let out: string = scratch_file(state, text.concat(text.concat("preview-", string.from_int(slot)), ".rgba"))
  match ffmpeg.frame(str.view(struct.borrow(state, field=worker)), source, at, info.fps, width, height, out) {
    err(problem) => { note_failure(state, problem)
      return failed_frame(state) }, ok(_) => {},
  }
  let entry: CachedFrame = CachedFrame {source: string.copy(source), frame: at, width: width,
    height: height, filename: string.copy(out)}
  if array.len(struct.borrow(state, field=frames)) < 2 { array.push(struct.borrow(state, field=frames), entry) }
  else { array.set(struct.borrow(state, field=frames), slot, entry) }
  match read_rgba(out, width, height) {
    some(surface) => Frame {ok: true, width: width, height: height, pixels: surface, detail: string.copy("FFmpeg frame")},
    none => { note_failure(state, "[GA_FRAME_READ] FFmpeg returned no complete frame")
      failed_frame(state) },
  }
}

pub fn thumbnail(state: ref<Provider>, source: str, width: u32, height: u32) -> Frame effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  source_frame(state, source, 0, width, height)
}

// PROGRAM FRAME: the composited timeline at one frame. The application passes the sources
// visible at that frame; a provider that cannot composite returns the topmost one, which is
// honest and keeps the monitor useful rather than blank.
pub fn program_frame(state: ref<Provider>, sources: ref<array<string>>, frame: i64, width: u32,
                     height: u32) -> Frame effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  if array.len(sources) == 0 {
    return Frame {ok: true, width: width, height: height,
      pixels: match draw.surface(width, height) {
        none => draw.empty_surface(),
        some(target) => { var canvas: draw.Canvas = draw.canvas(target)
          draw.clear(canvas, draw.rgb(10, 11, 14))
          draw.finish(canvas) },
      }, detail: string.copy("no clip under the playhead")}
  }
  let top: u64 = array.len(sources) - 1
  source_frame(state, str.view(array.borrow(sources, top)), frame, width, height)
}

// ENVELOPE: peak magnitudes for a waveform lane. The fake provider synthesises a stable
// shape; gcompose exposes `ENV`, which this asks for and reads back as text.
pub fn envelope(state: ref<Provider>, source: str, buckets: u64) -> array<f64> effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  var out: array<f64> = array.new()
  if buckets == 0 { return out }
  if state.kind == kind_fake() {
    struct.set(state, state.calls + 1, field=calls)
    let seed: u64 = fake_seed(source)
    var index: u64 = 0
    loop {
      if index >= buckets { break }
      let mixed: u64 = (seed + index * 2654435761) % 1000
      array.push(out, 0.15 + 0.8 * cast.float(mixed) / 1000.0)
      index = index + 1
    }
    return out
  }
  if state.kind != kind_fake() {
    struct.set(state, state.calls + 1, field=calls)
    var index: u64 = 0
    loop {
      if index >= array.len(struct.borrow(state, field=envelopes)) { break }
      let cached: ref<CachedEnvelope> = array.borrow(struct.borrow(state, field=envelopes), index)
      if str.view(struct.borrow(cached, field=source)) == source and cached.buckets == buckets {
        var copy: array<f64> = array.new()
        var peak: u64 = 0
        loop { if peak >= array.len(struct.borrow(cached, field=peaks)) { break }
          array.push(copy, array.get(struct.borrow(cached, field=peaks), peak))
          peak = peak + 1 }
        return copy
      }
      index = index + 1
    }
    let info: ffmpeg.Info = match native_info(state, source) {
      none => { return out }, some(value) => value,
    }
    if not info.audio { return out }
    let _ = files.mkdirs(str.view(struct.borrow(state, field=scratch)))
    let binary: string = if state.kind == kind_ffmpeg() { string.copy(str.view(struct.borrow(state, field=worker))) }
      else { let sibling: string = path.join(str.view(path.dirname(str.view(struct.borrow(state, field=worker)))), "ffmpeg.exe")
        if match files.exists(str.view(sibling)) { ok(value) => value, err(_) => false, } { sibling } else { string.copy("ffmpeg") } }
    match ffmpeg.envelope(binary, source,
      scratch_file(state, "waveform.pcm"), buckets) {
      err(problem) => { note_failure(state, problem) },
      ok(peaks) => {
        var cached: array<f64> = peaks
        var at: u64 = 0
        loop { if at >= array.len(cached) { break }
          array.push(out, array.get(cached, at))
          at = at + 1 }
        array.push(struct.borrow(state, field=envelopes), CachedEnvelope {
          source: string.copy(source), buckets: buckets, peaks: cached})
      },
    }
    return out
  }
  var command: string = string.copy("ENV ")
  string.append(command, str.view(wire_path(source)))
  string.append(command, " ")
  let count: i64 = cast.sat(buckets)
  string.append(command, str.view(string.from_int(count)))
  var envelope_file: string = scratch_file(state, "envelope.f32")
  string.append(command, " ")
  string.append(command, str.view(wire_path(str.view(envelope_file))))
  match ask(state, str.view(command), "env.txt") {
    none => out,
    some(reply) => {
      let raw: bytes = match files.read_bytes(str.view(envelope_file)) {
        ok(value) => value,
        err(problem) => { note_failure(state, "the worker's envelope could not be read")
          return out },
      }
      let data: view<byte> = bytes.view(raw)
      if view.len(data) != buckets * 4 {
        note_failure(state, "the worker's envelope has the wrong length")
        return out
      }
      var index: u64 = 0
      loop {
        if index >= buckets { break }
        let at: u64 = index * 4
        let b0: u8 = cast.bits(view.get(data, at))
        let b1: u8 = cast.bits(view.get(data, at + 1))
        let b2: u8 = cast.bits(view.get(data, at + 2))
        let b3: u8 = cast.bits(view.get(data, at + 3))
        let bits: u32 = cast.wrap(b0) + cast.wrap(b1) * 256 +
          cast.wrap(b2) * 65536 + cast.wrap(b3) * 16777216
        let peak: f32 = cast.bits(bits)
        array.push(out, cast.float(peak))
        index = index + 1
      }
      out
    },
  }
}

// Move the image out of a Frame. A surface is owned, so a caller that wants the pixels takes
// the whole reply rather than borrowing a field out of it.
pub fn take_pixels(value: Frame own) -> draw.Surface effects {alloc} {
  var held: Frame = value
  ref.swap(struct.borrow(held, field=pixels), draw.empty_surface())
}
pub fn frame_ok(value: ref<Frame>) -> bool effects {} { value.ok }
pub fn frame_detail(value: ref<Frame>) -> string effects {alloc} {
  string.copy(str.view(struct.borrow(value, field=detail)))
}
