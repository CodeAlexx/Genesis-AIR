// A latest-request mailbox isolates the persistent worker and its process handle on one thread.
// Requests/results publish by atomic rename; two image slots prevent partial frame reads.
module genesis.preview
import "chrome.ai" as chrome
import std.draw as draw
import std.editor as editor
import std.editor_io as editor_io
import std.editor_view as editor_view
import std.files as files
import std.math as math
import std.path as path
import std.tasks as tasks
import std.text as text
import std.channel as channel
import "preview_link.ai" as link
import "app.ai" as app
import "provider.ai" as provider
import "timeline_media.ai" as timeline_media

fn program_signature(document: ref<editor.Document>) -> string effects {alloc} {
  var copy: editor.Document = editor.copy_document(document)
  struct.set(copy, 0, field=monitor_source)
  let _ = struct.replace(copy, editor.Transport {playing: false, frame: 0, mark_in: -1,
    mark_out: -1, rate: 1.0, looping: false}, field=monitor)
  match editor_io.encode(copy) {ok(value) => value, err(_) => string.new(),}
}

pub type Images = struct {pictures: array<draw.Surface>, source_ns: u64, plan_ns: u64, program_ns: u64,
  source_key: string, source_held: bool, source_frame: i64, program_frame: i64}
pub fn images(state: ref<app.App>, width: u32, height: u32) -> array<draw.Surface>
    effects {alloc,fs.meta,fs.read,fs.write,process,net,time} {
  var reply: Images = images_measured(state,width,height,false)
  struct.replace(reply,array.new(),field=pictures)
}
// Viewport strip requests ignore transient transport and selection changes.
// Their own decoder can finish while monitor playback advances independently.
pub fn strips_signature(document: ref<editor.Document>) -> string effects {alloc} {
  var copy: editor.Document = editor.copy_document(document)
  struct.set(copy,0,field=monitor_source)
  struct.set(copy,editor.transport(),field=monitor)
  struct.set(copy,editor.transport(),field=program)
  let _ = editor.clear_selection(copy)
  match editor_io.encode(copy) {ok(value)=>value,err(_)=>string.new(),}
}
pub fn images_measured(state: ref<app.App>, width: u32, height: u32, profile: bool) -> Images effects {alloc, fs.meta, fs.read, fs.write, process, net, time} {
  images_with_source(state,width,height,profile,"")
}
fn images_with_source(state: ref<app.App>, width: u32, height: u32, profile: bool, previous_source: str)
    -> Images effects {alloc,fs.meta,fs.read,fs.write,process,net,time} {
  var out: array<draw.Surface> = array.new()
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  let monitor_source: u64 = document.monitor_source
  let monitor_frame: i64 = struct.get(struct.borrow(document, field=monitor), field=frame)
  let program_frame: i64 = editor.playhead(document)
  var source_path: string = string.new()
  if monitor_source != 0 {
    match editor.source_slot(document, monitor_source) {
      some(slot) => {
        let source: ref<editor.Source> = array.borrow(struct.borrow(document, field=sources), slot)
        if source.has_video {
          source_path = string.copy(str.view(struct.borrow(source, field=path)))
        }
      },
      none => { },
    }
  }
  // Which sources are under the playhead, bottom lane first.
  var visible: array<string> = array.new()
  var index: u64 = 0
  loop {
    if index >= editor.clip_count(document) { break }
    match editor.clip_at(document, index) {
      none => { },
      some(value) => {
        if value.enabled and value.start <= program_frame and editor.clip_end(value) > program_frame {
          match editor.source_slot(document, value.source) {
            some(slot) => { array.push(visible, string.copy(str.view(struct.borrow(
              array.borrow(struct.borrow(document, field=sources), slot), field=path)))) },
            none => { },
          }
        }
      },
    }
    index = index + 1
  }
  let source_begin: u64 = if profile {time.monotonic_ns()}else{0}
  var key_fields: array<string> = [provider.wire_path(str.view(source_path)),string.from_int(monitor_frame),
    string.from_int(width),string.from_int(height)]
  var source_key: string = text.join(key_fields,"\t")
  let source_held: bool = str.eq(str.view(source_key),previous_source)
  if not source_held and str.len(str.view(source_path)) != 0 {
    var shot: provider.Frame = provider.source_frame(struct.borrow(state, field=provider),
      str.view(source_path), monitor_frame, width, height)
    if not shot.ok {source_key=string.new()}
    array.push(out, provider.take_pixels(shot))
  } else {
    array.push(out, draw.empty_surface())
  }
  provider.set_profile(struct.borrow(state,field=provider),profile)
  let program_begin: u64 = if profile {time.monotonic_ns()}else{0}
  let source_ns: u64 = if profile {program_begin-source_begin}else{0}
  var plan_ns: u64 = 0
  var program: provider.Frame = if struct.get(struct.borrow(state, field=provider), field=kind) ==
      provider.kind_gcompose() {
    let output: string = provider.preview_path(struct.borrow(state, field=provider))
    var frame_cache: timeline_media.RenderCache = timeline_media.render_cache(
      struct.borrow(state, field=fonts))
    timeline_media.configure_monitor_preview(document, frame_cache, width, height)
    match timeline_media.frame_plan(document, program_frame, "PREVIEW", str.view(output),
      str.view(output), frame_cache) {
      ok(plan_lines) => {
        var lines: array<string> = plan_lines
        // Planning interns editor property names; compare after that deterministic
        // preparation so incoming mailbox documents and direct calls use the same key.
        let signature: string = program_signature(document)
        if profile {plan_ns=time.monotonic_ns()-program_begin}
        var picture: provider.Frame = match provider.cached_program(struct.borrow(state, field=provider), str.view(signature), width, height) {
          some(held) => held,
          none => provider.program_plan(struct.borrow(state, field=provider),
            lines, width, height, frame_cache.width, frame_cache.height),
        }
        timeline_media.cleanup_plan(str.view(output))
        if picture.ok { provider.hold_program(struct.borrow(state, field=provider), str.view(signature)) }
        picture
      },
      err(problem) => {
        app.set_status(state, str.view(problem))
        var empty: array<string> = array.new()
        provider.program_frame(struct.borrow(state, field=provider), empty,
          program_frame, width, height)
      },
    }
  } else { provider.program_frame(struct.borrow(state, field=provider), visible,
    program_frame, width, height) }
  let program_ns: u64 = if profile {time.monotonic_ns()-program_begin-plan_ns}else{0}
  array.push(out, provider.take_pixels(program))
  Images {pictures:out,source_ns:source_ns,plan_ns:plan_ns,program_ns:program_ns,source_key:source_key,source_held:source_held,source_frame:monitor_frame,program_frame:program_frame}
}

// Fill the waveform cache for audio lanes. Video lanes retain frame strips even for legacy combined clips. This is the only place the application asks
// the provider for envelopes, so painting never does media work.
pub fn waveforms(state: ref<app.App>) -> u64 effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  match waveforms_for_request(state,"",0) {
    ok(value)=>value,err(problem)=>{provider.note_failure(struct.borrow(state,field=provider),problem)
      0},
  }
}
pub fn waveforms_for_request(state: ref<app.App>, root: str, id: u64) -> result<u64,string>
    effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  waveforms_in_range(state,root,id,false,0,0,StripView {limited:false,first:0,height:0.0})
}
pub fn waveforms_for_viewport(state: ref<app.App>, root: str, id: u64, start: i64, span: i64)
    -> result<u64,string> effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  if start < 0 or span <= 0 or span > 9223372036854775807-start {
    return result.err("[GA_TIMELINE_RANGE] Invalid waveform viewport")
  }
  waveforms_in_range(state,root,id,true,start,start+span,StripView {limited:false,first:0,height:0.0})
}
pub fn waveforms_for_strip_geometry(state: ref<app.App>, root: str, id: u64, geometry: str)
    -> result<u64,string> effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  let view: StripGeometry = try strip_geometry(geometry)
  waveforms_in_range(state,root,id,true,view.start,view.start+view.span,view.lanes)
}
pub type StripView = struct {limited:bool,first:u64,height:f64}
pub type StripGeometry = struct {start:i64,zoom:f64,span:i64,lanes:StripView,visual:bool,project:u64}
// The existing 3/5/6/7-field callers retain their complete-track semantics.
// Native requests append the first displayed lane and logical body height.
pub fn strip_geometry(geometry: str) -> result<StripGeometry,string> effects {alloc} {
  var fields: array<string> = text.split(geometry,"\t")
  let count: u64 = array.len(fields)
  if count != 3 and count != 5 and count != 6 and count != 7 and count != 9 and count != 11 {
    return result.err("[GA_TIMELINE_RANGE] Invalid strip viewport field count")
  }
  let first: i64 = match text.parse_i64(array.borrow(fields,0)) {some(value)=>value,none=>{return result.err("[GA_TIMELINE_RANGE] Invalid strip start")},}
  let zoom: f64 = match text.parse_f64(array.borrow(fields,1)) {some(value)=>value,none=>{return result.err("[GA_TIMELINE_RANGE] Invalid strip zoom")},}
  let span: i64 = match text.parse_i64(array.borrow(fields,2)) {some(value)=>value,none=>{return result.err("[GA_TIMELINE_RANGE] Invalid strip span")},}
  if first < 0 or span <= 0 or span > 9223372036854775807-first or not math.is_finite(zoom) or zoom <= 0.0 {
    return result.err("[GA_TIMELINE_RANGE] Invalid strip time viewport")
  }
  var lanes: StripView = StripView {limited:false,first:0,height:0.0}
  if count == 9 or count == 11 {
    let lane: u64 = match text.parse_u64(array.borrow(fields,7)) {some(value)=>value,none=>{return result.err("[GA_TIMELINE_RANGE] Invalid first strip lane")},}
    let height: f64 = match text.parse_f64(array.borrow(fields,8)) {some(value)=>value,none=>{return result.err("[GA_TIMELINE_RANGE] Invalid strip body height")},}
    if lane > 9007199254740991 or not math.is_finite(height) or height <= 0.0 or height > 32768.0 {
      return result.err("[GA_TIMELINE_RANGE] Invalid strip lane viewport")
    }
    lanes=StripView {limited:true,first:lane,height:height}
  }
  var project:u64=0
  if count==11 {
    if not str.eq(array.borrow(fields,9),"VISUAL1") {return result.err("[GA_TIMELINE_RANGE] Unknown display reference geometry")}
    project=match text.parse_u64(array.borrow(fields,10)) {none=>{return result.err("[GA_TIMELINE_RANGE] Invalid display project epoch")},some(v)=>v,}}
  result.ok(StripGeometry {start:first,zoom:zoom,span:span,lanes:lanes,visual:count==11,project:project})
}
// This uses the same sorted/reversed SDK lane identities as paint and hit-test.
// It includes the partially visible final lane; the footer is excluded by the
// caller's body height. No second timeline model is created.
pub fn strip_lanes(state: ref<app.App>, view: StripView) -> result<array<u64>,string> effects {alloc} {
  let doc: ref<editor.Document> = struct.borrow(state,field=document)
  var bottom: array<u64> = editor_view.lanes(doc,doc.active)
  var out: array<u64> = array.new()
  let count: u64 = array.len(bottom)
  if view.limited and ((count == 0 and view.first != 0) or (count > 0 and view.first >= count)) {
    return result.err("[GA_TIMELINE_RANGE] First strip lane is outside the active sequence")
  }
  let pitch: f64 = app.track_pitch(state)
  let height: f64 = app.track_height(state)
  var lane: u64 = if view.limited {view.first}else{0}
  loop {if lane >= count {break}
    let top: f64 = 4.0+cast.float(lane-if view.limited {view.first}else{0})*pitch
    if view.limited and top >= view.height {break}
    if not view.limited or top+height > 0.0 {array.push(out,array.get(bottom,count-1-lane))}
    lane=lane+1
  }
  result.ok(out)
}
fn strip_clip_matches(doc: ref<editor.Document>, clip: editor.Clip, video: bool) -> bool effects {alloc} {
  if clip.owner != doc.active {return false}
  if not video {return editor.track_kind(doc,clip.track) == editor.track_audio() and chrome.clip_has_audio(doc,clip.id)}
  if editor.track_kind(doc,clip.track) != editor.track_video() {return false}
  if not editor.clip_has_video(clip) {return false}
  if clip.nested != 0 {return true}
  match editor.source_slot(doc,clip.source) {none=>false,some(slot)=>{
    let source: ref<editor.Source> = array.borrow(struct.borrow(doc,field=sources),slot)
    source.has_video and source.online
  },}
}
// One eligible clip per visible lane per round keeps a dense top lane from
// consuming the complete bounded bitmap budget before lower lanes get a turn.
pub fn strip_targets(state: ref<app.App>, first: i64, last: i64, visible: bool,
    view: StripView, video: bool) -> result<array<u64>,string> effects {alloc} {
  var lanes: array<u64> = try strip_lanes(state,view)
  var out: array<u64> = array.new()
  let doc: ref<editor.Document> = struct.borrow(state,field=document)
  if not view.limited {
    var at: u64=0
    loop {if at >= editor.clip_count(doc) {break}
      let clip: editor.Clip=option.unwrap(editor.clip_at(doc,at))
      at=at+1
      if visible and (editor.clip_end(clip) <= first or clip.start >= last) {continue}
      if strip_clip_matches(doc,clip,video) {array.push(out,clip.id)}
    }
    return result.ok(out)
  }
  var cursors: array<u64> = array.new()
  var lane: u64=0
  loop {if lane >= array.len(lanes) {break}
    array.push(cursors,0)
    lane=lane+1}
  loop {
    var found: bool=false
    lane=0
    loop {if lane >= array.len(lanes) {break}
      var at: u64=array.get(cursors,lane)
      loop {if at >= editor.clip_count(doc) {break}
        let clip: editor.Clip=option.unwrap(editor.clip_at(doc,at))
        at=at+1
        if clip.track != array.get(lanes,lane) or
            (visible and (editor.clip_end(clip) <= first or clip.start >= last)) {continue}
        if strip_clip_matches(doc,clip,video) {array.push(out,clip.id)
          found=true
          break}
      }
      array.set(cursors,lane,at)
      lane=lane+1
    }
    if not found {break}
  }
  result.ok(out)
}
pub fn waveform_buckets(length: i64, wanted: u64) -> result<u64,string> effects {alloc} {
  if wanted == 0 or wanted > app.waveform_peak_budget()/8 {
    return result.err("[GA_AUDIO_CLIP_ENV_CAPACITY] Too many waveform clips for the peak budget")
  }
  let divided: u64=app.waveform_peak_budget()/wanted
  let quota: u64=if divided > app.waveform_bucket_limit() {app.waveform_bucket_limit()}else{divided}
  let scaled: u64=cast.sat(length/3)
  let desired: u64=if scaled < 8 {8}else{scaled}
  result.ok(if desired > quota {quota}else{desired})
}
fn waveform_current(state: ref<app.App>, document: ref<editor.Document>, value: editor.Clip, buckets: u64) -> bool effects {alloc} {
  match app.waveform_slot(state,value.id) {none=>false,some(slot)=>{
    let cached: ref<app.Waveform> =array.borrow(struct.borrow(state,field=waveforms),slot)
    cached.document_revision == state.document_revision and cached.revision == state.media_revision and
      cached.source == value.source and cached.length == value.length and
      cached.first == timeline_media.source_frame(document,value,value.start) and
      cached.last == timeline_media.source_frame(document,value,value.start+value.length-1) and
      array.len(struct.borrow(cached,field=peaks)) == buckets
  },}
}
// GUI reference waveforms deliberately ignore only the owning sequence's
// output mixer. Child sequence gain/mute/solo and ordered clip DSP stay intact.
// This COPY never replaces or serializes the authored project.
pub fn visual_reference_document(document:ref<editor.Document>)->editor.Document effects {alloc} {
  var copy:editor.Document=editor.copy_document(document)
  var at:u64=0
  loop {if at>=array.len(struct.borrow(copy,field=tracks)) {break}
    let track:ref<editor.Track> =array.borrow(struct.borrow(copy,field=tracks),at)
    let id:u64=track.id
    let owner:u64=track.owner
    at=at+1
    if owner!=copy.active {continue}
    let _=editor.set_track_gain(copy,id,1.0)
    let _=editor.set_track_pan(copy,id,0.0)
    let _=editor.set_track_muted(copy,id,false)
    let _=editor.set_track_solo(copy,id,false)}
  copy
}
pub fn visual_reference_key(document:ref<editor.Document>,clip:editor.Clip,buckets:u64)
    ->result<string,string> effects {alloc} {
  if not editor.clip_has_audio(clip) or editor.track_gain(document,clip.track)!=1.0 or
      editor.track_pan(document,clip.track)!=0.0 or not editor.track_audible(document,clip.track) {
    return result.err("[GA_WAVEFORM_REFERENCE] Display descriptor must use the neutral owning output mixer")}
  var plan:array<string> =if timeline_media.effective_speed(document,clip)==0.0 {
    let saved:string=match editor_io.encode(document) {ok(v)=>v,err(_)=>{return result.err("[GA_WAVEFORM_REFERENCE] Cannot encode held display identity")},}
    [text.concat("held-visual-silence\n",saved),string.from_int(clip.id),string.from_int(buckets)]
  }else{try timeline_media.clip_envelope_plan(document,clip,buckets,"visual-envelope.f32")}
  var descriptor:string=text.concat("visual-root-neutral-v1\n",text.join(plan,"\n"))
  var digest:bytes=hash.sha256(str.bytes(str.view(descriptor)))
  result.ok(bytes.hex(bytes.view(digest)))
}
pub fn visual_reference_current(state:ref<app.App>,clip:editor.Clip,key:str,buckets:u64)->bool effects {} {
  match app.visual_waveform_slot(state,clip.id) {none=>false,some(slot)=>{
    let entry:ref<app.VisualWaveform> =array.borrow(struct.borrow(state,field=visual_waveforms),slot)
    entry.project==state.project_epoch and entry.media==state.media_revision and
      entry.clip==clip.id and entry.source==clip.source and entry.nested==clip.nested and entry.length==clip.length and
      str.eq(struct.borrow(entry,field=key),key) and array.len(struct.borrow(entry,field=peaks))==buckets
  },}
}
pub fn visual_waveforms_for_viewport(state:ref<app.App>,root:str,id:u64,first:i64,last:i64,view:StripView)
    ->result<u64,string> effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  var wanted:array<u64> =try strip_targets(state,first,last,true,view,false)
  if array.len(wanted)>app.waveform_peak_budget()/8 {return result.err("[GA_AUDIO_CLIP_ENV_CAPACITY] Too many display waveforms")}
  var document:editor.Document=visual_reference_document(struct.borrow(state,field=document))
  var widths:array<u64> =array.new()
  var keys:array<string> =array.new()
  var at:u64=0
  // Preflight every descriptor before evicting or publishing any new reference.
  loop {if at>=array.len(wanted) {break}
    let clip:editor.Clip=option.unwrap(editor.clip(document,array.get(wanted,at)))
    let buckets:u64=try waveform_buckets(clip.length,array.len(wanted))
    array.push(widths,buckets)
    array.push(keys,try visual_reference_key(document,clip,buckets))
    at=at+1}
  at=0
  loop {if at>=array.len(wanted) {break}
    let clip:editor.Clip=option.unwrap(editor.clip(document,array.get(wanted,at)))
    if visual_reference_current(state,clip,array.borrow(keys,at),array.get(widths,at)) {app.touch_visual_waveform(state,clip.id)}
    at=at+1}
  at=0
  loop {if at>=array.len(wanted) {break}
    if id!=0 and str.len(root)!=0 and number(root,"request.id")!=id {
      return result.err("[GA_AUDIO_STREAM_CANCELLED] Display viewport was superseded")}
    let clip:editor.Clip=option.unwrap(editor.clip(document,array.get(wanted,at)))
    let buckets:u64=array.get(widths,at)
    let key:str=array.borrow(keys,at)
    if not visual_reference_current(state,clip,key,buckets) {
      let engine:ref<provider.Provider> =struct.borrow(state,field=provider)
      var peaks:array<f64> =if timeline_media.effective_speed(document,clip)==0.0 {array.repeat(0.0,buckets)
      }else if engine.kind==provider.kind_fake() {
        provider.envelope(engine,text.concat("visual:",key),buckets)
      }else{
        if engine.kind!=provider.kind_gcompose() {return result.err("[GA_WAVEFORM_REFERENCE] Display waveforms require the native worker")}
        try timeline_media.clip_envelope(document,clip,buckets,provider.worker_path(engine),provider.audition_path(engine),root,id)}
      if not app.set_visual_waveform(state,clip.id,key,peaks) {
        return result.err("[GA_WAVEFORM_REFERENCE] Cannot retain validated display waveform")}
    }
    at=at+1}
  at=0
  loop {if at>=array.len(wanted) {break}
    let clip:editor.Clip=option.unwrap(editor.clip(document,array.get(wanted,at)))
    if not visual_reference_current(state,clip,array.borrow(keys,at),array.get(widths,at)) {
      return result.err("[GA_AUDIO_CLIP_ENV_CAPACITY] Requested display waveform was evicted")}
    at=at+1}
  result.ok(array.len(wanted))
}

fn waveforms_in_range(state: ref<app.App>, root: str, id: u64, visible: bool, first: i64, last: i64, view: StripView)
    -> result<u64,string> effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  var wanted: array<u64> = try strip_targets(state,first,last,visible,view,false)
  if array.len(wanted) > app.waveform_peak_budget()/8 {
    return result.err("[GA_AUDIO_CLIP_ENV_CAPACITY] Too many visible waveform clips for the peak budget")
  }
  var widths: array<u64> = array.new()
  var document: editor.Document = editor.copy_document(struct.borrow(state, field=document))
  var index: u64 = 0
  loop {
    if index >= array.len(wanted) { break }
    match editor.clip(document,array.get(wanted,index)) {
      none => { },some(value) => {
          array.push(widths,try waveform_buckets(value.length,array.len(wanted)))
      },
    }
    index = index + 1
  }
  // Promote ALL reusable targets before any new result can evict an entry.
  // A cached target later in document order must survive earlier misses too.
  index=0
  loop {if index >= array.len(wanted) {break}
    let value: editor.Clip=option.unwrap(editor.clip(document,array.get(wanted,index)))
    if waveform_current(state,document,value,array.get(widths,index)) {app.touch_waveform(state,value.id)}
    index=index+1
  }
  var filled: u64 = 0
  var at: u64 = 0
  loop {
    if at >= array.len(wanted) { break }
    if id != 0 and str.len(root) != 0 and number(root,"request.id") != id {
      return result.err("[GA_AUDIO_STREAM_CANCELLED] Strip viewport was superseded")
    }
    let value: editor.Clip = option.unwrap(editor.clip(document,array.get(wanted,at)))
    let buckets: u64 = array.get(widths,at)
    // The strip worker retains its cache across viewport requests. Only a
    // content/media generation or changed time mapping needs new audio work.
    if waveform_current(state,document,value,buckets) {
      filled=filled+1
      at=at+1
      continue
    }
      let engine: ref<provider.Provider> = struct.borrow(state,field=provider)
      var peaks: array<f64> = if not value.enabled or not editor.track_audible(document,value.track) or
          timeline_media.effective_speed(document,value) == 0.0 {
        // Waveforms show the authored clip's actual contribution, including
        // mute/solo/disabled silence and held pictures without advancing sound.
        var silence: array<f64> = array.new()
        var k: u64 = 0
        loop {if k >= buckets {break}
          array.push(silence,0.0)
          k=k+1
        }
        silence
      }else if engine.kind == provider.kind_fake() {
        provider.envelope(engine,text.concat("processed:",string.from_int(value.id)),buckets)
      }else{
        if engine.kind != provider.kind_gcompose() {return result.err("[GA_AUDIO_CLIP_ENV] Processed stereo waveforms require the native worker")}
        try timeline_media.clip_envelope(document,value,buckets,provider.worker_path(engine),
          provider.audition_path(engine),root,id)
      }
      app.set_waveform(state,value.id,peaks,timeline_media.source_frame(document,value,value.start),
        timeline_media.source_frame(document,value,value.start+value.length-1),state.media_revision)
      filled=filled+1
      at=at+1
  }
  // The fair quota ensures all current targets can coexist after old-cache
  // eviction. Never commit a generation silently missing an earlier clip.
  at=0
  loop {if at >= array.len(wanted) {break}
    let slot: u64=match app.waveform_slot(state,array.get(wanted,at)) {some(value)=>value,none=>{
      return result.err("[GA_AUDIO_CLIP_ENV_CAPACITY] A requested waveform was not retained")},}
    let cached: ref<app.Waveform> =array.borrow(struct.borrow(state,field=waveforms),slot)
    if cached.document_revision != state.document_revision or cached.revision != state.media_revision or
        array.len(struct.borrow(cached,field=peaks)) != array.get(widths,at) {
      return result.err("[GA_AUDIO_CLIP_ENV_CAPACITY] A requested waveform generation was not retained")
    }
    at=at+1
  }
  result.ok(filled)
}


pub type Config = struct {worker: string, ffprobe: string, scratch: string, kind: u32, fonts: array<string>, events: channel.Ticket, profile: bool, pixel_stream: bool, strips_only: bool}
pub fn config(state: ref<app.App>, root: str, events: channel.Ticket own) -> Config effects {alloc} {
  let kind: u32 = struct.get(struct.borrow(state, field=provider), field=kind)
  let worker: string = provider.worker_path(struct.borrow(state, field=provider))
  let ffprobe: string = string.copy(str.view(struct.borrow(struct.borrow(state, field=provider), field=ffprobe)))
  var fonts: array<string> = array.new()
  var i: u64 = 0
  loop { if i >= array.len(struct.borrow(state, field=fonts)) { break }
    array.push(fonts, string.copy(str.view(array.borrow(struct.borrow(state, field=fonts), i))))
    i = i + 1
  }
  Config {worker: worker, ffprobe: ffprobe, scratch: string.copy(root), kind: kind, fonts: fonts, events: events, profile: false, pixel_stream: false,strips_only:false}
}

fn publish_checked(root: str, name: str, value: str) -> bool effects {alloc, fs.write} {
  let output: string = path.join(root, name)
  let temp: string = text.concat(str.view(output), ".tmp")
  match files.write_text(str.view(temp), value) { err(_) => false,
    ok(_) => match files.rename(str.view(temp), str.view(output)) {ok(_)=>true,err(_)=>false,}, }
}
fn publish(root: str, name: str, value: str) -> unit effects {alloc, fs.write} {
  let _ = publish_checked(root,name,value)
  ()
}
fn number(root: str, name: str) -> u64 effects {alloc, fs.read} {
  match files.read_text(str.view(path.join(root, name))) {
    err(_) => 0, ok(value) => match text.parse_u64(str.view(text.trim(str.view(value)))) { none => 0, some(value) => value, },
  }
}
// The presenter supplies eligibility from its freshly configured request queue.
// Connection-wide failures have no retired picture identity to discard.
pub fn current_failure(transport: ref<link.Link>, request_current: bool) -> option<string> effects {alloc} {
  let detail: str = str.view(struct.borrow(transport,field=error))
  if str.len(detail) == 0 {
    if transport.closed {return option.some(string.copy("[GA_PREVIEW_CHANNEL] Preview producer is closed"))}
    return option.none()}
  if not transport.closed and transport.error_generation != 0 and not request_current {return option.none()}
  option.some(string.copy(detail))
}
// A broken event socket cannot carry its own fatal error. Keep the original
// request/snapshot beside the mailbox; only a closed producer can promote that
// terminal cause across retired document epochs. Ordinary cancellations never
// write this record and healthy Links never consume it.
fn terminal_failure(root:str,generation:u64,snapshot:u64,detail:str) -> unit
    effects {alloc,fs.meta,fs.read,fs.write} {
  if tasks.requested_at(path.join(root,"stop")) {return ()}
  var data:string=text.concat("1\t",text.concat(string.from_int(generation),
    text.concat("\t",string.from_int(snapshot))))
  string.append(data,"\n")
  string.append(data,detail)
  let _=publish_checked(root,"producer-failure.tsv",data)
  ()
}
pub fn producer_failure(root:str,generation:u64,snapshot:u64) -> option<string>
    effects {alloc,fs.read} {
  let data:string=match files.read_text(path.join(root,"producer-failure.tsv")) {
    ok(value)=>value,err(_)=>{return option.none()},}
  let newline:u64=match str.find(data,"\n") {some(value)=>value,none=>{return option.none()},}
  var fields:array<string> = text.split(str.slice(data,0,newline),"\t")
  if array.len(fields)!=3 or not str.eq(array.borrow(fields,0),"1") {return option.none()}
  let id:u64=match text.parse_u64(array.borrow(fields,1)) {some(value)=>value,none=>{return option.none()},}
  let base:u64=match text.parse_u64(array.borrow(fields,2)) {some(value)=>value,none=>{return option.none()},}
  if id!=generation or base!=snapshot or newline+1>=str.len(data) {return option.none()}
  option.some(string.copy(str.slice(data,newline+1,str.len(data))))
}
pub fn poll_failure(root:str,transport:ref<link.Link>) -> unit effects {alloc,fs.read} {
  if not transport.closed {return ()}
  let data:string=match files.read_text(path.join(root,"producer-failure.tsv")) {
    ok(value)=>value,err(_)=>{return ()},}
  let newline:u64=match str.find(data,"\n") {some(value)=>value,none=>{return ()},}
  var fields:array<string> = text.split(str.slice(data,0,newline),"\t")
  if array.len(fields)!=3 or not str.eq(array.borrow(fields,0),"1") {return ()}
  let id:u64=match text.parse_u64(array.borrow(fields,1)) {some(value)=>value,none=>{return ()},}
  let base:u64=match text.parse_u64(array.borrow(fields,2)) {some(value)=>value,none=>{return ()},}
  let detail:string=match producer_failure(root,id,base) {some(value)=>value,none=>{return ()},}
  var message:string=text.concat("[GA_PREVIEW_CHANNEL] Producer ended at request ",string.from_int(id))
  string.append(message,text.concat(" snapshot ",string.from_int(base)))
  string.append(message,": ")
  string.append(message,detail)
  let _=struct.replace(transport,message,field=error)
  struct.set(transport,0,field=error_generation)
  ()
}
// Legacy requests retain file authority; pixel windows poll their owned command
// authority without losing any replacement that arrives during decode or send.
pub fn fail_current(peer: ref<link.Peer>, root: str, generation: u64, detail: str)
    -> bool effects {alloc,fs.meta,fs.read,net,time} {
  if peer.control_mode {
    if not match link.window_current(peer,generation) {ok(v)=>v,err(_)=>false,} {return false}
  }else if tasks.requested_at(path.join(root,"stop")) or number(root,"request.id") != generation {return false}
  link.fail(peer,generation,detail)
  true
}
pub fn reset(root: str) -> unit effects {alloc, fs.write} {
  publish(root,"producer-failure.tsv","")
  let _ = files.remove(str.view(path.join(root, "stop")))
  publish(root, "request.id", "0")
  publish(root, "ready.id", "0")
  publish(root, "waveforms.id", "0")
  publish(root, "thumbnails.id", "0")
  ()
}
pub fn request(root: str, document: str, generation: u64) -> bool effects {alloc, fs.write} {
  request_viewport(root, document, generation, 0, 2.4, 450)
}
pub fn request_viewport(root: str, document: str, generation: u64, start: i64, zoom: f64, span: i64) -> bool effects {alloc, fs.write} {
  request_quality(root, document, generation, start, zoom, span, 480, 270)
}
pub fn request_quality(root: str, document: str, generation: u64, start: i64, zoom: f64,
    span: i64, width: u32, height: u32) -> bool effects {alloc, fs.write} {
  request_revision(root, document, generation, start, zoom, span, width, height, 0)
}
pub fn request_revision(root: str, document: str, generation: u64, start: i64, zoom: f64,
    span: i64, width: u32, height: u32, media_revision: u64) -> bool effects {alloc, fs.write} {
  request_document_revision(root,document,generation,start,zoom,span,width,height,media_revision,0)
}
pub fn request_document_revision(root: str, document: str, generation: u64, start: i64, zoom: f64,
    span: i64, width: u32, height: u32, media_revision: u64, document_revision: u64)
    -> bool effects {alloc, fs.write} {
  request_geometry(root,document,generation,start,zoom,span,width,height,media_revision,document_revision,"")
}
pub fn request_strips(root: str, document: str, generation: u64, start: i64, zoom: f64,
    span: i64, width: u32, height: u32, media_revision: u64, document_revision: u64,
    first_lane: u64, body_height: f64) -> bool effects {alloc,fs.write} {
  if start < 0 or span <= 0 or span > 9223372036854775807-start or not math.is_finite(zoom) or zoom <= 0.0 or
      first_lane > 9007199254740991 or not math.is_finite(body_height) or body_height <= 0.0 or body_height > 32768.0 {return false}
  let lanes: string = text.concat(string.from_int(first_lane),text.concat("\t",string.from_float(body_height)))
  request_geometry(root,document,generation,start,zoom,span,width,height,media_revision,document_revision,str.view(lanes))
}
// Opt-in GUI reference protocol. Older request_strips/WAVEFORMS 2 callers
// retain exact audible-contribution peaks, including muted/zero output.
pub fn request_visual_strips(root:str,document:str,generation:u64,start:i64,zoom:f64,
    span:i64,width:u32,height:u32,media_revision:u64,document_revision:u64,
    first_lane:u64,body_height:f64,project_epoch:u64)->bool effects {alloc,fs.write} {
  if start<0 or span<=0 or span>9223372036854775807-start or not math.is_finite(zoom) or zoom<=0.0 or
      first_lane>9007199254740991 or not math.is_finite(body_height) or body_height<=0.0 or body_height>32768.0 {return false}
  var lanes:string=text.concat(string.from_int(first_lane),text.concat("\t",string.from_float(body_height)))
  string.append(lanes,text.concat("\tVISUAL1\t",string.from_int(project_epoch)))
  request_geometry(root,document,generation,start,zoom,span,width,height,media_revision,document_revision,str.view(lanes))
}
fn request_geometry(root: str, document: str, generation: u64, start: i64, zoom: f64,
    span: i64, width: u32, height: u32, media_revision: u64, document_revision: u64, lanes: str)
    -> bool effects {alloc,fs.write} {
  let geometry: string = text.concat(str.view(string.from_int(start)), text.concat("\t",
    text.concat(str.view(string.from_float(zoom)), text.concat("\t", str.view(string.from_int(span))))))
  let sized: string = text.concat(str.view(geometry), text.concat("\t", text.concat(str.view(string.from_int(width)),
    text.concat("\t", str.view(string.from_int(height))))))
  var versioned: string = text.concat(str.view(sized), text.concat("\t", str.view(string.from_int(media_revision))))
  string.append(versioned,"\t")
  string.append(versioned,string.from_int(document_revision))
  if str.len(lanes) != 0 {string.append(versioned,"\t")
    string.append(versioned,lanes)}
  // Document, viewport, quality and revision are one atomic snapshot. A reader
  // cannot pair an old generation with the next drag's geometry or document.
  let generation_text: string = string.from_int(generation)
  var snapshot: string = text.concat(str.view(generation_text),"\t")
  string.append(snapshot,str.view(versioned))
  string.append(snapshot,"\n")
  string.append(snapshot,document)
  if not publish_checked(root,"request.air",str.view(snapshot)) {return false}
  publish_checked(root,"request.id",str.view(generation_text))
}
// Retain an immutable project snapshot across moving monitor requests. Only time
// travels on the command lane until content, source selection, mode, media or
// display geometry changes. The snapshot generation also survives a coalesced
// initial wake: the worker can load that exact base before applying the newest tick.
pub fn request_frame(state: ref<app.App>, root: str, transport: ref<link.Link>, generation: u64,
    content: str, program_frame: i64, source_frame: i64, width: u32, height: u32)
    -> bool effects {alloc,fs.write,net,time} {
  // A pending endpoint has no legal parked Program snapshot yet.
  if not app.endpoint_picture_ready(state) {return false}
  // Viewport strip lanes retain full geometry snapshots through request_revision.
  if not transport.pixel_stream {return false}
  let presentation:i64=app.presentation_duration(state)
  let document: ref<editor.Document> = struct.borrow(state,field=document)
  var key: string = string.copy(content)
  var fields: array<string> = [string.from_int(document.monitor_source),
    string.from_int(if editor.playing(document) {1}else{0}),
    string.from_int(if struct.get(struct.borrow(document,field=monitor),field=playing) {1}else{0}),
    string.from_int(state.media_revision),string.from_int(width),string.from_int(height),string.from_int(presentation),string.from_int(state.endpoint_prepare)]
  string.append(key,"\n")
  string.append(key,text.join(fields,"\t"))
  if transport.snapshot_generation == 0 or not str.eq(key,struct.borrow(transport,field=snapshot_key)) {
    var snapshot: editor.Document = editor.copy_document(document)
    let _ = editor.seek_until(snapshot,program_frame,presentation)
    let _ = editor.seek_monitor(snapshot,source_frame)
    let encoded: string = match editor_io.encode(snapshot) {ok(value)=>value,err(_)=>{return false},}
    if not request_endpoint_snapshot(state,root,encoded,generation,width,height) {return false}
    link.retire_window(transport)
    if not match link.wake(transport,false) {ok(_)=>true,err(_)=>false,} {return false}
    struct.set(transport,generation,field=snapshot_generation)
    struct.set(transport,false,field=command_retirement)
    let _ = struct.replace(transport,key,field=snapshot_key)
    return true
  }
  // The marker remains the authoritative retirement signal while a slow consumer
  // holds pixel credit. It contains no project data and publishes before the tick.
  if not publish_checked(root,"request.id",string.from_int(generation)) {return false}
  match link.frame(transport,generation,transport.snapshot_generation,program_frame,source_frame,state.media_revision) {
    ok(_)=>{struct.set(transport,false,field=command_retirement)
      true},err(_)=>false,
  }
}
// A GUI-issued window decodes at most two frames within the caller's eight-slot
// owned-plus-reserved budget. Its final ID is the retirement marker; each
// completion keeps its own ID and actual frame time. The Link FIFO owns at most
// two completed packets until the caller transfers them into its picture queue.
pub type FrameWindow = struct {first:u64,last:u64,snapshot:u64,program:i64,source:i64,
  revision:u64,source_playing:bool}
pub fn frame_window(command: str) -> result<FrameWindow,str> effects {alloc} {
  var fields: array<string> = text.split(command,"\t")
  if array.len(fields) != 7 {return result.err("[GA_PREVIEW_REQUEST] Invalid decode window")}
  let first: u64 = match text.parse_u64(array.borrow(fields,0)) {some(value)=>value,none=>0,}
  let last: u64 = match text.parse_u64(array.borrow(fields,1)) {some(value)=>value,none=>0,}
  let snapshot: u64 = match text.parse_u64(array.borrow(fields,2)) {some(value)=>value,none=>0,}
  let program: i64 = match text.parse_i64(array.borrow(fields,3)) {some(value)=>value,none=>-1,}
  let source: i64 = match text.parse_i64(array.borrow(fields,4)) {some(value)=>value,none=>-1,}
  let revision: u64 = match text.parse_u64(array.borrow(fields,5)) {some(value)=>value,none=>{
    return result.err("[GA_PREVIEW_REQUEST] Invalid window media revision")},}
  let mode: u64 = match text.parse_u64(array.borrow(fields,6)) {some(value)=>value,none=>2,}
  if first == 0 or last < first or last-first > 1 or snapshot == 0 or snapshot > first or
      program < 0 or source < 0 or mode > 1 {
    return result.err("[GA_PREVIEW_REQUEST] Invalid decode window bounds")
  }
  result.ok(FrameWindow {first:first,last:last,snapshot:snapshot,program:program,source:source,
    revision:revision,source_playing:mode==1})
}
pub fn window_positions(document: ref<editor.Document>, program: i64, source: i64,
    count: u64, source_playing: bool) -> bool effects {} {
  window_positions_until(document,program,source,count,source_playing,editor.sequence_duration(document,document.active))
}
pub fn window_positions_until(document:ref<editor.Document>,program:i64,source:i64,count:u64,source_playing:bool,total_program:i64) -> bool effects {} {
  if count == 0 or count > 2 or program < 0 or source < 0 {return false}
  let extra: i64 = cast.sat(count-1)
  if (source_playing and source > 9223372036854775807-extra) or
      (not source_playing and program > 9223372036854775807-extra) {return false}
  if count == 2 {
    let monitor_playing: bool = struct.get(struct.borrow(document,field=monitor),field=playing)
    if source_playing {if not monitor_playing or editor.playing(document) {return false}}
    else if not editor.playing(document) or monitor_playing {return false}
  }
  // Use the same bounds as seek/seek_monitor without copying a full project for
  // each moving request. A clamped frame cannot acquire an exact request stamp.
  let total_source: i64 = editor.source_frames(document,document.monitor_source)
  let last_program: i64 = if total_program > 0 {total_program-1}else{0}
  let last_source: i64 = if total_source > 0 {total_source-1}else{0}
  let end_program: i64 = if source_playing {program}else{program+extra}
  let end_source: i64 = if source_playing {source+extra}else{source}
  end_program <= last_program and end_source <= last_source
}
fn request_problem(transport:ref<link.Link>,detail:str) -> bool effects {alloc} {
  // A current publication fault has not acquired a queue stamp. Retired decode
  // errors must not masquerade as its cause; a terminal producer cause survives.
  if not transport.closed or str.len(struct.borrow(transport,field=error))==0 {
    let _=struct.replace(transport,string.copy(detail),field=error)
  }
  struct.set(transport,0,field=error_generation)
  false
}
pub fn request_window(state: ref<app.App>, root: str, transport: ref<link.Link>, first_id: u64,
    count: u64, content: str, program_frame: i64, source_frame: i64, width: u32, height: u32,
    source_playing: bool) -> bool effects {alloc,fs.read,fs.write,net,time} {
  if not app.endpoint_picture_ready(state) {return false}
  if transport.closed {poll_failure(root,transport)
    return request_problem(transport,"[GA_PREVIEW_CHANNEL] Preview command lane is closed")}
  if not transport.pixel_stream or first_id == 0 or count == 0 or count > 2 or
      first_id > 18446744073709551615-(count-1) or width == 0 or height == 0 or width > 1280 or height > 720 {
    return request_problem(transport,"[GA_PREVIEW_REQUEST] Invalid decode-window identity or dimensions")}
  let presentation:i64=app.presentation_duration(state)
  let document: ref<editor.Document> = struct.borrow(state,field=document)
  if not window_positions_until(document,program_frame,source_frame,count,source_playing,presentation) {
    return request_problem(transport,"[GA_PREVIEW_REQUEST] Decode window exceeds its transport bounds")}
  let last_id: u64 = first_id+count-1
  var key: string = string.copy(content)
  var fields: array<string> = [string.from_int(document.monitor_source),
    string.from_int(if editor.playing(document) {1}else{0}),
    string.from_int(if struct.get(struct.borrow(document,field=monitor),field=playing) {1}else{0}),
    string.from_int(state.media_revision),string.from_int(width),string.from_int(height),string.from_int(presentation),string.from_int(state.endpoint_prepare)]
  string.append(key,"\n")
  string.append(key,text.join(fields,"\t"))
  if transport.snapshot_generation == 0 or not str.eq(key,struct.borrow(transport,field=snapshot_key)) {
    var snapshot: editor.Document = editor.copy_document(document)
    let _ = editor.seek_until(snapshot,program_frame,presentation)
    let _ = editor.seek_monitor(snapshot,source_frame)
    let encoded: string = match editor_io.encode(snapshot) {ok(value)=>value,err(_)=>{
      return request_problem(transport,"[GA_PREVIEW_REQUEST] Cannot encode the preview snapshot")},}
    if not request_endpoint_snapshot(state,root,encoded,first_id,width,height) {
      return request_problem(transport,"[GA_PREVIEW_REQUEST] Cannot publish the preview snapshot")}
    struct.set(transport,first_id,field=snapshot_generation)
    let _ = struct.replace(transport,key,field=snapshot_key)
  }
  match link.window_frame(transport,first_id,last_id,transport.snapshot_generation,program_frame,source_frame,
      state.media_revision,source_playing) {ok(_)=>{struct.set(transport,true,field=command_retirement)
      true},err(problem)=>request_problem(transport,problem),}
}
// Retire live work before a synchronous picker holds the event consumer. This
// cancellation-only ID carries no decode; the next real request installs a
// fresh snapshot. Failed submission preserves all owned transport state.
pub fn retire_request(root:str,transport:ref<link.Link>,id:u64) -> bool effects {alloc,fs.write,net,time} {
  if transport.command_retirement {return match link.retire_command(transport,id) {ok(_)=>true,err(_)=>false,}}
  // Existing single-frame/nonpixel callers retain file-marker cancellation.
  if id==0 or id<=transport.ready or id<=transport.window_last or id<=transport.retired_through or
      id<=transport.snapshot_generation {return false}
  if not publish_checked(root,"request.id",string.from_int(id)) {return false}
  link.retire_window(transport)
  struct.set(transport,id,field=retired_through)
  struct.set(transport,0,field=snapshot_generation)
  let _=struct.replace(transport,string.new(),field=snapshot_key)
  true
}
fn window_current(peer:ref<link.Peer>,root: str,last:u64) -> result<bool,string>
    effects {alloc,fs.meta,fs.read,net,time} {
  if peer.control_mode {return link.window_current(peer,last)}
  result.ok(not tasks.requested_at(path.join(root,"stop")) and number(root,"request.id")==last)
}
fn fail_window(peer: ref<link.Peer>, root: str, last: u64, failed: u64, detail: str)
    -> unit effects {alloc,fs.meta,fs.read,net,time} {
  if match window_current(peer,root,last) {ok(v)=>v,err(_)=>false,} {link.fail(peer,failed,detail)}
  ()
}
fn render_window(state: ref<app.App>, peers: ref<array<link.Peer>>, root: str, window: FrameWindow,
    width: u32, height: u32, profile: bool, request_ns: u64, held_source: ref<string>)
    -> result<bool,string> effects {alloc,fs.meta,fs.read,fs.write,process,net,time} {
  var offset: u64 = 0
  loop {if offset > window.last-window.first {break}
    if not try window_current(array.borrow(peers,0),root,window.last) {return result.ok(false)}
    let id: u64 = window.first+offset
    let delta: i64 = cast.sat(offset)
    let program_frame: i64 = if window.source_playing {window.program}else{window.program+delta}
    let source_frame: i64 = if window.source_playing {window.source+delta}else{window.source}
    let presentation:i64=app.presentation_duration(state)
    let _ = editor.seek_until(struct.borrow(state,field=document),program_frame,presentation)
    let _ = editor.seek_monitor(struct.borrow(state,field=document),source_frame)
    let _ = struct.replace(struct.borrow(state,field=provider),string.new(),field=last_error)
    provider.begin_picture_control(struct.borrow(state,field=provider),option.unwrap(array.pop(peers)),window.last)
    var measured: Images = images_with_source(state,width,height,profile,str.view(held_source))
    // images returns a value on every error/cancel path; restore ownership before
    // polling, propagation, or publication of any result.
    array.push(peers,provider.end_picture_control(struct.borrow(state,field=provider)))
    if not try window_current(array.borrow(peers,0),root,window.last) {return result.ok(false)}
    let problem: string = provider.last_error(struct.borrow(state,field=provider))
    if str.len(problem) != 0 {fail_window(array.borrow(peers,0),root,window.last,id,problem)
      return result.ok(false)}
    if measured.program_frame != program_frame or measured.source_frame != source_frame {
      fail_window(array.borrow(peers,0),root,window.last,id,"[GA_PREVIEW_REQUEST] Decode window frame was clamped")
      return result.ok(false)
    }
    var rendered: array<draw.Surface> = struct.replace(measured,array.new(),field=pictures)
    var program: draw.Surface = match array.pop(rendered) {some(value)=>value,none=>draw.empty_surface(),}
    var source: draw.Surface = match array.pop(rendered) {some(value)=>value,none=>draw.empty_surface(),}
    let begin: u64 = time.monotonic_ns()
    let timing: link.FrameTiming = link.FrameTiming {generation:id,request_ns:request_ns,source_ns:measured.source_ns,
      plan_ns:measured.plan_ns,program_ns:measured.program_ns,publish_ns:0,coalesce_ns:struct.get(array.borrow(peers,0),field=last_drain_ns)}
    match link.notify_pixels_window(array.borrow(peers,0),root,window.last,source,program,"",measured.source_held,timing,
        link.FramePosition {source_frame:source_frame,program_frame:program_frame,revision:window.revision},begin) {
      ok(sent)=>{if not sent {return result.ok(false)}},
      err(problem)=>{
        // A superseding marker may retire this window while a blocked send
        // returns. That old send error must not close the current producer.
        fail_window(array.borrow(peers,0),root,window.last,id,problem)
        if not struct.get(struct.borrow(array.borrow(peers,0),field=events),field=failed) and
            not (try window_current(array.borrow(peers,0),root,window.last)) {
          return result.ok(false)}
        return result.err(problem)},
    }
    if not try window_current(array.borrow(peers,0),root,window.last) {return result.ok(false)}
    let _ = ref.swap(held_source,string.copy(str.view(struct.borrow(measured,field=source_key))))
    offset=offset+1
  }
  result.ok(true)
}
pub fn stop(root: str) -> unit effects {alloc, fs.write} { let _ = files.write_text(str.view(path.join(root, "stop")), "stop")
 () }
pub fn completed(root: str) -> u64 effects {alloc, fs.read} { number(root, "ready.id") }
pub fn thumbnails_completed(root: str) -> u64 effects {alloc, fs.read} { number(root, "thumbnails.id") }
pub fn waveforms_completed(root: str) -> u64 effects {alloc, fs.read} { number(root, "waveforms.id") }
pub fn error(root: str) -> string effects {alloc, fs.read} {
  match files.read_text(str.view(path.join(root, "error.txt"))) { ok(value) => value, err(_) => string.new(), }
}
fn image_file(root: str, id: u64, which: str) -> string effects {alloc} {
  path.join(root, str.view(text.concat(which, text.concat(str.view(string.from_int(id % 2)), ".rgba"))))
}
fn write_image(root: str, id: u64, which: str, image: ref<draw.Surface>) -> bool effects {alloc, fs.write} {
  let output: string = image_file(root, id, which)
  let temp: string = text.concat(str.view(output), ".tmp")
  let pixels: view<byte> = array.view(struct.borrow(image, field=pixels))
  match files.write_bytes(str.view(temp), pixels) { err(_) => false,
    ok(_) => match files.rename(str.view(temp), str.view(output)) {ok(_)=>true,err(_)=>false,}, }
}
fn image_size(root: str, id: u64) -> array<u32> effects {alloc, fs.read} {
  let filename: string = image_file(root, id, "size")
  let content: string = match files.read_text(str.view(filename)) {ok(value) => value, err(_) => string.copy("480\t270"),}
  var fields: array<string> = text.split(str.view(content), "\t")
  if array.len(fields) != 2 { return [480, 270] }
  let width: u32 = match text.parse_u64(str.view(array.borrow(fields, 0))) {some(value) => cast.sat(value), none => 480,}
  let height: u32 = match text.parse_u64(str.view(array.borrow(fields, 1))) {some(value) => cast.sat(value), none => 270,}
  [width, height]
}
pub fn read_images(root: str, id: u64) -> array<draw.Surface> effects {alloc, fs.read} {
  var out: array<draw.Surface> = array.new()
  let marker: string = text.concat("frame",text.concat(str.view(string.from_int(id % 2)),".id"))
  if number(root,str.view(marker)) != id { return out }
  var size: array<u32> = image_size(root, id)
  var i: u64 = 0
  loop { if i == 2 { break }
    let name: str = if i == 0 { "source" } else { "program" }
    var image: draw.Surface = match files.read_bytes(str.view(image_file(root, id, name))) {
      err(_) => draw.empty_surface(),
      ok(raw) => match draw.surface_from_rgba(array.get(size, 0), array.get(size, 1), bytes.view(raw)) { none => draw.empty_surface(), some(value) => value, },
    }
    array.push(out, image)
 i = i + 1
  }
  // A reused slot may have changed while its two files were being read. The
  // consumer retains its held picture and takes the next ready event instead.
  if number(root,str.view(marker)) != id {return array.new()}
  out
}
pub fn write_waveforms(state: ref<app.App>, root: str) -> unit effects {alloc, fs.write} {
  var selected: array<u64> = array.new()
  let _ = write_selected_waveforms(state,root,false,selected)
  ()
}
fn write_strip_waveforms(state: ref<app.App>, root: str, viewport: StripGeometry,id:u64) -> result<unit,string> effects {alloc,fs.write} {
  var selected: array<u64> = try strip_targets(state,viewport.start,viewport.start+viewport.span,true,viewport.lanes,false)
  if viewport.visual {write_visual_waveforms(state,root,selected,id)}else{write_selected_waveforms(state,root,viewport.lanes.limited,selected)}
}
fn write_selected_waveforms(state: ref<app.App>, root: str, limited: bool, selected: ref<array<u64>>) -> result<unit,string> effects {alloc,fs.write} {
  var lines: string = text.concat("WAVEFORMS 2\t",string.from_int(state.document_revision))
  string.append(lines,"\t")
  string.append(lines,string.from_int(state.media_revision))
  string.append(lines,"\n")
  var i: u64 = 0
  loop { if i >= array.len(struct.borrow(state, field=waveforms)) { break }
    let wave: ref<app.Waveform> = array.borrow(struct.borrow(state, field=waveforms), i)
    let current: editor.Clip = match editor.clip(struct.borrow(state,field=document),wave.clip) {
      some(value)=>value,none=>{i=i+1
        continue},}
    if not strip_clip_matches(struct.borrow(state,field=document),current,false) {i=i+1
      continue}
    if limited {
      var wanted: bool=false
      var k: u64=0
      loop {if k >= array.len(selected) {break}
        if array.get(selected,k)==wave.clip {wanted=true
          break}
        k=k+1}
      if not wanted {i=i+1
        continue}
    }
    string.append(lines, str.view(string.from_int(wave.clip)))
    var mapping: array<string> = [string.from_int(wave.source),string.from_int(wave.length),string.from_int(wave.first),string.from_int(wave.last),string.from_int(wave.revision),string.from_int(wave.document_revision)]
    string.append(lines,"\t")
    string.append(lines,str.view(text.join(mapping,"\t")))
    var k: u64 = 0
    loop { if k >= array.len(struct.borrow(wave, field=peaks)) { break }
      string.append(lines, "\t")
 string.append(lines, str.view(string.from_float(array.get(struct.borrow(wave, field=peaks), k))))
      k = k + 1
    }
    string.append(lines, "\n")
 i = i + 1
  }
  if not publish_checked(root, "waveforms.tsv", str.view(lines)) {
    return result.err("[GA_TIMELINE_PUBLISH] Cannot publish waveform data")
  }
  result.ok(())
}
pub fn read_waveforms(state: ref<app.App>, root: str, id: u64) -> bool effects {alloc, fs.read} {
  let requested: u64 = number(root,"request.id")
  if requested != 0 and requested != id {return false}
  if number(root,"waveforms.id") != id {return false}
  let content: string = match files.read_text(str.view(path.join(root, "waveforms.tsv"))) { ok(value) => value, err(_) => { return false }, }
  if number(root,"waveforms.id") != id {return false}
  if str.starts_with(content,"VISUAL-WAVEFORMS 1\t") {return read_visual_waveforms(state,root,id,str.view(content))}
  var rows: array<string> = text.split(str.view(content), "\n")
  let versioned: bool = str.starts_with(content,"WAVEFORMS 2\t")
  if versioned {
    var header: array<string> = text.split(array.borrow(rows,0),"\t")
    if array.len(header) != 3 {return false}
    if match text.parse_u64(array.borrow(header,1)) {some(value)=>value != state.document_revision,none=>true,} or
       match text.parse_u64(array.borrow(header,2)) {some(value)=>value != state.media_revision,none=>true,} {return false}
  }
  var incoming: array<app.Waveform> = array.new()
  var incoming_peaks: u64=0
  var i: u64 = 0
  loop { if i >= array.len(rows) { break }
    var fields: array<string> = text.split(str.view(array.borrow(rows, i)), "\t")
    if array.len(fields) > 6 {
      let clip: u64 = match text.parse_u64(str.view(array.borrow(fields, 0))) { some(value) => value, none => 0, }
      let source: u64 = match text.parse_u64(str.view(array.borrow(fields,1))) {some(value)=>value,none=>0,}
      let length: i64 = match text.parse_i64(str.view(array.borrow(fields,2))) {some(value)=>value,none=>0,}
      let first: i64 = match text.parse_i64(str.view(array.borrow(fields,3))) {some(value)=>value,none=>-1,}
      let last: i64 = match text.parse_i64(str.view(array.borrow(fields,4))) {some(value)=>value,none=>-1,}
      let revision: u64 = match text.parse_u64(str.view(array.borrow(fields,5))) {some(value)=>value,none=>0,}
      let document_revision: u64 = if versioned {
        if array.len(fields) <= 7 {return false}
        match text.parse_u64(array.borrow(fields,6)) {some(value)=>value,none=>{return false},}
      }else{state.document_revision}
      let current: editor.Clip = match editor.clip(struct.borrow(state,field=document),clip) {some(value)=>value,none=>{i=i+1
        continue},}
      if not strip_clip_matches(struct.borrow(state,field=document),current,false) or
          revision != state.media_revision or document_revision != state.document_revision or
          (not versioned and current.nested != 0) or current.source != source or current.length != length or
          timeline_media.source_frame(struct.borrow(state,field=document),current,current.start) != first or
          timeline_media.source_frame(struct.borrow(state,field=document),current,current.start+current.length-1) != last {i=i+1
        continue}
      var peaks: array<f64> = array.new()
 var k: u64 = if versioned {7}else{6}
      loop { if k >= array.len(fields) { break }
        let peak: f64 = match text.parse_f64(str.view(array.borrow(fields,k))) {some(value)=>value,none=>{return false},}
        if not math.is_finite(peak) or peak < 0.0 {return false}
        array.push(peaks,peak)
        if array.len(peaks) > app.waveform_bucket_limit() {return false}
 k = k + 1
      }
      incoming_peaks=incoming_peaks+array.len(peaks)
      if incoming_peaks > app.waveform_peak_budget() {return false}
      if clip != 0 {array.push(incoming,app.Waveform {clip:clip,source:source,length:length,first:first,last:last,
        revision:revision,document_revision:document_revision,peaks:peaks})}
    }
    i = i + 1
  }
  if number(root,"waveforms.id") != id or (number(root,"request.id") != 0 and number(root,"request.id") != id) {return false}
  i=0
  loop {if i >= array.len(incoming) {break}
    let wave: ref<app.Waveform> = array.borrow(incoming,i)
    app.set_waveform(state,wave.clip,struct.replace(wave,array.new(),field=peaks),wave.first,wave.last,wave.revision)
    i=i+1
  }
  true
}

pub fn compound_thumbnail(state: ref<app.App>, document: ref<editor.Document>,
    clip: editor.Clip, owner_frame: i64) -> result<provider.Frame,string>
    effects {alloc,fs.meta,fs.read,fs.write,process,net,time} {
  let prefix: string = text.concat(provider.preview_path(struct.borrow(state,field=provider)),".strip")
  var cache: timeline_media.RenderCache = timeline_media.render_cache(struct.borrow(state,field=fonts))
  timeline_media.configure_monitor_preview(document,cache,80,45)
  let planned: result<array<string>,string> = timeline_media.clip_picture_plan(document,clip,
    owner_frame,"PREVIEW",str.view(prefix),str.view(prefix),cache)
  var lines: array<string> = match planned {
    err(problem)=>{timeline_media.cleanup_plan(str.view(prefix))
      return result.err(problem)},ok(value)=>value,
  }
  var shot: provider.Frame = provider.program_plan(struct.borrow(state,field=provider),
    lines,80,45,cache.width,cache.height)
  timeline_media.cleanup_plan(str.view(prefix))
  if not shot.ok {return result.err(string.copy(str.view(struct.borrow(shot,field=detail))))}
  result.ok(shot)
}

fn write_thumbnails(state: ref<app.App>, root: str, id: u64, geometry: str) -> result<unit,string> effects {alloc, fs.meta, fs.read, fs.write, process, net, time} {
  var fields: array<string> = text.split(geometry, "\t")
  let viewport: StripGeometry = try strip_geometry(geometry)
  let start: i64 = viewport.start
  let zoom: f64 = viewport.zoom
  let span: i64 = viewport.span
  var wanted: array<u64> = try strip_targets(state,start,start+span,true,viewport.lanes,true)
  // Reserve the strip before reusing a slot. Readers keep the previous owned
  // pictures until the complete manifest and matching generation are committed.
  if not publish_checked(root,"thumbnails.id","0") {return result.err("[GA_TIMELINE_PUBLISH] Cannot reserve thumbnail generation")}
  // Match the painted, aspect-fitted tile width at this lane height. A fixed
  // 96px sampling interval left most of a 46px-high video lane without pictures.
  let tile_width: f64 = 80.0 * math.max(1.0, app.track_height(state) - 20.0) / 45.0
  let step: i64 = cast.sat(math.max(1.0, math.ceil((tile_width + 2.0) / zoom)))
  var doc: editor.Document = editor.copy_document(struct.borrow(state, field=document))
  var lines: string = string.new()
  var total: u64 = 0
  var i: u64 = 0
  var next_frames: array<i64> = array.new()
  loop {if i >= array.len(wanted) {break}
    let clip: editor.Clip=option.unwrap(editor.clip(doc,array.get(wanted,i)))
    let begin: i64=if start > clip.start {start}else{clip.start}
    array.push(next_frames,clip.start+((begin-clip.start)/step)*step)
    i = i + 1
  }
  i=0
  var exhausted: u64=0
  loop {if total >= 32 or array.len(wanted) == 0 {break}
    let clip: editor.Clip=option.unwrap(editor.clip(doc,array.get(wanted,i)))
    let last: i64=if start+span < clip.start+clip.length {start+span}else{clip.start+clip.length}
    let at: i64=array.get(next_frames,i)
    if at >= last {
      exhausted=exhausted+1
      if exhausted >= array.len(wanted) {break}
      i=if i+1 >= array.len(wanted) {0}else{i+1}
      continue
    }
    exhausted=0
    var filename: string = string.new()
    if clip.nested == 0 {
      let source_slot: u64 = match editor.source_slot(doc, clip.source) {none => {
        array.set(next_frames,i,last)
        i=if i+1 >= array.len(wanted) {0}else{i+1}
        continue }, some(value) => value,}
      let source: ref<editor.Source> = array.borrow(struct.borrow(doc, field=sources), source_slot)
      if not source.has_video or not source.online {
        array.set(next_frames,i,last)
        i=if i+1 >= array.len(wanted) {0}else{i+1}
        continue }
      let _ = ref.swap(filename,string.copy(str.view(struct.borrow(source, field=path))))
    }
      if number(root, "request.id") != id { return result.ok(()) }
      let sample: i64 = timeline_media.source_frame(doc, clip, at)
      var shot: provider.Frame = if clip.nested != 0 {
        try compound_thumbnail(state,doc,clip,at)
      }else{provider.source_frame(struct.borrow(state, field=provider), str.view(filename), sample, 80, 45)}
      if number(root,"request.id") != id {return result.ok(())}
      if not shot.ok {
        return result.err(text.concat("[GA_TIMELINE_SOURCE] Cannot decode timeline bitmap: ",
          str.view(struct.borrow(shot,field=detail))))
      }
      if shot.ok {
        let name: string = text.concat("thumb-", text.concat(str.view(string.from_int(id % 2)), text.concat("-", str.view(string.from_int(total)))))
        var pixels: draw.Surface = provider.take_pixels(shot)
        if not write_image(root,id,str.view(name),pixels) {return result.err("[GA_TIMELINE_PUBLISH] Cannot publish thumbnail pixels")}
        string.append(lines, str.view(string.from_int(clip.id)))
        string.append(lines, "\t")
        string.append(lines, str.view(string.from_int(at)))
        string.append(lines, "\t")
        string.append(lines, str.view(name))
        string.append(lines, "\t")
        string.append(lines, str.view(string.from_int(clip.source)))
        string.append(lines, "\t")
        string.append(lines, str.view(string.from_int(sample)))
        string.append(lines, "\t")
        let revision_text: string = if array.len(fields) >= 6 {string.copy(str.view(array.borrow(fields,5)))}else{string.copy("0")}
        string.append(lines,str.view(revision_text))
        string.append(lines,"\t")
        let document_revision_text: string = if array.len(fields) >= 7 {
          string.copy(str.view(array.borrow(fields,6)))
        }else{string.copy("0")}
        string.append(lines,str.view(document_revision_text))
        string.append(lines, "\n")
        total = total + 1
      }
      // The step may saturate for a tiny legacy zoom. Clamp to the checked
      // viewport/clip endpoint before addition, so the next time cannot wrap.
      array.set(next_frames,i,if step >= last-at {last}else{at+step})
      // Legacy snapshots keep their historical clip-first filmstrip. Native
      // lane snapshots give every eligible clip a turn before a second tile.
      if viewport.lanes.limited {i=if i+1 >= array.len(wanted) {0}else{i+1}}
  }
  if number(root,"request.id") != id {return result.ok(())}
  if not publish_checked(root,"thumbnails.tsv",str.view(lines)) or
      not publish_checked(root,"thumbnails.id",string.from_int(id)) {
    return result.err("[GA_TIMELINE_PUBLISH] Cannot commit thumbnail generation")
  }
  result.ok(())
}
pub fn read_thumbnails(state: ref<app.App>, root: str, id: u64) -> bool effects {alloc, fs.read} {
  let requested: u64 = number(root,"request.id")
  if requested != 0 and requested != id {return false}
  if number(root,"thumbnails.id") != id {return false}
  let content: string = match files.read_text(path.join(root, "thumbnails.tsv")) {ok(value) => value, err(_) => { return false },}
  var rows: array<string> = text.split(str.view(content), "\n")
  var thumbs: array<app.Thumbnail> = array.new()
  var i: u64 = 0
  loop { if i >= array.len(rows) { break }
    var fields: array<string> = text.split(str.view(array.borrow(rows, i)), "\t")
    i = i + 1
    if array.len(fields) != 6 and array.len(fields) != 7 { continue }
    let clip: u64 = match text.parse_u64(str.view(array.borrow(fields, 0))) {some(value) => value, none => 0,}
    let frame: i64 = match text.parse_i64(str.view(array.borrow(fields, 1))) {some(value) => value, none => 0,}
    let source: u64 = match text.parse_u64(str.view(array.borrow(fields,3))) {some(value)=>value,none=>{continue},}
    let source_frame: i64 = match text.parse_i64(str.view(array.borrow(fields,4))) {some(value)=>value,none=>{continue},}
    let revision: u64 = match text.parse_u64(str.view(array.borrow(fields,5))) {some(value)=>value,none=>{continue},}
    let document_revision: u64 = if array.len(fields) == 7 {
      match text.parse_u64(str.view(array.borrow(fields,6))) {some(value)=>value,none=>{continue},}
    }else{0}
    let current: editor.Clip = match editor.clip(struct.borrow(state,field=document),clip) {some(value)=>value,none=>{continue},}
    if not strip_clip_matches(struct.borrow(state,field=document),current,true) or
        revision != state.media_revision or current.owner != struct.get(struct.borrow(state,field=document),field=active) or
        (current.nested != 0 and document_revision != state.document_revision) or
        current.source != source or frame < current.start or frame >= current.start+current.length or
        timeline_media.source_frame(struct.borrow(state,field=document),current,frame) != source_frame {continue}
    let filename: string = image_file(root, id, str.view(array.borrow(fields, 2)))
    let raw: bytes = match files.read_bytes(str.view(filename)) {ok(value) => value, err(_) => { continue },}
    var pixels: draw.Surface = match draw.surface_from_rgba(80, 45, bytes.view(raw)) {some(value) => value, none => { continue },}
    array.push(thumbs, app.Thumbnail {clip: clip, frame: frame, source:source, source_frame:source_frame,
      revision:revision,document_revision:document_revision,pixels: pixels})
  }
  if number(root,"thumbnails.id") != id or (number(root,"request.id") != 0 and number(root,"request.id") != id) {return false}
  let _ = struct.replace(state, thumbs, field=thumbnails)
  true
}

pub fn run(config: Config own) -> bool effects {alloc, fs.meta, fs.read, fs.write, net, process, time} {
  var owned: Config = config
  var wake:array<link.Peer> = [match link.peer(struct.borrow(owned,field=events)) {ok(value)=>value,err(_)=>{return false},}]
  // Only the real pixel producer opts into command-owned retirement. Direct
  // Link fixtures, strip workers and old single-frame calls keep file authority.
  struct.set(array.borrow(wake,0),owned.pixel_stream and not owned.strips_only,field=control_enabled)
  let root: string = string.copy(str.view(struct.borrow(owned, field=scratch)))
  var engine: provider.Provider = if owned.kind == provider.kind_gcompose() {
    provider.gcompose(str.view(struct.borrow(owned, field=worker)), str.view(root))
  } else if owned.kind == provider.kind_ffmpeg() {
    provider.native(str.view(struct.borrow(owned, field=worker)), str.view(struct.borrow(owned, field=ffprobe)), str.view(root))
  } else { provider.fake(str.view(root)) }
  provider.use_program_stream(engine,owned.pixel_stream and not owned.strips_only)
  var state: app.App = app.app(engine)
  let _ = struct.replace(state, struct.replace(owned, array.new(), field=fonts), field=fonts)
  var seen: u64 = 0
  var snapshot_generation: u64 = 0
  var retired_generation:u64=0
  var snapshot_geometry: string = string.new()
  var media_revision: u64 = 0
  var held_source: string = string.new()
  loop {
    if tasks.requested_at(str.view(path.join(str.view(root), "stop"))) { break }
    match link.next_checked(array.borrow(wake,0)) {ok(active)=>{if not active {break}},err(problem)=>{
      terminal_failure(str.view(root),seen,snapshot_generation,problem)
      break},}
    let request_begin: u64 = if owned.profile {time.monotonic_ns()}else{0}
    let retired:u64=struct.get(array.borrow(wake,0),field=retired_generation)
    if owned.pixel_stream and retired>retired_generation {
      // A coalesced newer window must rebuild against a new worker, never reuse
      // retained GPU identities from the explicitly retired transport epoch.
      provider.restart(struct.borrow(state,field=provider))
      let _=ref.swap(held_source,string.new())
      snapshot_generation=0
      retired_generation=retired
    }
    if owned.pixel_stream and struct.get(array.borrow(wake,0),field=command_kind)==11 {
      provider.restart(struct.borrow(state,field=provider))
      let _=ref.swap(held_source,string.new())
      snapshot_generation=0
      seen=struct.get(array.borrow(wake,0),field=current_generation)
      continue}
    if owned.pixel_stream and struct.get(array.borrow(wake,0),field=command_kind)==12 {
      let control_detail:string=string.copy(struct.borrow(array.borrow(wake,0),field=command))
      let failed_generation:u64=struct.get(array.borrow(wake,0),field=current_generation)
      link.fail(array.borrow(wake,0),failed_generation,control_detail)
      seen=struct.get(array.borrow(wake,0),field=current_generation)
      continue}
    if owned.pixel_stream and struct.get(array.borrow(wake,0),field=control_mode) and struct.get(array.borrow(wake,0),field=command_kind)==0 {continue}
    let id:u64=if owned.pixel_stream and struct.get(array.borrow(wake,0),field=control_mode) {struct.get(array.borrow(wake,0),field=current_generation)}else{number(str.view(root),"request.id")}
    if id == 0 or id == seen { continue }
    var base: u64 = id
    var program_frame: i64 = 0
    var source_frame: i64 = 0
    var tick_revision: u64 = 0
    let batch: bool = struct.get(array.borrow(wake,0),field=command_kind) == 10
    var window: FrameWindow = FrameWindow {first:id,last:id,snapshot:id,program:0,source:0,revision:0,source_playing:false}
    let tick: bool = struct.get(array.borrow(wake,0),field=command_kind) == 8 or batch
    if batch {
      if not owned.pixel_stream or owned.strips_only {
        let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_REQUEST] Decode windows require a pixel stream")
        continue
      }
      window=match frame_window(struct.borrow(array.borrow(wake,0),field=command)) {ok(value)=>value,err(problem)=>{
        let _ = fail_current(array.borrow(wake,0),str.view(root),id,problem)
        continue},}
      if window.last != id {continue}
      base=window.snapshot
      program_frame=window.program
      source_frame=window.source
      tick_revision=window.revision
    } else if tick {
      var fields: array<string> = text.split(struct.borrow(array.borrow(wake,0),field=command),"\t")
      if array.len(fields) != 5 {
        let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_REQUEST] Invalid frame command")
        continue
      }
      let carried: u64 = match text.parse_u64(array.borrow(fields,0)) {some(value)=>value,none=>0,}
      if carried != id {continue}
      base=match text.parse_u64(array.borrow(fields,1)) {some(value)=>value,none=>0,}
      program_frame=match text.parse_i64(array.borrow(fields,2)) {some(value)=>value,none=>{continue},}
      source_frame=match text.parse_i64(array.borrow(fields,3)) {some(value)=>value,none=>{continue},}
      tick_revision=match text.parse_u64(array.borrow(fields,4)) {some(value)=>value,none=>{continue},}
      if base == 0 or base > id {
        let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_REQUEST] Invalid frame snapshot identity")
        continue
      }
    }
    var geometry: string = string.copy(snapshot_geometry)
    if not tick or base != snapshot_generation {
      let data: string = match files.read_text(str.view(path.join(str.view(root), "request.air"))) { ok(value) => value, err(_) => {
        let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_REQUEST] Cannot read the requested project snapshot")
        continue }, }
      let boundary: u64 = match str.find(str.view(data),"\n") {some(value)=>value,none=>{
        let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_REQUEST] Invalid preview snapshot header")
        continue},}
      let header: str = str.slice(str.view(data),0,boundary)
      let separator: u64 = match str.find(header,"\t") {some(value)=>value,none=>{
        let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_REQUEST] Invalid preview snapshot generation")
        continue},}
      let carried_id: u64 = match text.parse_u64(str.slice(header,0,separator)) {some(value)=>value,none=>0,}
      if carried_id != base {continue}
      geometry = string.copy(str.slice(header,separator+1,boundary))
      let document: editor.Document = match editor_io.decode(str.slice(str.view(data),boundary+1,str.len(str.view(data)))) {
        ok(value) => value, err(_) => {
          let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_REQUEST] Cannot decode the requested project snapshot")
          continue }, }
      if not match window_current(array.borrow(wake,0),str.view(root),id) {ok(v)=>v,err(problem)=>{
        terminal_failure(str.view(root),id,base,problem)
        break},} {continue}
      if owned.pixel_stream and snapshot_generation!=0 {
        provider.restart(struct.borrow(state,field=provider))
      }
      let _ = struct.replace(state, document, field=document)
      // Sent Source bytes may still be unreceived when an epoch is retired.
      // Only moving windows within this immutable snapshot may hold that key.
      let _ = ref.swap(held_source,string.new())
      snapshot_generation=base
      let _ = ref.swap(snapshot_geometry,string.copy(geometry))
    }
    if not match window_current(array.borrow(wake,0),str.view(root),id) {ok(v)=>v,err(problem)=>{
        terminal_failure(str.view(root),id,base,problem)
        break},} {continue}
    seen = id
    let _ = struct.replace(struct.borrow(state, field=provider), string.new(), field=last_error)
    var dimensions: array<string> = text.split(str.view(geometry), "\t")
    let width: u32 = if array.len(dimensions) >= 5 { match text.parse_u64(str.view(array.borrow(dimensions, 3))) {some(value) => cast.sat(value), none => 480,} } else { 480 }
    let height: u32 = if array.len(dimensions) >= 5 { match text.parse_u64(str.view(array.borrow(dimensions, 4))) {some(value) => cast.sat(value), none => 270,} } else { 270 }
    let revision: u64 = if array.len(dimensions) >= 6 { match text.parse_u64(str.view(array.borrow(dimensions, 5))) {some(value) => value, none => 0,} } else { 0 }
    struct.set(state,0,field=runtime_program_end)
    if array.len(dimensions)>9 and not owned.strips_only {
      if array.len(dimensions)!=13 or not str.eq(array.borrow(dimensions,9),"END1") {
        let _=fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_REQUEST] Invalid runtime endpoint bounds")
        continue}
      let total:i64=match text.parse_i64(array.borrow(dimensions,10)) {some(v)=>v,none=>-1,}
      let accepted:u64=match text.parse_u64(array.borrow(dimensions,11)) {some(v)=>v,none=>0,}
      let owner:u64=match text.parse_u64(array.borrow(dimensions,12)) {some(v)=>v,none=>0,}
      if not endpoint_program_bound(struct.borrow(state,field=document),total,accepted,owner) {
        let _=fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_REQUEST] Runtime endpoint identity or bound differs")
        continue}
      struct.set(state,total,field=runtime_program_end)
    }
    let presentation:i64=app.presentation_duration(state)
    if tick {
      if tick_revision != revision {
        let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_REQUEST] Frame media revision differs from its snapshot")
        continue
      }
      if batch and not window_positions_until(struct.borrow(state,field=document),program_frame,source_frame,
          window.last-window.first+1,window.source_playing,presentation) {
        fail_window(array.borrow(wake,0),str.view(root),id,window.first,"[GA_PREVIEW_REQUEST] Decode window exceeds its transport bounds")
        continue
      }
      let _ = editor.seek_until(struct.borrow(state,field=document),program_frame,presentation)
      let _ = editor.seek_monitor(struct.borrow(state,field=document),source_frame)
    }
    if revision != media_revision {
      provider.restart(struct.borrow(state, field=provider))
      media_revision = revision
      let _ = ref.swap(held_source,string.new())
    }
    struct.set(state,revision,field=media_revision)
    struct.set(state,if array.len(dimensions) >= 7 {match text.parse_u64(array.borrow(dimensions,6)) {
      some(value)=>value,none=>0,}}else{0},field=document_revision)
    // This mailbox accepts monitor sizes, not arbitrary export-sized allocations.
    if width == 0 or height == 0 or width > 1280 or height > 720 {
      let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_GEOMETRY] Preview dimensions must be within 1280x720")
      continue
    }
    let request_ns: u64 = if owned.profile {time.monotonic_ns()-request_begin}else{0}
    if batch {
      match render_window(state,wake,str.view(root),window,width,height,owned.profile,request_ns,held_source) {
        ok(_)=>{},err(problem)=>{
          terminal_failure(str.view(root),window.last,window.snapshot,problem)
          break},
      }
      continue
    }
    if owned.strips_only {
      let viewport: StripGeometry = match strip_geometry(str.view(geometry)) {
        err(problem)=>{let _ = fail_current(array.borrow(wake,0),str.view(root),id,problem)
          continue},ok(value)=>value,
      }
      if viewport.visual {struct.set(state,viewport.project,field=project_epoch)}
      let waves:result<u64,string> =if viewport.visual {
        visual_waveforms_for_viewport(state,str.view(root),id,viewport.start,viewport.start+viewport.span,viewport.lanes)
      }else{waveforms_in_range(state,str.view(root),id,true,viewport.start,viewport.start+viewport.span,viewport.lanes)}
      match waves {
        ok(_)=>{},err(problem)=>{let _ = fail_current(array.borrow(wake,0),str.view(root),id,problem)
          continue},
      }
      if number(str.view(root),"request.id") != id {continue}
      if not publish_checked(str.view(root),"waveforms.id","0") {
        let _=fail_current(array.borrow(wake,0),str.view(root),id,"[GA_TIMELINE_PUBLISH] Cannot reserve waveform generation")
        continue
      }
      match write_strip_waveforms(state,str.view(root),viewport,id) {ok(_)=>{},err(problem)=>{
        let _=fail_current(array.borrow(wake,0),str.view(root),id,problem)
        continue},}
      if number(str.view(root),"request.id") != id {continue}
      if not publish_checked(str.view(root),"waveforms.id",str.view(string.from_int(id))) {
        let _=fail_current(array.borrow(wake,0),str.view(root),id,"[GA_TIMELINE_PUBLISH] Cannot commit waveform generation")
        continue
      }
      if not link.notify(array.borrow(wake,0),2,id) {break}
      match write_thumbnails(state,str.view(root),id,str.view(geometry)) {
        err(problem)=>{let _ = fail_current(array.borrow(wake,0),str.view(root),id,str.view(problem))
          continue},ok(_)=>{},
      }
      if not link.notify(array.borrow(wake,0),3,number(str.view(root),"thumbnails.id")) {break}
      continue
    }
    let previous_source: string = if owned.pixel_stream {string.copy(str.view(held_source))}else{string.new()}
    if owned.pixel_stream {provider.begin_picture_control(struct.borrow(state,field=provider),option.unwrap(array.pop(wake)),id)}
    var measured: Images = images_with_source(state,width,height,owned.profile,str.view(previous_source))
    if owned.pixel_stream {array.push(wake,provider.end_picture_control(struct.borrow(state,field=provider)))
      if not match window_current(array.borrow(wake,0),str.view(root),id) {ok(v)=>v,err(_)=>false,} {continue}}
    let media_error: string = provider.last_error(struct.borrow(state,field=provider))
    if str.len(media_error) != 0 {
      publish(str.view(root),"error.txt",media_error)
      let _ = fail_current(array.borrow(wake,0),str.view(root),id,media_error)
      continue
    }
    let source_ns: u64 = measured.source_ns
    let plan_ns: u64 = measured.plan_ns
    let program_ns: u64 = measured.program_ns
    var rendered: array<draw.Surface> = struct.replace(measured,array.new(),field=pictures)
    let publish_begin: u64 = if owned.profile or owned.pixel_stream {time.monotonic_ns()}else{0}
    var program: draw.Surface = match array.pop(rendered) { some(value) => value, none => draw.empty_surface(), }
    var source: draw.Surface = match array.pop(rendered) { some(value) => value, none => draw.empty_surface(), }
    if owned.pixel_stream {
      let timing: link.FrameTiming = link.FrameTiming {generation:id,request_ns:request_ns,source_ns:source_ns,
        plan_ns:plan_ns,program_ns:program_ns,publish_ns:0,coalesce_ns:struct.get(array.borrow(wake,0),field=last_drain_ns)}
      match link.notify_pixels(array.borrow(wake,0),str.view(root),source,program,
          str.view(provider.last_error(struct.borrow(state,field=provider))),measured.source_held,timing,
          link.FramePosition {source_frame:measured.source_frame,program_frame:measured.program_frame,revision:revision},publish_begin) {
        ok(delivered)=>{if not delivered {continue}
          let _ = ref.swap(held_source,string.copy(str.view(struct.borrow(measured,field=source_key))))},
        err(problem)=>{terminal_failure(str.view(root),id,base,problem)
          let _ = fail_current(array.borrow(wake,0),str.view(root),id,str.view(problem))
          break},
      }
    } else {
    let marker: string = text.concat("frame",text.concat(str.view(string.from_int(id % 2)),".id"))
    if not publish_checked(str.view(root),str.view(marker),"0") {
      let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_PUBLISH] Cannot reserve the next frame slot")
      continue
    }
    if not write_image(str.view(root),id,"source",source) or
        not write_image(str.view(root),id,"program",program) {
      let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_PUBLISH] Cannot publish preview pixels")
      continue
    }
    publish(str.view(root), "error.txt", str.view(provider.last_error(struct.borrow(state, field=provider))))
    let size_text: string = text.concat(str.view(string.from_int(width)), text.concat("\t", str.view(string.from_int(height))))
    let size_name: string = text.concat("size",text.concat(str.view(string.from_int(id % 2)),".rgba"))
    let generation_text: string = string.from_int(id)
    if not publish_checked(str.view(root),str.view(size_name),str.view(size_text)) or
        not publish_checked(str.view(root),str.view(marker),str.view(generation_text)) {
      let _ = fail_current(array.borrow(wake,0),str.view(root),id,"[GA_PREVIEW_PUBLISH] Cannot commit preview dimensions and generation")
      continue
    }
    publish(str.view(root), "ready.id", str.view(generation_text))
    let drained_ns:u64=struct.get(array.borrow(wake,0),field=last_drain_ns)
    let delivered: bool = if owned.profile {
      link.notify_frame(array.borrow(wake,0),id,request_ns,source_ns,plan_ns,program_ns,time.monotonic_ns()-publish_begin,drained_ns)
    }else{link.notify(array.borrow(wake,0),1,id)}
    if not delivered { break }
    }
    if not owned.pixel_stream and not editor.playing(struct.borrow(state, field=document)) and
        not struct.get(struct.borrow(struct.borrow(state, field=document), field=monitor), field=playing) {
      match waveforms_for_request(state,str.view(root),id) {
        ok(_)=>{},err(problem)=>{let _ = fail_current(array.borrow(wake,0),str.view(root),id,problem)
          continue},
      }
      if not publish_checked(str.view(root),"waveforms.id","0") {
        let _=fail_current(array.borrow(wake,0),str.view(root),id,"[GA_TIMELINE_PUBLISH] Cannot reserve waveform generation")
        continue
      }
      var selected: array<u64> = array.new()
      match write_selected_waveforms(state,str.view(root),false,selected) {ok(_)=>{},err(problem)=>{
        let _=fail_current(array.borrow(wake,0),str.view(root),id,problem)
        continue},}
      if number(str.view(root),"request.id") != id {continue}
      if not publish_checked(str.view(root),"waveforms.id",str.view(string.from_int(id))) {
        let _=fail_current(array.borrow(wake,0),str.view(root),id,"[GA_TIMELINE_PUBLISH] Cannot commit waveform generation")
        continue
      }
      if not link.notify(array.borrow(wake,0),2,id) { break }
      match write_thumbnails(state,str.view(root),id,str.view(geometry)) {
        err(problem)=>{let _ = fail_current(array.borrow(wake,0),str.view(root),id,str.view(problem))
          continue},ok(_)=>{},
      }
      if not link.notify(array.borrow(wake,0),3,number(str.view(root),"thumbnails.id")) { break }
    }
  }
  provider.shutdown(struct.borrow(state, field=provider))
  link.finish(array.borrow(wake,0),seen)
  true
}

fn request_endpoint_snapshot(state:ref<app.App>,root:str,document:str,id:u64,width:u32,height:u32) -> bool effects {alloc,fs.write} {
  if not app.endpoint_current(state) {return request_document_revision(root,document,id,0,2.4,450,width,height,state.media_revision,state.document_revision)}
  let total:i64=app.presentation_duration(state)
  let generation:u64=match struct.borrow(state,field=accepted_audio) {some(v)=>v.generation,none=>0,}
  // Empty/no-audio graphs have no worker generation and require no extended bounds.
  if generation==0 {return request_document_revision(root,document,id,0,2.4,450,width,height,state.media_revision,state.document_revision)}
  var fields:array<string> =["0","46","END1",string.from_int(total),string.from_int(generation),string.from_int(state.document.active)]
  request_geometry(root,document,id,0,2.4,450,width,height,state.media_revision,state.document_revision,str.view(text.join(fields,"\t")))
}

// Bounds only: accepted generation remains host-owned and part of immutable snapshot identity.
pub fn endpoint_program_bound(document:ref<editor.Document>,total:i64,generation:u64,owner:u64) -> bool effects {} {
  let authored:i64=editor.duration(document)
  if owner!=document.active or generation==0 or authored<0 or total<authored {return false}
  let fps:f64=editor.sequence_fps(document,document.active)
  if not math.is_finite(fps) or fps<=0.0 or fps>1000.0 {return false}
  let extra:f64=cast.float(total-authored)
  extra<=math.ceil(fps*5.0)+1.0
}

fn write_visual_waveforms(state:ref<app.App>,root:str,wanted:ref<array<u64>>,id:u64)->result<unit,string> effects {alloc,fs.write} {
  var content:string=text.concat("VISUAL-WAVEFORMS 1\t",string.from_int(state.document_revision))
  string.append(content,text.concat("\t",string.from_int(state.media_revision)))
  string.append(content,text.concat("\t",string.from_int(state.project_epoch)))
  string.append(content,text.concat("\t",string.from_int(id)))
  string.append(content,"\n")
  var at:u64=0
  loop {if at>=array.len(wanted) {break}
    let clip:u64=array.get(wanted,at)
    let slot:u64=match app.visual_waveform_slot(state,clip) {none=>{return result.err("[GA_WAVEFORM_REFERENCE] Missing display cache")},some(v)=>v,}
    let value:ref<app.VisualWaveform> =array.borrow(struct.borrow(state,field=visual_waveforms),slot)
    var fields:array<string> =[string.from_int(clip),string.from_int(value.source),string.from_int(value.nested),
      string.from_int(value.length),string.copy(struct.borrow(value,field=key))]
    var p:u64=0
    loop {if p>=array.len(struct.borrow(value,field=peaks)) {break}
      array.push(fields,string.from_float(array.get(struct.borrow(value,field=peaks),p)))
      p=p+1}
    string.append(content,text.join(fields,"\t"))
    string.append(content,"\n")
    at=at+1}
  if not publish_checked(root,"waveforms.tsv",str.view(content)) {return result.err("[GA_TIMELINE_PUBLISH] Cannot publish display reference")}
  result.ok(())
}
fn visual_receipt_current(state:ref<app.App>,wanted:ref<array<u64>>,document:ref<editor.Document>)->bool effects {alloc} {
  if app.waveform_peak_count(state)>app.waveform_peak_budget() {return false}
  if state.visual_receipt_epoch!=state.visual_cache_epoch or
      state.visual_receipt_document!=state.document_revision or
      state.visual_receipt_media!=state.media_revision or state.visual_receipt_project!=state.project_epoch or
      array.len(wanted)!=array.len(struct.borrow(state,field=visual_receipt_clips)) {return false}
  var at:u64=0
  var total:u64=0
  loop {if at>=array.len(wanted) {break}
    let id:u64=array.get(wanted,at)
    if id!=array.get(struct.borrow(state,field=visual_receipt_clips),at) {return false}
    let clip:editor.Clip=match editor.clip(document,id) {none=>{return false},some(v)=>v,}
    if not strip_clip_matches(document,clip,false) {return false}
    let buckets:u64=match waveform_buckets(clip.length,array.len(wanted)) {err(_)=>{return false},ok(v)=>v,}
    total=total+buckets
    if total>app.waveform_peak_budget() {return false}
    let expected:string=match visual_reference_key(document,clip,buckets) {err(_)=>{return false},ok(v)=>v,}
    let slot:u64=match app.visual_waveform_slot(state,id) {none=>{return false},some(v)=>v,}
    let entry:ref<app.VisualWaveform> =array.borrow(struct.borrow(state,field=visual_waveforms),slot)
    if entry.document_revision!=state.document_revision or entry.media!=state.media_revision or
        entry.project!=state.project_epoch or entry.source!=clip.source or entry.nested!=clip.nested or
        entry.length!=clip.length or not str.eq(struct.borrow(entry,field=key),str.view(expected)) or
        array.len(struct.borrow(entry,field=peaks))!=buckets {return false}
    at=at+1}
  true
}
fn read_visual_waveforms(state:ref<app.App>,root:str,id:u64,content:str)->bool effects {alloc,fs.read} {
  if id==0 or id!=state.waveform_pending {return false}
  let header_end:u64=match str.find(content,"\n") {none=>{return false},some(v)=>v,}
  var header:array<string> =text.split(str.slice(content,0,header_end),"\t")
  if array.len(header)!=5 {return false}
  if match text.parse_u64(array.borrow(header,3)) {none=>true,some(v)=>v!=state.project_epoch,} or
      match text.parse_u64(array.borrow(header,4)) {none=>true,some(v)=>v!=id,} {return false}
  if match text.parse_u64(array.borrow(header,1)) {none=>true,some(v)=>v!=state.document_revision,} or
      match text.parse_u64(array.borrow(header,2)) {none=>true,some(v)=>v!=state.media_revision,} {return false}
  // Read the immutable request's viewport to require every target, not merely
  // whatever rows a partial publication happened to include.
  let snapshot:string=match files.read_text(path.join(root,"request.air")) {err(_)=>{return false},ok(v)=>v,}
  var snapshot_rows:array<string> =text.split(snapshot,"\n")
  var snapshot_fields:array<string> =text.split(array.borrow(snapshot_rows,0),"\t")
  if array.len(snapshot_fields)!=12 or match text.parse_u64(array.borrow(snapshot_fields,0)) {none=>true,some(v)=>v!=id,} {return false}
  var geometry_fields:array<string> =array.new()
  var g:u64=1
  loop {if g>=array.len(snapshot_fields) {break}
    array.push(geometry_fields,string.copy(array.borrow(snapshot_fields,g)))
    g=g+1}
  let viewport:StripGeometry=match strip_geometry(text.join(geometry_fields,"\t")) {err(_)=>{return false},ok(v)=>v,}
  if not viewport.visual or viewport.project!=state.project_epoch {return false}
  var wanted:array<u64> =match strip_targets(state,viewport.start,viewport.start+viewport.span,true,viewport.lanes,false) {err(_)=>{return false},ok(v)=>v,}
  var document:editor.Document=visual_reference_document(struct.borrow(state,field=document))
  // A new viewport often republishes the exact same whole-clip reference. Reuse
  // only a byte-identical, fully validated body while its owned cache and all
  // authored identities remain unchanged. Changed data still takes the complete
  // parser, neutral descriptor, finite-value and capacity checks below.
  let body:str=str.slice(content,header_end+1,str.len(content))
  var digest:bytes=hash.sha256(str.bytes(body))
  let fingerprint:string=bytes.hex(bytes.view(digest))
  if str.eq(str.view(fingerprint),struct.borrow(state,field=visual_receipt_body)) and
      visual_receipt_current(state,wanted,document) {
    if number(root,"waveforms.id")!=id or number(root,"request.id")!=id {return false}
    app.waveform_complete(state,id)
    return true
  }
  var rows:array<string> =text.split(content,"\n")
  var incoming:array<app.VisualWaveform> =array.new()
  var total:u64=0
  var at:u64=1
  loop {if at>=array.len(rows) {break}
    let row:str=array.borrow(rows,at)
    at=at+1
    if str.len(row)==0 {continue}
    var fields:array<string> =text.split(row,"\t")
    if array.len(fields)<13 or array.len(fields)>app.waveform_bucket_limit()+5 {return false}
    let clip:u64=match text.parse_u64(array.borrow(fields,0)) {none=>{return false},some(v)=>v,}
    let source:u64=match text.parse_u64(array.borrow(fields,1)) {none=>{return false},some(v)=>v,}
    let nested:u64=match text.parse_u64(array.borrow(fields,2)) {none=>{return false},some(v)=>v,}
    let length:i64=match text.parse_i64(array.borrow(fields,3)) {none=>{return false},some(v)=>v,}
    let current:editor.Clip=match editor.clip(document,clip) {none=>{return false},some(v)=>v,}
    if not strip_clip_matches(document,current,false) or source!=current.source or nested!=current.nested or length!=current.length {return false}
    var earlier:u64=0
    loop {if earlier>=array.len(incoming) {break}
      if struct.get(array.borrow(incoming,earlier),field=clip)==clip {return false}
      earlier=earlier+1}
    var selected:bool=false
    var w:u64=0
    loop {if w>=array.len(wanted) {break}
      if array.get(wanted,w)==clip {selected=true}
      w=w+1}
    if not selected {return false}
    let buckets:u64=match waveform_buckets(current.length,array.len(wanted)) {err(_)=>{return false},ok(v)=>v,}
    if array.len(fields)-5!=buckets {return false}
    let key:str=array.borrow(fields,4)
    let expected:string=match visual_reference_key(document,current,buckets) {err(_)=>{return false},ok(v)=>v,}
    if not str.eq(key,str.view(expected)) {return false}
    var peaks:array<f64> =array.new()
    var k:u64=5
    loop {if k>=array.len(fields) {break}
      let value:f64=match text.parse_f64(array.borrow(fields,k)) {none=>{return false},some(v)=>v,}
      if not math.is_finite(value) or value<0.0 {return false}
      array.push(peaks,value)
      k=k+1}
    total=total+array.len(peaks)
    if total>app.waveform_peak_budget() {return false}
    array.push(incoming,app.VisualWaveform {clip:clip,source:source,nested:nested,length:length,
      media:state.media_revision,project:state.project_epoch,document_revision:state.document_revision,key:string.copy(key),peaks:peaks})}
  if array.len(incoming)!=array.len(wanted) or number(root,"waveforms.id")!=id or number(root,"request.id")!=id {return false}
  // Validate all rows and protect already valid hits before any miss may evict.
  at=0
  loop {if at>=array.len(incoming) {break}
    let entry:ref<app.VisualWaveform> =array.borrow(incoming,at)
    let clip:editor.Clip=option.unwrap(editor.clip(document,entry.clip))
    if visual_reference_current(state,clip,struct.borrow(entry,field=key),array.len(struct.borrow(entry,field=peaks))) {app.touch_visual_waveform(state,entry.clip)}
    at=at+1}
  at=0
  loop {if at>=array.len(incoming) {break}
    let entry:ref<app.VisualWaveform> =array.borrow(incoming,at)
    let clip_id:u64=entry.clip
    var key:string=string.copy(struct.borrow(entry,field=key))
    var peaks:array<f64> =struct.replace(entry,array.new(),field=peaks)
    if not app.set_visual_waveform(state,clip_id,str.view(key),peaks) {return false}
    at=at+1}
  let _=struct.replace(state,string.copy(str.view(fingerprint)),field=visual_receipt_body)
  let _=struct.replace(state,wanted,field=visual_receipt_clips)
  struct.set(state,state.visual_cache_epoch,field=visual_receipt_epoch)
  struct.set(state,state.document_revision,field=visual_receipt_document)
  struct.set(state,state.media_revision,field=visual_receipt_media)
  struct.set(state,state.project_epoch,field=visual_receipt_project)
  app.waveform_complete(state,id)
  true
}

// Paint-only state; no peak normalization or inferred audio meter output.
pub fn visual_waveform_label(state:ref<app.App>,clip:editor.Clip,current:bool)->string effects {alloc} {
  let document:ref<editor.Document> =struct.borrow(state,field=document)
  if clip.source!=0 and not editor.source_online(document,clip.source) {return string.copy("Unavailable")}
  if not current {return string.copy(if state.waveform_pending!=0 {"Loading waveform..."}else{"Unavailable"})}
  var label:string=string.new()
  if not clip.enabled {label=string.copy("Disabled")}
  else if timeline_media.effective_speed(document,clip)==0.0 {label=string.copy("Held")}
  else if not editor.track_audible(document,clip.track) {
    let muted:bool=match editor.track_slot(document,clip.track) {none=>true,some(slot)=>{
      struct.get(array.borrow(struct.borrow(document,field=tracks),slot),field=muted)},}
    label=string.copy(if muted {"Muted"}else{"Solo excluded"})}
  else if editor.track_gain(document,clip.track)==0.0 {label=string.copy("Gain 0")}
  if state.waveform_pending!=0 {
    if str.len(label)!=0 {string.append(label," / ")}
    string.append(label,"Loading waveform...")}
  label
}
