// A latest-request mailbox isolates the persistent worker and its process handle on one thread.
// Requests/results publish by atomic rename; two image slots prevent partial frame reads.
module genesis.preview
import "chrome.ai" as chrome
import std.draw as draw
import std.editor as editor
import std.editor_io as editor_io
import std.files as files
import std.math as math
import std.path as path
import std.tasks as tasks
import std.text as text
import std.channel as channel
import "preview_link.ai" as link
import "app.ai" as app
import "provider.ai" as provider
import "timeline_media.ai" as timeline_media

fn program_signature(document: ref<editor.Document>) -> string effects {alloc} {
  var copy: editor.Document = editor.copy_document(document)
  struct.set(copy, 0, field=monitor_source)
  let _ = struct.replace(copy, editor.Transport {playing: false, frame: 0, mark_in: -1,
    mark_out: -1, rate: 1.0, looping: false}, field=monitor)
  match editor_io.encode(copy) {ok(value) => value, err(_) => string.new(),}
}

pub type Images = struct {pictures: array<draw.Surface>, source_ns: u64, plan_ns: u64, program_ns: u64,
  source_key: string, source_held: bool, source_frame: i64, program_frame: i64}
pub fn images(state: ref<app.App>, width: u32, height: u32) -> array<draw.Surface>
    effects {alloc,fs.meta,fs.read,fs.write,process,net,time} {
  var reply: Images = images_measured(state,width,height,false)
  struct.replace(reply,array.new(),field=pictures)
}
// Viewport strip requests ignore transient transport and selection changes.
// Their own decoder can finish while monitor playback advances independently.
pub fn strips_signature(document: ref<editor.Document>) -> string effects {alloc} {
  var copy: editor.Document = editor.copy_document(document)
  struct.set(copy,0,field=monitor_source)
  struct.set(copy,editor.transport(),field=monitor)
  struct.set(copy,editor.transport(),field=program)
  let _ = editor.clear_selection(copy)
  match editor_io.encode(copy) {ok(value)=>value,err(_)=>string.new(),}
}
pub fn images_measured(state: ref<app.App>, width: u32, height: u32, profile: bool) -> Images effects {alloc, fs.meta, fs.read, fs.write, process, net, time} {
  images_with_source(state,width,height,profile,"")
}
fn images_with_source(state: ref<app.App>, width: u32, height: u32, profile: bool, previous_source: str)
    -> Images effects {alloc,fs.meta,fs.read,fs.write,process,net,time} {
  var out: array<draw.Surface> = array.new()
  let document: ref<editor.Document> = struct.borrow(state, field=document)
  let monitor_source: u64 = document.monitor_source
  let monitor_frame: i64 = struct.get(struct.borrow(document, field=monitor), field=frame)
  let program_frame: i64 = editor.playhead(document)
  var source_path: string = string.new()
  if monitor_source != 0 {
    match editor.source_slot(document, monitor_source) {
      some(slot) => {
        let source: ref<editor.Source> = array.borrow(struct.borrow(document, field=sources), slot)
        if source.has_video {
          source_path = string.copy(str.view(struct.borrow(source, field=path)))
        }
      },
      none => { },
    }
  }
  // Which sources are under the playhead, bottom lane first.
  var visible: array<string> = array.new()
  var index: u64 = 0
  loop {
    if index >= editor.clip_count(document) { break }
    match editor.clip_at(document, index) {
      none => { },
      some(value) => {
        if value.enabled and value.start <= program_frame and editor.clip_end(value) > program_frame {
          match editor.source_slot(document, value.source) {
            some(slot) => { array.push(visible, string.copy(str.view(struct.borrow(
              array.borrow(struct.borrow(document, field=sources), slot), field=path)))) },
            none => { },
          }
        }
      },
    }
    index = index + 1
  }
  let source_begin: u64 = if profile {time.monotonic_ns()}else{0}
  var key_fields: array<string> = [provider.wire_path(str.view(source_path)),string.from_int(monitor_frame),
    string.from_int(width),string.from_int(height)]
  var source_key: string = text.join(key_fields,"\t")
  let source_held: bool = str.eq(str.view(source_key),previous_source)
  if not source_held and str.len(str.view(source_path)) != 0 {
    var shot: provider.Frame = provider.source_frame(struct.borrow(state, field=provider),
      str.view(source_path), monitor_frame, width, height)
    if not shot.ok {source_key=string.new()}
    array.push(out, provider.take_pixels(shot))
  } else {
    array.push(out, draw.empty_surface())
  }
  provider.set_profile(struct.borrow(state,field=provider),profile)
  let program_begin: u64 = if profile {time.monotonic_ns()}else{0}
  let source_ns: u64 = if profile {program_begin-source_begin}else{0}
  var plan_ns: u64 = 0
  var program: provider.Frame = if struct.get(struct.borrow(state, field=provider), field=kind) ==
      provider.kind_gcompose() {
    let output: string = provider.preview_path(struct.borrow(state, field=provider))
    var frame_cache: timeline_media.RenderCache = timeline_media.render_cache(
      struct.borrow(state, field=fonts))
    timeline_media.configure_monitor_preview(document, frame_cache, width, height)
    match timeline_media.frame_plan(document, program_frame, "PREVIEW", str.view(output),
      str.view(output), frame_cache) {
      ok(plan_lines) => {
        var lines: array<string> = plan_lines
        // Planning interns editor property names; compare after that deterministic
        // preparation so incoming mailbox documents and direct calls use the same key.
        let signature: string = program_signature(document)
        if profile {plan_ns=time.monotonic_ns()-program_begin}
        var picture: provider.Frame = match provider.cached_program(struct.borrow(state, field=provider), str.view(signature), width, height) {
          some(held) => held,
          none => provider.program_plan(struct.borrow(state, field=provider),
            lines, width, height, frame_cache.width, frame_cache.height),
        }
        timeline_media.cleanup_plan(str.view(output))
        if picture.ok { provider.hold_program(struct.borrow(state, field=provider), str.view(signature)) }
        picture
      },
      err(problem) => {
        app.set_status(state, str.view(problem))
        var empty: array<string> = array.new()
        provider.program_frame(struct.borrow(state, field=provider), empty,
          program_frame, width, height)
      },
    }
  } else { provider.program_frame(struct.borrow(state, field=provider), visible,
    program_frame, width, height) }
  let program_ns: u64 = if profile {time.monotonic_ns()-program_begin-plan_ns}else{0}
  array.push(out, provider.take_pixels(program))
  Images {pictures:out,source_ns:source_ns,plan_ns:plan_ns,program_ns:program_ns,source_key:source_key,source_held:source_held,source_frame:monitor_frame,program_frame:program_frame}
}

// Fill the waveform cache for every clip with audio, including video clips. This is the only place the application asks
// the provider for envelopes, so painting never does media work.
pub fn waveforms(state: ref<app.App>) -> u64 effects {alloc, fs.meta, fs.read, fs.write, process, time} {
  match waveforms_for_request(state,"",0) {
    ok(value)=>value,err(problem)=>{provider.note_failure(struct.borrow(state,field=provider),problem)
      0},
  }
}
pub fn waveforms_for_request(state: ref<app.App>, root: str, id: u64) -> result<u64,string>
    effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  waveforms_in_range(state,root,id,false,0,0)
}
pub fn waveforms_for_viewport(state: ref<app.App>, root: str, id: u64, start: i64, span: i64)
    -> result<u64,string> effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  if start < 0 or span <= 0 or span > 9223372036854775807-start {
    return result.err("[GA_TIMELINE_RANGE] Invalid waveform viewport")
  }
  waveforms_in_range(state,root,id,true,start,start+span)
}
fn waveforms_in_range(state: ref<app.App>, root: str, id: u64, visible: bool, first: i64, last: i64)
    -> result<u64,string> effects {alloc,fs.meta,fs.read,fs.write,process,time} {
  var wanted: array<u64> = array.new()
  var widths: array<u64> = array.new()
  var document: editor.Document = editor.copy_document(struct.borrow(state, field=document))
  var index: u64 = 0
  loop {
    if index >= editor.clip_count(document) { break }
    match editor.clip_at(document, index) {
      none => { },
      some(value) => {
        if visible and (editor.clip_end(value) <= first or value.start >= last) {index=index+1
          continue}
        if value.owner == document.active and chrome.clip_has_audio(document, value.id) {
          array.push(wanted,value.id)
          let widened: u64 = cast.sat(value.length)
          let buckets: u64 = if widened/3 > 512 {512}else{widened/3}
          array.push(widths,if buckets < 8 {8}else{buckets})
        }
      },
    }
    index = index + 1
  }
  var filled: u64 = 0
  var at: u64 = 0
  loop {
    if at >= array.len(wanted) { break }
    let value: editor.Clip = option.unwrap(editor.clip(document,array.get(wanted,at)))
    let buckets: u64 = array.get(widths,at)
    // The strip worker retains its cache across viewport requests. Only a
    // content/media generation or changed time mapping needs new audio work.
    match app.waveform_slot(state,value.id) {
      some(slot)=>{
        let cached: ref<app.Waveform> = array.borrow(struct.borrow(state,field=waveforms),slot)
        if cached.document_revision == state.document_revision and cached.revision == state.media_revision and
            cached.source == value.source and cached.length == value.length and
            cached.first == timeline_media.source_frame(document,value,value.start) and
            cached.last == timeline_media.source_frame(document,value,value.start+value.length-1) and
            array.len(struct.borrow(cached,field=peaks)) == buckets {
          filled=filled+1
          at=at+1
          continue
        }
      },none=>{},
    }
      let engine: ref<provider.Provider> = struct.borrow(state,field=provider)
      var peaks: array<f64> = if not value.enabled or not editor.track_audible(document,value.track) or
          timeline_media.effective_speed(document,value) == 0.0 {
        // Waveforms show the authored clip's actual contribution, including
        // mute/solo/disabled silence and held pictures without advancing sound.
        var silence: array<f64> = array.new()
        var k: u64 = 0
        loop {if k >= buckets {break}
          array.push(silence,0.0)
          k=k+1
        }
        silence
      }else if engine.kind == provider.kind_fake() {
        provider.envelope(engine,text.concat("processed:",string.from_int(value.id)),buckets)
      }else{
        if engine.kind != provider.kind_gcompose() {return result.err("[GA_AUDIO_CLIP_ENV] Processed stereo waveforms require the native worker")}
        try timeline_media.clip_envelope(document,value,buckets,provider.worker_path(engine),
          provider.audition_path(engine),root,id)
      }
      app.set_waveform(state,value.id,peaks,timeline_media.source_frame(document,value,value.start),
        timeline_media.source_frame(document,value,value.start+value.length-1),state.media_revision)
      filled=filled+1
      at=at+1
  }
  result.ok(filled)
}


pub type Config = struct {worker: string, ffprobe: string, scratch: string, kind: u32, fonts: array<string>, events: channel.Ticket, profile: bool, pixel_stream: bool, strips_only: bool}
pub fn config(state: ref<app.App>, root: str, events: channel.Ticket own) -> Config effects {alloc} {
  let kind: u32 = struct.get(struct.borrow(state, field=provider), field=kind)
  let worker: string = provider.worker_path(struct.borrow(state, field=provider))
  let ffprobe: string = string.copy(str.view(struct.borrow(struct.borrow(state, field=provider), field=ffprobe)))
  var fonts: array<string> = array.new()
  var i: u64 = 0
  loop { if i >= array.len(struct.borrow(state, field=fonts)) { break }
    array.push(fonts, string.copy(str.view(array.borrow(struct.borrow(state, field=fonts), i))))
    i = i + 1
  }
  Config {worker: worker, ffprobe: ffprobe, scratch: string.copy(root), kind: kind, fonts: fonts, events: events, profile: false, pixel_stream: false,strips_only:false}
}

fn publish_checked(root: str, name: str, value: str) -> bool effects {alloc, fs.write} {
  let output: string = path.join(root, name)
  let temp: string = text.concat(str.view(output), ".tmp")
  match files.write_text(str.view(temp), value) { err(_) => false,
    ok(_) => match files.rename(str.view(temp), str.view(output)) {ok(_)=>true,err(_)=>false,}, }
}
fn publish(root: str, name: str, value: str) -> unit effects {alloc, fs.write} {
  let _ = publish_checked(root,name,value)
  ()
}
fn number(root: str, name: str) -> u64 effects {alloc, fs.read} {
  match files.read_text(str.view(path.join(root, name))) {
    err(_) => 0, ok(value) => match text.parse_u64(str.view(text.trim(str.view(value)))) { none => 0, some(value) => value, },
  }
}
// The presenter supplies eligibility from its freshly configured request queue.
// Connection-wide failures have no retired picture identity to discard.
pub fn current_failure(transport: ref<link.Link>, request_current: bool) -> option<string> effects {alloc} {
  let detail: str = str.view(struct.borrow(transport,field=error))
  if str.len(detail) == 0 {return option.none()}
  if not transport.closed and transport.error_generation != 0 and not request_current {return option.none()}
  option.some(string.copy(detail))
}
// request.id is committed before the command wake. Check that authoritative
// marker after decoding without consuming the next queued frame command.
pub fn fail_current(peer: ref<link.Peer>, root: str, generation: u64, detail: str)
    -> bool effects {alloc,fs.meta,fs.read,net,time} {
  if tasks.requested_at(path.join(root,"stop")) or number(root,"request.id") != generation {return false}
  link.fail(peer,generation,detail)
  true
}
pub fn reset(root: str) -> unit effects {alloc, fs.write} {
  let _ = files.remove(str.view(path.join(root, "stop")))
  publish(root, "request.id", "0")
  publish(root, "ready.id", "0")
  publish(root, "waveforms.id", "0")
  publish(root, "thumbnails.id", "0")
  ()
}
pub fn request(root: str, document: str, generation: u64) -> bool effects {alloc, fs.write} {
  request_viewport(root, document, generation, 0, 2.4, 450)
}
pub fn request_viewport(root: str, document: str, generation: u64, start: i64, zoom: f64, span: i64) -> bool effects {alloc, fs.write} {
  request_quality(root, document, generation, start, zoom, span, 480, 270)
}
pub fn request_quality(root: str, document: str, generation: u64, start: i64, zoom: f64,
    span: i64, width: u32, height: u32) -> bool effects {alloc, fs.write} {
  request_revision(root, document, generation, start, zoom, span, width, height, 0)
}
pub fn request_revision(root: str, document: str, generation: u64, start: i64, zoom: f64,
    span: i64, width: u32, height: u32, media_revision: u64) -> bool effects {alloc, fs.write} {
  request_document_revision(root,document,generation,start,zoom,span,width,height,media_revision,0)
}
pub fn request_document_revision(root: str, document: str, generation: u64, start: i64, zoom: f64,
    span: i64, width: u32, height: u32, media_revision: u64, document_revision: u64)
    -> bool effects {alloc, fs.write} {
  let geometry: string = text.concat(str.view(string.from_int(start)), text.concat("\t",
    text.concat(str.view(string.from_float(zoom)), text.concat("\t", str.view(string.from_int(span))))))
  let sized: string = text.concat(str.view(geometry), text.concat("\t", text.concat(str.view(string.from_int(width)),
    text.concat("\t", str.view(string.from_int(height))))))
  var versioned: string = text.concat(str.view(sized), text.concat("\t", str.view(string.from_int(media_revision))))
  string.append(versioned,"\t")
  string.append(versioned,string.from_int(document_revision))
  // Document, viewport, quality and revision are one atomic snapshot. A reader
  // cannot pair an old generation with the next drag's geometry or document.
  let generation_text: string = string.from_int(generation)
  var snapshot: string = text.concat(str.view(generation_text),"\t")
  string.append(snapshot,str.view(versioned))
  string.append(snapshot,"\n")
  string.append(snapshot,document)
  if not publish_checked(root,"request.air",str.view(snapshot)) {return false}
  publish_checked(root,"request.id",str.view(generation_text))
}
// Retain an immutable project snapshot across moving monitor requests. Only time
// travels on the command lane until content, source selection, mode, media or
// display geometry changes. The snapshot generation also survives a coalesced
// initial wake: the worker can load that exact base before applying the newest tick.
pub fn request_frame(state: ref<app.App>, root: str, transport: ref<link.Link>, generation: u64,
    content: str, program_frame: i64, source_frame: i64, width: u32, height: u32)
    -> bool effects {alloc,fs.write,net,time} {
  // Viewport strip lanes retain full geometry snapshots through request_revision.
  if not transport.pixel_stream {return false}
  let document: ref<editor.Document> = struct.borrow(state,field=document)
  var key: string = string.copy(content)
  var fields: array<string> = [string.from_int(document.monitor_source),
    string.from_int(if editor.playing(document) {1}else{0}),
    string.from_int(if struct.get(struct.borrow(document,field=monitor),field=playing) {1}else{0}),
    string.from_int(state.media_revision),string.from_int(width),string.from_int(height)]
  string.append(key,"\n")
  string.append(key,text.join(fields,"\t"))
  if transport.snapshot_generation == 0 or not str.eq(key,struct.borrow(transport,field=snapshot_key)) {
    var snapshot: editor.Document = editor.copy_document(document)
    let _ = editor.seek(snapshot,program_frame)
    let _ = editor.seek_monitor(snapshot,source_frame)
    let encoded: string = match editor_io.encode(snapshot) {ok(value)=>value,err(_)=>{return false},}
    if not request_revision(root,encoded,generation,0,2.4,450,width,height,state.media_revision) {return false}
    if not match link.wake(transport,false) {ok(_)=>true,err(_)=>false,} {return false}
    struct.set(transport,generation,field=snapshot_generation)
    let _ = struct.replace(transport,key,field=snapshot_key)
    return true
  }
  // The marker remains the authoritative retirement signal while a slow consumer
  // holds pixel credit. It contains no project data and publishes before the tick.
  if not publish_checked(root,"request.id",string.from_int(generation)) {return false}
  match link.frame(transport,generation,transport.snapshot_generation,program_frame,source_frame,state.media_revision) {
    ok(_)=>true,err(_)=>false,
  }
}
pub fn stop(root: str) -> unit effects {alloc, fs.write} { let _ = files.write_text(str.view(path.join(root, "stop")), "stop")
 () }
pub fn completed(root: str) -> u64 effects {alloc, fs.read} { number(root, "ready.id") }
pub fn thumbnails_completed(root: str) -> u64 effects {alloc, fs.read} { number(root, "thumbnails.id") }
pub fn waveforms_completed(root: str) -> u64 effects {alloc, fs.read} { number(root, "waveforms.id") }
pub fn error(root: str) -> string effects {alloc, fs.read} {
  match files.read_text(str.view(path.join(root, "error.txt"))) { ok(value) => value, err(_) => string.new(), }
}
fn image_file(root: str, id: u64, which: str) -> string effects {alloc} {
  path.join(root, str.view(text.concat(which, text.concat(str.view(string.from_int(id % 2)), ".rgba"))))
}
fn write_image(root: str, id: u64, which: str, image: ref<draw.Surface>) -> bool effects {alloc, fs.write} {
  let output: string = image_file(root, id, which)
  let temp: string = text.concat(str.view(output), ".tmp")
  let pixels: view<byte> = array.view(struct.borrow(image, field=pixels))
  match files.write_bytes(str.view(temp), pixels) { err(_) => false,
    ok(_) => match files.rename(str.view(temp), str.view(output)) {ok(_)=>true,err(_)=>false,}, }
}
fn image_size(root: str, id: u64) -> array<u32> effects {alloc, fs.read} {
  let filename: string = image_file(root, id, "size")
  let content: string = match files.read_text(str.view(filename)) {ok(value) => value, err(_) => string.copy("480\t270"),}
  var fields: array<string> = text.split(str.view(content), "\t")
  if array.len(fields) != 2 { return [480, 270] }
  let width: u32 = match text.parse_u64(str.view(array.borrow(fields, 0))) {some(value) => cast.sat(value), none => 480,}
  let height: u32 = match text.parse_u64(str.view(array.borrow(fields, 1))) {some(value) => cast.sat(value), none => 270,}
  [width, height]
}
pub fn read_images(root: str, id: u64) -> array<draw.Surface> effects {alloc, fs.read} {
  var out: array<draw.Surface> = array.new()
  let marker: string = text.concat("frame",text.concat(str.view(string.from_int(id % 2)),".id"))
  if number(root,str.view(marker)) != id { return out }
  var size: array<u32> = image_size(root, id)
  var i: u64 = 0
  loop { if i == 2 { break }
    let name: str = if i == 0 { "source" } else { "program" }
    var image: draw.Surface = match files.read_bytes(str.view(image_file(root, id, name))) {
      err(_) => draw.empty_surface(),
      ok(raw) => match draw.surface_from_rgba(array.get(size, 0), array.get(size, 1), bytes.view(raw)) { none => draw.empty_surface(), some(value) => value, },
    }
    array.push(out, image)
 i = i + 1
  }
  // A reused slot may have changed while its two files were being read. The
  // consumer retains its held picture and takes the next ready event instead.
  if number(root,str.view(marker)) != id {return array.new()}
  out
}
pub fn write_waveforms(state: ref<app.App>, root: str) -> unit effects {alloc, fs.write} {
  var lines: string = text.concat("WAVEFORMS 2\t",string.from_int(state.document_revision))
  string.append(lines,"\t")
  string.append(lines,string.from_int(state.media_revision))
  string.append(lines,"\n")
  var i: u64 = 0
  loop { if i >= array.len(struct.borrow(state, field=waveforms)) { break }
    let wave: ref<app.Waveform> = array.borrow(struct.borrow(state, field=waveforms), i)
    string.append(lines, str.view(string.from_int(wave.clip)))
    var mapping: array<string> = [string.from_int(wave.source),string.from_int(wave.length),string.from_int(wave.first),string.from_int(wave.last),string.from_int(wave.revision),string.from_int(wave.document_revision)]
    string.append(lines,"\t")
    string.append(lines,str.view(text.join(mapping,"\t")))
    var k: u64 = 0
    loop { if k >= array.len(struct.borrow(wave, field=peaks)) { break }
      string.append(lines, "\t")
 string.append(lines, str.view(string.from_float(array.get(struct.borrow(wave, field=peaks), k))))
      k = k + 1
    }
    string.append(lines, "\n")
 i = i + 1
  }
  publish(root, "waveforms.tsv", str.view(lines))
}
pub fn read_waveforms(state: ref<app.App>, root: str, id: u64) -> bool effects {alloc, fs.read} {
  if number(root,"waveforms.id") != id {return false}
  let content: string = match files.read_text(str.view(path.join(root, "waveforms.tsv"))) { ok(value) => value, err(_) => { return false }, }
  if number(root,"waveforms.id") != id {return false}
  var rows: array<string> = text.split(str.view(content), "\n")
  let versioned: bool = str.starts_with(content,"WAVEFORMS 2\t")
  if versioned {
    var header: array<string> = text.split(array.borrow(rows,0),"\t")
    if array.len(header) != 3 {return false}
    if match text.parse_u64(array.borrow(header,1)) {some(value)=>value != state.document_revision,none=>true,} or
       match text.parse_u64(array.borrow(header,2)) {some(value)=>value != state.media_revision,none=>true,} {return false}
  }
  var incoming: array<app.Waveform> = array.new()
  var i: u64 = 0
  loop { if i >= array.len(rows) { break }
    var fields: array<string> = text.split(str.view(array.borrow(rows, i)), "\t")
    if array.len(fields) > 6 {
      let clip: u64 = match text.parse_u64(str.view(array.borrow(fields, 0))) { some(value) => value, none => 0, }
      let source: u64 = match text.parse_u64(str.view(array.borrow(fields,1))) {some(value)=>value,none=>0,}
      let length: i64 = match text.parse_i64(str.view(array.borrow(fields,2))) {some(value)=>value,none=>0,}
      let first: i64 = match text.parse_i64(str.view(array.borrow(fields,3))) {some(value)=>value,none=>-1,}
      let last: i64 = match text.parse_i64(str.view(array.borrow(fields,4))) {some(value)=>value,none=>-1,}
      let revision: u64 = match text.parse_u64(str.view(array.borrow(fields,5))) {some(value)=>value,none=>0,}
      let document_revision: u64 = if versioned {
        if array.len(fields) <= 7 {return false}
        match text.parse_u64(array.borrow(fields,6)) {some(value)=>value,none=>{return false},}
      }else{state.document_revision}
      let current: editor.Clip = match editor.clip(struct.borrow(state,field=document),clip) {some(value)=>value,none=>{i=i+1
        continue},}
      if revision != state.media_revision or document_revision != state.document_revision or
          (not versioned and current.nested != 0) or current.source != source or current.length != length or
          timeline_media.source_frame(struct.borrow(state,field=document),current,current.start) != first or
          timeline_media.source_frame(struct.borrow(state,field=document),current,current.start+current.length-1) != last {i=i+1
        continue}
      var peaks: array<f64> = array.new()
 var k: u64 = if versioned {7}else{6}
      loop { if k >= array.len(fields) { break }
        let peak: f64 = match text.parse_f64(str.view(array.borrow(fields,k))) {some(value)=>value,none=>{return false},}
        if not math.is_finite(peak) or peak < 0.0 {return false}
        array.push(peaks,peak)
 k = k + 1
      }
      if clip != 0 {array.push(incoming,app.Waveform {clip:clip,source:source,length:length,first:first,last:last,
        revision:revision,document_revision:document_revision,peaks:peaks})}
    }
    i = i + 1
  }
  if number(root,"waveforms.id") != id {return false}
  i=0
  loop {if i >= array.len(incoming) {break}
    let wave: ref<app.Waveform> = array.borrow(incoming,i)
    app.set_waveform(state,wave.clip,struct.replace(wave,array.new(),field=peaks),wave.first,wave.last,wave.revision)
    i=i+1
  }
  true
}

pub fn compound_thumbnail(state: ref<app.App>, document: ref<editor.Document>,
    clip: editor.Clip, owner_frame: i64) -> result<provider.Frame,string>
    effects {alloc,fs.meta,fs.read,fs.write,process,net,time} {
  let prefix: string = text.concat(provider.preview_path(struct.borrow(state,field=provider)),".strip")
  var cache: timeline_media.RenderCache = timeline_media.render_cache(struct.borrow(state,field=fonts))
  timeline_media.configure_monitor_preview(document,cache,80,45)
  let planned: result<array<string>,string> = timeline_media.clip_picture_plan(document,clip,
    owner_frame,"PREVIEW",str.view(prefix),str.view(prefix),cache)
  var lines: array<string> = match planned {
    err(problem)=>{timeline_media.cleanup_plan(str.view(prefix))
      return result.err(problem)},ok(value)=>value,
  }
  var shot: provider.Frame = provider.program_plan(struct.borrow(state,field=provider),
    lines,80,45,cache.width,cache.height)
  timeline_media.cleanup_plan(str.view(prefix))
  if not shot.ok {return result.err(string.copy(str.view(struct.borrow(shot,field=detail))))}
  result.ok(shot)
}

fn write_thumbnails(state: ref<app.App>, root: str, id: u64, geometry: str) -> result<unit,string> effects {alloc, fs.meta, fs.read, fs.write, process, net, time} {
  var fields: array<string> = text.split(geometry, "\t")
  if array.len(fields) < 3 { return result.ok(()) }
  let start: i64 = match text.parse_i64(str.view(array.borrow(fields, 0))) {some(value) => value, none => 0,}
  let zoom: f64 = match text.parse_f64(str.view(array.borrow(fields, 1))) {some(value) => value, none => 2.4,}
  let span: i64 = match text.parse_i64(str.view(array.borrow(fields, 2))) {some(value) => value, none => 450,}
  if zoom <= 0.0 or span <= 0 { return result.ok(()) }
  // Reserve the strip before reusing a slot. Readers keep the previous owned
  // pictures until the complete manifest and matching generation are committed.
  if not publish_checked(root,"thumbnails.id","0") {return result.err("[GA_TIMELINE_PUBLISH] Cannot reserve thumbnail generation")}
  // Match the painted, aspect-fitted tile width at this lane height. A fixed
  // 96px sampling interval left most of a 46px-high video lane without pictures.
  let tile_width: f64 = 80.0 * math.max(1.0, app.track_height(state) - 20.0) / 45.0
  let step: i64 = cast.sat(math.max(1.0, math.ceil((tile_width + 2.0) / zoom)))
  var doc: editor.Document = editor.copy_document(struct.borrow(state, field=document))
  var lines: string = string.new()
  var total: u64 = 0
  var i: u64 = 0
  loop { if i >= editor.clip_count(doc) or total >= 32 { break }
    let clip: editor.Clip = option.unwrap(editor.clip_at(doc, i))
    i = i + 1
    if clip.owner != doc.active or editor.track_kind(doc, clip.track) != editor.track_video() { continue }
    var filename: string = string.new()
    if clip.nested == 0 {
      let source_slot: u64 = match editor.source_slot(doc, clip.source) {none => { continue }, some(value) => value,}
      let source: ref<editor.Source> = array.borrow(struct.borrow(doc, field=sources), source_slot)
      if not source.has_video or not source.online { continue }
      let _ = ref.swap(filename,string.copy(str.view(struct.borrow(source, field=path))))
    }
    let last: i64 = if start + span < clip.start + clip.length { start + span } else { clip.start + clip.length }
    var at: i64 = if start > clip.start { start } else { clip.start }
    // Anchor the strip to the clip so a small scroll reuses the same samples.
    at = clip.start + ((at - clip.start) / step) * step
    loop { if at >= last or total >= 32 { break }
      if number(root, "request.id") != id { return result.ok(()) }
      let sample: i64 = timeline_media.source_frame(doc, clip, at)
      var shot: provider.Frame = if clip.nested != 0 {
        try compound_thumbnail(state,doc,clip,at)
      }else{provider.source_frame(struct.borrow(state, field=provider), str.view(filename), sample, 80, 45)}
      if number(root,"request.id") != id {return result.ok(())}
      if shot.ok {
        let name: string = text.concat("thumb-", text.concat(str.view(string.from_int(id % 2)), text.concat("-", str.view(string.from_int(total)))))
        var pixels: draw.Surface = provider.take_pixels(shot)
        if not write_image(root,id,str.view(name),pixels) {return result.err("[GA_TIMELINE_PUBLISH] Cannot publish thumbnail pixels")}
        string.append(lines, str.view(string.from_int(clip.id)))
        string.append(lines, "\t")
        string.append(lines, str.view(string.from_int(at)))
        string.append(lines, "\t")
        string.append(lines, str.view(name))
        string.append(lines, "\t")
        string.append(lines, str.view(string.from_int(clip.source)))
        string.append(lines, "\t")
        string.append(lines, str.view(string.from_int(sample)))
        string.append(lines, "\t")
        let revision_text: string = if array.len(fields) >= 6 {string.copy(str.view(array.borrow(fields,5)))}else{string.copy("0")}
        string.append(lines,str.view(revision_text))
        string.append(lines,"\t")
        let document_revision_text: string = if array.len(fields) >= 7 {
          string.copy(str.view(array.borrow(fields,6)))
        }else{string.copy("0")}
        string.append(lines,str.view(document_revision_text))
        string.append(lines, "\n")
        total = total + 1
      }
      at = at + step
    }
  }
  if number(root,"request.id") != id {return result.ok(())}
  if not publish_checked(root,"thumbnails.tsv",str.view(lines)) or
      not publish_checked(root,"thumbnails.id",string.from_int(id)) {
    return result.err("[GA_TIMELINE_PUBLISH] Cannot commit thumbnail generation")
  }
  result.ok(())
}
pub fn read_thumbnails(state: ref<app.App>, root: str, id: u64) -> bool effects {alloc, fs.read} {
  if number(root,"thumbnails.id") != id {return false}
  let content: string = match files.read_text(path.join(root, "thumbnails.tsv")) {ok(value) => value, err(_) => { return false },}
  var rows: array<string> = text.split(str.view(content), "\n")
  var thumbs: array<app.Thumbnail> = array.new()
  var i: u64 = 0
  loop { if i >= array.len(rows) { break }
    var fields: array<string> = text.split(str.view(array.borrow(rows, i)), "\t")
    i = i + 1
    if array.len(fields) != 6 and array.len(fields) != 7 { continue }
    let clip: u64 = match text.parse_u64(str.view(array.borrow(fields, 0))) {some(value) => value, none => 0,}
    let frame: i64 = match text.parse_i64(str.view(array.borrow(fields, 1))) {some(value) => value, none => 0,}
    let source: u64 = match text.parse_u64(str.view(array.borrow(fields,3))) {some(value)=>value,none=>{continue},}
    let source_frame: i64 = match text.parse_i64(str.view(array.borrow(fields,4))) {some(value)=>value,none=>{continue},}
    let revision: u64 = match text.parse_u64(str.view(array.borrow(fields,5))) {some(value)=>value,none=>{continue},}
    let document_revision: u64 = if array.len(fields) == 7 {
      match text.parse_u64(str.view(array.borrow(fields,6))) {some(value)=>value,none=>{continue},}
    }else{0}
    let current: editor.Clip = match editor.clip(struct.borrow(state,field=document),clip) {some(value)=>value,none=>{continue},}
    if revision != state.media_revision or current.owner != struct.get(struct.borrow(state,field=document),field=active) or
        (current.nested != 0 and document_revision != state.document_revision) or
        current.source != source or frame < current.start or frame >= current.start+current.length or
        timeline_media.source_frame(struct.borrow(state,field=document),current,frame) != source_frame {continue}
    let filename: string = image_file(root, id, str.view(array.borrow(fields, 2)))
    let raw: bytes = match files.read_bytes(str.view(filename)) {ok(value) => value, err(_) => { continue },}
    var pixels: draw.Surface = match draw.surface_from_rgba(80, 45, bytes.view(raw)) {some(value) => value, none => { continue },}
    array.push(thumbs, app.Thumbnail {clip: clip, frame: frame, source:source, source_frame:source_frame,
      revision:revision,document_revision:document_revision,pixels: pixels})
  }
  if number(root,"thumbnails.id") != id {return false}
  let _ = struct.replace(state, thumbs, field=thumbnails)
  true
}

pub fn run(config: Config own) -> bool effects {alloc, fs.meta, fs.read, fs.write, net, process, time} {
  var owned: Config = config
  var wake: link.Peer = match link.peer(struct.borrow(owned,field=events)) {ok(value)=>value,err(_)=>{return false},}
  let root: string = string.copy(str.view(struct.borrow(owned, field=scratch)))
  var engine: provider.Provider = if owned.kind == provider.kind_gcompose() {
    provider.gcompose(str.view(struct.borrow(owned, field=worker)), str.view(root))
  } else if owned.kind == provider.kind_ffmpeg() {
    provider.native(str.view(struct.borrow(owned, field=worker)), str.view(struct.borrow(owned, field=ffprobe)), str.view(root))
  } else { provider.fake(str.view(root)) }
  var state: app.App = app.app(engine)
  let _ = struct.replace(state, struct.replace(owned, array.new(), field=fonts), field=fonts)
  var seen: u64 = 0
  var snapshot_generation: u64 = 0
  var snapshot_geometry: string = string.new()
  var media_revision: u64 = 0
  var held_source: string = string.new()
  loop {
    if tasks.requested_at(str.view(path.join(str.view(root), "stop"))) { break }
    if not link.next(wake) { break }
    let request_begin: u64 = if owned.profile {time.monotonic_ns()}else{0}
    let id: u64 = number(str.view(root), "request.id")
    if id == 0 or id == seen { continue }
    var base: u64 = id
    var program_frame: i64 = 0
    var source_frame: i64 = 0
    var tick_revision: u64 = 0
    let tick: bool = wake.command_kind == 8
    if tick {
      var fields: array<string> = text.split(struct.borrow(wake,field=command),"\t")
      if array.len(fields) != 5 {
        let _ = fail_current(wake,str.view(root),id,"[GA_PREVIEW_REQUEST] Invalid frame command")
        continue
      }
      let carried: u64 = match text.parse_u64(array.borrow(fields,0)) {some(value)=>value,none=>0,}
      if carried != id {continue}
      base=match text.parse_u64(array.borrow(fields,1)) {some(value)=>value,none=>0,}
      program_frame=match text.parse_i64(array.borrow(fields,2)) {some(value)=>value,none=>{continue},}
      source_frame=match text.parse_i64(array.borrow(fields,3)) {some(value)=>value,none=>{continue},}
      tick_revision=match text.parse_u64(array.borrow(fields,4)) {some(value)=>value,none=>{continue},}
      if base == 0 or base > id {
        let _ = fail_current(wake,str.view(root),id,"[GA_PREVIEW_REQUEST] Invalid frame snapshot identity")
        continue
      }
    }
    var geometry: string = string.copy(snapshot_geometry)
    if not tick or base != snapshot_generation {
      let data: string = match files.read_text(str.view(path.join(str.view(root), "request.air"))) { ok(value) => value, err(_) => {
        let _ = fail_current(wake,str.view(root),id,"[GA_PREVIEW_REQUEST] Cannot read the requested project snapshot")
        continue }, }
      let boundary: u64 = match str.find(str.view(data),"\n") {some(value)=>value,none=>{
        let _ = fail_current(wake,str.view(root),id,"[GA_PREVIEW_REQUEST] Invalid preview snapshot header")
        continue},}
      let header: str = str.slice(str.view(data),0,boundary)
      let separator: u64 = match str.find(header,"\t") {some(value)=>value,none=>{
        let _ = fail_current(wake,str.view(root),id,"[GA_PREVIEW_REQUEST] Invalid preview snapshot generation")
        continue},}
      let carried_id: u64 = match text.parse_u64(str.slice(header,0,separator)) {some(value)=>value,none=>0,}
      if carried_id != base {continue}
      geometry = string.copy(str.slice(header,separator+1,boundary))
      let document: editor.Document = match editor_io.decode(str.slice(str.view(data),boundary+1,str.len(str.view(data)))) {
        ok(value) => value, err(_) => {
          let _ = fail_current(wake,str.view(root),id,"[GA_PREVIEW_REQUEST] Cannot decode the requested project snapshot")
          continue }, }
      if number(str.view(root), "request.id") != id { continue }
      let _ = struct.replace(state, document, field=document)
      snapshot_generation=base
      let _ = ref.swap(snapshot_geometry,string.copy(geometry))
    }
    if number(str.view(root), "request.id") != id {continue}
    seen = id
    let _ = struct.replace(struct.borrow(state, field=provider), string.new(), field=last_error)
    var dimensions: array<string> = text.split(str.view(geometry), "\t")
    let width: u32 = if array.len(dimensions) >= 5 { match text.parse_u64(str.view(array.borrow(dimensions, 3))) {some(value) => cast.sat(value), none => 480,} } else { 480 }
    let height: u32 = if array.len(dimensions) >= 5 { match text.parse_u64(str.view(array.borrow(dimensions, 4))) {some(value) => cast.sat(value), none => 270,} } else { 270 }
    let revision: u64 = if array.len(dimensions) >= 6 { match text.parse_u64(str.view(array.borrow(dimensions, 5))) {some(value) => value, none => 0,} } else { 0 }
    if tick {
      if tick_revision != revision {
        let _ = fail_current(wake,str.view(root),id,"[GA_PREVIEW_REQUEST] Frame media revision differs from its snapshot")
        continue
      }
      let _ = editor.seek(struct.borrow(state,field=document),program_frame)
      let _ = editor.seek_monitor(struct.borrow(state,field=document),source_frame)
    }
    if revision != media_revision {
      provider.restart(struct.borrow(state, field=provider))
      media_revision = revision
      let _ = ref.swap(held_source,string.new())
    }
    struct.set(state,revision,field=media_revision)
    struct.set(state,if array.len(dimensions) >= 7 {match text.parse_u64(array.borrow(dimensions,6)) {
      some(value)=>value,none=>0,}}else{0},field=document_revision)
    // This mailbox accepts monitor sizes, not arbitrary export-sized allocations.
    if width == 0 or height == 0 or width > 1280 or height > 720 {
      let _ = fail_current(wake,str.view(root),id,"[GA_PREVIEW_GEOMETRY] Preview dimensions must be within 1280x720")
      continue
    }
    let request_ns: u64 = if owned.profile {time.monotonic_ns()-request_begin}else{0}
    if owned.strips_only {
      let start: i64 = if array.len(dimensions) >= 3 {match text.parse_i64(array.borrow(dimensions,0)) {
        some(value)=>value,none=>0,}}else{0}
      let span: i64 = if array.len(dimensions) >= 3 {match text.parse_i64(array.borrow(dimensions,2)) {
        some(value)=>value,none=>450,}}else{450}
      match waveforms_for_viewport(state,str.view(root),id,start,span) {
        ok(_)=>{},err(problem)=>{let _ = fail_current(wake,str.view(root),id,problem)
          continue},
      }
      publish(str.view(root),"waveforms.id","0")
      write_waveforms(state,str.view(root))
      publish(str.view(root),"waveforms.id",str.view(string.from_int(id)))
      if not link.notify(wake,2,id) {break}
      match write_thumbnails(state,str.view(root),id,str.view(geometry)) {
        err(problem)=>{let _ = fail_current(wake,str.view(root),id,str.view(problem))
          continue},ok(_)=>{},
      }
      if not link.notify(wake,3,number(str.view(root),"thumbnails.id")) {break}
      continue
    }
    let previous_source: string = if owned.pixel_stream {string.copy(str.view(held_source))}else{string.new()}
    var measured: Images = images_with_source(state,width,height,owned.profile,str.view(previous_source))
    let media_error: string = provider.last_error(struct.borrow(state,field=provider))
    if str.len(media_error) != 0 {
      publish(str.view(root),"error.txt",media_error)
      let _ = fail_current(wake,str.view(root),id,media_error)
      continue
    }
    let source_ns: u64 = measured.source_ns
    let plan_ns: u64 = measured.plan_ns
    let program_ns: u64 = measured.program_ns
    var rendered: array<draw.Surface> = struct.replace(measured,array.new(),field=pictures)
    let publish_begin: u64 = if owned.profile or owned.pixel_stream {time.monotonic_ns()}else{0}
    var program: draw.Surface = match array.pop(rendered) { some(value) => value, none => draw.empty_surface(), }
    var source: draw.Surface = match array.pop(rendered) { some(value) => value, none => draw.empty_surface(), }
    if owned.pixel_stream {
      let timing: link.FrameTiming = link.FrameTiming {generation:id,request_ns:request_ns,source_ns:source_ns,
        plan_ns:plan_ns,program_ns:program_ns,publish_ns:0,coalesce_ns:wake.last_drain_ns}
      match link.notify_pixels(wake,str.view(root),source,program,
          str.view(provider.last_error(struct.borrow(state,field=provider))),measured.source_held,timing,
          link.FramePosition {source_frame:measured.source_frame,program_frame:measured.program_frame,revision:revision},publish_begin) {
        ok(delivered)=>{if not delivered {continue}
          let _ = ref.swap(held_source,string.copy(str.view(struct.borrow(measured,field=source_key))))},
        err(problem)=>{let _ = fail_current(wake,str.view(root),id,str.view(problem))
          break},
      }
    } else {
    let marker: string = text.concat("frame",text.concat(str.view(string.from_int(id % 2)),".id"))
    if not publish_checked(str.view(root),str.view(marker),"0") {
      let _ = fail_current(wake,str.view(root),id,"[GA_PREVIEW_PUBLISH] Cannot reserve the next frame slot")
      continue
    }
    if not write_image(str.view(root),id,"source",source) or
        not write_image(str.view(root),id,"program",program) {
      let _ = fail_current(wake,str.view(root),id,"[GA_PREVIEW_PUBLISH] Cannot publish preview pixels")
      continue
    }
    publish(str.view(root), "error.txt", str.view(provider.last_error(struct.borrow(state, field=provider))))
    let size_text: string = text.concat(str.view(string.from_int(width)), text.concat("\t", str.view(string.from_int(height))))
    let size_name: string = text.concat("size",text.concat(str.view(string.from_int(id % 2)),".rgba"))
    let generation_text: string = string.from_int(id)
    if not publish_checked(str.view(root),str.view(size_name),str.view(size_text)) or
        not publish_checked(str.view(root),str.view(marker),str.view(generation_text)) {
      let _ = fail_current(wake,str.view(root),id,"[GA_PREVIEW_PUBLISH] Cannot commit preview dimensions and generation")
      continue
    }
    publish(str.view(root), "ready.id", str.view(generation_text))
    let delivered: bool = if owned.profile {
      link.notify_frame(wake,id,request_ns,source_ns,plan_ns,program_ns,time.monotonic_ns()-publish_begin,wake.last_drain_ns)
    }else{link.notify(wake,1,id)}
    if not delivered { break }
    }
    if not owned.pixel_stream and not editor.playing(struct.borrow(state, field=document)) and
        not struct.get(struct.borrow(struct.borrow(state, field=document), field=monitor), field=playing) {
      match waveforms_for_request(state,str.view(root),id) {
        ok(_)=>{},err(problem)=>{let _ = fail_current(wake,str.view(root),id,problem)
          continue},
      }
      publish(str.view(root), "waveforms.id", "0")
      write_waveforms(state, str.view(root))
      publish(str.view(root), "waveforms.id", str.view(string.from_int(id)))
      if not link.notify(wake,2,id) { break }
      match write_thumbnails(state,str.view(root),id,str.view(geometry)) {
        err(problem)=>{let _ = fail_current(wake,str.view(root),id,str.view(problem))
          continue},ok(_)=>{},
      }
      if not link.notify(wake,3,number(str.view(root),"thumbnails.id")) { break }
    }
  }
  provider.shutdown(struct.borrow(state, field=provider))
  link.finish(wake,seen)
  true
}
