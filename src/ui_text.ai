// Cached TrueType typography for the editor chrome. Project titles have their own faces.
module genesis.ui_text

import std.draw as draw
import std.font as font
import std.geometry as geometry
import std.math as math
import "typeface.ai" as typeface

pub type Typography = struct { faces: array<font.Font>, scale: f64 }

pub fn empty() -> Typography effects {alloc} {
  Typography {faces: array.new(), scale: 1.0}
}

fn cap(slot: u64) -> f64 effects {} {
  if slot == 0 { 8.0 } else if slot == 1 { 10.0 } else if slot == 2 { 12.0 } else { 14.0 }
}

fn font_slot(size: f64) -> u64 effects {} {
  if size <= 8.0 { 0 } else if size <= 10.0 { 1 } else if size <= 12.0 { 2 } else { 3 }
}

pub fn load(paths: ref<array<string>>) -> Typography effects {alloc, fs.read, fs.meta} {
  var out: Typography = empty()
  var index: u64 = 0
  loop {
    if index >= 4 { break }
    match typeface.load(paths, typeface.px_for(cap(index))) {
      err(_) => { return empty() },
      ok(face) => array.push(struct.borrow(out, field=faces), face),
    }
    index = index + 1
  }
  out
}

pub fn available(book: ref<Typography>) -> bool effects {} {
  array.len(struct.borrow(book, field=faces)) == 4
}

pub fn set_scale(book: ref<Typography>, scale: f64) -> unit effects {alloc} {
  let next: f64 = if math.is_finite(scale) and scale > 0.0 { scale } else { 1.0 }
  if book.scale == next { return () }
  struct.set(book, next, field=scale)
  var index: u64 = 0
  loop {
    if index >= array.len(struct.borrow(book, field=faces)) { break }
    font.set_pixel_size(array.borrow(struct.borrow(book, field=faces), index),
      typeface.px_for(cap(index) * next))
    index = index + 1
  }
  ()
}

pub fn width(book: ref<Typography>, line: str, size: f64) -> f64 effects {alloc} {
  // Fixtures can exercise commands without reading system fonts; native paints load them first.
  if not available(book) { return cast.float(str.len(line)) * size * 0.58 }
  font.measure(array.borrow(struct.borrow(book, field=faces), font_slot(size)), line) / book.scale
}

pub fn fit(book: ref<Typography>, line: str, size: f64, limit: f64) -> string effects {alloc} {
  if not available(book) { return string.copy(line) }
  font.fit_text(array.borrow(struct.borrow(book, field=faces), font_slot(size)), line,
    math.max(0.0, limit) * book.scale)
}

pub fn paint(book: ref<Typography>, canvas: ref<draw.Canvas>, x: f64, top: f64,
             line: str, size: f64, colour: draw.Color) -> unit effects {alloc} {
  if not available(book) { return () }
  let face: ref<font.Font> = array.borrow(struct.borrow(book, field=faces), font_slot(size))
  // std.font rasterizes glyphs at their physical size; only the baseline is transformed.
  let _ = font.draw_text(canvas, face, geometry.vec2(x, top + cap(font_slot(size))), line, colour)
  ()
}
