// Titles and captions are stored in logical order, while std.font draws one
// glyph per scalar from left to right. This pass supplies the missing layout
// step for right-to-left scripts: Arabic joining through Unicode Presentation
// Forms-B (only where an installed face covers the form, otherwise the base
// letter is kept), then a simplified Unicode Bidirectional Algorithm (first
// strong paragraph level, rules W1-W7, N1-N2, I1-I2, L1 trailing whitespace,
// L2 reordering and L4 bracket mirroring). Explicit embeddings, isolates and
// OpenType GSUB/GPOS shaping (Indic reordering, general ligatures, mark
// positioning) are outside this pass.
module genesis.bidi

import std.font as font

// Bidi classes used here.
fn c_l() -> u32 effects {} { 0 }
fn c_r() -> u32 effects {} { 1 }
fn c_al() -> u32 effects {} { 2 }
fn c_en() -> u32 effects {} { 3 }
fn c_an() -> u32 effects {} { 4 }
fn c_es() -> u32 effects {} { 5 }
fn c_cs() -> u32 effects {} { 6 }
fn c_et() -> u32 effects {} { 7 }
fn c_nsm() -> u32 effects {} { 8 }
fn c_ws() -> u32 effects {} { 9 }
fn c_on() -> u32 effects {} { 10 }

fn in_range(s: u32, lo: u32, hi: u32) -> bool effects {} { s >= lo and s <= hi }

fn class_of(s: u32) -> u32 effects {} {
  if in_range(s, 48, 57) or in_range(s, 1776, 1785) or in_range(s, 8304, 8313) { return c_en() }
  if in_range(s, 1632, 1641) or in_range(s, 1643, 1644) { return c_an() }
  if s == 43 or s == 45 { return c_es() }
  if s == 44 or s == 46 or s == 47 or s == 58 or s == 160 { return c_cs() }
  if s == 35 or s == 36 or s == 37 or in_range(s, 162, 165) or s == 176 or s == 8240 or s == 8364 { return c_et() }
  if s == 32 or s == 9 or in_range(s, 8192, 8202) { return c_ws() }
  // Combining marks: Hebrew points/accents, Arabic harakat, generic combining range.
  if in_range(s, 768, 879) or in_range(s, 1425, 1469) or s == 1471 or in_range(s, 1473, 1474) or
      in_range(s, 1476, 1477) or s == 1479 or in_range(s, 1552, 1562) or in_range(s, 1611, 1631) or
      s == 1648 or in_range(s, 1750, 1756) or in_range(s, 1759, 1764) or in_range(s, 1767, 1768) or
      in_range(s, 1770, 1773) { return c_nsm() }
  if in_range(s, 1424, 1535) or in_range(s, 64285, 64335) { return c_r() }
  if in_range(s, 1536, 1791) or in_range(s, 1872, 1919) or in_range(s, 2208, 2303) or
      in_range(s, 64336, 65023) or in_range(s, 65136, 65279) { return c_al() }
  if s < 65 or in_range(s, 91, 96) or in_range(s, 123, 191) or s == 215 or s == 247 or
      in_range(s, 8192, 8303) or in_range(s, 8448, 8527) or in_range(s, 8592, 11263) or
      in_range(s, 12288, 12291) or in_range(s, 65280, 65295) { return c_on() }
  c_l()
}

// Presentation Forms-B base for letters that change shape: isolated, final,
// initial, medial follow at +0..+3; right-joining letters have two forms.
fn arabic_form_base(s: u32) -> u32 effects {} {
  if s == 1569 { return 65152 }
  if in_range(s, 1570, 1594) {
    let bases: u32 = s - 1570
    if bases == 0 { return 65153 }
    if bases == 1 { return 65155 }
    if bases == 2 { return 65157 }
    if bases == 3 { return 65159 }
    if bases == 4 { return 65161 }
    if bases == 5 { return 65165 }
    if bases == 6 { return 65167 }
    if bases == 7 { return 65171 }
    if bases == 8 { return 65173 }
    if bases == 9 { return 65177 }
    if bases == 10 { return 65181 }
    if bases == 11 { return 65185 }
    if bases == 12 { return 65189 }
    if bases == 13 { return 65193 }
    if bases == 14 { return 65195 }
    if bases == 15 { return 65197 }
    if bases == 16 { return 65199 }
    if bases == 17 { return 65201 }
    if bases == 18 { return 65205 }
    if bases == 19 { return 65209 }
    if bases == 20 { return 65213 }
    if bases == 21 { return 65217 }
    if bases == 22 { return 65221 }
    if bases == 23 { return 65225 }
    return 65229
  }
  if in_range(s, 1601, 1610) {
    let bases: u32 = s - 1601
    if bases == 0 { return 65233 }
    if bases == 1 { return 65237 }
    if bases == 2 { return 65241 }
    if bases == 3 { return 65245 }
    if bases == 4 { return 65249 }
    if bases == 5 { return 65253 }
    if bases == 6 { return 65257 }
    if bases == 7 { return 65261 }
    if bases == 8 { return 65263 }
    return 65265
  }
  0
}

// 0 none, 1 right-joining (isolated/final), 2 dual-joining, 3 join-causing tatweel.
fn joining(s: u32) -> u32 effects {} {
  if s == 1600 { return 3 }
  if s == 1569 { return 0 }
  if s == 1570 or s == 1571 or s == 1572 or s == 1573 or s == 1575 or s == 1577 or
      in_range(s, 1583, 1586) or s == 1608 or s == 1609 { return 1 }
  if arabic_form_base(s) != 0 { return 2 }
  0
}

fn lam_alef(alef: u32) -> u32 effects {} {
  if alef == 1570 { return 65269 }
  if alef == 1571 { return 65271 }
  if alef == 1573 { return 65273 }
  if alef == 1575 { return 65275 }
  0
}

fn covers(face: ref<font.Font>, s: u32) -> bool effects {alloc} {
  let before: u64 = font.missing_count(face)
  let _ = font.glyph_slot(face, s)
  font.missing_count(face) == before
}

fn transparent(s: u32) -> bool effects {} { class_of(s) == c_nsm() }

fn previous_joiner(values: ref<array<u32>>, at: u64) -> u32 effects {} {
  var i: u64 = at
  loop {
    if i == 0 { return 0 }
    i = i - 1
    let s: u32 = array.get(values, i)
    if not transparent(s) { return joining(s) }
  }
  0
}

fn next_index(values: ref<array<u32>>, at: u64) -> u64 effects {} {
  var i: u64 = at + 1
  loop {
    if i >= array.len(values) { return i }
    if not transparent(array.get(values, i)) { return i }
    i = i + 1
  }
  i
}

// Arabic contextual forms in logical order. Lam followed by an alef becomes
// one ligature scalar; its final form is used when the lam joins backwards.
fn shape_arabic(face: ref<font.Font>, input: ref<array<u32>>) -> array<u32> effects {alloc} {
  var out: array<u32> = array.new()
  var at: u64 = 0
  loop {
    if at >= array.len(input) { break }
    let s: u32 = array.get(input, at)
    let kind: u32 = joining(s)
    if kind == 0 or kind == 3 {
      array.push(out, s)
      at = at + 1
      continue
    }
    let before: u32 = previous_joiner(input, at)
    let joins_back: bool = before == 2 or before == 3
    let next: u64 = next_index(input, at)
    let following: u32 = if next < array.len(input) { array.get(input, next) } else { 0 }
    if s == 1604 and next < array.len(input) and lam_alef(following) != 0 {
      let ligature: u32 = lam_alef(following) + if joins_back { 1 } else { 0 }
      if covers(face, ligature) {
        array.push(out, ligature)
        // Marks between lam and alef stay attached after the ligature.
        var mark: u64 = at + 1
        loop {
          if mark >= next { break }
          array.push(out, array.get(input, mark))
          mark = mark + 1
        }
        at = next + 1
        continue
      }
    }
    let joins_next: bool = kind == 2 and next < array.len(input) and joining(following) != 0
    let offset: u32 = if kind == 1 {
      if joins_back { 1 } else { 0 }
    } else if joins_back and joins_next { 3 } else if joins_back { 1 } else if joins_next { 2 } else { 0 }
    let shaped: u32 = arabic_form_base(s) + offset
    array.push(out, if covers(face, shaped) { shaped } else { s })
    at = at + 1
  }
  out
}

fn mirror(s: u32) -> u32 effects {} {
  if s == 40 { return 41 }
  if s == 41 { return 40 }
  if s == 60 { return 62 }
  if s == 62 { return 60 }
  if s == 91 { return 93 }
  if s == 93 { return 91 }
  if s == 123 { return 125 }
  if s == 125 { return 123 }
  if s == 171 { return 187 }
  if s == 187 { return 171 }
  s
}

fn strong_of(kind: u32) -> u32 effects {} {
  // N1: European and Arabic numbers act as R for neutral resolution.
  if kind == c_l() { return c_l() }
  if kind == c_r() or kind == c_al() or kind == c_en() or kind == c_an() { return c_r() }
  99
}

/// True when the first strong scalar is right-to-left (rules P2/P3).
pub fn rtl_paragraph(line: str) -> bool effects {alloc} {
  var cursor: u64 = 0
  loop {
    if cursor >= str.len(line) { break }
    let kind: u32 = class_of(font.decode_at(line, cursor))
    if kind == c_l() { return false }
    if kind == c_r() or kind == c_al() { return true }
  }
  false
}

fn has_rtl(values: ref<array<u32>>) -> bool effects {} {
  var i: u64 = 0
  loop {
    if i >= array.len(values) { return false }
    let kind: u32 = class_of(array.get(values, i))
    if kind == c_r() or kind == c_al() or kind == c_an() { return true }
    i = i + 1
  }
  false
}

fn append_scalar(out: ref<string>, scalar: u32) -> unit effects {alloc} {
  let value: u64 = cast.wrap(scalar)
  var raw: array<byte> = array.new()
  if value < 128 {
    let b0: u8 = cast.wrap(value)
    array.push(raw, cast.bits(b0))
  } else if value < 2048 {
    let b0: u8 = cast.wrap(192 + value / 64)
    let b1: u8 = cast.wrap(128 + value % 64)
    array.push(raw, cast.bits(b0))
    array.push(raw, cast.bits(b1))
  } else if value < 65536 {
    let b0: u8 = cast.wrap(224 + value / 4096)
    let b1: u8 = cast.wrap(128 + value / 64 % 64)
    let b2: u8 = cast.wrap(128 + value % 64)
    array.push(raw, cast.bits(b0))
    array.push(raw, cast.bits(b1))
    array.push(raw, cast.bits(b2))
  } else {
    let b0: u8 = cast.wrap(240 + value / 262144)
    let b1: u8 = cast.wrap(128 + value / 4096 % 64)
    let b2: u8 = cast.wrap(128 + value / 64 % 64)
    let b3: u8 = cast.wrap(128 + value % 64)
    array.push(raw, cast.bits(b0))
    array.push(raw, cast.bits(b1))
    array.push(raw, cast.bits(b2))
    array.push(raw, cast.bits(b3))
  }
  match str.from_bytes(array.view(raw)) {
    some(piece) => { string.append(out, piece) },
    none => {},
  }
  ()
}

/// The visual-order line that std.font should draw left to right. Lines with
/// no right-to-left or Arabic-number scalar are returned unchanged.
pub fn visual(face: ref<font.Font>, line: str) -> string effects {alloc} {
  var logical: array<u32> = array.new()
  var cursor: u64 = 0
  loop {
    if cursor >= str.len(line) { break }
    array.push(logical, font.decode_at(line, cursor))
  }
  if not has_rtl(logical) { return string.copy(line) }
  var values: array<u32> = shape_arabic(face, logical)
  let count: u64 = array.len(values)
  let base: u32 = if rtl_paragraph(line) { 1 } else { 0 }
  let embedding: u32 = if base == 1 { c_r() } else { c_l() }
  var kinds: array<u32> = array.new()
  var i: u64 = 0
  loop {
    if i >= count { break }
    array.push(kinds, class_of(array.get(values, i)))
    i = i + 1
  }
  // W1: marks take the class of the preceding scalar (sos at the start).
  var previous: u32 = embedding
  i = 0
  loop {
    if i >= count { break }
    if array.get(kinds, i) == c_nsm() { array.set(kinds, i, previous) }
    previous = array.get(kinds, i)
    i = i + 1
  }
  // W2: EN after AL becomes AN. W3: AL becomes R.
  var last_strong: u32 = embedding
  i = 0
  loop {
    if i >= count { break }
    let kind: u32 = array.get(kinds, i)
    if kind == c_l() or kind == c_r() or kind == c_al() { last_strong = kind }
    if kind == c_en() and last_strong == c_al() { array.set(kinds, i, c_an()) }
    i = i + 1
  }
  i = 0
  loop {
    if i >= count { break }
    if array.get(kinds, i) == c_al() { array.set(kinds, i, c_r()) }
    i = i + 1
  }
  // W4: one separator between two numbers of the same kind joins them.
  i = 1
  loop {
    if i + 1 >= count { break }
    let kind: u32 = array.get(kinds, i)
    let left: u32 = array.get(kinds, i - 1)
    let right: u32 = array.get(kinds, i + 1)
    if kind == c_es() and left == c_en() and right == c_en() { array.set(kinds, i, c_en()) }
    else if kind == c_cs() and left == right and (left == c_en() or left == c_an()) { array.set(kinds, i, left) }
    i = i + 1
  }
  // W5: terminators adjacent to European numbers become EN.
  var changed: bool = true
  loop {
    if not changed { break }
    changed = false
    i = 0
    loop {
      if i >= count { break }
      if array.get(kinds, i) == c_et() and
          ((i > 0 and array.get(kinds, i - 1) == c_en()) or (i + 1 < count and array.get(kinds, i + 1) == c_en())) {
        array.set(kinds, i, c_en())
        changed = true
      }
      i = i + 1
    }
  }
  // W6: remaining separators and terminators are neutral. W7: EN after L is L.
  last_strong = embedding
  i = 0
  loop {
    if i >= count { break }
    let kind: u32 = array.get(kinds, i)
    if kind == c_es() or kind == c_cs() or kind == c_et() { array.set(kinds, i, c_on()) }
    if kind == c_l() or kind == c_r() { last_strong = kind }
    if kind == c_en() and last_strong == c_l() { array.set(kinds, i, c_l()) }
    i = i + 1
  }
  // N1/N2: neutral runs take matching surrounding strong direction, else embedding.
  i = 0
  loop {
    if i >= count { break }
    let kind: u32 = array.get(kinds, i)
    if kind != c_ws() and kind != c_on() { i = i + 1
      continue }
    var end: u64 = i
    loop {
      if end >= count { break }
      let next_kind: u32 = array.get(kinds, end)
      if next_kind != c_ws() and next_kind != c_on() { break }
      end = end + 1
    }
    let before: u32 = if i == 0 { embedding } else { strong_of(array.get(kinds, i - 1)) }
    let after: u32 = if end >= count { embedding } else { strong_of(array.get(kinds, end)) }
    let resolved: u32 = if before == after { before } else { embedding }
    var fill: u64 = i
    loop {
      if fill >= end { break }
      array.set(kinds, fill, resolved)
      fill = fill + 1
    }
    i = end
  }
  // I1/I2 levels, then L1: trailing whitespace returns to the paragraph level.
  var levels: array<u32> = array.new()
  i = 0
  loop {
    if i >= count { break }
    let kind: u32 = array.get(kinds, i)
    let level: u32 = if base == 0 {
      if kind == c_r() { 1 } else if kind == c_an() or kind == c_en() { 2 } else { 0 }
    } else {
      if kind == c_l() or kind == c_en() or kind == c_an() { 2 } else { 1 }
    }
    array.push(levels, level)
    i = i + 1
  }
  var tail: u64 = count
  loop {
    if tail == 0 { break }
    if class_of(array.get(values, tail - 1)) != c_ws() { break }
    array.set(levels, tail - 1, base)
    tail = tail - 1
  }
  // L2: reverse every maximal run at or above each level, highest first.
  var order: array<u64> = array.new()
  var highest: u32 = 0
  i = 0
  loop {
    if i >= count { break }
    array.push(order, i)
    if array.get(levels, i) > highest { highest = array.get(levels, i) }
    i = i + 1
  }
  var level: u32 = highest
  loop {
    if level < 1 { break }
    i = 0
    loop {
      if i >= count { break }
      if array.get(levels, array.get(order, i)) < level { i = i + 1
        continue }
      var end: u64 = i
      loop {
        if end >= count { break }
        if array.get(levels, array.get(order, end)) < level { break }
        end = end + 1
      }
      var lo: u64 = i
      var hi: u64 = end - 1
      loop {
        if lo >= hi { break }
        let swap: u64 = array.get(order, lo)
        array.set(order, lo, array.get(order, hi))
        array.set(order, hi, swap)
        lo = lo + 1
        hi = hi - 1
      }
      i = end
    }
    level = level - 1
  }
  var out: string = string.new()
  i = 0
  loop {
    if i >= count { break }
    let at: u64 = array.get(order, i)
    // L3: a reversed run places marks before their base; std.font attaches a
    // mark to the glyph drawn before it, so emit the base and then its marks.
    if transparent(array.get(values, at)) and array.get(levels, at) % 2 == 1 {
      var end: u64 = i
      loop {
        if end >= count { break }
        let mark: u64 = array.get(order, end)
        if not transparent(array.get(values, mark)) or array.get(levels, mark) % 2 == 0 { break }
        end = end + 1
      }
      if end < count and array.get(levels, array.get(order, end)) % 2 == 1 {
        append_scalar(out, mirror(array.get(values, array.get(order, end))))
        var back: u64 = end
        loop {
          if back == i { break }
          back = back - 1
          append_scalar(out, array.get(values, array.get(order, back)))
        }
        i = end + 1
        continue
      }
    }
    let s: u32 = array.get(values, at)
    // L4: mirrored brackets inside right-to-left levels.
    append_scalar(out, if array.get(levels, at) % 2 == 1 { mirror(s) } else { s })
    i = i + 1
  }
  out
}
